{
  "id": "OBJ3-NEXT-016-PARSE-RECOVERY-01",
  "title": "Issue #8169 parser recovery keeps missing-semicolon rejection structured",
  "feature": "structured parser diagnostics and recovery boundaries",
  "bucket": "diagnostics",
  "profile": "strict",
  "references": [
