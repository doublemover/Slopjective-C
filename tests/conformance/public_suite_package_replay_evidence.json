{
  "contract_id": "objc3c.public_conformance_suite.package_replay_evidence.v1",
  "schema_version": 1,
  "suite_id": "objc3-public-conformance-suite",
  "source_manifest": "tests/conformance/public_suite_manifest.json",
  "package_stage_root": "tmp/pkg/objc3-public-conformance-suite",
  "artifact_root": "tmp/artifacts/public-conformance/suite",
  "report_root": "tmp/reports/conformance",
  "outside_repo_replay": {
    "required": true,
    "model": "copy staged suite package into a clean directory outside the repository root and run only packaged public commands",
    "source_truth_policy": "checked-in manifests and fixtures define support; generated package and report trees prove replay only",
    "network_policy": "offline",
    "tmp_support_claims_allowed": false
  },
  "packaged_entrypoints": [
    {
      "profile_id": "core",
      "command": "npm run objc3c -- validate-conformance-corpus",
      "requires_repo_checkout": false,
      "requires_network": false
    },
    {
      "profile_id": "stdlib-package",
      "command": "npm run objc3c -- validate-interop-conformance",
      "requires_repo_checkout": false,
      "requires_network": false
    },
    {
      "profile_id": "release-candidate",
      "command": "npm run objc3c -- validate-release-candidate-conformance",
      "requires_repo_checkout": false,
      "requires_network": false
    }
  ],
  "required_packaged_inputs": [
    "tests/conformance/public_suite_manifest.json",
    "tests/conformance/corpus_surface.json",
    "tests/conformance/support_claim_runnable_evidence_catalog.json",
    "docs/support/capability_matrix.json",
    "docs/support/evidence_map.json",
    "schemas/objc3c-public-conformance-suite-v1.schema.json"
  ],
  "required_replay_outputs": [
    "tmp/reports/conformance/public-suite-summary.json",
    "tmp/artifacts/public-conformance/suite/manifest.snapshot.json",
    "tmp/pkg/objc3-public-conformance-suite/package-manifest.json"
  ],
  "fail_closed_checks": [
    "packaged commands must keep the npm public command prefix",
    "packaged replay must not use tmp artifacts as source truth",
    "outside-repo replay must not enable compatibility mode, fallback gates, or unsupported claim promotion",
    "release-candidate replay must include positive and negative evidence for every public-stable case"
  ]
}
