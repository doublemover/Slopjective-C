{
  "id": "HC-LEGACY-01",
  "title": "Reject retired ObjC 2 retired mode spelling",
  "feature": "hard-cutover language mode rejection",
  "bucket": "parser",
  "profile": "core",
  "references": [
    "docs/reference/legacy_spec_anchor_index.md#part-1-2-1",
    "docs/reference/legacy_spec_anchor_index.md#part-1-2-4",
    "docs/reference/legacy_spec_anchor_index.md#part-12-5-8"
  ],
  "source": "// RUN: objc3c --objc2-compatible -fsyntax-only %s\nint hard_cutover_legacy_mode(void) {\n    return 0;\n}\n",
  "expect": {
    "parse": "reject",
    "diagnostics": [
      {
        "code": "O3C001",
        "severity": "error",
        "span": {
          "start": { "line": 1, "column": 16 },
          "end": { "line": 1, "column": 34 }
        },
        "message": "Retired Objective-C mode is removed in the Objective-C 3.0 hard cutover; use canonical Objective-C 3 mode",
        "fixits": [
          {
            "range": {
              "start": { "line": 1, "column": 16 },
              "end": { "line": 1, "column": 34 }
            },
            "replacement": "-fobjc-version=3"
          }
        ]
      }
    ]
  }
}
