// #8200 cross-lane executable: distribution package lifecycle.
// package signing
// package publish
// install from clean root
// update
// rollback
// compile/run installed package
module CrossLaneDistributionPackageLifecycle;

extern fn publishedLifecycleSeed() -> i32
    __attribute__((objc_foreign, objc_import_module(named("CrossLanePublishedToolchain"))));

fn packageSigningManifestOk(seed: i32) -> i32 {
  return seed == 17 ? 2 : 101;
}

fn packagePublishReceiptOk() -> i32 {
  return 3;
}

fn installFromCleanRoot() -> i32 {
  return 5;
}

fn updateInstalledPackage() -> i32 {
  return 7;
}

fn rollbackInstalledPackage() -> i32 {
  return 11;
}

fn compileRunInstalledPackage() -> i32 {
  return 13;
}

fn verifyLifecycle() -> i32 {
  let seed = publishedLifecycleSeed();
  let total = packageSigningManifestOk(seed)
    + packagePublishReceiptOk()
    + installFromCleanRoot()
    + updateInstalledPackage()
    + rollbackInstalledPackage()
    + compileRunInstalledPackage();
  if (total != 41) {
    return total;
  }
  return 0;
}

fn main() -> i32 {
  return verifyLifecycle();
}
