// Expected advanced-runtime diagnostic: advanced-runtime.distributed-actor-transport-overclaim
module AdvancedRuntimeClosureNegativeDistributedActorTransportOverclaim;

extern fn objc3_runtime_actor_mailbox_enqueue_i32(actor_handle: i32, value: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_drain_next_i32(actor_handle: i32, executor_tag: i32) -> i32;

actor class DistributedActorTransportOverclaim
- (i32)remoteDrain:(i32)seed
    __attribute__((objc_distributed_actor,
                   objc_distributed_transport(named("local-mailbox-as-network"))));
@end

@implementation DistributedActorTransportOverclaim
- (i32)remoteDrain:(i32)seed
    __attribute__((objc_distributed_actor,
                   objc_distributed_transport(named("local-mailbox-as-network")))) {
  // distributed_actor_transport_evidence_sites must stay zero for the local
  // mailbox runtime envelope. Message identity, FIFO, drain, cancel, error,
  // and shutdown evidence are not network transport proof.
  let queued = objc3_runtime_actor_mailbox_enqueue_i32(seed, seed + 1, 1);
  return objc3_runtime_actor_mailbox_drain_next_i32(queued, 1);
}
@end
