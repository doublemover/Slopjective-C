// Expected advanced-runtime diagnostic: advanced-runtime.macro-package-replay-tampered-metadata
module AdvancedRuntimeClosureNegativeMacroPackageReplayTamperedMetadata;

pure fn tamperedReplayMacro() -> i32
    __attribute__((objc_macro(named("AdvancedRuntimeTamperedReplayMacro")),
                   objc_macro_package(named("std.metaprogramming.advanced-runtime")),
                   objc_macro_provenance(named("sha256:advanced-runtime-tampered-metadata")),
                   objc_macro_cache_key(named("AdvancedRuntimeTamperedReplayMacro:v1")),
                   objc_macro_sandbox(named("deterministic")))) {
  return 13;
}

extern fn tamperedReplayEntry(selector: SEL) -> i32
    __attribute__((objc_foreign,
                   objc_import_module(named("AdvancedRuntimeClosureKit")),
                   objc_mixed_image(named("AdvancedRuntimeClosureKitCore")),
                   objc_package_entry(named("AdvancedRuntimeClosureKit.tamperedReplay"))));

fn invalidTamperedReplay() -> i32 {
  // Runtime metadata that does not match package replay identity is rejected.
  return tamperedReplayMacro() + tamperedReplayEntry(nil);
}
