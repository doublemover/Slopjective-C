// Expected advanced-runtime diagnostic: advanced-runtime.macro-package-replay-untrusted
module AdvancedRuntimeClosureNegativeMacroPackageReplay;

pure fn packageReplayMacro() -> i32
    __attribute__((objc_macro(named("AdvancedRuntimePackageReplayMacro")),
                   objc_macro_package(named("std.metaprogramming.advanced-runtime")),
                   objc_macro_provenance(named("sha256:advanced-runtime-package-replay")),
                   objc_macro_cache_key(named("AdvancedRuntimePackageReplayMacro:v1")),
                   objc_macro_sandbox(named("deterministic")))) {
  return 5;
}

extern fn untrustedReplayEntry(selector: SEL) -> i32
    __attribute__((objc_foreign,
                   objc_import_module(named("AdvancedRuntimeClosureKit")),
                   objc_mixed_image(named("AdvancedRuntimeClosureKitCore")),
                   objc_package_entry(named("AdvancedRuntimeClosureKit.untrustedReplay"))));

fn invalidMacroPackageReplay() -> i32 {
  return packageReplayMacro() + untrustedReplayEntry(nil);
}
