// Expected advanced-runtime diagnostic: advanced-runtime.macro-package-replay-host-mismatch
module AdvancedRuntimeClosureNegativeMacroPackageReplayHostMismatch;

pure fn hostMismatchMacro() -> i32
    __attribute__((objc_macro(named("AdvancedRuntimeHostMismatchMacro")),
                   objc_macro_package(named("std.metaprogramming.advanced-runtime")),
                   objc_macro_provenance(named("sha256:advanced-runtime-host-mismatch")),
                   objc_macro_cache_key(named("AdvancedRuntimeHostMismatchMacro:v1")),
                   objc_macro_host_identity(named("objc3c-frontend-c-api-runner:wrong")),
                   objc_macro_sandbox(named("deterministic")))) {
  return 11;
}

extern fn hostMismatchReplayEntry(selector: SEL) -> i32
    __attribute__((objc_foreign,
                   objc_import_module(named("AdvancedRuntimeClosureKit")),
                   objc_mixed_image(named("AdvancedRuntimeClosureKitCore")),
                   objc_package_entry(named("AdvancedRuntimeClosureKit.hostMismatchReplay"))));

fn invalidHostMismatchReplay() -> i32 {
  // A macro cache generated under a different host identity is not replay proof.
  return hostMismatchMacro() + hostMismatchReplayEntry(nil);
}
