// Expected advanced-runtime diagnostic: advanced-runtime.macro-package-replay-missing-metadata
module AdvancedRuntimeClosureNegativeMacroPackageReplayMissingMetadata;

pure fn missingMetadataMacro() -> i32
    __attribute__((objc_macro(named("AdvancedRuntimeMissingMetadataMacro")),
                   objc_macro_package(named("std.metaprogramming.advanced-runtime")),
                   objc_macro_cache_key(named("AdvancedRuntimeMissingMetadataMacro:v1")),
                   objc_macro_sandbox(named("deterministic")))) {
  return 17;
}

extern fn missingMetadataReplayEntry(selector: SEL) -> i32
    __attribute__((objc_foreign,
                   objc_import_module(named("AdvancedRuntimeClosureKit")),
                   objc_mixed_image(named("AdvancedRuntimeClosureKitCore")),
                   objc_package_entry(named("AdvancedRuntimeClosureKit.missingMetadataReplay"))));

fn invalidMissingMetadataReplay() -> i32 {
  // Missing macro provenance, package lock identity, trust identity, and
  // runtime_consumption_artifact_identity keep package replay fail-closed.
  return missingMetadataMacro() + missingMetadataReplayEntry(nil);
}
