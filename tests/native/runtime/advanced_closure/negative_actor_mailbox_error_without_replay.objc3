// Expected advanced-runtime diagnostic: advanced-runtime.actor-mailbox-error-without-replay
module AdvancedRuntimeClosureNegativeActorMailboxErrorWithoutReplay;

extern fn objc3_runtime_actor_bind_executor_i32(actor_handle: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_enqueue_i32(actor_handle: i32, value: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_record_error_i32(actor_handle: i32, error_code: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_drain_next_i32(actor_handle: i32, executor_tag: i32) -> i32;

actor class ErrorMailboxReplayActor
- (i32)recordErrorWithoutReplay:(i32)seed;
@end

@implementation ErrorMailboxReplayActor
- (i32)recordErrorWithoutReplay:(i32)seed {
  objc3_runtime_actor_bind_executor_i32(seed, 1);
  objc3_runtime_actor_mailbox_enqueue_i32(seed, seed + 1, 1);
  objc3_runtime_actor_mailbox_record_error_i32(seed, 8216, 1);
  // Actor mailbox error evidence requires explicit replay identity and
  // actor_mailbox_error_operation_field_count before drain can be promoted.
  return objc3_runtime_actor_mailbox_drain_next_i32(seed, 1);
}
@end
