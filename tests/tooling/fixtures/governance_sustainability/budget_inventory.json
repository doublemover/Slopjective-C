{
  "contract_id": "objc3c.governance.sustainability.budget.inventory.v1",
  "surface_kind": "governance-sustainability-budget-inventory",
  "runbook": "docs/runbooks/objc3c_governance_sustainability.md",
  "summary_implementation_anchor": "scripts/build_governance_budget_inventory_summary.py",
  "owner_section": "budget",
  "owner_contract": {
    "owner": "budget_owner",
    "artifact_section": "budget.inventory_summary",
    "publication_projection": "stewardship_publication.budget.inventory_summary",
    "blocker_projection": "claim_audit.blocker_metadata.budget_inventory"
  },
  "measured_budget_surfaces": [
    {
      "surface_id": "package-bridge-budget",
      "source": "package.json:scripts",
      "measurement_kind": "objc3c-bridge-count",
      "current_budget_source": "scripts/ci/check_task_hygiene.py:PACKAGE_BRIDGE_BUDGET",
      "owner_surface": "scripts/ci/check_task_hygiene.py"
    },
    {
      "surface_id": "public-workflow-action-surface",
      "source": "scripts.objc3c_workflow",
      "measurement_kind": "action-definition-count",
      "owner_surface": "scripts.objc3c_workflow"
    },
    {
      "surface_id": "package-bridge-surface",
      "source": "package.json:scripts.objc3c",
      "measurement_kind": "bridge-presence",
      "owner_surface": "scripts.objc3c_workflow"
    },
    {
      "surface_id": "checked-in-runbook-surface",
      "source": "docs/runbooks/*.md",
      "measurement_kind": "file-count",
      "owner_surface": "docs/runbooks/"
    },
    {
      "surface_id": "checked-in-schema-surface",
      "source": "schemas/*.json",
      "measurement_kind": "file-count",
      "owner_surface": "schemas/"
    },
    {
      "surface_id": "live-checker-surface",
      "source": "scripts/**/check_*.py",
      "measurement_kind": "file-count",
      "owner_surface": "scripts/"
    }
  ],
  "must_remain_absent_surfaces": [
    {
      "surface_id": "deprecated-docs-contracts-root",
      "path": "docs/contracts"
    },
    {
      "surface_id": "deprecated-spec-planning-root",
      "path": "spec/planning"
    },
    {
      "surface_id": "deprecated-compiler-prototype-root",
      "path": "compiler"
    },
    {
      "surface_id": "milestone-named-workflows",
      "glob": ".github/workflows/m*.yml"
    },
    {
      "surface_id": "checker-wrapper-tests",
      "glob": "tests/tooling/test_check_*.py"
    },
    {
      "surface_id": "lane-readiness-runners",
      "glob": "scripts/**/run_*_lane_*_readiness.py"
    },
    {
      "surface_id": "legacy-npm-alias-references",
      "pattern": "npm run (check:objc3c:m|test:tooling:m|check:compiler-closeout:m|run:objc3c:|plan:compiler-dispatch:|refresh:compiler-dispatch:|dev:objc3c:)"
    },
    {
      "surface_id": "numeric-milestone-checker-references",
      "pattern": "scripts/check_m\\d"
    }
  ],
  "known_live_governance_drifts": [
    {
      "surface_id": "milestone-scoped-checkers",
      "glob": "scripts/check_m[0-9]*.py",
      "disposition": "must-remain-absent"
    }
  ],
  "budget_publication_semantics": {
    "evidence_section": "budget",
    "claim_audit_projection": "claim_audit.measured_budget_state",
    "anti_regression_projection": "budget.anti_regression_summary",
    "waiver_projection": "budget.waiver_registry",
    "blocker_metadata_projection": "claim_audit.blocker_metadata.budget_inventory"
  },
  "governance_entry_surfaces": [
    "scripts/ci/check_task_hygiene.py",
    "scripts/ci/run_task_hygiene_gate.py",
    "scripts/check_repo_superclean_surface.py",
    "scripts/check_documentation_surface.py",
    "scripts/check_objc3c_dependency_boundaries.py",
    "docs/runbooks/objc3c_maintainer_workflows.md",
    "docs/runbooks/objc3c_public_command_surface.md",
    "docs/runbooks/objc3c_package_ecosystem.md",
    "docs/runbooks/objc3c_adoption_legibility.md",
    "docs/runbooks/objc3c_long_horizon_operations.md",
    "docs/runbooks/objc3c_release_operations.md",
    "docs/runbooks/objc3c_security_hardening.md",
    "docs/governance/extension_author_guide_v1.md",
    "docs/governance/faq_v1.md",
    "scripts/check_objc3c_governance_sustainability_integration.py",
    "scripts.objc3c_workflow"
  ],
  "explicit_non_goals": [
    "no-hosted-community-infrastructure",
    "no-registry-moderation-service",
    "no-policy-only-substitute-for-executable-review-evidence",
    "no-replacement-of-package-release-security-support-or-adoption-evidence"
  ],
  "successor_issues": [
