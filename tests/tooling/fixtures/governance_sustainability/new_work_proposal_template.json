{
  "mode": "governance-new-work-proposal-template-v3",
  "contract_id": "objc3c.governance.new-work-proposal.template.v3",
  "consumed_contract_ids": {
    "governance_policy": "objc3c.governance.sustainability.policy.v1",
    "waiver_registry": "objc3c.governance.sustainability.waiver.registry.v1",
    "schema_surface": "objc3c.governance.sustainability.schema.surface.v1"
  },
  "issue_code_pattern": "^M\\d{3}-[A-E]\\d{3}$",
  "title_format": "[{milestone_code}][Lane-{lane}][{short_code}] {title_core}",
  "required_issue_fields": [
    "issue_code",
    "title_core",
    "kind",
    "milestone_focus_summary",
    "why_it_matters",
    "acceptance_criteria",
    "primary_implementation_surfaces",
    "dependencies",
    "validation_posture",
    "budget_impact",
    "review_class",
    "support_boundary_classification",
    "revert_or_demote_path",
    "evidence_surfaces",
    "label_names"
  ],
  "optional_issue_fields": [
    "boundary_note",
    "design_corrections_folded_in",
    "notes",
    "execution_order",
    "milestone_title",
    "waiver_id"
  ],
  "execution_order_fields": [
    "cleanup_program_slot",
    "cleanup_program_phase",
    "global_sequence",
    "blocked_by_prior_milestones",
    "direct_issue_blockers",
    "directly_unblocks",
    "instruction"
  ],
  "validation_postures": [
    "shared_acceptance_harness",
    "static_policy_guard",
    "conversion_bridge",
    "generator_contract_only"
  ],
  "budget_impact_options": [
    "no_budget_growth",
    "within_existing_budget",
    "requires_exception_record"
  ],
  "package_bridge": "objc3c",
  "governance_preflight_actions": [
    "validate-governance-sustainability"
  ],
  "governance_preflight_commands": [
    "npm run objc3c -- validate-governance-sustainability"
  ],
  "governance_preflight_implementation_anchors": [
    "scripts/build_governance_budget_inventory_summary.py",
    "scripts/build_governance_policy_summary.py",
    "scripts/build_governance_maintainer_review_summary.py",
    "scripts/build_governance_extension_review_policy_summary.py",
    "scripts/build_governance_stewardship_semantics_summary.py",
    "scripts/check_governance_sustainability_schema_surface.py",
    "scripts/build_governance_artifact_contract_summary.py",
    "scripts/check_governance_sustainability_budget_enforcement.py"
  ],
  "render_defaults": {
    "publish_mode": "render-only",
    "write_paths": {
      "issue_body": "issue_body.md",
      "issue_payload": "issue_payload.json",
      "summary": "publication_summary.json"
    }
  },
  "output_dir_default": "tmp/reports/governance-sustainability/new-work-proposal",
  "next_issue": "M332-D001"
}
