{
  "contract_id": "objc3c.governance.extension_review_policy.v1",
  "schema_version": 1,
  "runbook": "docs/runbooks/objc3c_governance_sustainability.md",
  "author_guide": "docs/governance/extension_author_guide_v1.md",
  "proposal_template": "tests/tooling/fixtures/governance_sustainability/new_work_proposal_template.json",
  "owner_section": "extension_review",
  "owner_contract": {
    "owner": "extension_review_owner",
    "artifact_section": "extension_review",
    "publication_projection": "extension_review_publication.extension_review",
    "blocker_projection": "claim_audit.blocker_metadata.extension_review"
  },
  "review_classes": [
    {
      "review_class": "language-extension",
      "allowed_scope": "new syntax, semantics, diagnostics, or standard-library-visible behavior",
      "requires": [
        "proposal_packet",
        "owner_and_backup",
        "support_boundary_classification",
        "conformance_evidence_plan",
        "adoption_and_docs_plan"
      ],
      "required_evidence_surfaces": [
        "docs/objc3c-native.md",
        "docs/runbooks/objc3c_public_conformance_reporting.md",
        "docs/runbooks/objc3c_adoption_legibility.md"
      ]
    },
    {
      "review_class": "support-boundary-impacting-change",
      "allowed_scope": "source, package, runtime, or release behavior that can affect existing users",
      "requires": [
        "proposal_packet",
        "upgrade_claim_class",
        "support_window_analysis",
        "revert_or_demote_path",
        "release_blocker_decision"
      ],
      "required_evidence_surfaces": [
        "docs/runbooks/objc3c_release_operations.md",
        "docs/runbooks/objc3c_long_horizon_operations.md",
        "tests/tooling/fixtures/release_operations/upgrade_support_claim_policy.json",
        "tests/tooling/fixtures/long_horizon_operations/conversion_replay_revert_support_window_semantics.json"
      ]
    },
    {
      "review_class": "package-ecosystem-change",
      "allowed_scope": "package lock, package authoring, local mirror, publication, or packaged toolchain behavior",
      "requires": [
        "proposal_packet",
        "package_surface_delta",
        "determinism_evidence",
        "offline_replay_path",
        "adoption_impact"
      ],
      "required_evidence_surfaces": [
        "docs/runbooks/objc3c_package_ecosystem.md",
        "tests/tooling/fixtures/package_ecosystem/artifact_contract.json",
        "docs/runbooks/objc3c_adoption_legibility.md"
      ]
    },
    {
      "review_class": "security-or-release-governance-change",
      "allowed_scope": "security posture, advisory, release trust, update, or distribution behavior",
      "requires": [
        "proposal_packet",
        "security_owner_review",
        "release_owner_review",
        "operator_impact",
        "publication_plan"
      ],
      "required_evidence_surfaces": [
        "docs/runbooks/objc3c_security_hardening.md",
        "docs/runbooks/objc3c_distribution_credibility.md",
        "docs/runbooks/objc3c_release_operations.md"
      ]
    }
  ],
  "proposal_required_fields": [
    "issue_code",
    "title_core",
    "kind",
    "milestone_focus_summary",
    "why_it_matters",
    "acceptance_criteria",
    "primary_implementation_surfaces",
    "dependencies",
    "validation_posture",
    "budget_impact",
    "review_class",
    "support_boundary_classification",
    "revert_or_demote_path",
    "evidence_surfaces",
    "label_names"
  ],
  "fail_closed_conditions": [
    "missing proposal packet",
    "missing owner or backup owner",
    "missing support-boundary classification",
    "missing revert or demotion path for support-boundary-impacting change",
    "missing evidence surface for selected review class",
    "claims wider than release, support, package, adoption, or security evidence"
  ],
  "publication_rules": [
    "resolve milestone targeting from the real GitHub milestone returned by the API",
    "use GitHub labels and issue blockers instead of prose-only dependency lists when publishing",
    "publish generated summaries under tmp/reports/governance-sustainability/",
    "keep checked-in contracts under tests/tooling/fixtures/governance_sustainability/",
    "project extension-review metadata through tmp/artifacts/governance-sustainability/extension-review-publication.json"
  ]
}
