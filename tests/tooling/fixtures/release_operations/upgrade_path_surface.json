{
  "contract_id": "objc3c.release.operations.upgrade.path.surface.v1",
  "schema_version": 1,
  "upgrade_guides": [
    "docs/tutorials/getting_started.md",
    "docs/tutorials/build_run_verify.md",
    "docs/tutorials/guided_walkthrough.md",
    "docs/tutorials/objc2_to_objc3_migration.md"
  ],
  "upstream_runbooks": [
    "docs/runbooks/objc3c_release_foundation.md",
    "docs/runbooks/objc3c_packaging_channels.md",
    "docs/runbooks/objc3c_release_operations.md"
  ],
  "upgrade_path_classes": [
    {
      "path_id": "stable-to-stable-patch",
      "from": "1.0.x",
      "to": "1.0.x",
      "upgrade_contract": "in-place",
      "requires_warning": false,
      "revert_channel": "local-installer"
    },
    {
      "path_id": "stable-to-candidate-minor",
      "from": "1.0.x",
      "to": "1.1.0-rc.x",
      "upgrade_contract": "qualified-with-generated-warning",
      "requires_warning": true,
      "revert_channel": "local-installer"
    },
    {
      "path_id": "stable-to-preview-minor",
      "from": "1.0.x",
      "to": "1.2.0-preview.x",
      "upgrade_contract": "blocked-until-generated-conversion-replay-evidence",
      "requires_warning": true,
      "revert_channel": "offline-bundle"
    }
  ],
  "required_channel_inputs": [
    "portable-archive",
    "local-installer",
    "offline-bundle"
  ],
  "upgrade_publication_rules": [
    "same-major upgrade paths only",
    "warning-required paths must emit generated warnings",
    "blocked paths must retain explicit revert guidance",
    "missing package-channel input fails publication"
  ]
}
