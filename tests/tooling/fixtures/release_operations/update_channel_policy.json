{
  "contract_id": "objc3c.release.operations.update.channel.policy.v1",
  "schema_version": 1,
  "default_channel": "stable",
  "missing_channel_behavior": "fail-closed",
  "channel_selection_rule": "only channel_id values listed in channel_order may be published",
  "channel_order": [
    "stable",
    "candidate",
    "nightly",
    "preview"
  ],
  "channels": [
    {
      "channel_id": "stable",
      "precedence": 1,
      "support_status": "supported",
      "warning_classes": [
        "deprecated-channel",
        "support-window-expired"
      ],
      "permitted_upgrade_targets": [
        "stable",
        "candidate"
      ],
      "revert_channel": "local-installer",
      "requires_generated_warning": false
    },
    {
      "channel_id": "candidate",
      "precedence": 2,
      "support_status": "release-drill",
      "warning_classes": [
        "candidate-channel",
        "downgrade-available"
      ],
      "permitted_upgrade_targets": [
        "stable",
        "candidate",
        "preview"
      ],
      "revert_channel": "local-installer",
      "requires_generated_warning": true
    },
    {
      "channel_id": "nightly",
      "precedence": 3,
      "support_status": "nightly",
      "warning_classes": [
        "nightly-channel",
        "nightly-rollback-required",
        "downgrade-available"
      ],
      "permitted_upgrade_targets": [
        "nightly",
        "stable"
      ],
      "revert_channel": "offline-bundle",
      "requires_generated_warning": true
    },
    {
      "channel_id": "preview",
      "precedence": 4,
      "support_status": "blocked",
      "warning_classes": [
        "preview-channel",
        "cross-major-unsupported",
        "data-format-conversion-blocked",
        "revert-recommended"
      ],
      "permitted_upgrade_targets": [
        "preview"
      ],
      "revert_channel": "offline-bundle",
      "requires_generated_warning": true
    }
  ],
  "warning_classes": [
    {
      "warning_id": "candidate-channel",
      "severity": "info"
    },
    {
      "warning_id": "preview-channel",
      "severity": "warn"
    },
    {
      "warning_id": "nightly-channel",
      "severity": "warn"
    },
    {
      "warning_id": "nightly-rollback-required",
      "severity": "warn"
    },
    {
      "warning_id": "downgrade-available",
      "severity": "info"
    },
    {
      "warning_id": "deprecated-channel",
      "severity": "warn"
    },
    {
      "warning_id": "support-window-expired",
      "severity": "error"
    },
    {
      "warning_id": "cross-major-unsupported",
      "severity": "error"
    },
    {
      "warning_id": "runtime-metadata-contract-mismatch",
      "severity": "error"
    },
    {
      "warning_id": "data-format-conversion-blocked",
      "severity": "error"
    },
    {
      "warning_id": "revert-recommended",
      "severity": "warn"
    }
  ]
}
