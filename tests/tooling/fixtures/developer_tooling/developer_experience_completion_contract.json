  "template_compile_contract": {
    "example_id": "auroraBoard",
    "materializer_action": "materialize-project-template",
    "compile_action": "compile-objc3c",
    "source_origin": "showcase/auroraBoard/main.objc3",
    "materialized_source": "tmp/artifacts/project-template/auroraBoard/src/main.objc3",
    "artifact_root": "tmp/artifacts/project-template/auroraBoard/build",
    "emit_prefix": "module",
    "public_compile_command": "npm run objc3c -- compile-objc3c tmp/artifacts/project-template/auroraBoard/src/main.objc3 --out-dir tmp/artifacts/project-template/auroraBoard/build --emit-prefix module"
  },
  "migration_examples": {
    "required_public_actions": [
      "analyze-migration-source",
      "rewrite-migration-source",
      "validate-migration-workflow"
    ],
    "positive_input": "tests/tooling/fixtures/adoption_legibility/migration_inputs/objc2_swift_cpp_positive.json",
    "expected_rewrite_output": "tests/tooling/fixtures/adoption_legibility/migration_outputs/objc2_swift_cpp_positive_rewritten.objc3",
    "negative_input": "tests/tooling/fixtures/adoption_legibility/migration_inputs/objc2_swift_cpp_negative.json",
    "expected_negative_diagnostics": "tests/tooling/fixtures/adoption_legibility/migration_outputs/objc2_swift_cpp_negative_diagnostics.json",
    "required_fenced_doc_commands": [
      {
        "source_path": "docs/tutorials/objc2_to_objc3_migration.md",
        "command": "npm run objc3c -- analyze-migration-source tests/tooling/fixtures/adoption_legibility/migration_inputs/objc2_swift_cpp_positive.json"
      },
      {
        "source_path": "docs/tutorials/objc2_to_objc3_migration.md",
        "command": "npm run objc3c -- rewrite-migration-source tests/tooling/fixtures/adoption_legibility/migration_inputs/objc2_swift_cpp_positive.json --output tmp/artifacts/migration-analyzer/objc2-swift-cpp-positive/rewritten.objc3"
      },
      {
        "source_path": "docs/tutorials/objc2_to_objc3_migration.md",
        "command": "npm run objc3c -- validate-migration-workflow"
      }
    ]
  },
  "diagnostic_fixit_metadata": {
    "bridge_contract": "tests/tooling/fixtures/developer_tooling/editor_diagnostic_bridge_contract.json",
    "required_diagnostic_fields": [
      "code",
      "severity",
      "phase",
      "category",
      "span",
      "message",
      "explanation",
      "fixits",
      "recovery"
    ],
    "required_code_action_codes": [
      "O3C004",
      "O3P104"
    ],
    "minimum_machine_applicable_fixit_count": 2
  },
  "support_boundary": "This contract proves a normal developer path over checked-in sources: project templates expose a compile command contract, migration tooling has checked-in input/output examples, and common first-run diagnostics carry structured fix-it and recovery metadata. It does not claim a full IDE, full ObjC2 acceptance, or release-channel behavior."
