{
  "contract_id": "objc3c.adoption_legibility.artifact_contract.v1",
  "schema_version": 1,
  "schema": "schemas/objc3c-adoption-legibility-evidence-v1.schema.json",
  "runbook": "docs/runbooks/objc3c_adoption_legibility.md",
  "owner_sections": [
    "owner_contracts",
    "public_workflow",
    "boundary_inventory",
    "artifact_contract",
    "evaluator_path",
    "adoption_replay",
    "comparison_matrix",
    "onboarding",
    "candidate_claims",
    "claim_audit"
  ],
  "owner_contracts": {
    "public_claim_owner": {
      "source_contract": "tests/tooling/fixtures/adoption_legibility/public_claim_policy.json",
      "artifact_section": "candidate_claims",
      "publication_projection": "evaluator_publication.candidate_claim_classes",
      "blocker_projection": "claim_audit.blocker_metadata.public_claim_policy"
    },
    "adoption_comparison_owner": {
      "source_contract": "tests/tooling/fixtures/adoption_legibility/capability_comparison_semantics.json",
      "artifact_section": "comparison_matrix",
      "publication_projection": "evaluator_publication.comparison_axes",
      "blocker_projection": "claim_audit.blocker_metadata.capability_comparison"
    },
    "adoption_replay_owner": {
      "source_contract": "tests/tooling/fixtures/adoption_legibility/adoption_replay_semantics.json",
      "artifact_section": "adoption_replay",
      "publication_projection": "evaluator_publication.adoption_replay_phases",
      "blocker_projection": "claim_audit.blocker_metadata.adoption_replay"
    },
    "publication_owner": {
      "source_contract": "scripts/publish_objc3c_adoption_legibility_metadata.py",
      "artifact_section": "public_workflow",
      "publication_projection": "evaluator_publication",
      "blocker_projection": "claim_audit.blocker_metadata.metadata_publication"
    }
  },
  "hard_cutover_claim_policy": {
    "retired_source_acceptance_claims_allowed": false,
    "retired_surface_acceptance_claims_allowed": false,
    "manual_adoption_metrics_allowed": false,
    "evidence_log_allowed": false,
    "wrapper_only_publication_allowed": false,
    "required_owner_contract_module": "scripts/objc3c_workflow/actions/ecosystem_publication_owner_contracts.py"
  },
  "source_contracts": [
    "tests/tooling/fixtures/adoption_legibility/boundary_inventory.json",
    "tests/tooling/fixtures/adoption_legibility/public_claim_policy.json",
    "tests/tooling/fixtures/adoption_legibility/capability_comparison_semantics.json",
    "tests/tooling/fixtures/adoption_legibility/adoption_replay_semantics.json",
    "tests/tooling/fixtures/adoption_legibility/migration_analyzer_contract.json"
  ],
  "artifact_root": "tmp/artifacts/adoption-legibility/",
  "report_root": "tmp/reports/adoption-legibility/",
  "generated_artifacts": [
    {
      "artifact_id": "adoption_legibility_evidence",
      "path": "checked_outputs/adoption-legibility/adoption-legibility-contract.json",
      "schema": "schemas/objc3c-adoption-legibility-evidence-v1.schema.json"
    },
    {
      "artifact_id": "evaluator_publication",
      "path": "tmp/artifacts/adoption-legibility/evaluator-publication.json",
      "schema": "schemas/objc3c-adoption-legibility-evidence-v1.schema.json"
    }
  ],
  "generated_reports": [
    "tmp/reports/adoption-legibility/boundary-inventory-summary.json",
    "tmp/reports/adoption-legibility/public-claim-policy-summary.json",
    "tmp/reports/adoption-legibility/capability-comparison-summary.json",
    "tmp/reports/adoption-legibility/adoption-replay-summary.json",
    "tmp/reports/adoption-legibility/artifact-contract-summary.json"
  ],
  "claim_rules": [
    "All adoption machine-owned artifacts must be regenerated from checked-in source contracts.",
    "tmp/ artifacts and reports are replay outputs, never canonical source authority.",
    "Evaluator, adoption replay, comparison, onboarding, and candidate-claim evidence must share one generated evidence contract.",
    "Migration examples must be checked-in input/output fixtures, with tmp reports treated only as replay outputs.",
    "Unsupported or deferred behavior must be visible in claim_audit.demoted_or_out_of_scope_claims.",
    "Public-claim, comparison, adoption replay, and publication blockers must project through claim_audit.blocker_metadata.",
    "Adoption publication actions must have owner contracts and may not be wrapper-only.",
    "Adoption claims must not imply Objective-C 2 retired-source acceptance, automatic conversion, alternate old-surface support, or adoption counts."
  ],
  "metadata_publication_rules": [
    "Publication consumes the generated evidence artifact and does not widen public claims.",
    "Publication exposes boundary inventory, adoption replay phases, comparison axes, onboarding surfaces, and forbidden claim wording together.",
    "Publication keeps validate-adoption-legibility and publish-adoption-legibility as the only public adoption action names."
  ],
  "required_generation_scripts": [
    "scripts/build_adoption_legibility_boundary_inventory_summary.py",
    "scripts/build_adoption_legibility_public_claim_policy_summary.py",
    "scripts/build_adoption_legibility_capability_comparison_summary.py",
    "scripts/build_adoption_legibility_adoption_replay_summary.py",
    "scripts/build_adoption_legibility_artifact_contract_summary.py",
    "scripts/build_objc3c_adoption_legibility_evidence.py"
  ]
}
