{
  "contract_id": "objc3c.adoption_legibility.migration_playbook_semantics.v1",
  "schema_version": 1,
  "owner_section": "migration_playbook",
  "owner_contract": {
    "owner": "migration_playbook_owner",
    "artifact_section": "migration_playbook",
    "publication_projection": "evaluator_publication.migration_phases",
    "blocker_projection": "claim_audit.blocker_metadata.migration_playbook"
  },
  "package_bridge": "objc3c",
  "depends_on": [
    "tests/tooling/fixtures/adoption_legibility/public_claim_policy.json",
    "tests/tooling/fixtures/adoption_legibility/capability_comparison_semantics.json",
    "tests/tooling/fixtures/package_ecosystem/package_authoring_workflow_contract.json",
    "tests/tooling/fixtures/application_architecture_testing/artifact_contract.json",
    "tests/tooling/fixtures/long_horizon_operations/migration_rollback_support_window_semantics.json"
  ],
  "playbook_phases": [
    {
      "phase_id": "orient",
      "sequence": 1,
      "description": "Start from evaluator-facing docs and public command discovery before choosing a migration path.",
      "required_paths": [
        "README.md",
        "site/index.md",
        "docs/tutorials/getting_started.md",
        "docs/runbooks/objc3c_public_command_surface.md"
      ],
      "required_actions": [
        "build-public-command-surface",
        "check-documentation-surface"
      ]
    },
    {
      "phase_id": "compile-showcase-anchors",
      "sequence": 2,
      "description": "Compile and validate ObjC2-shaped, Swift-facing, and C++-facing showcase anchors before publishing any adoption guidance.",
      "required_paths": [
        "showcase/auroraBoard/main.objc3",
        "showcase/signalMesh/main.objc3",
        "showcase/patchKit/main.objc3",
        "showcase/portfolio.json"
      ],
      "required_actions": [
        "compile-objc3c",
        "check-showcase-surface",
        "validate-showcase"
      ]
    },
    {
      "phase_id": "package-and-application-workspace",
      "sequence": 3,
      "description": "Move migration examples into deterministic package and canonical application workflow state.",
      "required_paths": [
        "docs/runbooks/objc3c_package_ecosystem.md",
        "docs/runbooks/objc3c_application_architecture_testing.md",
        "tests/tooling/fixtures/package_ecosystem/package_authoring_workflow_contract.json",
        "tests/tooling/fixtures/application_architecture_testing/artifact_contract.json"
      ],
      "required_actions": [
        "build-package-lock",
        "validate-package-ecosystem",
        "validate-application-architecture"
      ]
    },
    {
      "phase_id": "support-and-rollback-check",
      "sequence": 4,
      "description": "Check compatibility-report boundaries, support-window status, rollback-risk inventory, and long-horizon evidence before public adoption claims.",
      "required_paths": [
        "docs/runbooks/objc3c_release_operations.md",
        "docs/runbooks/objc3c_long_horizon_operations.md",
        "tests/tooling/fixtures/long_horizon_operations/migration_rollback_support_window_semantics.json"
      ],
      "required_actions": [
        "validate-release-operations",
        "publish-release-operations",
        "validate-long-horizon-operations"
      ]
    }
  ],
  "interop_guidance_axes": [
    {
      "axis_id": "objc2-object-model",
      "showcase_anchor": "showcase/auroraBoard/main.objc3",
      "runbook_anchor": "docs/runbooks/objc3c_object_model_closure.md",
      "allowed_guidance": "migrate recognizable interface, implementation, protocol, category, and property shapes only where runnable examples and conformance evidence cover them",
      "deferred_behavior": [
        "full Objective-C 2 runtime parity",
        "implicit behavior not represented by checked-in examples"
      ]
    },
    {
      "axis_id": "swift-facing-async",
      "showcase_anchor": "showcase/signalMesh/main.objc3",
      "runbook_anchor": "docs/runbooks/objc3c_concurrency_runtime_closure.md",
      "allowed_guidance": "treat async, executor, and message-send examples as explicit interop contracts, not Swift replacement claims",
      "deferred_behavior": [
        "complete actor parity",
        "unsupported Swift module import behavior"
      ]
    },
    {
      "axis_id": "cpp-facing-systems-interop",
      "showcase_anchor": "showcase/patchKit/main.objc3",
      "runbook_anchor": "docs/runbooks/objc3c_metaprogramming_interop_closure.md",
      "allowed_guidance": "explain imported hooks, macro derives, property behavior, and C/C++ boundary expectations only through checked-in sources and runbooks",
      "deferred_behavior": [
        "ABI parity",
        "zero-cost C++ interop claims"
      ]
    }
  ],
  "required_migration_replay_fields": [
    "source_version",
    "target_version",
    "source_channel",
    "target_channel",
    "package_lock",
    "canonical_application_workspace",
    "compatibility_report",
    "rollback_target"
  ],
  "hard_cutover_truthfulness": {
    "source_compatibility_claims_allowed": false,
    "migration_or_fallback_support_claims_allowed": false,
    "compatibility_report_boundary": "compatibility_report is a replay field for risk inventory only, not a source-compatibility guarantee",
    "rollback_target_boundary": "rollback_target identifies evidence-linked release operations state, not fallback support for retired behavior",
    "wrapper_only_publication_allowed": false
  },
  "publication_policy": {
    "metadata_projection": "evaluator_publication.migration_phases",
    "support_state": "evaluator-ready-with-same-major-porting-orientation-and-evidence-linked-comparison",
    "blocker_metadata_projection": "claim_audit.blocker_metadata.migration_playbook",
    "requires_public_actions": [
      "validate-adoption-legibility",
      "publish-adoption-legibility"
    ]
  },
  "fail_closed_conditions": [
    "playbook phase sequence is missing or out of order",
    "phase omits concrete paths or workflow actions",
    "interop guidance axis omits a runnable showcase anchor",
    "same-major support or rollback evidence is not named",
    "migration replay fields drift from long-horizon support semantics",
    "playbook wording implies source-compatible migration support or fallback support"
  ]
}
