// Positive execution fixture: stdlib runtime handles fail closed across table kinds.
module StdlibRuntimeStorageSubstrateHandles;

extern fn objc3_runtime_stdlib_text_utf8_literal_i32(byte_count: i32, unit_count: i32, valid_utf8: i32) -> i32;
extern fn objc3_runtime_stdlib_text_byte_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_text_last_status_i32() -> i32;
extern fn objc3_runtime_stdlib_collections_array3_i32(first: i32, second: i32, third: i32, count: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_array_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_last_status_i32() -> i32;
extern fn objc3_runtime_reset_for_testing() -> void;

fn main() -> i32 {
  let text_handle = objc3_runtime_stdlib_text_utf8_literal_i32(2, 2, 1);
  let array_handle = objc3_runtime_stdlib_collections_array3_i32(1, 2, 3, 3);
  let cross_kind_result = objc3_runtime_stdlib_text_byte_count_i32(array_handle)
    + objc3_runtime_stdlib_text_last_status_i32()
    - 30647
    + objc3_runtime_stdlib_collections_array_count_i32(text_handle)
    + objc3_runtime_stdlib_collections_last_status_i32()
    - 30638;
  objc3_runtime_reset_for_testing();
  return cross_kind_result
    + objc3_runtime_stdlib_text_byte_count_i32(text_handle)
    + objc3_runtime_stdlib_text_last_status_i32()
    - 30648
    + objc3_runtime_stdlib_collections_array_count_i32(array_handle)
    + objc3_runtime_stdlib_collections_last_status_i32()
    - 30639;
}
