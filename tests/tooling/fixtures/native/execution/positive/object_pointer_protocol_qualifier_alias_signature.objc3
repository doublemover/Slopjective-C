module ObjectPointerProtocolQualifierAliasSignature;

@protocol ClassProtocolFixture
@end

fn chooseId(flag: bool, when_true: id<ClassProtocolFixture>*?, when_false: id<ClassProtocolFixture>*!) -> id<ClassProtocolFixture>*? {
  if (flag) {
    return when_true;
  }
  return when_false;
}

fn chooseClass(flag: bool, when_true: Class<ClassProtocolFixture>*, when_false: Class<ClassProtocolFixture>*) -> Class<ClassProtocolFixture>* {
  if (flag) {
    return when_true;
  }
  return when_false;
}

fn chooseInstancetype(flag: bool, when_true: instancetype<ClassProtocolFixture>*, when_false: instancetype<ClassProtocolFixture>*) -> instancetype<ClassProtocolFixture>* {
  if (flag) {
    return when_true;
  }
  return when_false;
}

fn main() -> i32 {
  let id_value = chooseId(true, 40, 2);
  let class_value = chooseClass(false, 100, 8);
  let instance_value = chooseInstancetype(true, 3, 6);
  return id_value + class_value + instance_value;
