// Positive execution fixture: stdlib concurrency helpers route through runtime ABI.
module StdlibConcurrencyRuntimeHelpers;

extern fn objc3_runtime_spawn_task_i32(task_kind: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_enter_task_group_scope_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_add_task_group_task_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_wait_task_group_next_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_cancel_task_group_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_task_is_cancelled_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_task_on_cancel_i32(executor_tag: i32) -> i32;
extern fn objc3_runtime_executor_hop_i32(value: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_bind_executor_i32(actor_handle: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_enqueue_i32(actor_handle: i32, value: i32, executor_tag: i32) -> i32;
extern fn objc3_runtime_actor_mailbox_drain_next_i32(actor_handle: i32, executor_tag: i32) -> i32;

async fn runConcurrencyRuntimeHelpers() -> i32 __attribute__((objc_executor(global))) {
  let spawn = objc3_runtime_spawn_task_i32(1, 4);
  if (spawn != 111) {
    return 1;
  }

  let child_spawn = objc3_runtime_spawn_task_i32(1, 4);
  if (child_spawn != 111) {
    return 2;
  }

  let detached_spawn = objc3_runtime_spawn_task_i32(2, 4);
  if (detached_spawn != 121) {
    return 3;
  }

  let scope = objc3_runtime_enter_task_group_scope_i32(4);
  if (scope != 1) {
    return 4;
  }

  let add_first = objc3_runtime_add_task_group_task_i32(4);
  if (add_first != 1) {
    return 5;
  }

  let add_second = objc3_runtime_add_task_group_task_i32(4);
  if (add_second != 1) {
    return 6;
  }

  let cancellation_query = objc3_runtime_task_is_cancelled_i32(4);
  if (cancellation_query != 0) {
    return 7;
  }

  let wait_first = objc3_runtime_wait_task_group_next_i32(4);
  if (wait_first != 25) {
    return 8;
  }

  let join_status = objc3_runtime_executor_hop_i32(wait_first, 4);
  if (join_status != 25) {
    return 9;
  }

  let wait_second = objc3_runtime_wait_task_group_next_i32(4);
  if (wait_second != 26) {
    return 10;
  }

  let cancel_checkpoint = objc3_runtime_cancel_task_group_i32(4);
  if (cancel_checkpoint != 31) {
    return 11;
  }

  let cancelled_join = objc3_runtime_task_on_cancel_i32(4);
  if (cancelled_join != 41) {
    return 12;
  }

  let bound_executor = objc3_runtime_actor_bind_executor_i32(41, 4);
  if (bound_executor != 4) {
    return 13;
  }

  let enqueued = objc3_runtime_actor_mailbox_enqueue_i32(41, 13, 4);
  if (enqueued != 13) {
    return 14;
  }

  let drained = objc3_runtime_actor_mailbox_drain_next_i32(41, 4);
  if (drained != 13) {
    return 15;
  }

  return 0;
}

fn main() -> i32 {
  return runConcurrencyRuntimeHelpers();
}
