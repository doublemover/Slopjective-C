module propertyMetadataReflectionRuntime;

@interface Widget
@property (readonly, behavior=Projected, getter=tokenValue) id token;
@property (nonatomic, getter=currentValue, setter=setCurrentValue:, strong, behavior=Observed) id value;
@property (assign, setter=setCount:) i32 count;
@end

@implementation Widget
@property (readonly, behavior=Projected, getter=tokenValue) id token;
@property (nonatomic, getter=currentValue, setter=setCurrentValue:, strong, behavior=Observed) id value;
@property (assign, setter=setCount:) i32 count;
@end
