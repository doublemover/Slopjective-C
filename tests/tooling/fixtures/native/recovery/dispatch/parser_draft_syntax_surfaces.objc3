fn mapStatus(status: i32) -> NSError {
  return status;
}

pure fn traced() -> i32 __attribute__((objc_macro(named("Trace")), objc_macro_package(named("std.metaprogramming.trace")), objc_macro_provenance(named("sha256:abc123")))) {
  return 3;
}

fn risky(value: i32) throws -> i32 {
  if (value == 1) {
    throw 7;
  }
  return value;
}

fn recover() throws -> i32 {
  let direct = try risky(0);
  do {
    let bridged = try? bridgeStatus(1, 0);
    return direct + bridged;
  } catch (NSError* error) {
    return error;
  } catch {
    return 0;
  }
}

fn produce() -> i32 {
  return 5;
}

async fn runTask() -> i32 __attribute__((objc_executor(main))) {
  return await produce();
}

async fn taskGroupEntry() -> i32 __attribute__((objc_executor(global))) {
  task_spawn_child();
  with_task_group_scope();
  task_group_add_task();
  if (task_runtime_cancelled_value()) {
    return task_group_cancel_all();
  }
  sendable_transfer_marker();
  return await task_group_wait_next();
}

async fn detachedTaskEntry() -> i32 __attribute__((objc_executor(named("parser.detached")))) {
  detached_task_create();
  if (task_runtime_cancelled_value()) {
    return task_runtime_on_cancel();
  }
  return await produce();
}

fn main() -> i32 {
  let seed = traced();
  let scratch = seed;
  let callback = ^[__block scratch] (i32 value) {
    scratch = scratch + value;
    return seed + scratch;
  };
  return seed + foreignEntry();
}
