  "artifact_claim_rules": [
    "lockfiles and mirror indexes are generated artifacts, not checked-in source authority",
    "package manifests are generated from checked-in source contracts and must preserve language, ABI, digest, and trust metadata",
    "package ecosystem artifacts must validate against checked-in schemas before publication claims",
    "registry metadata must be generated from lock and mirror evidence",
    "registry indexes must validate exact locked versions, dependency digests, fail-closed hosted/network policy, and replay evidence",
    "offline mirror cache entries and restore receipts must be generated from the same lock-derived mirror index",
    "clean install validation roots must be re-created before package install credibility is claimed",
    "install receipts must be generated from lock, mirror, local registry, publication, and restore metadata that agree",
    "package update and uninstall operation receipts must be deterministic artifact inputs and must preserve locked dependency ordering semantics",
    "mixed-image interop package metadata must be digest-checked across lock, mirror, and local registry artifacts",
    "hosted registry claims remain release-blocking until a later hosted-service evidence path exists"
  ],
  "package_bridge": "objc3c",
  "owner_policy": {
    "channel_owner": "packaging-channels-source",
    "registry_owner": "package-ecosystem-registry-source",
    "package_authoring_owner": "package-ecosystem-authoring-source",
