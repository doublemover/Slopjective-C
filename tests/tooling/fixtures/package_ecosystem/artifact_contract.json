      "public_actions": [
        "validate-package-authoring"
      ],
      "claim_boundary": "package authoring credibility is owned by checked-in workflow contracts, not wrapper-only action dispatch"
    }
  },
  "hard_cutover_publication_policy": {
    "retired_source_acceptance_claims_allowed": false,
    "retired_surface_acceptance_claims_allowed": false,
    "wrapper_only_publication_allowed": false,
    "evidence_log_allowed": false,
