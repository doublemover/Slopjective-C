      "materialize_action": "materialize-canonical-application-workspace",
      "materialize_command": "npm run objc3c -- materialize-canonical-application-workspace",
      "validation_action": "validate-application-architecture",
      "validation_command": "npm run objc3c -- validate-application-architecture",
      "implementation_anchors": [
        "scripts/materialize_objc3c_canonical_application_workspace.py",
        "scripts/check_objc3c_application_architecture_integration.py"
      ]
    },
    {
      "workspace_id": "runnable-package-workspace",
      "source": "stdlib/package_surface.json",
      "materialize_action": "package-runnable-toolchain",
      "materialize_command": "npm run objc3c -- package-runnable-toolchain",
      "validation_action": "validate-runnable-stdlib-program",
      "validation_command": "npm run objc3c -- validate-runnable-stdlib-program",
      "implementation_anchors": [
        "scripts/package_objc3c_runnable_toolchain.ps1",
        "scripts/check_objc3c_runnable_stdlib_program_end_to_end.py"
      ]
    }
  ],
  "generated_roots": {
    "lock_root": "tmp/artifacts/package-ecosystem/locks",
    "mirror_root": "tmp/artifacts/package-ecosystem/mirrors",
    "mirror_cache_root": "tmp/artifacts/package-ecosystem/mirrors/cache",
    "offline_restore_receipt_root": "tmp/artifacts/package-ecosystem/offline-install",
    "report_root": "tmp/reports/package-ecosystem"
  },
  "lockfile_semantics": {
    "lockfile_contract_id": "objc3c.package_ecosystem.lockfile.v1",
    "ordering": "stable-by-package-id-then-source-path",
    "identity_model": "canonical-module-id-plus-source-package-surface",
    "digest_model": "source-path-and-generator-command-digest-inputs",
    "replay_model": "objc3c-package-bridge-action-list"
  },
  "offline_mirror_semantics": {
    "mirror_contract_id": "objc3c.package_ecosystem.offline_mirror.v1",
    "index_model": "lock-derived-package-index",
    "cache_model": "digest-checked-local-artifact-cache-derived-from-locked-package-graph",
    "network_policy": "no-network-during-validation",
    "restore_receipt_contract_id": "objc3c.package_ecosystem.offline_mirror.restore_receipt.v1",
    "failure_model": "missing-cache-entry-extra-package-cache-digest-mismatch-or-network-request-fails-validation"
  },
  "workspace_rules": [
    "workspace roots must come from checked-in package/workspace surfaces",
    "workspace materialization must be replayable from npm run objc3c actions with script paths recorded only as implementation anchors",
    "lockfiles and mirrors are generated artifacts under tmp and never source authority",
    "offline mirrors are valid only when derived from the current lock graph",
    "offline restores must publish a machine-owned restore receipt tied to cache digests and the public package bridge",
    "canonical applications and stdlib programs must pressure the same package semantics"
  ],
  "package_bridge": "objc3c",
  "owner_policy": {
    "channel_owner": "packaging-channels-source",
    "registry_owner": "package-ecosystem-registry-source",
    "package_authoring_owner": "package-ecosystem-authoring-source",
    "package_validation_owner": "package-ecosystem-validation-gate",
    "blocker_owner": "package-ecosystem-blockers",
    "source_authority": "checked-in-package-ecosystem-contracts",
    "evidence_log_allowed": false
  },
  "blocker_metadata": {
    "blocker_owner": "package-ecosystem-blockers",
    "blocking_conditions": [
      "workspace source missing from checked-in package surface",
      "lock replay path absent from objc3c package bridge",
      "mirror index not derived from current lock graph",
      "offline restore receipt missing or cache digest mismatched",
      "offline mirror validation requires network access"
    ]
  },
  "required_actions": [
    "materialize-stdlib-workspace",
    "materialize-canonical-application-workspace",
    "package-runnable-toolchain",
    "validate-stdlib-program",
    "validate-runnable-stdlib-program",
    "validate-application-architecture",
    "validate-runnable-application-architecture"
  ],
  "non_goals": [
    "hosted mirror service",
    "network-backed package restore",
    "hand-authored lockfiles as source authority",
    "mirror indexes disconnected from the lock graph"
  ]
}
