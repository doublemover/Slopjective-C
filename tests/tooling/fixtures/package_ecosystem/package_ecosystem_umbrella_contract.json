  "blocker_metadata": {
    "blocker_owner": "package-ecosystem-blockers",
    "blocking_conditions": [
      "direct @import support lacks locked package provenance or stable diagnostics",
      "hosted registry fixture lacks provider, endpoint, channel, snapshot, lock, trust, cache identity, offline mirror handoff, revocation/yank, or failure-mode metadata",
      "network dependency resolution accepts live fetches or fallback registry success",
      "release-channel publication accepts stale channel, endpoint drift, lock drift, cache tamper, dependency identity drift, or missing provenance",
      "package signing or verification can succeed without source-owned trust policy and reserved release/registry root handling",
      "package install or operation can mutate filesystem before extraction path safety proof",
      "public package action has no owner contract or checked-in source contract",
      "package ecosystem validation omits any direct import, hosted registry, network publication, signing, install distribution, operations, or runnable ecosystem action"
    ]
  },
  "claim_boundary": "Objective-C 3.0 package ecosystem closure is source-owned only when direct @import provenance, hosted registry offline metadata, network dependency resolution, package release-channel publication, signing and verification trust policy, install distribution, package operations, and runnable package ecosystem actions all agree through checked-in contracts and fail closed without live network or fallback registry success."
