{
  "contract_id": "objc3c.package_ecosystem.registry_publication_semantics.v1",
  "surface_kind": "package-ecosystem-registry-publication-semantics",
  "runbook": "docs/runbooks/objc3c_package_ecosystem.md",
  "boundary_inventory": "tests/tooling/fixtures/package_ecosystem/boundary_inventory.json",
  "dependency_lock_policy": "tests/tooling/fixtures/package_ecosystem/dependency_lock_policy.json",
  "local_workspace_mirror_semantics": "tests/tooling/fixtures/package_ecosystem/local_workspace_mirror_semantics.json",
  "publication_inputs": [
    "schemas/objc3c-release-manifest-v1.schema.json",
    "schemas/objc3c-update-manifest-v1.schema.json",
    "schemas/objc3c-package-channels-manifest-v1.schema.json",
    "scripts/build_objc3c_release_manifest.py",
    "scripts/build_objc3c_update_manifest.py",
    "scripts/build_objc3c_package_channels.py",
    "scripts/publish_objc3c_release_operations_metadata.py"
  ],
  "registry_layers": [
    {
      "layer_id": "local-index",
      "support_state": "supported-generated-artifact",
      "source_of_truth": "lockfile plus package metadata",
      "publication_path": "tmp/artifacts/package-ecosystem/registry/local-package-index.json",
      "claim_boundary": "local generated package discovery only"
    },
    {
      "layer_id": "offline-mirror",
      "support_state": "supported-generated-artifact",
      "source_of_truth": "lock-derived mirror index",
      "publication_path": "tmp/artifacts/package-ecosystem/mirrors/offline-mirror-index.json",
      "claim_boundary": "air-gapped local package restore evidence only"
    },
    {
      "layer_id": "publication-metadata",
      "support_state": "supported-generated-artifact",
      "source_of_truth": "release manifest, update manifest, and package-channel manifest",
      "publication_path": "tmp/artifacts/package-ecosystem/registry/publication-metadata.json",
      "claim_boundary": "replayable metadata for package publication planning"
    },
    {
      "layer_id": "hosted-registry",
      "support_state": "unsupported-fail-closed-if-claimed",
      "source_of_truth": "no checked-in source authority",
      "publication_path": "",
      "claim_boundary": "hosted registry, network fetch, auth, moderation, and availability claims fail closed"
    }
  ],
  "publication_rules": [
    "registry metadata must be generated from the lock and mirror evidence",
    "publication metadata may not introduce package identities absent from the lock graph",
    "hosted-registry behavior must fail closed when claimed without checked-in source authority",
    "release and update metadata may reference package ecosystem artifacts only as generated local evidence",
    "offline mirror publication must remain usable without network access"
  ],
  "package_bridge": "objc3c",
  "owner_policy": {
    "channel_owner": "packaging-channels-source",
    "registry_owner": "package-ecosystem-registry-source",
    "package_authoring_owner": "package-ecosystem-authoring-source",
    "package_validation_owner": "package-ecosystem-validation-gate",
    "blocker_owner": "package-ecosystem-blockers",
    "source_authority": "checked-in-package-ecosystem-contracts",
    "evidence_log_allowed": false
  },
  "owner_contracts": {
    "registry_publication_owner": {
      "role": "package-ecosystem-registry-owner",
      "source_contract": "tests/tooling/fixtures/package_ecosystem/registry_publication_semantics.json",
      "required_actions": [
        "validate-package-mirror",
        "validate-package-ecosystem",
        "validate-runnable-package-ecosystem"
      ],
      "required_evidence_contracts": [
        "objc3c.package_ecosystem.registry_publication_semantics.v1",
        "objc3c.package_ecosystem.artifact_contract.v1"
      ],
      "claim_boundary": "local generated registry metadata only; hosted registry availability and package-manager parity are release-blocking overclaims"
    }
  },
  "claim_truth_policy": {
    "retired_source_acceptance_claims_allowed": false,
    "retired_surface_acceptance_claims_allowed": false,
    "hosted_registry_claim_allowed": false,
    "evidence_log_allowed": false,
    "wrapper_only_allowed": false
  },
  "blocker_metadata": {
    "blocker_owner": "package-ecosystem-blockers",
    "blocking_conditions": [
      "hosted registry claimed as supported",
      "publication metadata contains an unlocked package identity",
      "offline mirror validation requires network access",
      "registry index is hand-authored instead of generated",
      "release/update metadata drifts from package ecosystem evidence",
      "registry publication owner contract is missing",
      "registry publication action is wrapper-only"
    ]
  },
  "required_actions": [
    "build-package-channels",
    "build-release-manifest",
    "build-update-manifest",
    "publish-release-operations",
    "validate-release-operations",
    "validate-release-operations-end-to-end"
  ],
  "release_blocking_conditions": [
    "hosted registry claimed as supported",
    "publication metadata contains an unlocked package identity",
    "offline mirror validation requires network access",
    "registry index is hand-authored instead of generated",
    "release/update metadata drifts from package ecosystem evidence"
  ]
}
