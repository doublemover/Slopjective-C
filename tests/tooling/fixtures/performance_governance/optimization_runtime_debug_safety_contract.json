  "runtime_debug_safety_boundaries": [
    {
      "boundary_id": "exact-target-devirtualization-runtime-safety",
      "pass_id": "devirtualization",
      "optimized_surface": "exact-target message-send direct dispatch",
      "deoptimization_boundary": "class, category, method, or runtime-cache generation drift invalidates the optimized site before direct dispatch can claim success",
      "invalidation_boundary": "receiver_static_type, selector_resolution, callee_body_identity, class_generation, category_generation, method_generation, runtime_cache_version, runtime_metadata, and package/import proof state are invalidated",
      "side_effect_replay_boundary": "the direct dispatch candidate must preserve ownership and side-effect summaries from the original message send",
      "debug_source_map_preservation": "source_map_debug_identity and line_table_debug_status must remain PRESERVED for the optimized callsite",
      "required_proof_ids": [
        "sealed_final_dispatch_evidence",
        "static_receiver_type_proof",
        "exact_method_target_identity",
        "class_category_method_mutation_invalidation",
        "runtime_cache_version_dependency",
        "source_map_debug_identity",
        "line_table_debug_status",
        "side_effect_summary",
        "invalidation_completeness"
      ],
      "fail_closed_if_missing": true
    },
    {
      "boundary_id": "method-inlining-runtime-debug-safety",
      "pass_id": "method-inlining",
      "optimized_surface": "safe scalar method/function inlining subset",
      "deoptimization_boundary": "callee generation, class/category/protocol generation, ABI, package/import, or runtime metadata drift rejects the inline candidate before speedup publication",
      "invalidation_boundary": "callee body identity, callee generation, local value, ownership transfer, source-map inline frame, diagnostic location, runtime metadata, source/debug/runtime identity, runtime generation dependency, and invalidation replay are invalidated",
      "side_effect_replay_boundary": "only pure, no-call, no-runtime-helper, no-allocation, no-ownership-transfer candidates can inline; side-effecting candidates reject fail-closed",
      "debug_source_map_preservation": "debug_identity_preservation must bind source-map ids, inline-frame id, diagnostic location id, and preserved line-table status",
      "required_proof_ids": [
        "callee_body_identity",
        "scalar_inline_subset",
        "ownership_arc_effects_replay",
        "source_map_inline_frame_preservation",
        "diagnostic_location_preservation",
        "source_identity_preservation",
        "debug_identity_preservation",
        "runtime_identity_preservation",
        "runtime_invalidation_replay",
        "side_effect_summary"
      ],
      "fail_closed_if_missing": true
    },
    {
      "boundary_id": "cache-aware-dispatch-runtime-debug-safety",
      "pass_id": "cache-aware-dispatch",
      "optimized_surface": "runtime-owned checked cache-aware dispatch helper",
      "deoptimization_boundary": "strict status-envelope failure aborts instead of silently claiming a cached value",
      "invalidation_boundary": "runtime_cache_version, selector_resolution, and source_map_debug cache-aware dispatch proof state are invalidated",
      "side_effect_replay_boundary": "dispatch miss behavior and side-effect replay remain runtime-owned by the checked helper and cannot be reimplemented by compiler-local cache speculation",
      "debug_source_map_preservation": "source-map and debug-visible cache-aware site anchors are preserved for optimized dispatch sites",
      "required_proof_ids": [
        "runtime_cache_version_dependency",
        "source_map_debug_identity",
        "line_table_debug_status",
        "semantic_equivalence",
        "invalidation_completeness"
      ],
      "fail_closed_if_missing": true
    }
  ],
