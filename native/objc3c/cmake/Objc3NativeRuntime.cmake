include_guard(GLOBAL)
get_filename_component(_OBJC3_NATIVE_RUNTIME_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/Objc3LinuxRuntime.cmake")
set(OBJC3_NATIVE_RUNTIME_PROFILE linux-x86_64-libobjc2 CACHE STRING "Qualified native Linux runtime")
set(OBJC3_LIBOBJC2_SOURCE_DIR "" CACHE PATH "Pinned libobjc2 source")
set(OBJC3_LIBOBJC2_BUILD_DIR "" CACHE PATH "Pinned libobjc2 build/stage")
set(OBJC3_ROBIN_MAP_SOURCE_DIR "" CACHE PATH "Pinned robin-map source")

function(objc3c_configure_native_runtime)
  cmake_parse_arguments(ARG "" "PROFILE;SOURCE_DIR;BUILD_DIR;ROBIN_MAP_SOURCE_DIR" "" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown runtime arguments: ${ARG_UNPARSED_ARGUMENTS}")
  endif()
  if(ARG_PROFILE AND NOT ARG_PROFILE STREQUAL "linux-x86_64-libobjc2")
    message(FATAL_ERROR "The current native runtime profile is linux-x86_64-libobjc2")
  endif()
  if(NOT ARG_SOURCE_DIR)
    set(ARG_SOURCE_DIR "${OBJC3_LIBOBJC2_SOURCE_DIR}")
  endif()
  if(NOT ARG_BUILD_DIR)
    set(ARG_BUILD_DIR "${OBJC3_LIBOBJC2_BUILD_DIR}")
  endif()
  if(NOT ARG_ROBIN_MAP_SOURCE_DIR)
    set(ARG_ROBIN_MAP_SOURCE_DIR "${OBJC3_ROBIN_MAP_SOURCE_DIR}")
  endif()
  objc3c_configure_linux_runtime("${ARG_SOURCE_DIR}" "${ARG_BUILD_DIR}" "${ARG_ROBIN_MAP_SOURCE_DIR}")
  set(OBJC3_LIBOBJC2_SOURCE_DIR "${ARG_SOURCE_DIR}" PARENT_SCOPE)
  set(OBJC3_LIBOBJC2_BUILD_DIR "${ARG_BUILD_DIR}" PARENT_SCOPE)
  set(OBJC3_ROBIN_MAP_SOURCE_DIR "${ARG_ROBIN_MAP_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

function(objc3c_add_native_object_adapter)
  cmake_parse_arguments(ARG "" "TARGET" "" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_TARGET OR NOT TARGET objc3_runtime::objc)
    message(FATAL_ERROR "Configure the runtime before objc3c_add_native_object_adapter(TARGET name)")
  endif()
  set(_source "${_OBJC3_NATIVE_RUNTIME_REPO_ROOT}/native/objc3c/src/runtime/platform/objc3_native_object_adapter.mm")
  set_source_files_properties("${_source}" PROPERTIES LANGUAGE CXX)
  add_library("${ARG_TARGET}" STATIC "${_source}")
  target_compile_definitions("${ARG_TARGET}" PRIVATE OBJC3_NATIVE_RUNTIME_GNUSTEP=1)
  target_include_directories("${ARG_TARGET}" PUBLIC "${_OBJC3_NATIVE_RUNTIME_REPO_ROOT}/native/objc3c/src")
  target_link_libraries("${ARG_TARGET}" PUBLIC objc3_native_runtime_profile)
endfunction()

function(objc3c_install_native_runtime)
  cmake_parse_arguments(ARG "" "TARGET;DESTINATION" "" ${ARGN})
  if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_TARGET OR NOT ARG_DESTINATION OR NOT TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "Usage: objc3c_install_native_runtime(TARGET adapter DESTINATION relative-prefix)")
  endif()
  install(TARGETS "${ARG_TARGET}" ARCHIVE DESTINATION "${ARG_DESTINATION}/lib" COMPONENT Runtime)
  get_filename_component(_runtime_libdir "${OBJC3_NATIVE_RUNTIME_LIBOBJC2_DLL}" DIRECTORY)
  install(FILES "${OBJC3_NATIVE_RUNTIME_LIBOBJC2_DLL}" "${_runtime_libdir}/libobjc.so"
    DESTINATION "${ARG_DESTINATION}/lib" COMPONENT Runtime)
  install(FILES "${OBJC3_NATIVE_RUNTIME_GENERATED_INCLUDE_DIR}/objc-config.h"
    DESTINATION "${ARG_DESTINATION}/include/objc" COMPONENT Runtime)
  install(FILES "${_OBJC3_NATIVE_RUNTIME_REPO_ROOT}/native/objc3c/src/runtime/platform/objc3_native_object_adapter.h"
    DESTINATION "${ARG_DESTINATION}/include/runtime/platform" COMPONENT Runtime)
  install(FILES "${_OBJC3_NATIVE_RUNTIME_REPO_ROOT}/scripts/objc3c_toolchain_runtime/runtime-profile.json"
    DESTINATION "${ARG_DESTINATION}/share/objc3c/runtime" COMPONENT Runtime)
  install(FILES "${OBJC3_LIBOBJC2_SOURCE_DIR}/COPYING"
    DESTINATION "${ARG_DESTINATION}/share/licenses/libobjc2" COMPONENT Runtime)
  install(FILES "${OBJC3_ROBIN_MAP_SOURCE_DIR}/LICENSE"
    DESTINATION "${ARG_DESTINATION}/share/licenses/robin-map" COMPONENT Runtime)
  install(DIRECTORY "${OBJC3_LIBOBJC2_SOURCE_DIR}/objc"
    DESTINATION "${ARG_DESTINATION}/include" COMPONENT Runtime FILES_MATCHING PATTERN "*.h")
endfunction()
