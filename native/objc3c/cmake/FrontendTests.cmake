include_guard(GLOBAL)

# Record the executable owning each CTest at registration. Several profiles
# intentionally run the same executable with different arguments.
function(objc3c_add_frontend_test)
  cmake_parse_arguments(PARSE_ARGV 0 _test "" "NAME;TARGET" "COMMAND")
  if(_test_UNPARSED_ARGUMENTS OR NOT _test_NAME OR NOT _test_COMMAND)
    message(FATAL_ERROR "Frontend tests require NAME and COMMAND")
  endif()
  if(_test_TARGET)
    list(FIND _test_COMMAND "$<TARGET_FILE:${_test_TARGET}>" _command_index)
    if(_command_index EQUAL -1)
      message(FATAL_ERROR "Wrapped frontend CTest ${_test_NAME} must pass its owned target to COMMAND")
    endif()
  else()
    list(GET _test_COMMAND 0 _test_TARGET)
    set(_command_index 0)
  endif()
  if(NOT TARGET "${_test_TARGET}")
    message(FATAL_ERROR "Frontend CTest ${_test_NAME} has no owned target ${_test_TARGET}")
  endif()
  get_target_property(_type "${_test_TARGET}" TYPE)
  if(NOT _type STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "Frontend CTest ${_test_NAME} must own an executable target")
  endif()
  get_target_property(_assertions "${_test_TARGET}" OBJC3C_TEST_ASSERTIONS_ENABLED)
  if(NOT _assertions)
    target_compile_options("${_test_TARGET}" PRIVATE -UNDEBUG
      "SHELL:-include '${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/test_assertion_policy.h'")
    set_property(TARGET "${_test_TARGET}" PROPERTY OBJC3C_TEST_ASSERTIONS_ENABLED TRUE)
  endif()
  add_test(NAME "${_test_NAME}" COMMAND ${_test_COMMAND})
  set_tests_properties("${_test_NAME}" PROPERTIES
    OBJC3C_OWNED_TARGET "${_test_TARGET}" OBJC3C_OWNED_COMMAND_INDEX "${_command_index}")
endfunction()

function(objc3c_write_frontend_test_inventory)
  if(DEFINED OBJC3C_NATIVE_TEST_INPUT_SHA256)
    string(LENGTH "${OBJC3C_NATIVE_TEST_INPUT_SHA256}" _test_hash_length)
    if(NOT _test_hash_length EQUAL 64 OR NOT OBJC3C_NATIVE_TEST_INPUT_SHA256 MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Invalid native qualification input digest")
    endif()
  endif()
  get_property(_frontend_tests DIRECTORY PROPERTY TESTS)
  set(_frontend_test_rows "")
  set(_configured_targets)
  foreach(_test IN LISTS _frontend_tests)
    get_test_property("${_test}" OBJC3C_OWNED_TARGET _target)
    get_test_property("${_test}" OBJC3C_OWNED_COMMAND_INDEX _command_index)
    if(NOT _target OR NOT TARGET "${_target}")
      message(FATAL_ERROR "Frontend CTest ${_test} has no registered executable owner")
    endif()
    if(NOT _target IN_LIST _configured_targets)
      target_link_libraries(${_target} PRIVATE objc3c_build_defaults)
      if(DEFINED OBJC3C_NATIVE_TEST_INPUT_SHA256 AND _target MATCHES "_test$")
        # CTest reclaims linked executables but keeps Ninja object files. Bind
        # their commands to test bytes even when the source mtime is unchanged.
        target_compile_definitions(${_target} PRIVATE
          "OBJC3C_NATIVE_TEST_INPUT_SHA256=${OBJC3C_NATIVE_TEST_INPUT_SHA256}")
      endif()
      list(APPEND _configured_targets "${_target}")
    endif()
    if(_frontend_test_rows)
      string(APPEND _frontend_test_rows ",\n")
    endif()
    string(APPEND _frontend_test_rows
      "    {\"name\":\"${_test}\",\"target\":\"${_target}\",\"executable\":\"$<TARGET_FILE:${_target}>\",\"command_index\":${_command_index}}")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/frontend-test-targets.json"
    CONTENT "{\n  \"tests\": [\n${_frontend_test_rows}\n  ]\n}\n")
endfunction()
