include_guard(GLOBAL)

# Record the executable owning each CTest at registration. Several profiles
# intentionally run the same executable with different arguments.
function(objc3c_add_frontend_test)
  cmake_parse_arguments(PARSE_ARGV 0 _test "" "NAME;TARGET" "COMMAND")
  if(_test_UNPARSED_ARGUMENTS OR NOT _test_NAME OR NOT _test_COMMAND)
    message(FATAL_ERROR "Frontend tests require NAME and COMMAND")
  endif()
  if(NOT _test_TARGET)
    list(GET _test_COMMAND 0 _test_TARGET)
  endif()
  if(NOT TARGET "${_test_TARGET}")
    message(FATAL_ERROR "Frontend CTest ${_test_NAME} has no owned target ${_test_TARGET}")
  endif()
  get_target_property(_type "${_test_TARGET}" TYPE)
  if(NOT _type STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "Frontend CTest ${_test_NAME} must own an executable target")
  endif()
  add_test(NAME "${_test_NAME}" COMMAND ${_test_COMMAND})
  set_tests_properties("${_test_NAME}" PROPERTIES OBJC3C_OWNED_TARGET "${_test_TARGET}")
endfunction()

function(objc3c_write_frontend_test_inventory)
  get_property(_frontend_tests DIRECTORY PROPERTY TESTS)
  set(_frontend_test_rows "")
  set(_configured_targets)
  foreach(_test IN LISTS _frontend_tests)
    get_test_property("${_test}" OBJC3C_OWNED_TARGET _target)
    if(NOT _target OR NOT TARGET "${_target}")
      message(FATAL_ERROR "Frontend CTest ${_test} has no registered executable owner")
    endif()
    if(NOT _target IN_LIST _configured_targets)
      target_compile_options(${_target} PRIVATE -UNDEBUG
        "SHELL:-include '${_objc3_repo}/native/objc3c/tests/test_assertion_policy.h'")
      target_link_libraries(${_target} PRIVATE objc3c_build_defaults)
      list(APPEND _configured_targets "${_target}")
    endif()
    if(_frontend_test_rows)
      string(APPEND _frontend_test_rows ",\n")
    endif()
    string(APPEND _frontend_test_rows
      "    {\"name\":\"${_test}\",\"target\":\"${_target}\",\"executable\":\"$<TARGET_FILE:${_target}>\"}")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/frontend-test-targets.json"
    CONTENT "{\n  \"tests\": [\n${_frontend_test_rows}\n  ]\n}\n")
endfunction()
