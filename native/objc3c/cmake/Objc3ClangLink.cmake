function(objc3c_link_clang_components target)
  if(OBJC3C_LINK_CLANG_CPP)
    if(NOT TARGET clang-cpp)
      message(FATAL_ERROR "The selected foundation does not provide clang-cpp")
    endif()
    target_link_libraries(${target} PRIVATE clang-cpp)
  else()
    target_link_libraries(${target} PRIVATE ${ARGN})
  endif()
endfunction()

function(objc3c_verify_clang_linkage)
  if(NOT OBJC3C_LINK_CLANG_CPP)
    return()
  endif()
  get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if(_target STREQUAL "objc3c_clang_foundation" OR
       "objc3c_clang_foundation" IN_LIST _links OR
       "objc3c_frontend_v2" IN_LIST _links OR "clang-cpp" IN_LIST _links)
      foreach(_link IN LISTS _links)
        if(_link MATCHES "^clang[A-Z]")
          message(FATAL_ERROR "${_target} mixes shared clang-cpp with static Clang component ${_link}")
        endif()
      endforeach()
    endif()
  endforeach()
endfunction()
