include_guard(GLOBAL)
# Native consumers execute the compiler and its output; cross builds are separate.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Native Linux compiler/runtime consumers require a native host")
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _objc3_linux_processor)
  if(_objc3_linux_processor MATCHES "^(x86_64|amd64)$")
    set(OBJC3_LINUX_NATIVE_HOST linux-x86_64)
    set(OBJC3_LINUX_NATIVE_TARGET x86_64-unknown-linux-gnu)
  elseif(_objc3_linux_processor MATCHES "^(aarch64|arm64)$")
    set(OBJC3_LINUX_NATIVE_HOST linux-aarch64)
    set(OBJC3_LINUX_NATIVE_TARGET aarch64-unknown-linux-gnu)
  else()
    message(FATAL_ERROR "Native Linux development requires x86-64 or AArch64")
  endif()
endif()
