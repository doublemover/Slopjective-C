    "languages": ["Objective-C C17", "Objective-C++ C++20"],
    "ownership": "ARC",
    "leaves": [
      "strong Objective-C object",
      "zeroing weak Objective-C object",
      "unsafe-unretained Objective-C object",
      "strong Block"
    ],
    "callable_forms": [
      "Objective-C class/instance/protocol/super messages",
      "heap and global Block invocation",
      "nonvariadic ordinary C-convention functions",
      "function-pointer callbacks",
      "C++ instance and static members",
      "virtual calls and adjustment thunks",
      "member pointers",
      "ordinary nonthrowing constructors",
      "ordinary and throwing templates"
    ],
    "parameters": "Each argument initializes an isolated caller-owned snapshot at argument evaluation; the callee borrows and may assign the slot; caller destroys its final selected arm at full-expression completion, including native exception exits.",
    "results": "Fresh caller-owned sret storage; success constructs the selected arm, typed failure returns a zero empty carrier. Propagation preserves assignment destinations. Completed results remain callee-owned until return cleanup finishes; native unwinding destroys them.",
    "physical_abi": "Managed arguments use pointers without byval or dead_on_return; parameter and result pointers consume SysV integer registers and spill as pointers after register exhaustion; weak storage retains its address.",
    "queries": "Borrow initialized local, parameter, reference or pointer storage; managed call and message results use owned full-expression temporaries.",
    "runtime_encoding": "Versioned v5 nominal encodings bind carrier kind, each arm storage encoding and strong/weak/unsafe/plain ownership. Native boolean/union layout preserves size/alignment. Source types and interface locks retain full semantic identity.",
    "runtime_link_policy": "Discarded COMDAT addresses in DWARF 5 .debug_addr pools use all-ones tombstones so duplicate Block helpers retain valid debug ranges.",
    "nil_receiver": "Zero-initialize Optional none or Result Err with zero payload, including discarded results. Caller snapshots clean up when no body runs.",
    "boundaries": [
      "carrier ivars and properties",
      "carrier value captures",
      "pointer/reference carrier runtime signatures",
      "true direct dispatch with GNUstep 2.0",
      "plain aggregate throws results",
      "typed-error constructors",
      "variadic and alternate calling conventions",
      "mandatory tail calls",
      "reference-bound returned temporaries",
      "volatile managed carriers",
      "nested managed storage",
      "managed MRC transfers",
      "runtime int128/half/extended-float/record arms",
      "generic aggregate FFI and forwarding",
      "public Optional/Result/throws syntax"
    ],
    "typed_errors": "Pending errors remain strongly owned through callee cleanup and pools, then publish to the caller pool; propagation adopts them before caller cleanup. Forced failures trap; catch recovery preserves failed assignments.",
    "public_feature_authority": "Existing qualified defer remains public; Optional/Result/throws feature predicates remain reserved."
  },
