{
  "schema_version": "objc3c-capability-matrix-v1",
  "matrix_version": "2026-05-09-hard-cutover",
  "schema_path": "schemas/objc3c-capability-matrix-v1.schema.json",
  "evidence_map_path": "docs/support/evidence_map.json",
  "states": [
    "implemented",
    "rejected",
    "reserved",
    "internal"
  ],
  "command_surface": {
    "public_bridge": "npm run objc3c -- <action>",
    "action_owner": "scripts/objc3c_workflow/action_catalog.py",
    "public_command_pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$",
    "unsupported_public_surfaces": [
      "direct python or PowerShell helper invocations",
      "direct CMake or native helper invocations",
      "retired package-script aliases",
      "public_scripts alias metadata",
      "workflow registry facade claims",
      "success-without-evidence capability claims",
      "runtime-behavior claims not represented by implemented matrix rows"
    ]
  },
  "projection_policy": {
    "authoritative_data": [
      "docs/support/capability_matrix.json",
      "docs/support/evidence_map.json"
    ],
    "schema_sources": [
      "schemas/objc3c-capability-matrix-v1.schema.json",
      "schemas/objc3c-capability-evidence-map-v1.schema.json"
    ],
    "human_projections": [
      "docs/support/capability_matrix.md",
      "docs/support/evidence_map.md",
      "docs/support/hard_cutover_capability_truth.md"
    ],
    "consumer_rule": "Consumers may summarize only rows and evidence present in authoritative data; projection docs cannot introduce new support claims."
  },
  "hard_cutover_rules": [
    "Only implemented behavior rows may claim public Objective-C 3.0 support.",
    "Rejected and reserved rows are diagnostic or documentation truth, not alternate acceptance paths.",
    "Internal rows can name source, schema, workflow, or report owners without widening language support.",
    "Publicly replayable commands must use npm run objc3c -- <action>.",
    "Docs, spec, and site content must not advertise shims, fallbacks, migration lanes, or compatibility modes as supported surfaces; rows that change support state must use canonical feature names with evidence instead of reviving those labels.",
    "Runtime and object-model prose must not claim full behavior from parser, metadata, owner-module, report, or internal API evidence alone."
  ],
  "retired_surface_terms": [
    {
      "term": "shim",
      "canonical_handling": "Reject as a support claim; replace with an implemented capability row or a diagnostic rejection row.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    },
    {
      "term": "fallback",
      "canonical_handling": "Reject as an acceptance path; use the canonical parser, semantic, lowering, runtime, or tooling behavior name.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    },
    {
      "term": "migration lane",
      "canonical_handling": "Reject as a supported mode; use adoption, upgrade, or reserved-state evidence without widening accepted syntax.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    },
    {
      "term": "compatibility mode",
      "canonical_handling": "Reject as a mode label; use strict capability states and evidence-backed support claims.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    },
    {
      "term": "package-script alias",
      "canonical_handling": "Reject as public command surface; use npm run objc3c -- <action>.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    },
    {
      "term": "report-only completion",
      "canonical_handling": "Reject as completion evidence unless the capability matrix has matching implemented rows and evidence-map entries.",
      "allowed_context": "Negative examples, issue evidence, and source-hygiene rejection data only."
    }
  ],
