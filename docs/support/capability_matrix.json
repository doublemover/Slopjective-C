    "public_command_pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$",
    "unsupported_public_surfaces": [
      "direct python or PowerShell helper invocations",
      "direct CMake or native helper invocations",
      "retired package-script aliases",
      "public_scripts alias metadata",
      "workflow registry facade claims",
      "success-without-evidence capability claims"
    ]
  },
  "hard_cutover_rules": [
    "Only implemented behavior rows may claim public Objective-C 3.0 support.",
    "Rejected and reserved rows are diagnostic or documentation truth, not alternate acceptance paths.",
    "Internal rows can name source, schema, workflow, or report owners without widening language support.",
    "Publicly replayable commands must use npm run objc3c -- <action>.",
    "Docs, spec, and site content must not advertise shims, fallbacks, migration lanes, or compatibility modes as supported surfaces; future support rows must use canonical feature names with evidence instead of reviving those labels."
  ],
