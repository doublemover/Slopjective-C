{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objc3c-capability-matrix-v1",
  "type": "object",
  "required": ["schema_version", "states", "capabilities"],
  "properties": {
    "schema_version": {
      "const": "objc3c-capability-matrix-v1"
    },
    "states": {
      "type": "array",
      "items": {
        "enum": ["implemented", "rejected", "reserved", "internal"]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "state", "summary", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["implemented", "rejected", "reserved", "internal"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "path"],
              "properties": {
                "kind": {
                  "enum": ["test", "diagnostic", "doc", "schema", "source"]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
