{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-capability-matrix-v1.schema.json",
  "$comment": "Canonical copy: schemas/objc3c-capability-matrix-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_version",
    "schema_path",
    "evidence_map_path",
    "states",
    "command_surface",
    "projection_policy",
    "hard_cutover_rules",
    "retired_surface_terms",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "objc3c-capability-matrix-v1"
    },
    "matrix_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_path": {
      "type": "string",
      "const": "schemas/objc3c-capability-matrix-v1.schema.json"
    },
    "evidence_map_path": {
      "type": "string",
      "const": "docs/support/evidence_map.json"
    },
    "states": {
      "type": "array",
      "items": {
        "enum": ["implemented", "rejected", "reserved", "internal"]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "command_surface": {
      "type": "object",
      "required": [
        "public_bridge",
        "action_owner",
        "public_command_pattern",
        "unsupported_public_surfaces"
      ],
      "properties": {
        "public_bridge": {
          "type": "string",
          "const": "npm run objc3c -- <action>"
        },
        "action_owner": {
          "type": "string",
          "const": "scripts/objc3c_workflow/action_catalog.py"
        },
        "public_command_pattern": {
          "type": "string",
          "const": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "unsupported_public_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "projection_policy": {
      "type": "object",
      "required": [
        "authoritative_data",
        "schema_sources",
        "human_projections",
        "consumer_rule"
      ],
      "properties": {
        "authoritative_data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "schema_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "human_projections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consumer_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hard_cutover_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "retired_surface_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "canonical_handling", "allowed_context"],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "canonical_handling": {
            "type": "string",
            "minLength": 1
          },
          "allowed_context": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "state", "summary", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["implemented", "rejected", "reserved", "internal"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "support_claims": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^objc3c\\.behavior\\.[a-z0-9._-]+$"
            },
            "uniqueItems": true
          },
          "owner_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "path"],
              "properties": {
                "kind": {
                  "enum": ["test", "diagnostic", "doc", "schema", "source"]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "description": "Optional public workflow command for replaying this evidence. Capability truth surfaces may only advertise the npm objc3c bridge.",
                  "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
