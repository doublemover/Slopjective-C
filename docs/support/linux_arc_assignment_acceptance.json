      "support_source": "extern id class_createInstance(Class cls, __SIZE_TYPE__ extra) __attribute__((ns_returns_retained));\nextern id object_dispose(id value);\nstatic int destroyed;\n__attribute__((objc_root_class))\n@interface ImportedProbe { Class isa; }\n+ (id)new;\n@end\n@implementation ImportedProbe\n+ (id)new { return class_createInstance(self, 0); }\n- (void)dealloc { ++destroyed; object_dispose(self); }\n@end\n",
      "provider_source": "typedef __objc3_optional(id) ObjectValue;\ntypedef __objc3_optional(id __weak) WeakValue;\n#include \"support.h\"\nid make(void) __attribute__((ns_returns_retained));\nid make(void) { return [ImportedProbe new]; }\nint destructions(void) { return destroyed; }\nvoid replace(ObjectValue *destination, const ObjectValue *source) { *destination = *source; }\nvoid replace_weak(WeakValue *destination, const WeakValue *source) { *destination = *source; }\n",
      "consumer_source": "@import Ownership;\nint main(void) {\n  id object = @Ownership.make();\n  __weak id observer = object;\n  @Ownership.ObjectValue source = __objc3_some(id, object);\n  @Ownership.ObjectValue destination = source;\n  @Ownership.WeakValue weak_source = __objc3_some(id __weak, object);\n  @Ownership.WeakValue weak_destination = weak_source;\n  object = (id)0;\n  @Ownership.replace(&destination, &source);\n  @Ownership.replace_weak(&weak_destination, &weak_source);\n  source = __objc3_none(id);\n  if (observer == (id)0) return 1;\n  destination = __objc3_none(id);\n  if (observer != (id)0 || @Ownership.destructions() != 1) return 2;\n  if (!__objc3_has_value(weak_destination)) return 3;\n  weak_destination = __objc3_none(id __weak);\n  return __objc3_has_value(weak_destination) ? 4 : 0;\n}\n",
