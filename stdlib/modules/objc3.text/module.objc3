module objc3_text;

extern fn objc3_runtime_stdlib_text_utf8_literal_i32(byte_count: i32, unit_count: i32, valid_utf8: i32) -> i32;
extern fn objc3_runtime_stdlib_text_byte_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_text_unit_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_text_is_valid_utf8_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_text_byte_at_or_i32(handle: i32, byte_index: i32, default_value: i32) -> i32;
extern fn objc3_runtime_stdlib_text_prefix_units_i32(handle: i32, requested_units: i32) -> i32;
extern fn objc3_runtime_stdlib_text_concat_i32(left_handle: i32, right_handle: i32) -> i32;
extern fn objc3_runtime_stdlib_text_last_status_i32() -> i32;

let Objc3TextStatusOk = 0;
let Objc3TextStatusInvalidHandle = 30641;
let Objc3TextStatusInvalidShape = 30642;
let Objc3TextStatusMalformedUtf8 = 30643;
let Objc3TextStatusOutOfBounds = 30644;
let Objc3TextStatusStorageUnavailable = 30646;

fn objc3_text_utf8_literal(byte_count: i32, unit_count: i32, valid_utf8: i32) {
  return objc3_runtime_stdlib_text_utf8_literal_i32(byte_count, unit_count, valid_utf8);
}

fn objc3_text_byte_count(handle: i32) {
  return objc3_runtime_stdlib_text_byte_count_i32(handle);
}

fn objc3_text_unit_count(handle: i32) {
  return objc3_runtime_stdlib_text_unit_count_i32(handle);
}

fn objc3_text_is_valid_utf8(handle: i32) {
  return objc3_runtime_stdlib_text_is_valid_utf8_i32(handle);
}

fn objc3_text_byte_at_or(handle: i32, byte_index: i32, default_value: i32) {
  return objc3_runtime_stdlib_text_byte_at_or_i32(handle, byte_index, default_value);
}

fn objc3_text_prefix_units(handle: i32, requested_units: i32) {
  return objc3_runtime_stdlib_text_prefix_units_i32(handle, requested_units);
}

fn objc3_text_concat(left_handle: i32, right_handle: i32) {
  return objc3_runtime_stdlib_text_concat_i32(left_handle, right_handle);
}

fn objc3_text_last_status() {
  return objc3_runtime_stdlib_text_last_status_i32();
}
