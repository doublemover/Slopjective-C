module objc3_collections_smoke;

extern fn objc3_runtime_stdlib_collections_array3_i32(first: i32, second: i32, third: i32, count: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_array_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_array_get_or_i32(handle: i32, index: i32, default_value: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_array_prefix_count_i32(handle: i32, requested: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_map_entry_i32(key: i32, value: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_map_count_i32(handle: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_map_contains_i32(handle: i32, key: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_map_lookup_or_i32(handle: i32, key: i32, default_value: i32) -> i32;
extern fn objc3_runtime_stdlib_collections_last_status_i32() -> i32;

fn main() {
  let array_handle = objc3_runtime_stdlib_collections_array3_i32(4, 5, 6, 3);
  let map_handle = objc3_runtime_stdlib_collections_map_entry_i32(7, 42);
  return array_handle
    + objc3_runtime_stdlib_collections_array_count_i32(array_handle)
    + objc3_runtime_stdlib_collections_array_get_or_i32(array_handle, 2, 99)
    + objc3_runtime_stdlib_collections_array_get_or_i32(array_handle, 4, 99)
    + objc3_runtime_stdlib_collections_array_prefix_count_i32(array_handle, 2)
    + map_handle
    + objc3_runtime_stdlib_collections_map_count_i32(map_handle)
    + objc3_runtime_stdlib_collections_map_contains_i32(map_handle, 7)
    + objc3_runtime_stdlib_collections_map_lookup_or_i32(map_handle, 7, 9)
    + objc3_runtime_stdlib_collections_map_lookup_or_i32(map_handle, 8, 9)
    + objc3_runtime_stdlib_collections_last_status_i32();
}
