  "fail_closed_rules": [
    {
      "rule_id": "missing-workspace-dependency",
      "diagnostic_id": "application-sample-workspace-dependency-missing",
      "trigger": "a sample package dependency is absent from the checked workspace manifest",
      "required_action": "update workspace.json before claiming the dependency",
      "blocks_sample_claim": true
    },
    {
      "rule_id": "missing-replay-dependency",
      "diagnostic_id": "application-sample-replay-dependency-missing",
      "trigger": "a sample package dependency is absent from replay-contract.json",
      "required_action": "update replay-contract.json before claiming the dependency",
      "blocks_sample_claim": true
    },
    {
      "rule_id": "missing-source-dependency-evidence",
      "diagnostic_id": "application-sample-source-dependency-evidence-missing",
      "trigger": "a sample package dependency has no checked source term in main.objc3",
      "required_action": "add a source-level use or remove the dependency claim",
      "blocks_sample_claim": true
    },
    {
      "rule_id": "unsupported-dependency-boundary",
      "diagnostic_id": "application-sample-unsupported-dependency-boundary",
      "trigger": "a sample dependency uses hosted registry, package-manager, or network package syntax",
      "required_action": "keep application framework samples on checked-in stdlib or showcase-framework dependencies",
      "blocks_sample_claim": true
    }
  ],
