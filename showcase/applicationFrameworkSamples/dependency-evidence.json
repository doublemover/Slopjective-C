{
  "contract_id": "objc3c.application_framework_samples.dependency_evidence.v1",
  "schema_version": 1,
  "issue": 8178,
  "manifest": "showcase/applicationFrameworkSamples/manifest.json",
  "source_root": "showcase/applicationFrameworkSamples",
  "forbidden_dependency_prefixes": [
    "hosted-registry:",
    "package-manager:",
    "network:"
  ],
  "clean_root_replay_policy": {
    "artifact_root_must_be_removed_before_compile": true,
    "stale_artifacts_allowed": false,
    "generated_outputs_are_source_truth": false
