{
  "schema": "objc3c.implementation-analysis-policy.v2",
  "tool": "objc3-clang-tidy",
  "checks": [
    "clang-analyzer-core.CallAndMessage",
    "clang-analyzer-core.DivideZero",
    "clang-analyzer-core.NullDereference",
    "clang-analyzer-core.StackAddressEscape",
    "clang-analyzer-core.UndefinedBinaryOperatorResult",
    "clang-analyzer-core.uninitialized.ArraySubscript",
    "clang-analyzer-core.uninitialized.Assign",
    "clang-analyzer-core.uninitialized.Branch",
    "clang-analyzer-core.uninitialized.UndefReturn",
    "clang-analyzer-cplusplus.NewDelete",
    "clang-analyzer-cplusplus.NewDeleteLeaks",
    "bugprone-dangling-handle",
    "bugprone-sizeof-expression",
    "bugprone-use-after-move"
  ],
  "warnings_as_errors": "*",
  "profile_checks": true,
  "translation_unit_timeout_seconds": 600,
  "baseline": [],
  "purpose": "Implementation defects in native sources and maintained Clang translation units; separate from ObjC3 language analyzer modeling",
  "translation_unit_timeout_overrides_seconds": {
    "native/objc3c/src/clang_foundation/interface_emission_features.cpp": 1800,
    "native/objc3c/src/clang_foundation/interface_emission_identity.cpp": 1800
  },
  "maintained_translation_unit_timeout_seconds": 3600,
  "hosts": [
    "linux-x86_64",
    "linux-aarch64"
  ],
  "partition_seconds": {
    "default": 120,
    "ASTContext.cpp": 1500,
    "ASTImporter.cpp": 1710,
    "ASTReader.cpp": 900,
    "ASTReaderDecl.cpp": 480,
    "ASTReaderStmt.cpp": 1110,
    "AnalysisBasedWarnings.cpp": 300,
    "CFG.cpp": 630,
    "CGCall.cpp": 420,
    "CGClass.cpp": 330,
    "CGDebugInfo.cpp": 630,
    "CGDecl.cpp": 330,
    "CGExpr.cpp": 480,
    "CGExprAgg.cpp": 420,
    "CGExprComplex.cpp": 360,
    "CGExprScalar.cpp": 750,
    "CGNonTrivialStruct.cpp": 600,
    "CGObjC.cpp": 450,
    "CGObjC3Carriers.cpp": 300,
    "CodeGenFunction.cpp": 330,
    "CodeGenModule.cpp": 600,
    "CompilerInvocation.cpp": 420,
    "DeclBase.cpp": 390,
    "DeclCXX.cpp": 420,
    "DeclObjC.cpp": 600,
    "ExprEngine.cpp": 360,
    "ItaniumCXXABI.cpp": 420,
    "ItaniumMangle.cpp": 360,
    "JSONNodeDumper.cpp": 600,
    "SemaChecking.cpp": 1320,
    "SemaDecl.cpp": 900,
    "SemaDeclAttr.cpp": 540,
    "SemaDeclCXX.cpp": 1410,
    "SemaExpr.cpp": 1170,
    "SemaExprCXX.cpp": 480,
    "SemaInit.cpp": 390,
    "SemaLookup.cpp": 390,
    "SemaObjC.cpp": 330,
    "SemaObjC3Borrowed.cpp": 660,
    "SemaObjC3Isolation.cpp": 660,
    "SemaOverload.cpp": 810,
    "SemaStmt.cpp": 360,
    "SemaTemplate.cpp": 540,
    "SemaTemplateDeduction.cpp": 630,
