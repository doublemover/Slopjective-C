+// RUN: split-file %s %t
+// RUN: %clang_cc1 -x objective-c -fmodules -emit-module -fmodule-name=Owner %t/module.modulemap -o %t/valid.pcm
+// RUN: %clang_cc1 -x objective-c -fmodules -fmodule-file=%t/valid.pcm -fsyntax-only %t/use.m
+// RUN: %python %S/Inputs/malformed-submodule.py %t/valid.pcm %t/bad.pcm
+// RUN: not %clang_cc1 -x objective-c -fmodules -fmodule-file=%t/bad.pcm -fsyntax-only %t/use.m 2>&1 | FileCheck %s
+// CHECK-NOT: PLEASE submit a bug report
+// CHECK: malformed module definition
+// CHECK-NOT: PLEASE submit a bug report
+
+//--- module.modulemap
+module Owner { header "owner.h" export * }
+//--- owner.h
+int owned(void);
+//--- use.m
+@import Owner;
+int use(void) { return owned(); }
