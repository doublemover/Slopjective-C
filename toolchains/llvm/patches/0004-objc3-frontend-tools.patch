+TEST(ObjC3SourceTools, CaptureModifiersAreContextualAndHaveOwnershipHover) {
+  Annotations A(R"objc(
+    void work(id object, int weak) {
+      void (^owned)(void) = ^[$modifier[[str~ong]] object] { (void)object; };
+      void (^named)(void) = ^[$name[[weak]]] { (void)weak; };
+      owned(); named();
+    }
+  )objc", llvm::Annotations::Markers().setPoint("~"));
