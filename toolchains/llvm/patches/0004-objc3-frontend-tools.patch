@@ -0,0 +1,46 @@
+// RUN: c-index-test -test-load-source all %s -x objective-c++ -std=c++20 -fobjc-version=3 | FileCheck %s --check-prefix=CURSORS
+// RUN: c-index-test -test-annotate-tokens=%s:5:1:16:1 %s -x objective-c++ -std=c++20 -fobjc-version=3 | FileCheck %s --check-prefix=TOKENS
+
+using Maybe = __objc3_optional(int);
+int condition_cursors(Maybe source, bool enabled) {
+  guard let first = source, enabled else { return -1; }
+  if var second = source, second > first {
+    second += first;
+    return second;
+  } else {
+    return first;
+  }
+}
+
+// CURSORS: FunctionDecl=condition_cursors:
+// CURSORS: UnexposedStmt=
+// CURSORS: UnexposedStmt=
+// CURSORS: VarDecl=first:
+// CURSORS: DeclRefExpr=source:
+// CURSORS: DeclRefExpr=enabled:
+// CURSORS: IfStmt=
+// CURSORS: UnexposedStmt=
+// CURSORS: VarDecl=second:
+// CURSORS: DeclRefExpr=source:
+// CURSORS: DeclRefExpr=second:
+// CURSORS: DeclRefExpr=first:
+// CURSORS: DeclRefExpr=second:
+// CURSORS: DeclRefExpr=first:
+// CURSORS: DeclRefExpr=second:
+// CURSORS: DeclRefExpr=first:
+// CURSORS-NOT: NotImplemented
+
+// TOKENS: Identifier: "guard" {{.*}} UnexposedStmt=
+// TOKENS: Identifier: "first" {{.*}} VarDecl=first:
+// TOKENS: Identifier: "source" {{.*}} DeclRefExpr=source:
+// TOKENS: Identifier: "enabled" {{.*}} DeclRefExpr=enabled:
+// TOKENS: Keyword: "if" {{.*}} IfStmt=
+// TOKENS: Identifier: "second" {{.*}} VarDecl=second:
+// TOKENS: Identifier: "source" {{.*}} DeclRefExpr=source:
+// TOKENS: Identifier: "second" {{.*}} DeclRefExpr=second:
+// TOKENS: Identifier: "first" {{.*}} DeclRefExpr=first:
+// TOKENS: Identifier: "second" {{.*}} DeclRefExpr=second:
