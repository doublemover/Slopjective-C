diff --git a/clang/test/Modules/Inputs/malformed-submodule.py b/clang/test/Modules/Inputs/malformed-submodule.py
new file mode 100644
index 000000000..057f292e8
--- /dev/null
+++ b/clang/test/Modules/Inputs/malformed-submodule.py
@@ -0,0 +1,112 @@
+"""Change a real PCM definition abbreviation into an attribute, in place.
+
+Keep every bit offset and block length intact so the production lazy module
+reader, rather than an unrelated container check, diagnoses the missing owner.
+"""
+import sys
+from pathlib import Path
+
+
+class Bits:
+    def __init__(self, data):
+        self.data, self.pos = data, 32
+        self.shared = {}
+
+    def read(self, count):
+        value = 0
+        for shift in range(count):
+            value |= ((self.data[self.pos // 8] >> (self.pos % 8)) & 1) << shift
+            self.pos += 1
+        return value
+
+    def vbr(self, width):
+        value, shift = 0, 0
+        while True:
+            chunk = self.read(width)
+            value |= (chunk & ((1 << (width - 1)) - 1)) << shift
+            if chunk < 1 << (width - 1):
+                return value
+            shift += width - 1
+
+    def align(self):
+        self.pos = (self.pos + 31) // 32 * 32
+
+    def operand(self, op):
+        kind, width, _ = op
+        if kind == 0:
+            return width
+        if kind == 1:
+            return self.read(width)
+        if kind == 2:
+            return self.vbr(width)
+        if kind == 4:
+            return self.read(6)
+        raise ValueError('unexpected scalar encoding')
+
+    def block(self, block, width, end):
+        abbrevs = list(self.shared.get(block, []))
+        owner = None
+        while self.pos < end:
+            code = self.read(width)
+            if code == 0:
+                self.align()
+                return False
+            if code == 1:
+                child, child_width = self.vbr(8), self.vbr(4)
+                self.align()
+                words = self.read(32)
+                child_end = self.pos + words * 32
+                if child in (0, 8, 13):
+                    if self.block(child, child_width, child_end):
+                        return True
+                self.pos = child_end
+                continue
+            if code == 2:
+                ops = []
+                for _ in range(self.vbr(5)):
+                    if self.read(1):
+                        offset = self.pos
+                        ops.append((0, self.vbr(8), offset))
+                    else:
+                        kind = self.read(3)
+                        ops.append((kind, self.vbr(5) if kind in (1, 2) else 0, None))
+                if block == 13 and ops[0][:2] == (0, 1):
+                    offset = ops[0][2]
+                    # SUBMODULE_DEFINITION=1 -> SUBMODULE_TOPHEADER=4; both
+                    # fit in the same single VBR8 group.
+                    for shift in range(8):
+                        bit = offset + shift
+                        self.data[bit // 8] &= ~(1 << (bit % 8))
+                        self.data[bit // 8] |= ((4 >> shift) & 1) << (bit % 8)
+                    return True
+                (self.shared.setdefault(owner, []) if block == 0 else abbrevs).append(ops)
+                continue
+            if code == 3:
+                record = self.vbr(6)
+                values = [self.vbr(6) for _ in range(self.vbr(6))]
+            else:
+                values, index = [], 0
+                ops = abbrevs[code - 4]
+                while index < len(ops):
+                    op = ops[index]
+                    if op[0] == 3:
+                        index += 1
+                        values.extend(self.operand(ops[index]) for _ in range(self.vbr(6)))
+                    elif op[0] == 5:
+                        size = self.vbr(6)
+                        self.align()
+                        self.pos += size * 8
+                        self.align()
+                    else:
+                        values.append(self.operand(op))
+                    index += 1
+                record, *values = values
+            if block == 0 and record == 1:
+                owner = values[0]
+        return False
+
+
+data = bytearray(Path(sys.argv[1]).read_bytes())
+assert data[:4] == b'CPCH'
+assert Bits(data).block(None, 2, len(data) * 8), 'missing definition abbreviation'
+Path(sys.argv[2]).write_bytes(data)
