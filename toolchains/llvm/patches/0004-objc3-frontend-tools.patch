+// Objective-C 3 publication gives unnamed template members a lexical owner.
+// Locations cannot distinguish their native USRs after interface relocation.
+static bool hasObjC3UnnamedTemplateOwner(const NamedDecl *D) {
+  if (D->getParentFunctionOrMethod()) return false;
+  bool Unnamed=false;
+  const DeclContext *Start=dyn_cast<DeclContext>(D);
+  if (!Start) Start=D->getDeclContext();
+  for (const DeclContext *DC=Start; DC; DC=DC->getParent()) {
+    const auto *Record=dyn_cast<CXXRecordDecl>(DC);
+    if (!Record) continue;
+    if (Record->isLambda() || Record->isLocalClass()) return false;
+    Unnamed |= !Record->getIdentifier() && !Record->getTypedefNameForAnonDecl();
+    if (Unnamed && (Record->getDescribedClassTemplate() ||
+                    isa<ClassTemplateSpecializationDecl>(Record))) return true;
+  }
+  return false;
+}
+
