 using namespace clang;
 using namespace CodeGen;
 
+namespace {
+struct DestroyObjC3BlockCapture final : EHScopeStack::Cleanup {
+  ObjC3BlockCaptureCleanup *Capture;
+  explicit DestroyObjC3BlockCapture(ObjC3BlockCaptureCleanup *Capture)
+      : Capture(Capture) {}
+  void Emit(CodeGenFunction &CGF, Flags F) override {
+    emitObjC3BlockCaptureCleanup(CGF, Capture, F.isForEHCleanup());
+  }
+};
+void destroyObjC3CapturedValue(CodeGenFunction &CGF, Address Addr, QualType Type) {
+  if (supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type)) {
+    emitObjC3MixedCarrierDestroyPayload(CGF, Type, Addr, true,
+                                      true, true, true);
+  } else if (supportsObjC3CarrierCppLocalLifetime(CGF.CGM, Type) &&
+      !hasObjC3CarrierManagedPayload(Type)) {
+    bool Emitted = emitObjC3CarrierDestroyActivePayload(CGF, Type, Addr, false);
+    assert(Emitted && "admitted C++ carrier must destroy its selected arm");
+    (void)Emitted;
+  } else {
+    emitObjC3CarrierDestroyActiveARCPayload(CGF, Type, Addr, true, true, true);
+  }
+}
+void initializeObjC3Capture(CodeGenFunction &CGF, QualType Type,
+                           Address Destination, Address Source,
+                           SourceLocation Loc, bool Move = false) {
+  auto Saved = CGF.getObjC3CarrierLocalInitState();
+  CGF.setObjC3CarrierLocalInitState(
+      {Destination, Type.getCanonicalType().getUnqualifiedType()});
+  if (Move) {
+    emitObjC3CarrierARCStorageCopy(
+        CGF, Type.getCanonicalType().getUnqualifiedType(), Destination, Source,
+        true);
+    clearObjC3MovedCaptureCarrier(CGF, Type, Source);
+  } else {
+    bool Emitted = emitObjC3CarrierARCCopy(CGF, Type, Destination, Source,
+                                          false, false, true, Loc);
+    assert(Emitted && "admitted capture must use active-arm initialization");
+    (void)Emitted;
+  }
+  CGF.setObjC3CarrierLocalInitState(Saved);
+}
+// Capture recipes use an opaque root so stack/nested/heap sources all bind
+// to their own physical field rather than the original source declaration.
+void initializeObjC3RecipeCapture(CodeGenFunction &CGF,
+                               const BlockDecl::Capture &Capture,
+                               Address Destination, Address Source, bool Move) {
+  const Expr *Recipe = Move ? Capture.getObjC3InitExpr() : Capture.getCopyExpr();
+  const auto *Transfer =
+      cast<ObjC3CarrierTransferExpr>(Recipe->IgnoreImplicit());
+  const auto *Root = cast<OpaqueValueExpr>(Transfer->getSource());
+  CodeGenFunction::OpaqueValueMapping Bind(
+      CGF, Root, CGF.MakeAddrLValue(Source, Root->getType()));
+  if (supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Recipe->getType()))
+    emitObjC3MixedCarrierValueInit(CGF, Recipe, Destination);
+  else
+    emitObjC3CarrierCppValueInit(CGF, Recipe, Destination);
+  if (Move)
+    clearObjC3MovedCaptureCarrier(CGF, Capture.getVariable()->getType(), Source,
+                                /*ManagedAlreadyMoved=*/false);
+}
