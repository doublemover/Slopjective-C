+              StoredEffects |= contents(Target, storageType(Target), State, true);
+              StoredEffects |= exposedEffects(State.MayTargets[Slot->second], State);
+            }
+            if (auto Offset = pointerOffset(Assignment); Offset && Slot != Slots.end()) {
+              auto Delta = pointerDelta(Offset->Amount, Offset->Subtract);
+              auto Step = offsetTargetValues(Assignment->getLHS()->getType(), State.MayTargets[Slot->second], State.ClosedTargets.test(Slot->second), Delta);
+              Targets = std::move(Step.first);Complete = Step.second;
+              Address = Complete && Targets.count() == 1 ? location(Targets.find_first()) : Storage{};
+              V = storedValue(Target, Assignment->getLHS()->getType(), State);
+              V |= value(Assignment->getRHS(), State);
+              Bytes = offsetByteValues(Assignment->getLHS()->getType(), Delta, State.ByteTargets[Slot->second]);
+              if (Delta && !*Delta) {
+                Owner = State.OwnerIdentities[Slot->second];
+                Unowned = State.UnownedOwners.test(Slot->second);
