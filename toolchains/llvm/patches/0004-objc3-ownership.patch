+      else if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(Written)) Written = Temporary->getSubExpr();
+      else if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(Written)) Written = Binding->getSubExpr();
+      else if (const auto *Cast = dyn_cast<CastExpr>(Written)) {
