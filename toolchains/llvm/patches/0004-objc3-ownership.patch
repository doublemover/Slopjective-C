+bool isResourceHandleType(QualType Type) {
+  return !Type.isNull() && !Type->isDependentType() &&
+         (Type->isIntegerType() || Type->isEnumeralType() ||
+          Type->isPointerType()) &&
+         !Type->isObjCRetainableType() && !Type.isConstQualified() &&
+         (Type.getObjCLifetime() == Qualifiers::OCL_None ||
+          Type.getObjCLifetime() == Qualifiers::OCL_ExplicitNone) &&
+         !Type->isAtomicType() && Type.getAddressSpace() == LangAS::Default;
+}
+// Resolve ordinary overloads and function-template deduction against the actual
+// storage, using native overload ranking and constraints. Prefer F(value); only
+// an empty viable set permits F(&value). Ambiguous/deleted best candidates must
+// not silently select a different address overload.
+ExprResult resolveResourceCallback(Sema &S, Expr *Value, QualType Storage) {
+  auto *Lookup = dyn_cast<UnresolvedLookupExpr>(Value->IgnoreParenImpCasts());
+  if (!Lookup || Storage->isDependentType() ||
+      Storage->isUndeducedType() || Value->isTypeDependent() ||
+      Value->isValueDependent()) return Value;
+  auto *Handle = new (S.Context)
+      OpaqueValueExpr(Value->getExprLoc(), Storage, VK_LValue);
+  auto *Address = new (S.Context) OpaqueValueExpr(
+      Value->getExprLoc(), S.Context.getPointerType(Storage), VK_PRValue);
+  for (Expr *Argument : {Handle, Address}) {
+    Expr *Arguments[] = {Argument};
+    OverloadCandidateSet Candidates(Value->getExprLoc(),
+                                    OverloadCandidateSet::CSK_Normal);
+    S.AddOverloadedCallCandidates(Lookup, Arguments, Candidates);
+    OverloadCandidateSet::iterator Best;
+    const auto Result = Candidates.BestViableFunction(S, Value->getExprLoc(), Best);
+    if (Result == OR_No_Viable_Function && Argument == Handle) continue;
+    if (Result != OR_Success) {
+      // Emit the ordinary candidate diagnostics once, on the terminal form.
+      (void)S.BuildCallExpr(nullptr, Value, Value->getExprLoc(), Arguments,
+                            Value->getEndLoc());
+      return ExprError();
+    }
+    if (S.CheckUnresolvedLookupAccess(Lookup, Best->FoundDecl) ==
+        Sema::AR_inaccessible) return ExprError();
+    return S.FixOverloadedFunctionReference(Value, Best->FoundDecl, Best->Function);
+  }
+  llvm_unreachable("both cleanup invocation forms examined");
+}
