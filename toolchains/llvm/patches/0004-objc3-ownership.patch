+          if (I >= Type->getNumParams()) return false;
+          QualType Parameter = Type->getParamType(I);
+          if (Parameter->isReferenceType()) {
+            QualType Object = Parameter->getPointeeType();
+            if (!Object.isConstQualified() || Object->isRecordType()) return false;
+          } else if (Parameter->isPointerType()) {
+            const bool Owner = ReturnOwner && *ReturnOwner == I;
+            const auto *Formal = I < Callee->getNumParams() ? Callee->getParamDecl(I) : nullptr;
+            const bool Consumed = Formal && Formal->hasAttr<CFConsumedAttr>();
+            QualType Object = Parameter->getPointeeType();
+            if (!Owner && !Consumed && (!Object.isConstQualified() || Object->isRecordType())) return false;
+          } else if (Parameter->isRecordType()) return false;
+        }
+      }
+      for (const Stmt *Child : Node->children()) Pending.push_back(Child);
+    }
+    return true;
+  }
+  bool readOnlyReferenceLambda(const LambdaExpr *Lambda) const {
+    if (auto Found = ReadOnlyReferenceLambdas.find(Lambda); Found != ReadOnlyReferenceLambdas.end()) return Found->second;
+    // Immediate literals and closed local uses have no escaping instantiations.
+    // Check every concrete synchronous body within the existing work bounds.
+    ReadOnlyReferenceLambdas[Lambda] = false;
+    if ((!ImmediateLambdaCalls.contains(Lambda) && !LocalReferenceLambdas.contains(Lambda)) ||
+        !qualifiedGenericCapture(Lambda)) return false;
+    for (const auto &Capture : Lambda->captures())
+      if (!Capture.capturesVariable()) return false;
+    for (const auto &[Declaration, Body] : closureBodies(Lambda))
+      if (!Body || !immediateReadOnlyLambdaBody(cast<FunctionDecl>(Declaration), Body)) return false;
+    ReadOnlyReferenceLambdas[Lambda] = true;
+    return true;
+  }
+  OwnerSummary futureOwnerRequirements(const Expr *Closure) {
+    if (auto Found = OwnerSummaries->find(Closure); Found != OwnerSummaries->end())
+      return Found->second;
