+    return Result;
+  }
+  bool referenceOwnerUnowned(const VarDecl *Variable, const Facts &State) const {
+    auto Slot = Slots.find({Variable, nullptr});
+    if (Slot == Slots.end()) return false;
+    const auto &Binding = State.References[Slot->second];
+    if (!Binding.Initialized) return State.UnownedOwners.test(Slot->second);
+    for (Storage Target : Binding.Targets)
+      if (auto Found = Slots.find(Target); Found != Slots.end() && State.UnownedOwners.test(Found->second)) return true;
+    return false;
+  }
+  Value ownerIdentity(const Expr *E, const Facts &State) const {
+    Value Result(OwnerCount);
+    if (!E)
+      return Result;
+    E = E->IgnoreParenCasts();
+    if (const auto *Statement = dyn_cast<StmtExpr>(E))
+      return evaluatedOwnerIdentity(getObjC3StatementExpressionResult(*Statement), State);
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return ownerIdentity(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return ownerIdentity(Opaque->getSourceExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      Result = ownerIdentity(Conditional->getTrueExpr(), State);
+      Result |= ownerIdentity(Conditional->getFalseExpr(), State);
+      return Result;
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp())
+        return ownerIdentity(Binary->getRHS(), State);
+    if (const auto *Operation = familyCall(E).Common;
+        Operation && isa<ObjCFamilyRetainAttr>(Operation))
+      return evaluatedOwnerIdentity(argument(E, 0), State);
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(E);
+        Message && Message->getMethodFamily() == OMF_retain &&
+        Message->getReceiverKind() == ObjCMessageExpr::Instance)
+      return evaluatedOwnerIdentity(Message->getInstanceReceiver(), State);
+    if (const VarDecl *Variable = variable(E)) {
+      auto Found = Slots.find({Variable, nullptr});
+      if (Found != Slots.end()) return referenceOwnerIdentity(Variable, State);
+    }
+    if (auto Found = Slots.find(storage(E, &State)); Found != Slots.end()) {
+      Result = State.OwnerIdentities[Found->second];
+      if (Result.none() && E->getType()->isPointerType() &&
+          !(State.ClosedTargets.test(Found->second) && State.MayTargets[Found->second].none()))
+        Result.set(OwnerRoots.lookup(nullptr));
+    }
+    return Result;
+  }
+  bool evaluatedOwnerIsUnowned(const Expr *E, const Facts &State) const {
+    if (E)
+      if (auto Slot = ExpressionSlots.find(E); Slot != ExpressionSlots.end())
+        if (State.EvaluatedReady.test(Slot->second))
+          return State.EvaluatedUnownedOwners.test(Slot->second);
+    return ownerIsUnowned(E, State);
+  }
+  Value evaluatedOwnerIdentity(const Expr *E, const Facts &State) const {
+    if (E)
+      if (auto Slot = ExpressionSlots.find(E); Slot != ExpressionSlots.end())
+        if (State.EvaluatedReady.test(Slot->second))
+          return State.EvaluatedOwners[Slot->second];
+    return ownerIdentity(E, State);
+  }
+  bool ownerIsUnowned(const Expr *E, const Facts &State) const {
+    if (!E) return false;
+    E = E->IgnoreParenCasts();
+    if (const auto *Statement = dyn_cast<StmtExpr>(E))
+      return ownerIsUnowned(getObjC3StatementExpressionResult(*Statement), State);
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return ownerIsUnowned(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return ownerIsUnowned(Opaque->getSourceExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E))
+      return ownerIsUnowned(Conditional->getTrueExpr(), State) ||
+             ownerIsUnowned(Conditional->getFalseExpr(), State);
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp())
+        return ownerIsUnowned(Binary->getRHS(), State);
+    if (const VarDecl *Variable = variable(E))
+      if (auto Slot = Slots.find({Variable, nullptr}); Slot != Slots.end())
+        return referenceOwnerUnowned(Variable, State);
+    if (auto Slot = Slots.find(storage(E, &State)); Slot != Slots.end()) return State.UnownedOwners.test(Slot->second);
+    return false;
+  }
+  bool originOwnerFacts(unsigned Token, const Facts &State, Value &Identities,
+                          bool &Unowned) const {
+    if (auto Source = OriginOwnerStorage.find(Token); Source != OriginOwnerStorage.end())
+      return storageOwnerFacts(Source->second, State, Identities, Unowned);
+    const Origin &O = Origins[Token];
+    if (!O.Owner || !Slots.count({O.Owner, nullptr})) return false;
+    Identities |= referenceOwnerIdentity(O.Owner, State);
+    Unowned |= referenceOwnerUnowned(O.Owner, State);return true;
+  }
+  bool matchesPin(const Origin &O, const VarDecl *Binding,
+                   const Facts &State, unsigned Token) const {
+    unsigned P = Pins.lookup(Binding);
+    if (!State.ActivePins.test(P))
+      return false;
+    auto Slot = Slots.find({Binding, nullptr});
+    if (Slot == Slots.end())
+      return false;
+    const Value &Identities = State.OwnerIdentities[Slot->second];
+    if (!Identities.test(ownerIndex(O))) return false;
+    if (O.Pin && State.EquivalentPins[P].test(Pins.lookup(O.Pin))) return true;
+    // A direct unchanged snapshot proves equality even when a branch joined
+    // multiple possible identities. Different variables need one known root.
+    bool SameStorage = false;
+    if (auto Source = OriginOwnerStorage.find(Token); Source != OriginOwnerStorage.end())
+      SameStorage = State.PinLocations[P].first && State.PinLocations[P] == Source->second;
+    return (((O.Owner && PinSources.lookup(Binding) == O.Owner) || SameStorage) && State.SamePins.test(P)) ||
+           (O.Identity && Identities.count() == 1);
+  }
+  Value acquired(const Stmt *Node, const Facts &State,
+                 bool UseSnapshot = true, const Expr *SnapshotSource = nullptr) const {
+    if (UseSnapshot)
+      if (const auto *Expression = dyn_cast<Expr>(Node))
+        if (auto Slot = ExpressionSlots.find(Expression);
+            Slot != ExpressionSlots.end() && State.AcquisitionReady.test(Slot->second))
+          return State.EvaluatedAcquisitions[Slot->second];
+    Value Result = empty();
+    auto Found = Acquisitions.find(Node);
+    if (Found == Acquisitions.end())
+      return Result;
+    llvm::DenseMap<const Expr *, std::pair<Value, bool>> Selections;
+    for (unsigned I : Found->second) {
+      const Origin &O = Origins[I];
+      if (O.IndependentAlias || O.Pin) continue;
+      auto StorageOwner = OriginOwnerStorage.find(I);
+      auto FutureOwner = FutureStorageOwners.find(I);
+      auto Selector = OriginOwnerSelectors.find(I);
+      if (SnapshotSource && (Selector != OriginOwnerSelectors.end()
+            ? SnapshotSource->IgnoreParenCasts() != Selector->second->IgnoreParenCasts()
+            : StorageOwner != OriginOwnerStorage.end()
+                ? !(storage(SnapshotSource) == StorageOwner->second) : O.Owner != variable(SnapshotSource))) continue;
+      if (Selector != OriginOwnerSelectors.end()) {
+        auto Selection = Selections.find(Selector->second);
+        if (Selection == Selections.end()) {
+          SmallVector<Storage, 4> Objects;
+          bool Complete = localLValueAlternatives(Selector->second, State, Objects, true, 0, false) && !Objects.empty() && Objects.size() <= 64;
+          Value Targets(Slots.size());
+          for (Storage Object : Objects) {
+            auto Slot = Slots.find(Object);
+            Complete &= Slot != Slots.end() && !hasUnknownIndex(Object) && typedWriteTarget(Object, Selector->second->getType());
+            if (Slot != Slots.end()) Targets.set(Slot->second);
+          }
+          Selection = Selections.insert({Selector->second, {std::move(Targets), Complete}}).first;
+        }
+        if (UnprovenOwnerSelectors.count(I)) {
+          if (!Selection->second.second || RejectedOwnerSelectors.count(I)) Result.set(I * 2);
+          continue;
+        }
+        if (!Selection->second.second || StorageOwner == OriginOwnerStorage.end() ||
+            !Selection->second.first.test(Slots.lookup(StorageOwner->second))) continue;
+      }
+      bool StorageReleased = false;
+      if (FutureOwner != FutureStorageOwners.end()) {
+        Value Identity(OwnerCount);
+        if (!futureStorageOwnerFacts(FutureOwner->second, State, Identity, StorageReleased) || !Identity.test(ownerIndex(O))) continue;
+      } else if (StorageOwner != OriginOwnerStorage.end()) {
+        Value Identity(OwnerCount);
+        if (!storageOwnerFacts(StorageOwner->second, State, Identity, StorageReleased) || !Identity.test(ownerIndex(O))) continue;
+      } else if (O.Owner) {
+        auto Slot = Slots.find({O.Owner, nullptr});
+        if (Slot != Slots.end() &&
+            !referenceOwnerIdentity(O.Owner, State).test(ownerIndex(O)))
+          continue;
+      } else if (O.Identity) {
+        continue;
+      }
+      if (O.Identity && O.StorageIdentity == ~0U) AcquiredOwnerRoots.insert(O.Identity);
+      if (O.StorageIdentity != ~0U) AcquiredStorageOwners.insert(O.StorageIdentity);
+      bool Pinned = false;
+      for (unsigned PinnedIndex : Found->second) {
+        const Origin &PinnedOrigin = Origins[PinnedIndex];
+        if (!PinnedOrigin.Pin || ownerIndex(PinnedOrigin) != ownerIndex(O) ||
+            PinnedOrigin.Owner != O.Owner)
+          continue;
+        if (matchesPin(O, PinnedOrigin.Pin, State, I)) {
+          Result.set(PinnedIndex * 2);
+          Pinned = true;
+        }
+      }
+      if (!Pinned) {
+        const auto Slot = Slots.find({O.Owner, nullptr});
+        const bool Released = FutureOwner != FutureStorageOwners.end() || StorageOwner != OriginOwnerStorage.end() ? StorageReleased :
+            O.Owner && Slot != Slots.end() && referenceOwnerUnowned(O.Owner, State);
+        Result.set(I * 2 + Released);
+      }
+    }
+    if (const auto *Invocation = dyn_cast<Expr>(Node))
+      if (auto OwnerIndex = borrowedResultOwner(Invocation)) {
+        const Expr *Owner = ownerArgument(Invocation, *OwnerIndex);
+        Value Dependency = value(Owner, State);
+        if (Dependency.count() == 1 && Dependency.test(0)) {
+          Value Identities = evaluatedOwnerIdentity(Owner, State);
+          if (Identities.count() == 1)
+            for (const auto &[Variable, Index] : OwnerRoots)
+              if (Variable && Identities.test(Index) && isa<ParmVarDecl>(Variable) &&
+                  (Variable->hasAttr<NoEscapeAttr>() || carriesBorrowedValue(Variable->getType())))
+                Dependency.reset(0);
+        }
+        Result |= Dependency;
+      }
+    return Result;
+  }
+  Storage addressExposure(Storage Target) const {
+    // A pointer to an array element can reach its siblings by valid pointer
+    // arithmetic. Exposing that address exposes the whole containing array,
+    // while loading an element's stored pointer still reads only that slot.
+    if (Target.Index >= 0 || Target.Index == -2) {
+      Storage Parent = parentStorage(Target);
+      QualType Type = storageType(Parent);
+      if (!Type.isNull() && Type->isArrayType()) return Parent;
+    }
+    return Target;
+  }
+  Value exposedEffects(const Value &Targets, const Facts &State) const {
+    Value Result = empty(), Pending = Targets, Seen(Slots.size());
+    while (Pending.any()) {
+      int Index = Pending.find_first();
+      Pending.reset(Index);
+      if (Seen.test(Index)) continue;
+      Seen.set(Index);
+      Storage Location = addressExposure(location(Index));
+      Result |= contents(Location, storageType(Location), State, true);
+      Pending |= storageTargets(Location, storageType(Location), State);
+      Pending.reset(Seen);
+    }
+    return Result;
+  }
+  bool readCallablePath(Storage Source, ArrayRef<PathNode> Components,
+                        const Facts &State, Value &Result,
+                        bool Owners = false, bool *Unowned = nullptr,
+                        unsigned Depth = 0) const {
+    QualType Type = storageType(Source);
+    if (Type.isNull() || Components.size() > 32 || Depth > 64) return false;
+    if (Type->isReferenceType())
+      if (auto Slot = Slots.find(Source); Slot != Slots.end() && State.References[Slot->second].Initialized) {
+        const auto &Binding = State.References[Slot->second];
+        if (!Binding.Complete || Binding.Targets.empty()) return false;
+        for (Storage Target : Binding.Targets)
+          if (Target == Source || !readCallablePath(Target, Components, State, Result, Owners, Unowned, Depth + 1)) return false;
+        return true;
+      }
+    if (Components.empty()) {
+      if (Owners) {
+        bool Released = false;
+        if (!storageOwnerFacts(Source, State, Result, Released)) return false;
+        if (Unowned) *Unowned |= Released;
+      } else {
+        Result |= contents(Source, Type, State, true);
+        Result |= exposedEffects(storageTargets(Source, Type, State), State);
+      }
+      return true;
+    }
+    Type = Type.getNonReferenceType();
+    const PathNode &Component = Components.front();
+    if (Component.BaseRecord) {
+      const auto *Record = Type->getAsCXXRecordDecl();
+      if (!Record || !(Record = Record->getDefinition()) || !Record->isDerivedFrom(Component.BaseRecord)) return false;
+      Source = baseStorage(Source, Component.BaseRecord, Component.VirtualBase);
+    } else if (Component.Field) {
+      const auto *Field = dyn_cast<FieldDecl>(Component.Field);
+      const auto *Record = Type->getAs<RecordType>();
+      if (!Field || !Record || Field->getParent()->getCanonicalDecl() != Record->getDecl()->getCanonicalDecl()) return false;
+      Source = fieldStorage(Source, Component.Field);
+    } else {
+      const auto *Array = Context.getAsArrayType(Type);
+      if (!Array) return false;
+      Source = indexedStorage(Source, Component.Index);
+    }
+    return readCallablePath(Source, Components.drop_front(), State, Result, Owners, Unowned, Depth + 1);
+  }
+  bool readCallableInitializer(const Expr *E, ArrayRef<PathNode> Components,
+                               const Facts &State, Value &Result,
+                               bool Owners = false, bool *Unowned = nullptr) const {
+    if (!E) return false;
+    if (Components.empty()) {
+      if (Owners) {
+        Result |= ownerIdentity(E, State);
+        if (Unowned) *Unowned |= ownerIsUnowned(E, State);
+      } else Result |= effects(E, State);
+      return true;
+    }
+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E)) return readCallableInitializer(Cleanups->getSubExpr(), Components, State, Result, Owners, Unowned);
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(E)) return readCallableInitializer(Temporary->getSubExpr(), Components, State, Result, Owners, Unowned);
+    if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(E)) return readCallableInitializer(Binding->getSubExpr(), Components, State, Result, Owners, Unowned);
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
+      if (modeledRecordCopy(Construction->getConstructor()) && Construction->getNumArgs() == 1)
+        return readCallableInitializer(Construction->getArg(0), Components, State, Result, Owners, Unowned);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) && Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+        return readCallableInitializer(Truth ? Conditional->getTrueExpr() : Conditional->getFalseExpr(), Components, State, Result, Owners, Unowned);
+      return readCallableInitializer(Conditional->getTrueExpr(), Components, State, Result, Owners, Unowned) &&
+             readCallableInitializer(Conditional->getFalseExpr(), Components, State, Result, Owners, Unowned);
+    }
+    if (const auto *List = dyn_cast<InitListExpr>(E)) {
+      if (List->getSemanticForm()) List = List->getSemanticForm();
+      const PathNode &Component = Components.front();
+      int64_t Index = Component.Index;
+      if (Component.BaseRecord || Component.Field) {
+        const auto *Record = E->getType()->getAs<RecordType>();
+        if (!Record) return false;
+        if (Record->getDecl()->isUnion()) {
+          const auto *Field = dyn_cast_or_null<FieldDecl>(Component.Field);
+          return Field && Field->getParent()->getCanonicalDecl() == Record->getDecl()->getCanonicalDecl() &&
+              readCallableInitializer(fieldInitializer(List, Field, 0),
+              Components.drop_front(), State, Result, Owners, Unowned);
+        }
+        Index = 0; bool Found = false;
+        if (const auto *CXX = dyn_cast<CXXRecordDecl>(Record->getDecl()))
+          for (const auto &Base : CXX->bases()) {
+            if (Component.BaseRecord && Base.getType()->getAsCXXRecordDecl() &&
+                Base.getType()->getAsCXXRecordDecl()->getCanonicalDecl() == Component.BaseRecord) {
+              Found = true; break;
+            }
+            ++Index;
+          }
+        if (!Component.BaseRecord)
+          for (const FieldDecl *Field : Record->getDecl()->fields()) {
+            if (Field->isUnnamedBitField()) continue;
+            if (Field == Component.Field) {Found = true;break;}
+            ++Index;
+          }
+        if (!Found) return false;
+      }
+      if (Index == -2) {
+        for (const Expr *Element : List->inits())
+          if (!readCallableInitializer(Element, Components.drop_front(), State, Result, Owners, Unowned)) return false;
+        return true;
+      }
+      if (Index < 0 || uint64_t(Index) >= List->getNumInits()) return false;
+      return readCallableInitializer(List->getInit(Index), Components.drop_front(), State, Result, Owners, Unowned);
+    }
+    return readCallablePath(storage(E, &State), Components, State, Result, Owners, Unowned);
+  }
+  Value effects(const Expr *E, const Facts &State) const {
+    if (!E) return empty();
+    if (auto Found = ExpressionSlots.find(E); Found != ExpressionSlots.end())
+      if (State.EvaluatedReady.test(Found->second)) {
+        Value Result = State.EvaluatedEffects[Found->second];
+        Result |= exposedEffects(State.EvaluatedMayTargets[Found->second], State);
+        return Result;
+      }
+    E = E->IgnoreParenCasts();
+    if (const auto *Statement = dyn_cast<StmtExpr>(E))
+      return effects(getObjC3StatementExpressionResult(*Statement), State);
+    if (const auto *Writeback = dyn_cast<ObjCIndirectCopyRestoreExpr>(E))
+      return Writeback->shouldCopy() ? effects(Writeback->getSubExpr(), State) : empty();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E)) return effects(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E)) return effects(Opaque->getSourceExpr(), State);
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(E)) return effects(Temporary->getSubExpr(), State);
+    if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(E)) return effects(Binding->getSubExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) &&
+          Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+        return effects(Truth ? Conditional->getTrueExpr() : Conditional->getFalseExpr(), State);
+      Value Result = effects(Conditional->getTrueExpr(), State);
+      Result |= effects(Conditional->getFalseExpr(), State);
+      return Result;
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp()) {
+        Value Result = effects(Binary->getRHS(), State);
+        if (Binary->isCompoundAssignmentOp()) Result |= effects(Binary->getLHS(), State);
+        return Result;
+      }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(E);
+        Unary && Unary->isIncrementDecrementOp()) return effects(Unary->getSubExpr(), State);
+    if (isa<BlockExpr, LambdaExpr>(E)) {
+      unsigned Slot = ClosureSlots.lookup(E);
+      if (State.CaptureReady.test(Slot)) return State.CapturedEffects[Slot];
+      Value Result = acquired(E, State);
+      for (int Bit = Result.find_first(); Bit >= 0; Bit = Result.find_next(Bit))
+        if (!Origins[Bit / 2].ConsumedByClosure) Result.reset(Bit);
+      if (auto Summary = OwnerSummaries->find(E); Summary != OwnerSummaries->end())
+        for (const auto &Invocation : Summary->second.InvokedPaths)
+          for (const auto &Capture : closureCaptures(E))
+            if (Capture.Variable == Invocation.Variable) {
+              bool Known = Capture.Initializer
+                  ? readCallableInitializer(Capture.Initializer, Invocation.Components, State, Result)
+                  : readCallablePath({Capture.Variable, nullptr}, Invocation.Components, State, Result);
+              if (!Known) UnqualifiedCallablePaths.insert(E);
+              break;
+            }
+      return Result;
+    }
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
+      if (modeledRecordCopy(Construction->getConstructor()) && Construction->getNumArgs() == 1)
+        return effects(Construction->getArg(0), State);
+    if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(E))
+      if (modeledRecordCopy(Operator->getDirectCallee()) && Operator->getNumArgs() == 2)
+        return effects(Operator->getArg(1), State);
+    Value Result = contents(storage(E, &State), E->getType(), State, true);
+    Result |= exposedEffects(possibleTargets(E, State), State);
+    SmallVector<Storage, 4> Alternatives;
+    if (localLValueAlternatives(E, State, Alternatives, false))
+      for (Storage Alternative : Alternatives) {
+        Result |= contents(Alternative, E->getType(), State, true);
+        Result |= exposedEffects(storageTargets(Alternative, E->getType(), State), State);
+      }
+    return Result;
+  }
+  bool overlapsUnion(Storage Location, Storage Other) const {
+    if (Location.first != Other.first)
+      return false;
+    for (unsigned Depth = 0; Depth != 32 && path(Location); ++Depth) {
+      Location = parentStorage(Location);
+      QualType Type = storageType(Location);
+      if (!Type.isNull())
+        if (const auto *Record = Type->getAs<RecordType>())
+          if (Record->getDecl()->isUnion() && within(Other, Location))
+            return true;
+    }
+    return false;
+  }
+  Value contents(Storage Location, QualType Type, const Facts &State,
+                 bool Effects = false) const {
+    Value Result = empty();
+    if (!Location.first)
+      return Result;
+    bool Aggregate = !Type.isNull() && (Type->isRecordType() || Type->isArrayType());
+    bool CopiedScalar = !Type.isNull() &&
+                        (Type->isArithmeticType() || Type->isEnumeralType());
+    unsigned Query = path(Location);
+    for (auto [Other, Index] : Slots) {
+      if (Other.first != Location.first)
+        continue;
+      if (pathsMayAlias(path(Other), Query) ||
+          (!CopiedScalar && within(Location, Other)) ||
+          overlapsUnion(Location, Other) || (Aggregate && within(Other, Location)))
+        Result |= Effects ? State.Effects[Index] : State.Values[Index];
+      if (!Effects && Aggregate && path(Other) != Query && within(Other, Location) &&
+          State.References[Index].AddressLoans.any())
+        Result |= State.References[Index].AddressLoans;
+    }
+    return Result;
+  }
+  Value storageTargets(Storage Location, QualType Type, const Facts &State) const {
+    Value Result(Slots.size());
+    if (!Location.first)
+      return Result;
+    bool Aggregate = !Type.isNull() && (Type->isRecordType() || Type->isArrayType());
+    unsigned Query = path(Location);
+    for (auto [Other, Index] : Slots)
+      if (Other.first == Location.first &&
+          (pathsMayAlias(path(Other), Query) || within(Location, Other) ||
+           overlapsUnion(Location, Other) || (Aggregate && within(Other, Location)))) {
+        Result |= State.MayTargets[Index];
+        for (Storage Target : State.References[Index].Targets)
+          if (auto Found = Slots.find(Target); Found != Slots.end()) Result.set(Found->second);
+      }
+    return Result;
+  }
+  Storage location(unsigned Index) const {
+    for (auto [Location, Slot] : Slots)
+      if (Slot == Index)
+        return Location;
+    return {};
+  }
+  Value exposedTargets(const Value &Targets, const Facts &State) const {
+    Value Result = empty(), Pending = Targets;
+    Value Seen(Slots.size());
+    while (true) {
+      Pending.reset(Seen);
+      int Index = Pending.find_first();
+      if (Index < 0)
+        break;
+      Seen.set(Index);
+      Storage Location = addressExposure(location(Index));
+      Result |= contents(Location, storageType(Location), State);
+      Pending |= storageTargets(Location, storageType(Location), State);
+    }
+    return Result;
+  }
+  std::optional<int64_t> pointerDelta(const Expr *Amount, bool Subtract) const {
+    auto Integer = Amount->getIntegerConstantExpr(Context);
+    if (!Integer || Integer->getSignificantBits() > 63) return std::nullopt;
+    int64_t Delta = Integer->getSExtValue();
+    return Subtract ? -Delta : Delta;
+  }
+  Storage constantTargetDelta(Storage Base, int64_t Delta) const {
+    if (!Base.first) return {};
+    if (!Delta) return Base;
+    if (Base.Index < 0 ||
+        (Delta > 0 && Base.Index > INT64_MAX - Delta) ||
+        (Delta < 0 && Delta < -Base.Index)) return {};
+    Base.Index += Delta;
+    return Slots.count(Base) ? Base : Storage{};
+  }
