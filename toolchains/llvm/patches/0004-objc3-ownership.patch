+    Nested.InheritedEffects[Destination] = effects(Initializer, State);
+    Nested.InheritedOwners[Variable] = ownerIdentity(Initializer, State);
+    Nested.InheritedTargets[Destination] = referent(Initializer, &State);
+    Nested.InheritedClosedTargets[Destination] = closedTargets(Initializer, State);
+    Nested.InheritedNonNullTargets[Destination] = nonNullAddress(Initializer, State);
+    Nested.InheritedByteTargets[Destination] = byteFacts(Initializer, State);
