+    if (localLValueAlternatives(E, State, Alternatives, false)) {
+      Value Result = empty();
+      for (Storage Alternative : Alternatives)
+        Result |= storedValue(Alternative, E->getType(), State);
+      return Result;
+    }
+    // A declaration-provided borrowed type with no tracked local definition
+    // (e.g. a field, foreign function pointer, or imported declaration) cannot
+    // silently become unborrowed merely because its acquisition is opaque.
+    if (carriesBorrowedValue(E->getType())) {
+      Value Result = empty();
+      Result.set(0);
+      return Result;
+    }
+    return empty();
+  }
+  void diagnose(const Stmt *Operation, StringRef Description) {
+    if (IsOwnerSummary) {Invalid = true;return;}
+    if (!Diagnosed.insert(Operation).second)
+      return;
+    Actions.Diag(Operation->getBeginLoc(),
+                 Actions.getDiagnostics().getCustomDiagID(
+                     DiagnosticsEngine::Error,
+                     "borrowed pointer escapes through %0; extend owner lifetime with withLifetime/keepAlive, copy data to owned storage, or mark the operation explicitly unsafe"))
+        << Description;
+    Invalid = true;
+  }
+  void expire(const VarDecl *Owner, Facts &State) const {
+    if (!Owner || !ExpiringOwners.insert(Owner).second) return;
+    if (Owner)
+      for (const auto &[Variable, Index] : OwnerRoots) {
+        (void)Index;
+        if (!Variable || Variable == Owner) continue;
+        auto Slot = Slots.find({Variable, nullptr});
+        if (Slot == Slots.end() || !State.References[Slot->second].Initialized) continue;
+        bool ReferencesOwner = llvm::any_of(State.References[Slot->second].Targets,
+            [&](Storage Target) {return Target.first == Owner;});
+        if (ReferencesOwner) expire(Variable, State);
+      }
+    if (auto Root = OwnerRoots.find(Owner); Root != OwnerRoots.end())
+      State.ExtraOwnerClaims[Root->second] = 0;
+    auto ExpireValue = [&](Value &V) {
+      for (unsigned I = 0; I != Origins.size(); ++I) {
+        const Origin &O = Origins[I];
+        if (O.HeldByClosure)
+          continue;
+        if ((O.Pin ? O.Pin == Owner : O.Owner == Owner) && V.test(I * 2)) {
+          unsigned Replacement = Origins.size();
+          auto Acquisition = Acquisitions.find(O.Acquisition);
+          if (Acquisition != Acquisitions.end())
+            for (unsigned Candidate : Acquisition->second) {
+              const Origin &Alternative = Origins[Candidate];
+              if (!O.Pin && !O.Unstable && !Alternative.Unstable && !Alternative.Pin &&
+                  ownerIndex(Alternative)==ownerIndex(O) && O.Identity && Alternative.Owner &&
+                  Alternative.Owner!=Owner && (O.IndependentAlias || Alternative.IndependentAlias)) {
+                Value Identity(OwnerCount);bool Unowned = false;
+                if (originOwnerFacts(Candidate, State, Identity, Unowned) && !Unowned &&
+                    Identity.count() == 1 && Identity.test(ownerIndex(O))) {
+                  Replacement = Candidate;break;
+                }
+              }
+              if (ownerIndex(Alternative) != ownerIndex(O) ||
+                  (Alternative.Owner != O.Owner &&
+                   !(O.Pin && !Alternative.Pin && Alternative.IndependentAlias)))
+                continue;
+              if (Alternative.Pin && Alternative.Pin != Owner &&
+                  matchesPin(O, Alternative.Pin, State, I)) {
+                Replacement = Candidate;
+                break;
+              }
+              if (O.Pin && !Alternative.Pin && !Alternative.Unstable &&
+                  Alternative.Owner && Alternative.Owner != Owner) {
+                Value Identities(OwnerCount);bool Unowned = false;
+                if (!originOwnerFacts(Candidate, State, Identities, Unowned) || Unowned) continue;
+                bool SameStorage = false;
+                if (auto Source = OriginOwnerStorage.find(Candidate); Source != OriginOwnerStorage.end())
