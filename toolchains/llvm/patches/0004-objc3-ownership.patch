+                    ((O.Identity && Identities.count() == 1) ||
+                     (((O.Owner && PinSources.lookup(O.Pin) == O.Owner) || SameStorage) &&
+                      State.SamePins.test(Pins.lookup(O.Pin))))) {
+                  Replacement = Candidate;
+                  break;
+                }
+              }
+            }
+          V.reset(I * 2);
+          if (Replacement != Origins.size())
+            V.set(Replacement * 2);
+          else
+            V.set(I * 2 + 1);
+        }
+      }
+    };
+    for (Value &V : State.Values)
+      ExpireValue(V);
+    for (Value &V : State.CapturedValues)
+      ExpireValue(V);
+    for (Value &V : State.EvaluatedValues)
+      ExpireValue(V);
+    for (Value &V : State.EvaluatedAcquisitions)
+      ExpireValue(V);
+    for (auto &Reference : State.References)
+      if (Reference.AddressLoans.any()) ExpireValue(Reference.AddressLoans);
+    if (auto Slot = Slots.find({Owner, nullptr}); Slot != Slots.end())
+      State.OwnerIdentities[Slot->second].reset();
+    for (auto [Pin, Source] : PinSources)
+      if (Source == Owner || State.PinLocations[Pins.lookup(Pin)].first == Owner)
+        State.SamePins.reset(Pins.lookup(Pin));
+    if (auto Found = Pins.find(Owner); Found != Pins.end()) {
+      State.ActivePins.reset(Found->second);
+      State.SamePins.reset(Found->second);
+    }
+    ExpiringOwners.erase(Owner);
+  }
+  const FunctionType *callFunctionType(const Expr *Invocation) const {
+    const auto *Call = dyn_cast<CallExpr>(Invocation);
+    if (!Call) return nullptr;
+    QualType Type = Call->getCallee()->getType();
+    if (Type->isPointerType() || Type->isBlockPointerType())
+      Type = Type->getPointeeType();
+    else if (Type->isSpecificPlaceholderType(BuiltinType::BoundMember)) {
+      const Expr *Bound = Call->getCallee()->IgnoreParens();
+      if (!isa<MemberExpr>(Bound) && !isa<BinaryOperator>(Bound)) return nullptr;
+      Type = Expr::findBoundMemberType(Bound);
+    }
+    return Type.isNull() ? nullptr : Type->getAs<FunctionType>();
+  }
+  const FunctionProtoType *callPrototype(const Expr *Invocation) const {
+    return dyn_cast_or_null<FunctionProtoType>(callFunctionType(Invocation));
+  }
+  bool observeOwnerConsumption(const Expr *Invocation, Facts &State) const {
+    if (addressBuiltin(callee(Invocation)) || compilerRuntimeHelper(callee(Invocation))) return false;
+    const bool ARC = Actions.getLangOpts().ObjCAutoRefCount;
+    Value Identity(OwnerCount), Unbounded(OwnerCount);
+    llvm::DenseMap<unsigned, unsigned> ConsumedClaims;
+    auto Consume = [&](const Value &Owners) {
+      Identity |= Owners;
+      for (int I = Owners.find_first(); I >= 0; I = Owners.find_next(I))
+        ++ConsumedClaims[I];
+    };
+    const Expr *RetainedOwner = nullptr;
+    const Expr *DeferredOwner = nullptr;
+    const auto Family = familyCall(Invocation);
+    const bool FamilyRelease = Family.MayRelease;
+    if (Family.Common && isa<ObjCFamilyRetainAttr>(Family.Common))
+      RetainedOwner = argument(Invocation, 0);
+    if (Family.MayAutorelease) DeferredOwner = argument(Invocation, 0);
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation); Message && !ARC) {
+      if (Message->getReceiverKind() == ObjCMessageExpr::Instance) {
+        if (Message->getMethodFamily() == OMF_retain) RetainedOwner = Message->getInstanceReceiver();
+        else if (Message->getMethodFamily() == OMF_autorelease) DeferredOwner = Message->getInstanceReceiver();
+      }
+      const auto *Method = Message->getMethodDecl();
+      if ((!Method || !Method->isClassMethod()) &&
+          (Message->getMethodFamily() == OMF_release ||
+           (Method && Method->hasAttr<NSConsumesSelfAttr>()))) {
+        Consume(evaluatedOwnerIdentity(Message->getInstanceReceiver(), State));
+        if (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance)
+          for (const Decl *Scope = Callable; Scope;
+               Scope = Scope->getDeclContext()
+                           ? Decl::castFromDeclContext(Scope->getDeclContext()) : nullptr)
+            if (const auto *Current = dyn_cast<ObjCMethodDecl>(Scope)) {
+              if (auto Slot = Slots.find({Current->getSelfDecl(), nullptr}); Slot != Slots.end())
+                Consume(State.OwnerIdentities[Slot->second]);
+              break;
+            }
+      }
+    }
+    if (RetainedOwner && Invocation != SuppressedRetainClaim &&
+        !ownerIsUnowned(RetainedOwner, State)) {
+      Value Owners = evaluatedOwnerIdentity(RetainedOwner, State);
+      // A may set cannot establish a retain for every possible object. Only
+      // one proven identity gains a definite additional lifetime claim.
+      if (Owners.count() == 1) {
+        unsigned Root = Owners.find_first();
+        // A source-sized cap keeps loops finite without truncating an
+        // arbitrarily long straight-line sequence of explicit retains.
+        if (State.ExtraOwnerClaims[Root] < ExpressionSlots.size())
+          ++State.ExtraOwnerClaims[Root];
+      }
+    }
+    if (DeferredOwner) {
+      // Pool/deferred release ordering is a separate proof. Stop using these
+      // extra counts rather than pretending that a scheduled release vanished.
+      Value Owners = evaluatedOwnerIdentity(DeferredOwner, State);
+      bool NativeMessage = isa<ObjCMessageExpr>(Invocation);
+      if (!NativeMessage || !scheduleNativePoolRelease(Owners, State)) {
+        for (int I = Owners.find_first(); I >= 0; I = Owners.find_next(I)) State.ExtraOwnerClaims[I] = 0;
+        // A captured callback can schedule a release in its caller's ambient
+        // pool. Until that queue is explicit in callable summaries, retain its
+        // possible lifetime effect rather than silently dropping the release.
+        if (IsOwnerSummary) {
+          for (const auto &[Root, Index] : OwnerRoots)
+            if (Root && Owners.test(Index)) ConsumedOwnerRoots.insert(Root);
+          for (const auto &[Location, Index] : StorageOwnerRoots) {
+            (void)Location;if (Owners.test(Index)) ConsumedStorageOwners.insert(Index);
+          }
+        }
+      }
+    }
+    if (FamilyRelease) Consume(evaluatedOwnerIdentity(argument(Invocation, 0), State));
+    const auto Formals = formalParameters(callee(Invocation));
+    unsigned Count = 0;
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) Count = Call->getNumArgs();
+    else if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation)) Count = Message->getNumArgs();
+    else if (const auto *Construction = dyn_cast<CXXConstructExpr>(Invocation)) Count = Construction->getNumArgs();
+    const FunctionProtoType *Prototype = callPrototype(Invocation);
+    for (unsigned I = 0; I != Count; ++I) {
+      const unsigned Formal = formalIndex(Invocation, I);
+      bool Consumed = false;
+      if (Formal < Formals.size()) {
+        const auto *Parameter = Formals[Formal];
+        Consumed = Parameter->hasAttr<CFConsumedAttr>() ||
+            (!ARC && Parameter->hasAttr<NSConsumedAttr>() &&
+             Parameter->getType()->isObjCRetainableType());
+      }
+      if (Prototype && Formal < Prototype->getNumParams())
+        Consumed |= Prototype->getExtParameterInfo(Formal).isCFConsumed() ||
+            (!ARC && Prototype->isParamConsumed(Formal) &&
+             Prototype->getParamType(Formal)->isObjCRetainableType());
