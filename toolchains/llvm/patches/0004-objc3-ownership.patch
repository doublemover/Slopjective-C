+    bool HasReturn=false;
+    while(!Pending.empty()) {
+      const Stmt *Node=Pending.pop_back_val();
+      if(!Node)continue;
+      if(!Budget)return false;
+      --Budget;
+      if(const auto *Lambda=dyn_cast<LambdaExpr>(Node)) {
+        for(const Expr *Initializer:Lambda->capture_inits())Pending.push_back(Initializer);
+        continue;
+      }
+      if(isa<BlockExpr>(Node))continue;
+      if(const auto *Return=dyn_cast<ReturnStmt>(Node)) {
+        HasReturn=true;
+        if(CheckReferenceObject && Function->getReturnType()->isReferenceType() &&
+            !Function->getReturnType().getNonReferenceType()->isFunctionType() &&
+            !staticReferenceResultObject(Return->getRetValue(),Depth+1,Budget,Bindings))return false;
+        if(!Prove(Return->getRetValue(),Depth+1,Budget,Bindings))return false;
+      }
+      for(const Stmt *Child:Node->children())Pending.push_back(Child);
+    }
+    if(!HasReturn || !Budget)return false;
