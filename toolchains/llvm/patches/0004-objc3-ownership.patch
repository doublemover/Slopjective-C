+      for (Storage Base : Bases) {
+        Storage Field = fieldStorage(Base, Member->getMemberDecl());
+        if (!Slots.count(Field) || (RequireComplete && hasUnknownIndex(Field))) {
+          if (RequireComplete) return false;
+          continue;
+        }
+        const auto &Binding = State.References[Slots.lookup(Field)];
+        if (Member->getMemberDecl()->getType()->isReferenceType() && Binding.Initialized) {
+          if (RequireComplete && !Binding.Complete) return false;
+          for (Storage Target : Binding.Targets) {
+            if (RequireComplete && (hasUnknownIndex(Target) || (RequireLocal && !localObject(Target)))) return false;
+            if (!llvm::is_contained(Targets, Target)) Targets.push_back(Target);
+          }
+        } else {
+          if (RequireComplete && RequireLocal && !localObject(Field)) return false;
+          if (!llvm::is_contained(Targets, Field)) Targets.push_back(Field);
+        }
+      }
+      return !Targets.empty();
+    }
+    if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(E)) {
+      if (!PointerTargets(Subscript->getBase(), Bases)) return false;
