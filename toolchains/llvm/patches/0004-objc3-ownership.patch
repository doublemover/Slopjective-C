+  const LambdaExpr *immediateLambdaReceiver(const Expr *Receiver) const {
+    for (unsigned Depth = 0; Receiver && Depth != 32; ++Depth) {
+      Receiver = Receiver->IgnoreParenImpCasts();
+      if (const auto *Lambda = dyn_cast<LambdaExpr>(Receiver)) return Lambda;
+      if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(Receiver)) Receiver = Temporary->getSubExpr();
+      else if (const auto *Temporary = dyn_cast<CXXBindTemporaryExpr>(Receiver)) Receiver = Temporary->getSubExpr();
+      else if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Receiver)) Receiver = Cleanups->getSubExpr();
+      else return nullptr;
+    }
+    return nullptr;
+  }
+  bool immediateReadOnlyLambdaBody(const FunctionDecl *Function, const Stmt *Body) const {
+    const auto *Prototype = Function->getType()->getAs<FunctionProtoType>();
+    if (!Prototype || Prototype->getObjC3FunctionEffects().Async ||
+        isa<CoroutineBodyStmt>(Body)) return false;
+    QualType Result = Function->getReturnType();
+    if (!Result->isVoidType() && !Result->isIntegralOrEnumerationType() &&
+        !Result->isRealFloatingType() && !Result->isAnyComplexType()) return false;
+    auto LocalOrScalarWrite = [&](const Expr *Written, auto &&Self, unsigned Depth = 0) -> bool {
+      if (!Written || Depth > 32) return false;
+      Written = Written->IgnoreParenImpCasts();
+      if (const auto *Reference = dyn_cast<DeclRefExpr>(Written)) {
+        const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl());
+        if (!Variable) return false;
+        if (Variable->getDeclContext() == Function && Variable->hasLocalStorage() &&
+            !Variable->getType()->isReferenceType()) return true;
+        QualType Type = Written->getType();
+        // Scalar updates do not rebind an owner/address. If an integer carries
+        // loan provenance, ordinary nested store checks still protect it.
+        return Type->isIntegralOrEnumerationType() || Type->isRealFloatingType() || Type->isAnyComplexType();
+      }
+      if (const auto *Member = dyn_cast<MemberExpr>(Written); Member && !Member->isArrow()) {
+        if (const auto *Field = dyn_cast<FieldDecl>(Member->getMemberDecl());
+            Field && Field->getType()->isReferenceType()) return false;
+        return Self(Member->getBase(), Self, Depth + 1);
+      }
+      if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(Written))
+        return Subscript->getBase()->IgnoreParenImpCasts()->getType()->isArrayType() &&
+               Self(Subscript->getBase(), Self, Depth + 1);
+      return false;
+    };
+    SmallVector<const Stmt *, 16> Pending{Body};
+    unsigned Budget = 4096;
+    while (!Pending.empty()) {
+      const Stmt *Node = Pending.pop_back_val();
+      if (!Node) continue;
+      if (!Budget--) return false;
+      if (isa<LambdaExpr, BlockExpr, ObjCMessageExpr, CXXConstructExpr,
+              CXXMemberCallExpr, CXXOperatorCallExpr, AsmStmt, VAArgExpr,
+              CXXNewExpr, CXXDeleteExpr>(Node)) return false;
+      if (const auto *Binary = dyn_cast<BinaryOperator>(Node); Binary && Binary->isAssignmentOp())
+        if (!LocalOrScalarWrite(Binary->getLHS(), LocalOrScalarWrite)) return false;
+      if (const auto *Unary = dyn_cast<UnaryOperator>(Node)) {
+        if (Unary->getOpcode() == UO_AddrOf) return false;
+        if (Unary->isIncrementDecrementOp() && !LocalOrScalarWrite(Unary->getSubExpr(), LocalOrScalarWrite)) return false;
+      }
