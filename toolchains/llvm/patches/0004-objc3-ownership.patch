+    // a loop's fallthrough or a goto to the end cannot fabricate static storage.
+    // Throw/noreturn exits produce no pointer result and impose no return proof.
+    for(const auto &Edge:Graph->getExit().preds()) {
+      const CFGBlock *Block=Edge.getReachableBlock();
+      if(!Block)continue;
