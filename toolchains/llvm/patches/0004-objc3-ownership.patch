+      if (Origins[Bit / 2].Identity != Owner || Origins[Bit / 2].StorageIdentity != ~0U)
+        return false;
+    return true;
+  }
+  bool localLValueAlternatives(const Expr *E, const Facts &State,
+                               SmallVectorImpl<Storage> &Targets,
+                               bool RequireComplete = true,
+                               unsigned Depth = 0, bool RequireLocal = true) const {
+    if (!E || Depth > 32) return false;
+    E = E->IgnoreParens();
+    if (const auto *Binding = referenceFacts(E, State)) {
+      if (RequireComplete && !Binding->Complete) return false;
+      for (Storage Target : Binding->Targets) {
+        if (!Slots.count(Target) || (RequireComplete &&
+            (hasUnknownIndex(Target) || (RequireLocal && !localObject(Target))))) {
+          if (RequireComplete) return false;
+          continue;
+        }
+        if (!llvm::is_contained(Targets, Target)) Targets.push_back(Target);
+      }
+      return !Targets.empty();
+    }
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E); Conditional && E->isGLValue()) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) && Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+        return localLValueAlternatives(Truth ? Conditional->getTrueExpr() : Conditional->getFalseExpr(), State, Targets, RequireComplete, Depth, RequireLocal);
+      SmallVector<Storage, 4> Left, Right;
+      bool L = localLValueAlternatives(Conditional->getTrueExpr(), State, Left, RequireComplete, Depth, RequireLocal);
+      bool R = localLValueAlternatives(Conditional->getFalseExpr(), State, Right, RequireComplete, Depth, RequireLocal);
+      if (RequireComplete && (!L || !R)) return false;
+      for (Storage Target : Left) if (!llvm::is_contained(Targets, Target)) Targets.push_back(Target);
+      for (Storage Target : Right) if (!llvm::is_contained(Targets, Target)) Targets.push_back(Target);
+      return !Targets.empty();
+    }
+    Storage Known = storage(E, &State);
+    if ((!Known.first || !typedWriteTarget(Known, E->getType())) &&
+        typedByteLValueTargets(E, State, Targets)) return true;
+    if (Known.first) {
+      if (!Slots.count(Known)) {
+        if (RequireComplete) return false;
+        Known = {Known.first, nullptr};
+      }
+      if (RequireComplete &&
+          ((RequireLocal && !localObject(Known)) || hasUnknownIndex(Known))) return false;
+      Targets.push_back(Known);
+      return true;
+    }
+    auto PointerTargets = [&](const Expr *Pointer, SmallVectorImpl<Storage> &Result) {
+      if (RequireComplete && RequireLocal) return finiteLocalTargets(Pointer, State, Result);
+      if (RequireComplete && !closedTargets(Pointer, State)) return false;
+      Value Possible = possibleTargets(Pointer, State);
+      for (int I = Possible.find_first(); I >= 0; I = Possible.find_next(I))
+        Result.push_back(location(I));
+      return !Result.empty();
+    };
