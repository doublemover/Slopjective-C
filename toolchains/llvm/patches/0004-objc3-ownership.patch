+#include <memory>
+#include <vector>
+using namespace clang;
+
+void clang::handleObjC3ReturnsBorrowedAttr(Sema &S, Decl *D,
+                                          const ParsedAttr &Attribute) {
+  auto Reject = [&](StringRef Message) {
+    S.Diag(Attribute.getLoc(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                  DiagnosticIDs::Level::Error, Message));
+    D->setInvalidDecl();
+  };
+  if (Attribute.isUsedAsTypeAttr() && !isa<FunctionDecl, ObjCMethodDecl>(D)) return;
+  if (!S.getLangOpts().ObjC3) {
+    Reject("objc_returns_borrowed requires Objective-C 3.0");
+    return;
+  }
+  if (D->hasAttr<ObjCReturnsInnerPointerAttr>()) {
+    Reject("objc_returns_borrowed cannot combine a formal owner with objc_returns_inner_pointer receiver ownership");
+    return;
+  }
+  ArrayRef<ParmVarDecl *> Parameters;
+  QualType Return;
+  if (const auto *Function = dyn_cast<FunctionDecl>(D)) {
+    Parameters = Function->parameters();
+    Return = Function->getReturnType();
+  } else if (const auto *Method = dyn_cast<ObjCMethodDecl>(D)) {
+    Parameters = Method->parameters();
+    Return = Method->getReturnType();
+  } else {
+    Reject("objc_returns_borrowed requires a function or method declaration");
+    return;
+  }
+  const auto *Function = dyn_cast<FunctionDecl>(D);
+  const auto *Prototype = Function ? Function->getType()->getAs<FunctionType>() : nullptr;
+  if (!isObjC3BorrowedType(S.Context, Return) &&
+      !(Prototype && Prototype->hasObjC3BorrowedResult())) {
+    Reject("objc_returns_borrowed requires a borrowed pointer return type");
+    return;
+  }
+  Expr *Argument = Attribute.getArgAsExpr(0);
+  auto Index = Argument->getIntegerConstantExpr(S.Context);
+  if (!Index || Index->isNegative() || Index->getActiveBits() > 32 ||
+      Index->getZExtValue() >= Parameters.size()) {
+    Reject("objc_returns_borrowed owner_index must be a valid zero-based formal parameter index");
+    return;
+  }
+  unsigned N = Index->getZExtValue();
+  QualType OwnerType = Parameters[N]->getType();
+  if ((!OwnerType->isDependentType() && !(OwnerType->isPointerType() || OwnerType->isObjCObjectPointerType() ||
+        OwnerType->isReferenceType() || OwnerType->isBlockPointerType())) ||
+      isObjC3BorrowedType(S.Context, OwnerType.getNonReferenceType())) {
+    Reject("objc_returns_borrowed owner parameter must be an owning object, reference, or non-borrowed pointer");
+    return;
+  }
+  if (const auto *Existing = D->getAttr<ObjCReturnsBorrowedAttr>()) {
+    if (Existing->getOwnerIndex() != N)
+      Reject("conflicting objc_returns_borrowed owner parameter indices");
+    return;
+  }
+  D->addAttr(ObjCReturnsBorrowedAttr::Create(S.Context, N, Attribute));
+  if (auto *Function = dyn_cast<FunctionDecl>(D)) {
+    const auto *Type = Function->getType()->getAs<FunctionProtoType>();
+    if (!Type) {Reject("objc_returns_borrowed requires a prototyped function"); return;}
+    auto EPI = Type->getExtProtoInfo(); EPI.ObjC3BorrowedOwner = N + 1;
+    Function->setType(S.Context.getFunctionType(Type->getReturnType(), Type->getParamTypes(), EPI));
+  }
+}
+
+bool clang::checkObjC3BorrowedRedeclaration(Sema &S, FunctionDecl *New,
+                                           FunctionDecl *Old) {
+  if (!S.getLangOpts().ObjC3 ||
+      sameObjC3BorrowedSignature(S.Context, New, S.Context, Old))
+    return false;
+  S.Diag(New->getLocation(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                DiagnosticIDs::Level::Error,
+                                "conflicting borrowed pointer declaration contract for '%0'"))
+      << New;
+  S.Diag(Old->getLocation(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                DiagnosticIDs::Level::Note,
+                                "previous borrowed pointer contract is declared here"));
+  return true;
+}
+
+QualType clang::preserveObjC3BorrowedType(Sema &S, QualType Composite,
+                                         QualType Source) {
+  ASTContext &Context = S.Context;
+  if (!S.getLangOpts().ObjC3 || Composite.isNull() || Source.isNull() ||
+      sameObjC3BorrowedType(Context, Composite, Context, Source))
+    return Composite;
+  // Keep other merged type attributes (nullability, calling convention, etc.)
+  // while inserting the ABI-neutral lifetime marker at its source positions.
+  if (const auto *Attribute = dyn_cast<AttributedType>(Composite.getTypePtr())) {
+    QualType Modified = preserveObjC3BorrowedType(S, Attribute->getModifiedType(), Source);
+    QualType Equivalent = preserveObjC3BorrowedType(S, Attribute->getEquivalentType(), Source);
+    return Context.getAttributedType(Attribute->getAttrKind(), Modified,
+                                      Equivalent, Attribute->getAttr());
+  }
+  QualType Result = Composite;
+  if (const auto *CF = Composite->getAs<FunctionProtoType>()) {
+    if (const auto *SF = Source->getAs<FunctionProtoType>()) {
+      if (CF->getNumParams() == SF->getNumParams()) {
+        SmallVector<QualType, 8> Parameters;
+        for (unsigned I = 0; I != CF->getNumParams(); ++I)
+          Parameters.push_back(preserveObjC3BorrowedType(
+              S, CF->getParamType(I), SF->getParamType(I)));
+        auto EPI = CF->getExtProtoInfo();
+        EPI.ObjC3BorrowedOwner = SF->getObjC3BorrowedOwner();
+        Result = Context.getFunctionType(preserveObjC3BorrowedType(
+            S, CF->getReturnType(), SF->getReturnType()), Parameters, EPI);
+      }
+    }
+  } else if (const auto *CF = Composite->getAs<FunctionNoProtoType>()) {
+    if (const auto *SF = Source->getAs<FunctionType>())
+      Result = Context.getFunctionNoProtoType(preserveObjC3BorrowedType(
+          S, CF->getReturnType(), SF->getReturnType()), CF->getExtInfo());
+  } else if (Composite->isPointerType() && Source->isPointerType()) {
+    Result = Context.getPointerType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isBlockPointerType() && Source->isBlockPointerType()) {
+    Result = Context.getBlockPointerType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isLValueReferenceType() && Source->isReferenceType()) {
+    Result = Context.getLValueReferenceType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isRValueReferenceType() && Source->isReferenceType()) {
+    Result = Context.getRValueReferenceType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (const auto *CO = Composite->getAs<ObjC3OptionalType>()) {
+    if (const auto *SO = Source->getAs<ObjC3OptionalType>())
+      Result = Context.getObjC3OptionalType(preserveObjC3BorrowedType(
+          S, CO->getElementType(), SO->getElementType()));
+  } else if (const auto *CR = Composite->getAs<ObjC3ResultType>()) {
+    if (const auto *SR = Source->getAs<ObjC3ResultType>())
+      Result = Context.getObjC3ResultType(preserveObjC3BorrowedType(
+          S, CR->getSuccessType(), SR->getSuccessType()),
+          preserveObjC3BorrowedType(S, CR->getErrorType(), SR->getErrorType()));
+  } else if (const auto *CA = Context.getAsArrayType(Composite)) {
+    if (const auto *SA = Context.getAsArrayType(Source)) {
+      QualType Element = preserveObjC3BorrowedType(
+          S, CA->getElementType(), SA->getElementType());
+      if (const auto *Constant = dyn_cast<ConstantArrayType>(CA))
+        Result = Context.getConstantArrayType(Element, Constant->getSize(),
+            Constant->getSizeExpr(), CA->getSizeModifier(),
+            CA->getIndexTypeCVRQualifiers());
+      else if (isa<IncompleteArrayType>(CA))
+        Result = Context.getIncompleteArrayType(Element, CA->getSizeModifier(),
+                                                CA->getIndexTypeCVRQualifiers());
+      else if (const auto *Variable = dyn_cast<VariableArrayType>(CA))
+        Result = Context.getVariableArrayType(Element, Variable->getSizeExpr(),
+            CA->getSizeModifier(), CA->getIndexTypeCVRQualifiers());
+    }
+  }
+  Result = Context.getQualifiedType(Result, Composite.getQualifiers());
+  if (isObjC3BorrowedType(Context, Source) &&
+      !isObjC3BorrowedType(Context, Result)) {
+    auto *Marker = ObjC3BorrowedAttr::CreateImplicit(Context);
+    Result = Context.getAttributedType(Marker, Result, Result);
+  }
+  return Result;
+}
+
+namespace {
+/// A forward may analysis. Every bit names an acquisition and its owner;
+/// adjacent bits distinguish live and expired values. Assignment kills old
+/// local facts, joins preserve alternatives, and owner destruction/replacement
+/// expires existing aliases without poisoning later acquisitions at that site.
+class BorrowedFlow {
+  struct Origin {
+    const Stmt *Acquisition = nullptr;
+    const VarDecl *Owner = nullptr;
+    const VarDecl *Identity = nullptr;
+    const VarDecl *Pin = nullptr;
+    bool Unstable = false;
+    const Expr *HeldByClosure = nullptr;
+    bool ConsumedByClosure = false;
+    bool SymbolicCallable = false;
+    bool IndependentAlias = false;
+    unsigned StorageIdentity = ~0U;
+  };
+  using Value = llvm::BitVector;
+  struct Storage {
+    const VarDecl *first = nullptr;
+    const ValueDecl *second = nullptr;
+    // -1 is the variable/field itself; -2 is an unknown array index.
+    int64_t Index = -1;
+    unsigned Parent = 0;
+    const CXXRecordDecl *BaseRecord = nullptr;
+    bool VirtualBase = false;
+    bool operator==(const Storage &Other) const {
+      return first == Other.first && second == Other.second &&
+             Index == Other.Index && Parent == Other.Parent &&
+             BaseRecord == Other.BaseRecord && VirtualBase == Other.VirtualBase;
+    }
+  };
+  struct StorageInfo {
+    static unsigned getHashValue(const Storage &S) {
+      return llvm::hash_combine(S.first, S.second, S.Index, S.Parent, S.BaseRecord, S.VirtualBase);
+    }
+    static bool isEqual(const Storage &A, const Storage &B) { return A == B; }
+  };
+  struct BytePosition {
+    Storage Base;
+    int64_t Offset;
+    bool operator==(const BytePosition &Other) const {
+      return Base == Other.Base && Offset == Other.Offset;
+    }
+  };
+  struct ByteFacts {
+    SmallVector<BytePosition, 4> Positions;
+    bool Complete = false;
+    bool operator==(const ByteFacts &Other) const {
+      return Complete == Other.Complete && Positions == Other.Positions;
+    }
+  };
+  struct ReferenceFacts {
+    SmallVector<Storage, 2> Targets;
+    bool Complete = false;
+    bool Initialized = false;
+    Value AddressLoans;
+    bool operator==(const ReferenceFacts &Other) const {
+      return Complete == Other.Complete && Initialized == Other.Initialized && Targets == Other.Targets &&
+             AddressLoans == Other.AddressLoans;
+    }
+  };
+  struct Facts {
+    SmallVector<Value, 16> Values;
+    SmallVector<Value, 16> Effects;
+    SmallVector<Value, 16> OwnerIdentities;
+    // Lower bounds on explicit manual/family retains in addition to the
+    // original lifetime claim. Saturation is conservative; joins take min.
+    SmallVector<unsigned, 16> ExtraOwnerClaims;
+    Value ActiveNativePools;
+    SmallVector<SmallVector<unsigned, 8>, 4> NativePoolClaims;
+    SmallVector<Storage, 16> LocalTargets;
+    SmallVector<Value, 16> MayTargets;
+    SmallVector<ByteFacts, 16> ByteTargets;
+    SmallVector<ReferenceFacts, 16> References;
+    // Every non-null target is represented in MayTargets. A partial may set
+    // must never justify a definite referent or a finite local write.
+    Value ClosedTargets;
+    Value NonNullTargets; // Complete address sets can still include null.
+    SmallVector<Value, 4> CapturedValues;
+    SmallVector<Value, 4> CapturedEffects;
+    SmallVector<Value, 4> CapturedReferenceTargets;
+    Value CaptureReady;
+    Value UnownedOwners;
+    SmallVector<Value, 16> EvaluatedValues;
+    SmallVector<Value, 16> EvaluatedEffects;
+    SmallVector<Value, 16> EvaluatedOwners;
+    SmallVector<Value, 16> EvaluatedAcquisitions;
+    Value AcquisitionReady;
+    SmallVector<Storage, 16> EvaluatedTargets;
+    SmallVector<Value, 16> EvaluatedMayTargets;
+    SmallVector<ByteFacts, 16> EvaluatedByteTargets;
+    Value EvaluatedClosedTargets;
+    Value EvaluatedNonNullTargets;
+    Value EvaluatedUnownedOwners;
+    Value EvaluatedReady;
+    // An active pin is an owning snapshot. Same additionally proves that the
+    // source variable has not been reassigned since that snapshot was taken.
+    Value ActivePins, SamePins;
+    SmallVector<Storage, 8> PinLocations;
+    SmallVector<Value, 8> EquivalentPins;
+    bool Reachable = false;
+  };
+  Sema &Actions;
+  ASTContext &Context;
+  Decl *Callable;
+  Stmt *Body;
+  llvm::DenseMap<Storage, unsigned, StorageInfo> Slots;
+  struct PathNode {
+    unsigned Parent = 0;
+    const ValueDecl *Field = nullptr;
+    int64_t Index = -1;
+    const CXXRecordDecl *BaseRecord = nullptr;
+    bool VirtualBase = false;
+  };
+  mutable std::vector<PathNode> Paths{{}};
+  mutable llvm::DenseMap<std::pair<unsigned, const ValueDecl *>, unsigned> FieldPaths;
+  mutable llvm::DenseMap<std::pair<unsigned, int64_t>, unsigned> ArrayPaths;
+  mutable llvm::DenseMap<std::pair<unsigned, const CXXRecordDecl *>, unsigned> BasePaths, VirtualBasePaths;
+  llvm::DenseMap<Storage, bool, StorageInfo> OpaqueBorrowedStorage;
+  struct CallableCapturePath {
+    const VarDecl *Variable = nullptr;
+    SmallVector<PathNode, 4> Components;
+  };
+  struct OwnerSummary {
+    SmallVector<const VarDecl *, 4> Borrowed, Consumed, Invoked, Mutated;
+    SmallVector<CallableCapturePath, 4> InvokedPaths, BorrowedPaths, ConsumedPaths;
+  };
+  struct FutureStorageOwner {
+    CallableCapturePath Path;
+    const Expr *Initializer = nullptr;
+  };
+  llvm::DenseMap<unsigned, Storage> OriginOwnerStorage;
+  llvm::DenseMap<unsigned, const Expr *> OriginOwnerSelectors;
+  llvm::DenseSet<unsigned> UnprovenOwnerSelectors, RejectedOwnerSelectors;
+  llvm::DenseMap<unsigned, FutureStorageOwner> FutureStorageOwners;
+  mutable llvm::DenseSet<unsigned> AcquiredStorageOwners, ConsumedStorageOwners;
+  llvm::DenseMap<unsigned, CallableCapturePath> SymbolicCallablePaths;
+  mutable SmallVector<unsigned, 4> InvokedCallableTokens;
+  mutable llvm::SmallPtrSet<const Expr *, 8> UnqualifiedCallablePaths;
+  struct FamilyCallInfo {
+    const Attr *Common = nullptr;
+    bool MayRetain = false, MayRelease = false, MayAutorelease = false;
+  };
+  mutable llvm::DenseMap<const CallExpr *, FamilyCallInfo> FamilyCalls;
+  const Expr *SuppressedRetainClaim = nullptr;
+  using OwnerSummaryCache = llvm::DenseMap<const Expr *, OwnerSummary>;
+  std::shared_ptr<OwnerSummaryCache> OwnerSummaries = std::make_shared<OwnerSummaryCache>();
+  llvm::DenseMap<const Expr *, SmallVector<const VarDecl *, 4>> FutureBorrowCaptures;
+  llvm::SmallPtrSet<const Expr *, 8> UnstableFutureOwners;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> AcquiredOwnerRoots;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> ConsumedOwnerRoots;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> InvokedCallableCaptures;
+  llvm::SmallPtrSet<const VarDecl *, 16> SummaryCaptures;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> MutatedCaptures;
+  bool IsOwnerSummary = false;
+  llvm::DenseMap<const Expr *, unsigned> ClosureSlots;
+  mutable llvm::DenseMap<const LambdaExpr *, bool> ReadOnlyReferenceLambdas;
+  mutable llvm::SmallPtrSet<const VarDecl *, 8> ExpiringOwners;
+  llvm::SmallPtrSet<const LambdaExpr *, 8> ImmediateLambdaCalls;
+  llvm::SmallPtrSet<const LambdaExpr *, 8> LocalReferenceLambdas;
+  llvm::DenseMap<const Expr *, unsigned> ExpressionSlots;
+  llvm::DenseMap<const Expr *, SmallVector<const Expr *, 2>> OwnerEvaluations;
+  llvm::DenseMap<const Expr *, const Expr *> InferredOwnerAcquisitions;
+  llvm::SmallPtrSet<const Expr *, 8> UnknownReceiverResults, NullReceiverResults;
+  const VarDecl *ReturnReceiverOwner = nullptr;
+  llvm::SmallPtrSet<const Expr *, 8> RejectedEmbeddedAcquisitions;
+  llvm::SmallPtrSet<const Expr *, 16> EmbeddedAddressUses;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedReferenceCaptures;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedLambdaStorage;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedUnownedOwners;
+  llvm::DenseMap<std::pair<const Expr *, unsigned>, unsigned> ClosureLoans;
+  llvm::DenseMap<const VarDecl *, unsigned> OwnerRoots{{nullptr, 0}};
+  llvm::DenseMap<Storage, unsigned, StorageInfo> StorageOwnerRoots;
+  unsigned OwnerCount = 1;
+  llvm::DenseMap<const Stmt *, unsigned> NativePoolSources;
+  llvm::DenseMap<const VarDecl *, unsigned> NativePoolGuards;
+  SmallVector<unsigned, 8> NativePoolDepths;
+  unsigned ownerIndex(const Origin &O) const {
+    return O.StorageIdentity != ~0U ? O.StorageIdentity : OwnerRoots.lookup(O.Identity);
