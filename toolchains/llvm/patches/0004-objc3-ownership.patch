+      if (Type->isReferenceType()) {
+        Binding = referenceInitializer(Destination, Initializer, State);
+        Targets.reset();Target = {};Complete = false;
+        if (!llvm::is_contained(Binding.Targets, Destination)) {V = empty();}
+      }
+      const bool LocalAddress = (Complete && Targets.any()) || (Bytes.Complete && !Bytes.Positions.empty());
+      if (LocalAddress && !hasUnknownIndex(Destination) &&
+          !isObjC3BorrowedType(Context, Type))
+        V = empty();
+      Value Effects = effects(Initializer, State);
+      if (LocalAddress && !isObjC3BorrowedType(Context, Type)) Effects = empty();
+      Value Owner = Type->isReferenceType() ? ownerIdentity(Initializer, State)
+                                            : evaluatedOwnerIdentity(Initializer, State);
+      const bool Unowned = Type->isReferenceType() ? ownerIsUnowned(Initializer, State)
+                                                  : evaluatedOwnerIsUnowned(Initializer, State);
+      if (auto Found = Slots.find(Destination); Found != Slots.end()) {
+        State.OwnerIdentities[Found->second] = Owner;
+        State.UnownedOwners[Found->second] = Unowned;
+      }
+      store(Operation, Destination, V, State, Emit, false, &Effects);
+      setTargetFacts(Destination, Target, Targets, Complete, State, true, Type->isReferenceType() || nonNullAddress(Initializer, State));
