+//===--- SemaObjC3Resources.h - Native scalar resource ownership ---*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_SEMA_SEMAOBJC3RESOURCES_H
+#define LLVM_CLANG_LIB_SEMA_SEMAOBJC3RESOURCES_H
+namespace clang {
+class Decl;
+class ParsedAttr;
+class Sema;
+class Stmt;
+class VarDecl;
+class Expr;
+class ObjCCleanupAttr;
+class ObjCResourceAttr;
+void handleObjC3RetainableFamilyAttr(Sema &S, Decl *D, const ParsedAttr &Attribute);
+void handleObjC3ResourceTypeAttr(Sema &S, Decl *D, const ParsedAttr &Attribute);
+void handleObjC3CleanupAttr(Sema &S, Decl *D, const ParsedAttr &Attribute);
+void rebuildObjC3CleanupAttr(Sema &, VarDecl *, Expr *, const ObjCCleanupAttr &);
+void handleObjC3ResourceAttr(Sema &S, Decl *D, const ParsedAttr &Attribute);
+void rebuildObjC3ResourceAttr(Sema &, VarDecl *, Expr *, Expr *, const ObjCResourceAttr &);
+bool checkObjC3ResourceDeclarations(Sema &S, const Stmt *Body);
