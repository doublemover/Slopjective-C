+  void holdClosureOwners(const Expr *Closure, Value &V, const Facts &State) const {
+    const auto Captures = owningClosureCaptures(Closure);
+    if (IsOwnerSummary)
+      for (const auto &Capture : Captures) {
+        Value Identity = Capture.Initializer ? evaluatedOwnerIdentity(Capture.Initializer, State)
+            : State.OwnerIdentities[Slots.lookup({Capture.Variable, nullptr})];
+        for (const auto &[Root, Index] : OwnerRoots)
+          if (Root && Identity.test(Index)) AcquiredOwnerRoots.insert(Root);
+      }
+    for (int Bit = V.find_first(); Bit >= 0; Bit = V.find_next(Bit)) {
+      if ((Bit & 1) || Origins[Bit / 2].HeldByClosure)
+        continue;
+      const Origin &O = Origins[Bit / 2];
+      if (!O.Owner)
+        continue;
+      for (const auto &Capture : Captures) {
+        auto Slot = Slots.find({Capture.Variable, nullptr});
+        Value Identity = Capture.Initializer ? evaluatedOwnerIdentity(Capture.Initializer, State)
+            : Slot == Slots.end() ? Value(OwnerCount)
+                                 : State.OwnerIdentities[Slot->second];
+        if (!Identity.test(ownerIndex(O)) ||
+            (Capture.Variable != O.Owner && (!O.Identity || Identity.count() != 1)))
+          continue;
+        auto Held = ClosureLoans.find({Closure, unsigned(Bit / 2)});
+        if (Held != ClosureLoans.end()) {
+          V.reset(Bit);
+          V.set(Held->second * 2);
