+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        bool Found = false;
+        for (auto [Location, Index] : Slots)
+          if (Location.first == Capture.getVariable()) {
+            Result |= storedValue(Location, Capture.getVariable()->getType(), State);
+            Found = true;
+          }
+        if (Capture.getVariable()->getType()->isReferenceType())
+          if (auto Slot = Slots.find({Capture.getVariable(), nullptr}); Slot != Slots.end())
+            if (State.References[Slot->second].AddressLoans.any()) Result |= State.References[Slot->second].AddressLoans;
+        if (!Found && isObjC3BorrowedType(Context, Capture.getVariable()->getType()))
+          Result.set(0);
