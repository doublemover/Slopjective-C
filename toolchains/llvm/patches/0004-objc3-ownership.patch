+              ? Assignment->getLHS() : Assignment->getRHS(), State);
+          ByteFacts Bytes = byteFacts(Assignment->getRHS(), State);
+          Value StoredEffects = effects(Assignment->getRHS(), State);
+          if (Assignment->isCompoundAssignmentOp()) {
+            auto Slot = Slots.find(Target);
