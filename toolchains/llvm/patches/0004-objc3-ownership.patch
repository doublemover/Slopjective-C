+        initializeAggregate(Operation, Destination, Type, Construction->getArg(0), State, Emit, Depth + 1);
+        return;
+      }
+    const auto *List = dyn_cast_or_null<InitListExpr>(Written);
+    if (List && List->getSemanticForm())
