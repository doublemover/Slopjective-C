+                     Entry.Complete, State, false, Entry.NonNull);
+      setByteFacts(Entry.Destination, Entry.Bytes, State);
+      State.References[Slots.lookup(Entry.Destination)] = Entry.Reference;
+      State.OwnerIdentities[Slots.lookup(Entry.Destination)] = Entry.Owners;
+      State.UnownedOwners[Slots.lookup(Entry.Destination)] = Entry.Unowned;
+    }
+    if (AncestorValue.any() || AncestorEffects.any() || AncestorTargets.any())
+      if (auto Root = Slots.find(Destination); Root != Slots.end()) {
+        AncestorValue |= State.Values[Root->second];
+        AncestorEffects |= State.Effects[Root->second];
+        store(Operation, Destination, AncestorValue, State, Emit, false, &AncestorEffects);
+        State.MayTargets[Root->second] |= AncestorTargets;
+        State.LocalTargets[Root->second] = {};
+        State.ClosedTargets.reset(Root->second);State.NonNullTargets.reset(Root->second);State.ByteTargets[Root->second] = {};
+      }
+  }
+  void initializeAggregate(const Stmt *Operation, Storage Destination,
+                            QualType Type, const Expr *Initializer,
+                            Facts &State, bool Emit, unsigned Depth = 0) {
+    if (!Destination.first) return;
+    if (Depth > 32) {
+      if (carriesBorrowedValue(Type)) {
+        Value Unknown = empty(); Unknown.set(0);
+        store(Operation, Destination, Unknown, State, Emit);
+      }
+      return;
+    }
+    if (!Type->isRecordType() && !Type->isArrayType()) {
+      Value V = value(Initializer, State);
+      Storage Target = Type->isReferenceType() ? storage(Initializer, &State) : referent(Initializer, &State);
+      Value Targets = possibleTargets(Initializer, State);
