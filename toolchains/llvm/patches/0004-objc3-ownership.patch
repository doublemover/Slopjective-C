+        Storage Element = constantTargetOffset(Base, Subscript->getIdx());
+        if (!Element.first && !RequireComplete) Element = {Base.first, nullptr};
+        if (!Element.first || !Slots.count(Element) || (RequireComplete && hasUnknownIndex(Element))) {
+          if (RequireComplete) return false;
+          continue;
+        }
+        if (!llvm::is_contained(Targets, Element)) Targets.push_back(Element);
+      }
+      return !Targets.empty();
+    }
+    if (const auto *Cast = dyn_cast<CastExpr>(E)) {
+      if (!Cast->isGLValue() || !localLValueAlternatives(Cast->getSubExpr(), State, Bases, RequireComplete, Depth + 1, RequireLocal))
+        return false;
+      for (Storage Base : Bases) {
+        Storage Adjusted = adjustBaseStorage(Base, Cast);
