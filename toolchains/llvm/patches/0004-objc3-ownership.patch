+    auto AddEffects = [&](const Value &Effects) {
+      for (int Bit = Effects.find_first(); Bit >= 0; Bit = Effects.find_next(Bit)) {
+        const Origin &O = Origins[Bit / 2];
+        if (O.SymbolicCallable) {
+          if (O.Identity) InvokedCallableCaptures.insert(O.Identity);
+          if (!llvm::is_contained(InvokedCallableTokens, unsigned(Bit / 2)))
+            InvokedCallableTokens.push_back(Bit / 2);
+        } else if (O.Identity && OwnerRoots.count(O.Identity)) {
+          Unbounded.set(ownerIndex(O));
+        }
+      }
+    };
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) {
+      AddEffects(effects(Call->getCallee(), State));
+      if (const auto *Member = dyn_cast<CXXMemberCallExpr>(Call))
+        AddEffects(effects(Member->getImplicitObjectArgument(), State));
+    }
+    if (!modeledRecordCopy(callee(Invocation)) &&
+        !copyingBuiltin(dyn_cast_or_null<FunctionDecl>(callee(Invocation))) &&
+        !fillingBuiltin(dyn_cast_or_null<FunctionDecl>(callee(Invocation))))
+      for (unsigned I = 0; I != Count; ++I)
+        if (safeParameter(Invocation, I)) AddEffects(effects(argument(Invocation, I), State));
+    for (int I = Identity.find_first(); I >= 0; I = Identity.find_next(I)) {
+      const unsigned Spent = ConsumedClaims.lookup(I);
+      if (State.ExtraOwnerClaims[I] >= Spent) {
+        State.ExtraOwnerClaims[I] -= Spent;
+        Identity.reset(I);
+      } else State.ExtraOwnerClaims[I] = 0;
+    }
+    // A captured callable's consumption summary does not bound release count.
+    // It must retire the owner's proof even if explicit extra retains exist.
+    Identity |= Unbounded;
+    for (int I = Unbounded.find_first(); I >= 0; I = Unbounded.find_next(I))
+      State.ExtraOwnerClaims[I] = 0;
+    return retireOwnerIdentities(Identity, State);
+  }
+  bool retireOwnerIdentities(const Value &Identity, Facts &State) const {
+    if (IsOwnerSummary) {
+      for (const auto &[Root, Index] : OwnerRoots)
+        if (Root && Identity.test(Index)) ConsumedOwnerRoots.insert(Root);
+      for (const auto &[Location, Index] : StorageOwnerRoots) {
+        (void)Location;
+        if (Identity.test(Index)) ConsumedStorageOwners.insert(Index);
+      }
+    }
+    if (Identity.none()) return false;
+    SmallVector<std::pair<const VarDecl *, Value>, 8> Aliases;
+    for (const auto &[Location, Index] : Slots) {
+      if (path(Location) || !Location.first || Pins.count(Location.first)) continue;
+      Value Current = referenceOwnerIdentity(Location.first, State);
+      if (Current.anyCommon(Identity)) Aliases.emplace_back(Location.first, std::move(Current));
+    }
+    const Value SamePins = State.SamePins;
+    for (const auto &[Owner, PreviousIdentity] : Aliases) {
+      expire(Owner, State);
+      const unsigned Slot = Slots.lookup({Owner, nullptr});
+      // release consumes the ownership claim without changing pointer bits.
+      // Retain identity for aliases and preexisting independent lifetime pins.
+      State.OwnerIdentities[Slot] = PreviousIdentity;
+      State.UnownedOwners.set(Slot);
+    }
+    for (const auto &[Location, Index] : Slots)
+      if (path(Location) && State.OwnerIdentities[Index].anyCommon(Identity)) {
+        expireReferenceLocation(Location, State);
+        State.UnownedOwners.set(Index);
+      }
+    State.SamePins = SamePins;
+    return !Aliases.empty();
+  }
+  void overwriteWholeUnionPointer(const Stmt *Operation, Storage Destination,
+                                  Facts &State) const {
+    const auto *Assignment=dyn_cast_or_null<BinaryOperator>(Operation);
+    QualType Type=storageType(Destination);
+    if(!Assignment || Assignment->getOpcode()!=BO_Assign || !localObject(Destination) ||
+        hasUnknownIndex(Destination) || Type.isNull() || !Type->isPointerType() ||
+        Type.isVolatileQualified() || Destination.first->getType().isVolatileQualified() ||
+        Type->isDependentType() || Type->isIncompleteType())return;
+    const auto Begin=storageByteOffset(Destination);
+    if(!Begin)return;
+    const auto Size=Context.getTypeSizeInChars(Type);
+    Storage Parent=parentStorage(Destination);
+    for(unsigned Depth=0;Depth!=32;++Depth) {
+      QualType ParentType=storageType(Parent);
+      const auto *Record=ParentType.isNull()?nullptr:ParentType->getAsRecordDecl();
+      if(Record && Record->isUnion() && Record->getDefinition() &&
+          !ParentType.isVolatileQualified() && ParentType.isDestructedType()==QualType::DK_none &&
+          ParentType.isTriviallyCopyableType(Context) &&
+          storageByteOffset(Parent)==Begin && Context.getTypeSizeInChars(ParentType)==Size) {
+        bool Plain=true;
+        for(const auto &[Other,Index]:Slots)if(within(Other,Parent)) {
+          QualType OtherType=storageType(Other);
+          if(State.OwnerIdentities[Index].any() || OtherType.isVolatileQualified() ||
+              (!OtherType.isNull() && OtherType->isAtomicType())) {
+            Plain=false;break;
+          }
+        }
+        if(Plain)for(const auto &[Other,Index]:Slots)
+          if(within(Other,Parent) && !StorageInfo::isEqual(Other,Destination)) {
+            State.Values[Index].reset();State.Effects[Index].reset();
+          }
+      }
+      if(!path(Parent))break;
+      Parent=parentStorage(Parent);
+    }
+  }
+  void store(const Stmt *Operation, Storage Destination, const Value &V,
+             Facts &State, bool Emit, bool Replace = false,
+             const Value *Effects = nullptr) {
+    if (IsOwnerSummary && SummaryCaptures.count(Destination.first))
+      MutatedCaptures.insert(Destination.first);
+    if (V.any() && Emit) {
+      if (InheritedLambdaStorage.count(Destination.first))
+        diagnose(Operation, "persistent storage in a C++ lambda capture");
+      bool ReferenceCaptured = InheritedReferenceCaptures.count(Destination.first);
+      // A capture on any incoming path can already have escaped. Snapshot
+      // readiness is a must fact; reference hazards deliberately use may facts.
+      for (const Value &Targets : State.CapturedReferenceTargets)
+        for (int Target = Targets.find_first(); Target >= 0;
+             Target = Targets.find_next(Target))
+          ReferenceCaptured |= location(Target).first == Destination.first;
+      if (ReferenceCaptured)
+        diagnose(Operation, "mutation of storage captured by reference by a C++ lambda");
