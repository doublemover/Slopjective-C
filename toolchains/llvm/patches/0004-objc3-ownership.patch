+      bool ReferenceBinding = false;
+      if (!DestinationType.isNull() && DestinationType->isReferenceType())
+        if (const auto *Declaration = dyn_cast<DeclStmt>(Operation))
+          for (const Decl *D : Declaration->decls()) ReferenceBinding |= D == Destination.first;
