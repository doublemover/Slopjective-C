+      if (!Summary.SummaryCaptures.count(Location.first)) continue;
+      if (Summary.AcquiredStorageOwners.count(Index)) Result.BorrowedPaths.push_back(Summary.capturePath(Location));
+      if (Summary.ConsumedStorageOwners.count(Index)) Result.ConsumedPaths.push_back(Summary.capturePath(Location));
+    }
+    }
+    (*OwnerSummaries)[Closure] = Result;
+    return Result;
+  }
+  bool sameCapturePath(const CallableCapturePath &A, const CallableCapturePath &B) const {
