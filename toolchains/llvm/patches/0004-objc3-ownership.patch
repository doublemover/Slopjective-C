+              (Assignment->getLHS()->getType()->isRecordType() ||
+               Assignment->getLHS()->getType()->isArrayType()))
+            initializeAggregate(Assignment, Target, Assignment->getLHS()->getType(),
+                                Assignment->getRHS(), State, Emit);
+  }
+  ByteFacts lvalueByteFacts(const Expr *E, const Facts &State,
+                             unsigned Depth = 0) const {
+    if (!E || Depth > 32) return {};
+    E = E->IgnoreParens();
+    if (const auto *Unary = dyn_cast<UnaryOperator>(E)) {
+      if (Unary->getOpcode() == UO_Deref) return byteFacts(Unary->getSubExpr(), State);
+      if (Unary->isIncrementDecrementOp() && Unary->isPrefix() && E->isGLValue())
+        return lvalueByteFacts(Unary->getSubExpr(), State, Depth + 1);
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E);
+        Binary && Binary->isAssignmentOp() && E->isGLValue())
+      return lvalueByteFacts(Binary->getLHS(), State, Depth + 1);
+    if (const auto *Cast = dyn_cast<CastExpr>(E)) {
+      if (!Cast->isGLValue() || (Cast->getCastKind() != CK_NoOp && Cast->getCastKind() != CK_LValueBitCast)) return {};
+      return lvalueByteFacts(Cast->getSubExpr(), State, Depth + 1);
+    }
+    if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(E))
+      return offsetByteFacts(Subscript->getBase(), pointerDelta(Subscript->getIdx(), false), State);
+    if (const auto *Member = dyn_cast<MemberExpr>(E)) {
+      const auto *Field = dyn_cast<FieldDecl>(Member->getMemberDecl());
+      if (Field && Field->getType()->isReferenceType()) {
+        Storage Target = storage(Member, &State);
+        if (localObject(Target) && Slots.count(Target) && storageByteOffset(Target))
+          return {{{Target, 0}}, true};
+        return {};
+      }
+      if (!Field || Field->isBitField() ||
+          !Field->getParent()->getDefinition() || Field->getParent()->isDependentContext()) return {};
+      uint64_t Bits = Context.getASTRecordLayout(Field->getParent()->getDefinition()).getFieldOffset(Field->getFieldIndex());
+      if (Bits % Context.getCharWidth() || Bits / Context.getCharWidth() > INT64_MAX) return {};
+      ByteFacts Bases = Member->isArrow() ? byteFacts(Member->getBase(), State)
+          : lvalueByteFacts(Member->getBase(), State, Depth + 1);
+      for (auto &Position : Bases.Positions)
+        if (llvm::AddOverflow(Position.Offset, int64_t(Bits / Context.getCharWidth()), Position.Offset)) return {};
+      return Bases;
+    }
+    Storage Target = storage(E, &State);
+    if (localObject(Target) && Slots.count(Target) && storageByteOffset(Target))
+      return {{{Target, 0}}, true};
+    return {};
+  }
+  bool typedByteLValueTargets(const Expr *E, const Facts &State,
+                               SmallVectorImpl<Storage> &Targets) const {
+    QualType Type = E->getType();
+    if (Type->isDependentType() || Type->isIncompleteType() || Type->isVariablyModifiedType() ||
+        Type->isFunctionType()) return false;
+    ByteFacts Bytes = lvalueByteFacts(E, State);
+    if (!Bytes.Complete) return false;
+    auto Exact = exactByteTargets(Bytes.Positions, Context.getTypeSizeInChars(Type).getQuantity(), Type);
+    if (!Exact.second) return false;
+    for (int I = Exact.first.find_first(); I >= 0; I = Exact.first.find_next(I))
+      Targets.push_back(location(I));
+    return !Targets.empty();
+  }
+  bool typedWriteTarget(Storage Target, QualType WrittenType) const {
+    QualType Type = storageType(Target);
+    return Target.first && Slots.count(Target) && !Type.isNull() &&
+           Context.hasSameUnqualifiedType(Type.getNonReferenceType(), WrittenType);
+  }
+  void weakRepresentationWrite(const Expr *Operation, const Expr *LValue,
+                                const Expr *Payload, Facts &State, bool Emit) {
+    Value V = value(Payload, State), Effects = effects(Payload, State);
+    if (V.any() && Emit)
+      diagnose(Operation, "heap, ivar, property, or indirect storage through a partial representation write");
+    SmallVector<Storage, 4> Alternatives;
+    localLValueAlternatives(LValue, State, Alternatives, false);
+    // Subscript/reinterpret strides can leave the modeled typed object. Every
+    // possible base root must lose its proof, even without an exact byte slot.
+    const Expr *Written = LValue->IgnoreParenCasts();
+    const Expr *Pointer = nullptr;
+    if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(Written)) Pointer = Subscript->getBase();
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Written); Unary && Unary->getOpcode() == UO_Deref)
+      Pointer = Unary->getSubExpr();
+    if (Pointer) {
+      Value Bases = possibleTargets(Pointer, State);
+      for (int I = Bases.find_first(); I >= 0; I = Bases.find_next(I))
+        Alternatives.push_back(location(I));
+    }
+    Value Aliases = possibleTargets(Payload, State);
+    llvm::SmallPtrSet<const VarDecl *, 8> Seen;
+    for (Storage Target : Alternatives) {
+      if (!Target.first || !Seen.insert(Target.first).second) continue;
+      Storage Root{Target.first, nullptr};
+      invalidateTargetProofs(Root, State);
+      invalidateMemoryOwner(Root, State);
+      for (auto [Location, Index] : Slots) {
+        if (Location.first != Root.first) continue;
+        Value Contents = State.Values[Index];Contents |= V;
+        Value StoredEffects = State.Effects[Index];StoredEffects |= Effects;
+        store(Operation, Location, Contents, State, false, false, &StoredEffects);
+        State.MayTargets[Index] |= Aliases;
+      }
+    }
+  }
+  void incrementLocal(const UnaryOperator *Unary, Storage Target,
+                        Facts &State, bool Emit) {
+    const Expr *Operand = Unary->getSubExpr();
+    if (!Unary->getType()->isPointerType()) {
+      // A complete typed scalar update retains its integer provenance; a byte
+      // access to another representation goes through the weak path instead.
+      Value V = value(Operand, State), Effects = effects(Operand, State);
+      invalidateTargetProofs(Target, State);
+      invalidateMemoryOwner(Target, State);
+      store(Unary, Target, V, State, Emit, false, &Effects);
+      return;
+    }
+    const unsigned Slot = Slots.lookup(Target);
+    auto Step = offsetTargetValues(Operand->getType(), State.MayTargets[Slot], State.ClosedTargets.test(Slot), Unary->isIncrementOp() ? 1 : -1);
+    Value V = storedValue(Target, Operand->getType(), State);
+    Value Effects = contents(Target, storageType(Target), State, true);
+    Effects |= exposedEffects(State.MayTargets[Slot], State);
+    ByteFacts Bytes = offsetByteValues(Operand->getType(), Unary->isIncrementOp() ? 1 : -1, State.ByteTargets[Slot]);
+    const bool LocalAddress = (Step.second && Step.first.any()) || (Bytes.Complete && !Bytes.Positions.empty());
+    if (LocalAddress && localObject(Target) && !isObjC3BorrowedType(Context, Operand->getType())) {
+      V = empty();Effects = empty();
+    }
+    Storage Address = Step.second && Step.first.count() == 1 ? location(Step.first.find_first()) : Storage{};
+    const bool NonNull = State.NonNullTargets.test(Slot);
+    invalidateMemoryOwner(Target, State);
+    if (auto Slot = Slots.find(Target); Slot != Slots.end()) {
+      State.OwnerIdentities[Slot->second].reset();
+      State.UnownedOwners.set(Slot->second);
+    }
+    setTargetFacts(Target, Address, Step.first, Step.second, State, true, NonNull);
+    setByteFacts(Target, Bytes, State);
+    store(Unary, Target, V, State, Emit, false, &Effects);
+  }
+  template <typename Apply>
+  void mutateLocal(const Expr *Operation, const Expr *LValue, const Expr *Payload,
+                     Facts &State, bool Emit, Apply ApplyWrite) {
+    SmallVector<Storage, 4> Alternatives;
+    const Storage Known = storage(LValue, &State);
+    bool Complete = Known.first ? typedWriteTarget(Known, LValue->getType())
+        : localLValueAlternatives(LValue, State, Alternatives);
+    if (Known.first && Complete) Alternatives.push_back(Known);
+    for (Storage Target : Alternatives)
+      Complete &= typedWriteTarget(Target, LValue->getType());
+    if (!Complete || Alternatives.empty()) {
+      Alternatives.clear();
+      Complete = typedByteLValueTargets(LValue, State, Alternatives);
+    }
+    if (!Complete || Alternatives.empty()) {
+      weakRepresentationWrite(Operation, LValue, Payload, State, Emit);
+      return;
+    }
+    Facts Joined;bool First = true;
+    for (Storage Target : Alternatives) {
+      Facts Branch = State;ApplyWrite(Target, Branch);
+      if (First) {Joined = std::move(Branch);First = false;}
+      else join(Joined, Branch);
+    }
+    State = std::move(Joined);
+  }
+  void checkCall(const Expr *Invocation, Facts &State, bool Emit) {
+    if (addressBuiltin(callee(Invocation)) || compilerRuntimeHelper(callee(Invocation))) return;
+    unsigned Count = 0;
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation))
+      Count = Call->getNumArgs();
