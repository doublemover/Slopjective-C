+    return false;
+  }
+  bool storageOwnerFacts(Storage Source, const Facts &State, Value &Identities,
+                           bool &Unowned, unsigned Depth = 0) const {
+    if (Depth > 32 || !Source.first || hasUnknownIndex(Source)) return false;
+    auto Slot = Slots.find(Source);
+    if (Slot == Slots.end()) return false;
+    const auto &Binding = State.References[Slot->second];
+    if (Binding.Initialized) {
+      if (!Binding.Complete || Binding.Targets.empty()) return false;
+      for (Storage Target : Binding.Targets)
+        if (Target == Source || !storageOwnerFacts(Target, State, Identities, Unowned, Depth + 1)) return false;
+      return true;
+    }
+    Identities |= State.OwnerIdentities[Slot->second];
+    Unowned |= State.UnownedOwners.test(Slot->second);
+    return true;
+  }
+  Value referenceOwnerIdentity(const VarDecl *Variable, const Facts &State) const {
+    Value Result(OwnerCount);
+    auto Slot = Slots.find({Variable, nullptr});
+    if (Slot == Slots.end()) return Result;
+    const auto &Binding = State.References[Slot->second];
+    if (!Binding.Initialized) return State.OwnerIdentities[Slot->second];
+    for (Storage Target : Binding.Targets)
+      if (auto Found = Slots.find(Target); Found != Slots.end()) Result |= State.OwnerIdentities[Found->second];
