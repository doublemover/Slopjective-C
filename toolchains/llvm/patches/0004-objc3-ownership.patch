+          if (RequireComplete) return false;
+          continue;
+        }
+        if (!llvm::is_contained(Targets, Adjusted)) Targets.push_back(Adjusted);
+      }
+      return !Targets.empty();
+    }
+    return false;
+  }
+  void assignLocal(const BinaryOperator *Assignment, Storage Target, Facts &State, bool Emit) {
+          Value V = value(Assignment->getRHS(), State);
+          if (isObjC3BorrowedType(Context, Assignment->getLHS()->getType()) &&
+              V.none() && !Assignment->getRHS()->isNullPointerConstant(
