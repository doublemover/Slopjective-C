index 000000000..8890be020
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Borrowed.cpp
@@ -0,0 +1,7309 @@
+//===--- SemaObjC3Borrowed.cpp - Borrowed pointer semantic checking --------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "SemaObjC3Borrowed.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/RecordLayout.h"
+#include "llvm/Support/MathExtras.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/AST/ObjC3Borrowed.h"
+#include "clang/AST/ObjC3Isolation.h"
+#include "clang/AST/ObjC3KeyPath.h"
+#include "clang/AST/ObjC3ResourceTypes.h"
