+    for (unsigned I = 0; I != A.Components.size(); ++I) {
+      const auto &L = A.Components[I];const auto &R = B.Components[I];
+      if (L.Field != R.Field || L.Index != R.Index || L.BaseRecord != R.BaseRecord || L.VirtualBase != R.VirtualBase) return false;
+    }
+    return true;
+  }
+  bool futureStorageOwnerFacts(const FutureStorageOwner &Owner, const Facts &State,
+                                 Value &Identities, bool &Unowned) const {
+    return Owner.Initializer ? readCallableInitializer(Owner.Initializer, Owner.Path.Components, State, Identities, true, &Unowned)
