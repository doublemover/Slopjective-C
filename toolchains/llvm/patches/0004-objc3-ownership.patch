+          // paths. A wildcard may alias any later index; dropping these leaves
+          // loses callbacks captured by a larger array.
+          for (unsigned I = 0; I != List->getNumInits(); ++I) {
+            bool Tracked = llvm::any_of(Elements, [I](Storage Other) {
+              return Other.Index >= 0 && uint64_t(Other.Index) == I;
+            });
+            if (!Tracked)
+              initializeAggregate(Operation, Element, Array->getElementType(),
+                                  List->getInit(I), State, Emit, Depth + 1);
+          }
+          // The summary is a set of possible addresses, never the final
+          // initializer's single referent.
+          for (const auto &[Location, Index] : Slots) {
+            if (Location.first != Element.first) continue;
+            unsigned Current = path(Location), Prefix = path(Element);
+            while (Current && Current != Prefix) Current = Paths[Current].Parent;
+            if (Current == Prefix) {
+              State.LocalTargets[Index] = {}; State.ClosedTargets.reset(Index);State.NonNullTargets.reset(Index);State.ByteTargets[Index] = {};
+            }
+          }
+          continue;
+        }
+        const Expr *ElementInit = List && Element.Index >= 0 &&
+                                         static_cast<uint64_t>(Element.Index) < List->getNumInits()
+                                      ? List->getInit(Element.Index) : nullptr;
+        initializeAggregate(Operation, Element, Array->getElementType(),
+                            ElementInit, State, Emit, Depth + 1);
+      }
+    }
+    // Exact aggregate initialization derives contents from individual paths.
+    // Opaque payload copies retain a conservative aggregate summary instead.
+    Value Summary = !List && Written ? value(Written, State) : empty();
+    if (const auto *Record = Type->getAs<RecordType>())
+      if (Record->getDecl()->isUnion())
+        Summary |= contents(Destination, Type, State);
+    Value EffectSummary = !List && Written ? effects(Written, State) : empty();
+    if (const auto *Record = Type->getAs<RecordType>())
+      if (Record->getDecl()->isUnion()) EffectSummary |= contents(Destination, Type, State, true);
+    store(Operation, Destination, Summary, State, Emit, false, &EffectSummary);
+  }
+  void initializeRecord(const Stmt *Operation, const VarDecl *Destination,
+                        const Expr *Initializer, Facts &State, bool Emit) {
+    if (Destination->getType()->isRecordType() && Initializer)
+      initializeAggregate(Operation, {Destination, nullptr}, Destination->getType(),
+                          Initializer, State, Emit);
+  }
+  void initializeArray(const Stmt *Operation, const VarDecl *Destination,
+                       const Expr *Initializer, Facts &State, bool Emit) {
+    if (Destination->getType()->isArrayType() && Initializer)
+      initializeAggregate(Operation, {Destination, nullptr}, Destination->getType(),
+                          Initializer, State, Emit);
+  }
+  Storage directLocalStorage(const Expr *E) const {
+    if (!E) return {};
+    E = E->IgnoreParenCasts();
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(E))
+      if (const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl());
+          Variable && Variable->hasLocalStorage() && !Variable->getType()->isReferenceType())
+        return {Variable, nullptr};
+    if (const auto *Member = dyn_cast<MemberExpr>(E))
+      if (!Member->isArrow() && isa<FieldDecl>(Member->getMemberDecl()))
+        return fieldStorage(directLocalStorage(Member->getBase()), Member->getMemberDecl());
+    if (const auto *Element = dyn_cast<ArraySubscriptExpr>(E)) {
+      const Expr *Base = Element->getBase()->IgnoreParenCasts();
+      auto Index = Element->getIdx()->getIntegerConstantExpr(Context);
+      if (Base->getType()->isArrayType() && Index && !Index->isNegative() && Index->getActiveBits() <= 63)
+        return indexedStorage(directLocalStorage(Base), Index->getZExtValue());
+    }
+    return {};
+  }
+  Storage directFillDestination(const Expr *Pointer) const {
+    if (!Pointer) return {};
+    Pointer = Pointer->IgnoreParenCasts();
+    if (const auto *Address = dyn_cast<UnaryOperator>(Pointer))
+      if (Address->getOpcode() == UO_AddrOf) return directLocalStorage(Address->getSubExpr());
+    if (Pointer->getType()->isArrayType()) return indexedStorage(directLocalStorage(Pointer), 0);
+    return {};
+  }
+  bool fillingBuiltin(const FunctionDecl *Function) const {
+    if (!Function || !Function->getBuiltinID()) return false;
+    StringRef Name = Function->getName();Name.consume_front("__builtin_");
+    return Name == "memset" || Name == "memset_inline" ||
+           Name == "__memset_chk" || Name == "bzero";
+  }
+  const Expr *memoryPointerArgument(const Expr *Expression) const {
+    Expression = Expression->IgnoreParens();
+    // Strip only the builtin signature's conversion to (const) void*. User
+    // casts and byte-scaled arithmetic must not acquire a typed target proof.
+    if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Expression);
+        Cast && Cast->getCastKind() == CK_BitCast &&
+        Cast->getType()->isVoidPointerType() && Cast->getSubExpr()->getType()->isPointerType())
+      return Cast->getSubExpr();
+    return Expression;
+  }
+  Value memoryTargets(const Expr *Pointer, const Facts &State) const {
+    return possibleTargets(memoryPointerArgument(Pointer), State);
+  }
+  bool completeMemoryTargets(const Expr *Pointer, const Facts &State) const {
+    return closedTargets(memoryPointerArgument(Pointer), State);
+  }
+  std::optional<int64_t> storageByteOffset(Storage Location, unsigned Depth = 0) const {
+    if (!Location.first || Depth > 32 || hasUnknownIndex(Location) || Location.BaseRecord)
+      return std::nullopt;
+    if (!path(Location)) return 0;
+    Storage Parent = parentStorage(Location);
+    auto Offset = storageByteOffset(Parent, Depth + 1);
+    QualType ParentType = storageType(Parent);
+    if (!Offset || ParentType.isNull() || ParentType->isDependentType()) return std::nullopt;
+    int64_t Delta = 0;
+    if (Location.second) {
+      const auto *Field = dyn_cast<FieldDecl>(Location.second);
+      const auto *Record = ParentType->getAsRecordDecl();
+      if (!Field || Field->isBitField() || !Record ||
+          !Record->getDefinition() ||
+          Field->getParent()->getCanonicalDecl() != Record->getCanonicalDecl())
+        return std::nullopt;
+      uint64_t Bits = Context.getASTRecordLayout(Record->getDefinition()).getFieldOffset(Field->getFieldIndex());
+      if (Bits % Context.getCharWidth() || Bits / Context.getCharWidth() > INT64_MAX)
+        return std::nullopt;
+      Delta = Bits / Context.getCharWidth();
+    } else if (Location.Index >= 0) {
+      const auto *Array = Context.getAsConstantArrayType(ParentType);
+      if (!Array || Array->getSize().getLimitedValue() <= uint64_t(Location.Index))
+        return std::nullopt;
+      QualType Element = Array->getElementType();
+      if (Element->isDependentType() || Element->isIncompleteType() || Element->isVariablyModifiedType()) return std::nullopt;
+      int64_t Size = Context.getTypeSizeInChars(Element).getQuantity();
+      if (llvm::MulOverflow(Location.Index, Size, Delta)) return std::nullopt;
+    } else return std::nullopt;
+    int64_t Result;
+    if (llvm::AddOverflow(*Offset, Delta, Result)) return std::nullopt;
+    return Result;
+  }
+  ByteFacts byteFacts(const Expr *E, const Facts &State) const {
+    ByteFacts Result;
+    Result.Complete = memoryBytePositions(E, State, Result.Positions);
+    if (!Result.Complete) Result.Positions.clear();
+    return Result;
+  }
+  bool joinByteFacts(ByteFacts &Destination, const ByteFacts &Source) const {
+    ByteFacts Joined = Destination;
+    Joined.Complete &= Source.Complete;
+    if (Joined.Complete) {
+      for (const auto &Position : Source.Positions)
+        if (!llvm::is_contained(Joined.Positions, Position)) {
+          if (Joined.Positions.size() == 64) {Joined = {};break;}
+          Joined.Positions.push_back(Position);
+        }
+    } else Joined.Positions.clear();
+    if (Joined == Destination) return false;
+    Destination = std::move(Joined);
+    return true;
+  }
+  Value byteMayTargets(const ByteFacts &Bytes) const {
+    Value Targets(Slots.size());
+    if (Bytes.Complete)
+      for (const auto &Position : Bytes.Positions)
+        if (auto Found = Slots.find({Position.Base.first, nullptr}); Found != Slots.end())
+          Targets.set(Found->second);
+    return Targets;
+  }
+  void setByteFacts(Storage Destination, const ByteFacts &Bytes, Facts &State) const {
+    if (auto Found = Slots.find(Destination); Found != Slots.end()) {
+      unsigned I = Found->second;
+      State.ByteTargets[I] = hasUnknownIndex(Destination) ? ByteFacts{} : Bytes;
+      if (State.ByteTargets[I].Complete && !Bytes.Positions.empty() && !State.ClosedTargets.test(I))
+        State.MayTargets[I] |= byteMayTargets(Bytes);
+    }
+  }
+  ByteFacts offsetByteFacts(const Expr *Base, std::optional<int64_t> Count,
+                             const Facts &State, unsigned Depth = 0) const {
+    if (!Base || !Count || Depth > 32 || !Base->getType()->isPointerType()) return {};
+    QualType Element = Base->getType()->getPointeeType();
+    if (Element->isVoidType() || Element->isFunctionType() || Element->isDependentType() ||
+        Element->isIncompleteType() || Element->isVariablyModifiedType()) return {};
+    int64_t Bytes;
+    if (llvm::MulOverflow(*Count, Context.getTypeSizeInChars(Element).getQuantity(), Bytes)) return {};
+    ByteFacts Result;
+    Result.Complete = memoryBytePositions(Base, State, Result.Positions, Depth + 1);
+    if (!Result.Complete) return {};
+    for (auto &Position : Result.Positions)
+      if (llvm::AddOverflow(Position.Offset, Bytes, Position.Offset)) return {};
+    return Result;
+  }
+  ByteFacts offsetByteValues(QualType Pointer, std::optional<int64_t> Count, ByteFacts Result) const {
+    if (!Count || !Result.Complete || !Pointer->isPointerType()) return {};
+    QualType Element = Pointer->getPointeeType();
+    if (Element->isVoidType() || Element->isFunctionType() || Element->isDependentType() ||
+        Element->isIncompleteType() || Element->isVariablyModifiedType()) return {};
+    int64_t Bytes;
+    if (llvm::MulOverflow(*Count, Context.getTypeSizeInChars(Element).getQuantity(), Bytes)) return {};
+    for (auto &Position : Result.Positions)
+      if (llvm::AddOverflow(Position.Offset, Bytes, Position.Offset)) return {};
+    return Result;
+  }
+  bool memoryBytePositions(const Expr *Expression, const Facts &State,
+                           SmallVectorImpl<BytePosition> &Positions,
+                           unsigned Depth = 0) const {
+    if (!Expression || Depth > 32 || Positions.size() > 64 ||
+        (!Expression->getType()->isPointerType() && !Expression->getType()->isArrayType())) return false;
+    Expression = Expression->IgnoreParens();
+    auto Append = [&](const ByteFacts &Bytes) {
+      if (!Bytes.Complete) return false;
+      for (const auto &Position : Bytes.Positions)
+        if (!llvm::is_contained(Positions, Position)) {
+          if (Positions.size() == 64) return false;
+          Positions.push_back(Position);
+        }
+      return true;
+    };
+    if (auto Found = ExpressionSlots.find(Expression); Found != ExpressionSlots.end() &&
+        State.EvaluatedReady.test(Found->second))
+      return Append(State.EvaluatedByteTargets[Found->second]);
+    if (auto Found = Slots.find(storage(Expression, &State)); Found != Slots.end() &&
+        State.ByteTargets[Found->second].Complete && !Expression->HasSideEffects(Context))
+      return Append(State.ByteTargets[Found->second]);
+    if (const auto *Cast = dyn_cast<CastExpr>(Expression))
+      if ((Cast->getCastKind() == CK_NoOp || Cast->getCastKind() == CK_BitCast ||
+           Cast->getCastKind() == CK_LValueToRValue) &&
+          Cast->getType()->isPointerType() && Cast->getSubExpr()->getType()->isPointerType())
+        return memoryBytePositions(Cast->getSubExpr(), State, Positions, Depth + 1);
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Expression))
+      return memoryBytePositions(Cleanups->getSubExpr(), State, Positions, Depth + 1);
+    if (const auto *Statement = dyn_cast<StmtExpr>(Expression))
+      return memoryBytePositions(getObjC3StatementExpressionResult(*Statement), State, Positions, Depth + 1);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Expression))
+      return memoryBytePositions(Opaque->getSourceExpr(), State, Positions, Depth + 1);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Expression)) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) &&
+          Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+        return memoryBytePositions(Truth ? Conditional->getTrueExpr() :
+            Conditional->getFalseExpr(), State, Positions, Depth + 1);
+      return memoryBytePositions(Conditional->getTrueExpr(), State, Positions, Depth + 1) &&
+             memoryBytePositions(Conditional->getFalseExpr(), State, Positions, Depth + 1);
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Expression);
+        Unary && Unary->isIncrementDecrementOp())
+      return Append(Unary->isPostfix() ? byteFacts(Unary->getSubExpr(), State)
+          : offsetByteFacts(Unary->getSubExpr(), Unary->isIncrementOp() ? 1 : -1, State, Depth + 1));
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Expression)) {
+      if (Binary->getOpcode() == BO_Comma || Binary->getOpcode() == BO_Assign)
+        return memoryBytePositions(Binary->getRHS(), State, Positions, Depth + 1);
+      if (auto Offset = pointerOffset(Binary))
+        return Append(offsetByteFacts(Offset->Base, pointerDelta(Offset->Amount, Offset->Subtract), State, Depth + 1));
+    }
+    if (const auto *Call = dyn_cast<CallExpr>(Expression);
+        Call && memoryWritingBuiltin(Call->getDirectCallee()) && Call->getNumArgs())
+      return memoryBytePositions(memoryPointerArgument(Call->getArg(0)), State, Positions, Depth + 1);
+    if (Expression->isGLValue() && !storage(Expression, &State).first) {
+      SmallVector<Storage, 4> Objects;
+      if (!localLValueAlternatives(Expression, State, Objects, true, 0, false)) return false;
+      for (Storage Object : Objects) {
+        auto Found = Slots.find(Object);
+        if (Found == Slots.end() || !Append(State.ByteTargets[Found->second])) return false;
+      }
+      return !Objects.empty();
+    }
+    if (!closedTargets(Expression, State)) return false;
+    Value Targets = possibleTargets(Expression, State);
+    for (int I = Targets.find_first(); I >= 0; I = Targets.find_next(I)) {
+      Storage Target = location(I);
+      if (!localObject(Target) || !storageByteOffset(Target)) return false;
+      Positions.push_back({Target, 0});
+      if (Positions.size() > 64) return false;
+    }
+    return true;
+  }
+  std::pair<Value, bool> memoryAccessTargets(const CallExpr *Call, unsigned Argument,
+                                             const Facts &State) const {
+    const Expr *Pointer = Call->getArg(Argument);
+    Value Targets = memoryTargets(Pointer, State);
+    if (completeMemoryTargets(Pointer, State)) return {Targets, true};
+    StringRef Name = Call->getDirectCallee()->getName();Name.consume_front("__builtin_");
+    unsigned Length = Name == "bzero" ? 1 : 2;
+    if (Call->getNumArgs() <= Length) return {Targets, false};
+    auto Amount = Call->getArg(Length)->getIntegerConstantExpr(Context);
+    if (!Amount || Amount->isNegative() || Amount->getActiveBits() > 63 || Amount->isZero())
+      return {Targets, false};
+    uint64_t Bytes = Amount->getZExtValue();
+    SmallVector<BytePosition, 8> Positions;
+    if (!memoryBytePositions(memoryPointerArgument(Pointer), State, Positions)) return {Targets, false};
+    auto Exact = exactByteTargets(Positions, Bytes);
+    return Exact.second ? Exact : std::make_pair(Targets, false);
+  }
+  std::pair<Value, bool> exactByteTargets(ArrayRef<BytePosition> Positions,
+                                          uint64_t Bytes, QualType Expected = {}) const {
+    Value Targets(Slots.size());
+    if (!Bytes || Positions.empty() || Positions.size() > 64) return {Targets, false};
+    Value Exact(Slots.size());
+    for (const auto &Position : Positions) {
+      auto Base = storageByteOffset(Position.Base);
+      int64_t Offset;
+      if (!Base || llvm::AddOverflow(*Base, Position.Offset, Offset) || Offset < 0)
+        return {Targets, false};
+      QualType Root = Position.Base.first->getType();
+      if (Root->isDependentType() || Root->isIncompleteType() || Root->isVariablyModifiedType()) return {Targets, false};
+      uint64_t Size = Context.getTypeSizeInChars(Root).getQuantity();
+      if (uint64_t(Offset) > Size || Bytes > Size - uint64_t(Offset)) return {Targets, false};
+      Storage Selected;
+      for (auto [Candidate, Index] : Slots) {
+        if (Candidate.first != Position.Base.first || !memoryObjectSize(Candidate, Bytes) ||
+            (!Expected.isNull() && !Context.hasSameUnqualifiedType(storageType(Candidate), Expected))) continue;
+        auto Start = storageByteOffset(Candidate);
+        if (!Start || *Start != Offset) continue;
+        if (!Selected.first || within(Selected, Candidate)) Selected = Candidate;
+        else if (!within(Candidate, Selected)) {
+          // Equal-sized pointer arms at the same physical byte range denote
+          // one local storage cell. A representative is enough: union reads
+          // still join every overlapping loan. Other ambiguous layouts stay
+          // open rather than inventing a unique target from source path IDs.
+          QualType Left=storageType(Selected),Right=storageType(Candidate);
+          if(!overlapsUnion(Selected,Candidate) || !Left->isPointerType() ||
+              !Context.hasSameUnqualifiedType(Left,Right))return {Targets,false};
+          if(path(Candidate)<path(Selected))Selected=Candidate;
