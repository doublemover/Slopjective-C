+        break;
+      }
+    }
+    for (const auto &Owned : owningClosurePaths(Closure)) {
+      Value Identities(OwnerCount);bool Unowned = false;
+      if (!futureStorageOwnerFacts(Owned, State, Identities, Unowned) || Unowned || Identities.count() != 1) continue;
+      if (IsOwnerSummary) {
+        for (const auto &[Root, Index] : OwnerRoots)
+          if (Root && Identities.test(Index)) AcquiredOwnerRoots.insert(Root);
+        for (const auto &[Location, Index] : StorageOwnerRoots) {
+          (void)Location;
+          if (Identities.test(Index)) AcquiredStorageOwners.insert(Index);
+        }
+      }
+      for (int Bit = V.find_first(); Bit >= 0; Bit = V.find_next(Bit)) {
+        const Origin &O = Origins[Bit / 2];
+        if ((Bit & 1) || O.HeldByClosure || !Identities.test(ownerIndex(O))) continue;
+        if (auto Held = ClosureLoans.find({Closure, unsigned(Bit / 2)}); Held != ClosureLoans.end()) {
