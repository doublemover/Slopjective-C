+    }
+    Value AncestorValue = empty(), AncestorEffects = empty();
+    Value AncestorTargets(Slots.size());
+    for (auto [Location, Index] : Slots)
+      if (within(Source, Location) && !within(Location, Source)) {
+        AncestorValue |= State.Values[Index];
+        AncestorEffects |= State.Effects[Index];
+        AncestorTargets |= State.MayTargets[Index];
+      }
+    invalidateTargetProofs(Destination, State);
+    for (Copy &Entry : Copies) {
+      store(Operation, Entry.Destination, Entry.Contents, State, Emit,
+            !hasUnknownIndex(Destination), &Entry.Effects);
