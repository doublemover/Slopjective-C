+bool checkObjC3BorrowedRedeclaration(Sema &, FunctionDecl *, FunctionDecl *);
+/// Find the common callable type when a top-level permission can be dropped.
+QualType findObjC3BorrowedCompositeType(Sema &S, QualType Left, QualType Right);
+
+bool checkObjC3CallableOwnershipCast(Sema &, const Expr *, QualType, SourceLocation,
+                                    bool ExplicitCast = true, bool Diagnose = true);
+bool checkObjC3BorrowedFlow(Sema &, Decl *, Stmt *);
+bool checkObjC3BorrowedGlobalInitializer(Sema &, VarDecl *);
+} // namespace clang
