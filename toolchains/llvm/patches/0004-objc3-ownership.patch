+static bool sameLifetimeSource(const Expr *Left, const Expr *Right) {
+  Left = Left->IgnoreParenImpCasts();
+  Right = Right->IgnoreParenImpCasts();
+  if (Left == Right) return true;
+  const auto *L = dyn_cast<DeclRefExpr>(Left);
+  const auto *R = dyn_cast<DeclRefExpr>(Right);
+  return L && R && !L->getType().isVolatileQualified() &&
+         L->getDecl()->getCanonicalDecl() == R->getDecl()->getCanonicalDecl() &&
+         L->getType() == R->getType() && L->getValueKind() == R->getValueKind();
+}
