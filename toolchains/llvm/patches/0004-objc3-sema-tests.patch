+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-concurrency -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-concurrency -fexceptions -fcxx-exceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fexceptions -fcxx-exceptions -fsyntax-only %s
+
+using Strong=id __strong;
+struct Copyable {Copyable(const Copyable &);Copyable(Copyable &&);~Copyable() noexcept;};
+struct MoveOnly {MoveOnly(const MoveOnly &)=delete;MoveOnly(MoveOnly &&) noexcept;~MoveOnly() noexcept;};
+struct Neither {Neither(const Neither &)=delete;Neither(Neither &&)=delete;~Neither() noexcept;};
+struct Throwing {Throwing(const Throwing &) noexcept(false);Throwing(Throwing &&) noexcept;~Throwing() noexcept;};
+template<class T>struct Storage {__objc3_result(T,Strong) values[2][2];};
+static_assert(!__is_trivially_copyable(Storage<Copyable>));
+static_assert(!__is_trivially_constructible(Storage<Copyable>,const Storage<Copyable> &));
+static_assert(__is_constructible(Storage<Copyable>,const Storage<Copyable> &));
+static_assert(__is_constructible(Storage<Copyable>,Storage<Copyable> &&));
+static_assert(!__is_constructible(Storage<MoveOnly>,const Storage<MoveOnly> &));
+static_assert(__is_constructible(Storage<MoveOnly>,Storage<MoveOnly> &&));
+static_assert(!__is_constructible(Storage<Neither>,const Storage<Neither> &));
+static_assert(!__is_constructible(Storage<Neither>,Storage<Neither> &&));
+static_assert(!__is_nothrow_constructible(Storage<Throwing>,const Storage<Throwing> &));
+static_assert(!__is_assignable(Storage<Copyable> &,const Storage<Copyable> &));
+static_assert(!__is_assignable(Storage<Copyable> &,Storage<Copyable> &&));
+union UnionStorage {__objc3_result(Copyable,Strong) value;};
+static_assert(!__is_constructible(UnionStorage,const UnionStorage &));
+static_assert(!__is_destructible(UnionStorage));
diff --git a/clang/test/ObjC3/Sema/native-union-keypath-gates.mm b/clang/test/ObjC3/Sema/native-union-keypath-gates.mm
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/native-union-keypath-gates.mm
@@ -0,0 +1,21 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple aarch64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-union-keypaths.h"
+union ImplicitManagedUnion {NativeUnionArm owned;int plain;};
+union ThrowingManagedUnion {NativeUnionArm owned;int plain;ThrowingManagedUnion(const ThrowingManagedUnion &);~ThrowingManagedUnion() noexcept(false);};
+union BorrowedManagedUnion {borrowed const char *loan;NativeUnionArm owned;BorrowedManagedUnion(const BorrowedManagedUnion &);~BorrowedManagedUnion() noexcept;};
+@interface NativeUnionPathRoot (OwnershipCases)
+@property(nonatomic) ImplicitManagedUnion implicit;
+@property(nonatomic) ThrowingManagedUnion throwing;
+@property(nonatomic) BorrowedManagedUnion loan;
+@end
+void native_union_keypath_gates(void) {
+ (void)@keypath(NativeUnionPathRoot,implicit); // expected-error {{key-path value must be a complete nondependent native}}
+ (void)@keypath(NativeUnionPathRoot,implicit.owned.value); // expected-error {{key-path record traversal requires a complete native}}
+ static_assert(__is_same(decltype(@keypath(NativeUnionPathRoot,throwing)),
+                         WritableKeyPath<NativeUnionPathRoot *, ThrowingManagedUnion>));
+ static_assert(__is_same(decltype(@keypath(NativeUnionPathRoot,throwing.owned.value)),
+                         WritableKeyPath<NativeUnionPathRoot *, int>));
+ (void)@keypath(NativeUnionPathRoot,loan); // expected-error {{key paths cannot erase borrowed provenance}}
+ (void)@keypath(NativeUnionPathRoot,loan.owned.value); // expected-error {{key paths cannot erase borrowed provenance}}
+}
