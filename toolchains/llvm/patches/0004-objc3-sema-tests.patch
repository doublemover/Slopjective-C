@@ -0,0 +1,36 @@
+#ifndef OBJC3_MEMBER_PROJECTION_GRAPHS_H
+#define OBJC3_MEMBER_PROJECTION_GRAPHS_H
+#include "native-instance-argument-projections.h"
+#ifdef __cplusplus
+struct BindingMemberGraphs {
+ int state;
+ int scalar(int value)const{return scalar_base(value);}
+ int scalar_base(int value)const{return value;}
+ template<class T>int scalar_template(T value)const{return scalar(value);}
+ int &reference(int &value)&{return reference_base(value);}
+ int &reference_base(int &value)&{return value;}
+ BindingWork work(BindingWork value)const{return forward(value);}
+ BindingWork forward(BindingWork value)const{return value;}
+ BindingWork literal(int value)const{return literal_base(value);}
+ BindingWork literal_base(int value)const{return BINDING_FACTORY_RESULT(^void(void) __objc3_async_frame {(void)value;});}
+ template<class T>BindingWork template_factory(T value)const{return literal(value);}
+ BindingWork open(BindingWork)const;
+ BindingWork opaque(BindingWork value)const{return open(value);}
+ BindingWork cycle(BindingWork value)const{return cycle(value);}
+ BindingWork state_work(BindingWork value)const{return state?forward(value):(BindingWork)0;}
+};
+struct BindingVirtualGraphs {
+ virtual BindingWork work(BindingWork value)const{return value;}
+ virtual BindingWork literal(int value)const{return BINDING_FACTORY_RESULT(^void(void) __objc3_async_frame {(void)value;});}
+ BindingWork open_chain(BindingWork value)const{return work(value);}
+};
+struct BindingFinalMethodGraphs:BindingVirtualGraphs {
+ BindingWork work(BindingWork value)const final{return value;}
+};
+struct BindingFinalGraphs final:BindingVirtualGraphs {
+ BindingWork work(BindingWork value)const override{return BindingVirtualGraphs::work(value);}
