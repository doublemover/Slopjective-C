+#ifndef OBJC3_BORROWED_MANUAL_CLAIMS_H
+#define OBJC3_BORROWED_MANUAL_CLAIMS_H
+typedef struct ClaimObject *ClaimRef __attribute__((objc_retainable_family(ClaimFamily)));
+ClaimRef ClaimHold(ClaimRef owner) __attribute__((objc_family_retain(ClaimFamily)));
+void ClaimDrop(ClaimRef owner) __attribute__((objc_family_release(ClaimFamily)));
+void ClaimDropConsumed(ClaimRef owner __attribute__((cf_consumed))) __attribute__((objc_family_release(ClaimFamily)));
+ClaimRef ClaimAutorelease(ClaimRef owner) __attribute__((objc_family_autorelease(ClaimFamily)));
+typedef borrowed const char *ClaimBytes;
+ClaimBytes claim_bytes(ClaimRef owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void claim_use(const char *value __attribute__((noescape)));
+void claim_take(ClaimRef owner __attribute__((cf_consumed)));
+void claim_take_two(ClaimRef first __attribute__((cf_consumed)),ClaimRef second __attribute__((cf_consumed)));
+void claim_overlap(ClaimRef owner __attribute__((cf_consumed)), const char *value __attribute__((noescape)));
+void claim_invoke(void (^work)(void) __attribute__((noescape)));
+#if !__has_feature(objc_arc)
+__attribute__((objc_root_class)) @interface ManualClaimOwner
+- (id)retain;
+- (oneway void)release;
+- (id)autorelease;
+- (void)consume __attribute__((ns_consumes_self));
+@end
+ClaimBytes object_claim_bytes(ManualClaimOwner *_Nonnull owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void object_claim_take(ManualClaimOwner *_Nonnull owner __attribute__((ns_consumed)));
+#endif
+#endif
