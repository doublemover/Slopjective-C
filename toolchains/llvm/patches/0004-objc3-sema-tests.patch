+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=expected,c %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=expected,cxx %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=expected,cxx %s
+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-consumed-owners.h -o %t-c.pch
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-c.pch -DFROM_PCH -fsyntax-only -verify=expected,c %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-consumed-owners.h -o %t-cxx.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-cxx.pch -DFROM_PCH -fsyntax-only -verify=expected,cxx %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-consumed-owners.h"
+#endif
+void direct_consume(ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  consume_claim(owner,0);
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void receiver_consume(ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  [owner consume];
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void message_argument(ConsumingOwner *_Nonnull receiver,ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  [receiver takeObject:owner];
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void indirect_consume(ConsumingOwner *_Nonnull owner,ConsumedCallback callback) {
+  const char *pointer=consumed_bytes(owner);
+  callback(owner,0);
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void block_consume(ConsumingOwner *_Nonnull owner,ConsumedBlock callback) {
+  const char *pointer=consumed_bytes(owner);
+  callback(owner,0);
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void overlapping_loan(ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  consume_pair(owner,pointer); // expected-error {{borrowed argument overlapping a consumed owner claim}}
+}
+void pinned_claim(ConsumingOwner *_Nonnull owner) {
+  keepAlive(owner);
+  const char *pointer=consumed_bytes(owner);
+  consume_pair(owner,pointer);
+  [owner consume];
+  consumed_use(pointer);
+  consumed_use(consumed_bytes(owner));
+}
+#ifdef __cplusplus
+void argument_snapshot(ConsumingOwner *_Nonnull owner,ConsumingOwner *_Nonnull replacement) {
+  ConsumingOwner *_Nonnull old=owner;
+  const char *pointer=consumed_bytes(old);
+  consume_claim(owner,(owner=replacement,0)); // cxx-warning {{unsequenced modification and access}}
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+  consumed_use(consumed_bytes(owner));
+}
+#endif
+void receiver_snapshot(ConsumingOwner *_Nonnull owner,ConsumingOwner *_Nonnull replacement) {
+  ConsumingOwner *_Nonnull old=owner;
+  const char *pointer=consumed_bytes(old);
+  ConsumingOwner *_Nonnull receiver=owner;
+  [receiver consumeAfter:(owner=replacement,0)];
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+  consumed_use(consumed_bytes(owner));
+}
+void (*erased_callback)(id,int)=consume_claim; // c-error {{incompatible function pointer types}} cxx-error {{cannot initialize}}
+void lost_contract(id owner __attribute__((ns_consumed))); // expected-note {{previous declaration is here}}
+void lost_contract(id owner) {} // expected-error {{conflicting types}}
+@interface ConsumingChild : ConsumingOwner
+- (void)drop;
+- (void)dropAfter:(ConsumingOwner *_Nonnull)replacement;
+@end
+@implementation ConsumingChild
+- (void)drop {
+  const char *pointer=consumed_bytes(self);
+  [super consume];
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+- (void)dropAfter:(ConsumingOwner *_Nonnull)replacement {
+  const char *pointer=consumed_bytes(self);
+  [super consumeAfter:(self=(ConsumingChild *)replacement,0)]; // expected-error {{super receiver consumption with side-effecting arguments}}
+  (void)pointer;
+}
+@end
+#ifdef __cplusplus
+struct ClaimSink {ClaimSink(id owner __attribute__((ns_consumed)));};
+struct ClaimCall {void operator()(id owner __attribute__((ns_consumed)));};
+void constructor_consume(ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  ClaimSink sink(owner);
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void operator_consume(ConsumingOwner *_Nonnull owner) {
+  const char *pointer=consumed_bytes(owner);
+  ClaimCall{}(owner);
+  consumed_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+#endif
