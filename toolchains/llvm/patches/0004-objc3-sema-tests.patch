+++ b/clang/test/ObjC3/Sema/Inputs/if-binding-dependent-bool.h
@@ -0,0 +1,31 @@
+typedef Optional(int) MaybeInt;
+
+struct ImplicitBool {
+  operator bool() const;
+};
+
+struct ExplicitBool {
+  explicit operator bool() const;
+};
+
+template<class T, int Threshold>
+int dependent_let_condition(MaybeInt source, T condition) {
+  if let value = source, value > Threshold, condition {
+    return value;
+  }
+  return 0;
+}
+
+template<class Test>
+int dependent_var_condition(MaybeInt source, Test test) {
+  if var value = source, test(value) {
+    return ++value;
+  }
+  return 0;
+}
+
+template<class T>
+int dependent_guard_condition(MaybeInt source, T condition) {
+  guard let value = source, condition else { return 0; }
+  return value;
+}
