+  const char *other_pointer=closure_bytes(other);
+  ClosureWork work=^{closure_consume(owner);};
+  closure_writeback(&work,(work=^{closure_consume(other);},0)); // expected-error {{borrowed argument overlapping a consumed owner claim}}
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+  closure_use(other_pointer);
+}
+void arc_writeback_preserves_input_loan(void *owner,void *other) {
+  const char *pointer=closure_bytes(owner);
+  ClosureWork work=^{closure_use(pointer);};
+  closure_writeback(&work,(work=^{closure_use(closure_bytes(other));},0));
+  closure_consume(owner);
+  work(); // expected-error {{captured owner lifetime ended}}
+}
+#endif
+#if __has_feature(objc_arc)
+void message_copy_in_snapshot(ClosureSink *_Nonnull sink,void *owner,void *other) {
+  const char *pointer=closure_bytes(owner);
+  const char *other_pointer=closure_bytes(other);
+  ClosureWork work=^{closure_consume(owner);};
+  [sink writeback:&work after:(work=^{closure_consume(other);},0)]; // expected-error {{borrowed argument overlapping a consumed owner claim}}
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+  closure_use(other_pointer);
+}
+void message_out_has_no_input(ClosureSink *_Nonnull sink,void *owner) {
+  const char *pointer=closure_bytes(owner);
+  ClosureWork work=^{closure_consume(owner);};
+  [sink output:&work];
+  closure_use(pointer);
+}
+#endif
+void future_byref_callback(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  __block ClosureWork work=^{};
+  ClosureWork forward=^{work();}; // expected-error {{byref Block callable capture requiring an explicit invocation lifetime contract}}
+  work=^{closure_consume(owner);};
+  forward();
+  closure_use(pointer);
+}
+
+void typed_callback_reference(void *owner,ClosureConsumer callback) {
+  const char *pointer=closure_bytes(owner);
