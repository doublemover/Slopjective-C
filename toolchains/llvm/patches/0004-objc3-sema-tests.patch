+// RUN: %clang_cc1 -x objective-c++-header -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-owned-records.h -o %t-c++20-True.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -include-pch %t-c++20-True.pch -DFROM_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-owned-records.h -o %t-c++23-False.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-c++23-False.pch -DFROM_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-owned-records.h -o %t-c++23-True.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -include-pch %t-c++23-True.pch -DFROM_PCH -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-owned-records.h"
+#endif
+int synchronous_argument_effect();
+void immediate_scalar_arguments(void *owner,int offset) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](int index){memory_use(pointer+index);}(offset);
+  pointer=memory_bytes(owner);
+  [&pointer](int index=0){memory_use(pointer+index);}();
+  pointer=memory_bytes(owner);
+}
+void immediate_generic_scalar(void *owner,int offset) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto index){memory_use(pointer+index);}(offset);
+  pointer=memory_bytes(owner);
+  [&pointer]<class T>(T index){memory_use(pointer+index);}(0L);
+  pointer=memory_bytes(owner);
+}
+void immediate_generic_pack(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto... indices){(memory_use(pointer+indices),...);}(0,1L,2u);
+  pointer=memory_bytes(owner);
+}
+int immediate_generic_result(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  int result=[&pointer](auto amount){return int(*pointer)+amount;}(3);
+  pointer=memory_bytes(owner);
+  return result;
+}
+void immediate_generic_local_cursor(void *owner,int count) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto count){
+    const char *cursor=pointer;
+    for(int i=0;i<count;++i)memory_use(cursor++);
+  }(count);
+  pointer=memory_bytes(owner);
+}
+void immediate_effectful_argument(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto index){memory_use(pointer+index);}(synchronous_argument_effect()); // expected-error {{C++ lambda reference capture}}
+}
+void immediate_reference_argument(void *owner,int &index) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto &value){memory_use(pointer+value);}(index); // expected-error {{C++ lambda reference capture}}
+}
+void immediate_pointer_argument(void *owner,int *index) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto value){memory_use(pointer+*value);}(index); // expected-error {{C++ lambda reference capture}}
+}
+void immediate_record_argument(void *owner) {
+  struct Index {int value;};Index index{0};
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto value){memory_use(pointer+value.value);}(index); // expected-error {{C++ lambda reference capture}}
+}
+void immediate_generic_reference_rebind(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto){pointer=nullptr;}(0); // expected-error {{C++ lambda reference capture}}
+}
+void immediate_generic_result_escape(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto){return pointer;}(0); // expected-error {{C++ lambda reference capture}} expected-error {{return without a matching borrowed return}}
+}
+void immediate_generic_expired(void *owner) {
+  const char *pointer=memory_bytes(owner);owner=nullptr;
+  [&pointer](auto index){memory_use(pointer+index);}(0); // expected-error 2 {{after its owner lifetime ended}}
+}
+void immediate_argument_loan_escape(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  [&pointer](auto){memory_use(pointer);}(reinterpret_cast<unsigned long>(pointer)); // expected-error {{argument without a non-escaping lifetime contract}}
+}
+void mutable_readonly_loan_record(void *owner) {
+  MemoryHolder record{memory_bytes(owner)};
+  auto work=[record,count=0]()mutable{++count;memory_use(record.pointer);};
+  work();work();
+  memory_consume(owner);
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void mutable_readonly_owned_record(id owner) {
+  MemoryObjectRecord record{owner};
+  auto work=[record,count=0]()mutable{++count;memory_use(memory_object_bytes(record.owner));};
+  owner=nullptr;record.owner=nullptr;
+#if __has_feature(objc_arc)
+  work();work();
+#else
+  work(); // expected-error {{after its owner lifetime ended}}
+#endif
+}
+void mutable_readonly_nested_record(id owner) {
+  MemoryNestedObjectRecord record{{owner}};
+  auto work=[record,count=0]()mutable{++count;memory_use(memory_object_bytes(record.value.owner));};
+  owner=nullptr;record.value.owner=nullptr;
+#if __has_feature(objc_arc)
+  work();work();
+#else
+  work(); // expected-error {{after its owner lifetime ended}}
+#endif
+}
+void mutable_readonly_held_record(id owner) {
+  MemoryObjectRecord record{owner};const char *pointer=memory_object_bytes(owner);
+  auto work=[record,pointer,count=0]()mutable{++count;(void)record.owner;memory_use(pointer);};
+  owner=nullptr;record.owner=nullptr;
+#if __has_feature(objc_arc)
+  work();work();
+#else
+  work(); // expected-error {{after its owner lifetime ended}}
+#endif
+}
+void mutable_generic_readonly_record(id owner) {
+  MemoryObjectRecord record{owner};
+  auto work=[record](auto value)mutable{memory_use(memory_object_bytes(record.owner));return value;};
+  work(1);work(2L);
+}
+void mutable_record_retarget(id owner) {
+  MemoryObjectRecord record{owner};
+  auto work=[record]()mutable{memory_use(memory_object_bytes(record.owner));record.owner=nullptr;}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+struct OpaqueRecord {id owner;void change();void inspect()const;};
+void mutable_record_indirect_method(id owner) {
+  OpaqueRecord record{owner};
+  auto work=[record]()mutable{record.change();memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+void mutable_record_const_method(id owner) {
+  OpaqueRecord record{owner};
+  auto work=[record]()mutable{record.inspect();memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+void change_record(MemoryObjectRecord *pointer __attribute__((noescape)));
+void mutable_record_indirect_address(id owner) {
+  MemoryObjectRecord record{owner};
+  auto work=[record]()mutable{change_record(&record);memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+
+struct OpaqueOperatorRecord {id owner;void operator()();OpaqueOperatorRecord &operator++();};
+void mutable_record_opaque_call(id owner) {
+  OpaqueOperatorRecord record{owner};
+  auto work=[record]()mutable{record();memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+void mutable_record_opaque_operator(id owner) {
+  OpaqueOperatorRecord record{owner};
+  auto work=[record]()mutable{++record;memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+void mutable_record_opaque_alias(id owner) {
+  OpaqueRecord record{owner};
+  auto work=[record]()mutable{auto *alias=&record;alias->change();memory_use(memory_object_bytes(record.owner));}; // expected-error {{mutable or generic C++ lambda capture}}
+  (void)work;
+}
+void opaque_address_expires_record_owner(id owner) {
+  MemoryObjectRecord record{owner};
+  const char *pointer=memory_object_bytes(record.owner);
+  change_record(&record);
+  memory_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void opaque_receiver_expires_record_owner(id owner) {
+  OpaqueRecord record{owner};
+  const char *pointer=memory_object_bytes(record.owner);
+  record.change();
+  memory_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void opaque_alias_receiver_expires_record_owner(id owner) {
+  OpaqueRecord record{owner};auto *alias=&record;
+  const char *pointer=memory_object_bytes(record.owner);
+  alias->change();
+  memory_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
