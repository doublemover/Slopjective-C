+  return @keypath(Root, value);
+}
+template<class Root> auto dependent_literal_read(Root root) {
+  return KeyPathGet(@keypath(Root, value), root);
+}
+template<class Root> struct DependentLiteralRoot { using type = Root; };
+template<class Root> auto dependent_qualified_literal_path() {
+  return @keypath(typename DependentLiteralRoot<Root>::type, pair.first);
+}
+template<class... Paths> unsigned count_literal_paths(Paths...) {
+  return sizeof...(Paths);
+}
+template<class... Roots> unsigned dependent_literal_pack() {
+  return count_literal_paths(@keypath(Roots, value)...);
+}
+#endif
diff --git a/clang/test/ObjC3/Sema/typed-keypath-dependent-application-errors.mm b/clang/test/ObjC3/Sema/typed-keypath-dependent-application-errors.mm
new file mode 100644
index 000000000..982561ce5
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-dependent-application-errors.mm
@@ -0,0 +1,44 @@
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+#include "../Inputs/keypath-abi.h"
+__attribute__((objc_root_class))
+@interface InvalidDependentPathRoot
+@property(nonatomic) int value;
+@end
+template<class Path> void write_readonly(Path path, InvalidDependentPathRoot *root) {
+  KeyPathSet(path, root, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+}
+template<class Path> auto read_untyped(Path path, InvalidDependentPathRoot *root) {
+  return KeyPathGet(path, root); // expected-error {{key-path application requires a typed key-path value}}
+}
+template<class Path, class... Roots> auto invalid_pack(Path path, Roots... roots) {
+  return KeyPathGet(path, roots...); // expected-error 2 {{key-path application has the wrong number of operands}}
+}
+template<class... Arguments> auto invalid_all_pack(Arguments... arguments) {
+  return KeyPathGet(arguments...); // expected-error 3 {{key-path application has the wrong number of operands}}
+}
+template<class Path> auto nullable_braced_root(Path path, InvalidDependentPathRoot * _Nullable root) {
+  return KeyPathGet(path, {root}); // expected-error {{key-path application requires a nonnull root}}
+}
+void reject_invalid_instantiations(InvalidDependentPathRoot *root) {
+  auto path = @keypath(InvalidDependentPathRoot, value);
+  (void)nullable_braced_root(path, root); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_all_pack(); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_all_pack(path); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_all_pack(path, root, root); // expected-note {{in instantiation of function template specialization}}
+  write_readonly(KeyPathAsReadOnly(path), root); // expected-note {{in instantiation of function template specialization}}
+  (void)read_untyped(17, root); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_pack(path); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_pack(path, root, root); // expected-note {{in instantiation of function template specialization}}
+}
+
+template<class Root> auto invalid_literal_root() {
+  return @keypath(Root, value); // expected-error {{key-path root must name a concrete Objective-C class}}
+}
+template<class Root> auto invalid_literal_member() {
+  return @keypath(Root, missing); // expected-error {{key-path component must name a visible declared instance property}}
+}
+void reject_dependent_literals() {
+  (void)invalid_literal_root<int>(); // expected-note {{in instantiation of function template specialization}}
+  (void)invalid_literal_member<InvalidDependentPathRoot *>(); // expected-note {{in instantiation of function template specialization}}
+}
diff --git a/clang/test/ObjC3/Sema/typed-keypath-dependent-applications.mm b/clang/test/ObjC3/Sema/typed-keypath-dependent-applications.mm
new file mode 100644
index 000000000..3767c294f
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-dependent-applications.mm
@@ -0,0 +1,41 @@
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-pch -o %t.arc.pch %S/Inputs/typed-keypath-dependent-applications.h
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -include-pch %t.arc.pch -DDEPENDENT_KEYPATH_USE_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-pch -o %t.mrc.pch %S/Inputs/typed-keypath-dependent-applications.h
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -include-pch %t.mrc.pch -DDEPENDENT_KEYPATH_USE_PCH -fsyntax-only -verify %s
+// expected-no-diagnostics
+#ifndef DEPENDENT_KEYPATH_USE_PCH
+#include "Inputs/typed-keypath-dependent-applications.h"
+#endif
+using Write = WritableKeyPath<DependentPathRoot *, int>;
+using Read = KeyPath<DependentPathRoot *, int>;
+void use_dependent_applications(DependentPathRoot *root) {
+  auto path = @keypath(DependentPathRoot, value);
+  static_assert(__is_same(decltype(dependent_path_get(path, root)), int));
+  static_assert(__is_same(decltype(dependent_path_readonly(path)), Read));
+  static_assert(__is_same(decltype(dependent_path_metadata(path)),
+                         const objc3_keypath_descriptor_v2 *));
+  static_assert(__is_same(decltype(dependent_path_kvc(path)), id));
+  auto pair_path = @keypath(DependentPathRoot, pair);
+  dependent_path_braced(pair_path, root);
+  KeyPathSet(pair_path, {root}, {11, 13});
+  dependent_path_set(path, root, 17);
+  dependent_path_all_set(path, root, 29);
+  (void)dependent_path_all_get(path, root);
+  (void)dependent_path_get(path, root);
+  (void)dependent_path_pack(path, root);
+  (void)dependent_path_get(dependent_path_readonly(path), root);
+}
+
+void use_dependent_literals(DependentPathRoot *root) {
+  auto path = dependent_literal_path<DependentPathRoot *>();
+  static_assert(__is_same(decltype(path), Write));
+  static_assert(__is_same(decltype(dependent_literal_read(root)), int));
+  auto field = dependent_qualified_literal_path<DependentPathRoot *>();
+  static_assert(__is_same(decltype(field), WritableKeyPath<DependentPathRoot *, long>));
+  (void)dependent_literal_pack<DependentPathRoot *, DependentPathRoot *>();
+  KeyPathSet(path, root, 31);
+}
diff --git a/clang/test/ObjC3/Sema/native-object-conversion-contracts.cpp b/clang/test/ObjC3/Sema/native-object-conversion-contracts.cpp
new file mode 100644
index 000000000..393cac8cf
--- /dev/null
+++ b/clang/test/ObjC3/Sema/native-object-conversion-contracts.cpp
@@ -0,0 +1,38 @@
+// RUN: %clang_cc1 -std=c++23 -fsyntax-only -verify %s
+// expected-no-diagnostics
+// Preserve the separation of explicit-object user conversions and implicit
+// identity/derived object bindings, including absent-base overload lookup.
+struct BindingBase {
+  constexpr int select() & { return 1; }
+  constexpr int select() const & { return 2; }
+  constexpr int select() && { return 3; }
+  template<class T> constexpr int implicit_template(T) & { return 4; }
+};
+struct BindingDerived : BindingBase {
+  constexpr int call() & { return implicit_template(0); }
+};
+constexpr bool implicit_bindings() {
+  BindingDerived object;
+  const BindingDerived constant;
+  return object.select() == 1 && constant.select() == 2 &&
+         BindingDerived{}.select() == 3 && object.call() == 4;
+}
+static_assert(implicit_bindings());
+struct ExplicitBinding {
+  template<class Self> constexpr int value(this Self &&, int input) {
+    return input;
+  }
+};
+static_assert(ExplicitBinding{}.value(7) == 7);
+enum PromotionEnum { PromotionValue = 7 };
+static_assert(__is_convertible_to(PromotionEnum, int));
+constexpr int promoted(int value) { return value; }
+static_assert(promoted(PromotionValue) == 7);
+template<class T> concept HasByte = sizeof(T) >= 1;
+template<class T> concept HasWord = HasByte<T> && sizeof(T) >= 2;
+template<class T> struct ConstrainedMember {
+  constexpr int value() requires HasByte<T> { return 1; }
+  constexpr int value() requires HasWord<T> { return 2; }
+};
+template<> constexpr int ConstrainedMember<int>::value() { return 11; }
+static_assert(ConstrainedMember<int>{}.value() == 11);
diff --git a/clang/test/ObjC3/Sema/Inputs/typed-keypath-dependent-types.h b/clang/test/ObjC3/Sema/Inputs/typed-keypath-dependent-types.h
new file mode 100644
