diff --git a/clang/test/ObjC3/Sema/Inputs/callable-borrowed-template.h b/clang/test/ObjC3/Sema/Inputs/callable-borrowed-template.h
new file mode 100644
index 000000000..578a6fc78
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/callable-borrowed-template.h
@@ -0,0 +1,55 @@
+typedef borrowed const char *Bytes;
+typedef void (*BorrowedCallback)(Bytes);
+typedef void (*RawCallback)(const char *);
+typedef void (*BorrowedSecond)(const char *, Bytes);
+typedef void (*BorrowedFirst)(Bytes, const char *);
+typedef void (^BorrowedBlock)(Bytes);
+typedef void (^RawBlock)(const char *);
+
+void accept_borrowed(BorrowedCallback);
+void accept_block(BorrowedBlock);
+void raw_call(const char *);
+void borrowed_call(Bytes);
+
+template<class Callback> void adapt_callback(Callback callback) {
+  accept_borrowed(callback);
+}
+
+template<class Callback> void invoke_callback(Callback callback, Bytes value) {
+  callback(value);
+}
+
+template<class Callback> void adapt_block(Callback callback) {
+  accept_block(callback);
+}
+
+template<class Callback> struct ContractKind { enum { Value = 0 }; };
+template<class Arg> using BorrowedArgument = borrowed Arg *;
+template<class Arg> struct ContractKind<void (*)(BorrowedArgument<Arg>)> {
+  enum { Value = 1 };
+};
+
+typedef Bytes (*ReturningCallback)(void *, Bytes)
+    __attribute__((objc_returns_borrowed(owner_index=0)));
+typedef Bytes (^ReturningBlock)(void *, Bytes)
+    __attribute__((objc_returns_borrowed(owner_index=0)));
+
+template<class Callback>
+Bytes forward_owner(Callback callback, void *owner, Bytes value)
+    __attribute__((objc_returns_borrowed(owner_index=1))) {
+  return callback(owner, value);
+}
+
+__attribute__((ms_abi, objc_returns_borrowed(owner_index=0)))
+Bytes adjusted(void *owner, Bytes value);
+__attribute__((objc_returns_borrowed(owner_index=0)))
+Bytes adjusted(void *owner, Bytes value);
+using Adjusted = Bytes (__attribute__((ms_abi, objc_returns_borrowed(owner_index=0)))
+                         *)(void *, Bytes);
+
+void swift_borrow(Bytes __attribute__((swift_context))) __attribute__((swiftcall));
+void swift_raw(const char * __attribute__((swift_context))) __attribute__((swiftcall));
+void swift_without_context(Bytes) __attribute__((swiftcall));
+using SwiftBorrowed = decltype(&swift_borrow);
+using SwiftRaw = decltype(&swift_raw);
+using SwiftWithoutContext = decltype(&swift_without_context);
