diff --git a/clang/test/ObjC3/Sema/Inputs/public-try-prefixes.h b/clang/test/ObjC3/Sema/Inputs/public-try-prefixes.h
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/public-try-prefixes.h
@@ -0,0 +1,46 @@
+#ifndef OBJC3_PUBLIC_TRY_PREFIXES_H
+#define OBJC3_PUBLIC_TRY_PREFIXES_H
+
+#include "../../CodeGen/Inputs/native-c-async-frame.h"
+
+@protocol Error @end
+int checked_value(int value) throws(id<Error>);
+int checked_work(int value) async throws(id<Error>);
+
+static inline int public_propagate(int value) throws(id<Error>) {
+  return try checked_value(value) + 1;
+}
+static inline int public_force(int value) {
+  try! checked_value(value);
+  return try! (checked_value(value)) + 1;
+}
+static inline int public_optional(int value) {
+  __objc3_optional(int) result = try? checked_value(value);
+  return __objc3_has_value(result);
+}
+static inline int public_optional_async(int value) async {
+  __objc3_optional(int) result = try? await checked_work(value);
+  return __objc3_has_value(result);
+}
+static inline int public_propagate_async(int value) async throws(id<Error>) {
+  return try await checked_work(value) + 1;
+}
+
+#ifdef __cplusplus
+static inline int preserve_native_try(int value) {
+  try { return value; } catch (...) { return 0; }
+}
+struct PreserveFunctionTry {
+  int value;
+  explicit PreserveFunctionTry(int input) try : value(input) {} catch (...) { throw; }
+};
+#else
+static inline int preserve_named_try(int try) {
+  return try ? 1 : 2;
+}
+static inline int preserve_named_try_call(int (*try)(int)) {
+  return try(42);
+}
+#endif
+
+#endif
diff --git a/clang/test/ObjC3/Sema/typed-keypath-accessor-projections.m b/clang/test/ObjC3/Sema/typed-keypath-accessor-projections.m
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-accessor-projections.m
@@ -0,0 +1,40 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -x objective-c -std=c23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+
+#include "../Inputs/keypath-abi.h"
+@protocol Error @end
+__attribute__((objc_root_class))
+@interface SplitAccessors
+@property(nonatomic) int ordinary;
+@property(nonatomic) int checked;
+- (void)setChecked:(int)value __objc3_throws(id<Error>);
+@property(nonatomic) int affine;
+- (void)setAffine:(int)value __attribute__((objc_executor(main)));
+@property(nonatomic, strong) SplitAccessors * _Nullable consuming;
+- (void)setConsuming:(SplitAccessors * _Nullable __attribute__((ns_consumed)))value;
+@property(nonatomic, readonly) int affineRead;
+- (int)affineRead __attribute__((objc_executor(main)));
+@property(nonatomic, readonly) int consumingRead;
+- (int)consumingRead __attribute__((ns_consumes_self));
+@property(nonatomic, readonly) int effectfulRead;
+- (int)effectfulRead __objc3_throws(id<Error>);
+@end
+int read_safe(SplitAccessors * _Nonnull object) {
+  KeyPath<SplitAccessors *, int> checked = @keypath(SplitAccessors, checked);
+  KeyPath<SplitAccessors *, int> affine = @keypath(SplitAccessors, affine);
+  KeyPath<SplitAccessors *, SplitAccessors * _Nullable> consuming = @keypath(SplitAccessors, consuming);
+  WritableKeyPath<SplitAccessors *, int> ordinary = @keypath(SplitAccessors, ordinary);
+  KeyPathSet(ordinary, object, 17);
+  return KeyPathGet(checked, object) + KeyPathGet(affine, object) +
+         (KeyPathGet(consuming, object) != 0);
+}
+void reject_effects(SplitAccessors * _Nonnull object) {
+  KeyPathSet(@keypath(SplitAccessors, checked), object, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(@keypath(SplitAccessors, affine), object, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(@keypath(SplitAccessors, consuming.ordinary), object, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  (void)@keypath(SplitAccessors, affineRead); // expected-error {{synchronous key paths cannot access actor-isolated or executor-affine properties}}
+  (void)@keypath(SplitAccessors, consumingRead); // expected-error {{key paths cannot erase consuming accessor ownership}}
+  (void)@keypath(SplitAccessors, effectfulRead); // expected-error {{key-path accessors must be synchronous and nonthrowing}}
+}
