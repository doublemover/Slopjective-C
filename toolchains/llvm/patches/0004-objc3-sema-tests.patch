@@ -0,0 +1,31 @@
+#ifndef OBJC3_BORROWED_CALLABLE_OWNER_H
+#define OBJC3_BORROWED_CALLABLE_OWNER_H
+typedef borrowed const char *CallbackBytes;
+CallbackBytes callback_source(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+CallbackBytes callback_first(id first,id second) __attribute__((objc_returns_borrowed(owner_index=0)));
+CallbackBytes callback_second(id first,id second) __attribute__((objc_returns_borrowed(owner_index=1)));
+typedef CallbackBytes CallbackFunction(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+typedef CallbackFunction *CallbackGetter;
+typedef CallbackBytes (*CallbackFirst)(id first,id second) __attribute__((objc_returns_borrowed(owner_index=0)));
+typedef CallbackBytes (*CallbackSecond)(id first,id second) __attribute__((objc_returns_borrowed(owner_index=1)));
+typedef CallbackBytes (*OpaqueGetter)(id owner);
+typedef CallbackBytes (^CallbackBlock)(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void callback_use(const char *value __attribute__((noescape)));
+void callback_escape(const char *value);
+void callback_consume(id value __attribute__((ns_consumed)));
+#ifdef __cplusplus
+using CallbackAlias=CallbackFunction *;
+template<class T> using CallbackResult=CallbackBytes(__attribute__((objc_returns_borrowed(owner_index=0))) *)(T*);
+template<class T> T callback_identity(T value) {return value;}
+template<class Getter>
+__attribute__((objc_returns_borrowed(owner_index=1)))
+CallbackBytes generic_callback_forward(Getter getter,id owner) {return getter(owner);}
+struct CallbackWorker {
+  CallbackBytes get(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+};
+template<class> struct CallbackOwner {static constexpr int value=0;};
+template<class T> struct CallbackOwner<CallbackBytes(__attribute__((objc_returns_borrowed(owner_index=0))) *)(id,T)> {static constexpr int value=1;};
+template<class T> struct CallbackOwner<CallbackBytes(__attribute__((objc_returns_borrowed(owner_index=1))) *)(id,T)> {static constexpr int value=2;};
+using CallbackMember=CallbackBytes(__attribute__((objc_returns_borrowed(owner_index=0))) CallbackWorker::*)(id);
+#endif
+#endif
