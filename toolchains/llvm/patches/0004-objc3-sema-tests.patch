+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+#include "../Inputs/keypath-abi.h"
+__attribute__((objc_root_class))
+@interface NullPathElement
+@end
+__attribute__((objc_root_class))
+@interface NullPathBox<T : id>
+@end
+using NullableElements = NullPathBox<NullPathElement * _Nullable> * _Nonnull;
+using NonnullElements = NullPathBox<NullPathElement * _Nonnull> * _Nonnull;
+using NullableCallback = NullPathElement * _Nullable (* _Nonnull)(NullPathElement * _Nullable);
+using NonnullCallback = NullPathElement * _Nonnull (* _Nonnull)(NullPathElement * _Nonnull);
+using NullablePointee = NullPathElement * __unsafe_unretained _Nullable * _Nonnull;
+using NonnullPointee = NullPathElement * __unsafe_unretained _Nonnull * _Nonnull;
+__attribute__((objc_root_class))
+@interface NullPathRoot
+@property(nonatomic, strong) NullableElements elements;
+@property(nonatomic) NullableCallback callback;
+@end
+using Read = KeyPath<NullPathRoot *, NullableElements>;
+using Alias = NullableElements;
+static_assert(__is_same(Read, KeyPath<NullPathRoot *, Alias>));
+static_assert(!__is_same(Read, KeyPath<NullPathRoot *, NonnullElements>));
+static_assert(!__is_same(KeyPath<NullableElements, int>,
+                        KeyPath<NonnullElements, int>));
+static_assert(!__is_same(KeyPath<NullPathRoot *, NullableCallback>,
+                        KeyPath<NullPathRoot *, NonnullCallback>));
+static_assert(!__is_same(KeyPath<NullPathRoot *, NullablePointee>,
+                        KeyPath<NullPathRoot *, NonnullPointee>));
+static_assert(__is_same(decltype(@keypath(NullPathRoot, elements)),
+                       WritableKeyPath<NullPathRoot *, NullableElements>));
+static_assert(__is_same(decltype(@keypath(NullPathRoot, callback)),
+                       WritableKeyPath<NullPathRoot *, NullableCallback>));
+
+struct NativeMemberPathOwner {};
+using NullableMember = int (NativeMemberPathOwner::*)(NullPathElement * _Nullable);
+using NonnullMember = int (NativeMemberPathOwner::*)(NullPathElement * _Nonnull);
+static_assert(!__is_same(KeyPath<NullPathRoot *, NullableMember>,
+                        KeyPath<NullPathRoot *, NonnullMember>));
