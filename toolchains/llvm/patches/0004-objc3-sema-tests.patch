+int local_argument_effect();
+void local_concrete_reference(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  auto work=[&pointer]{memory_use(pointer);};
+  work();work();
+}
+void local_const_default(void *owner) {
+  const char *pointer=memory_bytes(owner);
+  const auto work=[&pointer](int offset=0){memory_use(pointer+offset);};
+  work();work(1);
