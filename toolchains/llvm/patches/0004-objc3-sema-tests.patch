--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/borrowed-static-control-flow.h
@@ -0,0 +1,330 @@
+#ifndef OBJC3_BORROWED_STATIC_CONTROL_FLOW_H
+#define OBJC3_BORROWED_STATIC_CONTROL_FLOW_H
+typedef borrowed const char *StaticGraphLoan;
+#define STATIC_GRAPH __attribute__((objc_returns_borrowed(owner_index=0)))
+static const char graph_first[]="first",graph_second[]="second";
+static char graph_mutable[]="mutable";
+const char *graph_unknown(void);
+static const char *graph_branch(int choose){if(choose)return graph_first;return graph_second;}
+static const char *graph_switch(int choose){switch(choose){case 0:return graph_first;case 1:return graph_second;default:return 0;}}
+static const char *graph_loop(int count){while(count--){if(count==2)return graph_second;}return graph_first;}
+static const char *graph_goto(int choose){if(choose)goto other;return graph_first;other:return graph_second;}
+static const char *graph_const_local(int choose){const char *const value=choose?graph_first:graph_second;return value;}
+union StaticGraphUnion {char bytes[8];long other;};
+extern const union StaticGraphUnion graph_union;
+extern const char graph_equal_bound[8];
+static const char *graph_equal_arrays(int choose){const char *const value=choose?graph_equal_bound:graph_union.bytes;return value;}
+static const char *graph_array_local(int choose){const char local[8]="local";return choose?graph_equal_bound:local;}
+static const char *graph_array_mutable(int choose){return choose?graph_equal_bound:graph_mutable;}
+
+static const char *graph_const_union(int choose){const char *const value=choose?graph_first:graph_union.bytes;const char *const alias=value;return alias;}
+static const char *graph_const_chain(int choose){const char *const value=graph_const_local(choose);const char *const other=value;return other+1;}
+static const char *graph_mixed(int choose,const char *unknown){if(choose)return graph_first;return unknown;}
+static const char *graph_missing_default(int choose){switch(choose){case 0:return graph_first;case 1:return graph_second;}}
+static const char *graph_missing_branch(int choose){if(choose)return graph_first;}
+static const char *graph_missing_loop(int count){while(count--){return graph_first;}}
+static const char *graph_goto_end(int choose){if(choose)goto end;return graph_first;end:;}
+static const char *graph_mutable_local(int choose){const char *value=graph_first;if(choose)value=graph_unknown();return value;}
+static const char *graph_unknown_local(void){const char *const value=graph_unknown();return value;}
+static const char *graph_mutable_storage(void){const char *const value=graph_mutable;return value;}
+static const char *graph_nested_return(int choose,const char *unknown){(void)({if(choose)return unknown;0;});return graph_first;}
