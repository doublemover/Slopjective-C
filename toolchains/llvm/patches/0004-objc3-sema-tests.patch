+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -fsyntax-only -verify %s
+struct Owner {Owner(int);Owner(const Owner &);~Owner() noexcept;};
+typedef __objc3_optional(Owner) Maybe;
+typedef borrowed Maybe *BorrowedMaybe;
+void reject_direct(BorrowedMaybe value) {
+  value->~Maybe(); // expected-error {{native destruction of borrowed storage without ownership}}
+}
+void reject_alias(BorrowedMaybe value) {
+  Maybe *alias=value;
+  alias->~Maybe(); // expected-error {{native destruction of borrowed storage without ownership}}
+}
+void allow_owned(Maybe *value) {value->~Maybe();}
