+void nested_union_bytes(void *owner) {
+  struct NestedUnion value={17,{union_bytes(owner)}};
+  char *bytes=(char *)&value+__builtin_offsetof(struct NestedUnion,value);
+  *(const char **)bytes="permanent";
+  union_escape(value.value.first);
+}
+void nested_union_member(void *owner) {
+  struct NestedUnion value={17,{union_bytes(owner)}};
+  value.value.second="permanent";union_escape(value.value.first);
+}
+void partial_union_overwrite(void *owner) {
+  union PartialUnion value={union_bytes(owner)};
+  value.pointer="permanent";
