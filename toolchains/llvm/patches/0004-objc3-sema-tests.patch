+  FamilyRef resurrected=FamilyHold(owner); // expected-error {{retainable family operation after owner release}}
+  FamilyUse(FamilyGetBytes(resurrected));
+}
+#ifdef __cplusplus
+using CxxFamily __attribute__((objc_retainable_family(Cxx))) = FamilyRef; // expected-error {{cannot change its inherited family}}
+#endif
+typedef struct FamilyObject *RepeatedFamily __attribute__((objc_retainable_family(Example)));
