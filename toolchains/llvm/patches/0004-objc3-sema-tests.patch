+void Multiple(FamilyRef left,FamilyRef right) __attribute__((objc_family_release(Example))); // expected-error {{requires a synchronous nonthrowing nondependent unary function}}
+void Missing(void) __attribute__((objc_family_release(Example))); // expected-error {{requires a synchronous nonthrowing nondependent unary function}}
+FamilyRef Contradictory(FamilyRef value) __attribute__((objc_family_retain(Example),objc_family_autorelease(Example))); // expected-error {{cannot change its family or operation}}
+FamilyRef Redeclared(FamilyRef value) __attribute__((objc_family_retain(Example)));
+FamilyRef Redeclared(FamilyRef value) __attribute__((objc_family_autorelease(Example))); // expected-error {{redeclaration changes its family or operation}}
+void FamilyDrop(FamilyRef value);
+void inherited_release(FamilyRef owner) {
