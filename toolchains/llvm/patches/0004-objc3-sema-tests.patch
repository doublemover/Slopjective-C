--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/typed-keypath-dependent-types.h
@@ -0,0 +1,51 @@
+#ifndef OBJC3_DEPENDENT_KEYPATH_TYPES_H
+#define OBJC3_DEPENDENT_KEYPATH_TYPES_H
+#include "../../Inputs/keypath-abi.h"
+struct DependentTypePair { long first, second; };
+__attribute__((objc_root_class))
+@interface DependentTypeRoot
+@property(nonatomic) int count;
+@property(nonatomic, readonly) int identity;
+@property(nonatomic) DependentTypePair pair;
+@end
+template<class Root, class Value> using DependentRead = KeyPath<Root, Value>;
+template<class Root, class Value> using DependentWrite = WritableKeyPath<Root, Value>;
+template<class Root, class Value>
+Value read_typed_path(KeyPath<Root, Value> path, Root root) {
+  return KeyPathGet(path, root);
+}
+template<class Root, class Value>
+void write_typed_path(WritableKeyPath<Root, Value> path, Root root, Value value) {
+  KeyPathSet(path, root, value);
+}
+template<class Root, class Value>
+KeyPath<Root, Value> narrow_typed_path(WritableKeyPath<Root, Value> path) {
+  return path;
+}
+template<class Root, class Value> struct DependentPathHolder {
+  KeyPath<Root, Value> read;
+  WritableKeyPath<Root, Value> write;
+  Value get(Root root) const { return KeyPathGet(read, root); }
+  void set(Root root, Value value) const { KeyPathSet(write, root, value); }
+};
+template<class Path> struct DependentPathTraits;
+template<class Root, class Value> struct DependentPathTraits<KeyPath<Root, Value>> {
+  using root = Root; using value = Value;
+  static constexpr bool writable = false;
+};
+template<class Root, class Value> struct DependentPathTraits<WritableKeyPath<Root, Value>> {
+  using root = Root; using value = Value;
+  static constexpr bool writable = true;
+};
+template<class Root, class Value> int typed_path_kind(KeyPath<Root, Value>) {return 1;}
+template<class Root, class Value> long typed_path_kind(WritableKeyPath<Root, Value>) {return 2;}
+template<class... Roots> unsigned typed_path_pack(WritableKeyPath<Roots, int>... paths) {
+  return sizeof...(paths);
+}
+template<class Root> WritableKeyPath<Root, int> make_typed_path() {
+  return @keypath(Root, count);
+}
+template<class Root,class Value> int typed_read_ref(const KeyPath<Root,Value>& path) {return 1;}
+template<class Root,class Value> int typed_read_mutable_ref(KeyPath<Root,Value>& path) {return 1;}
+template<class Root,class Value> int typed_read_pointer(KeyPath<Root,Value>* path) {return 1;}
+#endif
diff --git a/clang/test/ObjC3/Sema/typed-keypath-dependent-type-errors.mm b/clang/test/ObjC3/Sema/typed-keypath-dependent-type-errors.mm
