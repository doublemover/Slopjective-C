+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-callable-owners.h -o %t-c++23-True.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -include-pch %t-c++23-True.pch -DFROM_PCH -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-callable-owners.h"
+#endif
+__attribute__((objc_returns_borrowed(owner_index=1)))
+CallbackBytes forward_callback(CallbackGetter getter,id owner) {return getter(owner);}
+__attribute__((objc_returns_borrowed(owner_index=1)))
+CallbackBytes forward_callback_block(CallbackBlock getter,id owner) {return getter(owner);}
+__attribute__((objc_returns_borrowed(owner_index=2)))
+CallbackBytes forward_second(CallbackSecond getter,id other,id owner) {return getter(other,owner);}
+void local_callback(CallbackGetter getter,id owner) {
+  const char *loan=getter(owner);
+  callback_use(loan);
+  keepAlive(owner);
+  callback_use(getter(owner));
+}
+void direct_callback_address(id owner) {
+#ifdef __cplusplus
+  auto getter=callback_source;
+#else
+  __auto_type getter=callback_source;
