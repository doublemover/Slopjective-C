+void consumed_use(const char *pointer __attribute__((noescape)));
+void consume_claim(id owner __attribute__((ns_consumed)),int unused);
+void consume_pair(id owner __attribute__((ns_consumed)),const char *pointer __attribute__((noescape)));
+typedef void (*ConsumedCallback)(id owner __attribute__((ns_consumed)),int unused);
+typedef void (^ConsumedBlock)(id owner __attribute__((ns_consumed)),int unused);
+__attribute__((objc_root_class)) @interface ConsumingOwner
+- (void)consume __attribute__((ns_consumes_self));
