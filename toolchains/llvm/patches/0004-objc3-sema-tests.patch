+// RUN: %clang_cc1 -x objective-c++-header -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc3-profile=strict-system -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -emit-pch %S/Inputs/callable-borrowed-template.h -o %t.23.arc.pch
+// RUN: %clang_cc1 -x objective-c++ -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc3-profile=strict-system -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -include-pch %t.23.arc.pch -DFROM_PCH -fsyntax-only -verify %s
