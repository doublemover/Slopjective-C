+void block_consumes_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  work();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void repeated_block(void *owner) {
+  void (^work)(void)=^{closure_use(closure_bytes(owner));closure_consume(owner);};
+  work();
+  work(); // expected-error {{captured owner lifetime ended}}
+}
+void copied_block(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  void (^copy)(void)=work;
+  closure_use(pointer);
+  copy();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void unused_block_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  void (^unused)(void)=^{(void)work;};
+  unused();
+  closure_use(pointer);
+}
+void invoked_block_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  void (^forward)(void)=^{work();};
+  forward();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void overwritten_block(void *owner,void *other) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  work=^{closure_consume(other);};
+  work();
+  closure_use(pointer);
+}
+void qualified_block_boundary(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  void (^work)(void)=^{closure_consume(owner);};
+  closure_invoke(work); // expected-error {{borrowed argument overlapping a consumed owner claim}}
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+#ifdef __cplusplus
+void lambda_consumes_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  work();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void repeated_lambda(void *owner) {
+  auto work=[owner]{closure_use(closure_bytes(owner));closure_consume(owner);};
+  work();
+  work(); // cxx-error {{after its owner lifetime ended}}
+}
