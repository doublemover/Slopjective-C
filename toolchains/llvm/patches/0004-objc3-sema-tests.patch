+#ifndef OBJC3_MEMBER_POINTER_GRAPHS_H
+#define OBJC3_MEMBER_POINTER_GRAPHS_H
+#include "native-stored-callables.h"
+#if defined(__cplusplus) && __OBJC3_PROFILE__ != 3
+struct FixedMemberReceiver {
+ void store(const char *&slot,const char *value)const{slot=value;}
+ void global(const char *value)const{global_projection_pointer=value;}
+ const char *load(const char *const &slot)const{return slot;}
+ const char *&slot()const{return global_projection_pointer;}
+ int number(const int &value)const{return value;}
+ int observation(const int &value)const{return value>=0;}
+ void ordinary(const char *&slot)const noexcept{slot="static";}
+ void alternate(const char *&slot)const noexcept{slot="other";}
+ virtual void dynamic(const char *&slot)const{slot="static";}
+};
+struct FixedMemberFinal final:FixedMemberReceiver {
+ void dynamic(const char *&slot)const override{slot="static";}
+};
+struct FixedMemberField {
+ const char *pointer;
+ const char *get()const{return pointer;}
+ bool observed()const{return pointer!=nullptr;}
+};
+static inline void member_pointer_ordinary(){
+ FixedMemberReceiver source;const char *slot="static";
+ auto const method=&FixedMemberReceiver::store;auto const &alias=method;(source.*alias)(slot,"other");
+ const char *value=slot;(void)binding_detached(^void(void) __objc3_async_frame {(void)value;});
+ auto const load=&FixedMemberReceiver::load;const char *read=(source.*load)(slot);
+ (void)binding_detached(^void(void) __objc3_async_frame {(void)read;});
+ auto const literal=&FixedMemberReceiver::ordinary;(source.*literal)(slot);
+ FixedMemberFinal final_source;auto const final_call=&FixedMemberFinal::dynamic;(final_source.*final_call)(slot);
+ const char *after=slot;(void)binding_detached(^void(void) __objc3_async_frame {(void)after;});
+}
+#endif
+#endif

