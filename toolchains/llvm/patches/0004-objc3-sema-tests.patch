diff --git a/clang/test/ObjC3/Sema/Inputs/dependent-resource.h b/clang/test/ObjC3/Sema/Inputs/dependent-resource.h
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/dependent-resource.h
@@ -0,0 +1,23 @@
+#ifndef OBJC3_DEPENDENT_RESOURCE_H
+#define OBJC3_DEPENDENT_RESOURCE_H
+namespace DependentResource {
+inline int calls=0;
+inline void close_int(int)noexcept{++calls;}
+inline void close_pointer(int *)noexcept{++calls;}
+template<class T>struct Traits {static void close(T)noexcept{++calls;}static constexpr T invalid=static_cast<T>(-1);};
+template<class T>void close_value(T)noexcept{++calls;}
+template<class T>void close_address(T *)noexcept{++calls;}
+template<class T>void dependent(T initial){@resource(Traits<T>::close, invalid: Traits<T>::invalid) T value=initial;(void)value;}
+template<class T>void address(T initial){@resource(close_address<T>, invalid: -1) T value=initial;(void)value;}
+template<class T>void automatic(T initial){@resource(close_value<T>, invalid: -1) auto value=initial;(void)value;}
+inline void auto_named(){@resource(close_int, invalid: -1) auto value=42;(void)value;}
+template<int Sentinel>void sentinel(int initial){@resource(close_int, invalid: Sentinel) int value=initial;(void)value;}
+typedef int Handle __attribute__((objc_requires_cleanup(close_value<int>),objc_invalid(-1),objc_resource_family(TemplateHandles)));
+inline void typed(){@resource(close_value<int>, invalid: -1) Handle value=42;(void)value;}
+template<class T>void wrong_callback(T initial){@resource(close_pointer, invalid: -1) T value=initial;(void)value;}
+template<class T>void wrong_auto(T initial){@resource(close_int, invalid: -1) auto value=initial;(void)value;}
+template<class T>void wrong_storage(T initial){@resource(close_value<T>, invalid: -1) T value=initial;(void)value;}
+inline int runtime_sentinel();
+template<class T>void wrong_sentinel(T initial){@resource(close_value<T>, invalid: runtime_sentinel()) T value=initial;(void)value;}
+}
+#endif
