+template <> struct DeepBase<0> { BaseBytes bytes; };
+struct ArcBorrowedBase { id object; BaseBytes bytes; };
+struct ArcBorrowedDerived : ArcBorrowedBase {};
+typedef void (*BorrowedSignature)(BaseBytes);
