+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=1 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=4 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=5 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DCASE=6 -fsyntax-only -verify %s
+#if CASE == 1
+int missing(void) __objc3_async __asm__("missing_frame"); // expected-error {{require the installed <objc3_runtime_services.h> frame declaration}}
+#elif CASE == 2
+#pragma pack(push, 1)
+#include "../CodeGen/Inputs/native-c-async-frame.h"
+#pragma pack(pop)
+int packed(void) __objc3_async __asm__("packed_frame"); // expected-error {{incompatible runtime layout}}
+#else
+#include "../CodeGen/Inputs/native-c-async-frame.h"
+#if CASE == 3
+int unbound(void) __objc3_async;
+int variadic(int, ...) __objc3_async __asm__("variadic_frame"); // expected-error {{require a non-variadic Linux x86-64}}
+id owned(void) __objc3_async __asm__("owned_frame") __attribute__((ns_returns_retained));
+_Noreturn void never(void) __objc3_async __asm__("never_frame"); // expected-error {{cannot be noreturn}}
+#elif CASE == 4
+// expected-no-diagnostics
+int definition(void) __objc3_async __asm__("definition_frame");
+int definition(void) __objc3_async {
+  return 42;
+}
+#elif CASE == 5
+int leaf(void) __objc3_async __asm__("leaf_frame");
+void suspend(void) {
+  __objc3_await leaf(); // expected-error {{native await requires an async Objective-C or Objective-C++20/23 function context}}
+}
+#elif CASE == 6
+int bound(int) __objc3_async __asm__("bound_frame");
+typedef int (*AsyncInt)(int) __objc3_async;
+int (*sync)(int) = bound; // expected-error {{incompatible function pointer types}}
+AsyncInt valid = bound;
+int invalid_value(void) {
+  return bound(0); // expected-error {{returning 'struct objc3_async_frame'}}
+}
+#endif
+#endif
diff --git a/clang/test/ObjC3/Sema/optional-access.m b/clang/test/ObjC3/Sema/optional-access.m
new file mode 100644
index 000000000..c12549591
--- /dev/null
+++ b/clang/test/ObjC3/Sema/optional-access.m
@@ -0,0 +1,43 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -Wnullable-to-nonnull-conversion -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -Wnullable-to-nonnull-conversion -fsyntax-only -verify=expected,cxx %s
+
+struct Record { int member; };
+@interface Receiver
+@property(readonly) Receiver * _Nonnull next;
+@property(readonly) int number;
+@property(readonly) struct Record record;
+- (int)scalar;
+- (struct Record)aggregate;
+- (void)effect:(int)value;
+- (void)noEffect;
++ (id)factory;
+@end
+void nonnull(id _Nonnull);
+
+void result_types(Receiver * _Nullable receiver, Receiver * _Nonnull fallback) {
+  nonnull(receiver?.next); // expected-warning {{implicit conversion from nullable pointer}} cxx-warning {{implicit conversion from nullable pointer}}
+  nonnull(receiver?.next ?? fallback);
+  (void)receiver?.number; // expected-error {{optional member access cannot return 'int'}}
+  (void)receiver?.record; // expected-error {{optional member access cannot return}}
+  (void)receiver?.noEffect; // expected-error {{optional member access cannot return 'void'}}
+  (void)[receiver? scalar]; // expected-error {{optional message send cannot return 'int'}}
+  (void)[receiver? aggregate]; // expected-error {{optional message send cannot return}}
+  [receiver? effect:1];
+}
+
+id class_receiver_expression(Class receiver) { return [receiver? factory]; }
+
+void invalid_receivers(int value, struct Record record, Optional(int) tagged) {
+  (void)value?.number; // expected-error {{optional access requires an Objective-C object receiver}}
+  (void)record?.member; // expected-error {{optional access requires an Objective-C object receiver}}
+  (void)tagged?.member; // expected-error {{optional access requires an Objective-C object receiver}}
+  (void)[value? factory]; // expected-error {{optional access requires an Objective-C object receiver}}
+  (void)[Receiver? factory]; // expected-error {{optional send requires a receiver expression}}
+}
+
+void recovery(Receiver *receiver) {
+  (void)receiver?.; // expected-error {{expected identifier}}
+  (void)[receiver?]; // expected-error {{expected identifier}}
+  id accepted = receiver?.next;
+  (void)accepted;
+}
diff --git a/clang/test/ObjC3/Sema/resource-operations.m b/clang/test/ObjC3/Sema/resource-operations.m
new file mode 100644
index 000000000..7346de9f3
--- /dev/null
+++ b/clang/test/ObjC3/Sema/resource-operations.m
@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=compatibility -fsyntax-only -verify=compat %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -verify=strict %s
+void close_handle(int) __attribute__((nothrow));
+void consume_handle(int) __attribute__((nothrow));
+#define RESOURCE __attribute__((objc_resource(close=close_handle, invalid=0)))
+void legal_transfer(void) {
+  int value RESOURCE = 0;
+  reset(value, 7);
+  int owned = take(value);
+  consume_handle(owned);
+  close_handle(owned);
+  if(value != 0)consume_handle(value);
+  value = 8;
+  discard(value);
+  reset(value, 9);
+}
+void moved_use(void) {
+  int value RESOURCE = 3;
+  int owned = take(value);
+  consume_handle(owned);
+  consume_handle(value); // strict-error {{may have been moved or discarded}}
+}
+void overwrite(void) {
+  int value RESOURCE = 3;
+  value = 4; // strict-error {{may overwrite live resource}}
+}
+void copy_owner(void) {
+  int value RESOURCE = 3;
+  int other RESOURCE = value; // strict-error {{copies ownership}}
+  (void)other;
+}
+void manual_close(void) {
+  int value RESOURCE = 3;
+  close_handle(value); // strict-error {{manual close of registered resource}}
+}
+void lost_take(void) {
+  int value RESOURCE = 3;
+  take(value); // strict-error {{discards its ownership result}} compat-warning {{expression result unused}} strict-warning {{expression result unused}}
+}
+void escaped_storage(void) {
+  int value RESOURCE = 3;
+  int *escaped = &value; // strict-error {{cannot track escaped storage}}
+  (void)escaped;
+}
+
+#ifdef __cplusplus
+void captured_owner(void) {
+  int value RESOURCE = 3;
+  auto closure = [value] { return value; }; // strict-error {{requires ownership-aware capture support}}
+  (void)closure;
+}
+#endif
diff --git a/clang/test/ObjC3/Sema/match-initialized-bindings.m b/clang/test/ObjC3/Sema/match-initialized-bindings.m
new file mode 100644
index 000000000..02e2cb01a
--- /dev/null
+++ b/clang/test/ObjC3/Sema/match-initialized-bindings.m
@@ -0,0 +1,31 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -Wuninitialized -Werror -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fblocks -Wuninitialized -Werror -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fblocks -Wuninitialized -Werror -fsyntax-only -verify %s
+
+int expression_binding(Optional(int) source) {
+  return match(source) {
+    case .Some(let payload) => payload + 1;
+    case .None => 0;
+  };
+}
+int statement_binding(Optional(int) source) {
+  match(source) {
+    case .Some(let payload): { return payload; }
+    case .None: { return 0; }
+  }
+}
+int block_binding(Optional(int) source) {
+  return (^(Optional(int) input) {
+    match(input) {
+      case .Some(let payload): { return payload; }
+      case .None: { return 0; }
+    }
+  })(source);
+}
+int unrelated_uninitialized(Optional(int) source) {
+  int missing; // expected-note {{initialize the variable 'missing' to silence this warning}}
+  return match(source) {
+    case .Some(let payload) => payload + missing; // expected-error {{variable 'missing' is uninitialized when used here}}
+    case .None => 0;
+  };
+}
diff --git a/clang/test/ObjC3/Sema/guard-unspecified-receivers.m b/clang/test/ObjC3/Sema/guard-unspecified-receivers.m
new file mode 100644
