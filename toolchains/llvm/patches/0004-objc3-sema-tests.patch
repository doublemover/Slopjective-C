diff --git a/clang/test/ObjC3/Sema/Inputs/native-lifetime-annotations.h b/clang/test/ObjC3/Sema/Inputs/native-lifetime-annotations.h
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/native-lifetime-annotations.h
@@ -0,0 +1,25 @@
+#ifndef OBJC3_NATIVE_LIFETIME_ANNOTATIONS_H
+#define OBJC3_NATIVE_LIFETIME_ANNOTATIONS_H
+namespace LifetimeControls {
+struct View;
+struct [[gsl::Owner(int)]] Owner {
+ int value;
+ void bind(View &target) const [[clang::lifetime_capture_by(target)]];
+};
+struct [[gsl::Pointer(int)]] View {const int *pointer;};
+inline void Owner::bind(View &renamed) const {renamed.pointer=&value;}
+void capture(const Owner &source [[clang::lifetime_capture_by(target)]],View &target);
+inline void capture(const Owner &renamed,View &result){result.pointer=&renamed.value;}
+void unnamed(const Owner &source [[clang::lifetime_capture_by(target)]],View &target);
+inline void unnamed(const Owner &,View &){}
+inline void global(const Owner &source [[clang::lifetime_capture_by_global]],int global){(void)source;(void)global;}
+inline void unknown(const Owner &source [[clang::lifetime_capture_by_unknown]],int unknown){(void)source;(void)unknown;}
+inline auto closure(){return [](const Owner &source [[clang::lifetime_capture_by(target)]],View &target){target.pointer=&source.value;};}
+template<class T>void generic(const Owner &source [[clang::lifetime_capture_by(target)]],View &target);
+template<class T>void generic(const Owner &,View &){}
+void conflict(const Owner &source [[clang::lifetime_capture_by(first)]],View &first,View &second);
+struct ReceiverConflict {
+ void bind(View &first,View &second) [[clang::lifetime_capture_by(first)]];
+};
+}
+#endif

