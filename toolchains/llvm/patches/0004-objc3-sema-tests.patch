+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface SafeBlockObject<Sendable> @end
+__attribute__((objc_root_class)) @interface UnsafeBlockObject @end
+typedef void (^BindingWork)(void) __objc3_async_frame;
+void *binding_detached(BindingWork) __attribute__((objc_task_detached));
+void binding_escape(BindingWork *);
+static inline void block_bindings_valid(int choose,SafeBlockObject *safe) {
+ BindingWork first=^void(void) __objc3_async_frame {(void)safe;};
+ BindingWork second=^void(void) __objc3_async_frame {};
+ BindingWork selected=first;if(choose)selected=second;
+ BindingWork alias=selected;alias=choose?first:selected;
+ (void)binding_detached(alias);
+ for(int n=0;n!=2;++n)alias=choose?alias:selected;
+ selected=alias;
+ (void)binding_detached(selected);
+ void (^callback)(void)=^{(void)safe;};
+ if(choose)callback=^{(void)safe;};
+ BindingWork nested=^void(void) __objc3_async_frame {callback();};
+ (void)binding_detached(nested);
+}
