+  (void)manual_block_detach(immutable);
+  (void)manual_block_detach(^objc3_async_frame { (void)object;return manual_factory(); }); // expected-error {{non-Sendable type}}
+  (void)manual_block_detach(unknown); // expected-error {{cannot prove Sendable captures}}
+  __block int shared=0;
+  (void)manual_block_detach(^objc3_async_frame { ++shared;return manual_factory(); }); // expected-error {{non-Sendable type}}
