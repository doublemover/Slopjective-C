+union __attribute__((objc_unsafe_sendable)) ImplicitManagedUnion {id value;long other;};
+ImplicitManagedUnion implicit_union(void) noexcept __attribute__((objc_executor(main)));
+struct ExplicitUnsendable {id value;~ExplicitUnsendable() noexcept;};
+ExplicitUnsendable explicit_unsendable(void) noexcept __attribute__((objc_executor(main)));
+union __attribute__((objc_unsafe_sendable)) ExplicitBorrowedUnion {
+  borrowed const char *value;long other;
+  ExplicitBorrowedUnion(const ExplicitBorrowedUnion &);
+  ~ExplicitBorrowedUnion() noexcept;
+};
