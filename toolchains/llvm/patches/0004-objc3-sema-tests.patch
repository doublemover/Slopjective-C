diff --git a/clang/test/ObjC3/Sema/carrier-arc-ownership.mm b/clang/test/ObjC3/Sema/carrier-arc-ownership.mm
new file mode 100644
index 000000000..59fa68eef
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-arc-ownership.mm
@@ -0,0 +1,36 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -std=c++20 -verify -fsyntax-only %s
+
+typedef __objc3_optional(id) StrongOptional;
+typedef __objc3_optional(id __weak) WeakOptional;
+typedef __objc3_optional(id __unsafe_unretained) UnsafeOptional;
+typedef __objc3_result(id, id __weak) MixedResult;
+
+struct ContainsRetainableField { id value; };
+typedef __objc3_optional(id __autoreleasing) AutoreleasingOptional; // expected-error {{payload type}} 
+typedef void (^Action)(void);
+typedef __objc3_optional(Action) BlockOptional;
+typedef __objc3_optional(Action __weak) WeakBlockOptional;
+typedef __objc3_optional(Action __unsafe_unretained) UnsafeBlockOptional;
+typedef __objc3_optional(struct ContainsRetainableField) AggregateOptional;
+
+void accepted_types(id object) {
+  StrongOptional strong = __objc3_some(id, object);
+  WeakOptional weak = __objc3_some(id __weak, object);
+  UnsafeOptional unsafe = __objc3_some(id __unsafe_unretained, object);
+  MixedResult result = __objc3_err(id, id __weak, object);
+  (void)strong; (void)weak; (void)unsafe; (void)result;
+}
+
+struct ArrayOfRetainableFields { id values[2]; };
+struct ManagedBase { id value; };
+struct DerivedManaged : ManagedBase { int plain; };
+typedef __objc3_optional(ArrayOfRetainableFields) ArrayAggregate;
+typedef __objc3_optional(DerivedManaged) DerivedAggregate;
+typedef __objc3_optional(StrongOptional) NestedManagedCarrier;
+
+typedef __objc3_optional(Action __autoreleasing) AutoreleasingBlockOptional; // expected-error {{payload type}}
+void accepted_block_types(Action action) {
+  WeakBlockOptional weak = __objc3_some(Action __weak, action);
+  UnsafeBlockOptional unsafe = __objc3_some(Action __unsafe_unretained, action);
+  (void)weak; (void)unsafe;
+}
