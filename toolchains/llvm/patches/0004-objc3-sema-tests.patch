+ return [alias read];
+}
+- (int)volatileAlias {
+ ReceiverActor *_Nonnull const volatile alias=self;
+ return [alias read]; // expected-error {{cross-actor entry requires an explicit await}}
+}
+- (int)mutableCell {
+ ReceiverActor *_Nonnull alias=self;
+ ReceiverActor *_Nonnull __strong *const cell=&alias;
+ return [*cell read]; // expected-error {{cross-actor entry requires an explicit await}}
+}
+- (int)conditionalAlias:(ReceiverActor *_Nonnull)other flag:(int)flag {
