+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2  -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2  -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2  -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-c-async-frame.h"
+typedef const struct __CFAdmission *AdmissionCFRef;
+AdmissionCFRef retained_foreign(void)
+    __attribute__((nothrow,cf_returns_retained,objc_executor(main)));
+AdmissionCFRef borrowed_foreign(void)
+    __attribute__((nothrow,cf_returns_not_retained,objc_executor(main)));
+AdmissionCFRef reject_retained_foreign(void) __objc3_async_frame {
+  return __objc3_await retained_foreign();
+}
+AdmissionCFRef reject_borrowed_foreign(void) __objc3_async_frame {
+  return __objc3_await borrowed_foreign();
+}
+typedef const struct __CFBridged *BridgedCFRef __attribute__((NSObject));
+int bridged_foreign(__attribute__((cf_consumed)) BridgedCFRef)
+    __attribute__((nothrow,objc_executor(main)));
+int reject_bridged_foreign(BridgedCFRef value) __objc3_async_frame {
+  return __objc3_await bridged_foreign(value);
+}
+
+// NSObject-backed pointers are admitted; function-pointer CF contracts remain
+// outside the native value/ownership contract.
+typedef void (*CodePointer)(void);
+int invalid_foreign_code(__attribute__((cf_consumed)) CodePointer)
+    __attribute__((nothrow,objc_executor(main))); // expected-note@-1 {{concurrency boundary is declared here}}
+int reject_foreign_code(CodePointer value) __objc3_async_frame {
+  return __objc3_await invalid_foreign_code(value); // expected-error {{awaited isolated entry requires}}
+}
