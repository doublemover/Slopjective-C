+  const char *pointer=closure_bytes(owner);
+  ClosureWork work=^{closure_consume(owner);};
+  closure_invoke_ref(&work,(work=^{closure_consume(other);},0)); // expected-error {{borrowed argument overlapping a consumed owner claim}}
+  closure_use(pointer);
