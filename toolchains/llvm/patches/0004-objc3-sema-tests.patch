+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-mrc.pch -DFROM_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-future-captures.h -o %t-arc.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -include-pch %t-arc.pch -DFROM_PCH -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-future-captures.h"
+#endif
+void before_consumption(void *owner) {
+  auto work=[owner]{future_use(future_bytes(owner));};
+  auto copy=work;
+  work();copy.operator()();future_sync(copy);
+  future_consume(owner);
+}
+void after_consumption(void *owner) {
+  auto work=[owner]{future_use(future_bytes(owner));};
+  future_consume(owner);
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void copied_capture(void *owner) {
+  void *alias=owner;
+  auto work=[alias]{future_use(future_bytes(alias));};
+  auto copy=work;
+  future_consume(owner);
+  copy(); // expected-error {{after its owner lifetime ended}}
+}
+void init_capture(void *owner) {
+  auto work=[copy=owner]{future_use(future_bytes(copy));};
+  future_consume(owner);
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void local_alias(void *owner) {
+  auto work=[owner]{void *alias=owner;future_use(future_bytes(alias));};
+  future_consume(owner);
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void overwritten_alias(void *first,void *second) {
+  auto work=[first,second]{void *alias=first;alias=second;future_use(future_bytes(alias));};
+  future_consume(first);
+  work();
+}
+void conditional_alias(void *first,void *second) {
+  auto work=[first,second](bool choose){void *alias=first;if(choose)alias=second;future_use(future_bytes(alias));};
+  future_consume(second);
+  work(true); // expected-error {{after its owner lifetime ended}}
+}
+void nested_body(void *owner) {
+  auto work=[owner]{auto nested=[owner]{future_use(future_bytes(owner));};nested();};
+  future_consume(owner);
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void block_body(void *owner) {
+  void (^work)(void)=^{future_use(future_bytes(owner));};
+  future_consume(owner);
+  work(); // expected-error {{after its captured owner lifetime ended}}
+}
+void escape_future(void *owner) {
+  auto work=[owner]{future_use(future_bytes(owner));};
+  future_sink(work); // expected-error {{borrowed pointer escapes}}
+}
+auto return_future(void *owner) {
+  return [owner]{future_use(future_bytes(owner));}; // expected-error {{borrowed pointer escapes}}
+}
+void unqualified_reference(void *owner) {
+  auto work=[&owner]{future_use(future_bytes(owner));};
+  work();
+}
+void unqualified_mutable(void *owner) {
+  auto work=[owner]()mutable{future_use(future_bytes(owner));};
+  work();
+}
+void unqualified_generic(void *owner) {
+  auto work=[owner](auto){future_use(future_bytes(owner));};
+  work(0);
+}
+void materialize_owner(void) {
+  auto work=[owner=make_future_owner()]{future_use(future_bytes(owner));}; // expected-error {{owner init-capture requiring an explicit stable lifetime binding}}
+  work();
+}
+#if __has_feature(objc_arc)
+void independent_owner(FutureObject *_Nonnull owner) {
+  auto work=[owner]{future_use(future_object_bytes(owner));};
+  owner=nullptr;
+  work();
+}
+void independent_init_owner(FutureObject *_Nonnull owner) {
+  auto work=[copy=owner]{future_use(future_object_bytes(copy));};
+  owner=nullptr;
+  work();
+}
+#else
+void manual_object(FutureObject *_Nonnull owner) {
+  auto work=[owner]{future_use(future_object_bytes(owner));};
+  [owner release];
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+void independent_block_owner(FutureObject *_Nonnull owner) {
+  void (^work)(void)=^[strong owner]{future_use(future_object_bytes(owner));};
+  [owner release];
+  work();
+}
+#endif
+
+#if !__has_feature(objc_arc)
+void independent_pin(FutureObject *_Nonnull owner) {
+  keepAlive(owner);
+  auto work=[owner]{future_use(future_object_bytes(owner));};
+  [owner release];
+  work();
+}
+void future_pin_expires(FutureObject *_Nonnull owner) {
+  auto work=[owner]{future_use(future_object_bytes(owner));};
+  withLifetime(owner) {[owner release];work();}
+  work(); // expected-error {{after its owner lifetime ended}}
+}
+#endif
+void unrelated_capture(void *first,void *second) {
+  auto work=[first,second]{(void)first;future_use(future_bytes(second));};
+  future_consume(first);
+  work();
+}
+void reference_scalar(void *owner) {
+  int count=0;
+  auto work=[owner,&count]{++count;future_use(future_bytes(owner));};
+  work();
+  future_consume(owner);
+}
+void nested_summary_depth(void *owner) {
+  auto work0=[owner]{
+    auto work1=[owner]{
+      auto work2=[owner]{
+        auto work3=[owner]{
+          auto work4=[owner]{
+            auto work5=[owner]{
+              auto work6=[owner]{
+                auto work7=[owner]{
+                  auto work8=[owner]{
+                    auto work9=[owner]{
+                      auto work10=[owner]{
+                        auto work11=[owner]{
+                          future_use(future_bytes(owner));
+                        };
+                        work11();
+                      };
+                      work10();
+                    };
+                    work9();
+                  };
+                  work8();
+                };
+                work7();
+              };
+              work6();
+            };
+            work5();
+          };
+          work4();
+        };
+        work3();
+      };
+      work2();
+    };
+    work1();
+  };
+  future_consume(owner);
+  work0(); // expected-error {{after its owner lifetime ended}}
+}
