+#ifndef OBJC3_PUBLIC_ASYNC_SYNTAX_H
+#define OBJC3_PUBLIC_ASYNC_SYNTAX_H
+#include "../../CodeGen/Inputs/native-c-async-frame.h"
+static inline int public_async_leaf(int value) async {return value+1;}
+static inline int public_async_parent(int value) async {return await public_async_leaf(value);}
+typedef int (*PublicAsyncFunction)(int) async;
+typedef int (^PublicAsyncBlock)(int) async;
+static inline int public_async_indirect(PublicAsyncFunction call,int value) async {return await call(value);}
+static inline objc3_async_frame public_async_block(int value){
+ PublicAsyncBlock work=^int(int input) async {return await public_async_leaf(input);};
+ return work(value);
+}
+static inline int async(int value){return value;}
+static inline int await(int value){return value;}
+static inline int public_async_identifiers(void){return async(20)+await(22);}
+static inline int public_async_parenthesized_name(int value) async {
+ int observed=(await)(value);
+ return await public_async_leaf(observed);
+}
+static inline int public_async_local_name(int value) async {
+ int await=value;int observed=await;
+ return await public_async_leaf(observed);
+}
+__attribute__((objc_root_class)) @interface PublicAsyncWorker
+-(int)step:(int)value async;
+-(int)async:(int)value;
+@end
+#if defined(__cplusplus)
+namespace objc3 {template<class Value>struct task {};}
+template<class Value>using __objc3_async_task=objc3::task<Value>;
+using PrivateTaskAlias=int(*)(int) __objc3_async;
+using IntrinsicFrameAlias=int(*)(int) __objc3_async_frame;
+using PublicAsyncAlias=int(*)(int) async;
+static_assert(__is_same(PublicAsyncAlias,IntrinsicFrameAlias));
+static_assert(!__is_same(PublicAsyncAlias,PrivateTaskAlias));
+struct PublicAsyncMethods {
+ int step(int value) async {return await public_async_leaf(value);}
+};
+static inline int public_async_lambda(int value) async {
+ auto work=[](int input)->int async {return await public_async_leaf(input);};
+ return await work(value);
+}
+#endif
+#endif

