--- /dev/null
+++ b/clang/test/ObjC3/Sema/cpp-carrier-parameter-access.mm
@@ -0,0 +1,19 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DREGION=1 -fsyntax-only -verify -verify-ignore-unexpected=note %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DREGION=2 -fsyntax-only -verify -verify-ignore-unexpected=note %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DREGION=3 -fsyntax-only -verify -verify-ignore-unexpected=note %s
+struct MoveOnly {MoveOnly(const MoveOnly &)=delete;MoveOnly(MoveOnly &&);~MoveOnly() noexcept;};
+using Maybe=__objc3_optional(MoveOnly);
+void sink(Maybe);
+__attribute__((objc_root_class)) @interface Host
+- (void)consume:(Maybe)value;
+@end
+typedef void (^Callback)(Maybe);
+void reject_copy(Host *object,Callback callback,Maybe &value) {
+#if REGION == 1
+  sink(value); // expected-error {{call to deleted constructor}}
+#elif REGION == 2
+  [object consume:value]; // expected-error {{call to deleted constructor}}
+#else
+  callback(value); // expected-error {{call to deleted constructor}}
+#endif
+}
