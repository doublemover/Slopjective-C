+typedef struct FamilyObject *OtherFamily __attribute__((objc_retainable_family(Other)));
+void ChangedParameter(FamilyRef value) __attribute__((objc_family_release(Example)));
+void ChangedParameter(OtherFamily value); // expected-error {{conflicting retainable family function type contract}}
