--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-dependent-types.mm
@@ -0,0 +1,37 @@
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-pch -o %t.arc.pch %S/Inputs/typed-keypath-dependent-types.h
+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -include-pch %t.arc.pch -DDEPENDENT_TYPES_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-pch -o %t.mrc.pch %S/Inputs/typed-keypath-dependent-types.h
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -include-pch %t.mrc.pch -DDEPENDENT_TYPES_PCH -fsyntax-only -verify %s
+// expected-no-diagnostics
+#ifndef DEPENDENT_TYPES_PCH
+#include "Inputs/typed-keypath-dependent-types.h"
+#endif
+void use_dependent_types(DependentTypeRoot *root) {
+  auto write = make_typed_path<DependentTypeRoot *>();
+  auto read = KeyPathAsReadOnly(write);
+  static_assert(__is_same(decltype(write), DependentWrite<DependentTypeRoot *, int>));
+  static_assert(__is_same(decltype(read), DependentRead<DependentTypeRoot *, int>));
+  static_assert(__is_same(decltype(read_typed_path(read, root)), int));
+  static_assert(__is_same(decltype(typed_path_kind(write)), long));
+  static_assert(__is_same(decltype(typed_path_kind(read)), int));
+  static_assert(DependentPathTraits<decltype(write)>::writable);
+  static_assert(!DependentPathTraits<decltype(read)>::writable);
+  static_assert(__is_same(typename DependentPathTraits<decltype(write)>::value, int));
+  write_typed_path(write, root, 17);
+  (void)read_typed_path(write, root); // deduction through the readonly view
+  (void)read_typed_path(narrow_typed_path(write), root);
+  DependentPathHolder<DependentTypeRoot *, int> holder{read, write};
+  holder.set(root, holder.get(root));
+  auto pair = @keypath(DependentTypeRoot, pair);
+  DependentTypePair value = {7, 9};
+  write_typed_path(pair, root, value);
+  static_assert(__is_same(decltype(read_typed_path(KeyPathAsReadOnly(pair), root)), DependentTypePair));
+  (void)typed_path_pack(write, write);
+  (void)typed_read_ref(write);
+  (void)typed_read_ref(read);
+  (void)typed_read_mutable_ref(read);
+}
diff --git a/clang/test/ObjC3/Sema/native-cf-isolation-errors.m b/clang/test/ObjC3/Sema/native-cf-isolation-errors.m
