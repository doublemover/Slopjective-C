+void conditional_work_values(BlockCaptureSafe *safe, int choose) {
+  (void)alias_spawn(choose ? ^void(void) __objc3_async_frame {(void)safe;}
+                          : ^void(void) __objc3_async_frame {});
+  AliasAsyncWork const first = ^void(void) __objc3_async_frame {(void)safe;};
+  AliasAsyncWork const second = ^void(void) __objc3_async_frame {};
+  AliasAsyncWork const choice = choose ? first : second;
+  AliasAsyncWork const diamond = choose ? choice : choice;
+  (void)alias_detach(diamond);
+  (void)alias_spawn((choose++, first));
+  (void)alias_spawn(({choose++; ^void(void) __objc3_async_frame {};}));
+  AliasAsyncWork mutable_work = second;
+  (void)alias_spawn(mutable_work = first);
+  (void)alias_spawn(choose ? first : (AliasAsyncWork)0);
+  (void)alias_spawn(first ?: second);
+}
