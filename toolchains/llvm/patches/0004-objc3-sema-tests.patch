+  const char *(*read)(void) = target_get_global;
+  if (choose) read = target_get_literal;
+  const char *value = read();
+  (void)binding_detached(^void(void) __objc3_async_frame { (void)value; });
+}
+#ifdef __cplusplus
+static const char *target_other_cell = "static";
+static inline const char *&target_get_global_cell(void) { return global_projection_pointer; }
+static inline const char *&target_get_other_cell(void) { return target_other_cell; }
+struct CallableTargetSet {
+  void store_first(const char *&slot, const char *value) const { slot = value; }
+  void store_other(const char *&slot, const char *value) const { (void)value; slot = "static"; }
+  const char *&first_cell() const { return global_projection_pointer; }
+  const char *&other_cell() const { return target_other_cell; }
+  int value(const int &value) const { return value; }
+  int observation(const int &value) const { return value != 0; }
+};
+static inline void member_target_set_safe(int choose) {
+  CallableTargetSet receiver;
+  auto const target = choose ? &CallableTargetSet::store_first : &CallableTargetSet::store_other;
+  const char *slot = "static";
+  (receiver.*target)(slot, "safe");
+  const char *value = slot;
+  (void)binding_detached(^void(void) __objc3_async_frame { (void)value; });
+}
+#endif
+#endif
+#endif
