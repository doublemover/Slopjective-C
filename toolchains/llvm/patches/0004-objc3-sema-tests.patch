+
+// C23 treats an empty parameter list as a prototype even without an effect.
+void ordinary_empty_list();
+void ordinary_empty_list(void);
+
+// The effect suffix remains a prototype-bearing declarator in C23.
+void effect_throws() __objc3_throws(Error);
+void effect_async() __objc3_async;
+
+// In C23 both empty-list declarations are prototypes, but effect identity
