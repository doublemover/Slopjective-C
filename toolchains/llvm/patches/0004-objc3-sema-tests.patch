+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+typedef void *NativeObject __attribute__((NSObject));
+template<class T> struct Payload {
+  using Stored=T;
+  union Storage {
+    char empty;
+    Stored value;
+    Storage():empty(){}
+    ~Storage(){}
+  } storage;
+};
+template<class T> struct PointerBox:Payload<T> {
+  PointerBox()=default;
+  PointerBox(const PointerBox&)=default;
+  PointerBox(PointerBox&&)=default;
+};
+static_assert(!__is_constructible(PointerBox<NativeObject>,const PointerBox<NativeObject>&));
+using BorrowedObject=__unsafe_unretained NativeObject;
+static_assert(__is_constructible(PointerBox<BorrowedObject>,const PointerBox<BorrowedObject>&));
+void use_storage() {PointerBox<NativeObject> owning;PointerBox<BorrowedObject> borrowed;}
