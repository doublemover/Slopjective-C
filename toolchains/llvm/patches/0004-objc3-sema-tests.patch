@@ -0,0 +1,13 @@
+#ifndef OBJC3_MEMORY_ALIAS_INPUTS_H
+#define OBJC3_MEMORY_ALIAS_INPUTS_H
+typedef borrowed const char *MemoryBytes;
+MemoryBytes memory_bytes(void *owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void memory_use(const char *pointer __attribute__((noescape)));
+void memory_escape(const char *pointer);
+void memory_escape_address(void *pointer);
+void memory_consume(void *owner __attribute__((cf_consumed)));
+struct MemoryHolder { const char *pointer; };
+struct MemoryPair { struct MemoryHolder first, second; };
+struct MemoryAlias { const char **cursor; };
+struct MemoryCallback { void (^__unsafe_unretained work)(void); };
+#endif
