+ int value;
+ int &operator*(){return value;}
+ int *operator&(){return &value;}
+ int operator()()const{return value;}
+ bool operator!()const{return value==0;}
+};
+void operator_field_cleanup(OperatorField *);
+static inline void operator_field_observations() {
+ OperatorField local{42};*local=43;int *const address=&local;*address=44;
+ (void)binding_detached(binding_make_scalar(local()));
+ OperatorField cleaned __attribute__((cleanup(operator_field_cleanup)))={42};
+ bool empty=!cleaned;(void)binding_detached(binding_make_scalar(empty));
+}
+struct OperatorResourceView {
+ const char *value;
+ const char *operator()()const{return value;}
+ bool operator!()const{return value==0;}
+};
+static inline void operator_observations(OperatorLoanFields &source) {
+ bool empty=!source;int number=source.number();bool compared=source.compared();
+ (void)binding_detached(^void(void) __objc3_async_frame {(void)empty;(void)number;(void)compared;});
