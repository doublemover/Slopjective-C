@@ -0,0 +1,36 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -Wno-nullability-completeness -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -Wno-nullability-completeness -verify=strict %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=compatibility -fsyntax-only -Wno-nullability-completeness -verify=compat %s
+// compat-no-diagnostics
+__attribute__((objc_root_class)) @interface Receiver
+- (void)ping;
+- (void)self_proof;
+@end
+void unknown_receiver(Receiver *value) {
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}}
+}
+void unspecified_receiver(Receiver * _Null_unspecified value) {
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}}
+  guard value != (id)0 else { return; }
+  [value ping];
+  value = (id)0;
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}}
+}
+void known_receiver(Receiver * _Nonnull value) { [value ping]; }
+void refined_receiver(Receiver *value) {
+  guard let proved = value else { return; }
+  [proved ping];
+  [value ping];
+}
+void literal_receiver(void) {
+  id value = @"nonnull";
+  [value ping];
+}
+@implementation Receiver
+- (void)ping {}
+- (void)self_proof {
+  [self ping];
+  self = (id)0;
+  [self ping]; // strict-error {{ordinary message send requires a nonnull receiver}}
+}
+@end
diff --git a/clang/test/ObjC3/Sema/cleanup-ownership.m b/clang/test/ObjC3/Sema/cleanup-ownership.m
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/cleanup-ownership.m
@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+void close_value(int);
+void close_address(int *);
+void wrong_address(long *);
+void no_parameters(void);
+@protocol Error @end
+void checked_close(int) throws(id<Error>);
+void async_close(int) __objc3_async;
+struct Record { int member; };
+void copy_record(struct Record);
+void valid(void) {
+  @cleanup(close_value) const int immutable = 0;
+  @cleanup(close_address) int addressed = 1;
+  int canonical __attribute__((cleanup(close_value))) = 2;
+  canonical = 3;
+}
+@cleanup(close_value) int global = 1; // expected-error {{only applies to local variables}}
+void static_storage(void) {
+  @cleanup(close_value) static int value = 1; // expected-error {{only applies to local variables}}
+}
+void bad_callback(void) {
+  @cleanup(wrong_address) int wrong = 1; // expected-error {{cannot accept the value}}
+  @cleanup(no_parameters) int arity = 1; // expected-error {{must name a nondependent function with one parameter}}
+  @cleanup(checked_close) int checked = 1; // expected-error {{cannot be async or use checked throws}}
+  @cleanup(async_close) int async_value = 1; // expected-error {{cannot be async or use checked throws}}
+  @cleanup(copy_record) struct Record copied = {}; // expected-error {{cannot accept the value}}
+}
+void duplicate_owner(void) {
+  @cleanup(close_value) int value __attribute__((cleanup(close_address))) = 1; // expected-error {{may have only one cleanup owner}}
+}
+void competing_owner(void) {
+  @cleanup(close_value) int value __attribute__((objc_resource(close=close_value, invalid=0))) = 1; // expected-error {{objc_resource and cleanup cannot own the same variable}}
+}
+void jump_into_cleanup(void) {
+  goto after; // expected-error {{cannot jump from this goto statement to its label}}
+  @cleanup(close_value) int value = 1; // expected-note {{jump bypasses initialization}}
+after:;
+}
+#ifdef __cplusplus
+void converted_reference(const double &);
+void temporary_argument(void) {
+  @cleanup(converted_reference) int value = 1;
+}
+template<class T> void dependent_storage(void) {
+  @cleanup(close_value) T value = {};
+}
+#else
+void variable_storage(int size) {
+  @cleanup(close_address) int values[size]; // expected-error {{requires complete nondependent fixed-size storage}}
+}
+#endif

diff --git a/clang/test/ObjC3/Sema/cleanup-nonlocal-jumps.m b/clang/test/ObjC3/Sema/cleanup-nonlocal-jumps.m
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/cleanup-nonlocal-jumps.m
@@ -0,0 +1,117 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc3-profile=compatibility -fsyntax-only -verify=compat %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc3-profile=strict-concurrency -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fno-builtin -fblocks -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -DTEST_LIBC_JUMPS -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc3-profile=compatibility -fsyntax-only -verify=compat %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -DTEST_LIBC_JUMPS -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -verify=strict %s
+// compat-no-diagnostics
+void close_value(int) __attribute__((nothrow));
+void escape_buffer(void **);
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sigsetjmp(void **, int) __attribute__((returns_twice));
+void siglongjmp(void **, int) __attribute__((noreturn));
+#ifdef __cplusplus
+}
+#endif
+// Use actual SJLJ builtins where supported and libc entry points on AArch64.
+#ifdef TEST_LIBC_JUMPS
+#define TEST_SETJMP(target) sigsetjmp(target, 0)
+#define TEST_LONGJMP siglongjmp
+#else
+#define TEST_SETJMP __builtin_setjmp
+#define TEST_LONGJMP __builtin_longjmp
+#endif
+void skips_defer(void **target) {
+  defer { close_value(1); } // strict-note {{scope-exit action registered here}}
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void skips_cleanup(void **target) {
+  @cleanup(close_value) int value = 1; // strict-note {{scope-exit action registered here}}
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void skips_resource(void **target) {
+  @resource(close_value, invalid: 0) int value = 1; // strict-note {{scope-exit action registered here}}
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void signal_jump(void **target) {
+  @cleanup(close_value) int value = 1; // strict-note {{scope-exit action registered here}}
+  siglongjmp(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void before_registration(void **target) {
+  TEST_LONGJMP(target, 1);
+  @cleanup(close_value) int value = 1;
+}
+void initializer_not_yet_registered(void **target) {
+  int value __attribute__((cleanup(close_value))) = (TEST_LONGJMP(target, 1), 1);
+}
+void after_inner_scope(void **target) {
+  { @cleanup(close_value) int value = 1; }
+  TEST_LONGJMP(target, 1);
+}
+void local_preserves_actions(void) {
+  void *target[5];
+  @cleanup(close_value) int value = 1;
+  defer { close_value(2); }
+  if(TEST_SETJMP(target) == 0) TEST_LONGJMP(target, 1);
+}
+void local_skips_new_action(void) {
+  void *target[5];
+  (void)TEST_SETJMP(target);
+  @cleanup(close_value) int value = 1; // strict-note {{scope-exit action registered here}}
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void escaped_target(void) {
+  void *target[5];
+  @cleanup(close_value) int value = 1; // strict-note {{scope-exit action registered here}}
+  (void)TEST_SETJMP(target);
+  escape_buffer(target);
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void loop_initializer(void **target) {
+  for(int value __attribute__((cleanup(close_value))) = 1;;) { // strict-note {{scope-exit action registered here}}
+    TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+  }
+}
+void before_nested_callable_runs(void **target) {
+  void (^body)(void) = ^{ @cleanup(close_value) int nested = 1; };
+  (void)body;
+  TEST_LONGJMP(target, 1);
+}
+#ifdef __cplusplus
+void condition_initializer(void **target) {
+  if(int value __attribute__((cleanup(close_value))) = 1) { // strict-note {{scope-exit action registered here}}
+    TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+  }
+}
+namespace user {
+void longjmp(void **, int);
+void ordinary_name(void **target) {
+  @cleanup(close_value) int value = 1;
+  longjmp(target, 1);
+}
+}
+#endif
+
+void skips_precise_owner(id owner, void **target) {
+  keepAlive(owner); // strict-note {{scope-exit action registered here}}
+  TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+}
+void skips_bounded_owner(id owner, void **target) {
+  withLifetime(owner) { // strict-note {{scope-exit action registered here}}
+    TEST_LONGJMP(target, 1); // strict-error {{non-local jump may bypass a registered cleanup action}}
+  }
+}
+void completed_precise_owner(id owner, void **target) {
+  { keepAlive(owner); }
+  withLifetime(owner) {}
+  TEST_LONGJMP(target, 1);
+}
+void local_preserves_precise_owner(id owner) {
+  void *target[5];
+  keepAlive(owner);
+  if (TEST_SETJMP(target) == 0) TEST_LONGJMP(target, 1);
+}
diff --git a/clang/test/ObjC3/Sema/resource-type-contracts.m b/clang/test/ObjC3/Sema/resource-type-contracts.m
new file mode 100644
index 000000000..79ab42fb6
--- /dev/null
+++ b/clang/test/ObjC3/Sema/resource-type-contracts.m
@@ -0,0 +1,140 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fexceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=compatibility -fsyntax-only -verify=common %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fexceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+void close_fd(int) __attribute__((nothrow));
+void close_stream(int) __attribute__((nothrow));
+void close_address(int *) __attribute__((nothrow));
+void close_alternate(int) __attribute__((nothrow));
+void observe_handle(int) __attribute__((nothrow));
+void possibly_throw(void);
+@requires_cleanup(close_fd) @resource_family(Descriptors) @invalid(-1) typedef int FD;
+typedef int Stream __attribute__((objc_requires_cleanup(close_stream), objc_resource_family(Streams), objc_invalid(0)));
+@requires_cleanup(close_alternate) @resource_family(Descriptors) @invalid(-1) typedef int AlternateFD;
+@requires_cleanup(close_address) @invalid(0) typedef int AddressHandle;
+typedef FD FDAlias;
+FD open_fd(void) __attribute__((nothrow));
+Stream open_stream(void) __attribute__((nothrow));
+AddressHandle open_address(void) __attribute__((nothrow));
+void manual_cleanup(void) {
+  FDAlias value = open_fd();
+  close_fd(value);
+}
+void guarded_cleanup(void) {
+  FD value = open_fd();
+  if(value != -1)close_fd(value);
+}
+void address_cleanup(void) {
+  AddressHandle value = open_address();
+  close_address(&value);
+}
+void automatic_cleanup(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+}
+void deferred_cleanup(void) {
+  FD value = open_fd();
+  defer { close_fd(value); }
+}
+void same_family_cleanup(void) {
+  FD value = open_fd();
+  close_alternate(value);
+}
+FD transfer_return(void) {
+  FD value = open_fd();
+  return value;
+}
+FD registered_transfer(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  return take(value);
+}
+FD direct_transfer(void) { return open_fd(); }
+void forgotten(void) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+}
+void conditional_leak(int condition) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+  if(condition)close_fd(value);
+}
+void native_exception_leak(void) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+  possibly_throw();
+  close_fd(value);
+}
+void repeated_cleanup(void) {
+  FD value = open_fd();
+  close_fd(value);
+  close_fd(value); // strict-error {{may already be closed, moved, or invalid}}
+}
+void manual_close_does_not_invalidate(void) {
+  FD value = open_fd();
+  close_fd(value);
+  if(value != -1)observe_handle(value); // strict-error {{may have been moved or discarded}}
+}
+void wrong_family(void) {
+  FD value = open_fd();
+  close_stream(value); // strict-error {{not associated with its type contract or family}}
+}
+void wrong_family_temporary(void) {
+  close_stream(open_fd()); // strict-error {{not associated with the acquired resource's family}}
+}
+void wrong_automatic_cleanup(void) {
+  @resource(close_stream, invalid: -1) FD value = open_fd(); // strict-error {{not associated with its type contract or family}}
+}
+void wrong_reset_family(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  reset(value, open_stream()); // strict-error {{reset of resource 'value' mixes incompatible cleanup families}}
+}
+void throwing_close(int);
+@requires_cleanup(throwing_close) @invalid(-1) typedef int ThrowingHandle;
+ThrowingHandle direct_disarmed_transfer(void) {
+  @resource(throwing_close, invalid: -1) ThrowingHandle value = 3;
+  return take(value);
+}
+void wrong_sentinel(void) {
+  @resource(close_fd, invalid: 0) FD value = open_fd(); // strict-error {{sentinel different from its typedef contract}}
+}
+void dropped_acquisition(void) {
+  open_fd(); // strict-error {{discarding a value with requires_cleanup loses ownership}}
+}
+void erased_local(void) {
+  int value = open_fd(); // strict-error {{erases its cleanup contract}}
+  observe_handle(value);
+}
+int erased_return(void) { return open_fd(); } // strict-error {{returning an acquired resource erases or changes its cleanup family}}
+FD unsafe_registered_return(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  return value; // strict-error {{returning registered resource}}
+}
+FD throwing_return_cleanup(void) {
+  FD value = open_fd();
+  defer { possibly_throw(); }
+  return value; // strict-error {{owned resource return has no rollback model}}
+}
+FD empty_throwing_return_cleanup(void) {
+  defer { possibly_throw(); }
+  return -1;
+}
+void loop_leak(int skip) {
+  for(int index = 0; index != 2; ++index) {
+    FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+    if(skip)continue;
+    close_fd(value);
+  }
+}
+void loop_cleanup(void) {
+  for(int index = 0; index != 2; ++index) {
+    FD value = open_fd();
+    close_fd(value);
+  }
+}
+// Contradictory contracts are ill-formed in every profile.
+@invalid(0) typedef FD BadSentinel; // common-error {{cannot change its inherited invalid sentinel}}
+@resource_family(Streams) typedef FD BadFamily; // common-error {{cannot change its inherited resource family}}
+@requires_cleanup(close_stream) typedef FD BadCleanup; // common-error {{cannot change its inherited cleanup function}}
+@requires_cleanup(close_fd) typedef float BadStorage; // common-error {{require a nondependent ordinary integer, enum, or pointer handle}}
+int runtime_sentinel(void);
+@invalid(runtime_sentinel()) typedef int NonConstant; // common-error {{invalid sentinel must be constant}}
+#ifdef __cplusplus
+using UsingFD = FD;
+UsingFD alias_return(void) { UsingFD value = open_fd(); return value; }
+#endif
diff --git a/clang/test/ObjC3/Sema/lifetime-control.m b/clang/test/ObjC3/Sema/lifetime-control.m
new file mode 100644
index 000000000..53d505ba1
--- /dev/null
+++ b/clang/test/ObjC3/Sema/lifetime-control.m
@@ -0,0 +1,42 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+id produce(void);
+void use(id);
+void valid(id owner, void (^block)(void), int enabled) {
+  keepAlive(owner);
+  withLifetime(produce()) { use(owner); }
+  withLifetime(block) block();
+  if (enabled) keepAlive(owner); else use(owner);
+  for (int n = 0; n != 2; ++n) withLifetime(produce()) {
+    if (enabled) continue;
+    break;
+  }
+  withLifetime((produce(), owner)) { keepAlive(produce()); }
+}
+void invalid(int number, void *pointer) {
+  keepAlive(number); // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+  withLifetime(pointer) {} // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+  keepAlive(use((id)0)); // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+}
+void bypass(id owner) {
+  goto after; // expected-error {{cannot jump from this goto statement to its label}}
+  keepAlive(owner); // expected-note {{jump bypasses initialization of a precise lifetime binding}}
+ after:;
+}
+void enter_body(id owner) {
+  goto inside; // expected-error {{cannot jump from this goto statement to its label}}
+  withLifetime(owner) { // expected-note {{jump bypasses initialization of a precise lifetime binding}}
+   inside: use(owner);
+  }
+}
+void unbraced_siblings(id owner, int enabled) {
+  if (enabled) keepAlive(owner); else { goto done; done:; }
+}
+#ifdef __cplusplus
+template <class T> void dependent(T value) {
+  withLifetime(value) { keepAlive(value); }
+}
+template void dependent<id>(id);
+#endif
diff --git a/clang/test/ObjC3/Sema/native-c-async-definitions.m b/clang/test/ObjC3/Sema/native-c-async-definitions.m
new file mode 100644
index 000000000..933ab9414
--- /dev/null
+++ b/clang/test/ObjC3/Sema/native-c-async-definitions.m
@@ -0,0 +1,31 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc3-strict-concurrency -Wobjc3-unnecessary-await -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-c-async-frame.h"
+int leaf(int value) __objc3_async { return value; }
+int sync(void) { return 0; }
+int identity(void) __objc3_async {
+  return __objc3_await sync(); // expected-warning {{native await operand does not suspend}}
+}
+int parent(int value) __objc3_async { return __objc3_await leaf(value); }
+void outside(void) {
+  __objc3_await leaf(1); // expected-error {{native await requires an async Objective-C or Objective-C++20/23 function context}}
+}
+int vla(int count) __objc3_async {
+  int values[count];
+  return __objc3_await leaf(values[0]);
+}
+int dynamic(int count) __objc3_async {
+  void *p = __builtin_alloca(count);
+  return __objc3_await leaf(p != 0);
+}
+int invalid_defer(void) __objc3_async {
+  __objc3_defer { __objc3_await leaf(1); } // expected-error {{cannot suspend from a defer statement}}
+  return 0;
+}
+
+int nested_unhandled(void) __objc3_async {
+  return __objc3_await (leaf(1), sync()); // expected-error {{native C await requires a direct async call or a provably non-suspending operand}}
+}
+int harmless_defer(void) __objc3_async {
+  __objc3_defer { (void)__objc3_await sync(); } // expected-warning {{native await operand does not suspend}}
+  return 0;
+}
diff --git a/clang/test/ObjC3/Sema/resource-capture-flow.m b/clang/test/ObjC3/Sema/resource-capture-flow.m
