+#ifndef BORROWED_STATIC_RESULTS_H
+#define BORROWED_STATIC_RESULTS_H
+typedef borrowed const char *StaticBytes;
+#define STATIC_RESULT __attribute__((objc_returns_borrowed(owner_index=0)))
+static const char static_bytes[]="permanent";
+static const char other_bytes[]="other";
+extern const char external_bytes[];
+static const char *const static_alias=static_bytes;
+static const char *mutable_alias=static_bytes;
+static char mutable_bytes[]="mutable";
+#ifdef __cplusplus
+#define STATIC_TLS thread_local
+#else
+#define STATIC_TLS _Thread_local
+#endif
+static STATIC_TLS const char tls_bytes[]="thread";
+struct StaticRecord {char bytes[8];};
+static const struct StaticRecord static_record={{'s','t','a','t','i','c',0}};
+union StaticUnion {char bytes[8];long other;};
+static const union StaticUnion static_union={{'u',0}};
+static const char *static_plain_source(void){return static_union.bytes;}
+static const char *static_plain_choice(int choose){return choose?static_bytes:other_bytes;}
+static const char *static_plain_offset(int offset){return static_plain_source()+offset;}
+static const char *static_plain_unknown(const char *value){return value;}
+static const char *static_plain_tls(void){return tls_bytes;}
+static const char *static_plain_mutable(void){return mutable_bytes;}
+static const char *static_plain_recursive(void){return static_plain_recursive();}
+static const char *static_plain_statements(void){const char *value=static_bytes;return value;}
+const char *static_external_body(void){return static_bytes;}
+inline const char *static_external_inline(void){return external_bytes;}
+static const char *static_weak_source(void) __attribute__((weakref("static_external_body")));
+const char *static_external_source(void);
+#ifdef __cplusplus
+static const char *const unknown_alias=static_external_source();
+#else
+extern const char *const unknown_alias;
+#endif
+#ifdef __cplusplus
+__attribute__((weak)) inline const char *static_inline_weak_source(){return external_bytes;}
+struct StaticSummaryMethods {
+ static const char *source(){return static_bytes;}
+ virtual const char *view(){return static_bytes;}
+};
+constexpr const char *static_constexpr_source(){return static_bytes;}
+struct StaticConstexprRecord {
+  char bytes[8];constexpr const char *data() const {return bytes;}
+};
+static constexpr StaticConstexprRecord static_constexpr_record={{'c','x','x',0}};
+constexpr const char *static_constexpr_member(){return static_constexpr_record.data();}
+template<int Offset> constexpr const char *static_constexpr_offset(){return static_bytes+Offset;}
+struct StaticMutableRecord {mutable char bytes[8];};
+static const StaticMutableRecord static_mutable_record={{'m',0}};
+struct StaticDestroyedRecord {char bytes[8];~StaticDestroyedRecord(){}};
+static const StaticDestroyedRecord static_destroyed_record={{'d',0}};
+#else
+// C file-scope const compound literals have permanent immutable storage.
+static const char *const compound_alias=(const char[]){'c','o','m','p',0};
