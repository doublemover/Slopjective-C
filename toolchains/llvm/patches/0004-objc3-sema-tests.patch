diff --git a/clang/test/ObjC3/Sema/carrier-standard-expressions.c b/clang/test/ObjC3/Sema/carrier-standard-expressions.c
new file mode 100644
index 000000000..1517b50e6
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-standard-expressions.c
@@ -0,0 +1,29 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c23 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(int) OptionalIntAlias;
+typedef __objc3_result(int, long) IntLongResult;
+typedef __objc3_result(int, long) IntLongResultAlias;
+
+_Static_assert(__builtin_types_compatible_p(__typeof__(__objc3_some(int, 0)),
+                                            OptionalInt),
+               "typeof preserves the canonical Optional result type");
+_Static_assert(__builtin_types_compatible_p(
+                   __typeof__(__objc3_ok(int, long, 0)), IntLongResult),
+               "typeof preserves the ordered Result arms");
+
+_Static_assert(_Generic(__objc3_some(int, 0), OptionalIntAlias: 1, default: 0),
+               "_Generic matches a carrier through a payload alias");
+_Static_assert(_Generic(__objc3_ok(int, long, 0), IntLongResultAlias: 1,
+                        default: 0),
+               "_Generic matches the exact ordered Result carrier");
+
+OptionalInt choose_optional(_Bool choose, int value) {
+  return choose ? __objc3_some(int, value) : __objc3_none(int);
+}
+IntLongResult choose_result(_Bool choose, int value, long error) {
+  return choose ? __objc3_ok(int, long, value)
+                : __objc3_err(int, long, error);
+}
diff --git a/clang/test/ObjC3/Sema/carrier-standard-expressions.mm b/clang/test/ObjC3/Sema/carrier-standard-expressions.mm
new file mode 100644
index 000000000..1ec430e2a
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-standard-expressions.mm
@@ -0,0 +1,34 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+using OptionalInt = __objc3_optional(int);
+using OptionalIntAlias = __objc3_optional(int);
+using IntLongResult = __objc3_result(int, long);
+using LongIntResult = __objc3_result(long, int);
+
+int nonthrowing_value() noexcept;
+int potentially_throwing_value();
+
+static_assert(__is_same(decltype(__objc3_some(int, 0)), OptionalInt));
+static_assert(__is_same(decltype(__objc3_ok(int, long, 0)), IntLongResult));
+static_assert(!__is_same(IntLongResult, LongIntResult));
+static_assert(noexcept(__objc3_none(int)));
+static_assert(noexcept(__objc3_some(int, nonthrowing_value())));
+static_assert(!noexcept(__objc3_some(int, potentially_throwing_value())));
+static_assert(noexcept(__objc3_has_value(__objc3_none(int))));
+static_assert(noexcept(__objc3_is_ok(__objc3_ok(int, long, 0))));
+static_assert(noexcept(__objc3_ok(int, long, nonthrowing_value())));
+static_assert(!noexcept(__objc3_err(int, long, potentially_throwing_value())));
+
+static_assert(__is_same(decltype(false ? __objc3_some(int, 0)
+                                      : __objc3_none(int)),
+                        OptionalIntAlias));
+static_assert(__is_same(decltype(false ? __objc3_ok(int, long, 0)
+                                      : __objc3_err(int, long, 0L)),
+                        IntLongResult));
+
+template <class T> using Optional = __objc3_optional(T);
+template <class T> auto select_optional(bool choose, T value) {
+  return choose ? __objc3_some(T, value) : __objc3_none(T);
+}
+static_assert(__is_same(decltype(select_optional(true, 0)), Optional<int>));
diff --git a/clang/test/ObjC3/Sema/carrier-template-deduction.mm b/clang/test/ObjC3/Sema/carrier-template-deduction.mm
