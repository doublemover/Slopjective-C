+}
+- (int)unknownAlias:(ReceiverActor *_Nonnull)other {
+ ReceiverActor *_Nonnull const alias=other;
+ return [alias read]; // expected-error {{cross-actor entry requires an explicit await}}
+}
+- (int)unsafeAlias {
