+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify -verify-ignore-unexpected=note %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify -verify-ignore-unexpected=note %s
+#include "Inputs/typed-keypath-dependent-types.h"
+template<class Value> using InvalidKnownRoot = KeyPath<int, Value>; // expected-error {{key-path root must name a concrete Objective-C class}}
+template<class Root> using InvalidKnownValue = KeyPath<Root, void>; // expected-error {{key-path value must be a complete nondependent native}}
+template<class Root> struct InvalidRootInstantiation {
+  KeyPath<Root, int> path; // expected-error {{key-path root must name a concrete Objective-C class}}
+};
+template<class Value> struct InvalidValueInstantiation {
+  KeyPath<DependentTypeRoot *, Value> path; // expected-error {{key-path value must be a complete nondependent native}}
+};
+InvalidRootInstantiation<int> invalid_root;
+InvalidValueInstantiation<void> invalid_value;
+void reject_type_deduction(DependentTypeRoot *root) {
+  auto write = make_typed_path<DependentTypeRoot *>();
+  auto read = KeyPathAsReadOnly(write);
+  typed_read_mutable_ref(write); // expected-error {{no matching function for call to 'typed_read_mutable_ref'}}
+  typed_read_pointer(&write); // expected-error {{no matching function for call to 'typed_read_pointer'}}
+  write_typed_path(read, root, 17); // expected-error {{no matching function for call to 'write_typed_path'}}
+  write_typed_path(write, root, 17L); // expected-error {{no matching function for call to 'write_typed_path'}}
+}
