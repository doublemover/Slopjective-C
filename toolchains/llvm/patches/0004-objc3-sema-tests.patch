@@ -0,0 +1,65 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+void close_handle(int);
+int close_status(int);
+void close_address(int *);
+void close_pointer(void *);
+void close_pointer_address(void **);
+void wrong_close(long *);
+void cleanup_handle(int *);
+int sentinel(void);
+void valid(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=-1))) = 1;
+  int addressed __attribute__((objc_resource(close=close_address, invalid=0))) = 2;
+  int status __attribute__((objc_resource(close=close_status, invalid=0))) = 3;
+  void *pointer __attribute__((objc_resource(close=close_pointer, invalid=0))) = 0;
+  void *pointer_address __attribute__((objc_resource(close=close_pointer_address, invalid=0))) = 0;
+  volatile int qualified __attribute__((objc_resource(close=close_status, invalid=0))) = 4;
+}
+int global __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{only applies to local variables}}
+struct ResourceField {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))); // expected-error {{only applies to local variables}}
+};
+void invalid_handles(void) {
+  const int immutable __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+  float floating __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+  id managed __attribute__((objc_resource(close=close_pointer, invalid=0))) = (id)0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+}
+typedef void *RetainableHandle __attribute__((NSObject));
+void close_retainable(RetainableHandle);
+void retainable_family_is_not_a_scalar_resource(void) {
+  RetainableHandle value __attribute__((objc_resource(close=close_retainable, invalid=0))) = 0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+#if __has_feature(objc_arc)
+  __weak RetainableHandle weak_value __attribute__((objc_resource(close=close_retainable, invalid=0))) = 0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+#endif
+}
+void incompatible_close(void) {
+  int value __attribute__((objc_resource(close=wrong_close, invalid=0))) = 1; // expected-error {{cannot accept the handle value or its address}}
+}
+void runtime_sentinel(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=sentinel()))) = 1; // expected-error {{invalid sentinel must be constant}}
+}
+void needs_initializer(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))); // expected-error {{requires an initializer}}
+}
+void duplicate_resource(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0), objc_resource(close=close_handle, invalid=-1))) = 1; // expected-error {{may have only one objc_resource attribute}}
+}
+void jump_into_resource(void) {
+  goto after; // expected-error {{cannot jump from this goto statement to its label}}
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-note {{jump bypasses initialization of a variable with objc_resource}}
+after:;
+}
+void switch_into_resource(int choice) {
+  switch(choice) {
+  case 0:;
+    int value __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-note {{jump bypasses initialization of a variable with objc_resource}}
+  case 1:; // expected-error {{cannot jump from switch statement to this case label}}
+  }
+}
+#ifdef __cplusplus
+template<class T> void dependent_handle(void) {
+  T value __attribute__((objc_resource(close=close_handle, invalid=0))) = {};
+}
+#endif
diff --git a/clang/test/ObjC3/Sema/carrier-source-records.mm b/clang/test/ObjC3/Sema/carrier-source-records.mm
new file mode 100644
index 000000000..2f2e8ac82
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-source-records.mm
@@ -0,0 +1,80 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+struct Leaf {
+  explicit Leaf(int);
+  Leaf(const Leaf &);
+  Leaf(Leaf &&) noexcept;
+  ~Leaf() noexcept;
+};
+using Inner = __objc3_optional(Leaf);
+using Outer = __objc3_optional(Inner);
+using Field = __objc3_result(Outer, Inner);
+
+struct Owner {
+  Field field;
+  Inner second;
+  Owner(int value)
+      : field(__objc3_ok(Outer, Inner,
+                         __objc3_some(Inner, __objc3_some(Leaf, Leaf(value))))),
+        second(__objc3_none(Leaf)) {}
+};
+static_assert(__is_constructible(Owner, const Owner &));
+static_assert(__is_constructible(Owner, Owner &&));
+static_assert(!__is_constructible(Owner));
+static_assert(!__is_trivially_copyable(Owner));
+static_assert(!__is_trivially_constructible(Owner, const Owner &));
+static_assert(!__is_trivially_constructible(Owner, Owner &&));
+static_assert(!__is_trivially_destructible(Owner));
+static_assert(!__is_nothrow_constructible(Owner, const Owner &));
+static_assert(__is_nothrow_constructible(Owner, Owner &&));
+static_assert(__is_nothrow_destructible(Owner));
+static_assert(!__is_assignable(Owner &, const Owner &));
+static_assert(!__is_assignable(Owner &, Owner &&));
+
+struct Initialized {
+  Inner field = __objc3_none(Leaf);
+};
+struct Aggregate { Inner first, second; };
+static_assert(__is_constructible(Initialized));
+static_assert(!__is_constructible(Aggregate));
+void field_initializers(Inner &source) {
+  Aggregate first{__objc3_some(Leaf, Leaf(1)), __objc3_none(Leaf)};
+  Aggregate copied{source, first.first};
+  Aggregate moved{static_cast<Inner &&>(source), __objc3_none(Leaf)};
+  Initialized initialized;
+}
+
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete;
+  MoveOnly(MoveOnly &&) noexcept;
+  ~MoveOnly();
+};
+struct MoveOwner { __objc3_optional(MoveOnly) field; };
+static_assert(!__is_constructible(MoveOwner, const MoveOwner &));
+static_assert(__is_constructible(MoveOwner, MoveOwner &&));
+
+struct NonConstCopy {
+  NonConstCopy(NonConstCopy &);
+  ~NonConstCopy();
+};
+struct NonConstOwner { __objc3_optional(NonConstCopy) field; };
+static_assert(__is_constructible(NonConstOwner, NonConstOwner &));
+static_assert(!__is_constructible(NonConstOwner, const NonConstOwner &));
+
+struct ThrowingDtor { ~ThrowingDtor() noexcept(false); };
+struct ThrowingOwner { __objc3_optional(ThrowingDtor) field; };
+static_assert(!__is_nothrow_destructible(ThrowingOwner));
+
+class PrivateDtor { ~PrivateDtor(); };
+struct PrivateOwner { __objc3_optional(PrivateDtor) field; };
+static_assert(!__is_destructible(PrivateOwner));
+static_assert(!__is_constructible(PrivateOwner, const PrivateOwner &));
+
+template <class T> struct GenericOwner {
+  __objc3_optional(T) field;
+};
+static_assert(__is_constructible(GenericOwner<Leaf>, const GenericOwner<Leaf> &));
+static_assert(!__is_constructible(GenericOwner<MoveOnly>,
+                                  const GenericOwner<MoveOnly> &));
diff --git a/clang/test/ObjC3/Sema/error-factory-contract.m b/clang/test/ObjC3/Sema/error-factory-contract.m
