+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system -fobjc-arc -fsyntax-only -verify=expected,cxx %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system -fobjc-arc -fsyntax-only -verify=expected,cxx %s
+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-closure-consumption.h -o %t-c.pch
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc3-profile=strict-system  -include-pch %t-c.pch -DFROM_PCH -fsyntax-only -verify=expected,c %s
+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-closure-consumption.h -o %t-c-arc.pch
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc3-profile=strict-system -fobjc-arc  -include-pch %t-c-arc.pch -DFROM_PCH -fsyntax-only -verify=expected,c %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-closure-consumption.h -o %t-cxx.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system  -include-pch %t-cxx.pch -DFROM_PCH -fsyntax-only -verify=expected,cxx %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system -fobjc-arc -emit-pch %S/Inputs/borrowed-closure-consumption.h -o %t-cxx-arc.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc3-profile=strict-system -fobjc-arc  -include-pch %t-cxx-arc.pch -DFROM_PCH -fsyntax-only -verify=expected,cxx %s
+#ifndef FROM_PCH
