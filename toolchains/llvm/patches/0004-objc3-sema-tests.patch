+#ifndef OBJC3_OPERATOR_FIELD_PROJECTIONS_H
+#define OBJC3_OPERATOR_FIELD_PROJECTIONS_H
+#include "native-borrowed-field-projections.h"
+#if defined(__cplusplus) && __OBJC3_PROFILE__ != 3
+struct OperatorLoanFields {
+ borrowed const char *loan;
+ int scalar;
+ const char *operator()()const{return loan;}
+ const char *operator*()const{return loan;}
+ const char *operator+()const{return loan;}
+ const char **operator&(){return &loan;}
+ bool operator!()const{return loan==0;}
+ const char *chained()const{return (*this)();}
+ __INTPTR_TYPE__ masked()const{return reinterpret_cast<__INTPTR_TYPE__>(loan)^1;}
+ __INTPTR_TYPE__ inverted()const{return ~reinterpret_cast<__INTPTR_TYPE__>(loan);}
+ int number()const{return scalar+1;}
+ bool compared()const{return reinterpret_cast<__INTPTR_TYPE__>(loan)>0;}
+};
+struct ArrayLoanFields {
+ borrowed const char *values[2];
+ int numbers[2];
+ const char *get()const{return values[1];}
+ const char *first()const{return *values;}
+ template<unsigned Index=1>const char *generic()const{return values[Index];}
+ const char *operator()()const{return values[0];}
+ bool present()const{return values[0]!=0;}
+ int number()const{return numbers[0];}
+};
+struct NestedArrayLoanFields {
+ ArrayLoanFields rows[2];
+ const char *get()const{return rows[1].values[0];}
+ int number()const{return rows[0].numbers[1];}
+};
