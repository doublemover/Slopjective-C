+// RUN: %clang_cc1 -std=c++23 -fexceptions -fcxx-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -x objective-c++ -Wthread-safety -Wthread-safety-beta -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fexceptions -fcxx-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -x objective-c++-header -emit-pch %S/Inputs/native-thread-safety.h -o %t-c++23-True.pch
+// RUN: %clang_cc1 -std=c++23 -fexceptions -fcxx-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fobjc-arc -x objective-c++ -include-pch %t-c++23-True.pch -DFROM_PCH -Wthread-safety -Wthread-safety-beta -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/native-thread-safety.h"
+#endif
+void thread_bad(ThreadSafety::Counter &counter){counter.bump();} // expected-warning {{requires holding mutex}}
+void thread_good(ThreadSafety::Counter &counter){ThreadSafety::Scope guard(counter.mutex);counter.bump();(void)counter.read();}
+void thread_try(ThreadSafety::Counter &counter){if(counter.mutex.try_lock()){counter.bump();counter.mutex.unlock();}}
+void thread_returned(ThreadSafety::Counter &counter){counter.get_mutex().lock();counter.bump();counter.get_mutex().unlock();}
+
+void thread_shared_read(ThreadSafety::Counter &counter){counter.mutex.lock_shared();(void)counter.read();counter.mutex.unlock_shared();}
+void thread_shared_write(ThreadSafety::Counter &counter){counter.mutex.lock_shared();counter.bump();counter.mutex.unlock_shared();} // expected-warning {{requires holding mutex}}
+void thread_generic_release(ThreadSafety::Counter &counter){counter.mutex.lock();counter.bump();counter.mutex.unlock_any();}
+void thread_bad_order(){ThreadSafety::second.lock();ThreadSafety::first.lock();ThreadSafety::first.unlock();ThreadSafety::second.unlock();} // expected-warning {{must be acquired before}}
+void thread_unchecked(ThreadSafety::Counter &counter) __attribute__((no_thread_safety_analysis)){counter.bump();}

