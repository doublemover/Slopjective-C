+const char *escaped_statement_result;
+void uncontracted_pointer(const char *);
+void direct_negative(borrowed const char *value) {
+  const char *alias = value;
+  escaped_statement_result = alias; // expected-error {{borrowed pointer}}
+}
+void wrapped_global_negative(borrowed const char *value) {
+  const char *alias = value;
+  escaped_statement_result = __extension__ ({ alias; }); // expected-error {{borrowed pointer}}
+}
+const char *wrapped_return_negative(borrowed const char *value) {
+  const char *alias = value;
+  return __extension__ ({ alias; }); // expected-error {{borrowed pointer}}
+}
+void wrapped_call_negative(borrowed const char *value) {
+  const char *alias = value;
+  uncontracted_pointer(__extension__ ({ alias; })); // expected-error {{borrowed pointer}}
+}
+void terminal_result_only(borrowed const char *value) {
+  const char *alias = value;
+  escaped_statement_result = __extension__ ({ (void)alias; (const char *)0; });
+  int scalar = __extension__ ({ alias[0]; });
+  (void)scalar;
+}
