+}
+__attribute__((objc_returns_borrowed(owner_index=2)))
+CallbackBytes wrong_owner(CallbackFirst getter,id first,id second) {
+  return getter(first,second); // expected-error {{return without a matching borrowed return and owner parameter contract}}
+}
+void erased_owner(CallbackGetter getter) {
+  (void)(OpaqueGetter)getter; // expected-error {{callable cast changes an ownership or borrowed lifetime contract}}
+}
+void strengthened_owner(OpaqueGetter getter) {
+  (void)(CallbackGetter)getter; // expected-error {{callable cast changes an ownership or borrowed lifetime contract}}
+}
+void changed_owner(CallbackFirst getter) {
