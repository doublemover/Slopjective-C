+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);throw 0;};
+  try{work();}catch(...){closure_use(pointer);} // expected-error {{after its owner lifetime ended}}
+}
+void throw_before_consumption(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{throw 0;closure_consume(owner);};
+  try{work();}catch(...){closure_use(pointer);}
+}
+#endif
+void assigned_block_element(void *owner,void *other) {
+  const char *pointer=closure_bytes(owner);
+  ClosureWork work[2]={^{closure_consume(owner);},^{}};
+  work[0]=^{closure_consume(other);};
+  work[0]();
+  closure_use(pointer);
+}
