+#include "Inputs/native-lifetime-annotations.h"
+namespace LifetimeControls {
+void valid(Owner &owner,View &view){capture(owner,view);unnamed(owner,view);owner.bind(view);closure()(owner,view);generic<int>(owner,view);global(owner,0);unknown(owner,0);}
+void rejected(View &view){
+ capture(Owner{42},view); // expected-error {{object whose reference is captured by 'view' will be destroyed at the end of the full-expression}}
+ unnamed(Owner{42},view); // expected-error {{object whose reference is captured by 'view' will be destroyed at the end of the full-expression}}
+ Owner{42}.bind(view); // expected-error {{object whose reference is captured by 'view' will be destroyed at the end of the full-expression}}
+ closure()(Owner{42},view); // expected-error {{object whose reference is captured by 'view' will be destroyed at the end of the full-expression}}
+ generic<int>(Owner{42},view); // expected-error {{object whose reference is captured by 'view' will be destroyed at the end of the full-expression}}
+ global(Owner{42},0); // expected-error {{object whose reference is captured will be destroyed at the end of the full-expression}}
+ unknown(Owner{42},0); // expected-error {{object whose reference is captured will be destroyed at the end of the full-expression}}
+}
+void conflict(const Owner &source [[clang::lifetime_capture_by(second)]],View &first,View &second){} // expected-error {{lifetime capture targets do not match a previous declaration}}
+void ReceiverConflict::bind(View &first,View &second) [[clang::lifetime_capture_by(second)]] {} // expected-error {{lifetime capture targets do not match a previous declaration}}
+}

