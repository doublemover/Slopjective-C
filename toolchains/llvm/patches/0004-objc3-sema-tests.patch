+void complete_union_overwrite(void *owner) {
+  union PointerUnion value={union_bytes(owner)};
+  value.second="permanent";
+  union_escape(value.first);union_escape(value.second);
+}
+__attribute__((objc_returns_borrowed(owner_index=1)))
+UnionLoan complete_union_rebind(void *previous,void *current) {
+  union PointerUnion value={union_bytes(previous)};
+  value.second=union_bytes(current);return value.first;
+}
+void complete_union_alias(void *owner) {
+  union PointerUnion value={union_bytes(owner)};
+  const char **cell=&value.second;*cell="permanent";
+  union_escape(value.first);
+}
+void complete_union_bytes(void *owner) {
+  union PointerUnion value={union_bytes(owner)};
+  char *bytes=(char *)&value;*(const char **)bytes="permanent";
+  union_escape(value.first);union_escape(value.second);
+}
+void borrowed_union_byte_store(void *owner) {
+  union PointerUnion value={0};char *bytes=(char *)&value;
+  *(const char **)bytes=union_bytes(owner);
