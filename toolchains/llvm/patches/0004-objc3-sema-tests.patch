diff --git a/clang/test/ObjC3/Sema/Inputs/dependent-cleanup.h b/clang/test/ObjC3/Sema/Inputs/dependent-cleanup.h
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/dependent-cleanup.h
@@ -0,0 +1,21 @@
+#ifndef OBJC3_DEPENDENT_CLEANUP_H
+#define OBJC3_DEPENDENT_CLEANUP_H
+namespace DependentCleanup {
+inline int calls=0;
+inline void close_int(int *)noexcept{++calls;}
+template<class T>struct Address {static void close(T *)noexcept{++calls;}};
+template<class T>struct Reference {static void close(T &)noexcept{++calls;}};
+template<class T>struct Copy {static void close(T)noexcept{++calls;}};
+struct Value {int value;explicit Value(int n):value(n){}explicit operator int()const{return value;}~Value()noexcept{}};
+template<class T>int address(int initial){@cleanup(Address<T>::close) T value(initial);return static_cast<int>(value);}
+template<class T>int reference(int initial){@cleanup(Reference<T>::close) T value(initial);return static_cast<int>(value);}
+template<class T>int named(int initial){@cleanup(close_int) T value(initial);return static_cast<int>(value);}
+template<class T>void function_close(T *)noexcept{++calls;}
+template<class T>int explicit_callback(int initial){@cleanup(function_close<T>) T value(initial);return static_cast<int>(value);}
+inline int auto_named(){@cleanup(close_int) auto value=42;return value;}
+template<class T>int auto_dependent(T initial){@cleanup(Address<T>::close) auto value=initial;return static_cast<int>(value);}
+template<class T>int auto_wrong(T initial){@cleanup(close_int) auto value=initial;return static_cast<int>(value);}
+template<class T>void auto_reference(T &initial){@cleanup(close_int) decltype(auto) value=(initial);}
+template<class T>void bad_copy(){@cleanup(Copy<T>::close) T value(42);}
+}
+#endif

