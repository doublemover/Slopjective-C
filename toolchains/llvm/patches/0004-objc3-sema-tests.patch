+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  work.operator()();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void copied_lambda(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  auto copy=work;
+  closure_use(pointer);
+  copy();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void unused_lambda_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  auto unused=[work]{(void)work;};
+  unused();
+  closure_use(pointer);
+}
+void invoked_lambda_capture(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  auto forward=[work]{work();};
+  forward();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void nested_lambda_creation(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto outer=[owner]{auto inner=[owner]{closure_consume(owner);};inner();};
+  outer();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void lambda_record_copy(void *owner) {
+  const char *pointer=closure_bytes(owner);
+  auto work=[owner]{closure_consume(owner);};
+  struct Holder{decltype(work) callback;};
+  Holder holder{work};
+  Holder copy=holder;
+  closure_use(pointer);
+  copy.callback();
+  closure_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
