+#ifndef NATIVE_MANUAL_FRAME_WORK_H
+#define NATIVE_MANUAL_FRAME_WORK_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+#include "../../CodeGen/Inputs/native-c-async-frame.h"
+#ifdef __cplusplus
+}
+#endif
+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface ManualRoot @end
+@interface ManualSafe : ManualRoot <Sendable> @end
+@interface ManualMutable : ManualRoot @end
+typedef objc3_async_frame (*ManualFunction)(void);
+typedef objc3_async_frame (^ManualBlock)(void);
+int manual_function_spawn(ManualFunction) __attribute__((objc_task_spawn));
+int manual_block_detach(ManualBlock) __attribute__((objc_task_detached));
+objc3_async_frame manual_factory(void);
+#ifdef __cplusplus
+struct ManualTask {struct promise_type;};
+typedef ManualTask (*ManualTaskFactory)(void);
+int manual_task_factory_spawn(ManualTaskFactory) __attribute__((objc_task_spawn));
+template<class Work> int manual_callable_spawn(Work) __attribute__((objc_task_spawn));
+struct ManualFunctor {int number;objc3_async_frame operator()();};
+struct ManualBase {objc3_async_frame operator()();};
+struct ManualDerived:ManualBase {};
+struct ManualTaskFunctor {ManualTask operator()();};
+namespace WrongCarrier {struct objc3_async_frame {};}
+struct ManualWrong {WrongCarrier::objc3_async_frame operator()();};
+#endif
+#endif
