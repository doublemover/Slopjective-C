+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+
+using LongOptional = __objc3_optional(long);
+template <class T> T infer_optional(__objc3_optional(T) *);
+static_assert(__is_same(decltype(infer_optional((LongOptional *)nullptr)),
+                        long));
+
+template <class T, class E> struct OrderedArms {};
+template <class T, class E>
+OrderedArms<T, E> infer_result(__objc3_result(T, E) *);
+using LongIntResult = __objc3_result(long, int);
+using IntLongResult = __objc3_result(int, long);
+static_assert(__is_same(decltype(infer_result((LongIntResult *)nullptr)),
+                        OrderedArms<long, int>));
+static_assert(__is_same(decltype(infer_result((IntLongResult *)nullptr)),
+                        OrderedArms<int, long>));
+
+template <class T> struct CarrierBase {};
+template <class T> struct CarrierDerived : CarrierBase<T> {};
+template <class T> T infer_optional_base(__objc3_optional(CarrierBase<T>) *); // expected-note {{candidate template ignored: could not match 'CarrierBase' against 'CarrierDerived'}}
+void reject_optional_payload_covariance(
+    __objc3_optional(CarrierDerived<int>) *value) {
+  (void)infer_optional_base(value); // expected-error {{no matching function for call to 'infer_optional_base'}}
+}
