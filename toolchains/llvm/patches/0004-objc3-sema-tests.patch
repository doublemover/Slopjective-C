+ (void)binding_detached(^void(void) __objc3_async_frame {(void)present;(void)number;(void)other;});
+}
+struct GenericOperatorLoan {
+ borrowed const char *loan;
+ template<class=void>const char *operator()()const{return loan;}
+};
