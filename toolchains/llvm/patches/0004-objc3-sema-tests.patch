diff --git a/clang/test/ObjC3/Sema/Inputs/callback-selection.h b/clang/test/ObjC3/Sema/Inputs/callback-selection.h
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/callback-selection.h
@@ -0,0 +1,40 @@
+#pragma once
+#ifdef __cplusplus
+namespace CallbackSelection {
+inline int selected=0;
+inline void close(int value)noexcept{selected=value;}
+inline void close(long value)noexcept{selected=static_cast<int>(value)+1;}
+inline void close(int *value)noexcept{selected=*value+2;}
+template<class T>void typed(T *value)noexcept{selected=static_cast<int>(*value);}
+template<class T>void handle(T value)noexcept{selected=static_cast<int>(value);}
+template<class T,int N>void array(T (&value)[N])noexcept{selected=static_cast<int>(value[0])+N;}
+template<class T> requires (__is_integral(T))
+void constrained(T *value)noexcept{selected=static_cast<int>(*value);}
+inline void constrained(void *)noexcept{selected=-2;}
+struct StaticClose {static void close(int value)noexcept{selected=value;}
+ static void close(long value)noexcept{selected=static_cast<int>(value)+1;}};
+inline void use(){
+ @cleanup(close) int value=41;
+ @cleanup(typed) long address=42;
+ @cleanup(array) int values[2]={43,44};
+ @cleanup(constrained) int constraint=45;
+ @cleanup(StaticClose::close) long member=46;
+ @resource(close,invalid:-1) int resource=47;
+ @resource(handle,invalid:-1) long deduced=48;
+}
+template<class T>inline void dependent(T initial){
+ @cleanup(typed) T value=initial;
+ @resource(handle,invalid:-1) T resource=initial;
+ @cleanup(close) auto automatic=initial;
+ @resource(close,invalid:-1) auto automatic_resource=initial;
+}
+@requires_cleanup(close) typedef int Handle;
+inline void contracted(){@resource(close,invalid:-1) Handle value=49;}
+}
+#else
+void c_overload(int) __attribute__((overloadable));
+void c_overload(long) __attribute__((overloadable));
+void c_overload(int *) __attribute__((overloadable));
+@requires_cleanup(c_overload) typedef int CHandle;
+inline void c_use(void){@cleanup(c_overload) int value=41;@resource(c_overload,invalid:-1) CHandle handle=42;(void)value;(void)handle;}
+#endif

