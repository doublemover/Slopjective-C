+++ b/clang/test/ObjC3/Sema/borrowed-manual-release.m
@@ -0,0 +1,120 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-manual-release.h -o %t-c.pch
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-c.pch -DFROM_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-manual-release.h -o %t-cxx.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-cxx.pch -DFROM_PCH -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-manual-release.h"
+#endif
+
+void before_release(ManualOwner *_Nonnull owner) {
+  const char *pointer=manual_bytes(owner);
+  manual_use(pointer);
+  [owner release];
+}
+void independent_pin(ManualOwner *_Nonnull owner) {
+  keepAlive(owner);
+  const char *pointer=manual_bytes(owner);
+  [owner release];
+  manual_use(pointer);
+  manual_use(manual_bytes(owner));
+}
+void independent_alias_pin(ManualOwner *_Nonnull owner) {
+  ManualOwner *_Nonnull alias=owner;
+  const char *pointer=manual_bytes(owner);
+  withLifetime(owner) {
+    [alias release];
+    manual_use(pointer);
+    manual_use(manual_bytes(owner));
+  }
+}
+void fresh_assignment(ManualOwner *_Nonnull owner,ManualOwner *_Nonnull replacement) {
+  [owner release];
+  owner=replacement;
+  manual_use(manual_bytes(owner));
+}
+void expired_loan(ManualOwner *_Nonnull owner) {
+  const char *pointer=manual_bytes(owner);
+  [owner release];
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void expired_alias(ManualOwner *_Nonnull owner) {
+  ManualOwner *_Nonnull alias=owner;
+  const char *pointer=manual_bytes(owner);
+  [alias release];
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void expired_alias_source(ManualOwner *_Nonnull owner) {
+  ManualOwner *_Nonnull alias=owner;
+  const char *pointer=manual_bytes(alias);
+  [owner release];
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void conditional_release(ManualOwner *_Nonnull owner,int choose) {
+  const char *pointer=manual_bytes(owner);
+  if (choose) [owner release];
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void expired_acquisition(ManualOwner *_Nonnull owner) {
+  [owner release];
+  manual_use(manual_bytes(owner)); // expected-error {{after its owner lifetime ended}}
+}
+int expired_access(ManualOwner *_Nonnull owner) {
+  [owner release];
+  return manual_bytes(owner)[0]; // expected-error {{access after its owner lifetime ended}}
+}
+void copied_consumed_owner(ManualOwner *_Nonnull owner) {
+  [owner release];
+  ManualOwner *_Nonnull alias=owner;
+  manual_use(manual_bytes(alias)); // expected-error {{after its owner lifetime ended}}
+}
+void late_pin(ManualOwner *_Nonnull owner) {
+  [owner release];
+  keepAlive(owner); // expected-error {{lifetime pin created after manual owner release}}
+  manual_use(manual_bytes(owner)); // expected-error {{after its owner lifetime ended}}
+}
+void ended_pin(ManualOwner *_Nonnull owner) {
+  const char *pointer=manual_bytes(owner);
+  withLifetime(owner) {
+    [owner release];
+    manual_use(pointer);
+  }
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void nested_block(ManualOwner *_Nonnull owner) {
+  [owner release];
+  void (^work)(void)=^{manual_use(manual_bytes(owner));}; // expected-error {{after its owner lifetime ended}}
+  work();
+}
+@interface ManualChild : ManualOwner
+- (void)drop;
+@end
+@implementation ManualChild
+- (void)drop {
+  const char *pointer=manual_bytes(self);
+  [super release];
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+@end
+__attribute__((objc_root_class)) @interface NonReleasingOwner
+- (void)release __attribute__((objc_method_family(none)));
+@end
+void no_family_effect(NonReleasingOwner *_Nonnull owner) {
+  const char *pointer=manual_bytes(owner);
+  [owner release];
+  manual_use(pointer);
+}
+#ifdef __cplusplus
+void nested_lambda(ManualOwner *_Nonnull owner) {
+  [owner release];
+  auto work=[owner] {manual_use(manual_bytes(owner));}; // expected-error {{after its owner lifetime ended}}
+  work();
+}
+void nested_init_lambda(ManualOwner *_Nonnull owner) {
+  [owner release];
+  auto work=[copy=owner] {manual_use(manual_bytes(copy));}; // expected-error {{after its owner lifetime ended}}
+  work();
+}
+#endif
