+#ifndef OBJC3_BORROWED_OWNED_RECORDS_H
+#define OBJC3_BORROWED_OWNED_RECORDS_H
+#include "borrowed-memory-aliases.h"
+MemoryBytes memory_object_bytes(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+struct MemoryObjectRecord {id owner;};
+struct MemoryNestedObjectRecord {struct MemoryObjectRecord value;};
+struct MemoryUnsafeObjectRecord {__unsafe_unretained id owner;};
+typedef void (^MemoryRecordWork)(void);
+#ifdef __cplusplus
+struct MemoryObjectReference {id __strong &owner;};
+#endif
+#endif
