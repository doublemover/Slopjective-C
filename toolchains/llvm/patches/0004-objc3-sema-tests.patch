+#ifndef OBJC3_UNION_BYTE_STORAGE_H
+#define OBJC3_UNION_BYTE_STORAGE_H
+typedef borrowed const char *UnionLoan;
+UnionLoan union_bytes(void *owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void union_escape(const char *value);
+void union_read(const char *value __attribute__((noescape)));
+union PointerUnion {const char *first;const char *second;};
+struct NestedUnion {int prefix;union PointerUnion value;};
+union PartialUnion {const char *pointer;char bytes[2*sizeof(void *)];};
+union AtomicUnion {const char *pointer;_Atomic(const char *) atomic;};
+#ifdef __cplusplus
+union NontrivialUnion {const char *pointer;const char *other;~NontrivialUnion(){}};
+#endif
+#endif
