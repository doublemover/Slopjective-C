diff --git a/clang/test/ObjC3/Sema/Inputs/import-overloaded-members.h b/clang/test/ObjC3/Sema/Inputs/import-overloaded-members.h
new file mode 100644
index 000000000..fc4c27dfd
--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/import-overloaded-members.h
@@ -0,0 +1,10 @@
+
+struct ImportedOverloads {
+  constexpr int pick(int value) const { return value + 10; }
+  constexpr int pick(long value) const { return static_cast<int>(value) + 20; }
+  template<class T> constexpr int implicit(T value) const { return pick(value); }
+  template<class T> constexpr int explicit_arrow(T value) const { return this->pick(value); }
+  template<class T> constexpr int explicit_dot(const ImportedOverloads &object, T value) const {
+    return object.pick(value);
+  }
+};
