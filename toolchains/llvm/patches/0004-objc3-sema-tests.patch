+  ResourcePropertyBorrowed(ResourcePropertyBorrowed &&);~ResourcePropertyBorrowed() noexcept;
+};
+@interface ResourcePropertyHost (Gates)
+@property(nonatomic) ResourcePropertyOpaque opaque;
+- (ResourcePropertyOpaque)opaque __attribute__((objc_executor(main)));
+- (void)setOpaque:(ResourcePropertyOpaque)value __attribute__((objc_executor(main)));
+@property(nonatomic) ResourcePropertyBorrowed borrowedValue;
+- (ResourcePropertyBorrowed)borrowedValue __attribute__((objc_executor(main)));
+- (void)setBorrowedValue:(ResourcePropertyBorrowed)value __attribute__((objc_executor(main)));
