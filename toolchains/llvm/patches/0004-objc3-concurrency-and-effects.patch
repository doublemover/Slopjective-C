+namespace {
+bool hasExceptionCaptureHook(Sema &S) {
+  if (!S.getLangOpts().CXXExceptions) return false;
+  for (NamedDecl *D : S.Context.getTranslationUnitDecl()->lookup(
+           &S.Context.Idents.get("__objc3_async_capture_current_exception")))
+    if (const auto *F = dyn_cast<FunctionDecl>(D)) {
+      const auto *FT = F->getType()->getAs<FunctionProtoType>();
+      if (FT && FT->isNothrow() && F->getNumParams() == 1 &&
+          F->getReturnType()->isIntegerType() &&
+          F->getParamDecl(0)->getType()->isPointerType() &&
+          F->getParamDecl(0)->getType()->getPointeeType()->isPointerType() &&
+          !FT->isVariadic() && S.Context.getTypeSize(F->getReturnType()) == 32) {
+        S.MarkFunctionReferenced(F->getLocation(), const_cast<FunctionDecl *>(F));
+        return true;
+      }
+    }
+  return false;
+}
+
+bool isolationFrameScalar(QualType T, bool Result) {
+  if (Result && T->isVoidType())
+    return true;
+  return T->isArithmeticType() || T->isEnumeralType() || T->isPointerType() ||
+         T->isNullPtrType() || T->isObjCRetainableType();
+}
+
+// Explicit C++ copy/move/destruction owns resource fields, active union arms
+// and MRC storage as one value. Hook instantiation independently checks access,
+// deleted operations and nonthrowing destruction. A promise cannot erase loans.
+static std::optional<bool> explicitFrameLifetime(ASTContext &Context, QualType Type) {
+  const auto *Class = Type->getAsCXXRecordDecl();
+  if (!Class || !(Class=Class->getDefinition()) || Type.isTriviallyCopyableType(Context)) return std::nullopt;
+  const auto *Destructor = Class->getDestructor();
+  if (!Destructor || !Destructor->isUserProvided() || Destructor->isDeleted()) return std::nullopt;
+  return !containsObjC3BorrowedType(Context, Type);
+}
+
+// Aggregate entries use the same typed capture/result operations as ordinary
+// native frames. Keep resource transfer and MRC managed aggregate storage out
+// of this value-copy boundary until their independent ownership is modeled.
+bool isolationFrameValue(Sema &S, QualType T, bool Result) {
+  if (isolationFrameScalar(T, Result)) return true;
+  if (!T->isRecordType()) return false;
+  unsigned Budget = 256;
+  llvm::DenseMap<std::pair<QualType, unsigned>, bool> Memo;
+  auto Check = [&](auto &&Self, QualType Value, unsigned Depth, bool UnionArm = false) -> bool {
+    if (Value.isNull() || Depth > 64 || Budget == 0 ||
+        Value->isDependentType() || Value.isVolatileQualified() ||
+        Value->isAtomicType() || Value->isReferenceType() ||
+        getObjC3ResourceTypeContract(S.Context, Value).Cleanup)
+      return false;
+    --Budget;
+    auto Key = std::make_pair(Value.getCanonicalType(), unsigned(UnionArm));
+    if (auto It = Memo.find(Key); It != Memo.end()) return It->second;
+    auto Evaluate = [&]() -> bool {
+    if (Value->isObjCRetainableType()) return !UnionArm && S.getLangOpts().ObjCAutoRefCount;
+    if (const auto *Array = S.Context.getAsArrayType(Value))
+      return isa<ConstantArrayType>(Array) &&
+             Self(Self, Array->getElementType(), Depth + 1, UnionArm);
+    if (const auto *Record = Value->getAs<RecordType>()) {
+      const auto *Definition = Record->getDecl()->getDefinition();
+      if (!Definition) return false;
+      if (auto Lifetime=explicitFrameLifetime(S.Context, Value)) return *Lifetime;
+      // C unions and implicit/deleted C++ union lifetimes cannot infer which
+      // managed arm is active. They still need a separate ownership contract.
+      if (Definition->isUnion() && !Value.isTriviallyCopyableType(S.Context))return false;
+      UnionArm |= Definition->isUnion();
+      for (const auto *Field : Definition->fields())
+        if (!Self(Self, Field->getType(), Depth + 1, UnionArm)) return false;
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+        for (const auto &Base : Class->bases())
+          if (!Self(Self, Base.getType(), Depth + 1, UnionArm)) return false;
+      return true;
+    }
+    return isolationFrameScalar(Value, false);
+    };
+    bool Accepted = Evaluate();
+    Memo[Key] = Accepted;
+    return Accepted;
+  };
+  return Check(Check, T, 0);
+}
+
+bool isolationConsumesReceiver(const Decl *Target) {
+  if (Target->hasAttr<NSConsumesSelfAttr>()) return true;
+  const auto *Method = dyn_cast<ObjCMethodDecl>(Target);
+  return Method && Method->isInstanceMethod() && Method->getMethodFamily() == OMF_init;
+}
+
+bool isolationResultIsOwned(const Decl *Target) {
+  if (Target->hasAttr<NSReturnsRetainedAttr>())
+    return true;
+  if (Target->hasAttr<NSReturnsNotRetainedAttr>() ||
+      Target->hasAttr<NSReturnsAutoreleasedAttr>())
+    return false;
+  if (const auto *Method = dyn_cast<ObjCMethodDecl>(Target))
+    switch (Method->getMethodFamily()) {
+    case OMF_alloc:
+    case OMF_new:
+    case OMF_copy:
+    case OMF_mutableCopy:
+    case OMF_init:
+      return true;
+    default:
+      break;
+    }
+  return false;
+}
+
+struct IsolationPropertyOperation {
+  ObjCPropertyRefExpr *Reference = nullptr;
+  Expr *RHS = nullptr;
+  QualType Result;
+  ExprValueKind RHSKind = VK_PRValue;
+  ObjCMethodDecl *Getter = nullptr, *Setter = nullptr;
+  std::optional<BinaryOperatorKind> Binary;
+  std::optional<UnaryOperatorKind> Unary;
+  bool RHSFirst = false;
+  bool writes() const { return Binary || Unary; }
+  bool reads() const { return !Binary || *Binary != BO_Assign; }
+};
+
+Expr *propertyInput(Expr *Value) {
+  for (unsigned I = 0; Value && I != 32; ++I) {
+    Value = Value->IgnoreParens();
+    if (auto *Opaque = dyn_cast<OpaqueValueExpr>(Value)) Value = Opaque->getSourceExpr();
+    else return Value;
+  }
+  return nullptr;
+}
+
+std::optional<IsolationPropertyOperation> propertyOperation(Expr *Source) {
+  auto *Pseudo = dyn_cast<PseudoObjectExpr>(Source);
+  if (!Pseudo) return std::nullopt;
+  IsolationPropertyOperation Result;
+  Expr *Syntax = Pseudo->getSyntacticForm()->IgnoreParenImpCasts();
+  Expr *RHSBinding = nullptr;
+  if (auto *Binary = dyn_cast<BinaryOperator>(Syntax); Binary && Binary->isAssignmentOp()) {
+    Result.Binary = Binary->getOpcode();
+    Result.Reference = dyn_cast<ObjCPropertyRefExpr>(Binary->getLHS()->IgnoreParenImpCasts());
+    RHSBinding = Binary->getRHS()->IgnoreParens();
+    Result.RHS = propertyInput(RHSBinding);
+    if (!Result.RHS) return std::nullopt;
+    Result.RHSKind = Result.RHS->getValueKind();
+  } else if (auto *Unary = dyn_cast<UnaryOperator>(Syntax); Unary && Unary->isIncrementDecrementOp()) {
+    Result.Unary = Unary->getOpcode();
+    Result.Reference = dyn_cast<ObjCPropertyRefExpr>(Unary->getSubExpr()->IgnoreParenImpCasts());
+  } else Result.Reference = dyn_cast<ObjCPropertyRefExpr>(Syntax);
+  if (!Result.Reference) return std::nullopt;
+  auto *Property = Result.Reference;
+  if (Property->isExplicitProperty()) {
+    Result.Getter = Property->getExplicitProperty()->getGetterMethodDecl();
+    Result.Setter = Property->getExplicitProperty()->getSetterMethodDecl();
+  } else {
+    Result.Getter = Property->getImplicitPropertyGetter();
+    Result.Setter = Property->getImplicitPropertySetter();
+  }
+  if ((Result.reads() && !Result.Getter) || (Result.writes() && !Result.Setter))
+    return std::nullopt;
+  Result.Result = Source->getType();
+  // Preserve the parser's receiver/RHS evaluation order. The RHS value is a
+  // caller-side snapshot; the accessor sequence itself runs at the destination.
+  if (RHSBinding && Property->isObjectReceiver()) {
+    if (const auto *Receiver = dyn_cast<OpaqueValueExpr>(Property->getBase());
+        Receiver && Receiver->isUnique()) {
+      // Unique receivers are evaluated lazily at the message. A captured
+      // assignment result evaluates its RHS earlier; a nontrivial C++ setter
+      // has no such result, so receiver evaluation precedes its construction.
+      // An async setter's frame result is not an early RHS capture.
+      const auto *Message = dyn_cast<ObjCMessageExpr>(getObjC3AsyncSourceCall(Pseudo));
+      Result.RHSFirst = Pseudo->getResultExpr() &&
+          (!Message || Message->getMethodDecl() != Result.Setter);
+    } else for (auto *Semantic : Pseudo->semantics()) {
+      if (Semantic == Property->getBase()) break;
+      if (Semantic == RHSBinding) { Result.RHSFirst = true; break; }
+    }
+  }
+  return Result;
+}
+
+bool propertyWriteValue(Sema &S, QualType Type, unsigned &Budget,
+                        llvm::SmallPtrSetImpl<const clang::Type *> &Seen, unsigned Depth = 0) {
+  if (Type.isNull() || !Budget || Depth > 64 || Type->isReferenceType() ||
+      (Type->isRecordType() && Type.isVolatileQualified()) ||
+      getObjC3ResourceTypeContract(S.Context, Type).Cleanup) return false;
+  --Budget;
+  if (!Seen.insert(Type.getCanonicalType().getTypePtr()).second) return true;
+  if (Type->isObjCRetainableType()) return true;
+  if (const auto *Array = S.Context.getAsArrayType(Type))
+    return isa<ConstantArrayType>(Array) && propertyWriteValue(S, Array->getElementType(), Budget, Seen, Depth + 1);
+  if (const auto *Record = Type->getAsRecordDecl()) {
+    const auto *Definition = Record->getDefinition();
+    if (!Definition) return false;
+    if (auto Lifetime=explicitFrameLifetime(S.Context, Type)) return *Lifetime;
+    for (const auto *Field : Definition->fields())
+      if (Field->hasAttr<ObjCResourceAttr>() || Field->hasAttr<ObjCCleanupAttr>() ||
+          !propertyWriteValue(S, Field->getType(), Budget, Seen, Depth + 1)) return false;
+    if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+      for (const auto &Base : Class->bases())
+        if (!propertyWriteValue(S, Base.getType(), Budget, Seen, Depth + 1)) return false;
+  }
+  return true;
+}
+
+ExprResult rebuildPropertyOperation(Sema &S, const IsolationPropertyOperation &Operation,
+                                    ArrayRef<Expr *> Arguments, SourceLocation Loc,
+                                    bool SuperInstance) {
+  const auto *Original = Operation.Reference;
+  ObjCPropertyRefExpr *Property;
+  if (Original->isClassReceiver()) {
+    Property = new (S.Context) ObjCPropertyRefExpr(Operation.Getter, Operation.Setter,
+        Original->getType(), Original->getValueKind(), Original->getObjectKind(),
+        Loc, Loc, Original->getClassReceiver());
+  } else {
+    auto Receiver = S.DefaultLvalueConversion(Arguments.front());
+    if (Receiver.isInvalid()) return ExprError();
+    if (Original->isExplicitProperty() && !Original->isSuperReceiver())
+      Property = new (S.Context) ObjCPropertyRefExpr(Original->getExplicitProperty(),
+          Original->getType(), Original->getValueKind(), Original->getObjectKind(), Loc, Receiver.get());
+    else Property = new (S.Context) ObjCPropertyRefExpr(Operation.Getter, Operation.Setter,
+        Original->getType(), Original->getValueKind(), Original->getObjectKind(), Loc, Receiver.get());
+  }
+  ExprResult Value;
+  if (Operation.Binary)
+    Value = S.BuildBinOp(nullptr, Loc, *Operation.Binary, Property, Arguments.back());
+  else if (Operation.Unary)
+    Value = S.BuildUnaryOp(nullptr, Loc, *Operation.Unary, Property);
+  else Value = S.DefaultLvalueConversion(Property);
+  if (Value.isInvalid() || !Original->isSuperReceiver()) return Value;
+  // Selection was checked in the source method. Build with the independent
+  // frame receiver, then restore each accessor's exact lexical super dispatch.
+  SmallVector<Stmt *, 16> Pending{Value.get()};
+  llvm::SmallPtrSet<Stmt *, 32> Seen;
+  unsigned Budget = 4096;
+  while (!Pending.empty()) {
+    Stmt *Node = Pending.pop_back_val();
+    if (!Node || !Seen.insert(Node).second) continue;
+    if (!Budget--) {
+      S.Diag(Loc, diag::err_objc3_isolation_hop_shape);
+      return ExprError();
+    }
+    if (auto *Message = dyn_cast<ObjCMessageExpr>(Node))
+      if (Message->getMethodDecl() == Operation.Getter || Message->getMethodDecl() == Operation.Setter)
+        Message->setSuper(Loc, Original->getSuperReceiverType(), SuperInstance);
+    if (auto *Opaque = dyn_cast<OpaqueValueExpr>(Node)) Pending.push_back(Opaque->getSourceExpr());
+    for (Stmt *Child : Node->children()) Pending.push_back(Child);
+  }
+  return Value;
+}
+
+FunctionDecl *buildIsolationThunk(Sema &S, Expr *Source, Expr *SourceReceiver,
+                                  const Decl *Target,
+                                  const FunctionProtoType *Original,
+                                  const ObjCExecutorAttr *Executor,
+                                  bool ActorEntry, ObjCMethodDecl *SuperContext,
+                                  SourceLocation Loc,
+                                  const IsolationPropertyOperation *Property = nullptr) {
+  auto *Message = dyn_cast<ObjCMessageExpr>(Source);
+  const bool HasReceiver = SourceReceiver != nullptr;
+  auto *TU = S.Context.getTranslationUnitDecl();
+  std::string Prefix =
+      "__objc3_isolation_entry_" + std::to_string(Loc.getRawEncoding());
+  std::string Name = Prefix;
+  unsigned Suffix = 0;
+  while (!TU->lookup(&S.Context.Idents.get(Name)).empty())
+    Name = Prefix + "_" + std::to_string(++Suffix);
+  FunctionProtoType::ExtProtoInfo Info;
+  Info.ObjC3Effects = Original->getObjC3FunctionEffects();
+  Info.ObjC3Effects.Async = true;
+  Info.ObjC3Effects.AsyncFrame = true;
+  SmallVector<QualType, 4> Types;
+  if (HasReceiver)
+    Types.push_back(SourceReceiver->getType());
+  llvm::append_range(Types, Original->param_types());
+  SmallVector<const ParmVarDecl *, 4> SourceParameters;
+  if (Message || Property)
+    llvm::append_range(SourceParameters, cast<ObjCMethodDecl>(Target)->parameters());
+  else
+    llvm::append_range(SourceParameters, cast<FunctionDecl>(Target)->parameters());
+  SmallVector<FunctionProtoType::ExtParameterInfo, 4> ParameterInfos(Types.size());
+  bool HasConsumed = false;
+  for (unsigned I = 0; I != Types.size(); ++I) {
+    const bool Receiver = HasReceiver && I == 0;
+    const unsigned SourceIndex = HasReceiver && I != 0 ? I - 1 : I;
+    const ParmVarDecl *SourceParameter = !Receiver && SourceIndex < SourceParameters.size()
+        ? SourceParameters[SourceIndex] : nullptr;
+    const auto SourceInfo = Receiver ? FunctionProtoType::ExtParameterInfo()
+                                    : Original->getExtParameterInfo(SourceIndex);
+    const bool Foreign = !Receiver && (SourceInfo.isCFConsumed() ||
+        (SourceParameter && SourceParameter->hasAttr<CFConsumedAttr>()));
+    if (Foreign) {
+      HasConsumed = true;
+      ParameterInfos[I] = ParameterInfos[I].withIsCFConsumed(true);
+      continue;
+    }
+    const bool Consumed = Receiver ? isolationConsumesReceiver(Target)
+        : SourceInfo.isConsumed() ||
+          (SourceParameter && SourceParameter->hasAttr<NSConsumedAttr>());
+    if (!Consumed) continue;
+    HasConsumed = true;
+    ParameterInfos[I] = ParameterInfos[I].withIsConsumed(true);
+    // The ramp adopts the caller's +1 independently of the frame copy.
+    // ARC uses ordinary strong-parameter cleanup. MRC ramps have an explicit
+    // normal/EH cleanup so failed allocation or copying balances adoption too.
+    auto Quals = Types[I].getQualifiers();
+    Quals.removeObjCLifetime();
+    if (S.getLangOpts().ObjCAutoRefCount)
+      Quals.addObjCLifetime(Qualifiers::OCL_Strong);
+    Types[I] = S.Context.getQualifiedType(Types[I].getUnqualifiedType(), Quals);
+  }
+  if (HasConsumed) Info.ExtParameterInfos = ParameterInfos.data();
+  QualType Type =
+      S.Context.getFunctionType(Original->getReturnType(), Types, Info);
+  // Register the native frame representation before publishing the body to
+  // CodeGen. A C++ task caller may be the first user of this logical result,
+  // so its task representation does not establish the thunk's frame ABI.
+  if (S.BuildObjC3AsyncTaskType(Type->castAs<FunctionProtoType>(), Loc).isNull())
+    return nullptr;
+  auto *Thunk = FunctionDecl::Create(
+      S.Context, TU, Loc, Loc, &S.Context.Idents.get(Name), Type,
+      S.Context.getTrivialTypeSourceInfo(Type, Loc), SC_Static);
+  Thunk->setImplicit();
+  // A super send uses the source method's lexical lookup context, while its
+  // receiver is the independently owned first frame parameter. Native lexical
+  // declaration contexts preserve this relationship through PCH/AST import.
+  if (SuperContext)
+    Thunk->setLexicalDeclContext(SuperContext);
+  const bool SourceAsync = Property
+      ? cast<ObjCMethodDecl>(Target)->getObjC3FunctionEffects().Async
+      : Original->getObjC3FunctionEffects().Async;
+  Thunk->addAttr(ObjC3IsolationThunkAttr::CreateImplicit(
+      S.Context, ActorEntry, !SourceAsync && isolationResultIsOwned(Target)));
+  if (hasObjC3CFResultOwnership(Target)) {
+    // A synchronous retained result transfers its source +1. An awaited
+    // native-frame result is a +0 expression rooted by its full expression.
+    if (!SourceAsync && Target->hasAttr<CFReturnsRetainedAttr>())
+      Thunk->addAttr(CFReturnsRetainedAttr::CreateImplicit(S.Context));
+    else
+      Thunk->addAttr(CFReturnsNotRetainedAttr::CreateImplicit(S.Context));
+  }
+  if (Executor)
+    Thunk->addAttr(Executor->clone(S.Context));
+  SmallVector<ParmVarDecl *, 4> Params;
+  for (unsigned I = 0; I != Types.size(); ++I) {
+    auto *Param = ParmVarDecl::Create(
+        S.Context, Thunk, Loc, Loc,
+        &S.Context.Idents.get("argument" + std::to_string(I)), Types[I],
+        S.Context.getTrivialTypeSourceInfo(Types[I], Loc), SC_None, nullptr);
+    Param->setImplicit();
+    if (ParameterInfos[I].isConsumed())
+      Param->addAttr(NSConsumedAttr::CreateImplicit(S.Context));
+    if (ParameterInfos[I].isCFConsumed())
+      Param->addAttr(CFConsumedAttr::CreateImplicit(S.Context));
+    Thunk->addDecl(Param);
+    Params.push_back(Param);
+  }
+  Thunk->setParams(Params);
+  Thunk->getLexicalDeclContext()->addDecl(Thunk);
+  {
+    Sema::SynthesizedFunctionScope Scope(S, Thunk);
+    SmallVector<Expr *, 4> Arguments;
+    for (unsigned I = 0; I < Params.size(); ++I) {
+      auto *Param = Params[I];
+      Expr *Argument = S.BuildDeclRefExpr(Param, Param->getType(), VK_LValue, Loc);
+      // The frame already owns an independent value parameter. Move that
+      // value into the target call rather than requiring another C++ copy.
+      if (S.getLangOpts().CPlusPlus && Param->getType()->isRecordType() &&
+          (!Property || (I + 1 == Params.size() && Property->RHS &&
+                         Property->RHSKind != VK_LValue)))
+        Argument = ImplicitCastExpr::Create(
+            S.Context, Param->getType(), CK_NoOp, Argument, nullptr,
+            VK_XValue, FPOptionsOverride());
+      if (!S.getLangOpts().ObjCAutoRefCount && ParameterInfos[I].isConsumed()) {
+        ExprResult Loaded = S.DefaultLvalueConversion(Argument);
+        if (Loaded.isInvalid()) return nullptr;
+        // An MRC callee consumes its incoming +1 manually. Keep the frame's
+        // own pin independent by producing a separate handoff claim.
+        Argument = ImplicitCastExpr::Create(
+            S.Context, Loaded.get()->getType(), CK_ARCProduceObject, Loaded.get(),
+            nullptr, VK_PRValue, FPOptionsOverride());
+      }
+      Arguments.push_back(Argument);
+    }
+    ExprResult Value;
+    if (Property) {
+      Value = rebuildPropertyOperation(S, *Property, Arguments, Loc,
+                                       !SuperContext || SuperContext->isInstanceMethod());
+    } else if (Message && !HasReceiver) {
+      Value = S.ObjC().BuildClassMessageImplicit(
+          Message->getClassReceiver(), false, Loc, Message->getSelector(),
+          const_cast<ObjCMethodDecl *>(cast<ObjCMethodDecl>(Target)), Arguments);
+    } else if (Message) {
+      ExprResult Receiver = S.DefaultLvalueConversion(Arguments.front());
+      if (Receiver.isInvalid())
+        return nullptr;
+      Value = S.ObjC().BuildInstanceMessageImplicit(
+          Receiver.get(), Receiver.get()->getType(), Loc,
+          Message->getSelector(),
+          const_cast<ObjCMethodDecl *>(cast<ObjCMethodDecl>(Target)),
+          MutableArrayRef<Expr *>(Arguments).drop_front());
+      if (!Value.isInvalid() && SuperContext) {
+        auto *Built = cast<ObjCMessageExpr>(
+            Value.get()->IgnoreImplicit()->IgnoreParenImpCasts());
+        Built->setSuper(Message->getSuperLoc(), Message->getSuperType(),
+                        Message->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+      }
+    } else if (HasReceiver) {
+      const auto *Call = cast<CXXMemberCallExpr>(Source);
+      const auto *OriginalMember = cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts());
+      ExprResult Receiver = S.DefaultLvalueConversion(Arguments.front());
+      if (Receiver.isInvalid()) return nullptr;
+      ExprResult Object = S.CreateBuiltinUnaryOp(Loc, UO_Deref, Receiver.get());
+      if (Object.isInvalid()) return nullptr;
+      Expr *Base = Object.get();
+      if (!OriginalMember->isArrow() && OriginalMember->getBase()->isXValue())
+        Base = ImplicitCastExpr::Create(S.Context, Base->getType(), CK_NoOp,
+            Base, nullptr, VK_XValue, FPOptionsOverride());
+      // Selection/access checking already happened at the source call. Keep
+      // its exact declaration and qualifier so virtual versus qualified-base
+      // dispatch, private/protected access and template specialization agree.
+      Expr *Callee = S.BuildMemberExpr(Base, false, Loc,
+          OriginalMember->getQualifierLoc(), OriginalMember->getTemplateKeywordLoc(),
+          const_cast<CXXMethodDecl *>(cast<CXXMethodDecl>(Target)),
+          OriginalMember->getFoundDecl(), OriginalMember->hadMultipleCandidates(),
+          OriginalMember->getMemberNameInfo(), OriginalMember->getType(),
+          OriginalMember->getValueKind(), OriginalMember->getObjectKind());
+      Value = S.BuildCallExpr(nullptr, Callee, Loc,
+          MutableArrayRef<Expr *>(Arguments).drop_front(), Loc);
+    } else {
+      auto *Function = const_cast<FunctionDecl *>(cast<FunctionDecl>(Target));
+      ExprResult Callee = S.BuildDeclRefExpr(Function, Function->getType(),
+                                             VK_LValue, Source->getExprLoc());
+      Value = S.BuildCallExpr(nullptr, Callee.get(), Loc, Arguments, Loc);
+    }
+    if (Value.isInvalid())
+      return nullptr;
+    if (!Property && Original->getObjC3FunctionEffects().Async) {
+      Value = S.ActOnObjC3CAwaitExpr(Loc, Value.get());
+      if (Value.isInvalid())
+        return nullptr;
+    }
+    if (!Property && Info.ObjC3Effects.Throws != ObjC3ThrowsKind::None) {
+      Value = S.ActOnObjC3TryExpr(
+          static_cast<unsigned>(ObjC3TryExpr::Kind::Propagate), Loc, Loc,
+          Value.get(), Loc);
+      if (Value.isInvalid())
+        return nullptr;
+    }
+    Value = S.ActOnFinishFullExpr(Value.get(), Loc, false);
+    if (Value.isInvalid())
+      return nullptr;
+    // This is a native frame body even in C++; its return must remain an
+    // ordinary ReturnStmt rather than constructing a language coroutine.
+    Stmt *Return = ReturnStmt::Create(S.Context, Loc, Value.get(), nullptr);
+    Thunk->setBody(CompoundStmt::Create(S.Context, {Return},
+                                        FPOptionsOverride(), Loc, Loc));
+    if (checkObjC3CAsyncBody(S, Thunk, Thunk->getBody())) {
+      Thunk->setInvalidDecl();
+      return nullptr;
+    }
+  }
+  S.Consumer.HandleTopLevelDecl(DeclGroupRef(Thunk));
+  return Thunk;
+}
+
+bool sameCurrentActor(const Decl *Callable, const ObjCMessageExpr *Message) {
+  return currentActorReceiver(Callable, Message->getInstanceReceiver(),
+      Message->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+}
+
+bool unsupportedIsolatedConsumption(const Sema &S, QualType Type,
+                                    const ParmVarDecl *Parameter,
+                                    FunctionProtoType::ExtParameterInfo Info) {
+  const bool ConsumedValue = Type->isObjCRetainableType() || isObjC3NSObjectStorageType(Type);
+  const bool Foreign = Info.isCFConsumed() ||
+      (Parameter && Parameter->hasAttr<CFConsumedAttr>());
+  const bool ForeignValue = Type->isPointerType() &&
+      !Type->getPointeeType()->isFunctionType() &&
+      Type.getAddressSpace() == LangAS::Default &&
+      Type->getPointeeType().getAddressSpace() == LangAS::Default;
+  return ((Info.isConsumed() ||
+           (Parameter && Parameter->hasAttr<NSConsumedAttr>())) &&
+          (!ConsumedValue || Foreign)) ||
+         (Foreign && !ForeignValue) ||
+         (Parameter && Parameter->hasAttr<ObjCResourceAttr>()) ||
+         Type->isReferenceType();
+}
+
+Expr *uninitializeConsumedArgument(Expr *Argument) {
+  // Source calls have already undergone consumed-parameter initialization.
+  // The adopting thunk redoes that initialization for its own consumed ABI;
+  // retaining the first ARCProduceObject would manufacture a second +1.
+  if (auto *Cast = dyn_cast<ImplicitCastExpr>(Argument);
+      Cast && Cast->getCastKind() == CK_ARCProduceObject)
+    return Cast->getSubExpr();
+  return Argument;
+}
+
+const FunctionProtoType *isolationCalleeFunctionType(Sema &S,
+                                                     const Decl *Target) {
+  if (const auto *Type = getObjC3CallableFunctionType(Target))
+    return Type;
+  // Ordinary synchronous methods intentionally need no stored effect type.
+  // Form their logical signature without mutating declaration identity.
+  if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Target)) {
+    SmallVector<QualType, 4> Types;
+    for (const auto *Parameter : Method->parameters())
+      Types.push_back(Parameter->getType());
+    FunctionProtoType::ExtProtoInfo Info;
+    Info.Variadic = Method->isVariadic();
+    Info.ObjC3Effects = Method->getObjC3FunctionEffects();
+    return S.Context.getFunctionType(Method->getReturnType(), Types, Info)
+        ->castAs<FunctionProtoType>();
+  }
+  return nullptr;
+}
+} // namespace
+
+ExprResult Sema::BuildObjC3IsolationAwaitOperand(SourceLocation Loc,
+                                                 Expr *Operand) {
+  // A known class-template member can still have dependent parameter/result
+  // storage or a dependent receiver. Rebuild its entry after substitution.
+  if (getLangOpts().CPlusPlus && Operand->isInstantiationDependent()) return Operand;
+  auto *Source = Operand->IgnoreImplicit()->IgnoreParenImpCasts();
+  if (isa<ObjCPropertyRefExpr>(Source)) {
+    auto Converted = DefaultLvalueConversion(Operand);
+    if (Converted.isInvalid()) return ExprError();
+    Operand = Converted.get();
+    Source = Operand->IgnoreImplicit()->IgnoreParenImpCasts();
+  }
+  auto Property = propertyOperation(Source);
+  auto *Call = dyn_cast<CallExpr>(Source);
+  auto *Message = dyn_cast<ObjCMessageExpr>(Source);
+  const Decl *Target = Property ? (Property->writes() ? Property->Setter : Property->Getter)
+                       : Call ? static_cast<const Decl *>(Call->getDirectCallee())
+                       : Message ? Message->getMethodDecl() : nullptr;
+  auto *Callable = Decl::castFromDeclContext(CurContext);
+  const auto *Executor = getObjC3Executor(Target);
+  const auto *Current = getObjC3Executor(Callable);
+  bool ActorEntry = (Message || Property) && isObjC3ActorIsolated(Target);
+  bool PropertyContract = true;
+  SmallVector<const ObjCMethodDecl *, 2> Accessors;
+  if (Property) {
+    if (Property->reads()) Accessors.push_back(Property->Getter);
+    if (Property->writes()) Accessors.push_back(Property->Setter);
+    for (const auto *Accessor : Accessors) {
+      ActorEntry |= isObjC3ActorIsolated(Accessor);
+      if (const auto *Required = getObjC3Executor(Accessor)) {
+        if (Executor && Executor->getExecutor() != Required->getExecutor()) PropertyContract = false;
+        else Executor = Required;
+      }
+    }
+  }
+  bool SameActor = false;
+  if (Property) {
+    SameActor = currentActorReceiver(Callable,
+        Property->Reference->isObjectReceiver()
+            ? propertyInput(Property->Reference->getBase()) : nullptr,
+        Property->Reference->isSuperReceiver());
+  } else if (Message) SameActor = sameCurrentActor(Callable, Message);
+  bool Crossing = (ActorEntry && !SameActor) ||
+                  (Executor && (!Current || Current->getExecutor() !=
+                                                Executor->getExecutor()));
+  const auto *FT = isolationCalleeFunctionType(*this, Target);
+  if (Crossing && ((Target && Target->hasAttr<ObjCReturnsInnerPointerAttr>()) ||
+                   (Property && Property->reads() && Property->Getter->hasAttr<ObjCReturnsInnerPointerAttr>()))) {
+    Diag(Loc, getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+        "isolated entry cannot transfer a receiver-owned interior view; copy to independent owned storage inside the executor"));
+    return ExprError();
+  }
+  bool PropertyNeedsFrame = false;
+  if (Property && FT) {
+    for (const auto *Accessor : Accessors) {
+      const auto Effects = Accessor->getObjC3FunctionEffects();
+      PropertyNeedsFrame |= Effects.Async || Effects.Throws != ObjC3ThrowsKind::None;
+    }
+    if (const auto *ResultMessage = dyn_cast<ObjCMessageExpr>(getObjC3AsyncSourceCall(Source));
+        ResultMessage && ResultMessage->getMethodDecl()->getObjC3FunctionEffects().Async)
+      Property->Result = getObjC3AsyncAwaitFunctionType(*this, Source)->getReturnType();
+    SmallVector<QualType, 1> Types;
+    if (Property->RHS) Types.push_back(Property->RHS->getType());
+    auto Info = FT->getExtProtoInfo();
+    // Accessors suspend individually inside the composed native frame.
+    Info.ObjC3Effects.Async = Info.ObjC3Effects.AsyncFrame = false;
+    // A compound operation checks the getter before the setter. Their error
+    // contracts must agree; a nonthrowing half contributes no extra effect.
+    for (const auto *Accessor : Accessors) {
+      const auto Effects = Accessor->getObjC3FunctionEffects();
+      if (Effects.Throws == ObjC3ThrowsKind::None) continue;
+      if (Info.ObjC3Effects.Throws == ObjC3ThrowsKind::None) {
+        Info.ObjC3Effects.Throws = Effects.Throws;
+        Info.ObjC3Effects.ErrorType = Effects.ErrorType;
+      } else if (Info.ObjC3Effects.Throws != Effects.Throws ||
+                 (Effects.Throws == ObjC3ThrowsKind::Typed &&
+                  !Context.hasSameType(Info.ObjC3Effects.ErrorType, Effects.ErrorType)))
+        PropertyContract = false;
+    }
+    if (Types.empty()) Info.ExtParameterInfos = nullptr;
+    FT = Context.getFunctionType(Property->Result, Types, Info)->castAs<FunctionProtoType>();
+  }
+  if (Message && FT && cast<ObjCMethodDecl>(Target)->hasRelatedResultType()) {
+    // Preserve the source send's instantiated class/generic result rather than
+    // erasing instancetype to the method declaration's logical id spelling.
+    QualType Logical = Message->getType();
+    if (FT->getObjC3FunctionEffects().Async)
+      Logical = getObjC3AsyncAwaitFunctionType(*this, Message)->getReturnType();
+    FT = Context.getFunctionType(Logical, FT->param_types(),
+                                  FT->getExtProtoInfo())->castAs<FunctionProtoType>();
+  }
+  if ((!Crossing && !PropertyNeedsFrame) || !FT ||
+      (!getLangOpts().CPlusPlus && FT->getObjC3FunctionEffects().Async &&
+       !FT->getObjC3FunctionEffects().AsyncFrame)) {
+    if (DiagnoseObjC3AwaitIsolation(Operand))
+      return ExprError();
+    return Operand;
+  }
+  ObjCMethodDecl *SuperContext = nullptr;
+  Expr *SourceReceiver = Property && Property->Reference->isObjectReceiver()
+      ? propertyInput(Property->Reference->getBase())
+      : Message ? Message->getInstanceReceiver() : nullptr;
+  const auto *CxxMethod = dyn_cast_or_null<CXXMethodDecl>(Target);
+  const auto *MemberCall = dyn_cast_or_null<CXXMemberCallExpr>(Call);
+  const auto *Member = Call
+      ? dyn_cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts()) : nullptr;
+  const bool StaticMember = CxxMethod && CxxMethod->isStatic() && Member;
+  const bool CxxReceiver = CxxMethod && !CxxMethod->isStatic() && MemberCall && Member;
+  if (CxxReceiver) {
+    SourceReceiver = Member->getBase();
+    if (!Member->isArrow())
+      // The original call already materialized a temporary receiver. Its
+      // ordinary full-expression cleanup remains on the awaiting caller;
+      // the private frame borrows that exact object instead of copying it.
+      SourceReceiver = UnaryOperator::Create(Context, SourceReceiver, UO_AddrOf,
+          Context.getPointerType(SourceReceiver->getType()), VK_PRValue,
+          OK_Ordinary, Loc, false, FPOptionsOverride());
+  }
+  if (Property && Property->Reference->isSuperReceiver()) {
+    SuperContext = getCurMethodDecl();
+    if (SuperContext) SourceReceiver = BuildDeclRefExpr(SuperContext->getSelfDecl(),
+        SuperContext->getSelfDecl()->getType(), VK_LValue, Loc);
+  }
+  if (Message && (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance ||
+                  Message->getReceiverKind() == ObjCMessageExpr::SuperClass)) {
+    SuperContext = getCurMethodDecl();
+    if (SuperContext)
+      SourceReceiver = BuildDeclRefExpr(SuperContext->getSelfDecl(),
+          SuperContext->getSelfDecl()->getType(), VK_LValue, Message->getSuperLoc());
+  }
+  SmallVector<Expr *, 4> SourceArguments;
+  if (Property) {
+    if (Property->RHS) {
+      Expr *RHS = Property->RHS;
+      if (getLangOpts().CPlusPlus && RHS->getType()->isRecordType() &&
+          !RHS->getType().isTriviallyCopyableType(Context)) {
+        // A property pseudo-object retains its source RHS rather than the
+        // setter's by-value construction. Build that typed snapshot before
+        // evaluating a later receiver, including throwing/deleted operations.
+        ExprResult Copy = PerformCopyInitialization(
+            InitializedEntity::InitializeTemporary(RHS->getType()), Loc, RHS);
+        if (Copy.isInvalid()) return ExprError();
+        RHS = Copy.get();
+      }
+      SourceArguments.push_back(RHS);
+    }
+  } else if (Call)
+    llvm::append_range(SourceArguments, Call->arguments());
+  else
+    llvm::append_range(SourceArguments, Message->arguments());
+  // Preserve pre-call argument evaluation on the caller. A nested crossing is
+  // never authorized merely because the outer call has an explicit await.
+  IsolationBodyChecker Arguments(*this, Callable, true);
+  if (SourceReceiver)
+    Arguments.Visit(SourceReceiver);
+  else if (StaticMember)
+    Arguments.Visit(Member->getBase());
+  for (auto *Argument : SourceArguments)
+    Arguments.Visit(Argument);
+  if (Arguments.failed())
+    return ExprError();
+  ArrayRef<ParmVarDecl *> TargetParameters = Message || Property
+      ? cast<ObjCMethodDecl>(Target)->parameters()
+      : cast<FunctionDecl>(Target)->parameters();
+  bool Shape = !FT->isVariadic() &&
+               FT->getNumParams() == SourceArguments.size() &&
+               isolationFrameValue(*this, FT->getReturnType(), true) &&
+               (!getLangOpts().CPlusPlus || FT->isNothrow() ||
+                Target->hasAttr<NoThrowAttr>() || hasExceptionCaptureHook(*this));
+  for (QualType T : FT->param_types())
+    Shape &= isolationFrameValue(*this, T, false);
+  if (Property) {
+    Shape &= PropertyContract;
+    for (const auto *Accessor : Accessors) {
+      const auto *Signature = isolationCalleeFunctionType(*this, Accessor);
+      Shape &= Signature && !Signature->isVariadic() &&
+          (!getLangOpts().CPlusPlus || Signature->isNothrow() ||
+           Accessor->hasAttr<NoThrowAttr>() || hasExceptionCaptureHook(*this));
+    }
+    if (Property->writes()) {
+      unsigned Budget = 256;
+      llvm::SmallPtrSet<const Type *, 32> Seen;
+      Shape &= propertyWriteValue(*this, Property->Result, Budget, Seen);
+      if (Property->RHS) Shape &= propertyWriteValue(*this, Property->RHS->getType(), Budget, Seen);
+      if (Property->reads()) {
+        Shape &= Property->Result->isArithmeticType() || Property->Result->isEnumeralType() ||
+                 Property->Result->isPointerType();
+        if (Property->RHS) Shape &= Property->RHS->getType()->isArithmeticType() ||
+                                  Property->RHS->getType()->isEnumeralType();
+      }
+    }
+  } else if (Call) {
+    const auto *Method = dyn_cast<CXXMethodDecl>(Target);
+    Shape &= CxxReceiver || StaticMember || ((!Method || Method->isStatic()) &&
+             isa<DeclRefExpr>(Call->getCallee()->IgnoreParenImpCasts()));
+  } else {
+    const bool Instance =
+        Message->getReceiverKind() == ObjCMessageExpr::Instance ||
+        (SuperContext && Message->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+    const bool NamedClass =
+        Message->getReceiverKind() == ObjCMessageExpr::Class ||
+        (SuperContext && Message->getReceiverKind() == ObjCMessageExpr::SuperClass);
+    Shape &=
+        ((Instance &&
+          SourceReceiver->getType()->isObjCObjectPointerType()) ||
+         (NamedClass && !isolationConsumesReceiver(Target)));
+  }
+  for (unsigned I = 0; I != FT->getNumParams(); ++I)
+    Shape &= !unsupportedIsolatedConsumption(
+        *this, FT->getParamType(I),
+        I < TargetParameters.size() ? TargetParameters[I] : nullptr,
+        FT->getExtParameterInfo(I));
+  if (Target->hasAttr<CFReturnsRetainedAttr>() || Target->hasAttr<CFReturnsNotRetainedAttr>())
+    Shape &= hasObjC3CFResultOwnership(Target);
+  if (!Shape) {
+    Diag(Loc, diag::err_objc3_isolation_hop_shape);
+    Diag(Target->getLocation(), diag::note_objc3_sendable_boundary);
+    return ExprError();
+  }
+  bool Failed = false;
+  if (Crossing) {
+  if (CxxReceiver)
+    Failed |= checkTransfer(*this, SourceReceiver->getType()->getPointeeType(),
+                            SourceReceiver->getExprLoc(), "shared isolated C++ receiver", Target, true);
+  else if (SourceReceiver && (!Message || Message->getReceiverKind() != ObjCMessageExpr::SuperClass))
+    Failed |= checkTransferValue(*this,SourceReceiver,transferSource(SourceReceiver)->getType(),
+                                 "isolated receiver",Target);
+  for (const Expr *Argument : SourceArguments)
+    Failed |=
+        checkTransferValue(*this,Argument,transferSource(Argument)->getType(),
+                           "isolated argument",Target);
+  Failed |=
+      checkTransfer(*this, FT->getReturnType(), Loc, "isolated result", Target);
+  if (FT->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::Typed)
+    Failed |= checkTransfer(*this, FT->getObjC3FunctionEffects().ErrorType, Loc,
+                            "isolated checked error", Target);
+  }
+  if (Failed)
+    return ExprError();
+  if (getLangOpts().ObjCAutoRefCount) {
+    for (unsigned I = 0; I != SourceArguments.size(); ++I)
+      if (FT->isParamConsumed(I) || (I < TargetParameters.size() &&
+          TargetParameters[I]->hasAttr<NSConsumedAttr>()))
+        SourceArguments[I] = uninitializeConsumedArgument(SourceArguments[I]);
+  }
+  auto *Thunk =
+      buildIsolationThunk(*this, Source, SourceReceiver, Target, FT, Executor,
+                          ActorEntry, SuperContext, Loc, Property ? &*Property : nullptr);
+  if (!Thunk)
+    return ExprError();
+  ExprResult Callee = BuildDeclRefExpr(Thunk, Thunk->getType(), VK_LValue, Loc);
+  // Bind source-order arguments (and a message receiver) before lazy frame
+  // creation. CodeGen acquires each retainable operand independently in both
+  // ownership modes; later arguments cannot invalidate an evaluated value.
+  SmallVector<Expr *, 4> Semantics;
+  SmallVector<Expr *, 4> Captures;
+  auto Capture = [&](Expr *Value) {
+    ExprResult Loaded = DefaultFunctionArrayLvalueConversion(Value);
+    if (Loaded.isInvalid()) return false;
+    Value = Loaded.get();
+    if (getLangOpts().CPlusPlus && Value->getType()->isRecordType() &&
+        !Value->getType().isTriviallyCopyableType(Context) && Value->isPRValue()) {
+      // The original call has already constructed this argument. Materialize
+      // its snapshot and move into the thunk's independent value parameter;
+      // an aggregate prvalue OVE would otherwise request a raw byte copy.
+      Value = CreateMaterializeTemporaryExpr(Value->getType(), Value, false);
+      Cleanup.setExprNeedsCleanups(true);
+    }
+    if (Value->getType()->isObjCRetainableType())
+      Cleanup.setExprNeedsCleanups(true);
+    auto *Opaque = new (Context)
+        OpaqueValueExpr(Value->getExprLoc(), Value->getType(),
+                        Value->getValueKind(), Value->getObjectKind(), Value);
+    Semantics.push_back(Opaque);
+    Captures.push_back(Opaque);
+    return true;
+  };
+  if (StaticMember) {
+    Expr *Base = Member->getBase();
+    // A static call through an object evaluates that base before its arguments,
+    // without copying it or transporting it to the destination executor.
+    Semantics.push_back(new (Context) OpaqueValueExpr(Base->getExprLoc(),
+        Base->getType(), Base->getValueKind(), Base->getObjectKind(), Base));
+  }
+  if (Property && Property->RHSFirst) {
+    if (!Capture(SourceArguments.front())) return ExprError();
+  }
+  if (SourceReceiver &&
+      !Capture(isolationConsumesReceiver(Target)
+                   ? uninitializeConsumedArgument(SourceReceiver)
+                   : SourceReceiver))
+    return ExprError();
+  for (unsigned I = 0; I != SourceArguments.size(); ++I) {
+    if (FT->getExtParameterInfo(I).isCFConsumed() ||
+        (I < TargetParameters.size() && TargetParameters[I]->hasAttr<CFConsumedAttr>()))
+      Cleanup.setExprNeedsCleanups(true);
+    if ((!Property || !Property->RHSFirst) && !Capture(SourceArguments[I])) return ExprError();
+  }
+  if (Property && Property->RHSFirst && SourceReceiver)
+    std::swap(Captures[0], Captures[1]);
+  ExprResult Frame = BuildCallExpr(nullptr, Callee.get(), Loc, Captures, Loc);
+  if (Frame.isInvalid())
+    return ExprError();
+  unsigned ResultIndex = Semantics.size();
+  Semantics.push_back(Frame.get());
+  return PseudoObjectExpr::Create(Context, Operand, Semantics, ResultIndex);
+}
+
+bool Sema::isObjC3NonSuspendingAwait(Expr *Operand) {
+  if (!Operand || Operand->isInstantiationDependent())
+    return false;
+  if (getLangOpts().CPlusPlus) {
+    QualType T = Operand->getType();
+    if (!T->isVoidType() && !T->isArithmeticType() && !T->isPointerType() &&
+        !T->isNullPtrType() && !T->isObjCObjectPointerType() &&
+        !T->isBlockPointerType())
+      return false;
+    if (T->isEnumeralType())
+      return false; // May have ADL operator co_await.
+  }
+  NonSuspendingAwaitProof Proof(Context);
+  Proof.Visit(Operand);
+  return Proof.Proven;
+}
+
+ExprResult Sema::ActOnObjC3NonSuspendingAwait(SourceLocation Loc,
+                                              Expr *Operand) {
+  if (getLangOpts().ObjC3StrictConcurrency)
+    Diag(Loc, diag::warn_objc3_unnecessary_c_await);
+  return Operand;
+}
