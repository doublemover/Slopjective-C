+    auto Flow=Visit(Visit,Body,Depth+1,false);
+    if(!Flow || *Flow!=Returned)return false;
+    for(const auto &Binding:Bindings)
+      for(unsigned I=0;I!=Call->getNumArgs();++I)if(Binding.second&(uint32_t(1)<<I)) {
+        if(!Budget)return false;--Budget;
+        FactoryCaptures->push_back({Call->getArg(I),Definition->getParamDecl(I),Binding.first,Function->getParamDecl(I)->getType()});
+      }
+    return true;
+  }
+
+  bool collectBinding(const VarDecl *Variable, unsigned Depth) {
+    if (!Variable || !Variable->hasInit() ||
+        Variable->getType().isVolatileQualified() || Depth>64)return false;
+    if(!Variable->isLocalVarDecl()) {
+      // Only immutable definitions with a closed native binding can supply
+      // a global environment. An external declaration or replaceable symbol
+      // does not prove the initializer that will execute.
+      if(!Variable->hasGlobalStorage() || !Variable->getType().isConstQualified() ||
+          (Variable->isExternallyVisible() && !Variable->isInline()) ||
+          Variable->hasAttr<WeakAttr>() || Variable->hasAttr<WeakRefAttr>() ||
+          Variable->hasAttr<WeakImportAttr>() || Variable->hasAttr<SelectAnyAttr>())return false;
+    }
+    if (CompleteBindings.contains(Variable))return true;
+    if (!ActiveBindings.insert(Variable).second)return true;
+    llvm::SaveAndRestore<const VarDecl *> Owner(InitializerOwner,nullptr);
+    const bool Proven=[&]() {
+    if (Variable->getType().isConstQualified())
+      return collectInitializer(Variable,Depth);
+    if (!ScopeBody || Variable->hasGlobalStorage() ||
+        Variable->hasAttr<BlocksAttr>() || !Variable->getType()->isBlockPointerType())return false;
+    // All possible writes contribute environments. Addresses and reference
+    // bindings escape that closed set, so they cannot establish this proof.
+    enum Use { Unknown, Read, Write };
+    struct Entry {const Stmt *Node;Use Role;};
+    SmallVector<Entry,32> Pending{{ScopeBody,Unknown}};
+    SmallVector<const Expr *,8> Values;
+    bool FoundDefinition=false;
+    auto ContainsBinding=[&](const Stmt *Node) {
+      if(!Node)return false;
+      const auto &SM=Context.getSourceManager();
+      const auto Location=SM.getExpansionLoc(Variable->getLocation());
+      const auto Begin=SM.getExpansionLoc(Node->getBeginLoc());
+      const auto End=SM.getExpansionLoc(Node->getEndLoc());
+      if(Location.isInvalid() || Begin.isInvalid() || End.isInvalid() ||
+          SM.getFileID(Begin)!=SM.getFileID(End))return true;
+      return SM.getFileID(Location)==SM.getFileID(Begin) && SM.isPointWithin(Location,Begin,End);
+    };
+    while (!Pending.empty()) {
+      const auto [Node,Role]=Pending.pop_back_val();
+      if (!Node)continue;
+      if (!ScanBudget)return false;
+      --ScanBudget;
+      if (isa<GotoStmt,IndirectGotoStmt,GCCAsmStmt>(Node))return false;
+      if (const auto *Declarations=dyn_cast<DeclStmt>(Node))
+        for (const auto *D:Declarations->decls())FoundDefinition|=D==Variable;
+      if (const auto *Reference=dyn_cast<DeclRefExpr>(Node)) {
+        if (Reference->getDecl()==Variable && Role==Unknown)return false;
+        continue;
+      }
+      if (const auto *Block=dyn_cast<BlockExpr>(Node)) {
+        for (const auto &Capture:Block->getBlockDecl()->captures()) {
+          if (Capture.getVariable()==Variable && Capture.isByRef())return false;
+          if (const auto *Init=Capture.getObjC3InitExpr())Pending.push_back({Init,Unknown});
+        }
+        continue; // Closure bodies mutate their own copied environments.
+      }
+      if (const auto *Lambda=dyn_cast<LambdaExpr>(Node)) {
+        for (const auto &Capture:Lambda->captures())
+          if (Capture.capturesVariable() && Capture.getCapturedVar()==Variable &&
+              Capture.getCaptureKind()==LCK_ByRef)return false;
+        for (const auto *Init:Lambda->capture_inits())Pending.push_back({Init,Unknown});
+        continue;
+      }
+      if (isa<UnaryExprOrTypeTraitExpr,CXXNoexceptExpr,RequiresExpr>(Node))continue;
+      if(const auto *Branch=dyn_cast<IfStmt>(Node)) {
+        Pending.push_back({Branch->getInit(),Unknown});
+        Pending.push_back({Branch->getConditionVariableDeclStmt(),Unknown});
+        const auto *Condition=Branch->getCond();Pending.push_back({Condition,Unknown});bool Truth;
+        if(Condition && !Condition->HasSideEffects(Context) &&
+            Condition->EvaluateAsBooleanCondition(Truth,Context)) {
+          Pending.push_back({Truth?Branch->getThen():Branch->getElse(),Unknown});
+          const auto *Discarded=Truth?Branch->getElse():Branch->getThen();
+          if(ContainsBinding(Discarded))Pending.push_back({Discarded,Unknown});
+        }
+        else {Pending.push_back({Branch->getThen(),Unknown});Pending.push_back({Branch->getElse(),Unknown});}
+        continue;
+      }
+      if(const auto *Loop=dyn_cast<WhileStmt>(Node)) {
+        Pending.push_back({Loop->getConditionVariableDeclStmt(),Unknown});
+        Pending.push_back({Loop->getCond(),Unknown});bool Truth;
+        if(Loop->getCond()->HasSideEffects(Context) ||
+            !Loop->getCond()->EvaluateAsBooleanCondition(Truth,Context) || Truth || ContainsBinding(Loop->getBody()))
+          Pending.push_back({Loop->getBody(),Unknown});
+        continue;
+      }
+      if(const auto *Loop=dyn_cast<ForStmt>(Node)) {
+        Pending.push_back({Loop->getInit(),Unknown});
+        Pending.push_back({Loop->getConditionVariableDeclStmt(),Unknown});
+        Pending.push_back({Loop->getCond(),Unknown});bool Truth;
+        if(!Loop->getCond() || Loop->getCond()->HasSideEffects(Context) ||
+            !Loop->getCond()->EvaluateAsBooleanCondition(Truth,Context) || Truth || ContainsBinding(Loop->getBody())) {
+          Pending.push_back({Loop->getInc(),Unknown});Pending.push_back({Loop->getBody(),Unknown});
+        }
+        continue;
+      }
+      if(const auto *Choice=dyn_cast<ChooseExpr>(Node);Choice && !Choice->isConditionDependent() && !ContainsBinding(Node)) {
+        Pending.push_back({Choice->getChosenSubExpr(),Role});continue;
+      }
+      if(const auto *Generic=dyn_cast<GenericSelectionExpr>(Node);Generic && !Generic->isResultDependent() && !ContainsBinding(Node)) {
+        Pending.push_back({Generic->getResultExpr(),Role});continue;
+      }
+      if(const auto *Binary=dyn_cast<BinaryOperator>(Node);Binary && Binary->isLogicalOp()) {
+        Pending.push_back({Binary->getLHS(),Unknown});bool Truth;
+        if(Binary->getLHS()->HasSideEffects(Context) ||
+            !Binary->getLHS()->EvaluateAsBooleanCondition(Truth,Context) ||
+            (Binary->getOpcode()==BO_LAnd?Truth:!Truth) || ContainsBinding(Binary->getRHS()))Pending.push_back({Binary->getRHS(),Unknown});
+        continue;
+      }
+      if (const auto *Paren=dyn_cast<ParenExpr>(Node)) {Pending.push_back({Paren->getSubExpr(),Role});continue;}
+      if (const auto *Cleanup=dyn_cast<ExprWithCleanups>(Node)) {Pending.push_back({Cleanup->getSubExpr(),Role});continue;}
+      if (const auto *Opaque=dyn_cast<OpaqueValueExpr>(Node)) {Pending.push_back({Opaque->getSourceExpr(),Role});continue;}
+      if (const auto *Default=dyn_cast<CXXDefaultArgExpr>(Node)) {Pending.push_back({Default->getExpr(),Unknown});continue;}
+      if (const auto *Default=dyn_cast<CXXDefaultInitExpr>(Node)) {Pending.push_back({Default->getExpr(),Unknown});continue;}
+      if (const auto *Cast=dyn_cast<CastExpr>(Node)) {
+        const bool Reads=Cast->getCastKind()==CK_LValueToRValue || Cast->getCastKind()==CK_ToVoid ||
+                         (Role==Read && Cast->isGLValue() && Cast->getCastKind()==CK_NoOp);
+        Pending.push_back({Cast->getSubExpr(),Reads?Read:Unknown});continue;
+      }
+      if(const auto *Call=dyn_cast<CallExpr>(Node))
+        if(argumentProjection(Call,Context,true)) {
+          // The complete helper proof forbids parameter writes/escapes. Even
+          // a reference argument is a read of its caller's Block environment.
+          for(const auto *Argument:Call->arguments())Pending.push_back({Argument,Read});
+          continue;
+        }
+      if (const auto *Conditional=dyn_cast<AbstractConditionalOperator>(Node)) {
+        Pending.push_back({Conditional->getCond(),Unknown});bool Truth;
+        if(!Conditional->getCond()->HasSideEffects(Context) &&
+            Conditional->getCond()->EvaluateAsBooleanCondition(Truth,Context)) {
+          Pending.push_back({Truth?Conditional->getTrueExpr():Conditional->getFalseExpr(),Role==Read?Read:Unknown});
+          const auto *Discarded=Truth?Conditional->getFalseExpr():Conditional->getTrueExpr();
+          if(ContainsBinding(Discarded))Pending.push_back({Discarded,Role==Read?Read:Unknown});
+        }
+        else {Pending.push_back({Conditional->getTrueExpr(),Role==Read?Read:Unknown});
+          Pending.push_back({Conditional->getFalseExpr(),Role==Read?Read:Unknown});}
+        continue;
+      }
+      if (const auto *Comma=dyn_cast<BinaryOperator>(Node);Comma && Comma->getOpcode()==BO_Comma) {
+        Pending.push_back({Comma->getLHS(),Unknown});Pending.push_back({Comma->getRHS(),Role});continue;
+      }
+      if (const auto *Unary=dyn_cast<UnaryOperator>(Node);Unary && Unary->getOpcode()==UO_Extension) {
+        Pending.push_back({Unary->getSubExpr(),Role});continue;
+      }
+      if (const auto *Assignment=dyn_cast<BinaryOperator>(Node);
+          Assignment && Assignment->getOpcode()==BO_Assign) {
+        const auto *Reference=dyn_cast<DeclRefExpr>(Assignment->getLHS()->IgnoreParenImpCasts());
+        const bool Writes=Reference && Reference->getDecl()==Variable;
+        if (Writes)Values.push_back(Assignment->getRHS());
+        Pending.push_back({Assignment->getLHS(),Writes?Write:Unknown});
+        Pending.push_back({Assignment->getRHS(),Unknown});continue;
+      }
+      for (const Stmt *Child:Node->children())Pending.push_back({Child,Unknown});
+    }
+    if (!FoundDefinition)return false;
+    if (!collectInitializer(Variable,Depth))return false;
+    // Assignment cycles close over the union of all admitted environments.
+    // The separate initializer DAG must establish each binding first.
+    for (const Expr *Value:Values)if (!collect(Value,Depth+1))return false;
+    return true;
+    }();
+    ActiveBindings.erase(Variable);
+    if (Proven)CompleteBindings.insert(Variable);
+    return Proven;
+  }
+public:
+  ConcurrentBlockValues(ASTContext &C, SmallVectorImpl<const BlockExpr *> &B,
+                        const Stmt *Body=nullptr,SmallVectorImpl<FactoryCapture> *Captures=nullptr,Sema *S=nullptr)
+      : Context(C), Actions(S), Blocks(B), FactoryCaptures(Captures), ScopeBody(Body) {}
+  bool collectVariable(const VarDecl *Variable) {
+    return collectBinding(Variable,0) && initializersAcyclic();
+  }
+  bool collectRoot(const Expr *Expression) {
+    return collect(Expression) && initializersAcyclic();
+  }
+  bool collect(const Expr *E, unsigned Depth = 0) {
+    if (!E || Depth > 64) return false;
+    E = transferSource(E);prepare(E);
+    if (const auto *Reference=dyn_cast<DeclRefExpr>(E))
+      if (const auto *Variable=dyn_cast<VarDecl>(Reference->getDecl())) {
+        if (InitializerOwner) {
+          auto &Edges=InitializerEdges[InitializerOwner];
+          if (!llvm::is_contained(Edges,Variable))Edges.push_back(Variable);
+        }
+        if (ActiveBindings.contains(Variable))return true;
+      }
+    if (Complete.contains(E)) return true;
+    if (!Budget || !Active.insert(E).second) return false;
+    --Budget;
+    bool Proven = [&]() {
+      if (E->IgnoreParenCasts()->isNullPointerConstant(Context, Expr::NPC_ValueDependentIsNotNull))
+        return true;
+      if (const auto *Block = dyn_cast<BlockExpr>(E)) {
+        if (Added.insert(Block->getBlockDecl()).second) Blocks.push_back(Block);
+        return true;
+      }
+      if (const auto *Cleanup = dyn_cast<ExprWithCleanups>(E))
+        return collect(Cleanup->getSubExpr(), Depth + 1);
+      if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+        bool Truth;
+        if (!Conditional->getCond()->HasSideEffects(Context) &&
+            Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+          return collect(Truth ? Conditional->getTrueExpr() : Conditional->getFalseExpr(), Depth + 1);
+        return collect(Conditional->getTrueExpr(), Depth + 1) &&
+               collect(Conditional->getFalseExpr(), Depth + 1);
+      }
+      if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+        if (Binary->getOpcode() == BO_Comma || Binary->getOpcode() == BO_Assign)
+          return collect(Binary->getRHS(), Depth + 1);
+      if(const auto *Choice=dyn_cast<ChooseExpr>(E);Choice && !Choice->isConditionDependent())
+        return collect(Choice->getChosenSubExpr(),Depth+1);
+      if(const auto *Generic=dyn_cast<GenericSelectionExpr>(E);Generic && !Generic->isResultDependent())
+        return collect(Generic->getResultExpr(),Depth+1);
+      if (const auto *Statement = dyn_cast<StmtExpr>(E)) {
+        const auto *Body = Statement->getSubStmt();
+        return !Body->body_empty() &&
+               collect(dyn_cast<Expr>(Body->body_back()), Depth + 1);
+      }
+      if(const auto *Call=dyn_cast<CallExpr>(E))
+        if(auto Projection=argumentProjection(Call,Context,true)) {
+          for(unsigned I=0;I!=Call->getNumArgs();++I)
+            if(Projection->selects(I) && !collect(Call->getArg(I),Depth+1))return false;
+          return true;
+        }
+      if(const auto *Call=dyn_cast<CallExpr>(E);Call && collectFactory(Call,Depth+1))return true;
+      const auto *Reference = dyn_cast<DeclRefExpr>(E);
+      const auto *Variable = Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+      return collectBinding(Variable,Depth);
+    }();
+    Active.erase(E);
+    if (Proven) Complete.insert(E);
+    return Proven;
+  }
+};
+bool knownConcurrentBlocks(Sema &S, const Expr *E,
+                            SmallVectorImpl<const BlockExpr *> &Blocks,
+                            const Stmt *Body=nullptr,SmallVectorImpl<FactoryCapture> *Captures=nullptr) {
+  return ConcurrentBlockValues(S.Context, Blocks, Body,Captures,&S).collectRoot(E);
+}
+struct ConcurrentCaptureProof {
+  llvm::SmallPtrSet<const VarDecl *,32> FactoryBindings;
+  llvm::SmallPtrSet<const Expr *,16> ActiveFactoryValues;
+  llvm::SmallPtrSet<const BlockDecl *,16> Active, Complete;
+  unsigned Budget=256;
+};
+bool checkKnownConcurrentBlock(Sema &, const BlockExpr *, SourceLocation,
+                               bool, ConcurrentCaptureProof &,const Stmt *);
+bool checkFactoryCaptures(Sema &S,ArrayRef<FactoryCapture> Captures,const Stmt *Body,
+                           ConcurrentCaptureProof &Proof,unsigned Depth=0) {
+  bool Invalid=false;llvm::SmallPtrSet<const Expr *,32> CheckedValues;
+  // All symbolic bindings are established before checking nested environments.
+  // Their original actual values are checked on every invocation below.
+  for(const auto &Capture:Captures)if(Capture.Binding)Proof.FactoryBindings.insert(Capture.Binding);
+  for(const auto &Capture:Captures) {
+    const auto *Value=Capture.Value;if(!Value)continue;
+    if(!CheckedValues.insert(Value).second)continue;
+    auto Type=transferSource(Value)->getType();
+    if(Type->isFunctionType())Type=S.Context.getPointerType(Type);
+    if(!Proof.Budget || Depth>32 || !Proof.ActiveFactoryValues.insert(Value).second) {
+      Invalid|=checkTransfer(S,Type,Value->getExprLoc(),"bounded factory capture proof",Capture.Parameter,true);
+      continue;
+    }
+    --Proof.Budget;
+    auto Leave=llvm::scope_exit([&]{Proof.ActiveFactoryValues.erase(Value);});
+    bool UnprovenLifetime = false;
+    const bool Managed = carriesManagedResourceValue(
+        S.Context, Value, Body, nullptr, &S, false, &UnprovenLifetime);
+    const bool Borrowed = carriesManagedResourceValue(
+        S.Context, Value, Body, nullptr, &S, true);
+    const char *CaptureReason = Borrowed ? "borrowed capture" :
+        UnprovenLifetime && Type->isPointerType() ? "unverified capture lifetime" :
+        Managed ? "cleanup-managed capture" : "concurrent capture";
+    if(Capture.TransportType->isBlockPointerType()) {
+      if (Managed || Borrowed)
+        Invalid |= checkTransfer(S, Type, Value->getExprLoc(), CaptureReason,
+            Capture.Parameter, Managed, Borrowed, Body, Managed && !UnprovenLifetime);
+      SmallVector<const BlockExpr *,8> Blocks;SmallVector<FactoryCapture,8> Nested;
+      if(knownConcurrentBlocks(S,Value,Blocks,Body,&Nested)) {
+        Invalid|=checkFactoryCaptures(S,Nested,Body,Proof,Depth+1);
+        for(const auto *Block:Blocks)
+          Invalid|=checkKnownConcurrentBlock(S,Block,Value->getExprLoc(),false,Proof,Body);
+      } else if(unsafeAdmission(S.Context,Type))
+        Invalid|=checkTransfer(S,Type,Value->getExprLoc(),"unchecked concurrent block value",Capture.Parameter);
+      else if(strictConcurrency(S)) {
+        S.Diag(Value->getExprLoc(),diag::err_objc3_task_unknown_capture);Invalid=true;
+      } else checkTransfer(S,Type,Value->getExprLoc(),"unverified concurrent block capture",Capture.Parameter);
+    } else Invalid|=checkTransfer(S,Type,Value->getExprLoc(),
+        CaptureReason,Capture.Parameter,Managed,Borrowed,Body,Managed && !UnprovenLifetime);
+  }
+  for(const auto &Capture:Captures)if(Capture.Environment)
+    Invalid|=checkKnownConcurrentBlock(S,Capture.Environment,Capture.Environment->getExprLoc(),false,Proof,Body);
+  return Invalid;
+}
+
+bool isAsyncBlockType(QualType T) {
+  if (const auto *B = T->getAs<BlockPointerType>())
+    if (const auto *FT = B->getPointeeType()->getAs<FunctionProtoType>())
+      return FT->getObjC3FunctionEffects().Async;
+  return false;
+}
+bool asyncWorkPrototype(Sema &S, const FunctionProtoType *Prototype) {
+  if (!Prototype) return false;
+  if (Prototype->getObjC3FunctionEffects().Async) return true;
+  QualType Result = Prototype->getReturnType();
+  // A mutable task rvalue transfers its existing owner through release_native.
+  // Borrowed/const task references and raw frame references cannot transfer it.
+  const bool ReferenceResult = Result->isReferenceType();
+  if (ReferenceResult) {
+    if (!Result->isRValueReferenceType()) return false;
+    Result = Result.getNonReferenceType();
+    if (Result.isConstQualified() || Result.isVolatileQualified()) return false;
+  }
+  const auto *Record = Result->getAsRecordDecl();
+  if (!Record) return false;
+  if (Record->getDeclContext()->getRedeclContext()->isTranslationUnit() &&
+      Record->getIdentifier() && Record->getName() == "objc3_async_frame") {
+    FunctionProtoType::ExtProtoInfo Info;
+    Info.ObjC3Effects.Async = Info.ObjC3Effects.AsyncFrame = true;
+    const auto *FrameFunction = S.Context.getFunctionType(
+        S.Context.VoidTy, {}, Info)->castAs<FunctionProtoType>();
+    QualType Frame = S.BuildObjC3AsyncTaskType(FrameFunction,
+        Record->getLocation(), false);
+    return !ReferenceResult && !Frame.isNull() &&
+           S.Context.hasSameType(Result, Frame);
+  }
+  const auto *Class = dyn_cast<CXXRecordDecl>(Record);
+  return Class && Class->hasDefinition() &&
+      !Class->getDefinition()->lookup(&S.Context.Idents.get("promise_type")).empty();
+}
+bool asyncWorkType(Sema &S,QualType Type) {
+  Type=Type.getNonReferenceType();
+  if(Type->isDependentType())return S.getLangOpts().CPlusPlus;
+  if(Type->isBlockPointerType() || Type->isFunctionPointerType())
+    if(const auto *Prototype=Type->getPointeeType()->getAs<FunctionProtoType>())
+      return asyncWorkPrototype(S, Prototype);
+  const auto *Root=Type->getAsCXXRecordDecl();
+  if(!Root)return false;
+  llvm::SmallPtrSet<const CXXRecordDecl *,8> Seen;
+  SmallVector<const CXXRecordDecl *,8> Pending{Root};
+  while(!Pending.empty()) {
+    const auto *Record=Pending.pop_back_val();
+    if(!Seen.insert(Record).second || !Record->hasDefinition())continue;
+    Record=Record->getDefinition();
+    for(const auto *Declaration:Record->lookup(S.Context.DeclarationNames.getCXXOperatorName(OO_Call))) {
+      const auto *Function=dyn_cast<FunctionDecl>(Declaration);
+      if(const auto *Template=dyn_cast<FunctionTemplateDecl>(Declaration))Function=Template->getTemplatedDecl();
+      if(!Function)continue;
+      const auto *Prototype=Function->getType()->getAs<FunctionProtoType>();
+      if(!Prototype)continue;
+      if(asyncWorkPrototype(S, Prototype) ||
+          (Function->hasBody() && isa<CoroutineBodyStmt>(Function->getBody())))return true;
+    }
+    for(const auto &Base:Record->bases())
+      if(const auto *Parent=Base.getType()->getAsCXXRecordDecl())Pending.push_back(Parent);
+  }
+  return false;
+}
+bool hasAsyncWork(Sema &S,const Decl *Declaration) {
+  if(const auto *Function=dyn_cast<FunctionDecl>(Declaration))
+    for(const auto *Parameter:Function->parameters())
+      if(asyncWorkType(S,Parameter->getType()))return true;
+  if(const auto *Method=dyn_cast<ObjCMethodDecl>(Declaration))
+    for(const auto *Parameter:Method->parameters())
+      if(asyncWorkType(S,Parameter->getType()))return true;
+  return false;
+}
+
+bool isAsyncWorkParameter(const Decl *D, unsigned Index) {
+  if (const auto *F = dyn_cast<FunctionDecl>(D))
+    return Index < F->getNumParams() &&
+           isAsyncBlockType(F->getParamDecl(Index)->getType());
+  if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+    return Index < M->param_size() &&
+           isAsyncBlockType((M->param_begin()[Index])->getType());
+  return false;
+}
+bool isConcurrentWorkParameter(Sema &S, const Decl *D, unsigned Index) {
+  if (const auto *F = dyn_cast<FunctionDecl>(D))
+    return Index < F->getNumParams() &&
+           asyncWorkType(S, F->getParamDecl(Index)->getType());
+  if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+    return Index < M->param_size() &&
+           asyncWorkType(S, (M->param_begin()[Index])->getType());
+  return false;
+}
+bool checkKnownConcurrentBlock(Sema &, const BlockExpr *, SourceLocation,
+                               bool RequireAsync, ConcurrentCaptureProof &,
+                               const Stmt *ScopeBody);
+
+bool checkBoundarySignature(Sema &S, const ObjCMethodDecl *Method) {
+  QualType Result = Method->getReturnType();
+  if (Method->hasRelatedResultType())
+    if (const auto *Interface = Method->getClassInterface(); isObjC3Actor(Interface))
+      // instancetype is logically this actor's dynamic type, not an arbitrary
+      // id. Nonisolated construction/identity results transfer an actor ref.
+      Result = S.Context.getObjCObjectPointerType(
+          S.Context.getObjCInterfaceType(Interface));
+  bool Invalid =
+      checkTransfer(S, Result, Method->getLocation(),
+                    "nonisolated result", Method);
+  for (const auto *P : Method->parameters())
+    Invalid |= checkTransfer(S, P->getType(), P->getLocation(),
+                             "nonisolated parameter", Method);
+  auto Effects = Method->getObjC3FunctionEffects();
+  if (Effects.Throws == ObjC3ThrowsKind::Typed)
+    Invalid |= checkTransfer(S, Effects.ErrorType, Method->getLocation(),
+                             "nonisolated checked error", Method);
+  return Invalid;
+}
