+}
+struct ReceiverPointees {
+  SmallVector<const Expr *,4> Targets;
+  bool Closed=false;
+  bool Truncated=false;
+};
+// Follow immutable native pointer bindings without guessing through retargeted
+// slots. Keep known alternatives even when another conditional arm is opaque;
+// only a complete target set may establish write cells or a read-only alias.
+ReceiverPointees receiverPointees(ASTContext &Context,const Expr *Expression) {
+  ReceiverPointees Result;unsigned Work=128;
+  llvm::SmallPtrSet<const VarDecl *,16> Active;
+  auto Resolve=[&](auto &&Self,const Expr *E,unsigned Depth)->bool {
+    if(!E)return false;
+    if(!Work || Depth>32){Result.Truncated=true;return false;}
+    --Work;E=E->IgnoreParenImpCasts();
+    if(const auto *Opaque=dyn_cast<OpaqueValueExpr>(E))return Self(Self,Opaque->getSourceExpr(),Depth+1);
+    if(const auto *Conditional=dyn_cast<AbstractConditionalOperator>(E)) {
+      bool Truth;
+      if(!Conditional->getCond()->HasSideEffects(Context) &&
+          Conditional->getCond()->EvaluateAsBooleanCondition(Truth,Context))
+        return Self(Self,Truth?Conditional->getTrueExpr():Conditional->getFalseExpr(),Depth+1);
+      const bool Left=Self(Self,Conditional->getTrueExpr(),Depth+1);
+      const bool Right=Self(Self,Conditional->getFalseExpr(),Depth+1);return Left && Right;
+    }
+    if(const auto *Address=dyn_cast<UnaryOperator>(E);Address && Address->getOpcode()==UO_AddrOf) {
+      const auto *Target=Address->getSubExpr()->IgnoreParenImpCasts();
+      if(Target->HasSideEffects(Context) ||
+          !isa<DeclRefExpr,MemberExpr,ArraySubscriptExpr>(Target))return false;
+      if(!llvm::is_contained(Result.Targets,Target)) {
+        if(Result.Targets.size()==16){Result.Truncated=true;return false;}
+        Result.Targets.push_back(Target);
+      }
+      return true;
+    }
+    if(const auto *Call=dyn_cast<CallExpr>(E))
+      if(auto Field=fieldProjection(Call,Context);Field && Field->StorageAddress) {
+        if(Field->Arrow)return Self(Self,Field->Receiver,Depth+1);
+        const auto *Target=Field->Receiver->IgnoreParenImpCasts();
+        if(Target->HasSideEffects(Context) || !isa<DeclRefExpr,MemberExpr,ArraySubscriptExpr>(Target))return false;
+        if(!llvm::is_contained(Result.Targets,Target)) {
+          if(Result.Targets.size()==16){Result.Truncated=true;return false;}
+          Result.Targets.push_back(Target);
+        }
+        return true;
+      }
+    const auto *Reference=dyn_cast<DeclRefExpr>(E);
+    const auto *Variable=Reference?dyn_cast<VarDecl>(Reference->getDecl()):nullptr;
+    if(!Variable || !Variable->hasLocalStorage() || !Variable->hasInit())return false;
+    auto Type=Variable->getType().getNonReferenceType();
+    if(!Type->isPointerType() || !Type.isConstQualified() || Type.isVolatileQualified() ||
+        !Active.insert(Variable->getCanonicalDecl()).second)return false;
+    auto Leave=llvm::scope_exit([&]{Active.erase(Variable->getCanonicalDecl());});
+    return Self(Self,Variable->getInit(),Depth+1);
+  };
+  Result.Closed=Resolve(Resolve,Expression,0) && !Result.Targets.empty();return Result;
+}
+bool declaredManagedReceiver(ASTContext &Context,const Expr *Expression) {
+  unsigned Work=64;llvm::SmallPtrSet<const VarDecl *,16> Active;
+  auto Visit=[&](auto &&Self,const Expr *E)->bool {
+    if(!E || !Work)return false;--Work;E=E->IgnoreParenImpCasts();
+    if(getObjC3ResourceTypeContract(Context,E->getType()).Cleanup)return true;
+    if(const auto *Deref=dyn_cast<UnaryOperator>(E);Deref && Deref->getOpcode()==UO_Deref) {
+      for(const auto *Target:receiverPointees(Context,Deref->getSubExpr()).Targets)if(Self(Self,Target))return true;
+      return false;
+    }
+    if(const auto *Member=dyn_cast<MemberExpr>(E))
+      return managedTransferStorage(Member->getMemberDecl()) || (!Member->isArrow() && Self(Self,Member->getBase()));
+    const auto *Reference=dyn_cast<DeclRefExpr>(E);
+    const auto *Variable=Reference?dyn_cast<VarDecl>(Reference->getDecl()):nullptr;
+    if(!Variable)return false;
+    if(managedTransferStorage(Variable))return true;
+    if(Variable->getType()->isReferenceType() && Variable->hasInit() &&
+        Active.insert(Variable->getCanonicalDecl()).second)return Self(Self,Variable->getInit());
+    return false;
+  };
+  return Visit(Visit,Expression);
+}
