+using namespace clang;
+
+namespace {
+bool strictConcurrency(const Sema &S) {
+  return S.getLangOpts().ObjC3StrictConcurrency;
+}
+bool protocolIsSendable(const ObjCProtocolDecl *P,
+                        llvm::SmallPtrSetImpl<const ObjCProtocolDecl *> &Seen) {
+  if (!P || !Seen.insert(P->getCanonicalDecl()).second)
+    return false;
+  if (P->getIdentifier() && P->getName() == "Sendable")
+    return true;
+  for (const auto *Inherited : P->protocols())
+    if (protocolIsSendable(Inherited, Seen))
+      return true;
+  return false;
+}
+const ObjCUnsafeSendableAttr *unsafeAdmission(ASTContext &C, QualType T) {
+  while (!T.isNull()) {
+    if (const auto *Alias = dyn_cast<TypedefType>(T.getTypePtr()))
+      if (const auto *A = Alias->getDecl()->getAttr<ObjCUnsafeSendableAttr>())
+        return A;
+    if (const auto *Object = T->getAs<ObjCObjectPointerType>())
+      for (auto *I = Object->getInterfaceDecl(); I; I = I->getSuperClass()) {
+        const auto *Contract = I->getDefinition() ? I->getDefinition() : I;
+        if (const auto *A = Contract->getAttr<ObjCUnsafeSendableAttr>())
+          return A;
+        if (const auto *Implementation = I->getImplementation())
+          if (const auto *A = Implementation->getAttr<ObjCUnsafeSendableAttr>())
+            return A;
+      }
+    if (const auto *R = T->getAsRecordDecl()) {
+      const auto *Contract = R->getDefinition() ? R->getDefinition() : R;
+      if (const auto *A = Contract->getAttr<ObjCUnsafeSendableAttr>())
+        return A;
+    }
+    QualType Next = T.getSingleStepDesugaredType(C);
+    if (Next == T)
+      break;
+    T = Next;
+  }
+  return nullptr;
+}
+struct SendableResult {
+  bool Safe = false;
+  bool Unchecked = false;
+  bool Borrowed = false;
+  bool Resource = false;
+};
+bool carriesManagedResourceValue(ASTContext &, const Expr *, const Stmt * = nullptr,
+                                  const VarDecl * = nullptr, Sema * = nullptr, bool = false,
+                                  bool *UnprovenLifetime = nullptr);
+bool managedTransferStorage(const ValueDecl *Value) {
+  return Value && (Value->hasAttr<CleanupAttr>() ||
+      Value->hasAttr<ObjCCleanupAttr>() || Value->hasAttr<ObjCResourceAttr>());
+}
+class SendableClassifier {
+  ASTContext &C;
+  Sema *Actions;
+  const Stmt *ScopeBody;
+  llvm::SmallPtrSet<const Type *, 16> Active;
+
+public:
+  explicit SendableClassifier(ASTContext &C,Sema *Actions=nullptr,const Stmt *ScopeBody=nullptr) : C(C),Actions(Actions),ScopeBody(ScopeBody) {}
+  SendableResult classify(QualType T) {
+    if (T.isNull())
+      return {};
+    // Lifetime restrictions dominate unsafe admission, including borrowed
+    // subobjects of a wrapper that has promised Sendable conformance.
+    if (containsObjC3BorrowedType(C, T))
+      return {false, false, true};
+    bool Unchecked = unsafeAdmission(C, T);
+    bool Resource = getObjC3ResourceTypeContract(C, T).Cleanup;
+    if (Resource && !Unchecked)
+      return {false, false, false, true};
+    if (T->isReferenceType())
+      return {};
+    if (T->isDependentType())
+      return {true, Resource, false, Resource};
+    if (T->isVoidType())
+      return {true, Resource, false, Resource};
+    if (const auto *Optional = T->getAs<ObjC3OptionalType>()) {
+      auto Part = classify(Optional->getElementType());
+      if (Part.Borrowed)
+        return Part;
+      return {Part.Safe || Unchecked,
+              Part.Unchecked || (!Part.Safe && Unchecked), false,
+              Part.Resource || Resource};
+    }
+    if (const auto *Result = T->getAs<ObjC3ResultType>()) {
+      auto A = classify(Result->getSuccessType());
+      auto B = classify(Result->getErrorType());
+      bool Borrowed = A.Borrowed || B.Borrowed;
+      bool Safe = A.Safe && B.Safe;
+      return {!Borrowed && (Safe || Unchecked),
+              A.Unchecked || B.Unchecked || (!Safe && Unchecked), Borrowed,
+              A.Resource || B.Resource || Resource};
+    }
+    if (const auto *Array = C.getAsArrayType(T)) {
+      auto Part = classify(Array->getElementType());
+      if (Part.Borrowed)
+        return Part;
+      return {Part.Safe || Unchecked,
+              Part.Unchecked || (!Part.Safe && Unchecked), false,
+              Part.Resource || Resource};
+    }
+    // Class metadata is immutable; transferring a Class value does not transfer
+    // an instance or attest the instance type's Sendable conformance.
+    if (T->isObjCClassType())return {true, Resource, false, Resource};
+    if (const auto *Object = T->getAs<ObjCObjectPointerType>()) {
+      if (isObjC3Actor(Object->getInterfaceDecl()))
+        return {true, Resource, false, Resource};
+      llvm::SmallPtrSet<const ObjCProtocolDecl *, 16> Protocols;
+      for (const auto *P : Object->quals())
+        if (protocolIsSendable(P, Protocols))
+          return {true, Resource, false, Resource};
+      for (const auto *I = Object->getInterfaceDecl(); I;
+           I = I->getSuperClass())
+        for (const auto *P : I->all_referenced_protocols())
+          if (protocolIsSendable(P, Protocols))
+            return {true, Resource, false, Resource};
+      return {Unchecked, Unchecked, false, Resource};
+    }
+    // A block's type cannot attest its capture set. Literal checking below
+    // reasons about capture provenance rather than accepting all block types.
+    if (T->isBlockPointerType())
+      return {Unchecked, Unchecked, false, Resource};
+    if (const auto *Record = T->getAs<RecordType>()) {
+      const auto *Definition = Record->getDecl()->getDefinition();
+      if (!Definition)
+        return {Unchecked, Unchecked, false, Resource};
+      if (!Active.insert(Record).second)
+        return {};
+      bool Safe = true, ReliesOnPromise = Resource;
+      bool ResourceBearing = Resource;
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition)) {
+        // An implicit ARC destructor only releases the fields checked below.
+        // User-provided destruction still needs explicit unsafe admission.
+        Safe = (Class->isAggregate() || Class->isLambda()) &&
+               (!Class->hasNonTrivialDestructor() ||
+                !Class->hasUserDeclaredDestructor());
+        if (Class->isLambda()) {
+          llvm::DenseMap<const ValueDecl *, FieldDecl *> CaptureFields;
+          FieldDecl *ThisField = nullptr;
+          Class->getCaptureFields(CaptureFields, ThisField);
+          for (const auto &Capture : Class->captures()) {
+            if (Capture.capturesThis()) {
+              if (Capture.getCaptureKind() == LCK_This) {
+                // A copied this pointer shares the original object. Scalar
+                // pointer sendability cannot attest the pointee's safety.
+                bool Admitted = ThisField &&
+                    unsafeAdmission(C, ThisField->getType()->getPointeeType());
+                Safe &= Admitted;
+                ReliesOnPromise |= Admitted;
+              }
+              // [*this] is an independent value, classified by its field.
+              continue;
+            }
+            if (!Capture.capturesVariable()) continue;
+            const ValueDecl *Variable = Capture.getCapturedVar();
+            auto Found = CaptureFields.find(Variable);
+            QualType CaptureType = Found == CaptureFields.end()
+                ? Variable->getType() : Found->second->getType();
+            bool Unowned = CaptureType.getObjCLifetime() ==
+                Qualifiers::OCL_ExplicitNone ||
+                CaptureType->isObjCInertUnsafeUnretainedType() ||
+                Variable->getType()->isObjCInertUnsafeUnretainedType();
+            auto ManagedVariable = [](const ValueDecl *Value) {
+              return Value->hasAttr<CleanupAttr>() ||
+                  Value->hasAttr<ObjCCleanupAttr>() ||
+                  Value->hasAttr<ObjCResourceAttr>();
+            };
+            bool Managed = ManagedVariable(Variable);
+            if (const auto *InitCapture = dyn_cast<VarDecl>(Variable);
+                InitCapture && InitCapture->hasInit() &&
+                !InitCapture->getType().isNull()) {
+              const Expr *Init = InitCapture->getInit()->IgnoreParenImpCasts();
+              if(carriesManagedResourceValue(C,Init,ScopeBody,nullptr,Actions,true)) {
+                Active.erase(Record);return {false,false,true};
+              }
+              Managed |= carriesManagedResourceValue(C,Init);
+            }
+            ResourceBearing |= Managed;
+            if (Unowned || Managed) {
+              bool Admitted = unsafeAdmission(C, CaptureType);
+              Safe &= Admitted;
+              ReliesOnPromise |= Admitted;
+            }
+          }
+        }
+      }
+      for (const auto *Field : Definition->fields()) {
+        if (isObjC3BorrowedType(C, Field->getType())) {
+          Active.erase(Record);
+          return {false, false, true};
+        }
+        auto Part = classify(Field->getType());
+        if (Part.Borrowed) {
+          Active.erase(Record);
+          return Part;
+        }
+        Safe &= Part.Safe;
+        ReliesOnPromise |= Part.Unchecked;
+        ResourceBearing |= Part.Resource;
+      }
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+        for (const auto &Base : Class->bases()) {
+          auto Part = classify(Base.getType());
+          if (Part.Borrowed) {
+            Active.erase(Record);
+            return Part;
+          }
+          Safe &= Part.Safe;
+          ReliesOnPromise |= Part.Unchecked;
+          ResourceBearing |= Part.Resource;
+        }
+      Active.erase(Record);
+      return {Safe || Unchecked, ReliesOnPromise || (!Safe && Unchecked),
+              false, ResourceBearing};
+    }
+    // C scalars (including raw non-borrowed pointers) and enums are value-like.
+    if (T->isScalarType() || T->isVectorType())
+      return {true, Resource, false, Resource};
+    return {Unchecked, Unchecked, false, Resource};
+  }
+};
+
+bool checkTransfer(Sema &S, QualType T, SourceLocation Loc, StringRef Reason,
+                   const Decl *Boundary, bool ForceUnsafe = false,bool ForceBorrowed=false,
+                   const Stmt *ScopeBody=nullptr,bool ForceResource=false) {
+  auto Classification = SendableClassifier(S.Context,&S,ScopeBody).classify(T);
+  if(ForceBorrowed){Classification.Safe=false;Classification.Borrowed=true;}
+  if (ForceUnsafe && !unsafeAdmission(S.Context, T))
+    Classification.Safe = false;
+  if (!Classification.Safe) {
+    S.Diag(Loc, strictConcurrency(S) ? diag::err_objc3_sendable_transfer
+                                     : diag::warn_objc3_sendable_transfer)
+        << T << Reason;
+    if (Boundary)
+      S.Diag(Boundary->getLocation(), diag::note_objc3_sendable_boundary);
+    if (strictConcurrency(S) && Classification.Borrowed &&
+        unsafeAdmission(S.Context, T) &&
+        !S.getDiagnostics().getSuppressAllDiagnostics() &&
+        !S.getDiagnostics().hasFatalErrorOccurred())
+      S.getDiagnostics().Report(Loc,
+          diag::warn_objc3_unchecked_sendable_borrowed) << T;
+    return strictConcurrency(S);
+  }
+  if (strictConcurrency(S) && (Classification.Unchecked || ForceUnsafe) &&
+      !S.getDiagnostics().getSuppressAllDiagnostics() &&
+      !S.getDiagnostics().hasFatalErrorOccurred()) {
+    if (Classification.Resource || ForceResource)
+      S.getDiagnostics().Report(Loc,
+          diag::warn_objc3_unchecked_sendable_resource) << T;
+    // This is a required standalone transfer note, not a child of a preceding
+    // warning. Emit it even when the previous diagnostic was suppressed.
+    S.getDiagnostics().Report(Loc, diag::note_objc3_unchecked_sendable)
+        .setForceEmit() << T;
+  }
+  return false;
+}
+
+const Expr *transferSource(const Expr *E) {
+  for (;;) {
+    E = E->IgnoreParenImpCasts();
+    if (const auto *Default = dyn_cast<CXXDefaultArgExpr>(E)) {
+      E = Default->getExpr();
+      continue;
+    }
+    if (const auto *Default = dyn_cast<CXXDefaultInitExpr>(E)) {
+      E = Default->getExpr();
+      continue;
+    }
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      if (Opaque->getSourceExpr()) {
+        E = Opaque->getSourceExpr();
+        continue;
+      }
+    return E;
+  }
+}
+// These standard views return the same storage without reading, writing or
+// escaping it. Propagate the surrounding use instead of treating the reference
+// argument as an opaque call. Methods and multi-argument algorithms are excluded.
+bool standardReferenceView(const CallExpr *Call) {
+  if(!Call || Call->getNumArgs()!=1 || !Call->isGLValue())return false;
+  const auto *Function=Call->getDirectCallee();
+  if(!Function || isa<CXXMethodDecl>(Function) || !Function->isInStdNamespace() ||
+      !Function->getIdentifier())return false;
+  const auto Name=Function->getIdentifier()->getName();
+  return Name=="move" || Name=="forward" || Name=="forward_like" || Name=="as_const";
+}
+// Match only direct storage accesses. Promotion through a reference, address,
+// capture or a glvalue assignment result would let another source write it.
+SmallVector<const Expr *, 8>
+localCallableInitializers(const VarDecl *Variable, const Stmt *Body,
+                          unsigned &Budget) {
+  if (!Body || !Variable->hasLocalStorage() || Variable->getType()->isReferenceType() ||
+      !Variable->hasInit() || Variable->hasAttr<BlocksAttr>() ||
+      Variable->hasAttr<CleanupAttr>())
+    return {};
+  auto IsBinding = [&](const Expr *E) {
+    const auto *Ref = dyn_cast<DeclRefExpr>(E->IgnoreParens());
+    return Ref && Ref->getDecl() == Variable;
+  };
+  struct Use {
+    const Stmt *Node;
+    bool ReadsValue = false;
+    bool DiscardsResult = false;
+  };
+  SmallVector<Use, 32> Pending{{Body}};
+  SmallVector<const Expr *, 8> Values{Variable->getInit()};
+  bool Declared = false;
+  while (!Pending.empty()) {
+    const auto [Node, ReadsValue, DiscardsResult] = Pending.pop_back_val();
+    if (!Node)
+      continue;
+    if (!Budget)
+      return {};
+    --Budget;
+    if (isa<GotoStmt, IndirectGotoStmt, AsmStmt, StmtExpr, CapturedStmt>(Node))
+      return {};
+    if (const auto *Decls = dyn_cast<DeclStmt>(Node))
+      for (const auto *D : Decls->decls()) {
+        Declared |= D == Variable;
+        if (const auto *V = dyn_cast<VarDecl>(D);
+            V && V->getType()->isVariablyModifiedType())
+          return {};
+      }
+    if (const auto *Ref = dyn_cast<DeclRefExpr>(Node)) {
+      if (Ref->getDecl() == Variable && !ReadsValue)
+        return {};
+      continue;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        if (Capture.getVariable() == Variable)
+          return {};
+        Pending.push_back({Capture.getObjC3InitExpr()});
+      }
+      continue;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const auto &Capture : Lambda->captures())
+        if (Capture.capturesVariable() && Capture.getCapturedVar() == Variable)
+          return {};
+      for (const auto *Init : Lambda->capture_inits())
+        Pending.push_back({Init});
+      continue;
+    }
+    if (const auto *Assignment = dyn_cast<BinaryOperator>(Node);
+        Assignment && Assignment->getOpcode() == BO_Assign &&
+        IsBinding(Assignment->getLHS())) {
+      if ((Assignment->isGLValue() && !ReadsValue && !DiscardsResult) ||
+          Values.size() == 8)
+        return {};
+      Values.push_back(Assignment->getRHS());
+      Pending.push_back({Assignment->getRHS()});
+      continue;
+    }
+    if (const auto *Paren = dyn_cast<ParenExpr>(Node)) {
+      Pending.push_back({Paren->getSubExpr(), ReadsValue, DiscardsResult});
+      continue;
+    }
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Node)) {
+      Pending.push_back({Cleanups->getSubExpr(), ReadsValue, DiscardsResult});
+      continue;
+    }
+    if (const auto *Cast = dyn_cast<CastExpr>(Node)) {
+      const bool Reads = Cast->getCastKind() == CK_LValueToRValue ||
+                         Cast->getCastKind() == CK_ToVoid;
+      Pending.push_back({Cast->getSubExpr(), Reads});
+      continue;
+    }
+    if (const auto *If = dyn_cast<IfStmt>(Node)) {
+      Pending.push_back({If->getInit(), false, true});
+      Pending.push_back({If->getConditionVariableDeclStmt()});
+      Pending.push_back({If->getCond()});
+      Pending.push_back({If->getThen(), false, true});
+      Pending.push_back({If->getElse(), false, true});
+      continue;
+    }
+    for (const Stmt *Child : Node->children())
+      Pending.push_back({Child, false, isa<CompoundStmt>(Node)});
+  }
+  return Declared ? Values : SmallVector<const Expr *, 8>{};
+}
+
+using ProjectionCallees = SmallVector<const FunctionDecl *, 4>;
+using CallableInitializers =
+    llvm::function_ref<SmallVector<const Expr *, 8>(const VarDecl *)>;
+
+// Resolve every target of a closed native callable choice. The prototype,
+// including calling convention and effects, must match every target exactly.
+ProjectionCallees projectionCallees(const CallExpr *Call, ASTContext &Context,
+                                     CallableInitializers LocalSources = nullptr) {
+  const auto *MemberCall=dyn_cast<BinaryOperator>(Call->getCallee()->IgnoreParenImpCasts());
+  const bool MemberTarget=MemberCall && MemberCall->isPtrMemOp();
+  if (!MemberTarget)
+    if (const auto *Direct = Call->getDirectCallee()) return {Direct};
+  const Expr *Target=MemberTarget?MemberCall->getRHS():Call->getCallee();
+  const auto CalleeType=Target->getType();
+  const auto *MemberType=CalleeType->getAs<MemberPointerType>();
+  if(MemberTarget?!MemberType:(!CalleeType->isPointerType() || !CalleeType->getPointeeType()->isFunctionType()))return {};
+  const auto Prototype=MemberType?MemberType->getPointeeType():CalleeType->getPointeeType();
+  if(!Prototype->isFunctionType())return {};
+  unsigned Work=64;
+  llvm::SmallPtrSet<const VarDecl *,16> Active;
+  llvm::SmallPtrSet<const FunctionDecl *,8> Seen;
+  ProjectionCallees Targets;
+  auto Resolve=[&](auto &&Self,const Expr *E,unsigned Depth)->bool {
+    if(!E || !Work || Depth>16)return false;--Work;E=E->IgnoreParenImpCasts();
+    if(const auto *Cast=dyn_cast<CastExpr>(E))
+      return Cast->getCastKind()==CK_NoOp && Self(Self,Cast->getSubExpr(),Depth+1);
+    if(const auto *Unary=dyn_cast<UnaryOperator>(E);Unary && Unary->getOpcode()==UO_AddrOf)
+      return Self(Self,Unary->getSubExpr(),Depth+1);
+    if(const auto *View=dyn_cast<CallExpr>(E);View && standardReferenceView(View))
+      return Self(Self,View->getArg(0),Depth+1);
+    if(const auto *Choice=dyn_cast<AbstractConditionalOperator>(E)) {
+      if(Choice->getCond()->HasSideEffects(Context))return false;
+      bool Truth;
+      if(!Choice->getCond()->isValueDependent() && Choice->getCond()->EvaluateAsBooleanCondition(Truth,Context))
+        return Self(Self,Truth?Choice->getTrueExpr():Choice->getFalseExpr(),Depth+1);
+      return Self(Self,Choice->getTrueExpr(),Depth+1) &&
+             Self(Self,Choice->getFalseExpr(),Depth+1);
+    }
+    const auto *Reference=dyn_cast<DeclRefExpr>(E);
+    if(!Reference)return false;
+    if(const auto *Function=dyn_cast<FunctionDecl>(Reference->getDecl())) {
+      if(!Context.hasSameType(Function->getType(),Prototype))return false;
+      if(MemberTarget) {
+        const auto *Method=dyn_cast<CXXMethodDecl>(Function);
+        const auto *Owner=MemberType->getMostRecentCXXRecordDecl();
+        if(!Method || Method->isStatic() || !Owner ||
+            Owner->getCanonicalDecl()!=Method->getParent()->getCanonicalDecl())return false;
+      }
+      if(Seen.insert(Function->getCanonicalDecl()).second) {
+        if(Targets.size()==8)return false;
+        Targets.push_back(Function);
+      }
+      return true;
+    }
+    const auto *Variable=dyn_cast<VarDecl>(Reference->getDecl());
+    if(!Variable)return false;
+    const auto Value=Variable->getType().getNonReferenceType();
+    const auto *Member=Value->getAs<MemberPointerType>();
+    if((MemberTarget?(!Member || !Member->getPointeeType()->isFunctionType()):
+        (!Value->isPointerType() || !Value->getPointeeType()->isFunctionType())) ||
+        Value.isVolatileQualified() || Variable->hasAttr<BlocksAttr>())return false;
+    Variable=Variable->getCanonicalDecl();
+    if(!Active.insert(Variable).second)return false;
+    auto Leave=llvm::scope_exit([&]{Active.erase(Variable);});
+    if (Value.isConstQualified())
+      return Self(Self, Variable->getAnyInitializer(), Depth + 1);
+    if (!LocalSources)
+      return false;
+    const auto Sources = LocalSources(Variable);
+    return !Sources.empty() &&
+           llvm::all_of(Sources, [&](const Expr *Source) {
+             return Self(Self, Source, Depth + 1);
+           });
+  };
+  if (!Resolve(Resolve, Target, 0)) return {};
+  return Targets;
+}
+
+const FunctionDecl *projectionCallee(const CallExpr *Call, ASTContext &Context) {
+  auto Targets = projectionCallees(Call, Context);
+  return Targets.size() == 1 ? Targets.front() : nullptr;
+}
+
+bool closedProjectionReceiverImpl(const CallExpr *Call,ASTContext &Context,
+    unsigned &Work,unsigned Depth,llvm::SmallPtrSetImpl<const FunctionDecl *> &Active,
+    const FunctionDecl *Selected = nullptr) {
+  if(!Work || Depth>16)return false;--Work;
+  const auto *Function=Selected?Selected:(Call?projectionCallee(Call,Context):nullptr);
+  if(!Function)return false;
+  const auto *Method=dyn_cast<CXXMethodDecl>(Function);
+  if(!Method)return true;
+  const auto *Member=dyn_cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts());
+  const bool LambdaOperator=Method->isOverloadedOperator() && Method->getParent()->isLambda();
+  const auto *Indirect=dyn_cast<BinaryOperator>(Call->getCallee()->IgnoreParenImpCasts());
+  const bool IndirectMember=isa<CXXMemberCallExpr>(Call) && Indirect && Indirect->isPtrMemOp();
+  if((Method->isOverloadedOperator() && !LambdaOperator) || Method->isExplicitObjectMemberFunction())return false;
+  if(Member && Member->getBase()->HasSideEffects(Context))return false;
+  if(IndirectMember && Indirect->getLHS()->HasSideEffects(Context))return false;
+  if(LambdaOperator && !Method->isStatic() && isa<CXXOperatorCallExpr>(Call) && (!Call->getNumArgs() || Call->getArg(0)->HasSideEffects(Context)))return false;
+  if(Method->isStatic())return true;
+  // A qualified call suppresses virtual dispatch. Otherwise the selected
+  // method or its declaring class must be final before its body is a proof.
+  if((!Member && !LambdaOperator && !IndirectMember) || (Method->isVirtual() && (!Member || !Member->hasQualifier()) &&
+      !Method->hasAttr<FinalAttr>() && !Method->getParent()->hasAttr<FinalAttr>()))return false;
+  const auto *Definition=Method->getDefinition();
+  if(!Definition)if(const auto *Pattern=Method->getTemplateInstantiationPattern())
+    Definition=Pattern->getDefinition();
+  if(!Definition || !Definition->getBody() || Definition->isVariadic() ||
+      isa<CoroutineBodyStmt>(Definition->getBody()) || Definition->isMultiVersion() ||
+      Definition->isNoReturn() || getObjC3Executor(Definition) || isObjC3ActorIsolated(Definition) ||
+      (Definition->isExternallyVisible() && !Definition->isInlined()) ||
+      Definition->hasAttr<WeakAttr>() || Definition->hasAttr<WeakRefAttr>() ||
+      Definition->hasAttr<WeakImportAttr>() || Definition->hasAttr<AliasAttr>() ||
+      Definition->hasAttr<IFuncAttr>() || Definition->hasAttr<ReturnsTwiceAttr>())return false;
+  if(const auto *Type=getObjC3CallableFunctionType(Definition);
+      !Type || Type->getObjC3FunctionEffects().Async ||
+      Type->getObjC3FunctionEffects().Throws!=ObjC3ThrowsKind::None)return false;
+  if(!Active.insert(Definition->getCanonicalDecl()).second)return false;
+  auto Leave=llvm::scope_exit([&]{Active.erase(Definition->getCanonicalDecl());});
+  SmallVector<const Stmt *,32> Pending{Definition->getBody()};
+  while(!Pending.empty()) {
+    if(!Work)return false;--Work;
+    const auto *Statement=Pending.pop_back_val();
+    if(isa<CXXThisExpr>(Statement))return false;
+    auto Enqueue=[&](const Stmt *Child) {
+      if(!Child)return true;
+      if(Pending.size()>=Work)return false;
+      Pending.push_back(Child);return true;
+    };
+    if(const auto *Nested=dyn_cast<CallExpr>(Statement)) {
+      const auto *Callee=dyn_cast<MemberExpr>(Nested->getCallee()->IgnoreParenImpCasts());
+      if(Callee && isa<CXXThisExpr>(Callee->getBase()->IgnoreParenImpCasts())) {
+        // Forwarding this to another closed receiver body does not expose its
+        // identity or state. Arguments still undergo the ordinary this walk.
+        if(!closedProjectionReceiverImpl(Nested,Context,Work,Depth+1,Active))return false;
+        for(const auto *Argument:Nested->arguments())if(!Enqueue(Argument))return false;
+        continue;
+      }
+    }
+    if(const auto *Block=dyn_cast<BlockExpr>(Statement)) {
+      if(Block->getBlockDecl()->capturesCXXThis())return false;
+      if(!Enqueue(Block->getBody()))return false;
+    }
+    if(const auto *Lambda=dyn_cast<LambdaExpr>(Statement)) {
+      for(const auto &Capture:Lambda->captures())if(Capture.capturesThis())return false;
+      if(!Enqueue(Lambda->getBody()))return false;
+    }
+    for(const auto *Child:Statement->children())if(!Enqueue(Child))return false;
+  }
+  return true;
+}
+bool closedProjectionReceiver(const CallExpr *Call,ASTContext &Context,
+                              const FunctionDecl *Selected = nullptr) {
+  unsigned Work=1024;llvm::SmallPtrSet<const FunctionDecl *,16> Active;
+  return closedProjectionReceiverImpl(Call,Context,Work,0,Active,Selected);
+}
+// A closed accessor exposes exactly one native field, rather than attesting
+// an arbitrary method result. Keep its receiver storage contract when the
+// field's scalar type has erased a local cleanup attribute.
+struct FieldProjection {
+  const Expr *Receiver;
+  bool Managed;
+  bool Arrow;
+  bool Identity;
+  bool Borrowed;
+  bool Pointer;
+  bool StorageAddress;
+  SmallVector<const Expr *,4> ValueSources={};
+  SmallVector<const VarDecl *,4> ReceiverBindings={};
+};
+std::optional<FieldProjection> fieldProjectionImpl(const CallExpr *Call,ASTContext &Context,
+    unsigned &Work,unsigned Depth,llvm::SmallPtrSetImpl<const FunctionDecl *> &Active,Sema *Actions) {
+  if(!Work || Depth>16)return std::nullopt;--Work;
+  const auto *Method=Call?dyn_cast_or_null<CXXMethodDecl>(Call->getDirectCallee()):nullptr;
+  const auto *Member=Call?dyn_cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts()):nullptr;
+  const Expr *Receiver=Member?Member->getBase():nullptr;
+  bool Arrow=Member && Member->isArrow();
+  unsigned Arguments=Call?Call->getNumArgs():0;
+  if(const auto *Operator=dyn_cast_or_null<CXXOperatorCallExpr>(Call);
+      Operator && Method && Method->isOverloadedOperator() && Arguments==1) {
+    Receiver=Operator->getArg(0);Arguments=0;Arrow=false;
+  }
+  if(!Method || !Receiver || Method->isStatic() || Method->isVolatile() ||
+      Method->isExplicitObjectMemberFunction() || Arguments ||
+      Method->getNumParams() || Receiver->HasSideEffects(Context) ||
+      Receiver->getType().getNonReferenceType().isVolatileQualified() ||
+      (Method->isVirtual() && (!Member || !Member->hasQualifier()) &&
+       !Method->hasAttr<FinalAttr>() && !Method->getParent()->hasAttr<FinalAttr>()))return std::nullopt;
+  if(!Active.insert(Method->getCanonicalDecl()).second)return std::nullopt;
+  auto Leave=llvm::scope_exit([&]{Active.erase(Method->getCanonicalDecl());});
+  const auto *Definition=Method->getDefinition();
+  // Used implicit getter bodies can still be in Clang's pending queue when a
+  // task/executor boundary is checked. Materialize only the selected concrete
+  // single-return field/member view, never unrelated pending work or patterns.
+  if(!Definition && Actions && &Actions->Context==&Context && Work>=16 &&
+      Method->instantiationIsPending() && !Method->isDependentContext() &&
+      !Method->isInvalidDecl() && !Method->getType()->isDependentType() &&
+      Method->getTemplateSpecializationKind()==TSK_ImplicitInstantiation &&
+      (!Actions->getCurFunctionDecl(true) || Actions->getCurFunctionDecl(true)->getCanonicalDecl()!=Method->getCanonicalDecl())) {
+    const auto *Pattern=Method->getTemplateInstantiationPattern();
+    const auto *Body=Pattern && !Pattern->isLateTemplateParsed()?dyn_cast_or_null<CompoundStmt>(Pattern->getBody()):nullptr;
+    const auto *Return=Body && Body->size()==1?dyn_cast<ReturnStmt>(*Body->body_begin()):nullptr;
+    const auto *Value=Return && Return->getRetValue()?Return->getRetValue()->IgnoreParenImpCasts():nullptr;
+    bool ScalarGraph=Method->getParent()->isLambda() && Body && Body->size()<=16;
+    if(ScalarGraph)for(const auto *Statement:Body->body())
+      ScalarGraph &= isa<ReturnStmt,IfStmt,DeclStmt,CompoundStmt>(Statement);
+    if((ScalarGraph || (Value && isa<DeclRefExpr,MemberExpr,ArraySubscriptExpr,CXXDependentScopeMemberExpr,CallExpr,BinaryOperator,UnaryOperator,AbstractConditionalOperator>(Value))) &&
+        Pattern->isInlined() && !Pattern->isInvalidDecl()) {
+      Work-=16;
+      Actions->InstantiateFunctionDefinition(Call->getExprLoc(),const_cast<CXXMethodDecl *>(Method),false,false);
+      Definition=Method->getDefinition();
+    }
+  }
+  if(!Definition || !Definition->getBody() || Definition->isVariadic() ||
+      Definition->isMultiVersion() || Definition->isNoReturn() ||
+      getObjC3Executor(Definition) || isObjC3ActorIsolated(Definition) ||
+      (Definition->isExternallyVisible() && !Definition->isInlined()) ||
+      Definition->hasAttr<WeakAttr>() || Definition->hasAttr<WeakRefAttr>() ||
+      Definition->hasAttr<WeakImportAttr>() || Definition->hasAttr<AliasAttr>() ||
+      Definition->hasAttr<IFuncAttr>() || Definition->hasAttr<ReturnsTwiceAttr>())return std::nullopt;
+  if(const auto *Type=getObjC3CallableFunctionType(Definition);
+      !Type || Type->getObjC3FunctionEffects().Async ||
+      Type->getObjC3FunctionEffects().Throws!=ObjC3ThrowsKind::None)return std::nullopt;
+  const auto *Body=dyn_cast<CompoundStmt>(Definition->getBody());
+  if(!Body)return std::nullopt;
+  const auto *Return=Body->size()==1?dyn_cast<ReturnStmt>(*Body->body_begin()):nullptr;
+  const auto *Value=Return?Return->getRetValue():nullptr;
+  bool Managed=false;
+  auto Path=[&](const Expr *E) {
+    E=E->IgnoreParenImpCasts();
+    for(;;) {
+      if(!Work)return false;--Work;
+      if(const auto *Field=dyn_cast<MemberExpr>(E)) {
+        const auto *Declaration=dyn_cast<FieldDecl>(Field->getMemberDecl());
+        if(!Declaration || Declaration->getType().isVolatileQualified() ||
+            Declaration->getType()->isAtomicType())return false;
+        Managed|=managedTransferStorage(Declaration) ||
+            getObjC3ResourceTypeContract(Context,Declaration->getType()).Cleanup;
+        E=Field->getBase()->IgnoreParenImpCasts();
+        if(Field->isArrow() && !isa<CXXThisExpr>(E))return false;
+        continue;
+      }
+      if(const auto *Subscript=dyn_cast<ArraySubscriptExpr>(E)) {
+        const auto *Base=Subscript->getBase()->IgnoreParenImpCasts();
+        const auto *Array=Context.getAsConstantArrayType(Base->getType());
+        const auto Index=Subscript->getIdx()->getIntegerConstantExpr(Context);
+        if(!Array || !Index || Index->isNegative() || Index->getActiveBits()>64 ||
+            Index->getZExtValue()>=Array->getSize().getLimitedValue())return false;
+        E=Base;continue;
+      }
+      if(const auto *Deref=dyn_cast<UnaryOperator>(E);Deref && Deref->getOpcode()==UO_Deref) {
+        const auto *Base=Deref->getSubExpr()->IgnoreParenImpCasts();
+        if(const auto *Array=Context.getAsConstantArrayType(Base->getType());Array && !Array->getSize().isZero()) {
+          E=Base;continue;
+        }
+      }
+      break;
+    }
+    if(const auto *Deref=dyn_cast<UnaryOperator>(E);Deref && Deref->getOpcode()==UO_Deref)
+      E=Deref->getSubExpr()->IgnoreParenImpCasts();
+    return isa<CXXThisExpr>(E);
+  };
+  auto Nested=[&](const CallExpr *Inner) -> std::optional<FieldProjection> {
+    auto Projection=fieldProjectionImpl(Inner,Context,Work,Depth+1,Active,Actions);
+    if(!Projection || (Projection->Arrow &&
+        !isa<CXXThisExpr>(Projection->Receiver->IgnoreParenImpCasts())) ||
+        !Path(Projection->Receiver))return std::nullopt;
+    Managed|=Projection->Managed;
+    return Projection;
+  };
+  // A pure status read does not copy resource identity or escape the object.
+  auto Observe=[&](auto &&Self,const Expr *E,unsigned Level)->bool {
+    if(!E || !Work || Level>32)return false;--Work;
+    E=E->IgnoreParens();
+    if(const auto *Cast=dyn_cast<CastExpr>(E))return Self(Self,Cast->getSubExpr(),Level+1);
+    if(isa<MemberExpr,ArraySubscriptExpr>(E))return Path(E);
+    if(const auto *Inner=dyn_cast<CallExpr>(E))return bool(Nested(Inner));
+    if(const auto *Conditional=dyn_cast<AbstractConditionalOperator>(E))
+      return Self(Self,Conditional->getCond(),Level+1) &&
+          Self(Self,Conditional->getTrueExpr(),Level+1) && Self(Self,Conditional->getFalseExpr(),Level+1);
+    if(const auto *Binary=dyn_cast<BinaryOperator>(E))
+      return !Binary->isAssignmentOp() && !Binary->isPtrMemOp() &&
