+const FunctionProtoType *clang::getObjC3AsyncAwaitFunctionType(Sema &S, const Expr *E) {
+  const auto *Type = getObjC3AsyncCalleeFunctionType(E);
+  const auto *Message = dyn_cast<ObjCMessageExpr>(getObjC3AsyncSourceCall(E));
+  if (!Type || !Type->getObjC3FunctionEffects().Async || !Message ||
+      !Message->getMethodDecl()->hasRelatedResultType()) return Type;
+  bool Class = Message->getReceiverKind() == ObjCMessageExpr::Class ||
+               Message->getReceiverKind() == ObjCMessageExpr::SuperClass;
+  bool Super = Message->getReceiverKind() == ObjCMessageExpr::SuperInstance ||
+               Message->getReceiverKind() == ObjCMessageExpr::SuperClass;
+  QualType Result = S.ObjC().getMessageSendResultType(Message->getInstanceReceiver(),
+      Message->getReceiverType(), const_cast<ObjCMethodDecl *>(Message->getMethodDecl()), Class, Super);
+  return S.Context.getFunctionType(Result, Type->param_types(),
+                                  Type->getExtProtoInfo())->castAs<FunctionProtoType>();
+}
