+// Returning the original expression for an unnecessary await is safe only if
+// no unhandled async operation is buried in its evaluated subexpressions.
+class NonSuspendingAwaitProof
+    : public ConstEvaluatedExprVisitor<NonSuspendingAwaitProof> {
+  using Base = ConstEvaluatedExprVisitor<NonSuspendingAwaitProof>;
+
+public:
+  bool Proven = true;
+  explicit NonSuspendingAwaitProof(ASTContext &C) : Base(C) {}
+  void VisitCoawaitExpr(const CoawaitExpr *) {} // Already lowered suspension.
+  void VisitCallExpr(const CallExpr *E) {
+    if (E->isUnevaluatedBuiltinCall(Context))
+      return;
+    const auto *FT = getObjC3CallableFunctionType(E->getDirectCallee());
+    if (!FT) {
+      QualType T = E->getCallee()->getType();
+      if (T->isPlaceholderType()) {
+        Proven = false;
+        return;
+      }
+      if (const auto *P = T->getAs<PointerType>())
+        T = P->getPointeeType();
+      else if (const auto *B = T->getAs<BlockPointerType>())
+        T = B->getPointeeType();
+      FT = T->getAs<FunctionProtoType>();
+    }
+    if (FT && FT->getObjC3FunctionEffects().Async)
+      Proven = false;
+    Base::VisitCallExpr(E);
+  }
+  void VisitCXXDefaultArgExpr(const CXXDefaultArgExpr *E) {
+    Visit(E->getExpr());
+  }
+  void VisitCXXDefaultInitExpr(const CXXDefaultInitExpr *E) {
+    Visit(E->getExpr());
+  }
+  void VisitObjCMessageExpr(const ObjCMessageExpr *E) {
+    const auto *M = E->getMethodDecl();
+    if (!M || M->getObjC3FunctionEffects().Async)
+      Proven = false;
+    Base::VisitStmt(E);
+  }
+};
+
+// A same-actor proof is a value identity proof, not merely an actor type.
+// Only immutable automatic bindings and exact address/load pairs participate.
+// Static/TLS locals can retain a different invocation's receiver; weak/volatile
+// slots and mutable aliases cannot establish the current receiver identity.
+bool currentActorReceiver(const Decl *Callable, const Expr *Receiver,
+                          bool Super = false) {
+  const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Callable);
+  if (!Method || !isObjC3ActorIsolated(Method)) return false;
+  const auto *Self = Method->getSelfDecl();
+  if (!Self || !Self->getType().isConstQualified()) return false;
+  if (Super) return true;
+  unsigned Budget = 128;
+  llvm::SmallPtrSet<const VarDecl *, 16> Active;
+  auto Prove = [&](auto &&Recurse, const Expr *Value, unsigned Loads,
+                   unsigned Depth) -> bool {
+    if (!Value || !Budget || Depth > 32 || Loads > 8) return false;
+    --Budget;
+    if (const auto *Paren = dyn_cast<ParenExpr>(Value))
+      return Recurse(Recurse, Paren->getSubExpr(), Loads, Depth + 1);
+    if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Value))
+      return Recurse(Recurse, Cast->getSubExpr(), Loads, Depth + 1);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Value))
+      return Recurse(Recurse, Opaque->getSourceExpr(), Loads, Depth + 1);
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Value))
+      return Recurse(Recurse, Cleanups->getSubExpr(), Loads, Depth + 1);
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(Value))
+      return Recurse(Recurse, Temporary->getSubExpr(), Loads, Depth + 1);
+    if (const auto *Temporary = dyn_cast<CXXBindTemporaryExpr>(Value))
+      return Recurse(Recurse, Temporary->getSubExpr(), Loads, Depth + 1);
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Value)) {
+      if (Reference->getDecl() == Self) return Loads == 0;
+      const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl());
+      if (!Variable || !Variable->hasLocalStorage() || !Variable->hasInit())
+        return false;
+      QualType Type = Variable->getType().getNonReferenceType();
+      if (!Type.isConstQualified() || Type.isVolatileQualified() ||
+          Type->isAtomicType() || Type.getObjCLifetime() == Qualifiers::OCL_Weak ||
+          !Active.insert(Variable).second) return false;
+      const bool Proven = Recurse(Recurse, Variable->getInit(), Loads, Depth + 1);
+      Active.erase(Variable);return Proven;
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Value)) {
+      if (Unary->getOpcode() == UO_Deref)
+        return Recurse(Recurse, Unary->getSubExpr(), Loads + 1, Depth + 1);
+      if (Unary->getOpcode() == UO_AddrOf && Loads)
+        return Recurse(Recurse, Unary->getSubExpr(), Loads - 1, Depth + 1);
+    }
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Value))
+      return Recurse(Recurse, Conditional->getTrueExpr(), Loads, Depth + 1) &&
+             Recurse(Recurse, Conditional->getFalseExpr(), Loads, Depth + 1);
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Value);
+        Binary && Binary->getOpcode() == BO_Comma)
+      return Recurse(Recurse, Binary->getRHS(), Loads, Depth + 1);
+    if (const auto *Generic = dyn_cast<GenericSelectionExpr>(Value);
+        Generic && !Generic->isResultDependent())
+      return Recurse(Recurse, Generic->getResultExpr(), Loads, Depth + 1);
+    if (const auto *Choice = dyn_cast<ChooseExpr>(Value);
+        Choice && !Choice->isConditionDependent())
+      return Recurse(Recurse, Choice->getChosenSubExpr(), Loads, Depth + 1);
+    return false;
+  };
+  return Prove(Prove, Receiver, 0, 0);
+}
+
+class IsolationBodyChecker : public EvaluatedExprVisitor<IsolationBodyChecker> {
+  using Base = EvaluatedExprVisitor<IsolationBodyChecker>;
+  Sema &S;
+  Decl *Callable;
+  unsigned AwaitDepth = 0;
+  bool CheckTaskBoundaries = true;
+  const Stmt *ScopeBody;
+  bool Invalid = false;
+  llvm::SmallPtrSet<const Stmt *, 32> Checked;
+
+  bool sameActor(const Expr *Receiver, bool Super = false) const {
+    return currentActorReceiver(Callable, Receiver, Super);
+  }
+  bool executorProven(const Decl *Callee) const {
+    const auto *Target = getObjC3Executor(Callee);
+    const auto *Current = getObjC3Executor(Callable);
+    return !Target ||
+           (Current && Current->getExecutor() == Target->getExecutor());
+  }
+  void checkCall(Expr *Site, const Decl *Target, ArrayRef<Expr *> Arguments,
+                 const Expr *Receiver = nullptr, bool Super = false) {
+    if (!Target || Site->isInstantiationDependent() || !Checked.insert(Site).second)
+      return;
+    // A private frame encapsulates the entry requirement. Its original source
+    // argument/result transfers were checked before replacing the await
+    // operand.
+    if (Target->hasAttr<ObjC3IsolationThunkAttr>())
+      return;
+    bool ActorCrossing =
+        isObjC3ActorIsolated(Target) && !sameActor(Receiver, Super);
+    bool ExecutorCrossing = !executorProven(Target);
+    if (ActorCrossing || ExecutorCrossing) {
+      unsigned Kind = ActorCrossing ? 0 : 1;
+      S.Diag(Site->getExprLoc(), AwaitDepth
+                                     ? diag::err_objc3_isolation_hop_unavailable
+                                     : diag::err_objc3_isolation_requires_await)
+          << Kind;
+      S.Diag(Target->getLocation(), diag::note_objc3_sendable_boundary);
+      Invalid = true;
+      for (const Expr *Argument : Arguments)
+        Invalid |=
+            checkTransferValue(S,Argument,transferSource(Argument)->getType(),
+                               "isolated argument",Target,ScopeBody);
+      QualType Result;
+      ObjC3FunctionEffectInfo Effects;
+      if (const auto *Method = dyn_cast<ObjCMethodDecl>(Target)) {
+        Result = Method->getReturnType();
+        Effects = Method->getObjC3FunctionEffects();
+      } else if (const auto *FT = getObjC3CallableFunctionType(Target)) {
+        Result = FT->getReturnType();
+        Effects = FT->getObjC3FunctionEffects();
+      }
+      if (!Result.isNull())
+        Invalid |= checkTransfer(S, Result, Site->getExprLoc(),
+                                 "isolated result", Target);
+      if (Effects.Throws == ObjC3ThrowsKind::Typed)
+        Invalid |= checkTransfer(S, Effects.ErrorType, Site->getExprLoc(),
+                                 "isolated checked error", Target);
+    }
+    if (!CheckTaskBoundaries)
+      return;
+    unsigned TaskKind = getObjC3TaskBoundaryKind(Target);
+    if (!TaskKind)
+      return;
+    // A dependent declaration is checked again after substitution; a generic
+    // attribute cannot turn an arbitrary scalar argument into asynchronous work.
+    if(!hasAsyncWork(S,Target)) {
+      // A group annotation may mark an async function whose body establishes
+      // the scope without transporting a callback through this call. Spawn and
+      // detached declarations always require an asynchronous work parameter.
+      if (TaskKind & 3) {
+        S.Diag(Site->getExprLoc(),diag::err_objc3_task_async_work);Invalid=true;
+      }
+      return;
+    }
+    unsigned Index = 0;
+    for (const Expr *Argument : Arguments) {
+      // A group-scope callback is concurrent work, but independent scalar
+      // configuration arguments stay ordinary synchronous call operands. A
+      // declaration that is also spawn/detached retains the stronger rule that
+      // every explicitly transported work-item argument is checked.
+      if (TaskKind == 4 && !isConcurrentWorkParameter(S, Target, Index)) {
+        ++Index;
+        continue;
+      }
+      QualType TransferType = transferSource(Argument)->getType();
+      // The source designator is a function lvalue; its transported value is
+      // the stable function address produced by the ordinary decay conversion.
+      if (TransferType->isFunctionType())
+        TransferType = S.Context.getPointerType(TransferType);
+      if (TransferType->isBlockPointerType()) {
+        // A null work item never transfers a capture environment. Its runtime
+        // startup rejection remains available under strict checking.
+        if (Argument->IgnoreParenCasts()->isNullPointerConstant(
+                S.Context, Expr::NPC_ValueDependentIsNotNull)) {
+          ++Index;
+          continue;
+        }
+        SmallVector<const BlockExpr *, 8> Blocks;
+        SmallVector<FactoryCapture,8> Captures;
+        const bool Known = knownConcurrentBlocks(S, Argument, Blocks, ScopeBody, &Captures);
+        const bool Unchecked = unsafeAdmission(S.Context, TransferType);
+        if ((Known || Unchecked) &&
+            (carriesManagedResourceValue(S.Context,Argument,ScopeBody,nullptr,&S) ||
+             carriesManagedResourceValue(S.Context,Argument,ScopeBody,nullptr,&S,true)))
+          Invalid |= checkTransferValue(S,Argument,TransferType,
+                                        "concurrent block value",Target,ScopeBody);
+        if (Known) {
+          ConcurrentCaptureProof Proof;
+          Invalid|=checkFactoryCaptures(S,Captures,ScopeBody,Proof);
+          for (const auto *Block : Blocks)
+            Invalid |= checkKnownConcurrentBlock(
+                S, Block, Site->getExprLoc(), isAsyncWorkParameter(Target, Index), Proof, ScopeBody);
+        } else if (Unchecked) {
+          Invalid |= checkTransfer(S, TransferType, Argument->getExprLoc(),
+                                   "unchecked concurrent block value", Target);
+        } else if (strictConcurrency(S)) {
+          S.Diag(Argument->getExprLoc(), diag::err_objc3_task_unknown_capture);
+          Invalid = true;
+        } else {
+          checkTransfer(S, TransferType, Argument->getExprLoc(),
+                        "unverified concurrent block capture", Target);
+        }
+      } else {
+        Invalid |= checkTransferValue(S,Argument,TransferType,
+                                      TaskKind == 4 ? "structured group argument"
+                                                    : "spawned work-item argument",
+                                      Target,ScopeBody);
+      }
+      ++Index;
+    }
+  }
+
+public:
+  IsolationBodyChecker(Sema &S, Decl *Callable, bool AwaitOperand = false,
+                       const Stmt *Body = nullptr)
+      : Base(S.Context), S(S), Callable(Callable),
+        AwaitDepth(AwaitOperand ? 1 : 0), CheckTaskBoundaries(!AwaitOperand), ScopeBody(Body) {}
+  bool failed() const { return Invalid; }
+  void VisitCompoundStmt(CompoundStmt *Body) {
+    for (Stmt *Child : Body->body()) {
+      if (CheckTaskBoundaries)
+        if (auto *Expression = dyn_cast<Expr>(Child)) {
+          const Expr *Value = Expression->IgnoreImplicit()->IgnoreParens();
+          if (const auto *Try = dyn_cast<ObjC3TryExpr>(Value))
+            Value = Try->getOperand()->IgnoreImplicit()->IgnoreParens();
+          const Decl *Target = nullptr;
+          if (const auto *Call = dyn_cast<CallExpr>(Value))
+            Target = Call->getDirectCallee();
+          if (const auto *Message = dyn_cast<ObjCMessageExpr>(Value))
+            Target = Message->getMethodDecl();
+          if (getObjC3TaskBoundaryKind(Target) & 1)
+            S.Diag(Expression->getExprLoc(),
+                   diag::warn_objc3_unused_task_handle);
+        }
+      Visit(Child);
+    }
+  }
+  void VisitBlockExpr(BlockExpr *) {} // Each callable checks its own body.
+  void VisitLambdaExpr(LambdaExpr *E) { Base::VisitLambdaExpr(E); }
+  void VisitCoawaitExpr(CoawaitExpr *E) {
+    if (E->getKeywordLoc().isInvalid() && !E->isInstantiationDependent() &&
+        isa<OpaqueValueExpr>(E->getReadyExpr()) &&
+        isa<ObjCMessageExpr>(getObjC3AsyncSourceCall(E))) {
+      S.Diag(E->getOperand()->getExprLoc(), S.getDiagnostics().getCustomDiagID(
+          DiagnosticsEngine::Error,
+          "async property mutation requires an explicit await of the whole property operation"));
+      Invalid = true;
+    }
+    llvm::SaveAndRestore<unsigned> AwaitGuard(AwaitDepth, AwaitDepth + 1);
+    Visit(E->getOperand());
+  }
+  void VisitCallExpr(CallExpr *E) {
+    if (E->isUnevaluatedBuiltinCall(S.Context))
+      return;
+    checkCall(E, E->getDirectCallee(), {E->getArgs(), E->getNumArgs()});
+    Base::VisitCallExpr(E);
+  }
+  void VisitCXXDefaultArgExpr(CXXDefaultArgExpr *E) { Visit(E->getExpr()); }
+  void VisitCXXDefaultInitExpr(CXXDefaultInitExpr *E) { Visit(E->getExpr()); }
+  void VisitPseudoObjectExpr(PseudoObjectExpr *E) {
+    if(ScopeBody && getObjC3IsolationSourceSyntax(E)) {
+      const auto *Frame=dyn_cast<CallExpr>(E->getResultExpr()->IgnoreParenImpCasts());
+      const auto *Thunk=Frame?Frame->getDirectCallee():nullptr;
+      const auto *Contract=Thunk?Thunk->getAttr<ObjC3IsolationThunkAttr>():nullptr;
+      bool Crossing=Thunk && !executorProven(Thunk);
+      if(Contract && Contract->getActorEntry()) {
+        // The receiver is the first frame argument for an actor entry. It is
+        // the same source value already used by native current-actor checking.
+        Crossing|=Frame->getNumArgs()==0 || !sameActor(Frame->getArg(0));
+      }
+      const Expr *Syntax = getObjC3IsolationSourceSyntax(E)->IgnoreImplicit()->IgnoreParenImpCasts();
+      const bool CxxReceiver = isa<CXXMemberCallExpr>(Syntax);
+      if (Crossing) for (auto [Index, Argument] : llvm::enumerate(Frame->arguments())) {
+        const auto *Value = transferSource(Argument);
+        QualType Type = Value->getType();
+        if (CxxReceiver && Index == 0 && Type->isPointerType())
+          Type = Type->getPointeeType();
+        // Initializer-only provenance was checked while constructing the frame.
+        // This pass contributes later writes and closed binding/escape facts.
+        if((!carriesManagedResourceValue(S.Context,Value,nullptr,nullptr,&S) &&
+            carriesManagedResourceValue(S.Context,Value,ScopeBody,nullptr,&S)) ||
+           (!carriesManagedResourceValue(S.Context,Value,nullptr,nullptr,&S,true) &&
+            carriesManagedResourceValue(S.Context,Value,ScopeBody,nullptr,&S,true)))
+          Invalid |= checkTransferValue(S, Value, Type,
+              "isolated snapshot", nullptr, ScopeBody);
+      }
+    }
+    const auto *Function = dyn_cast<FunctionDecl>(Callable);
+    if ((!Function || !Function->hasAttr<ObjC3IsolationThunkAttr>()) &&
+        !E->isInstantiationDependent()) {
+      const Expr *Syntax = E->getSyntacticForm()->IgnoreParenImpCasts();
+      const ObjCPropertyRefExpr *Property = nullptr;
+      if (const auto *Binary = dyn_cast<BinaryOperator>(Syntax); Binary && Binary->isAssignmentOp())
+        Property = dyn_cast<ObjCPropertyRefExpr>(Binary->getLHS()->IgnoreParenImpCasts());
+      if (const auto *Unary = dyn_cast<UnaryOperator>(Syntax); Unary && Unary->isIncrementDecrementOp())
+        Property = dyn_cast<ObjCPropertyRefExpr>(Unary->getSubExpr()->IgnoreParenImpCasts());
+      const ObjCMethodDecl *Setter = Property ? (Property->isExplicitProperty()
+          ? Property->getExplicitProperty()->getSetterMethodDecl()
+          : Property->getImplicitPropertySetter()) : nullptr;
+      if (Setter && Setter->getObjC3FunctionEffects().Async) {
+        S.Diag(E->getExprLoc(), S.getDiagnostics().getCustomDiagID(
+            DiagnosticsEngine::Error,
+            "async property mutation requires an explicit await of the whole property operation"));
+        Invalid = true;
+        return;
+      }
+    }
+    Base::VisitPseudoObjectExpr(E);
+  }
+  void VisitObjCMessageExpr(ObjCMessageExpr *E) {
+    checkCall(E, E->getMethodDecl(), {E->getArgs(), E->getNumArgs()},
+              E->getInstanceReceiver(),
+              E->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+    Base::VisitStmt(E);
+  }
+  void VisitObjCIvarRefExpr(ObjCIvarRefExpr *E) {
+    const auto *Ivar = E->getDecl();
+    if (isObjC3ActorIsolated(Ivar) && !sameActor(E->getBase()) &&
+        Checked.insert(E).second) {
+      S.Diag(E->getExprLoc(), diag::err_objc3_isolated_state) << Ivar;
+      Invalid = true;
+    }
+    Base::VisitStmt(E);
+  }
+};
+} // namespace
+
+bool clang::isObjC3SendableType(ASTContext &C, QualType T) {
+  return SendableClassifier(C).classify(T).Safe;
+}
+namespace {
+bool checkKnownConcurrentBlock(
+    Sema &S, const BlockExpr *B, SourceLocation Site, bool RequireAsync,
+    ConcurrentCaptureProof &Proof, const Stmt *ScopeBody) {
+  bool Invalid = false;
+  const BlockDecl *D = B->getBlockDecl();
+  if (!Proof.Budget || Proof.Active.size()>=64 || !Proof.Active.insert(D).second)
+    return checkTransfer(S, B->getType(), Site, "bounded block capture proof",
+                         nullptr, true);
+  --Proof.Budget;
+  const auto *Signature = getObjC3CallableFunctionType(D);
+  if (RequireAsync &&
+      (!Signature || !Signature->getObjC3FunctionEffects().Async)) {
+    S.Diag(Site, diag::err_objc3_task_async_work);
+    Invalid = true;
+  }
+  if (Proof.Complete.contains(D)) {Proof.Active.erase(D);return Invalid;}
+  for (const auto &Capture : D->captures()) {
+    const VarDecl *V = Capture.getVariable();
+    SourceLocation Loc = Capture.getObjC3CaptureRange().isValid()
+                             ? Capture.getObjC3CaptureRange().getBegin()
+                             : Site;
+    bool Unsafe=unsafeConcurrentCapture(Capture);
+    // The recipe checks actual caller contracts before visiting this literal.
+    // Plain formal parameter types cannot stand in for those source values.
+    if(Proof.FactoryBindings.contains(V))continue;
+    bool Managed = managedTransferStorage(V);
+    bool Borrowed=carriesManagedResourceValue(S.Context,nullptr,ScopeBody,V,&S,true);
+    if(const auto *Initializer=Capture.getObjC3InitExpr())
+      Borrowed|=carriesManagedResourceValue(S.Context,Initializer,ScopeBody,nullptr,&S,true);
+    bool UnprovenLifetime = false;
+    Managed |= carriesManagedResourceValue(S.Context, nullptr, ScopeBody, V,
+                                            &S, false, &UnprovenLifetime);
+    if (const auto *Initializer = Capture.getObjC3InitExpr())
+      Managed |= carriesManagedResourceValue(S.Context, Initializer, ScopeBody,
+                                              nullptr, &S, false, &UnprovenLifetime);
+    bool Failed = false;
+    if (Capture.isByRef() || Borrowed ||
+        (Managed && !unsafeAdmission(S.Context, V->getType()))) {
+      S.Diag(Loc, strictConcurrency(S) ? diag::err_objc3_sendable_transfer
+                                       : diag::warn_objc3_sendable_transfer)
+          << V->getType()
+          << (Capture.isByRef() ? "shared __block capture" :
+              Borrowed ? "borrowed capture" :
+              UnprovenLifetime && V->getType()->isPointerType()
+                  ? "unverified capture lifetime" : "cleanup-managed capture");
+      Failed = strictConcurrency(S);
+    } else {
+      SmallVector<const BlockExpr *, 8> Blocks;
+      const Expr *Initializer = Capture.getObjC3InitExpr();
+      SmallVector<FactoryCapture,8> FactoryCaptures;
+      const bool KnownBlocks = !Unsafe && !Managed && V->getType()->isBlockPointerType() &&
+          (Initializer ? knownConcurrentBlocks(S, Initializer, Blocks, ScopeBody,&FactoryCaptures)
+                       : ConcurrentBlockValues(S.Context,Blocks,ScopeBody,&FactoryCaptures,&S).collectVariable(V));
+      if (KnownBlocks) {
+        Failed|=checkFactoryCaptures(S,FactoryCaptures,ScopeBody,Proof);
+        for (const auto *Block : Blocks)
+          Failed |= checkKnownConcurrentBlock(S, Block, Loc, false, Proof, ScopeBody);
+      } else {
+        Failed = checkTransfer(S, V->getType(), Loc, "concurrent capture",
+                               nullptr, Unsafe || Managed, Borrowed, ScopeBody,
+                               Managed && !UnprovenLifetime);
+      }
+    }
+    if (Failed)
+      S.Diag(V->getLocation(), diag::note_objc3_sendable_capture) << V;
+    Invalid |= Failed;
+  }
+  if (D->capturesCXXThis()) {
+    class CapturedThisType : public ConstEvaluatedExprVisitor<CapturedThisType> {
+    public:
+      QualType Type;
+      explicit CapturedThisType(ASTContext &C) : ConstEvaluatedExprVisitor(C) {}
+      void VisitCXXThisExpr(const CXXThisExpr *E) {Type = E->getType()->getPointeeType();}
+      void VisitBlockExpr(const BlockExpr *E) {Visit(E->getBody());}
+    } Finder(S.Context);
+    Finder.Visit(B->getBody());
+    Invalid |= checkTransfer(S, Finder.Type.isNull() ? S.Context.VoidPtrTy : Finder.Type,
+                             Site, "shared C++ this capture", nullptr, true);
+  }
+  Proof.Active.erase(D);
+  if (!Invalid)Proof.Complete.insert(D);
+  return Invalid;
+}
+} // namespace
+
+bool clang::checkObjC3ConcurrentBlockCaptures(Sema &S, const BlockExpr *B,
+                                              SourceLocation Site) {
+  ConcurrentCaptureProof Proof;
+  return checkKnownConcurrentBlock(S, B, Site, true, Proof, nullptr);
+}
+
+void clang::handleObjC3IsolationAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  if (!S.getLangOpts().ObjC3) {
+    S.Diag(AL.getLoc(), diag::err_objc3_isolation_mode);
+    D->setInvalidDecl();
+    return;
+  }
+  switch (AL.getKind()) {
+  case ParsedAttr::AT_ObjCActorNonreentrant:
+    S.Diag(AL.getLoc(), diag::err_objc3_actor_nonreentrant_deferred);
+    D->setInvalidDecl();
+    return;
+  case ParsedAttr::AT_ObjCExecutor: {
+    if (!AL.checkExactlyNumArgs(S, 1) || !AL.isArgExpr(0)) {
+      D->setInvalidDecl();
+      return;
+    }
+    const auto *Literal =
+        dyn_cast<StringLiteral>(AL.getArgAsExpr(0)->IgnoreParenImpCasts());
+    if (!Literal)
+      return;
+    if (D->hasAttr<ObjCExecutorAttr>() &&
+        D->getAttr<ObjCExecutorAttr>()->getExecutor() != Literal->getString()) {
+      S.Diag(AL.getLoc(), diag::err_objc3_isolation_conflict)
+          << cast<NamedDecl>(D);
+      D->setInvalidDecl();
+      return;
+    }
+    if (!D->hasAttr<ObjCExecutorAttr>())
+      D->addAttr(ObjCExecutorAttr::Create(S.Context, Literal->getString(), AL));
+    return;
+  }
+  case ParsedAttr::AT_ObjCNonisolated: {
+    const auto *M = dyn_cast<ObjCMethodDecl>(D);
+    const auto *P = dyn_cast<ObjCPropertyDecl>(D);
+    if ((!M && !P) || (M && !M->isInstanceMethod()) ||
+        (P && !P->isInstanceProperty()) ||
+        !isObjC3Actor(getObjC3ContainingInterface(D))) {
+      S.Diag(AL.getLoc(), diag::err_objc3_nonisolated_context);
+      D->setInvalidDecl();
+      return;
+    }
+    if (!D->hasAttr<ObjCNonisolatedAttr>())
+      D->addAttr(ObjCNonisolatedAttr::Create(S.Context, AL));
+    bool Invalid = M ? checkBoundarySignature(S, M)
+                     : checkTransfer(S, P->getType(), P->getLocation(),
+                                     "nonisolated property", P);
+    if (Invalid)
+      D->setInvalidDecl();
+    return;
+  }
+  case ParsedAttr::AT_ObjCUnsafeSendable:
+    if (!D->hasAttr<ObjCUnsafeSendableAttr>())
+      D->addAttr(ObjCUnsafeSendableAttr::Create(S.Context, AL));
+    // Interfaces are the exported type contract. Implementation spelling must
+    // not leave a source-free importer unable to observe the admission.
+    if (auto *Implementation = dyn_cast<ObjCImplementationDecl>(D))
+      if (auto *Interface = Implementation->getClassInterface())
+        if (!Interface->hasAttr<ObjCUnsafeSendableAttr>())
+          Interface->addAttr(ObjCUnsafeSendableAttr::Create(S.Context, AL));
+    return;
+  default:
+    break;
+  }
+  unsigned Kind = AL.getKind() == ParsedAttr::AT_ObjCTaskSpawn      ? 1
+                  : AL.getKind() == ParsedAttr::AT_ObjCTaskDetached ? 2
+                                                                    : 4;
+  unsigned Existing = getObjC3TaskBoundaryKind(D);
+  if ((Existing & 3) && (Kind & 3) && !(Existing & Kind)) {
+    S.Diag(AL.getLoc(), diag::err_objc3_isolation_conflict)
+        << cast<NamedDecl>(D);
+    D->setInvalidDecl();
+    return;
+  }
+  if (Kind & 3) {
+    QualType Result;
+    if (const auto *F = dyn_cast<FunctionDecl>(D))
+      Result = F->getReturnType();
+    if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+      Result = M->getReturnType();
+    if (Result.isNull() || Result->isVoidType()) {
+      S.Diag(AL.getLoc(), diag::err_objc3_task_handle_result);
+      D->setInvalidDecl();
+      return;
+    }
+    const bool HasAsyncWork=hasAsyncWork(S,D);
+    if (!HasAsyncWork) {
+      S.Diag(AL.getLoc(), diag::err_objc3_task_async_work);
+      D->setInvalidDecl();
+      return;
+    }
+  }
+  if (Kind == 1 && !(Existing & 1))
+    D->addAttr(ObjCTaskSpawnAttr::Create(S.Context, AL));
+  if (Kind == 2 && !(Existing & 2))
+    D->addAttr(ObjCTaskDetachedAttr::Create(S.Context, AL));
+  if (Kind == 4 && !(Existing & 4))
+    D->addAttr(ObjCTaskGroupAttr::Create(S.Context, AL));
+}
+
+bool clang::checkObjC3NonisolatedInteriorResults(Sema &S,
+                                                ObjCContainerDecl *Container) {
+  if (!S.getLangOpts().ObjC3 || !Container ||
+      !isObjC3Actor(getObjC3ContainingInterface(Container))) return false;
+  // Attribute order and property accessor synthesis must both be complete.
+  // An unsafe Sendable promise cannot waive the receiver-owned view lifetime.
+  bool Invalid=false;
+  for (auto *Method:Container->instance_methods()) {
+    if (Method->isInvalidDecl() || !isObjC3Nonisolated(Method) ||
+        !Method->hasAttr<ObjCReturnsInnerPointerAttr>()) continue;
+    const bool Strict=strictConcurrency(S);
+    S.Diag(Method->getLocation(),S.getDiagnostics().getCustomDiagID(
+        Strict?DiagnosticsEngine::Error:DiagnosticsEngine::Warning,
+        "nonisolated actor member cannot transfer a receiver-owned interior "
+        "view; return independent owned storage"));
+    if (Strict) {Method->setInvalidDecl();Invalid=true;}
+  }
+  return Invalid;
+}
+
+bool clang::checkObjC3IsolationRedeclaration(Sema &S, Decl *New,
+                                             const Decl *Old) {
+  if (!S.getLangOpts().ObjC3 || !New || !Old)
+    return false;
+  // A visible prior declaration is a valid proof source. Omitted attributes on
+  // source redeclarations inherit, while conflicting explicit identity is
+  // rejected.
+  if (!New->hasAttr<ObjCExecutorAttr>())
+    if (const auto *A = Old->getAttr<ObjCExecutorAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCNonisolatedAttr>()) {
+    if (const auto *A = Old->getAttr<ObjCNonisolatedAttr>())
+      New->addAttr(A->clone(S.Context));
+    else if (isObjC3Nonisolated(Old))
+      // Property accessors inherit the property's effective contract even
+      // before the new implementation is linked to its property declaration.
+      New->addAttr(ObjCNonisolatedAttr::CreateImplicit(S.Context));
+  }
+  if (!New->hasAttr<ObjCTaskSpawnAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskSpawnAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCTaskDetachedAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskDetachedAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCTaskGroupAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskGroupAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (haveSameObjC3Isolation(New, Old))
+    return false;
+  S.Diag(New->getLocation(), diag::err_objc3_isolation_redeclaration)
+      << cast<NamedDecl>(New);
+  S.Diag(Old->getLocation(), diag::note_previous_declaration);
+  New->setInvalidDecl();
+  return true;
+}
+
+bool clang::checkObjC3IsolationBody(Sema &S, Decl *Callable, Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || !Callable || !Body)
+    return false;
+  IsolationBodyChecker Checker(S, Callable, false, Body);
+  Checker.Visit(Body);
+  return Checker.failed();
+}
+
+// Diagnose unsupported crossings before native awaitable conversion, which
+// otherwise hides the entry requirement behind the synchronous result type.
+bool Sema::DiagnoseObjC3AwaitIsolation(Expr *Operand) {
+  if (!getLangOpts().ObjC3 || !Operand)
+    return false;
+  IsolationBodyChecker Checker(*this, Decl::castFromDeclContext(CurContext),
+                               true);
+  Checker.Visit(Operand);
+  return Checker.failed();
+}
