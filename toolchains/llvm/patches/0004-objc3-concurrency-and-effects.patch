+static const FunctionProtoType *getCoroutineFunctionType(const Decl *D) {
+  if (const auto *Type = getObjC3CallableFunctionType(D)) return Type;
+  const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(D);
+  if (!Method || !Method->getLangOpts().ObjC3) return nullptr;
+  // An ordinary Objective-C++ coroutine keeps its written C++ return type.
+  // Build its logical prototype without changing the method's effect identity.
+  SmallVector<QualType, 4> Types;
+  SmallVector<FunctionProtoType::ExtParameterInfo, 4> Parameters;
+  bool HasOwnership = false;
+  for (const ParmVarDecl *Parameter : Method->parameters()) {
+    Types.push_back(Parameter->getType());
+    FunctionProtoType::ExtParameterInfo Info;
+    if (Parameter->hasAttr<NSConsumedAttr>()) {
+      Info = Info.withIsConsumed(true); HasOwnership = true;
+    }
+    if (Parameter->hasAttr<CFConsumedAttr>()) {
+      Info = Info.withIsCFConsumed(true); HasOwnership = true;
+    }
+    Parameters.push_back(Info);
+  }
+  FunctionProtoType::ExtProtoInfo Info;
+  Info.Variadic = Method->isVariadic();
+  if (HasOwnership) Info.ExtParameterInfos = Parameters.data();
+  return Method->getASTContext().getFunctionType(Method->getReturnType(), Types, Info)
+      ->castAs<FunctionProtoType>();
+}
+static ArrayRef<ParmVarDecl *> getCoroutineParameters(Decl *D) {
+  if (auto *FD = dyn_cast<FunctionDecl>(D))
+    return FD->parameters();
+  if (auto *BD = dyn_cast<BlockDecl>(D))
+    return BD->parameters();
+  auto *MD = cast<ObjCMethodDecl>(D);
+  return {MD->param_begin(), MD->param_size()};
+}
+static QualType getCoroutineReturnType(const Decl *D) {
+  return getCoroutineFunctionType(D)->getReturnType();
+}
