+// RUN: %clang -### --target=x86_64-unknown-linux-gnu --objc3-sdk-defaults -fsyntax-only %s -x objective-c %s 2>&1 | FileCheck %s
+// RUN: %clang -### --target=x86_64-unknown-linux-gnu --objc3-sdk-defaults -fsyntax-only -fno-objc-arc -fno-blocks -fobjc-runtime=gnustep-2.1 -x objective-c %s 2>&1 | FileCheck %s --check-prefix=EXPLICIT
+
+// CHECK: "-cc1"
+// CHECK-NOT: "-fobjc-version=3"
+// CHECK-NOT: "-fblocks"
+// CHECK-NOT: "-fobjc-runtime=
+// CHECK-NOT: "-fobjc-arc"
+// CHECK-SAME: "-x" "c"
+// CHECK: "-cc1"
+// CHECK-SAME: "-fobjc-version=3"
+// CHECK-SAME: "-fblocks"
+// CHECK-SAME: "-fobjc-runtime=gnustep-2.2"
+// CHECK-SAME: "-fobjc-arc"
+// CHECK-SAME: "-x" "objective-c"
+
+// EXPLICIT: "-cc1"
+// EXPLICIT-SAME: "-fobjc-version=3"
+// EXPLICIT-NOT: "-fblocks"
+// EXPLICIT-SAME: "-fobjc-runtime=gnustep-2.1"
+// EXPLICIT-NOT: "-fobjc-arc"
+// EXPLICIT-SAME: "-x" "objective-c"
