+++ b/clang/include/clang/Sema/ScopeInfo.h
@@ -694,6 +694,14 @@ public:
   /// the type of the non-static data member in the lambda/block structure
   /// that would store this capture.
   QualType getCaptureType() const { return CaptureType; }
+
+  /// An explicit Block capture snapshots a __block or reference source too;
+  /// its field is a value with the explicitly selected ownership.
+  void setObjC3BlockCaptureType(QualType Type) {
+    assert(isVariableCapture());
+    Kind = Cap_ByCopy;
+    CaptureType = Type;
+  }
 };
 
 class CapturingScopeInfo : public FunctionScopeInfo {
@@ -792,6 +800,10 @@ class BlockScopeInfo final : public CapturingScopeInfo {
 public:
   BlockDecl *TheDecl;
 
+  /// Registered before parsing the body, in capture-list evaluation order.
+  SmallVector<BlockDecl::Capture, 4> ObjC3ExplicitCaptures;
+  bool ObjC3CapturingExplicit = false;
+
   /// TheScope - This is the scope for the block itself, which contains
   /// arguments etc.
   Scope *TheScope;
diff --git a/clang/lib/Sema/SemaObjC.cpp b/clang/lib/Sema/SemaObjC.cpp
index 9adba1943..9df5e3ad1 100644
--- a/clang/lib/Sema/SemaObjC.cpp
