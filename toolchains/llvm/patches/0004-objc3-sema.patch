+    llvm::SmallVectorImpl<NamedDecl *> &Declarations) {
+  for (size_t I = 0, N = Sources.size(); I != N; ++I) {
+    auto Source = Sources[I];
+    SmallVector<NamedDecl *, 4> Candidates;
+    auto Result = Source->LookupObjC3QualifiedName(
+        Components, IdentifierNamespace, Candidates);
+    if (Result != ObjC3QualifiedNameLookupStatus::NotHandled) {
+      Declarations.append(Candidates.begin(), Candidates.end());
+      return Result;
+    }
+  }
+  return ObjC3QualifiedNameLookupStatus::NotHandled;
+}
