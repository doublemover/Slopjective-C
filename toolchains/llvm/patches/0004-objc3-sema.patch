+            DiagnosticsEngine::Error,"lifetime capture targets do not match a previous declaration"));
+        S.Diag(B->getLocation(),S.getDiagnostics().getCustomDiagID(
+            DiagnosticsEngine::Note,"previous lifetime capture contract is here"));
