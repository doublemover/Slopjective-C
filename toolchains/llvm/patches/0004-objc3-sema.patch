diff --git a/clang/lib/Sema/SemaObjC3Metaprogramming.cpp b/clang/lib/Sema/SemaObjC3Metaprogramming.cpp
new file mode 100644
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Metaprogramming.cpp
@@ -0,0 +1,133 @@
+//===--- SemaObjC3Metaprogramming.cpp - Explicit macro/derive attributes ------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/Sema/ObjC3Metaprogramming.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Expr.h"
+#include "clang/Basic/ParsedAttrInfo.h"
+#include "clang/Sema/ParsedAttr.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Basic/FileManager.h"
+#include "clang/Lex/Preprocessor.h"
+#include "clang/Lex/Lexer.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include <map>
+#include <mutex>
+using namespace clang;
+namespace {
+std::mutex CallbacksMutex;
+std::map<Sema *,ObjC3MetaCallbacks> Callbacks;
+ObjC3MetaCallbacks callbacks(Sema &S) {
+  std::lock_guard<std::mutex> Lock(CallbacksMutex);
+  auto I=Callbacks.find(&S);return I==Callbacks.end()?ObjC3MetaCallbacks{}:I->second;
+}
+class MetaAttributeInfo : public ParsedAttrInfo {
+  ObjC3MetaAttribute Kind;
+public:
+  MetaAttributeInfo(ObjC3MetaAttribute K,llvm::ArrayRef<Spelling> Names):Kind(K) {
+    Spellings=Names;NumArgs=K==ObjC3MetaAttribute::Entrypoint?0:1;
+  }
+  bool diagAppertainsToDecl(Sema &S,const ParsedAttr &A,const Decl *D) const override {
+    bool Allowed=Kind==ObjC3MetaAttribute::Entrypoint?isa<FunctionDecl>(D):
+                 Kind==ObjC3MetaAttribute::PropertyBehavior?isa<ObjCPropertyDecl>(D):isa<ObjCInterfaceDecl>(D);
+    if(!Allowed)S.Diag(A.getLoc(),S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+        "metaprogramming attribute does not apply to this declaration"));
+    return Allowed;
+  }
+  AttrHandling handleDeclAttribute(Sema &S,Decl *D,const ParsedAttr &A) const override {
+    if(Kind!=ObjC3MetaAttribute::Entrypoint && !S.getLangOpts().ObjC3) {
+      S.Diag(A.getLoc(),S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+          "metaprogramming expansion requires Objective-C 3.0 mode"));
+      return AttributeNotApplied;
+    }
+    llvm::StringRef Name;
+    if(Kind!=ObjC3MetaAttribute::Entrypoint) {
+      const auto *Literal=A.getNumArgs()==1 && A.isArgExpr(0)?dyn_cast<StringLiteral>(A.getArgAsExpr(0)->IgnoreParenImpCasts()):nullptr;
+      if(!Literal || Literal->getCharByteWidth()!=1 || Literal->getBytes().empty() ||
+          Literal->getBytes().size()>192 || Literal->getBytes().contains('\0')) {
+        S.Diag(A.getLoc(),S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+            "metaprogramming entrypoint name must be a nonempty UTF-8 string literal"));
+        return AttributeNotApplied;
+      }
+      Name=Literal->getBytes();
+    }
+    auto Host=callbacks(S);
+    if(Host.Attribute)
+      return Host.Attribute(Host.Context,S,D,Kind,Name,A.getRange())?AttributeApplied:AttributeNotApplied;
+    if(Kind==ObjC3MetaAttribute::Entrypoint) {
+      for(const auto *A:D->specific_attrs<AnnotateAttr>())
+        if(A->getAnnotation()=="objc3.meta.entry.v1")return AttributeApplied;
+      D->addAttr(AnnotateAttr::CreateImplicit(S.Context,"objc3.meta.entry.v1",nullptr,0,A.getRange()));
+      return AttributeApplied;
+    }
+    S.Diag(A.getLoc(),S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+        "metaprogramming request '%0' requires explicit locked packages through the Objective-C 3 compiler frontend"))<<Name;
+    return AttributeNotApplied;
+  }
+};
+#define META_ATTRIBUTE(Name,Kind) \
+class Name##Info final : public MetaAttributeInfo { \
+  static constexpr Spelling Names[]={{AttributeCommonInfo::AS_GNU,#Name}}; \
+public:Name##Info():MetaAttributeInfo(ObjC3MetaAttribute::Kind,Names){} \
+}; \
+static ParsedAttrInfoRegistry::Add<Name##Info> Name##Registration(#Name,"Objective-C 3 metaprogramming attribute");
+META_ATTRIBUTE(objc_derive,Derive)
+META_ATTRIBUTE(objc_expand,Expand)
+META_ATTRIBUTE(objc_property_behavior,PropertyBehavior)
+META_ATTRIBUTE(objc_macro,Entrypoint)
+#undef META_ATTRIBUTE
+}
+void clang::setObjC3MetaCallbacks(Sema &S,ObjC3MetaCallbacks Value) {
+  std::lock_guard<std::mutex> Lock(CallbacksMutex);Callbacks[&S]=Value;
+}
+void clang::clearObjC3MetaCallbacks(Sema &S) {
+  std::lock_guard<std::mutex> Lock(CallbacksMutex);Callbacks.erase(&S);
+}
+void clang::applyObjC3MetaProtocols(Sema &S,ObjCInterfaceDecl *D) {
+  auto Host=callbacks(S);if(Host.Interface)Host.Interface(Host.Context,S,D);
+}
+void clang::ensureObjC3MetaAttributesRegistered() {}
+
+namespace {
+void injectText(Sema &S,Preprocessor &PP,ObjCContainerDecl *D,Token &Current,std::string Text) {
+  auto &SM=PP.getSourceManager();
+  std::string Name=SM.getFilename(SM.getExpansionLoc(D->getLocation())).str();
+  Name+=".objc3-meta-"+std::to_string(SM.local_sloc_entry_size())+".inc";
+  auto ID=SM.createFileID(llvm::MemoryBuffer::getMemBufferCopy(Text,Name),
+                          SrcMgr::C_User,0,0,D->getLocation());
+  auto Buffer=SM.getBufferData(ID);
+  Lexer Raw(SM.getLocForStartOfFile(ID),PP.getLangOpts(),Buffer.begin(),Buffer.begin(),Buffer.end());
+  // Generated declarations belong to the annotated container for ownership,
+  // while their spelling locations retain the reconstructible package output.
+  auto Start=SM.getLocForStartOfFile(ID);
+  auto Expansion=SM.createExpansionLoc(Start,D->getLocation(),D->getLocation(),Text.size());
+  SmallVector<Token,64> Tokens;
+  for(;;) {
+    Token T;Raw.LexFromRawLexer(T);
+    if(T.is(tok::eof))break;
+    if(T.is(tok::raw_identifier))PP.LookUpIdentifierInfo(T);
+    T.setLocation(Expansion.getLocWithOffset(SM.getFileOffset(T.getLocation())));
+    Tokens.push_back(T);
+  }
+  Tokens.push_back(Current);
+  auto Owned=std::make_unique<Token[]>(Tokens.size());
+  std::copy(Tokens.begin(),Tokens.end(),Owned.get());
+  PP.EnterTokenStream(std::move(Owned),Tokens.size(),true,false);
+  PP.Lex(Current);
+}
+} // namespace
+void clang::injectObjC3MetaMembers(Sema &S,Preprocessor &PP,
+                                  ObjCContainerDecl *D,Token &Current) {
+  auto Host=callbacks(S);if(!D || !Host.Members)return;
+  auto Text=Host.Members(Host.Context,S,D);
+  if(!Text.empty())injectText(S,PP,D,Current,std::move(Text));
+}
+void clang::injectObjC3MetaIvars(Sema &S,Preprocessor &PP,ObjCInterfaceDecl *D,
+                                Token &Current,bool CreateBlock) {
+  auto Host=callbacks(S);if(!D || !Host.Ivars)return;
+  auto Text=Host.Ivars(Host.Context,S,D);if(Text.empty())return;
+  Text="@private\n"+Text+"\n";
+  if(CreateBlock)Text="{\n"+Text+"}\n";
+  injectText(S,PP,D,Current,std::move(Text));
+}

diff --git a/clang/include/clang/Sema/ObjC3Metaprogramming.h b/clang/include/clang/Sema/ObjC3Metaprogramming.h
new file mode 100644
--- /dev/null
+++ b/clang/include/clang/Sema/ObjC3Metaprogramming.h
@@ -0,0 +1,27 @@
+//===--- ObjC3Metaprogramming.h - Explicit metaprogramming host hooks --------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_SEMA_OBJC3METAPROGRAMMING_H
+#define LLVM_CLANG_SEMA_OBJC3METAPROGRAMMING_H
+#include "clang/Basic/SourceLocation.h"
+#include "llvm/ADT/StringRef.h"
+#include <string>
+namespace clang {
+class Decl;class ObjCInterfaceDecl;class ObjCContainerDecl;class Sema;class Preprocessor;class Token;
+enum class ObjC3MetaAttribute { Derive, Expand, PropertyBehavior, Entrypoint };
+struct ObjC3MetaCallbacks {
+  void *Context=nullptr;
+  bool (*Attribute)(void *,Sema &,Decl *,ObjC3MetaAttribute,llvm::StringRef,SourceRange)=nullptr;
+  std::string (*Members)(void *,Sema &,ObjCContainerDecl *)=nullptr;
+  std::string (*Ivars)(void *,Sema &,ObjCInterfaceDecl *)=nullptr;
+  void (*Interface)(void *,Sema &,ObjCInterfaceDecl *)=nullptr;
+};
+// Hooks belong to one Sema, never an ambient package search path. The owner
+// removes them in ForgetSema; nested interface readers have independent owners.
+void setObjC3MetaCallbacks(Sema &,ObjC3MetaCallbacks);
+void clearObjC3MetaCallbacks(Sema &);
+void applyObjC3MetaProtocols(Sema &,ObjCInterfaceDecl *);
+void injectObjC3MetaMembers(Sema &,Preprocessor &,ObjCContainerDecl *,Token &);
+void injectObjC3MetaIvars(Sema &,Preprocessor &,ObjCInterfaceDecl *,Token &,bool CreateBlock);
+void ensureObjC3MetaAttributesRegistered();
+}
+#endif

