+    }
+  }
+  Capture.setObjC3BlockCaptureType(CaptureType);
+  Capture.markUsed(true);
+  MarkVariableReferenced(Range.getEnd(), Resolved);
+  Resolved->markUsed(Context);
+  BSI->ObjC3ExplicitCaptures.emplace_back(
+      Resolved, false, Capture.isNested(), nullptr, Kind, CaptureType, Range,
+      ResourceCapture);
