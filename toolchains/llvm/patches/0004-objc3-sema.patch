+// A callable can lose its top-level borrowed parameter permission. A native
+// noescape parameter also proves the permission when the destination spells
+// it borrowed. Leave all other native parameter attributes to Clang's merge.
+static const FunctionProtoType *convertObjC3BorrowedParameters(
+    ASTContext &Context, const FunctionProtoType *From,
+    const FunctionProtoType *To) {
+  if ((!hasObjC3BorrowedParameters(From) && !hasObjC3BorrowedParameters(To)) ||
+      From->getNumParams() != To->getNumParams())
+    return From;
+
+  SmallVector<FunctionProtoType::ExtParameterInfo, 8> Infos;
+  bool Changed = false;
+  for (unsigned I = 0; I != From->getNumParams(); ++I) {
+    auto Source = From->getExtParameterInfo(I);
+    bool Borrowed = To->getExtParameterInfo(I).isObjC3Borrowed();
+    if (Borrowed && !Source.isObjC3Borrowed() && !Source.isNoEscape())
+      return From;
+    Changed |= Source.isObjC3Borrowed() != Borrowed;
+    Infos.push_back(Source.withIsObjC3Borrowed(Borrowed));
+  }
+  if (!Changed)
+    return From;
+
+  From = QualType(From, 0).getCanonicalType()->castAs<FunctionProtoType>();
+  auto EPI = From->getExtProtoInfo();
+  EPI.ExtParameterInfos =
+      llvm::any_of(Infos, [](auto Info) { return Info.getOpaqueValue() != 0; })
+          ? Infos.data()
+          : nullptr;
+  return Context.getFunctionType(From->getReturnType(), From->getParamTypes(), EPI)
+      ->castAs<FunctionProtoType>();
+}
+
+QualType clang::findObjC3BorrowedCompositeType(Sema &S, QualType Left,
+                                               QualType Right) {
+  if (!S.getLangOpts().ObjC3)
+    return {};
+  const auto *L = dyn_cast_or_null<FunctionProtoType>(
+      getObjC3CallableFunctionType(S.Context, Left));
+  const auto *R = dyn_cast_or_null<FunctionProtoType>(
+      getObjC3CallableFunctionType(S.Context, Right));
+  if (!hasObjC3BorrowedParameters(L) && !hasObjC3BorrowedParameters(R))
+    return {};
+  if (S.IsFunctionConversion(Left, Right))
+    return Right;
+  if (S.IsFunctionConversion(Right, Left))
+    return Left;
+  return {};
+}
+
