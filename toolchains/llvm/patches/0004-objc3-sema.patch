+    return;
+  }
+  auto &Capture = BSI->getCapture(Resolved);
+  if (Kind == BlockDecl::ObjC3CaptureKind::Move && Capture.isNested()) {
+    for (auto Scope = std::next(FunctionScopes.rbegin());
+         Scope != FunctionScopes.rend(); ++Scope) {
+      auto *Outer = dyn_cast<CapturingScopeInfo>(*Scope);
+      if (!Outer || !Outer->isCaptured(Resolved))
+        continue;
+      const auto &OuterCapture = Outer->getCapture(Resolved);
+      bool MutableResourceOwner = false;
+      if (ResourceCapture)
+        if (const auto *OuterBlock = dyn_cast<BlockScopeInfo>(Outer))
