+    if (!Capture->isInherited() || Capture->getArgIdents().empty())return;
+    auto *Names = S.Context.Allocate<IdentifierInfo *>(Capture->params_size());
+    std::copy(Capture->getArgIdents().begin(),Capture->getArgIdents().end(),Names);
+    unsigned I = 0;
+    for (int Target : Capture->params()) {
+      if (Target >= static_cast<int>(ImplicitThis) &&
+          static_cast<unsigned>(Target-ImplicitThis) < Function->getNumParams())
+        if (auto *Name = Function->getParamDecl(Target-ImplicitThis)->getIdentifier())Names[I]=Name;
+      ++I;
+    }
+    Capture->setArgs(ArrayRef(Names,Capture->params_size()),Capture->getArgLocs());
+  };
+  for (auto *Parameter : Function->parameters())
+    for (auto *Capture : Parameter->specific_attrs<LifetimeCaptureByAttr>())Rebind(Capture);
+  for (const auto *Capture : receiverLifetimeCaptures(Function))Rebind(const_cast<LifetimeCaptureByAttr *>(Capture));
+}
+static void checkLifetimeCaptureRedeclaration(FunctionDecl *New, Sema &S) {
+  const auto *Old = New->getPreviousDecl();
+  if (!Old || Old->getNumParams() != New->getNumParams()) return;
+  auto Check = [&](ArrayRef<const LifetimeCaptureByAttr *> Current,
+                   ArrayRef<const LifetimeCaptureByAttr *> Previous) {
+    for (const auto *A : Current) {
+      if (A->isInherited())continue;
