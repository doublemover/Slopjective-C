+ObjC3SourceImportResult MultiplexExternalSemaSource::HandleObjC3SourceImport(
+    llvm::StringRef CanonicalModule, SourceLocation ImportLoc) {
+  for (size_t I = 0, N = Sources.size(); I != N; ++I) {
+    auto Source = Sources[I];
+    auto Result = Source->HandleObjC3SourceImport(CanonicalModule, ImportLoc);
