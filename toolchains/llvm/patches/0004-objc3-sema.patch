+QualType withNullability(ASTContext &Context, QualType Type,
+                         NullabilityKind Kind) {
+  (void)AttributedType::stripOuterNullability(Type);
+  attr::Kind Attribute = Kind == NullabilityKind::NonNull
+                             ? attr::TypeNonNull
+                         : (Kind == NullabilityKind::Nullable ||
+                            Kind == NullabilityKind::NullableResult)
+                             ? attr::TypeNullable
+                             : attr::TypeNullUnspecified;
+  return Context.getAttributedType(Attribute, Type, Type);
+}
+
+bool isNonnullFallback(Expr *Value) {
+  if (auto Kind = Value->getType()->getNullability())
+    return *Kind == NullabilityKind::NonNull;
+  // These literals have no nullable dynamic case even when their builtin type
+  // carries no explicit nullability sugar.
+  return isa<ObjCStringLiteral, ObjCBoxedExpr, BlockExpr>(
+      Value->IgnoreParenImpCasts());
+}
+
+ExprResult buildOptionalCoalescing(Sema &S, Expr *LHS, Expr *RHS,
+                                    const ObjC3OptionalType *Optional,
+                                    SourceLocation Loc) {
+  QualType Payload = Optional->getElementType();
+  bool ReturnCarrier = S.Context.hasSameUnqualifiedType(LHS->getType(),
+                                                         RHS->getType());
+  if (Payload->isVoidType() && !ReturnCarrier) {
+    S.Diag(Loc, diag::err_objc3_coalesce_void_payload);
+    return ExprError();
+  }
+  if (!Payload->isVoidType() &&
+      S.RequireCompleteType(Loc, Payload, diag::err_typecheck_decl_incomplete_type))
+    return ExprError();
+  if (!ReturnCarrier) {
+    // Nested Optional payloads are unwrapped by one layer. A fallback already
+    // having the payload type must never be wrapped in another Optional.
+    auto Conversion = S.TryImplicitConversion(
+        RHS, Payload, /*SuppressUserConversions=*/false,
+        Sema::AllowedExplicit::None, /*InOverloadResolution=*/false,
+        /*CStyle=*/false, /*AllowObjCWritebackConversion=*/false);
+    if (Conversion.isBad()) {
+      S.Diag(Loc, diag::err_objc3_coalesce_fallback_type)
+          << RHS->getType() << Payload << RHS->getSourceRange();
+      return ExprError();
+    }
+  }
+
+  QualType BoundType = ReturnCarrier ? LHS->getType() : Payload;
+  BoundType = S.Context.getConstType(BoundType.getUnqualifiedType());
+  auto *Binding = VarDecl::Create(
+      S.Context, S.CurContext, Loc, Loc, nullptr, BoundType,
+      S.Context.getTrivialTypeSourceInfo(BoundType, Loc), SC_None);
+  Binding->setImplicit();
+  S.CurContext->addDecl(Binding);
+  auto *BindingStmt = new (S.Context) DeclStmt(DeclGroupRef(Binding), Loc, Loc);
+  Expr *Present = S.BuildDeclRefExpr(Binding, BoundType, VK_LValue, Loc);
+  auto *Some = new (S.Context) ObjC3MatchArm(
+      objc3::MatchPatternKind::OptionalSome, nullptr, BindingStmt, nullptr,
+      Present, Binding,
+      ReturnCarrier ? objc3::MatchBindingKind::Scrutinee
+                    : objc3::MatchBindingKind::OptionalPayload,
+      LHS->getType().getCanonicalType(), false, true, Loc, Loc,
+      SourceLocation(), Loc);
+  auto *None = new (S.Context) ObjC3MatchArm(
+      objc3::MatchPatternKind::OptionalNone, nullptr, nullptr, nullptr, RHS,
+      nullptr, objc3::MatchBindingKind::None,
+      LHS->getType().getCanonicalType(), false, true, Loc, Loc,
+      SourceLocation(), Loc);
+  ObjC3MatchArm *Arms[] = {Some, None};
+  ExprResult Result = S.ActOnObjC3MatchExpr(
+      LHS, Arms, Loc, LHS->getBeginLoc(), LHS->getEndLoc(), Loc,
+      RHS->getEndLoc());
+  if (Result.isInvalid())
+    return ExprError();
+  if (ReturnCarrier) {
+    Result.get()->setType(LHS->getType().getUnqualifiedType());
+  } else if (Result.get()->getType()->isObjCRetainableType()) {
+    // Carrier presence proves the tag, not the payload's pointer value.
+    // Some(nil) remains successful even with a nonnull fallback. Native
+    // match joins canonical types, so restore this operator's nullable join.
+    auto Left = Payload->getNullability();
+    auto Right = RHS->getType()->getNullability();
+    NullabilityKind L = Left ? *Left : NullabilityKind::Nullable;
+    NullabilityKind R = isNonnullFallback(RHS)
+                            ? NullabilityKind::NonNull
+                            : Right ? *Right : NullabilityKind::Nullable;
+    NullabilityKind Joined = NullabilityKind::NonNull;
+    if (L == NullabilityKind::Nullable || R == NullabilityKind::Nullable ||
+        L == NullabilityKind::NullableResult ||
+        R == NullabilityKind::NullableResult)
+      Joined = NullabilityKind::Nullable;
+    else if (L == NullabilityKind::Unspecified ||
+             R == NullabilityKind::Unspecified)
+      Joined = NullabilityKind::Unspecified;
+    Result.get()->setType(
+        withNullability(S.Context, Result.get()->getType(), Joined));
+  }
+  return Result;
+}
+} // namespace
+
+ExprResult Sema::ActOnObjC3CoalesceExpr(Expr *LHS, Expr *RHS,
+                                       SourceLocation OperatorLoc) {
+  if (!LHS || !RHS)
+    return ExprError();
+  ExprResult CheckedLHS = CheckPlaceholderExpr(LHS);
+  ExprResult CheckedRHS = CheckPlaceholderExpr(RHS);
+  if (CheckedLHS.isInvalid() || CheckedRHS.isInvalid())
+    return ExprError();
+  LHS = CheckedLHS.get();
+  RHS = CheckedRHS.get();
+  if (LHS->isTypeDependent() || RHS->isTypeDependent())
+    return ObjC3CoalesceExpr::Create(Context, Context.DependentTy, LHS, RHS,
+                                      nullptr, OperatorLoc);
+
+  ExprResult Semantic;
+  if (const auto *Optional = LHS->getType()->getAs<ObjC3OptionalType>()) {
+    Semantic = buildOptionalCoalescing(*this, LHS, RHS, Optional, OperatorLoc);
+  } else if (LHS->getType()->isObjCRetainableType()) {
+    if (!RHS->getType()->isObjCRetainableType() &&
+        !RHS->isNullPointerConstant(Context, Expr::NPC_ValueDependentIsNotNull)) {
+      Diag(OperatorLoc, diag::err_objc3_coalesce_fallback_type)
+          << RHS->getType() << LHS->getType() << RHS->getSourceRange();
+      return ExprError();
+    }
+    // The successful presence test refines the selected pointer. Do not let
+    // the conditional operator diagnose a conversion from its written nullable
+    // source to a nonnull fallback before this operator computes its own join.
+    QualType LoadedType = LHS->getType();
+    (void)AttributedType::stripOuterNullability(LoadedType);
+    Expr *Loaded = ImplicitCastExpr::Create(
+        Context, LoadedType, CK_NoOp, LHS, nullptr, LHS->getValueKind(),
+        FPOptionsOverride());
+    Semantic = ActOnConditionalOp(OperatorLoc, OperatorLoc, Loaded,
+                                   /*Middle=*/nullptr, RHS);
+    if (!Semantic.isInvalid()) {
+      NullabilityKind Nullability = NullabilityKind::Nullable;
+      if (LHS->getType()->getNullability() == NullabilityKind::NonNull ||
+          isNonnullFallback(RHS))
+        Nullability = NullabilityKind::NonNull;
+      else if (auto Written = RHS->getType()->getNullability())
+        Nullability = *Written;
+      Semantic.get()->setType(
+          withNullability(Context, Semantic.get()->getType(), Nullability));
+    }
+  } else {
+    Diag(OperatorLoc, diag::err_objc3_coalesce_requires_optional)
+        << LHS->getType() << LHS->getSourceRange();
+    return ExprError();
+  }
+  if (Semantic.isInvalid())
+    return ExprError();
+  return ObjC3CoalesceExpr::Create(Context, Semantic.get()->getType(), LHS,
+                                    RHS, Semantic.get(), OperatorLoc);
+}
diff --git a/clang/lib/Sema/SemaObjC3OptionalAccess.cpp b/clang/lib/Sema/SemaObjC3OptionalAccess.cpp
new file mode 100644
index 000000000..ef0b1bc0a
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3OptionalAccess.cpp
@@ -0,0 +1,156 @@
+//===--- SemaObjC3OptionalAccess.cpp - Reference-only optional access -----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/DeclSpec.h"
+#include "clang/Sema/ParsedTemplate.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Sema/SemaObjC.h"
+#include "llvm/ADT/APInt.h"
+
+using namespace clang;
+
+namespace {
+QualType nullableType(ASTContext &Context, QualType Type, bool Nonnull) {
+  (void)AttributedType::stripOuterNullability(Type);
+  return Context.getAttributedType(
+      Nonnull ? attr::TypeNonNull : attr::TypeNullable, Type, Type);
+}
+
+ExprResult prepareReceiver(Sema &S, Scope *Scope, Expr *&WrittenReceiver,
+                           SourceLocation Loc) {
+  // C++ disambiguation can leave a parenthesized operand as a ParenListExpr,
+  // which has no type. Normalize it just as ordinary postfix member access
+  // does, before checking placeholder types or retaining a written operand.
+  ExprResult Normalized =
+      S.MaybeConvertParenListExprToParenExpr(Scope, WrittenReceiver);
+  if (Normalized.isInvalid())
+    return ExprError();
+  WrittenReceiver = Normalized.get();
+  ExprResult Checked = S.CheckPlaceholderExpr(WrittenReceiver);
+  if (Checked.isInvalid())
+    return ExprError();
+  Expr *Receiver = Checked.get();
+  if (!Receiver->isTypeDependent() &&
+      !Receiver->getType()->isObjCObjectPointerType()) {
+    S.Diag(Loc, diag::err_objc3_optional_access_receiver)
+        << Receiver->getType() << Receiver->getSourceRange();
+    return ExprError();
+  }
+  return S.DefaultFunctionArrayLvalueConversion(Receiver);
+}
+
+OpaqueValueExpr *makeReceiver(Sema &S, Expr *Source, SourceLocation Loc) {
+  QualType Type = Source->getType();
+  if (!Source->isTypeDependent()) {
+    Type = nullableType(S.Context, Type, /*Nonnull=*/true);
+    if (S.getLangOpts().ObjCAutoRefCount) {
+      // Hold one loaded receiver across argument/getter evaluation. The
+      // ordinary ARC casts preserve its cleanup through PCH and replay.
+      Source = ImplicitCastExpr::Create(S.Context, Source->getType(),
+          CK_ARCProduceObject, Source, nullptr, VK_PRValue, FPOptionsOverride());
+      Source = ImplicitCastExpr::Create(S.Context, Source->getType(),
+          CK_ARCConsumeObject, Source, nullptr, VK_PRValue, FPOptionsOverride());
+      S.Cleanup.setExprNeedsCleanups(true);
+    }
+  }
+  return new (S.Context) OpaqueValueExpr(Loc, Type, VK_PRValue, OK_Ordinary,
+                                        Source);
+}
+} // namespace
+
+ExprResult Sema::BuildObjC3OptionalAccess(
+    Expr *WrittenReceiver, OpaqueValueExpr *Receiver, Expr *Access,
+    IdentifierInfo *Member, SourceLocation OperatorLoc, SourceLocation MemberLoc,
+    SourceLocation LBracketLoc, SourceLocation RBracketLoc) {
+  if (WrittenReceiver->isTypeDependent() || Access->isTypeDependent())
+    return ObjC3OptionalAccessExpr::Create(
+        Context, Context.DependentTy, WrittenReceiver, Access, nullptr, Member,
+        OperatorLoc, MemberLoc, LBracketLoc, RBracketLoc);
+  ExprResult Value = CheckPlaceholderExpr(Access);
+  if (Value.isInvalid())
+    return ExprError();
+  Access = Value.get();
+  QualType ResultType = Access->getType();
+  if (!ResultType->isObjCRetainableType() &&
+      !(Member == nullptr && ResultType->isVoidType())) {
+    Diag(OperatorLoc, diag::err_objc3_optional_access_result)
+        << (Member == nullptr) << ResultType << Access->getSourceRange();
+    return ExprError();
+  }
+
+  Expr *Source = Receiver->getSourceExpr();
+  Expr *Zero = IntegerLiteral::Create(
+      Context, llvm::APInt(Context.getIntWidth(Context.IntTy), 0), Context.IntTy,
+      OperatorLoc);
+  Expr *Absent = Zero;
+  if (ResultType->isVoidType())
+    Absent = ImplicitCastExpr::Create(Context, Context.VoidTy, CK_ToVoid, Zero,
+        nullptr, VK_PRValue, FPOptionsOverride());
+  Expr *SelectedAccess = Access;
+  if (ResultType->isObjCRetainableType()) {
+    QualType JoinedType = ResultType;
+    (void)AttributedType::stripOuterNullability(JoinedType);
+    SelectedAccess = ImplicitCastExpr::Create(
+        Context, JoinedType, CK_NoOp, Access, nullptr, Access->getValueKind(),
+        FPOptionsOverride());
+    Absent = ImplicitCastExpr::Create(Context, JoinedType, CK_NullToPointer,
+        Zero, nullptr, VK_PRValue, FPOptionsOverride());
+  }
+  ExprResult Joined = ActOnConditionalOp(OperatorLoc, OperatorLoc, Receiver,
+                                          SelectedAccess, Absent);
+  if (Joined.isInvalid())
+    return ExprError();
+  auto *Conditional = cast<ConditionalOperator>(Joined.get());
+  ResultType = Conditional->getType();
+  if (!ResultType->isVoidType())
+    ResultType = nullableType(Context, ResultType, /*Nonnull=*/false);
+  auto *Semantic = new (Context) BinaryConditionalOperator(
+      Source, Receiver, Conditional->getCond(), Conditional->getTrueExpr(),
+      Conditional->getFalseExpr(), OperatorLoc, OperatorLoc, ResultType,
+      VK_PRValue, OK_Ordinary);
+  return ObjC3OptionalAccessExpr::Create(
+      Context, ResultType, WrittenReceiver, Access, Semantic, Member, OperatorLoc,
+      MemberLoc, LBracketLoc, RBracketLoc);
+}
+
+ExprResult Sema::ActOnObjC3OptionalMemberExpr(
+    Scope *Scope, Expr *Base, SourceLocation OperatorLoc, IdentifierInfo *Member,
+    SourceLocation MemberLoc, Decl *ObjCImplementation) {
+  ExprResult Source = prepareReceiver(*this, Scope, Base, OperatorLoc);
+  if (Source.isInvalid())
+    return ExprError();
+  auto *Receiver = makeReceiver(*this, Source.get(), OperatorLoc);
+  CXXScopeSpec SS;
+  UnqualifiedId Name;
+  Name.setIdentifier(Member, MemberLoc);
+  ExprResult Access = ActOnMemberAccessExpr(
+      Scope, Receiver, OperatorLoc, tok::period, SS, SourceLocation(), Name,
+      ObjCImplementation);
+  if (Access.isInvalid())
+    return ExprError();
+  return BuildObjC3OptionalAccess(Base, Receiver, Access.get(), Member,
+                                  OperatorLoc, MemberLoc, SourceLocation(),
+                                  SourceLocation());
+}
+
+ExprResult Sema::ActOnObjC3OptionalMessageExpr(
+    Scope *Scope, Expr *Base, Selector Sel, SourceLocation LBracketLoc,
+    ArrayRef<SourceLocation> SelectorLocs, SourceLocation RBracketLoc,
+    MultiExprArg Args, SourceLocation OperatorLoc) {
+  ExprResult Source = prepareReceiver(*this, Scope, Base, OperatorLoc);
+  if (Source.isInvalid())
+    return ExprError();
+  auto *Receiver = makeReceiver(*this, Source.get(), OperatorLoc);
+  ExprResult Access = ObjC().ActOnInstanceMessage(
+      Scope, Receiver, Sel, LBracketLoc, SelectorLocs, RBracketLoc, Args);
+  if (Access.isInvalid())
+    return ExprError();
+  return BuildObjC3OptionalAccess(Base, Receiver, Access.get(), nullptr,
+                                  OperatorLoc, SourceLocation(), LBracketLoc,
+                                  RBracketLoc);
+}
diff --git a/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp b/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp
new file mode 100644
index 000000000..4c5f0dba4
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp
@@ -0,0 +1,195 @@
+//===--- SemaObjC3NonlocalJumps.cpp - Scope-exit nonlocal transfers --------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "SemaObjC3Resources.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ObjC3SourceScopes.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/Basic/Builtins.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/STLExtras.h"
+
+using namespace clang;
+
+namespace {
+enum class JumpKind { None, Save, Restore };
+JumpKind jumpKind(const CallExpr *Call) {
+  const FunctionDecl *Function = Call->getDirectCallee();
+  if (!Function)
+    return JumpKind::None;
+  switch (Function->getBuiltinID()) {
+  case Builtin::BI__builtin_setjmp:
+  case Builtin::BI__sigsetjmp:
+  case Builtin::BI_setjmp:
+  case Builtin::BIsetjmp:
+  case Builtin::BIsigsetjmp:
+    return JumpKind::Save;
+  case Builtin::BI__builtin_longjmp:
+  case Builtin::BI_longjmp:
+  case Builtin::BIlongjmp:
+  case Builtin::BIsiglongjmp:
+    return JumpKind::Restore;
+  default:
+    break;
+  }
+  // -fno-builtin does not change the C library's nonlocal-transfer contract.
+  // A C++ member or namespace function with the same name has no such contract.
+  if (Function->getIdentifier() &&
+      (Function->isExternC() ||
+       (!Function->getASTContext().getLangOpts().CPlusPlus &&
+        Function->getDeclContext()->getRedeclContext()->isTranslationUnit()))) {
+    StringRef Name = Function->getName();
+    if (Name == "setjmp" || Name == "_setjmp" || Name == "sigsetjmp" ||
+        Name == "__sigsetjmp")
+      return JumpKind::Save;
+    if (Name == "longjmp" || Name == "_longjmp" || Name == "siglongjmp")
+      return JumpKind::Restore;
+  }
+  return JumpKind::None;
+}
+
+class NonlocalJumpCheck {
+  struct Action {
+    const Stmt *Owner;
+    const Stmt *Initializer;
+    SourceLocation Registration;
+  };
+  Sema &Actions;
+  ObjC3SourceScopes Scopes;
+  llvm::DenseMap<const Stmt *, const Stmt *> Parents;
+  llvm::DenseMap<const VarDecl *, unsigned> References, JumpReferences;
+  llvm::SmallPtrSet<const VarDecl *, 16> Captured;
+  SmallVector<const CallExpr *, 8> Saves, Restores;
+  SmallVector<Action, 16> Registrations;
+
+  void collect(const Stmt *Node, const Stmt *Parent = nullptr) {
+    if (!Node)
+      return;
+    Parents[Node] = Parent;
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Node))
+      if (const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl()))
+        ++References[Variable];
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const LambdaCapture &Capture : Lambda->captures())
+        if (Capture.capturesVariable())
+          if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+            Captured.insert(Variable);
+      for (const Expr *Initializer : Lambda->capture_inits())
+        collect(Initializer, Node);
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      for (const BlockDecl::Capture &Capture : Block->getBlockDecl()->captures())
+        Captured.insert(Capture.getVariable());
+      return; // The nested callable has its own completed-body check.
+    }
+    if (const auto *Call = dyn_cast<CallExpr>(Node)) {
+      JumpKind Kind = jumpKind(Call);
+      if (Kind != JumpKind::None) {
+        (Kind == JumpKind::Save ? Saves : Restores).push_back(Call);
+        if (const VarDecl *Variable = buffer(Call))
+          ++JumpReferences[Variable];
+      }
+    }
+    for (const Stmt *Child : Node->children())
+      collect(Child, Node);
+  }
+
+  const VarDecl *buffer(const CallExpr *Call) const {
+    if (Call->getNumArgs() == 0)
+      return nullptr;
+    const auto *Reference =
+        dyn_cast<DeclRefExpr>(Call->getArg(0)->IgnoreParenImpCasts());
+    return Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+  }
+  bool within(const Stmt *Node, const Stmt *Owner) const {
+    for (; Node; Node = Parents.lookup(Node))
+      if (Node == Owner)
+        return true;
+    return false;
+  }
+  const Stmt *owner(const Stmt *SourceOwner) const {
+    // A for-condition declaration owns the per-iteration release queue, but
+    // its cleanup remains registered while the condition and body execute.
+    if (isa<DeclStmt>(SourceOwner))
+      if (const auto *Loop = dyn_cast_or_null<ForStmt>(Parents.lookup(SourceOwner)))
+        if (Loop->getConditionVariableDeclStmt() == SourceOwner)
+          return Loop;
+    return SourceOwner;
+  }
+  bool pending(const Action &Action, const CallExpr *Call) const {
+    return within(Call, Action.Owner) &&
+           (!Action.Initializer || !within(Call, Action.Initializer)) &&
+           Actions.getSourceManager().isBeforeInTranslationUnit(
+               Action.Registration, Call->getExprLoc());
+  }
+  const CallExpr *localTarget(const CallExpr *Restore) const {
+    const VarDecl *Buffer = buffer(Restore);
+    if (!Buffer || !Buffer->hasLocalStorage() || Buffer->hasAttr<BlocksAttr>() ||
+        !Buffer->getType()->isArrayType() || Captured.contains(Buffer) ||
+        References.lookup(Buffer) != JumpReferences.lookup(Buffer))
+      return nullptr;
+    const CallExpr *Target = nullptr;
+    for (const CallExpr *Save : Saves)
+      if (buffer(Save) == Buffer) {
+        if (Target)
+          return nullptr; // Multiple saves require dynamic target analysis.
+        Target = Save;
+      }
+    return Target;
+  }
+
+public:
+  NonlocalJumpCheck(Sema &Actions, const Stmt *Body)
+      : Actions(Actions), Scopes(Body) {
+    collect(Body);
+    for (auto [Deferred, Owner] : Scopes.Defers)
+      Registrations.push_back({owner(Owner), nullptr, Deferred->getBeginLoc()});
+    for (auto [Variable, Owner] : Scopes.Variables)
+      if (!Variable->isInvalidDecl() &&
+          (Variable->hasAttr<CleanupAttr>() || Variable->hasAttr<ObjCCleanupAttr>() ||
+           Variable->hasAttr<ObjCResourceAttr>() ||
+           Variable->hasAttr<ObjC3LifetimeBindingAttr>()))
+        Registrations.push_back({owner(Owner), Variable->getInit(),
+                                 Variable->getLocation()});
+    llvm::stable_sort(Registrations, [&](const Action &Left, const Action &Right) {
+      return Actions.getSourceManager().isBeforeInTranslationUnit(
+          Right.Registration, Left.Registration);
+    });
+  }
+  bool check() {
+    bool Invalid = false;
+    for (const CallExpr *Restore : Restores) {
+      const CallExpr *Target = localTarget(Restore);
+      for (const Action &Registration : Registrations) {
+        if (!pending(Registration, Restore) ||
+            (Target && pending(Registration, Target)))
+          continue;
+        Actions.Diag(Restore->getExprLoc(),
+                     Actions.getDiagnostics().getCustomDiagID(
+                         DiagnosticsEngine::Error,
+                         "non-local jump may bypass a registered cleanup action "
+                         "in a strict profile"));
+        Actions.Diag(Registration.Registration,
+                     Actions.getDiagnostics().getCustomDiagID(
+                         DiagnosticsEngine::Note,
+                         "scope-exit action registered here"));
+        Invalid = true;
+        break; // One action explains this transfer; do not duplicate errors.
+      }
+    }
+    return Invalid;
+  }
+};
+} // namespace
+
+bool clang::checkObjC3NonlocalJumps(Sema &S, const Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile == 0 || !Body)
+    return false;
+  return NonlocalJumpCheck(S, Body).check();
+}
