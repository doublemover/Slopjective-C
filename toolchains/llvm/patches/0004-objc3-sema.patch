+QualType TreeTransform<Derived>::TransformObjC3OptionalType(
+    TypeLocBuilder &TLB, ObjC3OptionalTypeLoc TL) {
+  TypeSourceInfo *Element = getDerived().TransformType(TL.getElementLoc());
