+    for (const auto *A:New->getParamDecl(I)->specific_attrs<LifetimeCaptureByAttr>())Current.push_back(A);
+    for (const auto *A:Old->getParamDecl(I)->specific_attrs<LifetimeCaptureByAttr>())Previous.push_back(A);
+    Check(Current,Previous);
