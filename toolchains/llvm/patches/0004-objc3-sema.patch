+static unsigned lifetimeCaptureMode(const LifetimeCaptureByAttr *A) {
+  return A->isThis() ? 1 : A->isGlobal() ? 2 : A->isUnknown() ? 3 : 0;
+}
+static SmallVector<const LifetimeCaptureByAttr *, 4>
+receiverLifetimeCaptures(const FunctionDecl *F) {
+  SmallVector<const LifetimeCaptureByAttr *, 4> Captures;
+  const auto *Method = dyn_cast<CXXMethodDecl>(F);
+  if (!Method || Method->isStatic() || Method->isExplicitObjectMemberFunction())
+    return Captures;
+  if (auto *Info = F->getTypeSourceInfo())
+    for (TypeLoc Type = Info->getTypeLoc();;) {
+      auto Attribute = Type.getAsAdjusted<AttributedTypeLoc>();
+      if (!Attribute) break;
+      if (auto *Capture = Attribute.getAttrAs<LifetimeCaptureByAttr>())
+        Captures.push_back(Capture);
+      Type = Attribute.getModifiedLoc();
+    }
+  return Captures;
+}
+static void mergeReceiverLifetimeCaptures(FunctionDecl *New,
+                                          const FunctionDecl *Old, Sema &S) {
+  const auto Existing = receiverLifetimeCaptures(New);
+  for (const auto *Previous : receiverLifetimeCaptures(Old)) {
+    if (llvm::any_of(Existing, [&](const LifetimeCaptureByAttr *A) {
+          return lifetimeCaptureMode(A) == lifetimeCaptureMode(Previous);
+        }))
+      continue;
+    auto *Inherited = Previous->clone(S.Context);Inherited->setInherited(true);
+    QualType Original = New->getType();
+    QualType Wrapped = S.Context.getAttributedType(Inherited, Original, Original);
+    TypeLocBuilder Builder;
+    if (auto *Info = New->getTypeSourceInfo())Builder.pushFullCopy(Info->getTypeLoc());
+    auto Location = Builder.push<AttributedTypeLoc>(Wrapped);Location.setAttr(Inherited);
+    New->setType(Wrapped);New->setTypeSourceInfo(Builder.getTypeSourceInfo(S.Context,Wrapped));
