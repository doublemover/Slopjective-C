+    return isMutableObjC3CaptureCarrierTree(Context, Optional->getElementType(),
+                                            Depth + 1);
+  if (const auto *Result = dyn_cast<ObjC3ResultType>(Canonical))
+    return isMutableObjC3CaptureCarrierTree(Context, Result->getSuccessType(),
+                                            Depth + 1) &&
+           isMutableObjC3CaptureCarrierTree(Context, Result->getErrorType(),
+                                            Depth + 1);
+  return true;
