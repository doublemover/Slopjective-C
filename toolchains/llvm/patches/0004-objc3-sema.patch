+static bool isMutableObjC3CaptureCarrierTree(ASTContext &Context, QualType Type,
+                                               unsigned Depth = 0) {
+  if (Depth > 64 || Type.isConstQualified() || Type.isVolatileQualified() ||
+      Type->isAtomicType() || getObjC3ResourceTypeContract(Context, Type).Cleanup)
