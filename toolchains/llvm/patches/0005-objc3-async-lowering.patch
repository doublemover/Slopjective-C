+llvm::Value *clang::CodeGen::emitObjC3CAsyncCheckedMultiply(
+    CodeGenFunction &CGF, llvm::Value *Left, llvm::Value *Right) {
+  return checkedStorageArithmetic(CGF, llvm::Intrinsic::umul_with_overflow,
+                                  Left, Right);
+}
+
+llvm::Value *clang::CodeGen::emitObjC3CAsyncStorage(
+    CodeGenFunction &CGF, llvm::Value *Bytes, CharUnits RequestedAlignment,
+    const VarDecl *Owner) {
+  auto &Data = *CGF.ObjC3CAsync.Data;
+  // One pointer-sized, aligned header links builtin allocas until frame exit.
+  // A lexical VLA owns its allocation directly and is released after its users.
+  CharUnits Alignment = std::max(RequestedAlignment,
+                                 CGF.getPointerAlign());
+  auto *Align = llvm::ConstantInt::get(CGF.SizeTy, Alignment.getQuantity());
+  auto *Mask = llvm::ConstantInt::get(CGF.SizeTy, Alignment.getQuantity() - 1);
+  Bytes = CGF.Builder.CreateZExtOrTrunc(Bytes, CGF.SizeTy);
+  if (!Owner)
+    Bytes = checkedStorageArithmetic(CGF, llvm::Intrinsic::uadd_with_overflow,
+                                     Bytes, Align);
+  // A zero-byte VLA still has a nonnull owner. Never call aligned_alloc(0).
+  Bytes = CGF.Builder.CreateSelect(CGF.Builder.CreateIsNull(Bytes), Align, Bytes);
+  auto *Padded = checkedStorageArithmetic(CGF, llvm::Intrinsic::uadd_with_overflow,
+                                          Bytes, Mask);
+  auto *Rounded = CGF.Builder.CreateAnd(Padded, CGF.Builder.CreateNot(Mask));
+  auto *Memory = call(CGF, "aligned_alloc", CGF.Int8PtrTy, {Align, Rounded});
+  auto *Failed = CGF.createBasicBlock("objc3.storage.failed");
+  auto *Ready = CGF.createBasicBlock("objc3.storage.ready");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNull(Memory), Failed, Ready);
+  CGF.EmitBlock(Failed);
+  replaceError(CGF, Data, serviceError(CGF, CGF.Builder.getInt32(3)));
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(1), Data.Kind);
+  CGF.EmitBranchThroughCleanup(Data.Final);
+  CGF.EmitBlock(Ready);
+  if (!Owner) {
+    Address Link(Memory, CGF.Int8PtrTy, Alignment);
+    CGF.Builder.CreateStore(CGF.Builder.CreateLoad(Data.DynamicAllocations), Link);
+    CGF.Builder.CreateStore(Memory, Data.DynamicAllocations);
+    return CGF.Builder.CreateInBoundsGEP(CGF.Int8Ty, Memory, Align,
+                                         "objc3.alloca.storage");
+  }
+  Address Slot = CGF.CreateTempAlloca(CGF.Int8PtrTy, CGF.getPointerAlign(),
+                                      "objc3.vla.owner");
+  CGF.Builder.CreateStore(Memory, Slot);
+  if (CGF.hasObjC3DeferredSourceOwner(Owner))
+    CGF.EHStack.pushCleanup<EmitObjC3OrderedRelease>(
+        NormalAndEHCleanup, CGF.registerObjC3SourceRelease(
+            Owner, Slot, true,
+            [](CodeGenFunction &CGF, Address Storage,
+               EHScopeStack::Cleanup::Flags) {
+              freeDynamicStorage(CGF, Storage);
+            }));
+  else
+    CGF.EHStack.pushCleanup<FreeDynamicStorage>(NormalAndEHCleanup, Slot);
+  return Memory;
+}
