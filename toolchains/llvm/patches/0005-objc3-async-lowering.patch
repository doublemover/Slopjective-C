+llvm::Value *checkedStorageArithmetic(CodeGenFunction &CGF,
+                                      llvm::Intrinsic::ID Op,
+                                      llvm::Value *Left, llvm::Value *Right) {
+  auto *Checked = CGF.Builder.CreateCall(CGF.CGM.getIntrinsic(Op, {CGF.SizeTy}),
+                                         {Left, Right});
+  auto *Overflow = CGF.Builder.CreateExtractValue(Checked, 1);
+  auto *Failed = CGF.createBasicBlock("objc3.storage.overflow");
+  auto *Ready = CGF.createBasicBlock("objc3.storage.size");
+  CGF.Builder.CreateCondBr(Overflow, Failed, Ready);
+  CGF.EmitBlock(Failed);
+  auto &Data = *CGF.ObjC3CAsync.Data;
+  replaceError(CGF, Data, serviceError(CGF, CGF.Builder.getInt32(3)));
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(1), Data.Kind);
+  CGF.EmitBranchThroughCleanup(Data.Final);
+  CGF.EmitBlock(Ready);
+  return CGF.Builder.CreateExtractValue(Checked, 0);
+}
