+class NilResultClassifier {
+  ASTContext &Ctx;
+  llvm::DenseMap<const RecordDecl *, bool> Records;
+  unsigned Budget = 4096;
+public:
+  explicit NilResultClassifier(ASTContext &Ctx) : Ctx(Ctx) {}
+  bool requiresFailure(QualType Type, unsigned Depth = 0) {
+    if (Depth > 64 || !Budget || Type->isReferenceType() ||
+        getObjC3ResourceTypeContract(Ctx, Type).Cleanup) return true;
+    --Budget;
+    if (const auto *Array = Ctx.getAsArrayType(Type))
+      return requiresFailure(Array->getElementType(), Depth + 1);
+    const auto *Record = Type->getAsRecordDecl();
+    if (!Record) return false;
+    if (!Type.isTriviallyCopyableType(Ctx)) return true;
+    const auto *Definition = Record->getDefinition();
+    if (!Definition) return true;
+    if (auto Found = Records.find(Definition); Found != Records.end())
+      return Found->second;
+    // Only structural C++ values have a zero-state independent of user
+    // construction and default member initializers. Memoize shared record
+    // graphs so repeated by-value shapes take bounded work.
+    Records[Definition] = true;
+    if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition);
+        Class && !Class->isAggregate()) return true;
+    for (const FieldDecl *Field : Definition->fields())
+      if (Field->hasInClassInitializer() || Field->hasAttr<ObjCResourceAttr>() ||
+          Field->hasAttr<ObjCCleanupAttr>() ||
+          requiresFailure(Field->getType(), Depth + 1)) return true;
+    if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+      for (const auto &Base : Class->bases())
+        if (requiresFailure(Base.getType(), Depth + 1)) return true;
+    return Records[Definition] = false;
+  }
+};
+static bool nilResultRequiresFailure(ASTContext &Ctx, QualType Type) {
+  return NilResultClassifier(Ctx).requiresFailure(Type);
+}
+
+static const ParmVarDecl *isolationNilReceiver(const FunctionDecl &Function,
+                                                 const Stmt &Body) {
+  if (!Function.getNumParams()) return nullptr;
+  const auto *Receiver = Function.getParamDecl(0);
+  if (!Receiver->getType()->isObjCObjectPointerType()) return nullptr;
+  const auto *Marker = Function.getAttr<ObjC3IsolationThunkAttr>();
+  if (Marker && Marker->getActorEntry()) return Receiver;
+  SmallVector<const Stmt *, 16> Pending{&Body};
+  unsigned Budget = 4096;
+  while (!Pending.empty() && Budget--) {
+    const Stmt *Node = Pending.pop_back_val();
+    if (!Node) continue;
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(Node)) {
+      if (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance ||
+          Message->getReceiverKind() == ObjCMessageExpr::SuperClass) return Receiver;
+      const Expr *Value = Message->getInstanceReceiver();
+      for (unsigned I = 0; Value && I != 32; ++I) {
+        Value = Value->IgnoreParenImpCasts();
+        if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Value)) Value = Opaque->getSourceExpr();
+        else break;
+      }
+      if (const auto *Reference = dyn_cast_or_null<DeclRefExpr>(Value);
+          Reference && Reference->getDecl() == Receiver) return Receiver;
+    }
+    if (isa<LambdaExpr, BlockExpr>(Node)) continue;
+    for (const Stmt *Child : Node->children()) Pending.push_back(Child);
+  }
+  return nullptr;
+}
+
+static bool nilPropertyAssignmentHasResult(const Stmt &Body) {
+  const auto *Compound = dyn_cast<CompoundStmt>(&Body);
+  if (!Compound || Compound->size() != 1) return false;
+  const auto *Return = dyn_cast<ReturnStmt>(*Compound->body_begin());
+  if (!Return || !Return->getRetValue()) return false;
+  const Expr *Value = Return->getRetValue();
+  for (unsigned I = 0; I != 32; ++I) {
+    Value = Value->IgnoreParenImpCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Value)) Value = Cleanups->getSubExpr();
+    else if (const auto *Temporary = dyn_cast<CXXBindTemporaryExpr>(Value)) Value = Temporary->getSubExpr();
+    else break;
+  }
+  const auto *Pseudo = dyn_cast<PseudoObjectExpr>(Value);
+  const auto *Assignment = Pseudo ? dyn_cast<BinaryOperator>(Pseudo->getSyntacticForm()->IgnoreParenImpCasts()) : nullptr;
+  return Assignment && Assignment->getOpcode() == BO_Assign &&
+      isa<ObjCPropertyRefExpr>(Assignment->getLHS()->IgnoreParenImpCasts());
+}
