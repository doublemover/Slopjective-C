+      CGM.CreateRuntimeFunction(Type, "__objc3_task_error_create"), {OwnedError});
+  LValue Base = MakeAddrLValue(GetAddrOfLocalVar(Promise), Promise->getType());
+  LValue ErrorSlot = EmitLValueForField(Base, ErrorField);
+  llvm::Value *Previous = EmitLoadOfScalar(ErrorSlot, SourceLocation());
+  EmitStoreOfScalar(Error, ErrorSlot);
+  auto *ReleaseType = llvm::FunctionType::get(VoidTy, {Int8PtrTy}, false);
+  EmitNounwindRuntimeCall(
+      CGM.CreateRuntimeFunction(ReleaseType, "objc3_error_release"), {Previous});
+  EmitStoreOfScalar(Builder.getTrue(), EmitLValueForField(Base, RaisedField));
+  ++CurCoro.Data->CoreturnCount;
+  EmitBranchThroughCleanup(CurCoro.Data->FinalJD);
+  return true;
+}
