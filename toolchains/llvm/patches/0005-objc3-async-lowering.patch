+bool clang::CodeGen::emitObjC3NilAsyncFrame(CodeGenFunction &Parent, Address Result,
+                                           const ObjCMethodDecl *Method) {
+  if (!Method || !Method->getObjC3FunctionEffects().Async) return false;
+  const bool Task = !Method->getObjC3FunctionEffects().AsyncFrame;
+  auto &CGM = Parent.CGM;
+  auto &Ctx = CGM.getContext();
+  const auto *Original = getObjC3CallableFunctionType(Method);
+  QualType Logical = Original->getReturnType();
+  QualType Frame = Ctx.getObjC3AsyncFrameType(Logical);
+  if (Frame.isNull()) {
+    // ASTContext result/carrier caches are not serialized. A PCH body can
+    // contain a task-only message whose descriptor hooks were prepared by
+    // Sema, but whose frame mapping has not been rebuilt in this context.
+    // Recover the already-validated runtime declaration, not a guessed layout.
+    for (NamedDecl *D : Ctx.getTranslationUnitDecl()->lookup(&Ctx.Idents.get("objc3_async_frame")))
+      if (const auto *Alias = dyn_cast<TypedefNameDecl>(D)) {
+        Frame = Alias->getUnderlyingType();
+        Ctx.setObjC3AsyncFrameType(Logical, Frame);
+        break;
+      }
+  }
+  if (Frame.isNull()) return false;
+  Address FrameResult = Task ? Address(Parent.CreateMemTemp(Frame, "objc3.nil.task.frame")) : Result;
+  if (nilResultRequiresFailure(Ctx, Logical)) {
+    // Preserve the declared type without constructing an owner or C++ value.
+    // Immutable descriptor context makes construction/disposal allocation free;
+    // execution reports INVALID_ARGUMENT through the existing service channel.
+    auto *Descriptor = frameResultDescriptor(Parent, Logical);
+    storeField(Parent, FrameResult, 0, Parent.Builder.getInt32(40));
+    storeField(Parent, FrameResult, 1, Parent.Builder.getInt32(AsyncABI));
+    storeField(Parent, FrameResult, 2, Descriptor);
+    storeField(Parent, FrameResult, 3, typedFailureCallback(Parent, false, 1));
+    storeField(Parent, FrameResult, 4, typedFailureCallback(Parent, true, 1));
+    storeField(Parent, FrameResult, 5, Descriptor);
+  } else {
+    FunctionProtoType::ExtProtoInfo Info;
+    Info.ObjC3Effects.Async = true;
+    Info.ObjC3Effects.AsyncFrame = true;
+    QualType Type = Ctx.getFunctionType(Logical, {}, Info);
+    auto *Function = FunctionDecl::Create(Ctx, Ctx.getTranslationUnitDecl(),
+        SourceLocation(), SourceLocation(), &Ctx.Idents.get("__objc3_nil_frame_entry"),
+        Type, Ctx.getTrivialTypeSourceInfo(Type), SC_Static);
+    Function->setImplicit();
+    if (hasObjC3CFResultOwnership(Method))
+      Function->addAttr(CFReturnsNotRetainedAttr::CreateImplicit(Ctx));
+    Expr *Zero = Logical->isVoidType() ? nullptr : new (Ctx) ImplicitValueInitExpr(Logical);
+    Stmt *Return = ReturnStmt::Create(Ctx, SourceLocation(), Zero, nullptr);
+    auto *Body = CompoundStmt::Create(Ctx, {Return}, FPOptionsOverride(),
+                                       SourceLocation(), SourceLocation());
+    Function->setBody(Body);
+    Ctx.setObjC3AsyncFrameType(Logical, Frame);
+    const auto &FI = CGM.getTypes().arrangeFunctionDeclaration(Function);
+    auto *Entry = llvm::Function::Create(CGM.getTypes().GetFunctionType(FI),
+        llvm::GlobalValue::InternalLinkage, "__objc3_nil_frame_entry", &CGM.getModule());
+    CGM.SetInternalFunctionAttributes(GlobalDecl(Function), Entry, FI);
+    {
+      CodeGenFunction Nil(CGM);
+      FunctionArgList Parameters;
+      Nil.StartFunction(GlobalDecl(Function), Frame, Entry, FI, Parameters);
+      auto Debug = ApplyDebugLocation::CreateArtificial(Nil);
+      Nil.EmitObjC3CAsyncBody(*Function, *Body);
+      Nil.FinishFunction();
+    }
+    CallArgList Arguments;
+    Parent.EmitCall(FI, CGCallee::forDirect(Entry), ReturnValueSlot(FrameResult, false), Arguments);
+  }
+  if (!Task) return true;
+  // Use the SDK's typed constructor. The compiler never guesses the private
+  // layout or destruction behavior of the C++ task carrier.
+  for (NamedDecl *D : Ctx.getTranslationUnitDecl()->lookup(&Ctx.Idents.get("__objc3_async_from_frame"))) {
+    const auto *Template = dyn_cast<FunctionTemplateDecl>(D);
+    if (!Template) continue;
+    for (FunctionDecl *Function : Template->specializations()) {
+      const auto *Args = Function->getTemplateSpecializationArgs();
+      if (!Args || Args->size() != 1 || !Ctx.hasSameUnqualifiedType(Args->get(0).getAsType(), Logical)) continue;
+      CallArgList FromFrame;
+      FromFrame.add(RValue::getAggregate(FrameResult), Function->getParamDecl(0)->getType());
+      Parent.EmitCall(CGM.getTypes().arrangeFunctionDeclaration(Function),
+          CGCallee::forDirect(CGM.GetAddrOfFunction(Function), CGCalleeInfo(GlobalDecl(Function))),
+          ReturnValueSlot(Result, false), FromFrame);
+      return true;
+    }
+  }
+  llvm_unreachable("Sema did not instantiate the nil task result hook");
+}
+
+llvm::Value *clang::CodeGen::emitObjC3CFRetain(CodeGenFunction &CGF,
+                                              llvm::Value *Value) {
+  auto *Incoming = CGF.Builder.GetInsertBlock();
+  auto *Retain = CGF.createBasicBlock("objc3.cf.retain");
+  auto *Done = CGF.createBasicBlock("objc3.cf.retained");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Value), Retain, Done);
+  CGF.EmitBlock(Retain);
+  llvm::Value *Owned = call(CGF, "CFRetain", CGF.Int8PtrTy, {Value});
+  auto *Retained = CGF.Builder.GetInsertBlock();
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+  auto *Result = CGF.Builder.CreatePHI(Value->getType(), 2, "objc3.cf.owner");
+  Result->addIncoming(Value, Incoming);
+  Result->addIncoming(Owned, Retained);
+  return Result;
+}
+
+void clang::CodeGen::emitObjC3CFRelease(CodeGenFunction &CGF,
+                                        llvm::Value *Value) {
+  auto *Release = CGF.createBasicBlock("objc3.cf.release");
+  auto *Done = CGF.createBasicBlock("objc3.cf.released");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Value), Release, Done);
+  CGF.EmitBlock(Release);
+  call(CGF, "CFRelease", CGF.VoidTy, {Value});
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
