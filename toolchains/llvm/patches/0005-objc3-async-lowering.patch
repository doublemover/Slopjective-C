+void clang::CodeGen::initializeObjC3CFTaskResult(CodeGenFunction &CGF, const VarDecl *Promise,
+                                                QualType Result, bool Adopt, bool Foreign) {
+  auto &Ctx = CGF.getContext();
+  for (NamedDecl *D : Ctx.getTranslationUnitDecl()->lookup(&Ctx.Idents.get("__objc3_async_cf_result_ops"))) {
+    const auto *Template = dyn_cast<FunctionTemplateDecl>(D);
+    if (!Template) continue;
+    for (FunctionDecl *Function : Template->specializations()) {
+      const auto *Args = Function->getTemplateSpecializationArgs();
+      if (!Args || Args->size() != 1 || !Ctx.hasSameType(Args->get(0).getAsType(), Promise->getType())) continue;
+      CallArgList Arguments;
+      Arguments.add(RValue::get(CGF.GetAddrOfLocalVar(Promise).emitRawPointer(CGF)), Function->getParamDecl(0)->getType());
+      Arguments.add(RValue::get(valueOps(CGF, Result, Foreign, !Foreign)), Function->getParamDecl(1)->getType());
+      Arguments.add(RValue::get(CGF.Builder.getInt1(Adopt)), Function->getParamDecl(2)->getType());
+      CGF.EmitCall(CGF.CGM.getTypes().arrangeFunctionDeclaration(Function),
+          CGCallee::forDirect(CGF.CGM.GetAddrOfFunction(Function), CGCalleeInfo(GlobalDecl(Function))),
+          ReturnValueSlot(), Arguments);
+      return;
+    }
+  }
+  llvm_unreachable("Sema did not instantiate the native CF promise hook");
+}
