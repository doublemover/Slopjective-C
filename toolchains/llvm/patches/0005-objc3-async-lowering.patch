+bool CodeGenFunction::EmitObjC3AsyncErrorReturn(llvm::Value *OwnedError) {
+  if (ObjC3CAsync.Data)
+    return EmitObjC3CAsyncErrorReturn(OwnedError);
+  const auto *Body = getObjC3CoroutineBody(CurCodeDecl);
+  if (!Body || !CurCoro.Data)
+    return false;
