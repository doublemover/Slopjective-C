diff --git a/clang/lib/Basic/ObjC3Features.cpp b/clang/lib/Basic/ObjC3Features.cpp
new file mode 100644
index 000000000..aae761dec
--- /dev/null
+++ b/clang/lib/Basic/ObjC3Features.cpp
@@ -0,0 +1,19 @@
+#include "clang/Basic/ObjC3Features.h"
+#include "clang/Basic/LangOptions.h"
+#include "clang/Basic/TargetInfo.h"
+
+bool clang::isObjC3FeatureAvailable(ObjC3Feature Feature,
+                                   const LangOptions &LangOpts,
+                                   const TargetInfo &Target) {
+  (void)Target;
+  if (!LangOpts.ObjC3) return false;
+  switch (Feature) {
+#define OBJC3_FEATURE(Name, Macro, Predicate) \
+  case ObjC3Feature::Name: return Predicate;
+#define OBJC3_FEATURE_ALIAS(Name, Macro, Query)
+#include "clang/Basic/ObjC3Features.def"
+#undef OBJC3_FEATURE_ALIAS
+#undef OBJC3_FEATURE
+  }
+  return false;
+}
