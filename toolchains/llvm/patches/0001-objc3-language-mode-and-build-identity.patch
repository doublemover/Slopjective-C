index 000000000..d6be82528
--- /dev/null
+++ b/clang/test/ObjC3/LanguageMode/feature-authority.m
@@ -0,0 +1,39 @@
+// RUN: %clang_cc1 -fsyntax-only -x objective-c %s
+// RUN: %clang_cc1 -fsyntax-only -x objective-c -fobjc-version=3 -fobjc3-profile=compatibility -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 %s
+// RUN: %clang_cc1 -fsyntax-only -x objective-c -fobjc-version=3 -fobjc3-profile=strict -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// RUN: %clang_cc1 -fsyntax-only -x objective-c -fobjc-version=3 -fobjc3-profile=strict-concurrency -triple x86_64-apple-macosx14.0 -fobjc-runtime=macosx-14.0.0 %s
+// RUN: %clang_cc1 -fsyntax-only -x objective-c -fobjc-version=3 -fobjc3-profile=strict-system -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 %s
+
+// Accepted internal syntax is not sufficient evidence for public capabilities.
+#if __has_feature(objc3_defer) || __has_extension(objc3_defer) || \
+    __has_feature(objc3_optionals) || __has_feature(objc3_optional) || \
+    __has_feature(objc3_result) || __has_feature(objc3_throws) || \
+    __has_feature(objc3_typed_throws) || __has_feature(objc3_async_await) || \
+    __has_feature(objc3_async) || __has_feature(objc3_actors)
+#error unqualified feature advertised by a native query
+#endif
+
+#ifdef __OBJC3__
+#if __OBJC3_FEATURE_DEFER__ != __has_feature(objc3_defer) || \
+    __OBJC3_FEATURE_OPTIONALS__ != __has_feature(objc3_optionals) || \
+    __OBJC3_FEATURE_OPTIONAL__ != __has_feature(objc3_optional) || \
+    __OBJC3_FEATURE_RESULT__ != __has_feature(objc3_result) || \
+    __OBJC3_FEATURE_THROWS__ != __has_feature(objc3_throws) || \
+    __OBJC3_FEATURE_TYPED_THROWS__ != __has_feature(objc3_typed_throws) || \
+    __OBJC3_FEATURE_ASYNC_AWAIT__ != __has_feature(objc3_async_await) || \
+    __OBJC3_FEATURE_ASYNC__ != __has_feature(objc3_async) || \
+    __OBJC3_FEATURE_ACTORS__ != __has_feature(objc3_actors)
+#error generated macro and native query disagree
+#endif
+#if !defined(__OBJC3_FEATURE_OPTIONALS__) || \
+    !defined(__OBJC3_FEATURE_THROWS__) || !defined(__OBJC3_FEATURE_ASYNC_AWAIT__)
+#error missing canonical feature macro
+#endif
+#else
+#if defined(__OBJC3_FEATURE_DEFER__) || defined(__OBJC3_FEATURE_OPTIONALS__) || \
+    defined(__OBJC3_FEATURE_THROWS__) || defined(__OBJC3_FEATURE_ASYNC_AWAIT__)
+#error feature macros escaped the explicit language opt-in
+#endif
+#endif
+
+int feature_authority_fixture;
