new file mode 100644
index 000000000..f9c0321df
--- /dev/null
+++ b/clang/include/clang/Basic/ObjC3Features.h
@@ -0,0 +1,21 @@
+#ifndef LLVM_CLANG_BASIC_OBJC3FEATURES_H
+#define LLVM_CLANG_BASIC_OBJC3FEATURES_H
+
+namespace clang {
+class LangOptions;
+class TargetInfo;
+
+enum class ObjC3Feature {
+#define OBJC3_FEATURE(Name, Macro, Predicate) Name,
+#define OBJC3_FEATURE_ALIAS(Name, Macro, Query)
+#include "clang/Basic/ObjC3Features.def"
+#undef OBJC3_FEATURE_ALIAS
+#undef OBJC3_FEATURE
+};
+
+// The generated authority grants a feature only for a qualified target,
+// native runtime and semantic profile. Syntax recognition alone is insufficient.
+bool isObjC3FeatureAvailable(ObjC3Feature Feature, const LangOptions &LangOpts,
+                            const TargetInfo &Target);
+} // namespace clang
+#endif
