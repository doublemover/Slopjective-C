index 0000000000000000000000000000000000000000..6fe78ea9276521fd9d14451d1cf8a13ab6b2f519
--- /dev/null
+++ b/clang/test/ObjC3/Sema/deferred-arc-carrier-init.m
@@ -0,0 +1,77 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fobjc-exceptions -Wno-uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -Wno-uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fobjc-exceptions -Wno-uninitialized -emit-obj -o %t.o -verify %s
+
+typedef __objc3_optional(id) Maybe;
+typedef __objc3_result(id, id) Outcome;
+
+Outcome branch(int success, id value, id error) {
+  Outcome result;
+  if (success)
+    result = __objc3_ok(id, id, value);
+  else
+    result = __objc3_err(id, id, error);
+  return result;
+}
+
+void missing_branch(int success, id value) {
+  Outcome result;
+  if (success)
+    result = __objc3_ok(id, id, value);
+  (void)__objc3_is_ok(result); // expected-error {{is used before definite initialization}}
+}
+
+void missing_loop(int count, id value) {
+  Maybe result;
+  for (int i = 0; i < count; ++i)
+    result = __objc3_some(id, value);
+  (void)__objc3_has_value(result); // expected-error {{is used before definite initialization}}
+}
+
+void escape_before_assignment(void) {
+  Maybe result;
+  (void)&result; // expected-error {{is used before definite initialization}}
+}
+
+void read_own_assignment(void) {
+  Maybe result;
+  result = result; // expected-error {{is used before definite initialization}}
+}
+
+int resume_execution(void) __attribute__((returns_twice));
+
+void call_without_assignment(void) {
+  Maybe result;
+  (void)resume_execution();
+  (void)__objc3_has_value(result); // expected-error {{is used before definite initialization}}
+}
+
+Maybe make_result(void);
+
+void objc_throw_skips_assignment(void) {
+  Maybe result;
+  @try {
+    result = make_result();
+  } @catch (id failure) {
+    (void)__objc3_has_value(result); // expected-error {{is used before definite initialization}}
+  }
+}
+
+#ifdef __cplusplus
+void cxx_throw_skips_assignment(void) {
+  Maybe result;
+  try {
+    result = make_result();
+  } catch (int) {
+    (void)__objc3_has_value(result); // expected-error {{is used before definite initialization}}
+  }
+}
+#endif
+
+void constant_requires_initializer(void) {
+  const Maybe result; // expected-error {{requires an initializer at its declaration}}
+}
+
+void byref_requires_initializer(void) {
+  __block Maybe result; // expected-error {{requires an initializer at its declaration}}
+}
