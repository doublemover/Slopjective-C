+// Run each error in its own translation unit. Clang skips flow analysis
+// after an earlier uncompilable diagnostic.
+typedef __objc3_optional(id) Maybe;
+typedef __objc3_result(id, id) Outcome;
+Maybe make_result(void);
+
+#if CASE == 1
+// expected-no-diagnostics
+Outcome branch(int success, id value, id error) {
+  Outcome result;
+  if (success)
+    result = __objc3_ok(id, id, value);
+  else
+    result = __objc3_err(id, id, error);
+  return result;
+}
+#elif CASE == 2
+void missing_branch(int success, id value) {
+  Outcome result;
+  if (success)
+    result = __objc3_ok(id, id, value);
+  (void)__objc3_is_ok(result); // expected-error {{is used before definite initialization}}
+}
+#elif CASE == 3
+void missing_loop(int count, id value) {
+  Maybe result;
+  for (int i = 0; i < count; ++i)
