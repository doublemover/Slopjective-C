+namespace {
+
+class ObjC3CarrierInitReporter : public UninitVariablesHandler {
+  Sema &S;
+  llvm::SmallPtrSet<const VarDecl *, 4> Reported;
+
+public:
+  explicit ObjC3CarrierInitReporter(Sema &S) : S(S) {}
+
+  void handleUseOfUninitVariable(const VarDecl *VD,
+                                 const UninitUse &Use) override {
+    if (!isObjC3DeferredCarrierLocal(*VD) || !Reported.insert(VD).second)
+      return;
+    const Expr *Read = Use.getUser();
+    S.Diag(Read->getBeginLoc(), diag::err_objc3_carrier_use_before_initialization)
+        << VD->getDeclName() << Read->getSourceRange();
+  }
+};
+
+void checkObjC3CarrierInitialization(Sema &S, const Decl *D) {
+  if (!S.getLangOpts().ObjC3 || !S.getLangOpts().ObjCAutoRefCount)
+    return;
+
+  const VarDecl *FirstCarrier = nullptr;
+  for (const Decl *Local : cast<DeclContext>(D)->decls())
+    if (const auto *Var = dyn_cast<VarDecl>(Local);
+        Var && isObjC3DeferredCarrierLocal(*Var)) {
+      FirstCarrier = Var;
+      break;
+    }
+  if (!FirstCarrier)
+    return;
+
+  // This graph represents branches, exceptional successors, and deferred
+  // statements. Other analyses use the regular graph and its cleanup contract.
+  AnalysisDeclContext AC(nullptr, D);
+  auto &Options = AC.getCFGBuildOptions();
+  Options.AddEHEdges = true;
+  Options.AddInitializers = true;
+  Options.AddImplicitDtors = true;
+  Options.AddParameterLifetimes = true;
+  Options.AddTemporaryDtors = true;
+  Options.AddCXXDefaultInitExprInCtors = true;
+  Options.AddLifetime = true;
+  Options.AnalyzeObjC3CarrierInitialization = true;
+  Options.setAllAlwaysAdd();
+  if (CFG *Graph = AC.getCFG()) {
+    ObjC3CarrierInitReporter Reporter(S);
+    UninitVariablesAnalysisStats Stats{};
+    runUninitializedVariablesAnalysis(*cast<DeclContext>(D), *Graph, AC,
+                                      Reporter, Stats);
+  } else {
+    S.Diag(FirstCarrier->getLocation(), diag::err_objc3_carrier_requires_initializer)
+        << FirstCarrier->getDeclName();
+  }
+}
+
