+bool clang::isObjC3ARCCarrierStorage(ASTContext &Context, QualType Type) {
+  if (!Context.getLangOpts().ObjCAutoRefCount ||
+      !hasObjC3CarrierManagedPayload(Type))
+    return false;
+  auto Info = Context.getObjC3CarrierRepresentationType(Type);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return false;
+  unsigned Budget = 256;
+  for (const auto *Field : {Info.ValueField, Info.SuccessField, Info.ErrorField})
+    if (Field && !isSupportedARCCarrierField(Field->getType(), Budget))
+      return false;
+  return true;
+}
