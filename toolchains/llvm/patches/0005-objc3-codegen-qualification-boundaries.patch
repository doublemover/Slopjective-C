+    if (Representation.State ==
+            ObjC3CarrierRepresentationInfo::Status::Materialized &&
+        Representation.Record && !Representation.Type.isNull())
+      return ConvertTypeForMem(Representation.Type);
+
+    CGM.Error(SourceLocation(),
+              "cannot lower ObjC3 carrier without a materialized storage "
+              "representation");
+    SkippedLayout = true;
+    return llvm::StructType::get(getLLVMContext());
+  }
