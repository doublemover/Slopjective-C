+#include "typed-error-managed-runtime.h"
+extern "C" ZeroCodeError *managed_mrc_object(ZeroCodeError *value, ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) {
+  if (error) __objc3_throw(error);
+  return value;
+}
+extern "C" ZeroCodeError *managed_mrc_owned(ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) __attribute__((ns_returns_retained)) {
+  if (error) __objc3_throw(error);
+  return (ZeroCodeError *)make_zero_code_error();
+}
+extern "C" ManagedSuccessBlock managed_mrc_block(ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) {
+  if (error) __objc3_throw(error);
+  return ^{ return 42; };
+}
+extern "C" void *_Block_copy(const void *);
+extern "C" void _Block_release(const void *);
+extern "C" ManagedSuccessBlock managed_mrc_owned_block(ZeroCodeError *value, ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) __attribute__((ns_returns_retained)) {
+  if (error) __objc3_throw(error);
+  return (ManagedSuccessBlock)_Block_copy(^{ return [value code] + 42; });
+}
+ZeroCodeError *ManagedMRCMember::object(ZeroCodeError *value, ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) { return __objc3_try(managed_mrc_object(value, error)); }
+ManagedSuccessBlock ManagedMRCMember::block(ZeroCodeError *error)
+    __objc3_throws(ZeroCodeError *) { return __objc3_try(managed_mrc_block(error)); }
+@implementation ManagedMRCReceiver
+- (ZeroCodeError *)object:(ZeroCodeError *)value error:(ZeroCodeError *)error
+    __objc3_throws(ZeroCodeError *) { return __objc3_try(managed_mrc_object(value, error)); }
+- (ManagedSuccessBlock)block:(ZeroCodeError *)error
+    __objc3_throws(ZeroCodeError *) { return __objc3_try(managed_mrc_block(error)); }
+@end
+extern "C" int run_mrc_managed_checks(void) {
+  int before = zero_code_error_deallocations();
+  ZeroCodeError *owner = (ZeroCodeError *)make_zero_code_error();
+  if (__objc3_try_force(managed_mrc_object(owner, nil)) != owner) return 181;
+  auto callback = managed_mrc_object;
+  if (__objc3_try_force(callback(owner, nil)) != owner) return 182;
+  ZeroCodeError *owned = __objc3_try_force(managed_mrc_owned(nil));
+  if (zero_code_error_retain_count(owned) != 1) return 183;
+  [owned release];
+  if (__objc3_try_force(managed_mrc_block(nil))() != 42) return 184;
+  ZeroCodeError *(^object_block)(ZeroCodeError *, ZeroCodeError *) __objc3_throws(ZeroCodeError *) =
+      ^ZeroCodeError *(ZeroCodeError *value, ZeroCodeError *error) __objc3_throws(ZeroCodeError *) {
+        return __objc3_try(managed_mrc_object(value, error));
+      };
+  if (__objc3_try_force(object_block(owner, nil)) != owner) return 199;
+  ManagedMRCMember member;
+  if (__objc3_try_force(member.object(owner, nil)) != owner ||
+      __objc3_try_force(member.block(nil))() != 42) return 200;
+  ManagedMRCReceiver *receiver = (ManagedMRCReceiver *)make_named_zero_code_error("ManagedMRCReceiver");
+  if (__objc3_try_force([receiver object:owner error:nil]) != owner ||
+      __objc3_try_force([receiver block:nil])() != 42) return 201;
+  [receiver release];
+  ManagedSuccessBlock heap = __objc3_try_force(managed_mrc_owned_block(owner, nil));
+  if (heap() != 42) return 203;
+  _Block_release(heap);
+  [owner release];
+  return zero_code_error_deallocations() == before + 3 ? 0 : 185;
+}
diff --git a/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-optional-runtime.inc b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-optional-runtime.inc
