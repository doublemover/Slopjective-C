+++ b/clang/test/ObjC3/Analysis/defer-native-cxx.mm
@@ -0,0 +1,76 @@
+// RUN: %clang_analyze_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fcxx-exceptions -fexceptions -analyzer-checker=debug.DumpCFG -analyzer-config cfg-rich-constructors=false %s 2>&1 | FileCheck %s
+// RUN: %clang_analyze_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fcxx-exceptions -fexceptions -analyzer-checker=debug.DumpCFG -analyzer-config cfg-rich-constructors=true %s 2>&1 | FileCheck %s
+
+// The path-sensitive native-EH contracts live in ObjC3ConditionScopeTest.
+// These public-source cases also require the analyzer's ordinary CFG to keep
+// construction, implicit cleanup and copied deferred bodies visible.
+
+void first() noexcept;
+void second() noexcept;
+void cleanup(int *);
+struct Lifetime {
+  Lifetime() noexcept;
+  ~Lifetime() noexcept(false);
+};
+
+// CHECK-LABEL: void local_destruction()
+// CHECK-DAG: Lifetime value;
+// CHECK-DAG: ~Lifetime() (Implicit destructor)
+// CHECK-DAG: first
+void local_destruction() {
+  defer { first(); }
+  Lifetime value;
+}
+
+// CHECK-LABEL: void result_temporary()
+// CHECK-DAG: ~Lifetime() (Temporary object destructor)
+// CHECK-DAG: first
+void result_temporary() {
+  defer { first(); }
+  (void)Lifetime();
+}
+
+// CHECK-LABEL: void attributed_cleanup()
+// CHECK-DAG: CleanupFunction (cleanup)
+// CHECK-DAG: first
+void attributed_cleanup() {
+  defer { first(); }
+  int value __attribute__((cleanup(cleanup)));
+}
+
+// CHECK-LABEL: void copied_native_cleanup(bool exit)
+// CHECK-DAG: second
+// CHECK-DAG: ~Lifetime() (Implicit destructor)
+// CHECK-DAG: first
+void copied_native_cleanup(bool exit) {
+  defer { first(); }
+  Lifetime value;
+  defer { second(); }
+  if (exit)
+    return;
+}
+
+void consume(const Lifetime &);
+
+// CHECK-LABEL: void consumed_temporary()
+// CHECK-DAG: consume
+// CHECK-DAG: ~Lifetime() (Temporary object destructor)
+// CHECK-DAG: first
+void consumed_temporary() {
+  defer { first(); }
+  consume(Lifetime());
+}
+
+struct Element {
+  Element() noexcept;
+  ~Element() noexcept;
+};
+
+// CHECK-LABEL: void nonthrowing_array()
+// CHECK-DAG: Element elements[2];
+// CHECK-DAG: ~Element[2]() (Implicit destructor)
+// CHECK-DAG: first
+void nonthrowing_array() {
+  defer { first(); }
+  Element elements[2];
+}
