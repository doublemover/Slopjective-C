+int nil_await(void) __objc3_async {
+  NativeCallables *receiver = 0;
+  return __objc3_await [receiver value:42];
+}
diff --git a/clang/test/ObjC3/CodeGen/native-c-async-definitions.m b/clang/test/ObjC3/CodeGen/native-c-async-definitions.m
