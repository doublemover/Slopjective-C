+// A carrier can own nontrivial C++ payloads without itself being a C++ record.
+// Keep their destruction explicit instead of inventing a C++ destructor decl.
+static void collectObjC3CarrierDestructors(
+    QualType Type, SmallVectorImpl<const CXXDestructorDecl *> &Destructors) {
+  Type = Type.getCanonicalType();
+  if (const auto *Optional = Type->getAs<ObjC3OptionalType>()) {
+    collectObjC3CarrierDestructors(Optional->getElementType(), Destructors);
+  } else if (const auto *Result = Type->getAs<ObjC3ResultType>()) {
+    collectObjC3CarrierDestructors(Result->getSuccessType(), Destructors);
+    collectObjC3CarrierDestructors(Result->getErrorType(), Destructors);
+  } else if (const auto *Array = dyn_cast<ArrayType>(Type.getTypePtr())) {
+    collectObjC3CarrierDestructors(Array->getElementType(), Destructors);
+  } else if (const auto *Record = Type->getAsCXXRecordDecl()) {
+    if (Record->hasDefinition() && !Record->hasTrivialDestructor())
+      if (const auto *Destructor = Record->getDestructor())
+        Destructors.push_back(Destructor);
+  }
+}
+
+void CFGObjC3CarrierDtor::getPossibleDestructors(
+    SmallVectorImpl<const CXXDestructorDecl *> &Destructors) const {
+  collectObjC3CarrierDestructors(getVarDecl()->getType(), Destructors);
+}
+
+bool CFGBuilder::hasObjC3CarrierDestructor(const VarDecl *Variable) const {
+  QualType Type = Variable->getType().getCanonicalType();
+  if (!isa<ObjC3OptionalType, ObjC3ResultType>(Type.getTypePtr()))
+    return false;
+  SmallVector<const CXXDestructorDecl *, 4> Destructors;
+  collectObjC3CarrierDestructors(Type, Destructors);
+  return !Destructors.empty();
+}
+
+void CFGBuilder::addObjC3SourceCleanup(ObjC3BindingCondition *Binding) {
+  auto *Snapshot = Binding->getSnapshotDecl();
+  // The graph is built backwards: source temporaries finish after snapshot
+  // destruction, and both finish after successful binding initialization.
+  if (auto *Full = dyn_cast<ExprWithCleanups>(Snapshot->getInit())) {
+    if (BuildOpts.AddTemporaryDtors || BuildOpts.AddLifetime) {
+      TempDtorContext Temporaries;
+      VisitForTemporaries(Full->getSubExpr(), true, Temporaries);
+      addFullExprCleanupMarker(Temporaries, Full);
+    }
+  }
+  if (BuildOpts.AddImplicitDtors && hasObjC3CarrierDestructor(Snapshot)) {
+    autoCreateBlock();
+    Block->appendObjC3CarrierDtor(Snapshot, Binding,
+                                  cfg->getBumpVectorContext());
+  }
+}
