diff --git a/clang/lib/CodeGen/CGObjC3ABIBoundaries.cpp b/clang/lib/CodeGen/CGObjC3ABIBoundaries.cpp
new file mode 100644
index 000000000..3477607ea
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ABIBoundaries.cpp
@@ -0,0 +1,226 @@
+//===--- CGObjC3ABIBoundaries.cpp - Unqualified native boundaries
+//----------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3ABIBoundaries.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3ManagedStorage.h"
+#include "CGObjC3Carriers.h"
+#include "CGObjC3TypedErrors.h"
+#include "CodeGenModule.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "llvm/ADT/SmallPtrSet.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+QualType findCarrier(ASTContext &Ctx, QualType T, bool FollowPointers,
+                     llvm::SmallPtrSetImpl<const Type *> &Seen) {
+  if (T.isNull())
+    return {};
+  T = Ctx.getCanonicalType(T);
+  const Type *Ty = T.getTypePtr();
+  if (!Seen.insert(Ty).second)
+    return {};
+  if (isa<ObjC3OptionalType, ObjC3ResultType>(Ty))
+    return T;
+  if (const auto *Array = Ctx.getAsArrayType(T))
+    return findCarrier(Ctx, Array->getElementType(), FollowPointers, Seen);
+  if (const auto *Atomic = dyn_cast<AtomicType>(Ty))
+    return findCarrier(Ctx, Atomic->getValueType(), FollowPointers, Seen);
+  if (FollowPointers) {
+    if (const auto *Pointer = dyn_cast<PointerType>(Ty))
+      return findCarrier(Ctx, Pointer->getPointeeType(), true, Seen);
+    if (const auto *Reference = dyn_cast<ReferenceType>(Ty))
+      return findCarrier(Ctx, Reference->getPointeeType(), true, Seen);
+  }
+  if (const auto *Record = dyn_cast<RecordType>(Ty)) {
+    const RecordDecl *Definition = Record->getDecl()->getDefinition();
+    if (!Definition)
+      return {};
+    if (const auto *CXXRecord = dyn_cast<CXXRecordDecl>(Definition))
+      for (const CXXBaseSpecifier &Base : CXXRecord->bases())
+        if (QualType Found =
+                findCarrier(Ctx, Base.getType(), FollowPointers, Seen);
+            !Found.isNull())
+          return Found;
+    for (const FieldDecl *Field : Definition->fields())
+      if (QualType Found =
+              findCarrier(Ctx, Field->getType(), FollowPointers, Seen);
+          !Found.isNull())
+        return Found;
+  }
+  return {};
+}
+
+// Trivial scalar carriers use the same AST-owned record representation as
+// ordinary calls. Keep this separate from the ARC capture contract: admitting
+// a callable signature must not select managed copy/dispose hooks for a plain
+// capture. The runtime encoder independently bounds the supported leaf types.
+bool supportsPlainCarrierRuntimeABI(CodeGenModule &CGM, QualType Type) {
+  if (Type.isNull() || hasObjC3CarrierManagedPayload(Type) ||
+      !supportsObjC3CarrierCopyPayload(CGM, Type))
+    return false;
+  std::string Encoding;
+  return getObjC3CarrierRuntimeEncoding(CGM.getContext(), Type, Encoding);
+}
+
+bool diagnose(CodeGenModule &CGM, QualType Type, SourceLocation Loc,
+              bool FollowPointers, const char *Operation) {
+  llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+  QualType Carrier = findCarrier(CGM.getContext(), Type, FollowPointers, Seen);
+  if (Carrier.isNull())
+    return false;
+  diagnoseUnsupportedObjC3CarrierOperation(CGM, Loc, Carrier, Operation);
+  return true;
+}
+} // namespace
+
+bool CodeGen::diagnoseUnsupportedObjC3ValueABI(CodeGenModule &CGM,
+                                               QualType Type,
+                                               SourceLocation Loc) {
+  return diagnose(CGM, Type, Loc, false, "by-value call ABI");
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3AggregateCopy(CodeGenModule &CGM,
+                                                    QualType Type,
+                                                    SourceLocation Loc) {
+  if (Type.isNull() ||
+      isa<ObjC3OptionalType, ObjC3ResultType>(
+          CGM.getContext().getCanonicalType(Type).getTypePtr()) ||
+      supportsObjC3ManagedRecordLifetime(CGM, Type))
+    return false;
+  return diagnose(CGM, Type, Loc, false, "enclosing aggregate copy");
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3AtomicAccess(CodeGenModule &CGM,
+                                                   QualType Type,
+                                                   SourceLocation Loc) {
+  return diagnose(CGM, Type, Loc, false, "atomic access");
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3RepresentationAccess(CodeGenModule &CGM,
+                                                           QualType Type,
+                                                           SourceLocation Loc) {
+  return diagnose(CGM, Type, Loc, false, "object representation bitcast");
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3RuntimeFunction(CodeGenModule &CGM,
+                                                      QualType FunctionType,
+                                                      SourceLocation Loc) {
+  const auto *FPT = FunctionType->getAs<FunctionProtoType>();
+  if (!FPT)
+    return diagnoseUnsupportedObjC3CarrierByValue(CGM, FunctionType, Loc);
+  if (FPT->getObjC3FunctionEffects().Async) {
+    if (!CGM.getTypes().diagnoseUnsupportedObjC3Effects(FunctionType, nullptr))
+      return false;
+    return true;
+  }
+  auto Check = [&](QualType T) {
+    if (!FPT->isVariadic() && FPT->getCallConv() == CC_C &&
+        !FPT->getObjC3FunctionEffects().Async &&
+        (FPT->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::None ||
+         supportsObjC3ErrorOutFunction(CGM, FPT, nullptr, false)) &&
+        (supportsObjC3CarrierRuntimeCallABI(CGM, T) ||
+         supportsPlainCarrierRuntimeABI(CGM, T) ||
+         supportsObjC3ManagedRecordRuntimeABI(CGM, T)))
+      return false;
+    return diagnose(CGM, T, Loc, true, "runtime callable type encoding");
+  };
+  if (Check(FPT->getReturnType()))
+    return true;
+  for (QualType Parameter : FPT->param_types())
+    if (Check(Parameter))
+      return true;
+  return false;
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3ObjCMethod(CodeGenModule &CGM,
+                                                 const ObjCMethodDecl *Method) {
+  if (!Method)
+    return false;
+  if (!Method->getObjC3FunctionType().isNull()) {
+    const auto *FPT =
+        Method->getObjC3FunctionType()->castAs<FunctionProtoType>();
+    const auto Effects = FPT->getObjC3FunctionEffects();
+    const bool Async = Effects.Async && CGM.getLangOpts().CPlusPlus20 &&
+                       Method->getMethodFamily() == OMF_None &&
+                       !Method->hasRelatedResultType() &&
+                       !Method->hasAttr<NSConsumesSelfAttr>() &&
+                       !Method->hasAttr<NSReturnsRetainedAttr>() &&
+                       !Method->hasAttr<NSReturnsNotRetainedAttr>() &&
+                       !Method->hasAttr<NSReturnsAutoreleasedAttr>() &&
+                       getObjCMethodCallingConvention(Method, false) == CC_C &&
+                       !CGM.getContext()
+                            .getObjC3AsyncTaskType(FPT->getReturnType())
+                            .isNull() &&
+                       (Effects.Throws == ObjC3ThrowsKind::None ||
+                        Effects.Throws == ObjC3ThrowsKind::Untyped ||
+                        isObjC3ErrorObjectType(CGM, Effects.ErrorType));
+    if (!Async && !supportsObjC3ErrorOutMethod(CGM, Method)) {
+      CGM.ErrorUnsupported(Method, "ObjC3 async/throws method ABI lowering");
+      return true;
+    }
+    if (CGM.getTypes().diagnoseUnsupportedObjC3Effects(
+            Method->getObjC3FunctionType()))
+      return true;
+  }
+  // Objective-C message sends and method metadata have separate lowering
+  // paths from ordinary CallExprs. Preserve callable effects in each value
+  // type instead of treating an effectful callback as an ordinary callback.
+  if (CGM.getTypes().diagnoseUnsupportedObjC3Effects(Method->getReturnType(),
+                                                     Method))
+    return true;
+  for (const ParmVarDecl *Param : Method->parameters())
+    if (CGM.getTypes().diagnoseUnsupportedObjC3Effects(Param->getType(), Param))
+      return true;
+  auto Check = [&](QualType T, SourceLocation Loc) {
+    if (!Method->isVariadic() &&
+        getObjCMethodCallingConvention(Method, false) == CC_C &&
+        (Method->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::None ||
+         supportsObjC3ErrorOutMethod(CGM, Method)) &&
+        !Method->getObjC3FunctionEffects().Async &&
+        (supportsObjC3CarrierRuntimeCallABI(CGM, T) ||
+         supportsPlainCarrierRuntimeABI(CGM, T) ||
+         supportsObjC3ManagedRecordRuntimeABI(CGM, T)))
+      return false;
+    if (diagnoseUnsupportedObjC3ValueABI(CGM, T, Loc))
+      return true;
+    return diagnose(CGM, T, Loc, true, "Objective-C runtime type encoding");
+  };
+  bool Invalid = Check(Method->getReturnType(), Method->getLocation());
+  for (const ParmVarDecl *Param : Method->parameters())
+    Invalid |= Check(Param->getType(), Param->getLocation());
+  return Invalid;
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3ObjCContainer(
+    CodeGenModule &CGM, const ObjCContainerDecl *Container) {
+  if (!Container)
+    return false;
+  bool Invalid = false;
+  for (const ObjCMethodDecl *Method : Container->methods())
+    // The property declaration below supplies one precise metadata diagnostic
+    // instead of repeating it on implicit getter and setter declarations.
+    if (!Method->isPropertyAccessor())
+      Invalid |= diagnoseUnsupportedObjC3ObjCMethod(CGM, Method);
+  for (const Decl *Member : Container->decls()) {
+    if (const auto *Ivar = dyn_cast<ObjCIvarDecl>(Member)) {
+      if (!supportsObjC3ManagedRuntimeStorage(CGM, Ivar->getType()))
+        Invalid |= diagnose(CGM, Ivar->getType(), Ivar->getLocation(), true,
+                            "Objective-C runtime type encoding");
+    } else if (const auto *Property = dyn_cast<ObjCPropertyDecl>(Member)) {
+      if (containsObjC3CarrierManagedStorage(Property->getType()) &&
+          Property->isAtomic()) {
+        CGM.ErrorUnsupported(Property, "atomic managed carrier property");
+        Invalid = true;
+      } else if (!supportsObjC3ManagedRuntimeStorage(CGM, Property->getType()))
+        Invalid |= diagnose(CGM, Property->getType(), Property->getLocation(),
+                            true, "Objective-C runtime type encoding");
+    }
+  }
+  return Invalid;
+}
