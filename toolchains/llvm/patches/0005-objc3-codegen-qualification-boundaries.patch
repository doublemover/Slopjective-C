+namespace {
+void collectDeferredBodyLabels(const Stmt *Statement,
+                               SmallVectorImpl<const LabelDecl *> &Labels) {
+  if (!Statement)
+    return;
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement)) {
+    collectDeferredBodyLabels(Argument->getExpr(), Labels);
+    return;
+  }
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement)) {
+    collectDeferredBodyLabels(Initializer->getExpr(), Labels);
+    return;
+  }
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Capture : Lambda->capture_inits())
+      collectDeferredBodyLabels(Capture, Labels);
+    return;
+  }
+  if (isa<BlockExpr>(Statement))
+    return;
+  if (const auto *Label = dyn_cast<LabelStmt>(Statement))
+    Labels.push_back(Label->getDecl());
+  for (const Stmt *Child : Statement->children())
+    collectDeferredBodyLabels(Child, Labels);
+}
+} // namespace
+
+void CodeGenFunction::EmitDeferredBody(const DeferStmt &S) {
+  // A deferred body can be emitted for both normal and exceptional cleanup.
+  // Each copy must resolve its own labels and allocate its own local storage.
+  // VLA size values from one copy do not dominate another copy's blocks.
+  auto SavedLocals = LocalDeclMap;
+  auto SavedLabels = LabelMap;
+  auto SavedVLASizes = VLASizeMap;
+  SmallVector<const LabelDecl *, 8> Labels;
+  collectDeferredBodyLabels(S.getBody(), Labels);
+  for (const LabelDecl *Label : Labels)
+    LabelMap.erase(Label);
+  EmitStmt(S.getBody());
+  LocalDeclMap = std::move(SavedLocals);
+  LabelMap = std::move(SavedLabels);
+  VLASizeMap = std::move(SavedVLASizes);
+}
