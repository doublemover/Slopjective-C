+    __objc3_do {
+      OwnedError Owner;
+      ThrowCleanup Cleanup;
+      __objc3_throw(Owner.Object);
+    } __objc3_catch { return 94; }
+  } catch (int Value) {
+    if (Value != 37 || zero_code_error_deallocations() != Before + 1)
+      return 95;
+  }
+  Before = zero_code_error_deallocations();
