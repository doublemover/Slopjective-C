+// RUN: test ! -e %t.ivar.o
+// RUN: %clang_cc1 -triple x86_64-apple-macosx10.15 -fobjc-runtime=macosx-10.15 -x objective-c++ -std=c++20 -fobjc-version=3 -Wno-objc-root-class -Wno-incomplete-implementation -DTEST_METHODS -emit-obj -o %t.methods.o -verify %s
