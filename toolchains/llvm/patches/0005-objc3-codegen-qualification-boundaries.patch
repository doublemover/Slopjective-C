+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -fobjc-arc -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s --check-prefixes=CHECK,ARC
+#include "Inputs/native-c-async-frame.h"
+@protocol Error @end
+@protocol NativeError <Error> @end
+struct Pair { int left; double right; };
+struct __attribute__((aligned(256))) Wide { unsigned char bytes[256]; };
+typedef int (^Callback)(int);
+extern void cleanup(int *);
+// CHECK-LABEL: define{{.*}} void @leaf(
+// CHECK: llvm.coro.id
+// CHECK: llvm.coro.align.i64
+// CHECK: aligned_alloc
+// CHECK: llvm.coro.begin
+// CHECK: llvm.coro.suspend
+// CHECK: objc3_task_complete
+int leaf(int value) __objc3_async { return value; }
+// CHECK-LABEL: define{{.*}} void @chain(
+// CHECK: llvm.coro.suspend
+// CHECK: {{call|invoke}} void @leaf(
+// CHECK: objc3_async_frame_start_child
+// CHECK: objc3_task_await
+// CHECK: llvm.coro.suspend
+// CHECK: objc3_task_is_cancel_requested
+// CHECK: objc3_task_copy_result
+int chain(int count) __objc3_async {
+  int sum = 0;
+  __objc3_defer { cleanup(&sum); }
+  for (int i = 0; i < count; ++i) sum += __objc3_await leaf(i);
+  return sum;
+}
+// CHECK-LABEL: define{{.*}} void @pair(
+struct Pair pair(struct Pair value) __objc3_async {
+  value.left += __objc3_await leaf(2);
+  return value;
+}
+// CHECK-LABEL: define{{.*}} void @wide(
+struct Wide wide(struct Wide value) __objc3_async {
+  value.bytes[255] += __objc3_await leaf(2);
+  return value;
+}
+// CHECK-LABEL: define{{.*}} void @complex_value(
+__complex__ double complex_value(__complex__ double value) __objc3_async {
+  __real__ value += __objc3_await leaf(2);
+  return value;
+}
+// CHECK-LABEL: define{{.*}} void @object(
+// CHECK: objc3_async_reference_ops
+id object(id value) __objc3_async {
+  id live = value;
+  __objc3_await leaf(0);
+  return live;
+}
+// CHECK-LABEL: define{{.*}} void @block(
+Callback block(int value) __objc3_async {
+  int extra = __objc3_await leaf(2);
+  return ^(int delta) { return value + extra + delta; };
+}
+// CHECK-LABEL: define{{.*}} void @raise(
+// CHECK: __objc3_task_error_create
+int raise(id<NativeError> error) __objc3_async __objc3_throws(id<NativeError>) {
+  __objc3_throw(error);
+}
+// CHECK-LABEL: define{{.*}} void @checked(
+// CHECK: __objc3_task_error_object
+// CHECK: objc3.await.checked.error
+int checked(id<NativeError> error) __objc3_async __objc3_throws(id<NativeError>) {
+  return __objc3_try(__objc3_await raise(error));
+}
+// CHECK-LABEL: define{{.*}} void @recover(
+int recover(id<NativeError> error) __objc3_async {
+  __objc3_do {
+    return __objc3_try(__objc3_await checked(error));
+  } __objc3_catch(id<NativeError> caught) {
+    return caught ? __objc3_await leaf(42) : 0;
+  }
+}
+// CHECK-LABEL: define{{.*}} void @foreign(
+// CHECK: objc_exception_throw
+int foreign(id exception) __objc3_async {
+  __objc3_await leaf(0);
+  @throw exception;
+}
+// CHECK-LABEL: define{{.*}} void @empty(
+void empty(void) __objc3_async {}
+_Static_assert(sizeof(leaf(1)) == sizeof(objc3_async_frame), "physical frame call");
+typedef int (*AsyncInt)(int) __objc3_async;
+_Static_assert(__builtin_types_compatible_p(__typeof__(&leaf), AsyncInt), "logical effect type");
+
+extern id retained_result(void) __attribute__((ns_returns_retained));
+// A naturally +1 source result is claimed, copied to the owned completion and
+// released once on the frame return edge, rather than leaking an ARC +1.
+// ARC-LABEL: define{{.*}} void @new_object_result(
+// ARC: {{call|invoke}} ptr @retained_result
+// ARC: {{objc_release|llvm.objc.release}}
+id new_object_result(void) __objc3_async { return retained_result(); }
