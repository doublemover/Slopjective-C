+#include "Inputs/native-async-task.h"
+@protocol Error @end
+@protocol ParseError <Error> @end
+// CHECK-LABEL: define{{.*}} void @_Z5raise
+// CHECK: llvm.coro.id
+// CHECK: call ptr @__objc3_task_error_create
+// CHECK: br label %coro.final
+int raise(id<ParseError> error) __objc3_async __objc3_throws(id<ParseError>) {
+  __objc3_throw(error);
+}
+// CHECK-LABEL: define{{.*}} void @_Z9propagate
+// CHECK: __objc3_async_checked
+// CHECK: objc3.try.failed
+// CHECK: __objc3_task_error_create
+int propagate(id<ParseError> error) __objc3_async __objc3_throws(id<ParseError>) {
+  return __objc3_try(__objc3_await raise(error));
+}
+int plain(int) __objc3_async;
+int recover(id<ParseError> error) __objc3_async {
+  __objc3_do {
+    return __objc3_try(__objc3_await propagate(error));
+  } __objc3_catch(id<ParseError> caught) {
+    int value = __objc3_await plain(42);
+    return caught ? value : 0;
+  }
+}
+void no_value(id<ParseError> error) __objc3_async __objc3_throws(id<ParseError>) {
+  __objc3_throw(error);
+}
+void forward_void(id<ParseError> error) __objc3_async __objc3_throws(id<ParseError>) {
+  __objc3_try(__objc3_await no_value(error));
+  return;
+}
+template<class T>
+int generic(T error) __objc3_async __objc3_throws(id<ParseError>) {
+  return __objc3_try(__objc3_await raise(error));
+}
+template int generic<id<ParseError>>(id<ParseError>)
+    __objc3_async __objc3_throws(id<ParseError>);
