+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fcxx-exceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -std=c++20 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fcxx-exceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -std=c++23 -O2 -emit-obj -o %t.o %s
+// REQUIRES: x86-registered-target
+
+extern "C" {
+id make_owner(void) __attribute__((ns_returns_retained));
+void observe(id) __attribute__((nothrow));
+void release_marker(int *) __attribute__((nothrow));
+void may_throw(void);
+}
+
+// An implicit destructor only releases the ARC field. Private fields and a
+// user constructor do not introduce a user destructor action.
+class PrivateOwner {
+  id value;
+public:
+  PrivateOwner() : value(make_owner()) { may_throw(); }
+  void visit() const { observe(value); }
+};
+
+extern "C" void cleanup_private_owner(void) {
+  int marker __attribute__((cleanup(release_marker))) = 1;
+  PrivateOwner value;
+  value.visit();
+}
+// CHECK-LABEL: define{{.*}} void @cleanup_private_owner(
+// CHECK: invoke void @_ZN12PrivateOwnerC1Ev(
+// CHECK: call void @release_marker(
+// CHECK: scope.release:
+// CHECK: call void @_ZN12PrivateOwnerD1Ev{{"?}}(
+// CHECK: ret void
+
+extern "C" void cleanup_lambda_capture(void) {
+  int marker __attribute__((cleanup(release_marker))) = 1;
+  id value = make_owner();
+  auto closure = [value] { observe(value); };
+  value = (id)0;
+  closure();
+}
