diff --git a/clang/test/ObjC3/CodeGen/optional-coalescing-cxx-runtime.mm b/clang/test/ObjC3/CodeGen/optional-coalescing-cxx-runtime.mm
new file mode 100644
index 000000000..746c56c96
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/optional-coalescing-cxx-runtime.mm
@@ -0,0 +1,42 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-llvm -o /dev/null %s
+// REQUIRES: x86-registered-target
+// Executed by the admitted development coalescing source matrix.
+
+static int live, constructed, destroyed, fallback_calls;
+struct Value {
+  int number;
+  explicit Value(int number) noexcept : number(number) {
+    ++live;
+    ++constructed;
+  }
+  Value(const Value &other) noexcept : number(other.number) {
+    ++live;
+    ++constructed;
+  }
+  ~Value() noexcept { --live; ++destroyed; }
+};
+static Value fallback() noexcept {
+  ++fallback_calls;
+  return Value(9);
+}
+template <class T> static auto generic(T source) { return source ?? 42; }
+
+int main() {
+  {
+    Optional(Value) present = Some(Value, Value(7));
+    Value selected = present ?? fallback();
+    if (selected.number != 7 || fallback_calls != 0 || live != 2)
+      return 1;
+    Optional(Value) absent = None(Value);
+    Value selected_fallback = absent ?? fallback();
+    if (selected_fallback.number != 9 || fallback_calls != 1 || live != 3)
+      return 2;
+  }
+  if (live != 0 || constructed != destroyed)
+    return 3;
+  if (generic(Some(int, 7)) != 7 || generic(None(int)) != 42)
+    return 4;
+  Optional(Optional(int)) nested = Some(Optional(int), Some(int, 8));
+  Optional(int) flattened = nested ?? None(int);
+  return (flattened ?? 0) == 8 ? 0 : 5;
+}
