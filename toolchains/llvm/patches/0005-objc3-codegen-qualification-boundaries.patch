diff --git a/clang/lib/CodeGen/CGObjC3Conditions.cpp b/clang/lib/CodeGen/CGObjC3Conditions.cpp
new file mode 100644
index 000000000..417be8af6
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Conditions.cpp
@@ -0,0 +1,218 @@
+//===--- CGObjC3Conditions.cpp - Ordered condition ownership ---------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGDebugInfo.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3Carriers.h"
+#include "CGObjC3ManagedStorage.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Expr.h"
+#include "llvm/ADT/STLFunctionalExtras.h"
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+const Expr *withoutFullExpression(const Expr *E) {
+  while (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+    E = Cleanups->getSubExpr();
+  return E;
+}
+const OpaqueValueExpr *findBindingSource(const Stmt *S) {
+  if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(S)) return Opaque;
+  for (const Stmt *Child : S->children())
+    if (Child)
+      if (const auto *Found = findBindingSource(Child)) return Found;
+  return nullptr;
+}
+
+// This guard predates source evaluation. Its pointer slot is read only after
+// the constructor completed; no user local or debug declaration exists on the
+// failure branch. Native ARC exception policy also applies to this cleanup.
+struct DestroyCompletedBinding final : EHScopeStack::Cleanup {
+  const VarDecl *Variable;
+  Address Pointer, Initialized;
+  DestroyCompletedBinding(const VarDecl *Variable, Address Pointer,
+                          Address Initialized)
+      : Variable(Variable), Pointer(Pointer), Initialized(Initialized) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    auto *Destroy = CGF.createBasicBlock("objc3.binding.destroy");
+    auto *Done = CGF.createBasicBlock("objc3.binding.cleanup.done");
+    CGF.Builder.CreateCondBr(CGF.Builder.CreateLoad(Initialized), Destroy, Done);
+    CGF.EmitBlock(Destroy);
+    CGF.Builder.CreateStore(CGF.Builder.getFalse(), Initialized);
+    QualType Type = Variable->getType().getCanonicalType();
+    Address Storage(CGF.Builder.CreateLoad(Pointer), CGF.ConvertTypeForMem(Type),
+                    CGF.getContext().getDeclAlign(Variable));
+    bool Precise = Variable->hasAttr<ObjCPreciseLifetimeAttr>();
+    bool StrongEH = CGF.getARCCleanupKind() & EHCleanup;
+    bool Carrier = isa<ObjC3OptionalType, ObjC3ResultType>(Type.getTypePtr());
+    if (Carrier && supportsObjC3CarrierARCLocalLifetime(CGF.CGM, Type)) {
+      emitObjC3CarrierDestroyActiveARCPayload(CGF, Type, Storage, Precise,
+                                             StrongEH, true);
+    } else if (supportsObjC3ManagedRecordLifetime(CGF.CGM, Type)) {
+      CGF.emitDestroy(Storage, Type, destroyObjC3ManagedStorage, false);
+    } else if (Carrier && hasObjC3CarrierCppLocalDestructor(CGF.CGM, Type)) {
+      bool Emitted = emitObjC3CarrierDestroyActivePayload(CGF, Type, Storage, false);
+      assert(Emitted);
+      (void)Emitted;
+    } else if (Type.isDestructedType() == QualType::DK_objc_strong_lifetime) {
+      if (StrongEH)
+        CGF.EmitARCDestroyStrong(Storage, Precise ? ARCPreciseLifetime
+                                                : ARCImpreciseLifetime);
+    } else if (auto Kind = Type.isDestructedType()) {
+      CGF.emitDestroy(Storage, Type, CGF.getDestroyer(Kind), false);
+    }
+    CGF.EmitBranch(Done);
+    CGF.EmitBlock(Done);
+  }
+};
+
+void emitConditions(CodeGenFunction &CGF, ArrayRef<Stmt *> Conditions,
+                    unsigned Index, CodeGenFunction::JumpDest Failed,
+                    SourceLocation End, llvm::function_ref<void()> Success) {
+  if (Index == Conditions.size()) {
+    Success();
+    return;
+  }
+  auto Next = [&] {
+    emitConditions(CGF, Conditions, Index + 1, Failed, End, Success);
+  };
+  const Stmt *Condition = Conditions[Index];
+  const auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition);
+  if (!Binding) {
+    llvm::Value *Value;
+    {
+      CodeGenFunction::RunCleanupsScope Temporaries(CGF);
+      Value = CGF.EvaluateExprAsBool(cast<Expr>(Condition));
+      Temporaries.ForceCleanup({&Value});
+    }
+    auto *Present = CGF.createBasicBlock("objc3.condition.true");
+    auto *Absent = CGF.createBasicBlock("objc3.condition.false");
+    CGF.Builder.CreateCondBr(Value, Present, Absent);
+    CGF.EmitBlock(Absent);
+    CGF.EmitBranchThroughCleanup(Failed);
+    CGF.EmitBlock(Present);
+    Next();
+    return;
+  }
+
+  const VarDecl *Variable = Binding->getBindingDecl();
+  Address Initialized = CGF.CreateTempAlloca(
+      CGF.Builder.getInt1Ty(), CharUnits::One(), "objc3.binding.initialized");
+  Address Pointer = CGF.CreateDefaultAlignTempAlloca(
+      CGF.Int8PtrTy, "objc3.binding.storage");
+  CGF.Builder.CreateStore(CGF.Builder.getFalse(), Initialized);
+  CodeGenFunction::RunCleanupsScope ConstructionGuard(CGF);
+  CGF.pushFullExprCleanup<DestroyCompletedBinding>(
+      EHCleanup, Variable, Pointer, Initialized);
+  CodeGenFunction::RunCleanupsScope SourceScope(CGF);
+  const VarDecl *Snapshot = Binding->getSnapshotDecl();
+  auto SnapshotEmission = CGF.EmitAutoVarInitialized(
+      *Snapshot, withoutFullExpression(Snapshot->getInit()));
+  if (!SnapshotEmission) return;
+  CGF.EmitAutoVarCleanups(*SnapshotEmission);
+  // Const aggregate locals may use native global-constant promotion. The local
+  // map owns the usable address even when AutoVarEmission has no stack address.
+  Address SourceStorage = CGF.GetAddrOfLocalVar(Snapshot);
+  QualType SourceType = Snapshot->getType();
+  llvm::Value *IsPresent;
+  Address Payload = SourceStorage;
+  if (SourceType->getAs<ObjC3OptionalType>()) {
+    IsPresent = emitObjC3CarrierLoadTag(CGF, SourceStorage, SourceType,
+                                       Binding->getEqualLoc());
+    Payload = getObjC3CarrierPayloadAddress(
+        CGF, SourceStorage, SourceType, ObjC3CarrierPayloadArm::Value);
+  } else {
+    auto Value = CGF.EmitLoadOfLValue(
+        CGF.MakeAddrLValue(SourceStorage, SourceType), Binding->getEqualLoc());
+    IsPresent = CGF.Builder.CreateIsNotNull(Value.getScalarVal());
+  }
+  auto *Present = CGF.createBasicBlock("objc3.binding.present");
+  auto *Absent = CGF.createBasicBlock("objc3.binding.absent");
+  CGF.Builder.CreateCondBr(IsPresent, Present, Absent);
+  CGF.EmitBlock(Absent);
+  CGF.EmitBranchThroughCleanup(Failed);
+  CGF.EmitBlock(Present);
+  std::optional<CodeGenFunction::AutoVarEmission> Emission;
+  {
+    const auto *Opaque = findBindingSource(Variable->getInit());
+    assert(Opaque && "binding initializer lost its native source");
+    CodeGenFunction::OpaqueValueMapping Mapping(
+        CGF, Opaque, CGF.MakeAddrLValue(Payload, Opaque->getType()));
+    Emission = CGF.EmitAutoVarInitialized(
+        *Variable, withoutFullExpression(Variable->getInit()),
+        /*DeferScopeRegistrations=*/true);
+  }
+  if (!Emission) return;
+  Address BindingStorage = CGF.GetAddrOfLocalVar(Variable);
+  CGF.Builder.CreateStore(BindingStorage.emitRawPointer(CGF), Pointer);
+  CGF.Builder.CreateStore(CGF.Builder.getTrue(), Initialized);
+  SourceScope.ForceCleanup();
+  ConstructionGuard.ForceCleanup();
+  // SourceScope can no longer pop lifetime-end/fake-use or final destruction
+  // of the user binding. Labels are rescaled as each native lexical scope ends.
+  CodeGenFunction::LexicalScope Lifetime(
+      CGF, SourceRange(Variable->getLocation(), End));
+  // Complete the declaration's debug visibility only after its full condition
+  // succeeds. Shared source cleanup blocks also run on absent paths and must
+  // not inherit a successful binding's lexical debug scope.
+  assert(!Variable->isNRVOVariable() && !Variable->isEscapingByref() &&
+         !Variable->getType()->isVariablyModifiedType());
+  if (auto *DI = CGF.getDebugInfo())
+    if (CGF.CGM.getCodeGenOpts().hasReducedDebugInfo() && CGF.HaveInsertPoint()) {
+      DI->setLocation(Variable->getLocation());
+      DI->EmitDeclareOfAutoVariable(
+          Variable, Emission->getOriginalAllocatedAddress().getPointer(),
+          CGF.Builder, /*UsePointerValue=*/false);
+    }
+  CGF.EmitAutoVarStorageCleanups(*Emission);
+  CGF.EmitAutoVarCleanups(*Emission);
+  Next();
+}
+} // namespace
+
+void CodeGenFunction::EmitObjC3GuardStmt(const ObjC3GuardStmt *Guard) {
+  auto *ConditionsBlock = createBasicBlock("objc3.guard.conditions");
+  auto Failed = getJumpDestInCurrentScope("objc3.guard.else");
+  EmitBranch(ConditionsBlock);
+  EmitBlock(Failed.getBlock());
+  EmitStmt(Guard->getElse());
+  // Completed-callable Sema proves the mandatory failure exit.
+  if (HaveInsertPoint()) {
+    Builder.CreateUnreachable();
+    Builder.ClearInsertionPoint();
+  }
+  EmitBlock(ConditionsBlock);
+  auto Continuation = ObjC3GuardContinuation;
+  bool HasContinuation = Continuation && Continuation->Statement == Guard;
+  SourceLocation End = HasContinuation ? Continuation->End : Guard->getEndLoc();
+  LexicalScope Scope(*this, SourceRange(Guard->getKeywordLoc(), End));
+  SmallVector<Stmt *, 4> Conditions;
+  for (unsigned I = 0; I != Guard->getNumConditions(); ++I)
+    Conditions.push_back(Guard->getCondition(I));
+  emitConditions(*this, Conditions, 0, Failed, End, [&] {
+    if (HasContinuation) Continuation->Emit();
+  });
+}
+
+void CodeGenFunction::EmitObjC3IfBindingStmt(const ObjC3IfBindingStmt *If) {
+  auto *ConditionsBlock = createBasicBlock("objc3.if.conditions");
+  auto Failed = getJumpDestInCurrentScope("objc3.if.else");
+  auto *End = createBasicBlock("objc3.if.end");
+  EmitBranch(ConditionsBlock);
+  EmitBlock(Failed.getBlock());
+  if (If->getElse()) EmitStmt(If->getElse());
+  EmitBranch(End);
+  EmitBlock(ConditionsBlock);
+  {
+    LexicalScope Scope(*this, If->getSourceRange());
+    SmallVector<Stmt *, 4> Conditions;
+    for (unsigned I = 0; I != If->getNumConditions(); ++I)
+      Conditions.push_back(If->getCondition(I));
+    emitConditions(*this, Conditions, 0, Failed, If->getThen()->getEndLoc(),
+                     [&] { EmitStmt(If->getThen()); });
+  }
+  EmitBranch(End);
+  EmitBlock(End, true);
+}
