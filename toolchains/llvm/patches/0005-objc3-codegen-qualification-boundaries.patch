+//===--- CGObjC3Match.cpp - Native ObjC3 match lowering ------------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3Match.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3Carriers.h"
+#include "CGObjC3ManagedStorage.h"
+#include "CGObjC3ResultExpr.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/Type.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/STLFunctionalExtras.h"
+#include "llvm/IR/BasicBlock.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+void CodeGenFunction::BindObjC3MatchDecl(const VarDecl *VD, Address Addr) {
+  ObjC3BorrowedMatchBindings.insert(VD);
+  setAddrOfLocalVar(VD, Addr);
+}
+
+void CodeGenFunction::UnbindObjC3MatchDecl(const VarDecl *VD) {
+  ObjC3BorrowedMatchBindings.erase(VD);
+  LocalDeclMap.erase(VD);
+}
+
+namespace {
+// Keep a fully constructed C++ result alive across arm temporary cleanup.
+// An exception from a temporary destructor must destroy that result, while a
+// failed constructor must leave its storage uninitialized.
+struct DestroyCompletedMatchResult final : EHScopeStack::Cleanup {
+  QualType Type;
+  Address Storage, Initialized;
+  DestroyCompletedMatchResult(QualType Type, Address Storage,
+                              Address Initialized)
+      : Type(Type), Storage(Storage), Initialized(Initialized) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    auto *Destroy = CGF.createBasicBlock("objc3.match.result.destroy");
+    auto *Done = CGF.createBasicBlock("objc3.match.result.cleanup.done");
+    CGF.Builder.CreateCondBr(CGF.Builder.CreateLoad(Initialized), Destroy,
+                             Done);
+    CGF.EmitBlock(Destroy);
+    CGF.Builder.CreateStore(CGF.Builder.getFalse(), Initialized);
+    CGF.emitDestroy(Storage, Type, CGF.getDestroyer(Type.isDestructedType()),
+                    false);
+    CGF.Builder.CreateBr(Done);
+    CGF.EmitBlock(Done);
+  }
+};
+
+struct DestroyCppMatchSnapshot final : EHScopeStack::Cleanup {
+  QualType Type;
+  Address Storage;
+  DestroyCppMatchSnapshot(QualType Type, Address Storage)
+      : Type(Type), Storage(Storage) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    bool Emitted = emitObjC3CarrierDestroyActivePayload(CGF, Type, Storage, false);
+    assert(Emitted && "admitted C++ match snapshot lost its destruction recipe");
+    (void)Emitted;
+  }
+};
+
+struct MatchScrutinee {
+  Expr *Expression = nullptr;
+  QualType Type;
+  Address Storage = Address::invalid();
+  llvm::Value *Scalar = nullptr;
+  llvm::Value *Tag = nullptr;
+  bool IsOptional = false;
+  bool IsResult = false;
+  bool IsVolatile = false;
+};
+
+bool isObjC3Carrier(ASTContext &Ctx, QualType CarrierType, bool &IsOptional,
+                    bool &IsResult) {
+  const clang::Type *Canonical =
+      Ctx.getCanonicalType(CarrierType).getTypePtr();
+  IsOptional = isa<ObjC3OptionalType>(Canonical);
+  IsResult = isa<ObjC3ResultType>(Canonical);
+  return IsOptional || IsResult;
+}
+
+bool isNativeMatchScalar(QualType Type) {
+  return !Type.isNull() &&
+         (Type->isIntegralOrEnumerationType() || Type->isPointerType() ||
+          Type->isNullPtrType() || Type->isObjCRetainableType());
+}
+
+bool emitScrutineeOnce(CodeGenFunction &CGF, Expr *Expression,
+                       MatchScrutinee &State, const Stmt *Owner) {
+  if (!Expression)
+    return false;
+  State.Expression = Expression;
+  State.Type = Expression->getType();
+  State.IsVolatile = State.Type.isVolatileQualified();
+  if (isObjC3Carrier(CGF.getContext(), State.Type, State.IsOptional,
+                     State.IsResult)) {
+    const bool Managed = supportsObjC3CarrierARCLocalLifetime(CGF.CGM, State.Type);
+    const bool Cpp = supportsObjC3CarrierCppLocalLifetime(CGF.CGM, State.Type);
+    if (!Managed && !Cpp &&
+        !supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, State.Type)) {
+      CGF.ErrorUnsupported(Owner, "ObjC3 match with managed carrier payload");
+      return false;
+    }
+    if (Managed) {
+      // A managed binding borrows an owned snapshot. A guard or body may
+      // replace the original carrier without invalidating any binding.
+      State.Storage = CGF.CreateMemTemp(State.Type, "objc3.match.owned.scrutinee");
+      emitObjC3CarrierARCValueInit(CGF, Expression, State.Storage);
+      pushObjC3CarrierARCTemporaryCleanup(CGF, State.Type, State.Storage);
+    } else {
+      // Keep a prvalue's storage and cleanup in the enclosing match full
+      // expression. The carrier is materialized exactly once.
+      State.Storage = CGF.CreateMemTemp(State.Type, "objc3.match.scrutinee");
+      Qualifiers TempQualifiers;
+      if (State.IsVolatile)
+        TempQualifiers.addVolatile();
+      {
+        CodeGenFunction::CleanupDeactivationScope Deactivation(CGF);
+        auto Saved = CGF.getObjC3CarrierLocalInitState();
+        Address Initialized = Address::invalid();
+        if (Cpp)
+          Initialized = beginObjC3CarrierInitGuard(
+              CGF, State.Type.getCanonicalType().getUnqualifiedType(),
+              State.Storage, false);
+        CGF.setObjC3CarrierLocalInitState({State.Storage, State.Type, Initialized});
+        CGF.EmitAnyExprToMem(Expression, State.Storage, TempQualifiers, true);
+        CGF.setObjC3CarrierLocalInitState(Saved);
+      }
+      if (Cpp && hasObjC3CarrierCppLocalDestructor(CGF.CGM, State.Type))
+        CGF.pushFullExprCleanup<DestroyCppMatchSnapshot>(
+            NormalAndEHCleanup, State.Type, State.Storage);
+    }
+    State.Tag = emitObjC3CarrierLoadTag(CGF, State.Storage, State.Type,
+                                         Expression->getExprLoc(),
+                                         State.IsVolatile);
+    if (!State.Tag) {
+      CGF.ErrorUnsupported(Owner, "ObjC3 match carrier representation");
+      return false;
+    }
+    return true;
+  }
+
+  // Materialize the one scalar evaluation for both lvalues and prvalues.
+  // A case binding names that immutable snapshot even if a guard or body
+  // changes the original source through another name.
+  if (!isNativeMatchScalar(State.Type)) {
+    CGF.ErrorUnsupported(Owner, "ObjC3 match scrutinee type");
+    return false;
+  }
+  if (CGF.getLangOpts().ObjCAutoRefCount &&
+      State.Type->isObjCRetainableType()) {
+    const Expr *Value = Expression;
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Value))
+      Value = Cleanups->getSubExpr();
+    State.Scalar = CGF.EmitARCRetainScalarExpr(Value);
+    CGF.EmitObjCConsumeObject(State.Type, State.Scalar);
+  } else if (Expression->isGLValue()) {
+    LValue LV = CGF.EmitLValue(Expression);
+    State.Scalar = CGF.EmitLoadOfLValue(LV, Expression->getExprLoc())
+                       .getScalarVal();
+  } else {
+    State.Scalar = CGF.EmitScalarExpr(Expression);
+  }
+  if (!State.Scalar)
+    return false;
+  if (!State.Storage.isValid()) {
+    State.Storage = CGF.CreateMemTemp(State.Type,
+                                      "objc3.match.scalar.scrutinee");
+    CGF.Builder.CreateStore(State.Scalar, State.Storage);
+  }
+  return true;
+}
+
+llvm::Value *emitArmTest(CodeGenFunction &CGF, const MatchScrutinee &State,
+                         const ObjC3MatchArm &Arm) {
+  using Kind = ObjC3MatchArm::PatternKind;
+  switch (Arm.getPatternKind()) {
+  case Kind::Wildcard:
+  case Kind::Default:
+  case Kind::Binding:
+    return CGF.Builder.getInt1(true);
+  case Kind::BooleanTrue:
+    if (State.IsOptional || State.IsResult || !State.Type->isBooleanType())
+      return CGF.Builder.getInt1(false);
+    return State.Scalar;
+  case Kind::BooleanFalse:
+    if (State.IsOptional || State.IsResult || !State.Type->isBooleanType())
+      return CGF.Builder.getInt1(false);
+    return CGF.Builder.CreateNot(State.Scalar, "objc3.match.false");
+  case Kind::OptionalSome:
+    return State.IsOptional ? State.Tag : CGF.Builder.getInt1(false);
+  case Kind::OptionalNone:
+    return State.IsOptional
+               ? CGF.Builder.CreateNot(State.Tag, "objc3.match.none")
+               : CGF.Builder.getInt1(false);
+  case Kind::ResultOK:
+    return State.IsResult ? State.Tag : CGF.Builder.getInt1(false);
+  case Kind::ResultErr:
+    return State.IsResult
+               ? CGF.Builder.CreateNot(State.Tag, "objc3.match.err")
+               : CGF.Builder.getInt1(false);
+  case Kind::IntegerLiteral:
+  case Kind::CharacterLiteral:
+  case Kind::NilLiteral: {
+    if (State.IsOptional || State.IsResult || !Arm.getPatternValue())
+      return CGF.Builder.getInt1(false);
+    llvm::Value *Pattern =
+        Arm.getPatternKind() == Kind::NilLiteral &&
+                State.Scalar->getType()->isPointerTy()
+            ? llvm::ConstantPointerNull::get(
+                  llvm::cast<llvm::PointerType>(State.Scalar->getType()))
+            : CGF.EmitScalarExpr(Arm.getPatternValue());
+    if (!Pattern)
+      return CGF.Builder.getInt1(false);
+    if (Pattern->getType() != State.Scalar->getType()) {
+      if (Pattern->getType()->isIntegerTy() &&
+          State.Scalar->getType()->isIntegerTy()) {
+        Pattern = CGF.Builder.CreateIntCast(
+            Pattern, State.Scalar->getType(),
+            Arm.getPatternValue()->getType()->isSignedIntegerOrEnumerationType(),
+            "objc3.match.literal.cast");
+      } else if (Arm.getPatternKind() == Kind::NilLiteral &&
+                 Pattern->getType()->isPointerTy() &&
+                 State.Scalar->getType()->isPointerTy()) {
+        Pattern = CGF.Builder.CreatePointerCast(
+            Pattern, State.Scalar->getType(), "objc3.match.nil.cast");
+      } else {
+        return CGF.Builder.getInt1(false);
+      }
+    }
+    return CGF.Builder.CreateICmpEQ(State.Scalar, Pattern,
+                                    "objc3.match.literal");
+  }
+  case Kind::StringLiteral:
+  case Kind::TypeTest:
+  case Kind::MoveBinding:
+    CGF.ErrorUnsupported(&Arm, "ObjC3 match pattern");
+    return CGF.Builder.getInt1(false);
+  }
+  llvm_unreachable("unhandled ObjC3 match pattern");
+}
+
+Address getBindingSourceAddress(CodeGenFunction &CGF,
+                                  const MatchScrutinee &State,
+                                  const ObjC3MatchArm &Arm) {
+  using Binding = objc3::MatchBindingKind;
+  Address Result = Address::invalid();
+  switch (Arm.getBindingKind()) {
+  case Binding::OptionalPayload:
+    if (State.IsOptional)
+      Result = getObjC3CarrierPayloadAddress(
+          CGF, State.Storage, State.Type, ObjC3CarrierPayloadArm::Value);
+    break;
+  case Binding::SuccessPayload:
+    if (State.IsResult)
+      Result = getObjC3CarrierPayloadAddress(
+          CGF, State.Storage, State.Type, ObjC3CarrierPayloadArm::Success);
+    break;
+  case Binding::ErrorPayload:
+    if (State.IsResult)
+      Result = getObjC3CarrierPayloadAddress(
+          CGF, State.Storage, State.Type, ObjC3CarrierPayloadArm::Error);
+    break;
+  case Binding::Scrutinee:
+    // Scalar and reference-handle bindings borrow the one stored snapshot.
+    // Carrier payload bindings use their dedicated arm cases above.
+    Result = State.Storage;
+    break;
+  case Binding::None:
+    break;
+  }
+  if (!Result.isValid() || !Arm.getBindingDecl())
+    return Address::invalid();
+  return Result.withElementType(
+      CGF.ConvertTypeForMem(Arm.getBindingDecl()->getType()));
+}
+
+const OpaqueValueExpr *findBindingSource(const Stmt *Node) {
+  if (!Node)
+    return nullptr;
+  if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Node))
+    if (!Opaque->getSourceExpr())
+      return Opaque;
+  for (const Stmt *Child : Node->children())
+    if (const auto *Source = findBindingSource(Child))
+      return Source;
+  return nullptr;
+}
+
+// The caller owns the result lifetime. Every arm, including an early guard
+// failure, drains only its own temporaries before entering the next block.
+void emitArmBody(CodeGenFunction &CGF, const MatchScrutinee &State,
+                 const ObjC3MatchArm &Arm, llvm::BasicBlock *Next,
+                 llvm::BasicBlock *Exit,
+                 llvm::function_ref<void(const Expr *)> EmitValue,
+                 llvm::BasicBlock *&ValueBlock,
+                 std::initializer_list<llvm::Value **> ValuesToReload = {}) {
+  auto NextDestination = CGF.getJumpDestInCurrentScope(Next);
+  CodeGenFunction::RunCleanupsScope BindingScope(CGF);
+  const VarDecl *Binding = Arm.getBindingDecl();
+  if (Binding) {
+    Address Source = getBindingSourceAddress(CGF, State, Arm);
+    if (!Source.isValid()) {
+      CGF.ErrorUnsupported(&Arm, "ObjC3 match borrowed binding");
+      CGF.Builder.CreateBr(Next);
+      return;
+    }
+    if (Binding->hasInit()) {
+      const auto *Opaque = findBindingSource(Binding->getInit());
+      if (!Opaque) {
+        CGF.ErrorUnsupported(&Arm, "ObjC3 owned match binding initializer");
+        CGF.Builder.CreateBr(Next);
+        return;
+      }
+      CodeGenFunction::OpaqueValueMapping Mapping(
+          CGF, Opaque, CGF.MakeAddrLValue(Source, Opaque->getType()));
+      CGF.EmitDecl(*Binding);
+    } else {
+      CGF.BindObjC3MatchDecl(Binding, Source);
+    }
+  }
+
+  llvm::BasicBlock *Body = CGF.createBasicBlock("objc3.match.body");
+  if (const Expr *Guard = Arm.getGuard()) {
+    llvm::Value *GuardValue = nullptr;
+    {
+      CodeGenFunction::RunCleanupsScope GuardScope(CGF);
+      GuardValue = CGF.EvaluateExprAsBool(Guard);
+      GuardScope.ForceCleanup({&GuardValue});
+    }
+    auto *Failed = CGF.createBasicBlock("objc3.match.guard.failed");
+    CGF.Builder.CreateCondBr(GuardValue, Body, Failed);
+    CGF.EmitBlock(Failed);
+    CGF.EmitBranchThroughCleanup(NextDestination);
+  } else {
+    CGF.Builder.CreateBr(Body);
+  }
+
+  CGF.EmitBlock(Body);
+  {
+    CodeGenFunction::RunCleanupsScope ArmScope(CGF);
+    if (EmitValue) {
+      // Establish the result's exception guard before running full-expression
+      // cleanup, even when the AST already wraps the body in cleanups.
+      const Expr *BodyExpr = cast<Expr>(Arm.getBody());
+      if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(BodyExpr))
+        BodyExpr = Cleanups->getSubExpr();
+      EmitValue(BodyExpr);
+    } else if (Arm.getBody()) {
+      CGF.EmitStmt(Arm.getBody());
+    }
+    ArmScope.ForceCleanup(ValuesToReload);
+  }
+  BindingScope.ForceCleanup(ValuesToReload);
+  if (CGF.HaveInsertPoint()) {
+    ValueBlock = CGF.Builder.GetInsertBlock();
+    CGF.Builder.CreateBr(Exit);
+  }
+  if (Binding)
+    CGF.UnbindObjC3MatchDecl(Binding);
+}
+
+// ARC results must outlive both arm and scrutinee cleanup. Store the +1 value
+// before either can throw, and release it only on exceptional exit here.
+struct ReleaseCompletedMatchResult final : EHScopeStack::Cleanup {
+  Address Storage;
+  explicit ReleaseCompletedMatchResult(Address Storage) : Storage(Storage) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.EmitARCRelease(CGF.Builder.CreateLoad(Storage), ARCImpreciseLifetime);
+  }
+};
+
+RValue emitValueMatchExpr(CodeGenFunction &CGF, const ObjC3MatchExpr *Match,
+                          bool Complex) {
+  const QualType Type = Match->getType();
+  const bool Retain = CGF.getLangOpts().ObjCAutoRefCount &&
+                      Type->isObjCRetainableType();
+  CodeGenFunction::RunCleanupsScope ResultScope(CGF);
+  Address OwnedResult = Address::invalid();
+  if (Retain) {
+    OwnedResult = CGF.CreateMemTemp(Type, "objc3.match.owned.result");
+    CGF.Builder.CreateStore(llvm::Constant::getNullValue(CGF.ConvertType(Type)),
+                            OwnedResult);
+    CGF.pushFullExprCleanup<ReleaseCompletedMatchResult>(EHCleanup, OwnedResult);
+  }
+  CodeGenFunction::RunCleanupsScope MatchScope(CGF);
+  MatchScrutinee State;
+  if (!emitScrutineeOnce(CGF, Match->getScrutinee(), State, Match))
+    return CGF.GetUndefRValue(Type);
+
+  llvm::BasicBlock *Exit = CGF.createBasicBlock("objc3.match.expr.end");
+  llvm::SmallVector<llvm::Value *, 8> Values, Imaginary;
+  llvm::SmallVector<llvm::BasicBlock *, 8> IncomingBlocks;
+  CodeGenFunction::ConditionalEvaluation Evaluation(CGF);
+  for (unsigned I = 0; I != Match->getNumArms(); ++I) {
+    const ObjC3MatchArm &Arm = *Match->getArm(I);
+    auto *Next = CGF.createBasicBlock("objc3.match.expr.next");
+    auto *Selected = CGF.createBasicBlock("objc3.match.expr.selected");
+    CGF.Builder.CreateCondBr(emitArmTest(CGF, State, Arm), Selected, Next);
+    CGF.EmitBlock(Selected);
+    llvm::Value *Value = nullptr, *Imag = nullptr;
+    llvm::BasicBlock *ValueBlock = nullptr;
+    Evaluation.begin(CGF);
+    emitArmBody(CGF, State, Arm, Next, Exit, [&](const Expr *Body) {
+      if (Complex) {
+        auto Pair = CGF.EmitComplexExpr(Body);
+        Value = Pair.first;
+        Imag = Pair.second;
+      } else if (Retain) {
+        Value = CGF.EmitARCRetainScalarExpr(Body);
+        CGF.Builder.CreateStore(Value, OwnedResult);
+      } else {
+        Value = CGF.EmitScalarExpr(Body);
+      }
+    }, ValueBlock, {&Value, &Imag});
+    Evaluation.end(CGF);
+    if (ValueBlock) {
+      Values.push_back(Value);
+      if (Complex)
+        Imaginary.push_back(Imag);
+      IncomingBlocks.push_back(ValueBlock);
+    }
+    CGF.EmitBlock(Next);
+  }
+  // Exhaustiveness is checked by Sema; no arm may fabricate a result.
+  CGF.Builder.CreateUnreachable();
+  CGF.EmitBlock(Exit, true);
+  auto Join = [&](llvm::ArrayRef<llvm::Value *> Inputs, llvm::StringRef Name) {
+    llvm::Type *ValueType = Complex ? CGF.ConvertType(Type->getAs<ComplexType>()->getElementType())
+                                    : CGF.ConvertType(Type);
+    auto *Phi = CGF.Builder.CreatePHI(ValueType, Inputs.size(), Name);
+    for (unsigned I = 0; I != Inputs.size(); ++I)
+      Phi->addIncoming(Inputs[I], IncomingBlocks[I]);
+    return static_cast<llvm::Value *>(Phi);
+  };
+  llvm::Value *Value = Join(Values, "objc3.match.value");
+  llvm::Value *Imag = Complex ? Join(Imaginary, "objc3.match.imaginary") : nullptr;
+  MatchScope.ForceCleanup({&Value, &Imag});
+  ResultScope.ForceCleanup({&Value, &Imag});
+  if (Retain)
+    Value = CGF.EmitObjCConsumeObject(Type, Value);
+  return Complex ? RValue::getComplex(Value, Imag) : RValue::get(Value);
+}
+
+} // namespace
+
+void CodeGenFunction::EmitObjC3MatchStmt(const ObjC3MatchStmt *Match) {
+  RunCleanupsScope MatchScope(*this);
+  MatchScrutinee State;
+  if (!emitScrutineeOnce(*this, Match->getScrutinee(), State, Match))
+    return;
+
+  llvm::BasicBlock *Exit = createBasicBlock("objc3.match.end");
+  for (unsigned I = 0; I != Match->getNumArms(); ++I) {
+    const ObjC3MatchArm &Arm = *Match->getArm(I);
+    llvm::BasicBlock *Next = createBasicBlock("objc3.match.next");
+    llvm::Value *Test = emitArmTest(*this, State, Arm);
+    llvm::BasicBlock *Selected = createBasicBlock("objc3.match.selected");
+    Builder.CreateCondBr(Test, Selected, Next);
+    EmitBlock(Selected);
+    llvm::BasicBlock *Unused = nullptr;
+    emitArmBody(*this, State, Arm, Next, Exit, nullptr, Unused);
+    EmitBlock(Next);
+  }
+  Builder.CreateBr(Exit);
+  EmitBlock(Exit, true);
+}
+
+llvm::Value *CodeGenFunction::EmitObjC3MatchExpr(const ObjC3MatchExpr *Match) {
+  return emitValueMatchExpr(*this, Match, false).getScalarVal();
+}
+
+RValue CodeGen::emitObjC3MatchComplexExpr(CodeGenFunction &CGF,
+                                        const ObjC3MatchExpr *Match) {
+  return emitValueMatchExpr(CGF, Match, true);
+}
+
+void CodeGen::emitObjC3MatchAggregateExpr(CodeGenFunction &CGF,
+                                          const ObjC3MatchExpr *Match,
+                                          AggValueSlot Destination) {
+  // The destination belongs to the enclosing expression. Only scrutinee,
+  // guards and arm temporaries are scoped inside this evaluation.
+  CodeGenFunction::RunCleanupsScope ResultScope(CGF);
+  Address ResultInitialized = Address::invalid();
+  if (Match->getType().isDestructedType() == QualType::DK_cxx_destructor &&
+      !CGF.isObjC3CarrierLocalInitialization(Destination.getAddress(),
+                                             Match->getType())) {
+    ResultInitialized =
+        CGF.CreateTempAlloca(CGF.Builder.getInt1Ty(), CharUnits::One(),
+                             "objc3.match.result.initialized");
+    CGF.Builder.CreateStore(CGF.Builder.getFalse(), ResultInitialized);
+    CGF.pushFullExprCleanup<DestroyCompletedMatchResult>(
+        EHCleanup, Match->getType(), Destination.getAddress(),
+        ResultInitialized);
+  }
+  CodeGenFunction::RunCleanupsScope MatchScope(CGF);
+  MatchScrutinee State;
+  if (!emitScrutineeOnce(CGF, Match->getScrutinee(), State, Match))
+    return;
+  llvm::BasicBlock *Exit = CGF.createBasicBlock("objc3.match.aggregate.end");
+  Destination.setExternallyDestructed();
+  CodeGenFunction::ConditionalEvaluation Evaluation(CGF);
+  for (unsigned I = 0; I != Match->getNumArms(); ++I) {
+    const ObjC3MatchArm &Arm = *Match->getArm(I);
+    llvm::BasicBlock *Next = CGF.createBasicBlock("objc3.match.aggregate.next");
+    llvm::Value *Test = emitArmTest(CGF, State, Arm);
+    llvm::BasicBlock *Selected =
+        CGF.createBasicBlock("objc3.match.aggregate.selected");
+    CGF.Builder.CreateCondBr(Test, Selected, Next);
+    CGF.EmitBlock(Selected);
+    llvm::BasicBlock *Unused = nullptr;
+    Evaluation.begin(CGF);
+    emitArmBody(CGF, State, Arm, Next, Exit, [&](const Expr *Body) {
+      CGF.EmitAggExpr(Body, Destination);
+      if (ResultInitialized.isValid() && CGF.HaveInsertPoint())
+        CGF.Builder.CreateStore(CGF.Builder.getTrue(), ResultInitialized);
+    }, Unused);
+    Evaluation.end(CGF);
+    CGF.EmitBlock(Next);
+  }
+  // Sema checked exhaustiveness. An unselected arm never creates a result.
+  CGF.Builder.CreateUnreachable();
+  CGF.EmitBlock(Exit, true);
+}
