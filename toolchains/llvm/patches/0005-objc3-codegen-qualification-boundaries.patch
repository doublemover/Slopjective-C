diff --git a/clang/test/ObjC3/CodeGen/Inputs/native-c-async-definition.h b/clang/test/ObjC3/CodeGen/Inputs/native-c-async-definition.h
new file mode 100644
index 000000000..b3da37925
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/native-c-async-definition.h
@@ -0,0 +1,10 @@
+#ifndef NATIVE_C_ASYNC_DEFINITION_H
+#define NATIVE_C_ASYNC_DEFINITION_H
+#include "native-c-async-frame.h"
+static inline int pch_leaf(int value) __objc3_async { return value; }
+static inline int pch_parent(int value) __objc3_async {
+  int live = value + 1;
+  return live + __objc3_await pch_leaf(1);
+}
+typedef int (*PCHAsyncInt)(int) __objc3_async;
+#endif
