+bool CodeGenTypes::diagnoseUnsupportedObjC3Effects(QualType T,
+                                                   const Decl *D) {
+  llvm::SmallPtrSet<const Type *, 16> Seen;
+  bool FoundUnsupportedEffect = false;
+  auto Visit = [&](auto &&VisitSelf, QualType Current) -> void {
+    if (Current.isNull())
+      return;
+    Current = Context.getCanonicalType(Current);
+    const Type *Ty = Current.getTypePtr();
+    if (!Seen.insert(Ty).second)
+      return;
+
+    if (const auto *FPT = dyn_cast<FunctionProtoType>(Ty)) {
+      ObjC3FunctionEffectInfo Effects = FPT->getObjC3FunctionEffects();
+      if (Effects.Async || Effects.Throws != ObjC3ThrowsKind::None) {
+        FoundUnsupportedEffect = true;
+        if (DiagnosedObjC3EffectTypes.insert(Ty).second) {
+          if (D)
+            CGM.ErrorUnsupported(D, "ObjC3 async/throws callable ABI lowering");
+          else
+            CGM.Error(SourceLocation(),
+                      "cannot compile ObjC3 async/throws callable type without ABI lowering");
+        }
+      }
+      VisitSelf(VisitSelf, FPT->getReturnType());
+      for (QualType Param : FPT->param_types())
+        VisitSelf(VisitSelf, Param);
+    } else if (const auto *FT = dyn_cast<FunctionNoProtoType>(Ty)) {
+      VisitSelf(VisitSelf, FT->getReturnType());
+    } else if (const auto *PT = dyn_cast<PointerType>(Ty)) {
+      VisitSelf(VisitSelf, PT->getPointeeType());
+    } else if (const auto *BPT = dyn_cast<BlockPointerType>(Ty)) {
+      VisitSelf(VisitSelf, BPT->getPointeeType());
+    } else if (const auto *RefTy = dyn_cast<ReferenceType>(Ty)) {
+      VisitSelf(VisitSelf, RefTy->getPointeeType());
+    } else if (const auto *MPT = dyn_cast<MemberPointerType>(Ty)) {
+      VisitSelf(VisitSelf, MPT->getPointeeType());
+    } else if (const auto *AT = dyn_cast<ArrayType>(Ty)) {
+      VisitSelf(VisitSelf, AT->getElementType());
+    } else if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Ty)) {
+      VisitSelf(VisitSelf, Optional->getElementType());
+    } else if (const auto *Result = dyn_cast<ObjC3ResultType>(Ty)) {
+      VisitSelf(VisitSelf, Result->getSuccessType());
+      VisitSelf(VisitSelf, Result->getErrorType());
+    } else if (const auto *OPT = dyn_cast<ObjCObjectPointerType>(Ty)) {
+      VisitSelf(VisitSelf, OPT->getPointeeType());
+    } else if (const auto *RecordTy = dyn_cast<RecordType>(Ty)) {
+      if (const RecordDecl *RD = RecordTy->getDecl()->getDefinition())
+        for (const FieldDecl *Field : RD->fields())
+          VisitSelf(VisitSelf, Field->getType());
+    }
+  };
+  Visit(Visit, T);
+  return FoundUnsupportedEffect;
+}
