+#ifndef TYPED_ERROR_MANAGED_RUNTIME_H
+#define TYPED_ERROR_MANAGED_RUNTIME_H
+#include "typed-error-runtime-interface.h"
+using ManagedSuccessBlock = int (^)(void);
+struct ManagedMRCMember {
+  ZeroCodeError *object(ZeroCodeError *, ZeroCodeError *) __objc3_throws(ZeroCodeError *);
+  ManagedSuccessBlock block(ZeroCodeError *) __objc3_throws(ZeroCodeError *);
+};
+@interface ManagedMRCReceiver : ZeroCodeError
+- (ZeroCodeError *)object:(ZeroCodeError *)value error:(ZeroCodeError *)error __objc3_throws(ZeroCodeError *);
+- (ManagedSuccessBlock)block:(ZeroCodeError *)error __objc3_throws(ZeroCodeError *);
+@end
+extern "C" {
+ZeroCodeError *managed_mrc_object(ZeroCodeError *, ZeroCodeError *) __objc3_throws(ZeroCodeError *);
+ZeroCodeError *managed_mrc_owned(ZeroCodeError *) __objc3_throws(ZeroCodeError *) __attribute__((ns_returns_retained));
+ManagedSuccessBlock managed_mrc_block(ZeroCodeError *) __objc3_throws(ZeroCodeError *);
+ManagedSuccessBlock managed_mrc_owned_block(ZeroCodeError *, ZeroCodeError *) __objc3_throws(ZeroCodeError *) __attribute__((ns_returns_retained));
+int run_mrc_managed_checks(void);
+}
+#endif
