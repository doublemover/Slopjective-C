+  MirrorResultIntLong error_wide = result_echo_indirect(
+      make_result_err(0x123456789abcdefLL));
+  if (error_wide.is_ok != 0 ||
+      error_wide.payload.error_value != 0x123456789abcdefLL)
+    return 8;
+
+  MirrorResultIntLong success_nonzero = result_echo_indirect(make_result_ok(42));
+  if (success_nonzero.is_ok != 1 || success_nonzero.payload.ok_value != 42)
+    return 9;
+  return 0;
