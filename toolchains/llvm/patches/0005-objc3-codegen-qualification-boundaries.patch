+// Compile this translation unit with -fno-objc-arc. All source-owned references
+// are explicitly balanced. The compiler owns a separate error transport retain.
+#include "typed-error-mixed-runtime.h"
+
+typedef __objc3_optional(int) MRCOptionalInt;
+static int MRCCleanupEvents;
+namespace { static int run_noreturn_checks(); }
+
+struct OwnedError {
+  RuntimeError Object = (RuntimeError)make_zero_code_error();
+  OwnedError() = default;
+  OwnedError(const OwnedError &) = delete;
+  ~OwnedError() {
+    [Object release];
+    ++MRCCleanupEvents;
+  }
+};
+struct CountCleanup { ~CountCleanup() { ++MRCCleanupEvents; } };
+struct ThrowCleanup { ~ThrowCleanup() noexcept(false) { throw 37; } };
+struct ThrowingOwnedError {
+  RuntimeError Object = (RuntimeError)make_zero_code_error();
+  ~ThrowingOwnedError() noexcept(false) { [Object release]; throw 41; }
+};
+
+extern "C" int mixed_mrc_value(int fail, RuntimeError error)
+    __objc3_throws(RuntimeError) {
+  if (fail) __objc3_throw(error);
+  return 0;
+}
+
+extern "C" int mixed_mrc_owned_pool(int fail) __objc3_throws(RuntimeError) {
+  @autoreleasepool {
+    OwnedError Owner;
+    if (fail) __objc3_throw(Owner.Object);
+    return 0;
+  }
+}
+
+extern "C" int mixed_mrc_forward_arc(int fail, RuntimeError error)
+    __objc3_throws(RuntimeError) {
+  @autoreleasepool {
+    CountCleanup Cleanup;
+    return __objc3_try(mixed_arc_value(fail, error));
+  }
+}
+
+static void mrc_expression_unwind() __objc3_throws(RuntimeError) {
+  __objc3_throw(ThrowingOwnedError().Object);
+}
+static void mrc_function_unwind() __objc3_throws(RuntimeError) {
+  OwnedError Owner;
+  ThrowCleanup Cleanup;
+  __objc3_throw(Owner.Object);
+}
+
+static int mrc_nested_rethrow() {
+  __objc3_do {
+    __objc3_do {
+      __objc3_throw(OwnedError().Object);
+    } __objc3_catch(RuntimeError error) {
+      // The temporary's original +1 is gone; the binding borrows the one
+      // reference owned by the handler. Rethrow must acquire a new retain.
+      if (zero_code_error_retain_count(error) != 1) return 80;
+      __objc3_throw(error);
+    } __objc3_catch { return 81; }
+  } __objc3_catch(RuntimeError error) {
+    if (zero_code_error_retain_count(error) != 1) return 82;
+    return 0;
+  }
+  return 83;
+}
+
+extern "C" int run_mrc_error_checks(void) {
+  int Before = zero_code_error_deallocations();
+  int Events = MRCCleanupEvents;
+  if (mrc_nested_rethrow() || zero_code_error_deallocations() != Before + 1 ||
+      MRCCleanupEvents != Events + 1)
