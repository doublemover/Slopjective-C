+      bool SupportedAsync = ErrorOutABI && AsyncABI && Effects.Async &&
+          !FPT->isVariadic() &&
+          FPT->getCallConv() == CC_C &&
+          !Context.getObjC3AsyncTaskType(FPT->getReturnType()).isNull() &&
+          (Effects.Throws == ObjC3ThrowsKind::None ||
+           Effects.Throws == ObjC3ThrowsKind::Untyped ||
+           isObjC3ErrorObjectType(CGM, Effects.ErrorType));
