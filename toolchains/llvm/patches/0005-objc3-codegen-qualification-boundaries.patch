diff --git a/clang/test/ObjC3/CodeGen/Inputs/typed-error-noreturn-runtime.inc b/clang/test/ObjC3/CodeGen/Inputs/typed-error-noreturn-runtime.inc
new file mode 100644
index 000000000..b11510f62
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-noreturn-runtime.inc
@@ -0,0 +1,69 @@
+// Native checked-error exits return through their ABI error output even when
+// the source function promises no ordinary success. Exercise optimized calls,
+// local handlers, propagation, optional swallowing and independent native EH.
+namespace {
+using NoreturnError = ZeroCodeError *;
+static int NoreturnEvents;
+struct NoreturnCleanup {
+  ~NoreturnCleanup() { ++NoreturnEvents; }
+};
+[[noreturn]] static int checked_noreturn(NoreturnError Error) throws(NoreturnError) {
+  NoreturnCleanup Local;
+  throwError(Error);
+}
+struct NoreturnReceiver {
+  [[noreturn]] int fail(NoreturnError Error) throws(NoreturnError) {
+    NoreturnCleanup Local;
+    throwError(Error);
+  }
+  [[noreturn]] virtual int dynamic(NoreturnError Error) throws(NoreturnError) {
+    NoreturnCleanup Local;
+    throwError(Error);
+  }
+};
+[[noreturn]] static int checked_noreturn_native(NoreturnError) throws(NoreturnError) {
+  NoreturnCleanup Local;
+  throw 91;
+}
+static int checked_noreturn_propagate(NoreturnError Error) throws(NoreturnError) {
+  NoreturnCleanup Local;
+  return tryValue(checked_noreturn(Error));
+}
+static int run_noreturn_checks() {
+  @autoreleasepool {
+    NoreturnError Error = (NoreturnError)make_zero_code_error();
+    int Before = NoreturnEvents;
+    int Caught = 0;
+    handle { (void)tryValue(checked_noreturn(Error)); return 201; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    auto Callback = &checked_noreturn;
+    handle { (void)tryValue(Callback(Error)); return 202; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    NoreturnReceiver Receiver;
+    handle { (void)tryValue(Receiver.fail(Error)); return 203; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    auto Member = &NoreturnReceiver::fail;
+    handle { (void)tryValue((Receiver.*Member)(Error)); return 204; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    NoreturnReceiver *Dynamic = &Receiver;
+    handle { (void)tryValue(Dynamic->dynamic(Error)); return 205; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    handle { (void)tryValue(checked_noreturn_propagate(Error)); return 206; }
+    catch(NoreturnError Received) { Caught += Received == Error; }
+    if (Caught != 6) return 207;
+    if (NoreturnEvents != Before + 7) return 211;
+    auto Missing = tryOptional(checked_noreturn(Error));
+    if (hasValue(Missing) || NoreturnEvents != Before + 8) return 208;
+    try {
+      (void)tryOptional(checked_noreturn_native(Error));
+      return 209;
+    } catch(int Value) {
+      if (Value != 91 || NoreturnEvents != Before + 9) return 210;
+    }
+#if !__has_feature(objc_arc)
+    [Error release];
+#endif
+  }
+  return 0;
+}
+} // namespace
