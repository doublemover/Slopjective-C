@@ -0,0 +1,71 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -fobjc-arc -emit-llvm -o - %s | FileCheck %s --implicit-check-not=@._OBJC_CLASS_SourceRoot --implicit-check-not=@._OBJC_CLASS_SourceChild --implicit-check-not=@._OBJC_PROTOCOL_SourceProtocol
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -x objective-c++ -std=c++20 -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s --implicit-check-not=@._OBJC_CLASS_SourceRoot --implicit-check-not=@._OBJC_CLASS_SourceChild --implicit-check-not=@._OBJC_PROTOCOL_SourceProtocol --check-prefixes=CHECK,CXX
+// Runtime names govern definitions, references, ivars, protocols, inheritance,
+// direct methods and typed exception metadata under GNUstep 2.2.
+__attribute__((objc_runtime_name("OwnedProtocol")))
+@protocol SourceProtocol
+- (int)value;
+@end
+
+__attribute__((objc_root_class,objc_runtime_name("OwnedRoot")))
+@interface SourceRoot <SourceProtocol> {
+@public
+  Class isa;
+  int slot;
+}
++ (Class)class;
+- (int)value;
+- (int)directValue __attribute__((objc_direct));
+@end
+@implementation SourceRoot
++ (Class)class { return self; }
+- (int)value { return slot; }
+- (int)directValue { return slot + 1; }
+@end
+
+__attribute__((objc_runtime_name("OwnedChild")))
+@interface SourceChild : SourceRoot @end
+@implementation SourceChild
+- (int)value { return [super value] + 1; }
+@end
+
+Class class_reference(void) { return [SourceRoot class]; }
+id protocol_reference(void) { return (id)@protocol(SourceProtocol); }
+int ivar_reference(SourceRoot *object) { return object->slot; }
+int direct_reference(SourceRoot *object) { return [object directValue]; }
+int exception_reference(SourceRoot *object) {
+  @try { @throw object; }
+  @catch (SourceRoot *caught) { return [caught directValue]; }
+}
+
+// CHECK-DAG: @._OBJC_CLASS_OwnedRoot =
+// CHECK-DAG: @._OBJC_CLASS_OwnedChild =
+// CHECK-DAG: @._OBJC_REF_CLASS_OwnedRoot =
+// CHECK-DAG: @._OBJC_PROTOCOL_OwnedProtocol =
+// CHECK-DAG: @__objc_ivar_offset_OwnedRoot.slot.i =
+// CHECK-DAG: define{{.*}} @_i_OwnedRoot__directValue(
+// CXX-DAG: @__objc_eh_typeinfo_OwnedRoot =
+
+__attribute__((objc_root_class, objc_runtime_name("__objc3_m_Class")))
+@interface OwnedMethods
++ (int)a_b:(int)value;
++ (int)a:(int)value b:(int)other;
++ (int)direct __attribute__((objc_direct));
+@end
+@implementation OwnedMethods
++ (int)a_b:(int)value { return value; }
++ (int)a:(int)value b:(int)other { return value + other; }
++ (int)direct { return 42; }
+@end
+__attribute__((annotate("objc3.module-name:__objc3_m_Category")))
+@interface OwnedMethods (SourceCategory)
++ (int)category;
+@end
+@implementation OwnedMethods (SourceCategory)
++ (int)category { return [OwnedMethods direct]; }
+@end
+// CHECK-DAG: define{{.*}} @__objc3_method_c_R15_5f5f6f626a63335f6d5f436c617373_C0__S4_615f623a_M(
+// CHECK-DAG: define{{.*}} @__objc3_method_c_R15_5f5f6f626a63335f6d5f436c617373_C0__S4_613a623a_M(
+// CHECK-DAG: define{{.*}} @__objc3_method_c_R15_5f5f6f626a63335f6d5f436c617373_C0__S6_646972656374_D(
+// CHECK-DAG: define{{.*}} @__objc3_method_c_R15_5f5f6f626a63335f6d5f436c617373_C18_5f5f6f626a63335f6d5f43617465676f7279_S8_63617465676f7279_M(
+// CHECK-DAG: c"__objc3_m_Category\00"
