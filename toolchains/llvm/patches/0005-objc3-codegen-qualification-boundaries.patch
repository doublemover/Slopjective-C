index 000000000..a5ab4ea77
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/carrier-arc-call-boundaries.mm
@@ -0,0 +1,32 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -DVARIADIC -emit-llvm -o %t.var.ll -verify %s
+// RUN: test ! -e %t.var.ll
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -DBLOCK -emit-llvm -o %t.block.ll -verify %s
+// RUN: test ! -e %t.block.ll
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -DTHROWS -emit-llvm -o %t.throws.ll -verify %s
+// RUN: test ! -e %t.throws.ll
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -DMUSTTAIL -emit-llvm -o %t.tail.ll -verify %s
+// RUN: test ! -e %t.tail.ll
+typedef __objc3_optional(id) Strong;
+#ifdef VARIADIC
+void variadic(int first, ...);
+void reject(Strong value) {
+  variadic(1, value); // expected-error {{ObjC3 carrier operation 'by-value call ABI'}} expected-error {{cannot pass object of non-trivial type}}
+}
+#endif
+#ifdef BLOCK
+void reject(Strong (^callback)(Strong), Strong value) {
+  callback(value); // expected-error {{ObjC3 carrier operation 'by-value call ABI'}}
+}
+#endif
+#ifdef THROWS
+@protocol Error @end
+Strong rejected(void) __objc3_throws(id<Error>) { // expected-error {{ObjC3 async/throws callable ABI lowering}}
+  return __objc3_none(id);
+}
+#endif
+#ifdef MUSTTAIL
+Strong tail(Strong value);
+Strong reject(Strong value) {
+  [[clang::musttail]] return tail(value); // expected-error {{tail call requires that the return value, all parameters, and any temporaries created by the expression are trivially destructible}}
+}
+#endif
