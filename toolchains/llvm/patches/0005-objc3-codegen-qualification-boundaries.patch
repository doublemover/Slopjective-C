+++ b/clang/test/ObjC3/CodeGen/typed-error-managed-success.mm
@@ -0,0 +1,33 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fblocks -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fblocks -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fblocks -emit-llvm -o - %s | FileCheck %s
+@protocol Error @end
+using E = id<Error>;
+using B = int (^)(void);
+extern "C" id object_value(id object, E error) __objc3_throws(E) {
+  if (error) __objc3_throw(error);
+  return object;
+}
+extern "C" B block_value(B block, E error) __objc3_throws(E) {
+  if (error) __objc3_throw(error);
+  return block;
+}
+using Callback = id (*)(id, E) __objc3_throws(E);
+using ThrowingBlock = B (^)(B, E) __objc3_throws(E);
+id callback(Callback call, id object) { return __objc3_try_force(call(object, (E)0)); }
+B invoke_block(ThrowingBlock call, B block) { return __objc3_try_force(call(block, (E)0)); }
+struct Member {
+  id value(id object, E error) __objc3_throws(E) { return __objc3_try(object_value(object, error)); }
+};
+id member(Member &receiver, id object) { return __objc3_try_force(receiver.value(object, (E)0)); }
+__attribute__((objc_root_class)) @interface Receiver
+- (id)value:(id)object error:(E)error __objc3_throws(E);
+@end
+@implementation Receiver
+- (id)value:(id)object error:(E)error __objc3_throws(E) { return __objc3_try(object_value(object, error)); }
+@end
+id message(Receiver *receiver, id object) { return __objc3_try_force([receiver value:object error:(E)0]); }
+// CHECK-LABEL: define{{.*}} ptr @object_value(ptr {{.*}}, ptr {{.*}}, ptr {{.*}})
+// CHECK: objc3.error.out.initialize
+// CHECK-LABEL: define{{.*}} ptr @block_value(ptr {{.*}}, ptr {{.*}}, ptr {{.*}})
+// CHECK: objc3.error.out.initialize
