+
+extern "C" int mixed_arc_value(int fail, RuntimeError error)
+    __objc3_throws(RuntimeError) {
+  if (fail) __objc3_throw(error);
+  return 0;
+}
+
+static int run_mixed_arc_checks() {
+  int Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    __attribute__((objc_precise_lifetime)) RuntimeError Error =
+        (RuntimeError)make_zero_code_error();
+    if (__objc3_try_force(mixed_mrc_value(0, Error)) != 0 ||
+        __objc3_try_force(mixed_mrc_forward_arc(0, Error)) != 0 ||
+        __objc3_has_value(__objc3_try_optional(mixed_mrc_value(1, Error))))
+      return 101;
+    int Caught = 0;
+    __objc3_do { __objc3_try(mixed_mrc_forward_arc(1, Error)); }
+    __objc3_catch(RuntimeError binding) {
+      if (binding != Error || !is_nonnull_zero_code_error(binding)) return 102;
+      ++Caught;
+    }
+    if (Caught != 1 || zero_code_error_deallocations() != Before) return 103;
+  }
+  if (zero_code_error_deallocations() != Before + 1) return 104;
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (__objc3_try_force(mixed_mrc_owned_pool(0)) != 0 ||
+        zero_code_error_deallocations() != Before + 1)
+      return 106;
+    if (__objc3_has_value(__objc3_try_optional(mixed_mrc_owned_pool(1))) ||
+        zero_code_error_deallocations() != Before + 1)
+      return 107;
+  }
