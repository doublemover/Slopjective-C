+class CodeGenFunction;
+class CodeGenModule;
+class LValue;
+enum class ObjC3StorageOperation {
+  DefaultInitialize,
+  Destroy,
+  Copy,
+  Move,
+  CopyAssign,
+  MoveAssign
+};
+bool supportsObjC3ManagedRecordLifetime(CodeGenModule &CGM, QualType Type);
+bool supportsObjC3ManagedRecordCallABI(CodeGenModule &CGM, QualType Type);
+/// Data-only records with native, complete runtime encodings.
+bool supportsObjC3ManagedRecordRuntimeABI(CodeGenModule &CGM, QualType Type);
+bool supportsObjC3ManagedRuntimeStorage(CodeGenModule &CGM, QualType Type);
+llvm::Function *getObjC3ManagedStorageFunction(CodeGenModule &CGM,
+                                               QualType Type,
+                                               ObjC3StorageOperation Operation);
+bool emitObjC3ManagedStorageCall(CodeGenFunction &CGF, LValue Destination,
+                                 ObjC3StorageOperation Operation);
+bool emitObjC3ManagedStorageCall(CodeGenFunction &CGF, LValue Destination,
+                                 LValue Source,
+                                 ObjC3StorageOperation Operation);
+void destroyObjC3ManagedStorage(CodeGenFunction &CGF, Address Storage,
+                                QualType Type);
+} // namespace clang::CodeGen
