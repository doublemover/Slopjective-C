+//===--- CGObjC3BlockCaptures.cpp - Explicit Block capture owners -----------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3BlockCaptures.h"
+#include "CGCall.h"
+#include "CGDebugInfo.h"
+#include "CGObjC3Carriers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ObjC3Async.h"
+#include "clang/AST/Stmt.h"
+#include "llvm/IR/DataLayout.h"
+#include "llvm/IR/DerivedTypes.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace clang::CodeGen {
+struct ObjC3BlockCaptureFullExprData {
+  ObjC3BlockCaptureCleanup *Captures = nullptr;
+};
+} // namespace clang::CodeGen
+
+namespace {
+bool containsExplicitBlockCapture(const Stmt *Statement) {
+  if (!Statement) return false;
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement))
+    return containsExplicitBlockCapture(Argument->getExpr());
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement))
+    return containsExplicitBlockCapture(Initializer->getExpr());
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Initializer : Lambda->capture_inits())
+      if (containsExplicitBlockCapture(Initializer)) return true;
+    return false;
+  }
+  if (const auto *Block = dyn_cast<BlockExpr>(Statement))
+    return Block->getBlockDecl()->hasObjC3CaptureList();
+  for (const Stmt *Child : Statement->children())
+    if (containsExplicitBlockCapture(Child)) return true;
+  return false;
+}
+struct RollbackBlockCaptureFullExpr final : EHScopeStack::Cleanup {
+  ObjC3BlockCaptureFullExprData *Data;
+  explicit RollbackBlockCaptureFullExpr(ObjC3BlockCaptureFullExprData *Data)
+      : Data(Data) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    // The list is prepended in creation order, so unwind destroys the completed
+    // prefix in reverse order. Earlier prefix cleanups may have run already.
+    for (auto *Capture = Data->Captures; Capture; Capture = Capture->Next)
+      emitObjC3BlockCaptureCleanup(CGF, Capture, true);
+  }
+};
+void releasePendingARCReturn(CodeGenFunction &CGF, llvm::Value *ShouldRelease) {
+  auto *Release = CGF.createBasicBlock("objc3.arc.return.abandon");
+  auto *Done = CGF.createBasicBlock("objc3.arc.return.continue");
+  CGF.Builder.CreateCondBr(ShouldRelease, Release, Done);
+  CGF.EmitBlock(Release);
+  // Disarm before releasing, including a Block whose dispose helper owns
+  // resource owners. A later exception path must not release the slot twice.
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(0), CGF.ObjC3ARCReturnPending);
+  CGF.EmitARCDestroyStrong(CGF.ReturnValue, ARCPreciseLifetime);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
+struct DestroyPendingARCReturn final : EHScopeStack::Cleanup {
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    llvm::Value *Site = CGF.Builder.CreateLoad(CGF.ObjC3ARCReturnPending);
+    releasePendingARCReturn(
+        CGF, CGF.Builder.CreateICmpNE(Site, CGF.Builder.getInt32(0)));
+  }
+};
+void collectARCReturnSites(const Stmt *Statement, CodeGenFunction &CGF,
+                          SmallVectorImpl<unsigned> &Sites) {
+  if (!Statement || isa<BlockExpr>(Statement)) return;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Initializer : Lambda->capture_inits())
+      collectARCReturnSites(Initializer, CGF, Sites);
+    return;
+  }
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement)) {
+    collectARCReturnSites(Argument->getExpr(), CGF, Sites);
+    return;
+  }
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement)) {
+    collectARCReturnSites(Initializer->getExpr(), CGF, Sites);
+    return;
+  }
+  if (const auto *Return = dyn_cast<ReturnStmt>(Statement)) {
+    if (unsigned Site = CGF.ObjC3ARCReturnSites.lookup(Return))
+      Sites.push_back(Site);
+    return;
+  }
+  for (const Stmt *Child : Statement->children())
+    collectARCReturnSites(Child, CGF, Sites);
+}
+// This prefix is compiler-private. Copy/dispose helpers depend only on this
+// versioned prefix, and can safely share helpers across different handle types,
+// cleanup functions and sentinels. Each owner carries its exact native callback.
+llvm::StructType *ownerHeader(CodeGenModule &CGM) {
+  return llvm::StructType::get(CGM.getLLVMContext(),
+                               {CGM.SizeTy, CGM.VoidPtrTy});
+}
+llvm::StructType *ownerType(CodeGenModule &CGM, const VarDecl &Variable) {
+  return llvm::StructType::get(
+      CGM.getLLVMContext(),
+      {CGM.SizeTy, CGM.VoidPtrTy,
+       CGM.getTypes().ConvertTypeForMem(Variable.getType())});
+}
+Address ownerAddress(CodeGenFunction &CGF, llvm::Value *Owner,
+                      llvm::StructType *Type) {
+  return Address(Owner, Type,
+      CharUnits::fromQuantity(CGF.CGM.getDataLayout().getABITypeAlign(Type).value()));
+}
+llvm::FunctionCallee allocationFunction(CodeGenModule &CGM, bool Free) {
+  auto *Type = Free
+      ? llvm::FunctionType::get(CGM.VoidTy, {CGM.VoidPtrTy}, false)
+      : llvm::FunctionType::get(CGM.VoidPtrTy, {CGM.SizeTy}, false);
+  return CGM.CreateRuntimeFunction(Type, Free ? "free" : "malloc");
+}
+struct FreeOwner final : EHScopeStack::Cleanup {
+  llvm::Value *Owner;
+  explicit FreeOwner(llvm::Value *Owner) : Owner(Owner) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.EmitNounwindRuntimeCall(allocationFunction(CGF.CGM, true), Owner);
+  }
+};
+void trapUnless(CodeGenFunction &CGF, llvm::Value *Condition,
+                 StringRef SuccessName) {
+  auto *Success = CGF.createBasicBlock(SuccessName);
+  auto *Failure = CGF.createBasicBlock("objc3.capture.owner.failure");
+  CGF.Builder.CreateCondBr(Condition, Success, Failure);
+  CGF.EmitBlock(Failure);
+  CGF.EmitTrapCall(llvm::Intrinsic::trap);
+  CGF.Builder.CreateUnreachable();
+  CGF.EmitBlock(Success);
+}
+
+llvm::Function *createResourceDestructor(CodeGenModule &CGM,
+                                          const VarDecl &Variable) {
+  const auto *Resource = Variable.getAttr<ObjCResourceAttr>();
+  assert(Resource && "resource capture requires a validated native contract");
+  ASTContext &Context = CGM.getContext();
+  auto *Parameter = ImplicitParamDecl::Create(
+      Context, Context.VoidPtrTy, ImplicitParamKind::Other);
+  FunctionArgList Parameters{Parameter};
+  const auto &FI = CGM.getTypes().arrangeBuiltinFunctionDeclaration(
+      Context.VoidTy, Parameters);
+  auto *Function = llvm::Function::Create(
+      CGM.getTypes().GetFunctionType(FI), llvm::GlobalValue::PrivateLinkage,
+      "__objc3_block_resource_destroy_v1", &CGM.getModule());
+  CGM.SetInternalFunctionAttributes(GlobalDecl(), Function, FI);
+  CodeGenFunction Callback(CGM);
+  Callback.StartFunction(GlobalDecl(), Context.VoidTy, Function, FI, Parameters);
+  auto Location = ApplyDebugLocation::CreateArtificial(Callback);
+  llvm::Value *Owner =
+      Callback.Builder.CreateLoad(Callback.GetAddrOfLocalVar(Parameter));
+  Address Payload = Callback.Builder.CreateStructGEP(
+      ownerAddress(Callback, Owner, ownerType(CGM, Variable)), 2,
+      "objc3.capture.resource");
+  QualType HandleType = Variable.getType();
+  LValue Handle = Callback.MakeAddrLValue(Payload, HandleType);
+  llvm::Value *Current = Callback.EmitLoadOfLValue(
+      Handle, Variable.getLocation()).getScalarVal();
+  llvm::Value *Invalid = Callback.EmitScalarExpr(Resource->getInvalid());
+  auto *Close = Callback.createBasicBlock("objc3.capture.resource.close");
+  auto *Done = Callback.createBasicBlock("objc3.capture.resource.done");
+  Callback.Builder.CreateCondBr(Callback.Builder.CreateICmpNE(Current, Invalid),
+                                Close, Done);
+  Callback.EmitBlock(Close);
+  // Consume before calling user code. Address callbacks receive a snapshot so
+  // they see the acquired handle while owner storage remains safely invalid.
+  Callback.EmitStoreOfScalar(Invalid, Handle);
+  llvm::Value *Argument = Current;
+  if (Resource->getByAddress()) {
+    Address Snapshot = Callback.CreateMemTemp(HandleType,
+                                               "objc3.capture.close.snapshot");
+    Callback.EmitStoreOfScalar(Current,
+                                Callback.MakeAddrLValue(Snapshot, HandleType),
+                                true);
+    Argument = Snapshot.emitRawPointer(Callback);
+  }
+  const auto *Call = cast<CallExpr>(Resource->getCall());
+  const auto *Operand =
+      cast<OpaqueValueExpr>(Call->getArg(0)->IgnoreParenImpCasts());
+  CodeGenFunction::OpaqueValueMapping Binding(Callback, Operand,
+                                               RValue::get(Argument));
+  // Keep the validated native call: conversions, calling convention, builtin
+  // lowering and a throwing cleanup's exception edge all remain intact.
+  Callback.EmitIgnoredExpr(Call);
+  Callback.EmitBranch(Done);
+  Callback.EmitBlock(Done);
+  Callback.FinishFunction();
+  return Function;
+}
+} // namespace
+
+ObjC3BlockCaptureFullExprScope::ObjC3BlockCaptureFullExprScope(
+    CodeGenFunction &CGF, const Expr *Expression) : CGF(CGF) {
+  if (!CGF.getLangOpts().ObjC3 ||
+      (!CGF.getLangOpts().Exceptions && !CGF.getLangOpts().ObjCExceptions) ||
+      !containsExplicitBlockCapture(Expression))
+    return;
+  Previous = CGF.ObjC3BlockCaptureFullExpr;
+  // Both this descriptor and its capture records outlive deferred EH emission
+  // after the C++ emission-scope object has returned. They contain no owners
+  // requiring destruction and use the AST arena's compilation lifetime.
+  Data = new (CGF.getContext()) ObjC3BlockCaptureFullExprData;
+  DominatingIP = CGF.Builder.CreateFlagLoad(
+      llvm::Constant::getNullValue(CGF.Int8PtrTy));
+  CGF.EHStack.pushCleanup<RollbackBlockCaptureFullExpr>(EHCleanup, Data);
+  Cleanup = CGF.EHStack.stable_begin();
+  CGF.ObjC3BlockCaptureFullExpr = this;
+}
+
+ObjC3BlockCaptureFullExprScope::~ObjC3BlockCaptureFullExprScope() {
+  finish();
+}
+
+void ObjC3BlockCaptureFullExprScope::finish() {
+  if (!Data) return;
+  CGF.ObjC3BlockCaptureFullExpr = Previous;
+  // The inner RunCleanupsScope has now finished temporary destruction and
+  // installed every permanent lifetime-extended cleanup. This is the ownership
+  // handoff point; earlier throwing destructors still route through rollback.
+  CGF.DeactivateCleanupBlock(Cleanup, DominatingIP);
+  DominatingIP->eraseFromParent();
+  Data = nullptr;
+}
+
+void ObjC3BlockCaptureFullExprScope::addCleanup(
+    ObjC3BlockCaptureCleanup *Capture) {
+  assert(Data && "only an active capture guard can register fields");
+  Capture->Next = Data->Captures;
+  Data->Captures = Capture;
+}
+
+ObjC3BlockCaptureCleanup *clang::CodeGen::registerObjC3BlockCaptureCleanup(
+    CodeGenFunction &CGF, Address Field, QualType Type,
+    CodeGenFunction::Destroyer *Destroyer, bool UseArrayEHCleanup) {
+  auto *Capture = new (CGF.getContext()) ObjC3BlockCaptureCleanup{
+      nullptr,
+      CGF.CreateTempAlloca(CGF.Int8PtrTy, CGF.getPointerAlign(),
+                          "objc3.capture.storage"),
+      CGF.CreateTempAlloca(CGF.Builder.getInt1Ty(), CharUnits::One(),
+                          "objc3.capture.live"),
+      Field.getElementType(), Field.getAlignment(), Type, Destroyer,
+      UseArrayEHCleanup};
+  CGBuilderTy EntryBuilder(CGF.CGM, CGF.AllocaInsertPt);
+  EntryBuilder.CreateStore(CGF.Builder.getFalse(), Capture->Live);
+  CGF.Builder.CreateStore(Field.emitRawPointer(CGF), Capture->StoragePointer);
+  CGF.Builder.CreateStore(CGF.Builder.getTrue(), Capture->Live);
+  if (CGF.ObjC3BlockCaptureFullExpr)
+    CGF.ObjC3BlockCaptureFullExpr->addCleanup(Capture);
+  return Capture;
+}
+
+void clang::CodeGen::emitObjC3BlockCaptureCleanup(
+    CodeGenFunction &CGF, ObjC3BlockCaptureCleanup *Capture, bool ForEHCleanup) {
+  auto *Destroy = CGF.createBasicBlock("objc3.capture.destroy");
+  auto *Done = CGF.createBasicBlock("objc3.capture.destroyed");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateLoad(Capture->Live), Destroy, Done);
+  CGF.EmitBlock(Destroy);
+  // Invalidate before calling a user destructor or the resource owner. A
+  // second exception must not make another cleanup path destroy this field.
+  CGF.Builder.CreateStore(CGF.Builder.getFalse(), Capture->Live);
+  Address Field(CGF.Builder.CreateLoad(Capture->StoragePointer),
+                Capture->ElementType, Capture->Alignment);
+  CGF.emitDestroy(Field, Capture->Type, Capture->Destroyer,
+                  !ForEHCleanup && Capture->UseArrayEHCleanup);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
+
+void clang::CodeGen::emitObjC3ARCReturnProlog(CodeGenFunction &CGF) {
+  // Native ARC result initialization produces +1 for both retained-result and
+  // autoreleased-result functions. Autorelease occurs only in the epilogue.
+  // Async/coroutine logical ObjC results use different physical staging slots.
+  const auto *Callable = getObjC3CallableFunctionType(CGF.CurCodeDecl);
+  if (!CGF.getLangOpts().ObjC3 || !CGF.getLangOpts().ObjCAutoRefCount ||
+      CGF.CurFuncIsThunk || CGF.FnRetTy.isNull() ||
+      !CGF.FnRetTy->isObjCRetainableType() || !CGF.ReturnValue.isValid() ||
+      (Callable && (Callable->isObjC3Async() ||
+                    Callable->isObjC3AsyncFrame())) || CGF.isCoroutine() ||
+      getObjC3CoroutineBody(CGF.CurCodeDecl) ||
+      !CGF.ReturnValue.getElementType()->isPointerTy())
+    return;
+  CGF.ObjC3ARCReturnPending = CGF.CreateTempAlloca(
+      CGF.Builder.getInt32Ty(), CharUnits::fromQuantity(4),
+      "objc3.arc.return.pending");
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(0), CGF.ObjC3ARCReturnPending);
+  if (CGF.getLangOpts().Exceptions || CGF.getLangOpts().ObjCExceptions)
+    CGF.EHStack.pushCleanup<DestroyPendingARCReturn>(EHCleanup);
+}
+
+void clang::CodeGen::commitObjC3ARCReturn(CodeGenFunction &CGF,
+                                        const ReturnStmt &Return) {
+  if (!CGF.ObjC3ARCReturnPending.isValid()) return;
+  const Expr *Value = Return.getRetValue();
+  while (const auto *Full = dyn_cast_or_null<ExprWithCleanups>(Value))
+    Value = Full->getSubExpr();
+  const auto *Produced = dyn_cast_or_null<ImplicitCastExpr>(Value);
+  if (!Produced || Produced->getCastKind() != CK_ARCProduceObject)
+    return; // Synthetic +0 returns have no proved owned result to release.
+  auto [Position, Inserted] = CGF.ObjC3ARCReturnSites.try_emplace(
+      &Return, CGF.ObjC3ARCReturnSites.size() + 1);
+  (void)Inserted;
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(Position->second),
+                          CGF.ObjC3ARCReturnPending);
+}
+
+void clang::CodeGen::abandonObjC3ARCReturnForCatch(CodeGenFunction &CGF,
+                                                const Stmt *TryBody) {
+  if (!CGF.ObjC3ARCReturnPending.isValid()) return;
+  SmallVector<unsigned, 8> Sites;
+  collectARCReturnSites(TryBody, CGF, Sites);
+  if (Sites.empty()) return;
+  llvm::Value *Pending = CGF.Builder.CreateLoad(CGF.ObjC3ARCReturnPending);
+  llvm::Value *Abandoned = CGF.Builder.getFalse();
+  for (unsigned Site : Sites)
+    Abandoned = CGF.Builder.CreateOr(
+        Abandoned, CGF.Builder.CreateICmpEQ(Pending, CGF.Builder.getInt32(Site)));
+  releasePendingARCReturn(CGF, Abandoned);
+}
+
+void clang::CodeGen::disarmObjC3ARCReturn(CodeGenFunction &CGF) {
+  if (CGF.ObjC3ARCReturnPending.isValid())
+    CGF.Builder.CreateStore(CGF.Builder.getInt32(0), CGF.ObjC3ARCReturnPending);
+}
+
+void clang::CodeGen::abandonObjC3ARCReturn(CodeGenFunction &CGF) {
+  if (!CGF.ObjC3ARCReturnPending.isValid()) return;
+  llvm::Value *Site = CGF.Builder.CreateLoad(CGF.ObjC3ARCReturnPending);
+  releasePendingARCReturn(
+      CGF, CGF.Builder.CreateICmpNE(Site, CGF.Builder.getInt32(0)));
+}
+
+uint64_t clang::CodeGen::getObjC3BlockResourcePayloadOffset(
+    CodeGenModule &CGM, const VarDecl &Variable) {
+  return CGM.getDataLayout().getStructLayout(ownerType(CGM, Variable))
+      ->getElementOffset(2);
+}
+
+Address clang::CodeGen::getObjC3BlockResourcePayload(
+    CodeGenFunction &CGF, Address Field, const VarDecl &Variable) {
+  llvm::Value *Owner = CGF.Builder.CreateLoad(Field, "objc3.capture.owner");
+  return CGF.Builder.CreateStructGEP(
+      ownerAddress(CGF, Owner, ownerType(CGF.CGM, Variable)), 2,
+      "objc3.capture.resource");
+}
+
+void clang::CodeGen::initializeObjC3BlockResource(
+    CodeGenFunction &CGF, Address Field, Address Source,
+    const VarDecl &Variable) {
+  CodeGenModule &CGM = CGF.CGM;
+  const auto *Resource = Variable.getAttr<ObjCResourceAttr>();
+  auto *Type = ownerType(CGM, Variable);
+  llvm::Value *Bytes = llvm::ConstantInt::get(
+      CGM.SizeTy, CGM.getDataLayout().getTypeAllocSize(Type).getFixedValue());
+  llvm::Value *Raw = CGF.EmitNounwindRuntimeCall(
+      allocationFunction(CGM, false), Bytes, "objc3.capture.owner.allocate");
+  // Allocation has not consumed the source. Failure terminates before changing
+  // its ownership or publishing a partially initialized owner.
+  trapUnless(CGF, CGF.Builder.CreateIsNotNull(Raw),
+               "objc3.capture.owner.allocated");
+  Address Owner = ownerAddress(CGF, Raw, Type);
+  CGF.Builder.CreateStore(llvm::ConstantInt::get(CGM.SizeTy, 1),
+                           CGF.Builder.CreateStructGEP(Owner, 0));
+  CGF.Builder.CreateStore(createResourceDestructor(CGM, Variable),
+                           CGF.Builder.CreateStructGEP(Owner, 1));
+  QualType HandleType = Variable.getType();
+  LValue SourceValue = CGF.MakeAddrLValue(Source, HandleType);
+  llvm::Value *Current = CGF.EmitLoadOfLValue(
+      SourceValue, Variable.getLocation()).getScalarVal();
+  Address Payload = CGF.Builder.CreateStructGEP(Owner, 2);
+  CGF.EmitStoreOfScalar(Current, CGF.MakeAddrLValue(Payload, HandleType), true);
+  llvm::Value *Invalid = CGF.EmitScalarExpr(Resource->getInvalid());
+  CGF.EmitStoreOfScalar(Invalid, SourceValue);
+  CGF.Builder.CreateStore(Raw, Field);
+}
+
+void clang::CodeGen::copyObjC3BlockResource(CodeGenFunction &CGF,
+                                            Address Destination,
+                                            Address Source) {
+  llvm::Value *Owner = CGF.Builder.CreateLoad(Source, "objc3.capture.owner");
+  Address Header = ownerAddress(CGF, Owner, ownerHeader(CGF.CGM));
+  llvm::Value *Old = CGF.Builder.CreateAtomicRMW(
+      llvm::AtomicRMWInst::Add, CGF.Builder.CreateStructGEP(Header, 0),
+      llvm::ConstantInt::get(CGF.SizeTy, 1), llvm::AtomicOrdering::Monotonic);
+  auto *Maximum = llvm::ConstantInt::getAllOnesValue(CGF.SizeTy);
+  trapUnless(CGF, CGF.Builder.CreateAnd(
+      CGF.Builder.CreateICmpNE(Old, Maximum),
+      CGF.Builder.CreateIsNotNull(Old)), "objc3.capture.owner.retained");
+  CGF.Builder.CreateStore(Owner, Destination);
+}
+
+void clang::CodeGen::destroyObjC3BlockResource(CodeGenFunction &CGF,
+                                               Address Field, QualType) {
+  llvm::Value *Owner = CGF.Builder.CreateLoad(Field, "objc3.capture.owner");
+  Address Header = ownerAddress(CGF, Owner, ownerHeader(CGF.CGM));
+  llvm::Value *Old = CGF.Builder.CreateAtomicRMW(
+      llvm::AtomicRMWInst::Sub, CGF.Builder.CreateStructGEP(Header, 0),
+      llvm::ConstantInt::get(CGF.SizeTy, 1),
+      llvm::AtomicOrdering::AcquireRelease);
+  auto *Final = CGF.createBasicBlock("objc3.capture.owner.final");
+  auto *Done = CGF.createBasicBlock("objc3.capture.owner.done");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateICmpEQ(
+      Old, llvm::ConstantInt::get(CGF.SizeTy, 1)), Final, Done);
+  CGF.EmitBlock(Final);
+  {
+    CodeGenFunction::RunCleanupsScope Cleanup(CGF);
+    CGF.EHStack.pushCleanup<FreeOwner>(NormalAndEHCleanup, Owner);
+    llvm::Value *Destructor = CGF.Builder.CreateLoad(
+        CGF.Builder.CreateStructGEP(Header, 1), "objc3.capture.owner.destructor");
+    auto *FunctionType = llvm::FunctionType::get(
+        CGF.VoidTy, {CGF.VoidPtrTy}, false);
+    // User close may throw. FreeOwner runs on the native exception edge before
+    // a later capture, the original scope, or the Blocks runtime handles it.
+    CGF.EmitRuntimeCallOrInvoke(llvm::FunctionCallee(FunctionType, Destructor),
+                                 Owner);
+  }
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
+
+void clang::CodeGen::clearObjC3MovedCaptureCarrier(CodeGenFunction &CGF,
+                                                    QualType Type,
+                                                    Address Source) {
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(Type);
+  auto ClearArm = [&](FieldDecl *Field, ObjC3CarrierPayloadArm Arm) {
+    if (!Field || Field->getType()->isVoidType())
+      return;
+    QualType Payload = Field->getType();
+    Address Storage = getObjC3CarrierPayloadAddress(CGF, Source, Type, Arm);
+    if (isa<ObjC3OptionalType, ObjC3ResultType>(
+            Payload.getCanonicalType().getTypePtr())) {
+      clearObjC3MovedCaptureCarrier(CGF, Payload, Storage);
+      return;
+    }
+    // Native ARC move has already left these initialized slots nil, including
+    // the source of objc_moveWeak. Do not overwrite a weak registration.
+    if (Payload.getObjCLifetime() == Qualifiers::OCL_Strong ||
+        Payload.getObjCLifetime() == Qualifiers::OCL_Weak)
+      return;
+    CGF.EmitNullInitialization(Storage, Payload);
+  };
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, Source, Type, SourceLocation(), false);
+  auto *Active = CGF.createBasicBlock("objc3.capture.move.active");
+  auto *Inactive = CGF.createBasicBlock("objc3.capture.move.inactive");
+  auto *Done = CGF.createBasicBlock("objc3.capture.move.done");
+  CGF.Builder.CreateCondBr(Tag, Active, Inactive);
+  CGF.EmitBlock(Active);
+  ClearArm(Info.ValueField ? Info.ValueField : Info.SuccessField,
+           Info.ValueField ? ObjC3CarrierPayloadArm::Value
+                           : ObjC3CarrierPayloadArm::Success);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Inactive);
+  ClearArm(Info.ErrorField, ObjC3CarrierPayloadArm::Error);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
