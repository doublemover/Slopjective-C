+#ifndef NATIVE_C_ASYNC_ENTRY_ABI_H
+#define NATIVE_C_ASYNC_ENTRY_ABI_H
+#include "native-c-async-frame.h"
+#include "native-async-task.h"
+template<class T> objc3::task<T> __objc3_async_from_frame(objc3_async_frame);
+@protocol Error @end
+@protocol FrameError <Error> @end
+extern "C" int frame_leaf(int) __objc3_async_frame;
+extern "C" void frame_empty(void) __objc3_async_frame;
+extern "C" id frame_object(id) __objc3_async_frame;
+extern "C" int frame_checked(id<FrameError>) __objc3_async_frame __objc3_throws(id<FrameError>);
+int task_leaf(int) __objc3_async;
+using FrameCallback = int (*)(int) __objc3_async_frame;
+using TaskCallback = int (*)(int) __objc3_async;
+using FrameBlock = int (^)(int) __objc3_async_frame;
+using TaskBlock = int (^)(int) __objc3_async;
+@protocol FrameMethods
+- (int)value:(int)value __objc3_async_frame;
+@end
+__attribute__((objc_root_class))
+@interface FrameWorker <FrameMethods>
+- (int)value:(int)value __objc3_async_frame;
+- (id)object:(id)value __objc3_async_frame;
+- (int)direct:(int)value __objc3_async_frame __attribute__((objc_direct));
++ (int)classValue __objc3_async_frame;
+@end
+#endif
