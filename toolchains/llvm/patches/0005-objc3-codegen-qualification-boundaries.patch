+#ifndef OBJC3_MATCH_AGGREGATE_PCH_H
+#define OBJC3_MATCH_AGGREGATE_PCH_H
+struct MatchPair { int first, second; };
+static inline struct MatchPair match_pair(int value) {
+  struct MatchPair result = {value, 42};
+  return result;
+}
+static inline struct MatchPair select_pair(Optional(int) value) {
+  return match(value) {
+    case .Some(let payload) => match_pair(payload);
+    case .None => match_pair(-1);
+  };
+}
+#if __has_feature(objc_arc)
+static inline Optional(id) select_owned(Optional(id) value) {
+  return match(value) {
+    case .Some(let payload) => Some(id, payload);
+    case .None => None(id);
+  };
+}
+#endif
+#ifdef __cplusplus
+struct MatchClass {
+  explicit MatchClass(int);
+  MatchClass(const MatchClass &);
+  ~MatchClass();
+  int value;
+};
+template <class T>
+static inline T select_copy(Optional(int) value, const T &left, const T &right) {
+  return match(value) {
+    case .Some(let payload) => left;
+    case .None => right;
+  };
+}
+#endif
+#endif
