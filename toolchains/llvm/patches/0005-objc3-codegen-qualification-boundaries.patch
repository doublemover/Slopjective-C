+  if (__objc3_try_force([NullReceiver forwardedValue:1 error:error]) != 0 ||
+      !__objc3_has_value(__objc3_try_optional([NullReceiver forwardedValue:1 error:error])) ||
+      __objc3_try_force([NullReceiver value:1 error:error]) != 0 ||
+      !__objc3_has_value(__objc3_try_optional([NullReceiver value:1 error:error])) ||
+      !__objc3_has_value(__objc3_try_optional([NullReceiver note:error]))) return 193;
+  int Receivers = 0, Arguments = 0;
+  if (__objc3_try_force([select_message_receiver(receiver, &Receivers)
+        value:select_message_argument(&Arguments) error:error]) != 0 ||
+      Receivers != 1 || Arguments != 1) return 194;
