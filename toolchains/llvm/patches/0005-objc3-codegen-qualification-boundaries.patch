+
+typedef __objc3_optional(int) MaybeInt;
+extern "C" {
+int next_scalar();
+void consume(const int &);
+
+void borrow_scalar_lvalue(int &source) {
+  __objc3_match_stmt (source) {
+  case let borrowed: { consume(borrowed); }
+  }
