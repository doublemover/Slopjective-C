diff --git a/clang/test/ObjC3/CodeGen/result-expression-lowering.c b/clang/test/ObjC3/CodeGen/result-expression-lowering.c
new file mode 100644
index 000000000..4d6df1540
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/result-expression-lowering.c
@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-version=3 -emit-llvm -o - %s | FileCheck %s
+
+typedef __objc3_result(int, long long) IntResult;
+typedef __objc3_result(void, int) VoidResult;
+extern void consume_storage(void *);
+extern void side_effect(void);
+extern int next_value(void);
+
+void success_zero(void) {
+  IntResult result = __objc3_ok(int, long long, 0);
+  consume_storage(&result);
+}
+void error_zero(void) {
+  IntResult result = __objc3_err(int, long long, 0);
+  consume_storage(&result);
+}
+void volatile_success(void) {
+  volatile IntResult result = __objc3_ok(int, long long, 0);
+  consume_storage((void *)&result);
+}
+_Bool query_success_zero(void) {
+  return __objc3_is_ok(__objc3_ok(int, long long, 0));
+}
+_Bool query_error_zero(void) {
+  return __objc3_is_ok(__objc3_err(int, long long, 0));
+}
+_Bool query_void_side_effect(void) {
+  return __objc3_is_ok(__objc3_ok(void, int, side_effect()));
+}
+_Bool exactly_once(void) {
+  return __objc3_is_ok(__objc3_err(int, long long, next_value()));
+}
+_Bool volatile_query(volatile IntResult *result) {
+  return __objc3_is_ok(*result);
+}
+
+// CHECK-LABEL: define{{.*}} @success_zero
+// CHECK: store i32 0
+// CHECK: store i8 1
+// CHECK-LABEL: define{{.*}} @error_zero
+// CHECK: store i64 0
+// CHECK: store i8 0
+// CHECK-LABEL: define{{.*}} @volatile_success
+// CHECK: store volatile i32 0
+// CHECK: store volatile i8 1
+// CHECK-LABEL: define{{.*}} @query_void_side_effect
+// CHECK: call void @side_effect()
+// CHECK-NOT: call void @side_effect()
+// CHECK-LABEL: define{{.*}} @exactly_once
+// CHECK: call i32 @next_value()
+// CHECK-NOT: call i32 @next_value()
+// CHECK-LABEL: define{{.*}} @volatile_query
+// CHECK: load volatile i8
diff --git a/clang/test/ObjC3/CodeGen/try-throw-fail-closed.mm b/clang/test/ObjC3/CodeGen/try-throw-fail-closed.mm
new file mode 100644
index 000000000..86b38ae6e
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/try-throw-fail-closed.mm
@@ -0,0 +1,42 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=1 -emit-llvm -o /dev/null -verify=propagate %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=2 -emit-llvm -o /dev/null -verify=raise %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=3 -emit-llvm -o /dev/null -verify=force %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=4 -emit-llvm -o /dev/null -verify=optionalize %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=5 -emit-llvm -o /dev/null -verify=complex %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -DTEST_KIND=6 -emit-llvm -o /dev/null -verify=handler %s
+
+struct Error {};
+
+// Each gate runs in its own translation unit. A top-level effect-qualified
+// declaration rejects the callable ABI before reaching a try visitor, so
+// the value visitors use native local function declarations instead.
+#if TEST_KIND == 1
+int propagate() __objc3_throws(Error) { // propagate-error {{ObjC3 async/throws callable ABI lowering}}
+  int typed_call(void) __objc3_throws(Error);
+  return __objc3_try(typed_call());
+}
+#elif TEST_KIND == 2
+void raise() __objc3_throws(Error) { // raise-error {{ObjC3 async/throws callable ABI lowering}}
+  __objc3_throw(Error{});
+}
+#elif TEST_KIND == 3
+int force_in_plain_callable() {
+  int typed_call(void) __objc3_throws(Error);
+  return __objc3_try_force(typed_call()); // force-error {{unsupported typed throws call shape}}
+}
+#elif TEST_KIND == 4
+void optionalize_in_plain_callable() {
+  int typed_call(void) __objc3_throws(Error);
+  __objc3_optional(int) value = __objc3_try_optional(typed_call()); // optionalize-error {{unsupported typed throws optional result}}
+}
+#elif TEST_KIND == 5
+_Complex double force_complex() {
+  _Complex double complex_call(void) __objc3_throws(Error);
+  return __objc3_try_force(complex_call()); // complex-error {{unsupported typed throws call shape}}
+}
+#elif TEST_KIND == 6
+void reject_unqualified_handler() {
+  __objc3_do { __objc3_throw(Error{}); } // handler-error {{non-object typed-error handler ABI}}
+  __objc3_catch(Error error) { (void)error; }
+}
+#endif
