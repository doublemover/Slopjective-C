+struct BlockCaptureLifetime {
+  int *Live;
+  explicit BlockCaptureLifetime(int *live) : Live(live) { ++*Live; }
+  BlockCaptureLifetime(const BlockCaptureLifetime &other) : Live(other.Live) { ++*Live; }
+  ~BlockCaptureLifetime() { --*Live; }
+};
+extern "C" RuntimeErrorBlock make_arc_error_block(RuntimeError error,
+                                                   int *live, int *cleanups) {
+  BlockCaptureLifetime Owner(live);
+  __block int Sequence = 0;
+  return ^int(int fail) __objc3_throws(RuntimeError) {
+    int Value = Sequence++;
+    CallbackCleanup Cleanup{cleanups, false};
+    if (*Owner.Live < 1) __builtin_trap();
+    @autoreleasepool { if (fail) __objc3_throw(error); }
+    return Value;
+  };
+}
+extern "C" int invoke_consumed_error_block(
+    id owner __attribute__((ns_consumed)), int fail)
+    __objc3_throws(RuntimeError) {
+  RuntimeErrorBlock block = (RuntimeErrorBlock)owner;
+  return __objc3_try(block(fail));
+}
+extern "C" int run_block_checks(void) {
+  int Before = zero_code_error_deallocations();
+  int Live = 0, Cleanups = 0;
+  @autoreleasepool {
+    __attribute__((objc_precise_lifetime)) RuntimeError Error =
+        (RuntimeError)make_zero_code_error();
+    __attribute__((objc_precise_lifetime)) RuntimeErrorBlock Arc =
+        make_arc_error_block(Error, &Live, &Cleanups);
+    if (Live != 1 || __objc3_try_force(Arc(0)) != 0 || Cleanups != 1) return 130;
+    int Caught = 0;
+    __objc3_do { __objc3_try(Arc(1)); }
+    __objc3_catch(RuntimeError error) { if (error != Error) return 131; ++Caught; }
+    if (Caught != 1 || Cleanups != 2) return 132;
+    if (!verify_physical_error_block((__bridge void *)Arc, Error, 2) || Cleanups != 5)
+      return 133;
+    RuntimeErrorBlock Forward = ^int(int fail) __objc3_throws(RuntimeError) {
+      return __objc3_try(Arc(fail));
+    };
+    if (__objc3_try_force(Forward(0)) != 5 || Cleanups != 6) return 134;
+    if (__objc3_has_value(__objc3_try_optional(Forward(1))) || Cleanups != 7) return 135;
+    RuntimeErrorBlock Plain = ^int(int value) { return value; };
+    if (__objc3_try_force(Plain(7)) != 7) return 136;
+    RuntimeVoidErrorBlock Void = ^void(int fail) __objc3_throws(RuntimeError) {
+      if (fail) __objc3_throw(Error);
+    };
+    __objc3_try_force(Void(0));
+    if (__objc3_has_value(__objc3_try_optional(Void(1)))) return 137;
+    RuntimeErrorBlock MRC = make_mrc_error_block(Error);
+    if (__objc3_try_force(MRC(0)) != 0 ||
+        __objc3_has_value(__objc3_try_optional(MRC(1))) ||
+        __objc3_try_force(MRC(0)) != 1) return 138;
+    int ParameterCleanups = 0;
+    RuntimeCleanupErrorBlock WithCleanup =
+        ^int(int fail, RuntimeError error, CallbackCleanup cleanup)
+            __objc3_throws(RuntimeError) {
+          if (fail) __objc3_throw(error);
+          return 0;
+        };
+    try {
+      (void)__objc3_try_optional(WithCleanup(1, Error, CallbackCleanup{&ParameterCleanups, true}));
+      return 139;
+    } catch (int Value) {
+      if (Value != 79 || ParameterCleanups != 1) return 140;
+    }
+  }
+  if (Live != 0 || zero_code_error_deallocations() != Before + 1) return 141;
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (__objc3_has_value(__objc3_try_optional(invoke_consumed_error_block(
+            make_mrc_error_block((RuntimeError)make_zero_code_error()), 1))) ||
+        zero_code_error_deallocations() != Before) return 142;
+  }
+  if (zero_code_error_deallocations() != Before + 1) return 143;
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    RuntimeConsumedArgumentBlock Consumed =
+        ^int(int fail, RuntimeError error __attribute__((ns_consumed)))
+            __objc3_throws(RuntimeError) {
+          if (fail) __objc3_throw(error);
+          return 0;
+        };
+    if (__objc3_has_value(__objc3_try_optional(
+            Consumed(1, (RuntimeError)make_zero_code_error()))) ||
+        zero_code_error_deallocations() != Before) return 151;
+  }
+  if (zero_code_error_deallocations() != Before + 1) return 152;
+  return run_mrc_block_checks();
+}
+
+extern "C" void block_trap(int kind) {
+  @autoreleasepool {
+    RuntimeError Error = kind == 1 ? nil : (RuntimeError)make_zero_code_error();
+    RuntimeErrorBlock Block = ^int(int fail) __objc3_throws(RuntimeError) {
+      if (fail) __objc3_throw(Error);
+      return 0;
+    };
+    __objc3_try_force(Block(1));
+  }
+}
