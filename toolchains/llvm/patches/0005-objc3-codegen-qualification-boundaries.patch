diff --git a/clang/lib/CodeGen/CGObjC3MixedCarriers.cpp b/clang/lib/CodeGen/CGObjC3MixedCarriers.cpp
new file mode 100644
index 000000000..b64f7d116
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3MixedCarriers.cpp
@@ -0,0 +1,291 @@
+//===--- CGObjC3MixedCarriers.cpp - Mixed ARC/C++ carrier locals -----------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3MixedCarriers.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3Carriers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/Expr.h"
+#include "llvm/IR/Constants.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+
+bool isCarrier(QualType T) {
+  return !T.isNull() && isa<ObjC3OptionalType, ObjC3ResultType>(
+                            T.getCanonicalType().getTypePtr());
+}
+
+bool isARCPointer(QualType T) {
+  return T->isObjCObjectPointerType() || T->isBlockPointerType();
+}
+
+bool classifyTree(CodeGenModule &CGM, QualType T, bool &HasARC,
+                   bool &HasCXX, unsigned &Budget, unsigned Depth = 0) {
+  if (T.isNull() || T->isDependentType() || T.isVolatileQualified() ||
+      Depth > 64 || Budget == 0)
+    return false;
+  --Budget;
+  if (isCarrier(T)) {
+    auto Info = CGM.getContext().getObjC3CarrierRepresentationType(T);
+    if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+      return false;
+    for (FieldDecl *Field : {Info.ValueField, Info.SuccessField, Info.ErrorField})
+      if (Field && !classifyTree(CGM, Field->getType(), HasARC, HasCXX,
+                                 Budget, Depth + 1))
+        return false;
+    return true;
+  }
+  if (isARCPointer(T)) {
+    HasARC = true;
+    auto Lifetime = T.getObjCLifetime();
+    return Lifetime == Qualifiers::OCL_Strong ||
+           Lifetime == Qualifiers::OCL_Weak ||
+           Lifetime == Qualifiers::OCL_ExplicitNone;
+  }
+  if (!supportsObjC3CarrierCppPayloadLifetime(CGM, T))
+    return false;
+  HasCXX |= T->getAsCXXRecordDecl() != nullptr;
+  return true;
+}
+
+bool emitMixedConstructor(CodeGenFunction &CGF, QualType Type,
+                           Address Destination, Expr *Payload,
+                           ObjC3CarrierPayloadArm Arm, bool IsNone,
+                           bool IsLocalInitialization, bool IsIgnored,
+                           bool IsVolatile, SourceLocation Loc) {
+  auto Fail = [&]() {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, Type, "mixed ARC/C++ carrier local initialization");
+    return true;
+  };
+  ObjC3CarrierStorageLayout Layout;
+  if (!supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type) ||
+      !IsLocalInitialization || IsIgnored || IsVolatile ||
+      !Destination.isValid() || Destination.isSigned() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, Type, Layout) ||
+      Destination.getElementType() != Layout.StorageType ||
+      !CGF.isObjC3CarrierLocalInitialization(Destination, Type))
+    return Fail();
+
+  if (!IsNone) {
+    if (!Payload)
+      return Fail();
+    auto Info = CGF.getContext().getObjC3CarrierRepresentationType(Type);
+    FieldDecl *Field = Arm == ObjC3CarrierPayloadArm::Value ? Info.ValueField
+                       : Arm == ObjC3CarrierPayloadArm::Success
+                           ? Info.SuccessField : Info.ErrorField;
+    if (!Field) {
+      if (!Payload->getType()->isVoidType())
+        return Fail();
+      (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(), true);
+    } else {
+      QualType PayloadType = Field->getType();
+      Address Storage =
+          getObjC3CarrierPayloadAddress(CGF, Destination, Type, Arm);
+      if (!Storage.isValid())
+        return Fail();
+      if (isCarrier(PayloadType)) {
+        if (supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, PayloadType))
+          emitObjC3MixedCarrierValueInit(CGF, Payload, Storage);
+        else if (supportsObjC3CarrierARCLocalLifetime(CGF.CGM, PayloadType))
+          emitObjC3CarrierARCValueInit(CGF, Payload, Storage);
+        else
+          emitObjC3CarrierCppValueInit(CGF, Payload, Storage);
+      } else if (isARCPointer(PayloadType)) {
+        CGF.EmitScalarInit(Payload, nullptr,
+                           CGF.MakeAddrLValue(Storage, PayloadType), false);
+      } else {
+        CGF.EmitAnyExprToMem(Payload, Storage, PayloadType.getQualifiers(),
+                             /*IsInit=*/true);
+      }
+    }
+  }
+  return emitObjC3CarrierStoreTag(
+             CGF, Destination, Type,
+             CGF.Builder.getInt1(!IsNone && Arm != ObjC3CarrierPayloadArm::Error),
+             /*IsInitialization=*/true, /*IsVolatile=*/false)
+             ? true : Fail();
+}
+
+/// Each materialized non-carrier leaf receives one ordinal in source arm
+/// order. Absent Optionals and void arms use zero, which never owns a payload.
+llvm::Value *emitSelection(CodeGenFunction &CGF, QualType Type, Address Storage,
+                            unsigned &Ordinal) {
+  if (!isCarrier(Type))
+    return CGF.Builder.getInt32(++Ordinal);
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(Type);
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, Storage, Type, SourceLocation(), false);
+  assert(Tag && "qualified mixed carrier tag");
+  auto *Active = CGF.createBasicBlock("objc3.mixed.select.active");
+  auto *Inactive = CGF.createBasicBlock("objc3.mixed.select.inactive");
+  auto *Done = CGF.createBasicBlock("objc3.mixed.select.done");
+  CGF.Builder.CreateCondBr(Tag, Active, Inactive);
+  auto SelectArm = [&](FieldDecl *Field, ObjC3CarrierPayloadArm Arm) {
+    if (!Field)
+      return static_cast<llvm::Value *>(CGF.Builder.getInt32(0));
+    Address Payload =
+        getObjC3CarrierPayloadAddress(CGF, Storage, Type, Arm);
+    assert(Payload.isValid() && "qualified mixed carrier payload");
+    return emitSelection(CGF, Field->getType(), Payload, Ordinal);
+  };
+  const bool IsOptional = Type->getAs<ObjC3OptionalType>();
+  CGF.EmitBlock(Active);
+  llvm::Value *TrueValue = SelectArm(
+      IsOptional ? Info.ValueField : Info.SuccessField,
+      IsOptional ? ObjC3CarrierPayloadArm::Value : ObjC3CarrierPayloadArm::Success);
+  auto *TrueEnd = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Inactive);
+  llvm::Value *FalseValue =
+      SelectArm(Info.ErrorField, ObjC3CarrierPayloadArm::Error);
+  auto *FalseEnd = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+  auto *Value = CGF.Builder.CreatePHI(CGF.Int32Ty, 2, "objc3.mixed.selected");
+  Value->addIncoming(TrueValue, TrueEnd);
+  Value->addIncoming(FalseValue, FalseEnd);
+  return Value;
+}
+
+struct Leaf {
+  QualType Type;
+  Address Storage;
+  unsigned Ordinal;
+};
+
+void collectLeaves(CodeGenFunction &CGF, QualType Type, Address Storage,
+                    SmallVectorImpl<Leaf> &Leaves, unsigned &Ordinal) {
+  if (!isCarrier(Type)) {
+    Leaves.push_back({Type, Storage, ++Ordinal});
+    return;
+  }
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(Type);
+  auto Collect = [&](FieldDecl *Field, ObjC3CarrierPayloadArm Arm) {
+    if (!Field)
+      return;
+    Address Payload = getObjC3CarrierPayloadAddress(CGF, Storage, Type, Arm);
+    assert(Payload.isValid() && "qualified mixed carrier payload");
+    collectLeaves(CGF, Field->getType(), Payload, Leaves, Ordinal);
+  };
+  Collect(Info.ValueField, ObjC3CarrierPayloadArm::Value);
+  Collect(Info.SuccessField, ObjC3CarrierPayloadArm::Success);
+  Collect(Info.ErrorField, ObjC3CarrierPayloadArm::Error);
+}
+
+} // namespace
+
+bool CodeGen::supportsObjC3MixedCarrierLocalLifetime(CodeGenModule &CGM,
+                                                     QualType Type) {
+  if (!CGM.getLangOpts().ObjCAutoRefCount || !CGM.getLangOpts().CPlusPlus ||
+      !isCarrier(Type))
+    return false;
+  bool HasARC = false, HasCXX = false;
+  unsigned Budget = 256;
+  return classifyTree(CGM, Type, HasARC, HasCXX, Budget) && HasARC && HasCXX;
+}
+
+void CodeGen::emitObjC3MixedCarrierValueInit(CodeGenFunction &CGF,
+                                            const Expr *E, Address Destination) {
+  QualType Type = E->getType().getCanonicalType().getUnqualifiedType();
+  assert(supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type));
+  CodeGenFunction::CleanupDeactivationScope Deactivation(CGF);
+  auto Saved = CGF.getObjC3CarrierLocalInitState();
+  Address Initialized = beginObjC3CarrierInitGuard(
+      CGF, Type, Destination, /*IsARC=*/false);
+  CGF.setObjC3CarrierLocalInitState({Destination, Type, Initialized});
+  CGF.EmitAnyExprToMem(E, Destination, Qualifiers(), true);
+  CGF.setObjC3CarrierLocalInitState(Saved);
+}
+
+bool CodeGen::emitObjC3OptionalMixedLocalExpr(
+    CodeGenFunction &CGF, const ObjC3OptionalExpr &E, Address Destination,
+    bool IsLocalInitialization, bool DestinationIsIgnored,
+    bool DestinationIsVolatile) {
+  return emitMixedConstructor(
+      CGF, E.getCarrierType(), Destination, E.getPayload(),
+      ObjC3CarrierPayloadArm::Value,
+      E.getKind() == ObjC3OptionalExpr::Kind::None, IsLocalInitialization,
+      DestinationIsIgnored, DestinationIsVolatile, E.getKeywordLoc());
+}
+
+bool CodeGen::emitObjC3ResultMixedLocalExpr(
+    CodeGenFunction &CGF, const ObjC3ResultExpr &E, Address Destination,
+    bool IsLocalInitialization, bool DestinationIsIgnored,
+    bool DestinationIsVolatile) {
+  return emitMixedConstructor(
+      CGF, E.getCarrierType(), Destination, E.getPayload(),
+      E.getKind() == ObjC3ResultExpr::Kind::Err ? ObjC3CarrierPayloadArm::Error
+                                               : ObjC3CarrierPayloadArm::Success,
+      false, IsLocalInitialization, DestinationIsIgnored,
+      DestinationIsVolatile, E.getKeywordLoc());
+}
+
+llvm::Value *CodeGen::emitObjC3MixedCarrierTagQuery(
+    CodeGenFunction &CGF, QualType Type, Expr *Operand, bool IsResult,
+    SourceLocation Loc) {
+  if (!supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type) || !Operand ||
+      !Operand->isGLValue() || Operand->getType().isVolatileQualified() ||
+      IsResult != (Type->getAs<ObjC3ResultType>() != nullptr)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, Type, "mixed ARC/C++ carrier tag query");
+    return llvm::PoisonValue::get(CGF.ConvertType(CGF.getContext().BoolTy));
+  }
+  Address Storage = CGF.EmitLValue(Operand).getAddress();
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(CGF, Storage, Type, Loc, false);
+  assert(Tag && "qualified mixed carrier tag");
+  return Tag;
+}
+
+Address CodeGen::snapshotObjC3MixedCarrierCleanupSelection(
+    CodeGenFunction &CGF, QualType Type, Address Storage) {
+  assert(supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type));
+  unsigned Ordinal = 0;
+  llvm::Value *Selected = emitSelection(CGF, Type, Storage, Ordinal);
+  Address Selection = CGF.CreateTempAlloca(
+      CGF.Int32Ty, CGF.getContext().getTypeAlignInChars(CGF.getContext().IntTy),
+      "objc3.mixed.cleanup.selection");
+  CGF.Builder.CreateStore(Selected, Selection);
+  return Selection;
+}
+
+void CodeGen::emitObjC3MixedCarrierDestroyPayload(
+    CodeGenFunction &CGF, QualType Type, Address Storage, bool PreciseLifetime,
+    bool DestroyCXX, bool DestroyStrong, bool DestroyWeak, Address Selection) {
+  assert(supportsObjC3MixedCarrierLocalLifetime(CGF.CGM, Type));
+  if (!Selection.isValid())
+    Selection = snapshotObjC3MixedCarrierCleanupSelection(CGF, Type, Storage);
+  SmallVector<Leaf, 8> Leaves;
+  unsigned Ordinal = 0;
+  collectLeaves(CGF, Type, Storage, Leaves, Ordinal);
+  auto *Done = CGF.createBasicBlock("objc3.mixed.destroy.done");
+  auto *Dispatch = CGF.Builder.CreateSwitch(CGF.Builder.CreateLoad(Selection),
+                                           Done, Leaves.size());
+  for (const Leaf &L : Leaves) {
+    auto Lifetime = L.Type.getObjCLifetime();
+    bool IsCXX = L.Type.isDestructedType() == QualType::DK_cxx_destructor;
+    if (!(IsCXX && DestroyCXX) &&
+        !(isARCPointer(L.Type) &&
+          ((DestroyStrong && Lifetime == Qualifiers::OCL_Strong) ||
+           (DestroyWeak && Lifetime == Qualifiers::OCL_Weak))))
+      continue;
+    auto *Destroy = CGF.createBasicBlock("objc3.mixed.destroy.leaf");
+    Dispatch->addCase(CGF.Builder.getInt32(L.Ordinal), Destroy);
+    CGF.EmitBlock(Destroy);
+    if (IsCXX)
+      CGF.emitDestroy(L.Storage, L.Type,
+                      CGF.getDestroyer(QualType::DK_cxx_destructor), false);
+    else if (Lifetime == Qualifiers::OCL_Strong)
+      CGF.EmitARCDestroyStrong(
+          L.Storage, PreciseLifetime ? ARCPreciseLifetime : ARCImpreciseLifetime);
+    else
+      CGF.EmitARCDestroyWeak(L.Storage);
+    CGF.Builder.CreateBr(Done);
+  }
+  CGF.EmitBlock(Done);
+}
