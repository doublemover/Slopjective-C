@@ -0,0 +1,1300 @@
+//===--- CGObjC3Carriers.cpp - ObjC3 carrier CodeGen adapter ----*- C++ -*-===//
+//
+//===----------------------------------------------------------------------===//
+
+#include "CGObjC3Carriers.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3ManagedStorage.h"
+#include "CGObjC3ResultExpr.h"
+#include "CGRecordLayout.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "CodeGenTypes.h"
+#include "clang/AST/CanonicalType.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/TypeLoc.h"
+#include "clang/AST/Type.h"
+#include "clang/CodeGen/CGFunctionInfo.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+
+/// The hidden synthetic CXXRecordDecl is layout-only. Inspect source payload
+/// types recursively and conservatively; never ask its implicit special-member
+/// traits whether copying, moving, or destruction is legal.
+bool hasOnlyTrivialCallABILeaves(ASTContext &Ctx, QualType T) {
+  if (T.isNull())
+    return false;
+  if (const auto *Array = Ctx.getAsArrayType(T))
+    return isa<ConstantArrayType>(Array) &&
+           hasOnlyTrivialCallABILeaves(Ctx, Array->getElementType());
+  if (T->isVoidType() || T->isIntegerType() || T->isEnumeralType() ||
+      T->isRealFloatingType() || T->isPointerType() ||
+      T->isAnyComplexType() || T->isMemberPointerType())
+    return !T->isObjCObjectPointerType() && !T->isBlockPointerType() &&
+           T.getObjCLifetime() == Qualifiers::OCL_None;
+
+  const Type *Canonical = Ctx.getCanonicalType(T).getTypePtr();
+  if (isa<ObjC3OptionalType>(Canonical)) {
+    auto Info = Ctx.getObjC3CarrierRepresentationType(T);
+    if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+      return false;
+    return !Info.ValueField ||
+           hasOnlyTrivialCallABILeaves(Ctx, Info.ValueField->getType());
+  }
+  if (isa<ObjC3ResultType>(Canonical)) {
+    auto Info = Ctx.getObjC3CarrierRepresentationType(T);
+    if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+      return false;
+    return (!Info.SuccessField ||
+            hasOnlyTrivialCallABILeaves(Ctx, Info.SuccessField->getType())) &&
+           (!Info.ErrorField ||
+            hasOnlyTrivialCallABILeaves(Ctx, Info.ErrorField->getType()));
+  }
+
+  // C records have no user-declared C++ special members. Walk their declared
+  // fields rather than inferring operation properties from a synthetic
+  // carrier record. C++ records remain fail-closed until Sema supplies the
+  // actual use-site operation resolution.
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    if (isa<CXXRecordDecl>(RD) || !RD->isCompleteDefinition())
+      return false;
+    for (const FieldDecl *Field : RD->fields())
+      if (!hasOnlyTrivialCallABILeaves(Ctx, Field->getType()))
+        return false;
+    return true;
+  }
+
+  // Includes C++ records, ARC-qualified storage, vectors, and any type whose
+  // actual use-site special-member/lifetime facts are not available here.
+  return false;
+}
+
+bool containsNestedCarrierValue(ASTContext &Ctx, QualType T) {
+  if (T.isNull())
+    return false;
+  const Type *Canonical = Ctx.getCanonicalType(T).getTypePtr();
+  if (isa<ObjC3OptionalType>(Canonical) || isa<ObjC3ResultType>(Canonical))
+    return true;
+  if (const auto *Array = Ctx.getAsArrayType(T))
+    return containsNestedCarrierValue(Ctx, Array->getElementType());
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    if (const RecordDecl *Definition = RD->getDefinition())
+      for (const FieldDecl *Field : Definition->fields())
+        if (containsNestedCarrierValue(Ctx, Field->getType()))
+          return true;
+  }
+  return false;
+}
+
+} // namespace
+
+bool CodeGen::getObjC3CarrierStorageLayout(CodeGenModule &CGM,
+                                           QualType CarrierType,
+                                           ObjC3CarrierStorageLayout &Result) {
+  Result = {};
+  ASTContext &Ctx = CGM.getContext();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized ||
+      !Info.Record || !Info.TagField || Info.Type.isNull())
+    return false;
+
+  const CGRecordLayout &Outer = CGM.getTypes().getCGRecordLayout(Info.Record);
+  Result.StorageType = Outer.getLLVMType();
+  Result.TagField = Outer.getLLVMFieldNo(Info.TagField);
+  if (Info.PayloadField) {
+    if (!Info.PayloadUnion)
+      return false;
+    Result.HasPayloadStorage = true;
+  }
+
+  // Guard against accidental disagreement between AST representation identity
+  // and CodeGen's actual memory type. Never rebuild a lookalike LLVM struct.
+  if (CGM.getTypes().ConvertTypeForMem(Info.Type) != Result.StorageType) {
+    Result = {};
+    return false;
+  }
+  return true;
+}
+
+Address CodeGen::getObjC3CarrierTagAddress(CodeGenFunction &CGF,
+                                           Address CarrierStorage,
+                                           QualType CarrierType) {
+  ObjC3CarrierStorageLayout Layout;
+  if (!CarrierStorage.isValid() || CarrierStorage.isSigned() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      CarrierStorage.getElementType() != Layout.StorageType)
+    return Address::invalid();
+  return CGF.Builder.CreateStructGEP(CarrierStorage, Layout.TagField,
+                                     "objc3.carrier.tag.addr");
+}
+
+Address CodeGen::getObjC3CarrierPayloadAddress(CodeGenFunction &CGF,
+                                               Address CarrierStorage,
+                                               QualType CarrierType,
+                                               ObjC3CarrierPayloadArm Arm) {
+  ObjC3CarrierStorageLayout Layout;
+  if (!CarrierStorage.isValid() || CarrierStorage.isSigned() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      CarrierStorage.getElementType() != Layout.StorageType ||
+      !Layout.hasPayloadStorage())
+    return Address::invalid();
+
+  uint64_t ArmOffsetBits = 0;
+  FieldDecl *SourceField = nullptr;
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(CarrierType);
+  switch (Arm) {
+  case ObjC3CarrierPayloadArm::Value:
+    ArmOffsetBits = Info.ValueOffsetBits;
+    SourceField = Info.ValueField;
+    break;
+  case ObjC3CarrierPayloadArm::Success:
+    ArmOffsetBits = Info.SuccessOffsetBits;
+    SourceField = Info.SuccessField;
+    break;
+  case ObjC3CarrierPayloadArm::Error:
+    ArmOffsetBits = Info.ErrorOffsetBits;
+    SourceField = Info.ErrorField;
+    break;
+  }
+  const unsigned CharWidth = CGF.getContext().getCharWidth();
+  if (!SourceField || ArmOffsetBits % CharWidth)
+    return Address::invalid();
+  // Empty C++ fields may have no physical LLVM field number. The AST's native
+  // record layout still owns their byte offset and required object address.
+  // Using that offset also avoids inheriting another union arm's memory type.
+  Address PayloadStorage = CGF.Builder.CreateConstInBoundsByteGEP(
+      CarrierStorage.withElementType(CGF.Int8Ty),
+      CharUnits::fromQuantity(ArmOffsetBits / CharWidth),
+      "objc3.carrier.payload.addr");
+  llvm::Type *ArmMemoryType = CGF.ConvertTypeForMem(SourceField->getType());
+  return PayloadStorage.withElementType(ArmMemoryType);
+}
+
+llvm::Value *CodeGen::emitObjC3CarrierLoadTag(CodeGenFunction &CGF,
+                                              Address CarrierStorage,
+                                              QualType CarrierType,
+                                              SourceLocation Loc,
+                                              bool IsVolatile) {
+  Address Tag = getObjC3CarrierTagAddress(CGF, CarrierStorage, CarrierType);
+  if (!Tag.isValid())
+    return nullptr;
+  return CGF.EmitLoadOfScalar(Tag, IsVolatile, CGF.getContext().BoolTy, Loc);
+}
+
+bool CodeGen::emitObjC3CarrierStoreTag(CodeGenFunction &CGF,
+                                       Address CarrierStorage,
+                                       QualType CarrierType,
+                                       llvm::Value *TagValue,
+                                      bool IsInitialization,
+                                      bool IsVolatile) {
+  Address Tag = getObjC3CarrierTagAddress(CGF, CarrierStorage, CarrierType);
+  if (!Tag.isValid() || !TagValue)
+    return false;
+  CGF.EmitStoreOfScalar(TagValue, Tag, IsVolatile,
+                        CGF.getContext().BoolTy, AlignmentSource::Type,
+                        IsInitialization);
+  return true;
+}
+
+// H4 OPTIONAL EXPR LOWERING BEGIN.
+bool CodeGen::emitObjC3OptionalAggregateExpr(
+    CodeGenFunction &CGF, const ObjC3OptionalExpr &E, Address Destination,
+    bool DestinationIsIgnored, bool DestinationIsVolatile,
+    bool IsLocalCarrierInitialization) {
+  const QualType CarrierType = E.getCarrierType();
+  const bool IsNone = E.getKind() == ObjC3OptionalExpr::Kind::None;
+  const bool IsSome = E.getKind() == ObjC3OptionalExpr::Kind::Some;
+  if (!IsNone && !IsSome)
+    return false;
+
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) &&
+      !(IsLocalCarrierInitialization && !DestinationIsIgnored &&
+        supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        IsSome ? "Some construction" : "None construction");
+    return true;
+  }
+
+  // A discarded Some still evaluates its payload exactly once, including a
+  // void side-effect expression, but needs no Optional storage.
+  if (DestinationIsIgnored) {
+    if (IsSome && E.getPayload())
+      (void)CGF.EmitAnyExpr(E.getPayload(), AggValueSlot::ignored(),
+                            /*ignoreResult=*/true);
+    return true;
+  }
+
+  ObjC3CarrierStorageLayout Layout;
+  if (!Destination.isValid() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      Destination.getElementType() != Layout.StorageType) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "aggregate storage construction");
+    return true;
+  }
+
+  if (IsSome) {
+    Expr *Payload = E.getPayload();
+    TypeSourceInfo *PayloadInfo = E.getPayloadTypeInfo();
+    if (!Payload || !PayloadInfo) {
+      diagnoseUnsupportedObjC3CarrierOperation(
+          CGF.CGM, E.getKeywordLoc(), CarrierType,
+          "Some payload construction");
+      return true;
+    }
+
+    QualType PayloadType = PayloadInfo->getType();
+    if (PayloadType->isVoidType()) {
+      // The tag is the only representation field for Optional<void>. Evaluate
+      // before setting it so a throwing/side-effecting expression is once-only.
+      (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(),
+                            /*ignoreResult=*/true);
+    } else {
+      Address PayloadStorage = getObjC3CarrierPayloadAddress(
+          CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Value);
+      if (!PayloadStorage.isValid()) {
+        diagnoseUnsupportedObjC3CarrierOperation(
+            CGF.CGM, E.getKeywordLoc(), CarrierType,
+            "Some payload storage");
+        return true;
+      }
+
+      // The Sema child is already copy-initialized to T. Emit it directly into
+      // the selected hidden union arm; never load/copy the enclosing record.
+      // EmitAnyExprToMem reconstructs scalar LValues from the expression type,
+      // which drops qualifiers supplied only by a volatile carrier destination.
+      // Store scalar children explicitly so both payload and carrier volatility
+      // survive, while evaluating the child exactly once.
+      const bool PayloadIsVolatile =
+          DestinationIsVolatile || PayloadType.isVolatileQualified();
+      if (CodeGenFunction::hasScalarEvaluationKind(PayloadType)) {
+        llvm::Value *Value = CGF.EmitScalarExpr(Payload);
+        CGF.EmitStoreOfScalar(Value, PayloadStorage, PayloadIsVolatile,
+                              PayloadType, AlignmentSource::Type,
+                              /*isInit=*/true);
+      } else {
+        Qualifiers PayloadQualifiers = PayloadType.getQualifiers();
+        if (DestinationIsVolatile)
+          PayloadQualifiers.addVolatile();
+        CGF.EmitAnyExprToMem(Payload, PayloadStorage, PayloadQualifiers,
+                             /*IsInit=*/true);
+      }
+    }
+  }
+
+  // Presence is committed only after successful payload initialization.
+  // None writes false and never touches the inactive union storage.
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(IsSome),
+                                /*IsInitialization=*/true,
+                                DestinationIsVolatile)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "discriminant initialization");
+  }
+  return true;
+}
+
+llvm::Value *CodeGen::emitObjC3OptionalHasValueExpr(
+    CodeGenFunction &CGF, const ObjC3OptionalExpr &E) {
+  QualType CarrierType = E.getCarrierType();
+  Expr *Operand = E.getPayload();
+  auto UndefBool = [&]() -> llvm::Value * {
+    return llvm::PoisonValue::get(CGF.ConvertType(E.getType()));
+  };
+
+  // Borrowing an existing C++ carrier reads only its discriminant. It does
+  // not construct, copy, move, or destroy the active payload.
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) &&
+      !(Operand && Operand->isGLValue() &&
+        supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "hasValue query");
+    return UndefBool();
+  }
+
+  if (!Operand) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "hasValue operand");
+    return UndefBool();
+  }
+
+  Address Storage = Address::invalid();
+  if (Operand->isGLValue()) {
+    // Reading a tag from an Optional glvalue is a borrow, not a copy or move.
+    Storage = CGF.EmitLValue(Operand).getAddress();
+  } else {
+    // Materialize an Optional rvalue once, then inspect only the tag. This
+    // avoids duplicating calls, side effects, and temporary cleanup.
+    Storage = CGF.CreateMemTemp(CarrierType, "objc3.optional.hasvalue");
+    CGF.EmitAnyExprToMem(Operand, Storage, Qualifiers(), /*IsInit=*/true);
+  }
+
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, Storage, CarrierType, E.getExprLoc(),
+      Operand->getType().isVolatileQualified());
+  if (!Tag) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "hasValue tag read");
+    return UndefBool();
+  }
+  return Tag;
+}
+// H4 OPTIONAL EXPR LOWERING END.
+
+namespace {
+bool supportsOptionalCopyPayload(CodeGenModule &CGM, QualType PayloadType,
+                                 unsigned Depth = 0) {
+  if (Depth > 64 || PayloadType.isNull())
+    return false;
+  ASTContext &Ctx = CGM.getContext();
+  QualType Canonical = Ctx.getCanonicalType(PayloadType);
+  const Type *Ty = Canonical.getTypePtr();
+  if (Ty->isVoidType())
+    return true;
+  if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Ty)) {
+    ObjC3CarrierStorageLayout Layout;
+    if (!getObjC3CarrierStorageLayout(CGM, Canonical, Layout))
+      return false;
+    auto Info = Ctx.getObjC3CarrierRepresentationType(Canonical);
+    return !Info.ValueField ||
+           supportsOptionalCopyPayload(CGM, Optional->getElementType(),
+                                       Depth + 1);
+  }
+  if (const auto *Result = dyn_cast<ObjC3ResultType>(Ty)) {
+    ObjC3CarrierStorageLayout Layout;
+    if (!getObjC3CarrierStorageLayout(CGM, Canonical, Layout))
+      return false;
+    return supportsOptionalCopyPayload(CGM, Result->getSuccessType(),
+                                       Depth + 1) &&
+           supportsOptionalCopyPayload(CGM, Result->getErrorType(),
+                                       Depth + 1);
+  }
+  // Ordinary Clang aggregate copying is valid only when the leaf contains no
+  // carrier subobject. Such subobjects must be recursively transferred by tag.
+  return !containsNestedCarrierValue(Ctx, Canonical) &&
+         hasOnlyTrivialCallABILeaves(Ctx, Canonical);
+}
+
+bool emitOptionalCopyImpl(CodeGenFunction &CGF, QualType CarrierType,
+                          Address Destination, Address Source,
+                          bool DestinationIsVolatile,
+                          bool SourceIsVolatile, bool IsInitialization,
+                          SourceLocation Loc, unsigned Depth);
+
+bool emitOptionalCopyPayload(CodeGenFunction &CGF, QualType PayloadType,
+                             Address Destination, Address Source,
+                             bool DestinationIsVolatile,
+                             bool SourceIsVolatile, bool IsInitialization,
+                             SourceLocation Loc, unsigned Depth) {
+  if (Depth > 64 || PayloadType.isNull())
+    return false;
+  ASTContext &Ctx = CGF.getContext();
+  QualType Canonical = Ctx.getCanonicalType(PayloadType);
+  const Type *Ty = Canonical.getTypePtr();
+  if (Ty->isVoidType())
+    return true;
+
+  if (isa<ObjC3OptionalType>(Ty))
+    return emitOptionalCopyImpl(CGF, Canonical, Destination, Source,
+                                DestinationIsVolatile, SourceIsVolatile,
+                                IsInitialization, Loc, Depth);
+  if (isa<ObjC3ResultType>(Ty))
+    return emitObjC3ResultCopy(CGF, Canonical, Destination, Source,
+                               DestinationIsVolatile, SourceIsVolatile,
+                               IsInitialization, Loc);
+
+  const bool SrcVolatile = SourceIsVolatile || PayloadType.isVolatileQualified();
+  const bool DstVolatile = DestinationIsVolatile || PayloadType.isVolatileQualified();
+  if (Ty->isAnyComplexType()) {
+    QualType SrcType = SrcVolatile ? Ctx.getVolatileType(PayloadType) : PayloadType;
+    QualType DstType = DstVolatile ? Ctx.getVolatileType(PayloadType) : PayloadType;
+    auto Value = CGF.EmitLoadOfComplex(CGF.MakeAddrLValue(Source, SrcType), Loc);
+    CGF.EmitStoreOfComplex(Value, CGF.MakeAddrLValue(Destination, DstType),
+                           IsInitialization);
+    return true;
+  }
+  if (Ty->isScalarType()) {
+    llvm::Value *Value =
+        CGF.EmitLoadOfScalar(Source, SrcVolatile, PayloadType, Loc);
+    if (!Value)
+      return false;
+    CGF.EmitStoreOfScalar(Value, Destination, DstVolatile, PayloadType,
+                          AlignmentSource::Type, IsInitialization);
+    return true;
+  }
+
+  if (!Ty->isAggregateType() ||
+      containsNestedCarrierValue(Ctx, PayloadType))
+    return false;
+  const uint64_t Size = Ctx.getTypeSizeInChars(PayloadType).getQuantity();
+  // The leaf is an ordinary C aggregate, not a carrier or C++ object. memmove
+  // handles exact-self/overlap safely; the enclosing carrier is never copied.
+  CGF.Builder.CreateMemMove(Destination, Source, CGF.Builder.getInt64(Size),
+                            DstVolatile || SrcVolatile);
+  return true;
+}
+
+bool validateCarrierCopyStorageImpl(CodeGenFunction &CGF, QualType CarrierType,
+                                    Address Destination, Address Source,
+                                    unsigned Depth) {
+  if (Depth > 64)
+    return false;
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || !Source.isValid() || Destination.isSigned() ||
+      Source.isSigned() || Destination.getElementType() != Layout.StorageType ||
+      Source.getElementType() != Layout.StorageType)
+    return false;
+  const Type *Canonical =
+      CGF.getContext().getCanonicalType(CarrierType).getTypePtr();
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(CarrierType);
+  const auto *Optional = dyn_cast<ObjC3OptionalType>(Canonical);
+  const auto *Result = dyn_cast<ObjC3ResultType>(Canonical);
+  if (!Optional && !Result)
+    return false;
+
+  auto ValidateArm = [&](FieldDecl *Field, QualType PayloadType,
+                         ObjC3CarrierPayloadArm Arm) {
+    if (PayloadType->isVoidType())
+      return Field == nullptr;
+    if (!Field ||
+        !CGF.getContext().hasSameType(Field->getType(), PayloadType))
+      return false;
+    Address SrcPayload =
+        getObjC3CarrierPayloadAddress(CGF, Source, CarrierType, Arm);
+    Address DstPayload =
+        getObjC3CarrierPayloadAddress(CGF, Destination, CarrierType, Arm);
+    if (!SrcPayload.isValid() || !DstPayload.isValid() ||
+        SrcPayload.getElementType() != CGF.ConvertTypeForMem(PayloadType) ||
+        DstPayload.getElementType() != CGF.ConvertTypeForMem(PayloadType))
+      return false;
+    const Type *PayloadCanonical =
+        CGF.getContext().getCanonicalType(PayloadType).getTypePtr();
+    if (isa<ObjC3OptionalType>(PayloadCanonical) ||
+        isa<ObjC3ResultType>(PayloadCanonical))
+      return validateCarrierCopyStorageImpl(CGF, PayloadType, DstPayload,
+                                            SrcPayload, Depth + 1);
+    return supportsOptionalCopyPayload(CGF.CGM, PayloadType, Depth + 1);
+  };
+
+  if (Optional)
+    return ValidateArm(Info.ValueField, Optional->getElementType(),
+                       ObjC3CarrierPayloadArm::Value);
+  return ValidateArm(Info.SuccessField, Result->getSuccessType(),
+                     ObjC3CarrierPayloadArm::Success) &&
+         ValidateArm(Info.ErrorField, Result->getErrorType(),
+                     ObjC3CarrierPayloadArm::Error);
+}
+
+bool emitOptionalCopyImpl(CodeGenFunction &CGF, QualType CarrierType,
+                          Address Destination, Address Source,
+                          bool DestinationIsVolatile,
+                          bool SourceIsVolatile, bool IsInitialization,
+                          SourceLocation Loc, unsigned Depth) {
+  if (Depth > 64)
+    return false;
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || !Source.isValid() || Destination.isSigned() ||
+      Source.isSigned() || Destination.getElementType() != Layout.StorageType ||
+      Source.getElementType() != Layout.StorageType)
+    return false;
+
+  ASTContext &Ctx = CGF.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const auto *Optional = dyn_cast<ObjC3OptionalType>(Canonical);
+  if (!Optional ||
+      !supportsOptionalCopyPayload(CGF.CGM, Optional->getElementType(), Depth))
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  Address SrcPayload = Address::invalid();
+  Address DstPayload = Address::invalid();
+  if (Info.ValueField) {
+    SrcPayload = getObjC3CarrierPayloadAddress(
+        CGF, Source, CarrierType, ObjC3CarrierPayloadArm::Value);
+    DstPayload = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Value);
+    if (!SrcPayload.isValid() || !DstPayload.isValid())
+      return false;
+  }
+
+  llvm::Value *Present = emitObjC3CarrierLoadTag(
+      CGF, Source, CarrierType, Loc, SourceIsVolatile);
+  if (!Present)
+    return false;
+  llvm::BasicBlock *CopyPayload =
+      CGF.createBasicBlock("objc3.optional.copy.present");
+  llvm::BasicBlock *CopyAbsent =
+      CGF.createBasicBlock("objc3.optional.copy.absent");
+  llvm::BasicBlock *Continue =
+      CGF.createBasicBlock("objc3.optional.copy.cont");
+  CGF.Builder.CreateCondBr(Present, CopyPayload, CopyAbsent);
+
+  CGF.EmitBlock(CopyPayload);
+  if (Info.ValueField &&
+      !emitOptionalCopyPayload(CGF, Optional->getElementType(), DstPayload,
+                               SrcPayload, DestinationIsVolatile,
+                               SourceIsVolatile, IsInitialization, Loc,
+                               Depth + 1))
+    return false;
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(true), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+
+  CGF.EmitBlock(CopyAbsent);
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(false), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+  CGF.EmitBlock(Continue);
+  return true;
+}
+} // namespace
+
+bool CodeGen::supportsObjC3CarrierCopyPayload(CodeGenModule &CGM,
+                                              QualType PayloadType,
+                                              unsigned Depth) {
+  return supportsOptionalCopyPayload(CGM, PayloadType, Depth);
+}
+
+bool CodeGen::validateObjC3CarrierCopyStorage(CodeGenFunction &CGF,
+                                               QualType CarrierType,
+                                               Address Destination,
+                                               Address Source,
+                                               unsigned Depth) {
+  return validateCarrierCopyStorageImpl(CGF, CarrierType, Destination, Source,
+                                        Depth);
+}
+
+bool CodeGen::emitObjC3CarrierCopyPayload(
+    CodeGenFunction &CGF, QualType PayloadType, Address Destination,
+    Address Source, bool DestinationIsVolatile, bool SourceIsVolatile,
+    bool IsInitialization, SourceLocation Loc, unsigned Depth) {
+  if (Depth > 64 || PayloadType.isNull())
+    return false;
+  ASTContext &Ctx = CGF.getContext();
+  QualType Canonical = Ctx.getCanonicalType(PayloadType);
+  const Type *Ty = Canonical.getTypePtr();
+  if (Ty->isVoidType())
+    return true;
+  if (isa<ObjC3OptionalType>(Ty))
+    return emitOptionalCopyImpl(CGF, Canonical, Destination, Source,
+                                DestinationIsVolatile, SourceIsVolatile,
+                                IsInitialization, Loc, Depth);
+  if (isa<ObjC3ResultType>(Ty))
+    return emitObjC3ResultCopy(CGF, Canonical, Destination, Source,
+                               DestinationIsVolatile, SourceIsVolatile,
+                               IsInitialization, Loc);
+  if (!supportsOptionalCopyPayload(CGF.CGM, PayloadType, Depth))
+    return false;
+  const bool SrcVolatile = SourceIsVolatile || PayloadType.isVolatileQualified();
+  const bool DstVolatile = DestinationIsVolatile || PayloadType.isVolatileQualified();
+  if (Ty->isScalarType()) {
+    llvm::Value *Value =
+        CGF.EmitLoadOfScalar(Source, SrcVolatile, PayloadType, Loc);
+    if (!Value)
+      return false;
+    CGF.EmitStoreOfScalar(Value, Destination, DstVolatile, PayloadType,
+                          AlignmentSource::Type, IsInitialization);
+    return true;
+  }
+  if (!Ty->isAggregateType() ||
+      containsNestedCarrierValue(Ctx, PayloadType))
+    return false;
+  const uint64_t Size = Ctx.getTypeSizeInChars(PayloadType).getQuantity();
+  CGF.Builder.CreateMemMove(Destination, Source, CGF.Builder.getInt64(Size),
+                            DstVolatile || SrcVolatile);
+  return true;
+}
+
+bool CodeGen::emitObjC3OptionalCopy(CodeGenFunction &CGF,
+                                    QualType CarrierType,
+                                    Address Destination, Address Source,
+                                    bool DestinationIsVolatile,
+                                    bool SourceIsVolatile,
+                                    bool IsInitialization,
+                                    SourceLocation Loc) {
+  ASTContext &Ctx = CGF.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const auto *Optional = dyn_cast<ObjC3OptionalType>(Canonical);
+  if (!Optional ||
+      !supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) ||
+      !supportsOptionalCopyPayload(CGF.CGM, Optional->getElementType()) ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source,
+                                       0)) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Optional copy");
+    return true;
+  }
+  // Snapshot the complete active tree before writing any destination field.
+  // This preserves source reads under exact self-copy and overlapping ranges,
+  // while leaving every inactive temporary payload uninitialized and unread.
+  QualType SnapshotType = Ctx.getCanonicalType(CarrierType).getUnqualifiedType();
+  Address Snapshot = CGF.CreateMemTemp(SnapshotType,
+                                       "objc3.optional.copy.snapshot");
+  if (!emitOptionalCopyImpl(CGF, SnapshotType, Snapshot, Source,
+                            /*DestinationIsVolatile=*/false,
+                            SourceIsVolatile, /*IsInitialization=*/true, Loc,
+                            0) ||
+      !emitOptionalCopyImpl(CGF, CarrierType, Destination, Snapshot,
+                            DestinationIsVolatile,
+                            /*SourceIsVolatile=*/false, IsInitialization, Loc,
+                            0))
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Optional copy storage");
+  // true means the ordinary whole-carrier memcpy fallback is always forbidden.
+  return true;
+}
+
+bool CodeGen::classifyObjC3CarrierCallABI(CodeGenModule &CGM,
+                                          QualType CarrierType,
+                                          ObjC3CarrierCallABI &Result) {
+  Result = {};
+  ASTContext &Ctx = CGM.getContext();
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGM, CarrierType, Layout))
+    return false;
+
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  auto IsTrivialField = [&](FieldDecl *FD) {
+    return !FD || (!containsNestedCarrierValue(Ctx, FD->getType()) &&
+                   hasOnlyTrivialCallABILeaves(Ctx, FD->getType()));
+  };
+  if (!IsTrivialField(Info.ValueField) || !IsTrivialField(Info.SuccessField) ||
+      !IsTrivialField(Info.ErrorField))
+    return false;
+
+  // Let this target's ABIInfo classify the actual Clang record, for both a
+  // return and a parameter. No host macros, hand-authored coercions, or ABI
+  // claims based on synthetic record special-member traits are involved.
+  QualType ProbeArgs[] = {Info.Type};
+  QualType ProbeType = Ctx.getFunctionType(Info.Type, ProbeArgs,
+                                           FunctionProtoType::ExtProtoInfo());
+  auto *Proto = dyn_cast<FunctionProtoType>(
+      Ctx.getCanonicalType(ProbeType).getTypePtr());
+  if (!Proto)
+    return false;
+  const CGFunctionInfo &FI = CGM.getTypes().arrangeFreeFunctionType(
+      CanQual<FunctionProtoType>::CreateUnsafe(QualType(Proto, 0)));
+  const ABIArgInfo &Ret = FI.getReturnInfo();
+  if (FI.arguments().size() != 1)
+    return false;
+  const ABIArgInfo &Arg = FI.arguments()[0].info;
+  Result.ResultKind = static_cast<unsigned>(Ret.getKind());
+  Result.ArgumentKind = static_cast<unsigned>(Arg.getKind());
+  if (Ret.canHaveCoerceToType())
+    Result.ResultCoerceType = Ret.getCoerceToType();
+  if (Arg.canHaveCoerceToType())
+    Result.ArgumentCoerceType = Arg.getCoerceToType();
+  return true;
+}
+
+namespace {
+
+bool hasNoNestedManagedCarrierFields(
+    ASTContext &Ctx, QualType T,
+    llvm::SmallPtrSetImpl<const CXXRecordDecl *> &Seen) {
+  if (T.isNull())
+    return false;
+  T = Ctx.getCanonicalType(T);
+  const Type *Ty = T.getTypePtr();
+  if (isa<ObjC3OptionalType>(Ty) || isa<ObjC3ResultType>(Ty) ||
+      Ty->isObjCObjectPointerType() || Ty->isBlockPointerType() ||
+      Ty->isObjCObjectType() || T.getObjCLifetime() != Qualifiers::OCL_None)
+    return false;
+  if (const auto *AT = Ctx.getAsArrayType(T))
+    return isa<ConstantArrayType>(AT) &&
+           hasNoNestedManagedCarrierFields(Ctx, AT->getElementType(), Seen);
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    const RecordDecl *Definition = RD->getDefinition();
+    if (!Definition || !Definition->isCompleteDefinition())
+      return false;
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(Definition)) {
+      if (!Seen.insert(CXX->getCanonicalDecl()).second)
+        return true;
+      for (const CXXBaseSpecifier &Base : CXX->bases())
+        if (!hasNoNestedManagedCarrierFields(Ctx, Base.getType(), Seen))
+          return false;
+    }
+    for (const FieldDecl *Field : Definition->fields())
+      if (!hasNoNestedManagedCarrierFields(Ctx, Field->getType(), Seen))
+        return false;
+    return true;
+  }
+  // Pointer pointees do not form owned subobjects. Qualifiers on the pointer
+  // itself were checked above; ordinary C++ destruction owns pointed-to state.
+  return true;
+}
+
+bool isEligibleCarrierCppLocalArm(ASTContext &Ctx, QualType T) {
+  if (T.isNull())
+    return false;
+  if (T->isVoidType())
+    return true;
+  llvm::SmallPtrSet<const CXXRecordDecl *, 8> Seen;
+  if (!hasNoNestedManagedCarrierFields(Ctx, T, Seen))
+    return false;
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD)) {
+      if (!CXX->isCompleteDefinition())
+        return false;
+      if (!CXX->hasTrivialDestructor()) {
+        const CXXDestructorDecl *Dtor = CXX->getDestructor();
+        // Sema checks destructor access at the carrier declaration. This
+        // qualified lowering slice additionally requires a public destructor.
+        if (!Dtor || Dtor->isDeleted() || Dtor->getAccess() != AS_public)
+          return false;
+      }
+      return true;
+    }
+    return hasOnlyTrivialCallABILeaves(Ctx, T);
+  }
+  return hasOnlyTrivialCallABILeaves(Ctx, T);
+}
+
+bool isNontrivialCXXDestructor(QualType T) {
+  if (T.isNull() || T.isDestructedType() != QualType::DK_cxx_destructor)
+    return false;
+  const CXXRecordDecl *RD = T->getAsCXXRecordDecl();
+  const CXXDestructorDecl *Dtor = RD ? RD->getDestructor() : nullptr;
+  // Sema checks access at the carrier declaration; retain this narrower
+  // public-destructor qualification boundary in CodeGen.
+  return Dtor && !Dtor->isDeleted() && Dtor->getAccess() == AS_public;
+}
+
+} // namespace
+
+bool CodeGen::supportsObjC3CarrierCppLocalLifetime(CodeGenModule &CGM,
+                                                    QualType CarrierType) {
+  ASTContext &Ctx = CGM.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  if (!isa<ObjC3OptionalType>(Canonical) && !isa<ObjC3ResultType>(Canonical))
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return false;
+  return (!Info.ValueField ||
+          isEligibleCarrierCppLocalArm(Ctx, Info.ValueField->getType())) &&
+         (!Info.SuccessField ||
+          isEligibleCarrierCppLocalArm(Ctx, Info.SuccessField->getType())) &&
+         (!Info.ErrorField ||
+          isEligibleCarrierCppLocalArm(Ctx, Info.ErrorField->getType()));
+}
+
+bool CodeGen::hasObjC3CarrierCppLocalDestructor(CodeGenModule &CGM,
+                                                 QualType CarrierType) {
+  ASTContext &Ctx = CGM.getContext();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  return isNontrivialCXXDestructor(
+             Info.ValueField ? Info.ValueField->getType() : QualType()) ||
+         isNontrivialCXXDestructor(
+             Info.SuccessField ? Info.SuccessField->getType() : QualType()) ||
+         isNontrivialCXXDestructor(
+             Info.ErrorField ? Info.ErrorField->getType() : QualType());
+}
+
+bool CodeGen::emitObjC3CarrierDestroyActivePayload(
+    CodeGenFunction &CGF, QualType CarrierType, Address CarrierStorage,
+    bool IsVolatile) {
+  ASTContext &Ctx = CGF.getContext();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const bool IsOptional = isa<ObjC3OptionalType>(Canonical);
+  const bool IsResult = isa<ObjC3ResultType>(Canonical);
+  if ((!IsOptional && !IsResult) ||
+      !supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType))
+    return false;
+
+  QualType ValueType = Info.ValueField ? Info.ValueField->getType() : QualType();
+  QualType SuccessType =
+      Info.SuccessField ? Info.SuccessField->getType() : QualType();
+  QualType ErrorType = Info.ErrorField ? Info.ErrorField->getType() : QualType();
+  const bool DestroysValue = IsOptional && isNontrivialCXXDestructor(ValueType);
+  const bool DestroysSuccess = IsResult && isNontrivialCXXDestructor(SuccessType);
+  const bool DestroysError = IsResult && isNontrivialCXXDestructor(ErrorType);
+  if (!DestroysValue && !DestroysSuccess && !DestroysError)
+    return true;
+
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(CGF, CarrierStorage, CarrierType,
+                                              SourceLocation(), IsVolatile);
+  if (!Tag)
+    return false;
+  auto DestroyArm = [&](ObjC3CarrierPayloadArm Arm, QualType PayloadType) {
+    Address Payload = getObjC3CarrierPayloadAddress(
+        CGF, CarrierStorage, CarrierType, Arm);
+    if (!Payload.isValid())
+      return false;
+    if (IsVolatile)
+      PayloadType = PayloadType.withVolatile();
+    CGF.emitDestroy(Payload, PayloadType,
+                    CGF.getDestroyer(QualType::DK_cxx_destructor),
+                    /*useEHCleanupForArray=*/false);
+    return true;
+  };
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.carrier.dtor.done");
+  if (DestroysValue) {
+    llvm::BasicBlock *Destroy =
+        CGF.createBasicBlock("objc3.carrier.dtor.present");
+    CGF.Builder.CreateCondBr(Tag, Destroy, Done);
+    CGF.EmitBlock(Destroy);
+    if (!DestroyArm(ObjC3CarrierPayloadArm::Value, ValueType))
+      return false;
+    CGF.Builder.CreateBr(Done);
+  } else if (DestroysSuccess && DestroysError) {
+    llvm::BasicBlock *DestroySuccess =
+        CGF.createBasicBlock("objc3.result.dtor.success");
+    llvm::BasicBlock *DestroyError =
+        CGF.createBasicBlock("objc3.result.dtor.error");
+    CGF.Builder.CreateCondBr(Tag, DestroySuccess, DestroyError);
+    CGF.EmitBlock(DestroySuccess);
+    if (!DestroyArm(ObjC3CarrierPayloadArm::Success, SuccessType))
+      return false;
+    CGF.Builder.CreateBr(Done);
+    CGF.EmitBlock(DestroyError);
+    if (!DestroyArm(ObjC3CarrierPayloadArm::Error, ErrorType))
+      return false;
+    CGF.Builder.CreateBr(Done);
+  } else {
+    const bool DestroyOnSuccess = DestroysSuccess;
+    llvm::BasicBlock *Destroy =
+        CGF.createBasicBlock("objc3.carrier.dtor.selected");
+    llvm::Value *ShouldDestroy = DestroyOnSuccess
+                                     ? Tag
+                                     : CGF.Builder.CreateNot(Tag);
+    CGF.Builder.CreateCondBr(ShouldDestroy, Destroy, Done);
+    CGF.EmitBlock(Destroy);
+    if (!DestroyArm(DestroyOnSuccess ? ObjC3CarrierPayloadArm::Success
+                                     : ObjC3CarrierPayloadArm::Error,
+                    DestroyOnSuccess ? SuccessType : ErrorType))
+      return false;
+    CGF.Builder.CreateBr(Done);
+  }
+  CGF.EmitBlock(Done);
+  return true;
+}
+
+bool CodeGen::supportsPlainObjC3CarrierStorageLifetime(CodeGenModule &CGM,
+                                                       QualType CarrierType) {
+  ASTContext &Ctx = CGM.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  if (!isa<ObjC3OptionalType>(Canonical) && !isa<ObjC3ResultType>(Canonical))
+    return false;
+
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return false;
+  auto IsPlainField = [&](FieldDecl *Field) {
+    return !Field || hasOnlyTrivialCallABILeaves(Ctx, Field->getType());
+  };
+  return IsPlainField(Info.ValueField) && IsPlainField(Info.SuccessField) &&
+         IsPlainField(Info.ErrorField);
+}
+
+namespace {
+QualType findCarrierByValue(ASTContext &Ctx, QualType T,
+                            llvm::SmallPtrSetImpl<const Type *> &Seen) {
+  if (T.isNull())
+    return QualType();
+  T = Ctx.getCanonicalType(T);
+  const Type *Ty = T.getTypePtr();
+  if (!Seen.insert(Ty).second)
+    return QualType();
+  if (isa<ObjC3OptionalType>(Ty) || isa<ObjC3ResultType>(Ty))
+    return T;
+  if (const auto *AT = Ctx.getAsArrayType(T))
+    return findCarrierByValue(Ctx, AT->getElementType(), Seen);
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    if (const RecordDecl *Definition = RD->getDefinition()) {
+      if (const auto *CXXRD = dyn_cast<CXXRecordDecl>(Definition))
+        for (const CXXBaseSpecifier &Base : CXXRD->bases())
+          if (QualType Found = findCarrierByValue(Ctx, Base.getType(), Seen);
+              !Found.isNull())
+            return Found;
+      for (const FieldDecl *Field : Definition->fields())
+        if (QualType Found = findCarrierByValue(Ctx, Field->getType(), Seen);
+            !Found.isNull())
+          return Found;
+    }
+  }
+  return QualType();
+}
+} // namespace
+
+static bool supportsQualifiedX64CarrierABI(CodeGenModule &CGM,
+                                           QualType CarrierType) {
+  ASTContext &Ctx = CGM.getContext();
+  const llvm::Triple &Triple = CGM.getTarget().getTriple();
+  const bool Windows = Triple.getVendor() == llvm::Triple::PC &&
+                       Triple.isKnownWindowsMSVCEnvironment() &&
+                       CGM.getTarget().getCXXABI().isMicrosoft();
+  const bool Linux = Triple.isOSLinux() && Triple.isGNUEnvironment() &&
+                     CGM.getTarget().getCXXABI().isItaniumFamily();
+  if ((Ctx.getLangOpts().CPlusPlus && !Linux) ||
+      Triple.getArch() != llvm::Triple::x86_64 || (!Windows && !Linux))
+    return false;
+
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized ||
+      Info.Type.isNull())
+    return false;
+
+  // ABI projection is useful only if both call boundaries can produce the
+  // active-arm snapshot. In particular, ordinary C records containing nested
+  // carriers are not yet supported by the payload-copy helper.
+  if (!supportsObjC3CarrierCopyPayload(CGM, CarrierType))
+    return false;
+
+  auto IsPlainField = [&](FieldDecl *Field) {
+    return !Field || hasOnlyTrivialCallABILeaves(Ctx, Field->getType());
+  };
+  return IsPlainField(Info.ValueField) && IsPlainField(Info.SuccessField) &&
+         IsPlainField(Info.ErrorField);
+}
+
+bool CodeGen::getObjC3CarrierABIProjectionType(CodeGenModule &CGM,
+                                                QualType SourceType,
+                                                QualType &ABIType) {
+  ABIType = SourceType;
+  if (SourceType.isNull())
+    return false;
+  ASTContext &Ctx = CGM.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(SourceType).getTypePtr();
+  if (!isa<ObjC3OptionalType>(Canonical) && !isa<ObjC3ResultType>(Canonical))
+    return false;
+  if (supportsObjC3CarrierARCCallABI(CGM, SourceType)) {
+    auto Info = Ctx.getObjC3CarrierRepresentationType(SourceType);
+    ABIType = Info.Type;
+    CGM.getTypes().registerObjC3ARCCarrierABIRecord(ABIType);
+    return true;
+  }
+  if (!supportsQualifiedX64CarrierABI(CGM, SourceType))
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(SourceType);
+  ABIType = Ctx.getQualifiedType(Info.Type, SourceType.getQualifiers());
+  return true;
+}
+
+bool CodeGen::emitObjC3CarrierABISnapshot(CodeGenFunction &CGF,
+                                          QualType CarrierType,
+                                          Address Destination,
+                                          Address Source,
+                                          bool DestinationIsVolatile,
+                                          bool SourceIsVolatile,
+                                          SourceLocation Loc) {
+  CodeGenModule &CGM = CGF.CGM;
+  QualType ABIType;
+  if (!getObjC3CarrierABIProjectionType(CGM, CarrierType, ABIType) ||
+      !supportsObjC3CarrierCopyPayload(CGM, CarrierType) ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source))
+    return false;
+
+  llvm::TypeSize Size = CGM.getDataLayout().getTypeAllocSize(
+      Destination.getElementType());
+  if (Size.isScalable())
+    return false;
+
+  // The target ABI coercion may read every byte of its native record. Clear
+  // only the fresh ABI destination so inactive union arms and padding are
+  // initialized without reading any inactive source bytes.
+  CGF.Builder.CreateMemSet(Destination, CGF.Builder.getInt8(0),
+                           CGF.Builder.getInt64(Size.getFixedValue()),
+                           DestinationIsVolatile);
+  return emitObjC3CarrierCopyPayload(
+      CGF, CarrierType, Destination, Source, DestinationIsVolatile,
+      SourceIsVolatile, /*IsInitialization=*/true, Loc);
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3CarrierFreeFunctionABI(
+    CodeGenModule &CGM, QualType FunctionType, SourceLocation Loc) {
+  ASTContext &Ctx = CGM.getContext();
+  FunctionType = Ctx.getCanonicalType(FunctionType);
+  const auto *FPT = dyn_cast<FunctionProtoType>(FunctionType.getTypePtr());
+  auto Diagnose = [&](QualType Carrier) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGM, Loc, Carrier,
+                                             "by-value call ABI");
+    return true;
+  };
+
+  if (!FPT || FPT->getCallConv() != CC_C || FPT->isVariadic()) {
+    QualType Carrier;
+    llvm::SmallPtrSet<const Type *, 16> Seen;
+    if (FPT) {
+      Carrier = findCarrierByValue(Ctx, FPT->getReturnType(), Seen);
+      for (QualType Param : FPT->param_types())
+        if (Carrier.isNull()) {
+          Seen.clear();
+          Carrier = findCarrierByValue(Ctx, Param, Seen);
+        }
+    } else if (const auto *FNPT =
+                   dyn_cast<FunctionNoProtoType>(FunctionType.getTypePtr())) {
+      Carrier = findCarrierByValue(Ctx, FNPT->getReturnType(), Seen);
+    }
+    return !Carrier.isNull() && Diagnose(Carrier);
+  }
+
+  auto CheckType = [&](QualType T) {
+    if (FPT->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::None &&
+        !FPT->getObjC3FunctionEffects().Async &&
+        supportsObjC3ManagedRecordCallABI(CGM, T)) return false;
+    llvm::SmallPtrSet<const Type *, 16> Seen;
+    QualType Found = findCarrierByValue(Ctx, T, Seen);
+    if (Found.isNull())
+      return false;
+
+    QualType Projection;
+    if (getObjC3CarrierABIProjectionType(CGM, T, Projection))
+      return false;
+
+    // A carrier under an ordinary record/array has no source-to-physical
+    // projection in this packet. Only a direct Optional/Result is admitted.
+    const Type *Canonical = Ctx.getCanonicalType(T).getTypePtr();
+    if (isa<ObjC3OptionalType>(Canonical) || isa<ObjC3ResultType>(Canonical))
+      return Diagnose(T);
+    return Diagnose(Found);
+  };
+
+  if (CheckType(FPT->getReturnType()))
+    return true;
+  for (QualType Param : FPT->param_types())
+    if (CheckType(Param))
+      return true;
+  return false;
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3CarrierVariadicArgument(
+    CodeGenModule &CGM, QualType ArgumentType, SourceLocation Loc) {
+  llvm::SmallPtrSet<const Type *, 16> Seen;
+  QualType Carrier = findCarrierByValue(CGM.getContext(), ArgumentType, Seen);
+  if (Carrier.isNull())
+    return false;
+  diagnoseUnsupportedObjC3CarrierOperation(CGM, Loc, Carrier,
+                                           "by-value call ABI");
+  return true;
+}
+
+bool CodeGen::diagnoseUnsupportedObjC3CarrierByValue(CodeGenModule &CGM,
+                                                     QualType FunctionType,
+                                                     SourceLocation Loc) {
+  ASTContext &Ctx = CGM.getContext();
+  FunctionType = Ctx.getCanonicalType(FunctionType);
+  auto Search = [&](QualType T) {
+    llvm::SmallPtrSet<const Type *, 16> Seen;
+    return findCarrierByValue(Ctx, T, Seen);
+  };
+
+  QualType Carrier;
+  if (const auto *FPT =
+          dyn_cast<FunctionProtoType>(FunctionType.getTypePtr())) {
+    Carrier = Search(FPT->getReturnType());
+    for (QualType Param : FPT->param_types())
+      if (Carrier.isNull())
+        Carrier = Search(Param);
+  } else if (const auto *FT =
+                 dyn_cast<FunctionNoProtoType>(FunctionType.getTypePtr())) {
+    Carrier = Search(FT->getReturnType());
+  }
+  if (Carrier.isNull())
+    return false;
+
+  diagnoseUnsupportedObjC3CarrierOperation(CGM, Loc, Carrier,
+                                           "by-value call ABI");
+  return true;
+}
+
+void CodeGen::diagnoseUnsupportedObjC3CarrierOperation(CodeGenModule &CGM,
+                                                       SourceLocation Loc,
+                                                       QualType CarrierType,
+                                                       const char *Operation) {
+  unsigned DiagID = CGM.getDiags().getCustomDiagID(
+      DiagnosticsEngine::Error,
+      "ObjC3 carrier operation '%0' for type %1 has no qualified lowering: "
+      "payload ownership or target call-ABI facts are unresolved");
+  CGM.getDiags().Report(Loc, DiagID) << Operation << CarrierType;
+}
+
+bool CodeGen::emitObjC3CarrierTransferAggregateExpr(
+    CodeGenFunction &CGF, const ObjC3CarrierTransferExpr &E,
+    Address Destination, bool DestinationIsIgnored,
+    bool DestinationIsVolatile, bool IsLocalCarrierInitialization) {
+  const QualType CarrierType = E.getCarrierType();
+  auto Fail = [&]() {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        E.isMove() ? "carrier move construction" : "carrier copy construction");
+    // This expression has no generic aggregate fallback. Sema normally
+    // guarantees the source and recipes; this boundary remains defensive.
+    return true;
+  };
+
+  ASTContext &Ctx = CGF.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const bool IsOptional = isa<ObjC3OptionalType>(Canonical);
+  const bool IsResult = isa<ObjC3ResultType>(Canonical);
+  if ((!IsOptional && !IsResult) || DestinationIsIgnored ||
+      DestinationIsVolatile || !IsLocalCarrierInitialization ||
+      !E.getSource() || E.getSource()->getType().isVolatileQualified() ||
+      (!supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType) &&
+       !supportsObjC3CarrierARCLocalLifetime(CGF.CGM, CarrierType)))
+    return Fail();
+
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || Destination.isSigned() ||
+      Destination.getElementType() != Layout.StorageType)
+    return Fail();
+
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  struct ArmPlan {
+    FieldDecl *Field;
+    ObjC3CarrierPayloadArm Arm;
+    OpaqueValueExpr *Source;
+    Expr *Initializer;
+  };
+  ArmPlan Value{Info.ValueField, ObjC3CarrierPayloadArm::Value,
+                E.getValueSource(), E.getValueInit()};
+  ArmPlan Success{Info.SuccessField, ObjC3CarrierPayloadArm::Success,
+                  E.getSuccessSource(), E.getSuccessInit()};
+  ArmPlan Error{Info.ErrorField, ObjC3CarrierPayloadArm::Error,
+                E.getErrorSource(), E.getErrorInit()};
+
+  auto IsValidArm = [&](const ArmPlan &Plan) {
+    if (!Plan.Field)
+      return !Plan.Source && !Plan.Initializer;
+    if (Plan.Field->getType()->isVoidType())
+      return !Plan.Source && !Plan.Initializer;
+    if (!Plan.Source || !Plan.Initializer ||
+        Plan.Source->getType().isNull() ||
+        Plan.Source->getValueKind() !=
+            (E.isMove() ? VK_XValue : VK_LValue))
+      return false;
+    QualType ExpectedSource = Ctx.getQualifiedType(
+        Plan.Field->getType(), E.getSource()->getType().getQualifiers());
+    const bool IsARCPointer = Plan.Field->getType()->isObjCObjectPointerType() ||
+                              Plan.Field->getType()->isBlockPointerType();
+    const bool IsNestedCarrier = isa<ObjC3OptionalType, ObjC3ResultType>(
+        Plan.Field->getType().getCanonicalType().getTypePtr());
+    return Ctx.hasSameType(Plan.Source->getType(), ExpectedSource) &&
+           (IsARCPointer || IsNestedCarrier
+                ? Ctx.hasSameUnqualifiedType(Plan.Initializer->getType(),
+                                             Plan.Field->getType())
+                : Ctx.hasSameType(Plan.Initializer->getType(),
+                                  Plan.Field->getType()));
+  };
+  if (!IsValidArm(Value) || !IsValidArm(Success) || !IsValidArm(Error))
+    return Fail();
+
+  // Evaluate the source glvalue once before reading its tag. The payload
+  // leaves are mapped only inside the selected branch below.
+  LValue SourceLV = CGF.EmitLValue(E.getSource());
+  Address SourceStorage = SourceLV.getAddress();
+  if (!SourceStorage.isValid() || SourceStorage.isSigned() ||
+      SourceStorage.getElementType() != Layout.StorageType)
+    return Fail();
+  Address SourceTag =
+      getObjC3CarrierTagAddress(CGF, SourceStorage, CarrierType);
+  Address DestinationTag =
+      getObjC3CarrierTagAddress(CGF, Destination, CarrierType);
+  if (!SourceTag.isValid() || !DestinationTag.isValid() ||
+      SourceTag.isSigned() || DestinationTag.isSigned())
+    return Fail();
+
+  auto ValidateStorage = [&](const ArmPlan &Plan) {
+    if (!Plan.Field || Plan.Field->getType()->isVoidType())
+      return true;
+    Address Src = getObjC3CarrierPayloadAddress(
+        CGF, SourceStorage, CarrierType, Plan.Arm);
+    Address Dst = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, Plan.Arm);
+    QualType PayloadType = Plan.Field->getType();
+    return Src.isValid() && Dst.isValid() && !Src.isSigned() &&
+           !Dst.isSigned() &&
+           Src.getElementType() == CGF.ConvertTypeForMem(PayloadType) &&
+           Dst.getElementType() == CGF.ConvertTypeForMem(PayloadType);
+  };
+  if ((IsOptional && !ValidateStorage(Value)) ||
+      (IsResult && (!ValidateStorage(Success) || !ValidateStorage(Error))))
+    return Fail();
+
+  auto EmitArm = [&](const ArmPlan &Plan) {
+    if (!Plan.Field || Plan.Field->getType()->isVoidType())
+      return true;
+    Address Src = getObjC3CarrierPayloadAddress(
+        CGF, SourceStorage, CarrierType, Plan.Arm);
+    Address Dst = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, Plan.Arm);
+    LValue SourcePayload = CGF.MakeAddrLValue(Src, Plan.Source->getType());
+    CodeGenFunction::OpaqueValueMapping Bind(CGF, Plan.Source, SourcePayload);
+    QualType PayloadType = Plan.Field->getType();
+    if (isa<ObjC3OptionalType, ObjC3ResultType>(PayloadType.getCanonicalType().getTypePtr())) {
+      emitObjC3CarrierARCValueInit(CGF, Plan.Initializer, Dst);
+    } else if (PayloadType->isObjCObjectPointerType() || PayloadType->isBlockPointerType()) {
+      // Initialization is not an ARC assignment into an existing slot. Native
+      // scalar initialization retains strong objects, copies Blocks, and
+      // initializes/copies/moves weak storage without reading inactive bytes.
+      CGF.EmitScalarInit(Plan.Initializer, /*D=*/nullptr,
+                         CGF.MakeAddrLValue(Dst, PayloadType),
+                         /*capturedByInit=*/false);
+    } else {
+      CGF.EmitAnyExprToMem(Plan.Initializer, Dst,
+                           PayloadType.getQualifiers(), /*IsInit=*/true);
+    }
+    return true;
+  };
+
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, SourceStorage, CarrierType, E.getKeywordLoc(),
+      E.getSource()->getType().isVolatileQualified());
+  if (!Tag)
+    return Fail();
+
+  llvm::BasicBlock *Active = CGF.createBasicBlock("objc3.transfer.active");
+  llvm::BasicBlock *Inactive = CGF.createBasicBlock("objc3.transfer.inactive");
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.transfer.done");
+  CGF.Builder.CreateCondBr(Tag, Active, Inactive);
+
+  CGF.EmitBlock(Active);
+  if (IsOptional) {
+    EmitArm(Value);
+    if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                 CGF.Builder.getInt1(true), true,
+                                 DestinationIsVolatile))
+      return Fail();
+  } else {
+    EmitArm(Success);
+    if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                 CGF.Builder.getInt1(true), true,
+                                 DestinationIsVolatile))
+      return Fail();
+  }
+  CGF.Builder.CreateBr(Done);
+
+  CGF.EmitBlock(Inactive);
+  if (IsResult)
+    EmitArm(Error);
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                               CGF.Builder.getInt1(false), true,
+                               DestinationIsVolatile))
+    return Fail();
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+  return true;
+}
diff --git a/clang/lib/CodeGen/CGObjC3Carriers.h b/clang/lib/CodeGen/CGObjC3Carriers.h
new file mode 100644
index 000000000..c41f46904
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Carriers.h
@@ -0,0 +1,200 @@
+//===--- CGObjC3Carriers.h - ObjC3 carrier CodeGen adapter ------*- C++ -*-===//
+//
+// Staged adapter for canonical ObjC3 Optional/Result storage.  This header is
+// intentionally private to Clang CodeGen; it does not declare a source ABI.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3CARRIERS_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3CARRIERS_H
+
+#include "Address.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/Basic/LLVM.h"
+
+namespace llvm {
+class StructType;
+class Type;
+} // namespace llvm
+
+namespace clang {
+class QualType;
+class SourceLocation;
+class ObjC3CarrierTransferExpr;
+
+class ObjC3OptionalExpr;
+class Expr;
+namespace CodeGen {
+class CodeGenModule;
+class CodeGenFunction;
+
+enum class ObjC3CarrierPayloadArm : unsigned char { Value, Success, Error };
+
+/// Physical memory type and tag field for the AST-owned hidden carrier record.
+/// A payload can have storage even when an empty C++ field is omitted from the
+/// physical LLVM record. Payload addresses use AST field offsets instead.
+struct ObjC3CarrierStorageLayout {
+  llvm::StructType *StorageType = nullptr;
+  unsigned TagField = ~0U;
+  bool HasPayloadStorage = false;
+
+  bool hasPayloadStorage() const { return HasPayloadStorage; }
+};
+
+/// Translate only the representation already owned by ASTContext. This uses
+/// Clang's target record converter and field maps, preserving target padding,
+/// alignment, zero-sized/void-arm tags, and union offsets.
+bool getObjC3CarrierStorageLayout(CodeGenModule &CGM, QualType CarrierType,
+                                  ObjC3CarrierStorageLayout &Result);
+
+/// Field-address and discriminant hooks for address-backed carrier values.
+/// PayloadAddress returns invalid for a void/unavailable arm. The caller must
+/// test the discriminant before reading an arm and must initialize the active
+/// arm before storing a present tag.
+Address getObjC3CarrierTagAddress(CodeGenFunction &CGF, Address CarrierStorage,
+                                  QualType CarrierType);
+Address getObjC3CarrierPayloadAddress(CodeGenFunction &CGF,
+                                      Address CarrierStorage,
+                                      QualType CarrierType,
+                                      ObjC3CarrierPayloadArm Arm);
+llvm::Value *emitObjC3CarrierLoadTag(CodeGenFunction &CGF,
+                                     Address CarrierStorage,
+                                     QualType CarrierType, SourceLocation Loc,
+                                     bool IsVolatile = false);
+bool emitObjC3CarrierStoreTag(CodeGenFunction &CGF, Address CarrierStorage,
+                              QualType CarrierType, llvm::Value *TagValue,
+                              bool IsInitialization,
+                              bool IsVolatile = false);
+
+/// Emit the first qualified Optional expression subset. Aggregate construction
+/// accepts only payloads whose storage/lifetime facts are already proven plain;
+/// the caller must not fall back to an ordinary aggregate copy on false.
+bool emitObjC3OptionalAggregateExpr(CodeGenFunction &CGF,
+                                    const ObjC3OptionalExpr &E,
+                                    Address Destination,
+                                    bool DestinationIsIgnored,
+                                    bool DestinationIsVolatile,
+                                    bool IsLocalCarrierInitialization = false);
+
+/// Evaluate HasValue's carrier operand once, then read only the explicit tag.
+/// Unsupported payload ownership is diagnosed before any generic copy path.
+llvm::Value *emitObjC3OptionalHasValueExpr(CodeGenFunction &CGF,
+                                           const ObjC3OptionalExpr &E);
+
+/// Copy an initialized Optional using only its discriminant and active
+/// payload. Sema must already have admitted this copy operation. This helper
+/// performs no move, destruction, or by-value call-ABI adaptation. The caller
+/// must not fall back to whole-carrier copying when it returns true.
+bool emitObjC3OptionalCopy(CodeGenFunction &CGF, QualType CarrierType,
+                           Address Destination, Address Source,
+                           bool DestinationIsVolatile,
+                           bool SourceIsVolatile, bool IsInitialization,
+                           SourceLocation Loc);
+
+/// Shared private payload-copy checks used by Optional and Result transfer.
+/// Nested carriers recurse through the corresponding copy helper; aggregates
+/// containing carrier subobjects remain unsupported by this packet.
+bool supportsObjC3CarrierCopyPayload(CodeGenModule &CGM, QualType PayloadType,
+                                     unsigned Depth = 0);
+bool validateObjC3CarrierCopyStorage(CodeGenFunction &CGF,
+                                     QualType CarrierType,
+                                     Address Destination, Address Source,
+                                     unsigned Depth = 0);
+bool emitObjC3CarrierCopyPayload(CodeGenFunction &CGF, QualType PayloadType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile,
+                                 bool IsInitialization, SourceLocation Loc,
+                                 unsigned Depth = 0);
+
+/// Initialize a direct local carrier from a source glvalue. Sema must have
+/// resolved each active payload arm through ordinary InitializeMember copy or
+/// move initialization. The helper evaluates Source exactly once, branches on
+/// its tag, initializes only the selected payload, then writes the destination
+/// tag. It never disengages a moved-from source.
+bool emitObjC3CarrierTransferAggregateExpr(
+    CodeGenFunction &CGF, const ObjC3CarrierTransferExpr &E,
+    Address Destination, bool DestinationIsIgnored,
+    bool DestinationIsVolatile, bool IsLocalCarrierInitialization);
+
+/// Compute the target's ordinary C argument and result classifications for a
+/// one-argument probe whose argument and result are the carrier record. This
+/// is deliberately available only for recursively trivial, non-ARC payloads
+/// without nested carriers. It is diagnostic/probe data only; function
+/// signature normalization and source parameter/result adapters are not wired.
+struct ObjC3CarrierCallABI {
+  unsigned ResultKind = 0;
+  unsigned ArgumentKind = 0;
+  llvm::Type *ResultCoerceType = nullptr;
+  llvm::Type *ArgumentCoerceType = nullptr;
+};
+
+bool classifyObjC3CarrierCallABI(CodeGenModule &CGM, QualType CarrierType,
+                                 ObjC3CarrierCallABI &Result);
+
+/// Project a plain Optional/Result source type to its exact AST-owned native
+/// record for the admitted Windows x86_64 C calling convention. Returns true
+/// only when SourceType is a carrier and the complete payload tree is eligible.
+/// The returned QualType is an ABI classification type, not a source type.
+bool getObjC3CarrierABIProjectionType(CodeGenModule &CGM, QualType SourceType,
+                                      QualType &ABIType);
+
+/// Create a zero-initialized ABI snapshot of a carrier, then copy only its
+/// discriminant and active payload. Destination must be fresh, disjoint
+/// storage with the AST-owned representation type; Source remains untouched.
+/// This is for native ABI coercion only and does not imply carrier ownership
+/// semantics beyond the copy operation admitted by Sema.
+bool emitObjC3CarrierABISnapshot(CodeGenFunction &CGF, QualType CarrierType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile, SourceLocation Loc);
+
+/// Diagnose by-value carriers in an ordinary free-function type unless every
+/// direct carrier parameter/result is eligible for the narrow Windows x64 C ABI
+/// projection. Carriers nested in an ordinary aggregate remain unsupported.
+bool diagnoseUnsupportedObjC3CarrierFreeFunctionABI(
+    CodeGenModule &CGM, QualType FunctionType, SourceLocation Loc);
+
+/// Variadic actual arguments have no formal source type to project. Reject a
+/// carrier or aggregate containing one before CodeGen arranges the ellipsis.
+bool diagnoseUnsupportedObjC3CarrierVariadicArgument(
+    CodeGenModule &CGM, QualType ArgumentType, SourceLocation Loc);
+
+/// True only when the carrier can be materialized as plain local storage with
+/// no C++ special-member or ARC lifetime operation. This does not qualify
+/// initialization, copy, move, destruction, or call-ABI lowering.
+bool supportsPlainObjC3CarrierStorageLifetime(CodeGenModule &CGM,
+                                              QualType CarrierType);
+
+/// True for materialized direct Optional/Result storage whose selected payload
+/// can use ordinary C++ construction/destruction. Nested carriers, ARC-bearing
+/// subobjects, nontrivial C records, and incomplete payloads remain rejected.
+bool supportsObjC3CarrierCppLocalLifetime(CodeGenModule &CGM,
+                                           QualType CarrierType);
+bool hasObjC3CarrierCppLocalDestructor(CodeGenModule &CGM,
+                                        QualType CarrierType);
+/// Destroy only the active C++ payload arm using Clang's ordinary destroyer.
+/// The caller must have registered a NormalAndEH cleanup after successful
+/// aggregate initialization; the discriminant is never read earlier.
+bool emitObjC3CarrierDestroyActivePayload(CodeGenFunction &CGF,
+                                          QualType CarrierType,
+                                          Address CarrierStorage,
+                                          bool IsVolatile);
+
+/// Diagnose a function type that passes a carrier itself, or a complete
+/// aggregate containing a carrier, by value. Pointer pointees are not walked.
+bool diagnoseUnsupportedObjC3CarrierByValue(CodeGenModule &CGM,
+                                            QualType FunctionType,
+                                            SourceLocation Loc);
+
+/// Emit a precise error before ordinary call lowering can silently apply a
+/// wrong ABI to an unsupported payload operation.
+void diagnoseUnsupportedObjC3CarrierOperation(CodeGenModule &CGM,
+                                              SourceLocation Loc,
+                                              QualType CarrierType,
+                                              const char *Operation);
+
+} // namespace CodeGen
+} // namespace clang
+
+#endif
diff --git a/clang/lib/CodeGen/CGObjC3ErrorHandlers.cpp b/clang/lib/CodeGen/CGObjC3ErrorHandlers.cpp
new file mode 100644
index 000000000..e97620d7a
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ErrorHandlers.cpp
@@ -0,0 +1,224 @@
+//===--- CGObjC3ErrorHandlers.cpp - ObjC3 error handlers
+//--------------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3ErrorHandlers.h"
+#include "CGObjC3TypedErrors.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjCRuntime.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/Stmt.h"
+#include "clang/Basic/TargetInfo.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Intrinsics.h"
+#include "llvm/Support/SaveAndRestore.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace clang::CodeGen {
+struct ObjC3ErrorHandler {
+  Address ErrorStorage;
+  CodeGenFunction::JumpDest Dispatch;
+};
+} // namespace clang::CodeGen
+
+Address CodeGen::getObjC3ErrorDestinationStorage(CodeGenFunction &CGF) {
+  if (auto *Handler = CGF.ObjC3ActiveErrorHandler)
+    return Handler->ErrorStorage;
+  return CGF.ObjC3PendingErrorStorage;
+}
+
+void CodeGen::emitObjC3ErrorTransfer(CodeGenFunction &CGF) {
+  if (auto *Handler = CGF.ObjC3ActiveErrorHandler) {
+    CGF.EmitBranchThroughCleanup(Handler->Dispatch);
+    return;
+  }
+  if (!CGF.ObjC3PendingErrorStorage.isValid()) {
+    // Sema proves exhaustiveness from the observed static effects. A payload
+    // forged with an unsafe object cast can still fail a runtime type test.
+    CGF.EmitTrapCall(llvm::Intrinsic::trap);
+    CGF.Builder.CreateUnreachable();
+    CGF.Builder.ClearInsertionPoint();
+    return;
+  }
+  if (isObjC3AsyncThrowingFunction(CGF)) {
+    QualType ErrorType, ParameterType;
+    getObjC3ErrorOutTypes(CGF.CGM, ErrorType, ParameterType);
+    CGF.EmitObjC3AsyncErrorReturn(takeOwnedObjC3Error(
+        CGF, CGF.ObjC3PendingErrorStorage, ErrorType));
+    return;
+  }
+  if (!CGF.FnRetTy->isVoidType() && !emitObjC3CarrierARCErrorReturn(CGF))
+    CGF.Builder.CreateStore(
+        llvm::Constant::getNullValue(CGF.ConvertType(CGF.FnRetTy)),
+        CGF.ReturnValue);
+  CGF.EmitBranchThroughCleanup(CGF.ReturnBlock);
+}
+
+namespace {
+llvm::Value *emitObjectClass(CodeGenFunction &CGF, llvm::Value *Object) {
+  auto *Type = llvm::FunctionType::get(CGF.Int8PtrTy, {CGF.Int8PtrTy}, false);
+  return CGF.EmitNounwindRuntimeCall(
+      CGF.CGM.CreateRuntimeFunction(Type, "object_getClass"), {Object},
+      "objc3.error.class");
+}
+
+llvm::Value *emitClassMatch(CodeGenFunction &CGF, llvm::Value *ObjectClass,
+                            ObjCInterfaceDecl *Interface) {
+  llvm::Value *Expected = CGF.CGM.getObjCRuntime().GetClass(CGF, Interface);
+  auto *Entry = CGF.Builder.GetInsertBlock();
+  auto *Loop = CGF.createBasicBlock("objc3.catch.class.test");
+  auto *Compare = CGF.createBasicBlock("objc3.catch.class.compare");
+  auto *Next = CGF.createBasicBlock("objc3.catch.class.next");
+  auto *Done = CGF.createBasicBlock("objc3.catch.class.done");
+  CGF.Builder.CreateBr(Loop);
+  CGF.EmitBlock(Loop);
+  auto *Class = CGF.Builder.CreatePHI(CGF.Int8PtrTy, 2, "objc3.catch.class");
+  Class->addIncoming(ObjectClass, Entry);
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Class), Compare, Done);
+  CGF.EmitBlock(Compare);
+  llvm::Value *Matches = CGF.Builder.CreateICmpEQ(Class, Expected);
+  CGF.Builder.CreateCondBr(Matches, Done, Next);
+  CGF.EmitBlock(Next);
+  auto *Type = llvm::FunctionType::get(CGF.Int8PtrTy, {CGF.Int8PtrTy}, false);
+  llvm::Value *Super = CGF.EmitNounwindRuntimeCall(
+      CGF.CGM.CreateRuntimeFunction(Type, "class_getSuperclass"), {Class});
+  Class->addIncoming(Super, CGF.Builder.GetInsertBlock());
+  CGF.Builder.CreateBr(Loop);
+  CGF.EmitBlock(Done);
+  auto *Result = CGF.Builder.CreatePHI(CGF.Builder.getInt1Ty(), 2,
+                                       "objc3.catch.class.matches");
+  Result->addIncoming(CGF.Builder.getFalse(), Loop);
+  Result->addIncoming(CGF.Builder.getTrue(), Compare);
+  return Result;
+}
+
+llvm::Value *emitProtocolMatch(CodeGenFunction &CGF, llvm::Value *ObjectClass,
+                               ObjCProtocolDecl *Protocol) {
+  llvm::Value *Reference =
+      CGF.CGM.getObjCRuntime().GenerateProtocolRef(CGF, Protocol);
+  // libobjc2 uses int BOOL on Windows and byte BOOL on Unix. A parsed runtime
+  // header is authoritative when present; otherwise use the selected runtime
+  // and target. Never assume a C++ i1 return for a runtime C BOOL function.
+  auto &Ctx = CGF.getContext();
+  llvm::Type *BoolType =
+      Ctx.getBOOLDecl() ? CGF.ConvertType(Ctx.getBOOLType())
+                        : (CGF.CGM.getTarget().getTriple().isOSWindows() &&
+                                   CGF.getLangOpts().ObjCRuntime.isGNUFamily()
+                               ? CGF.Int32Ty
+                               : CGF.Int8Ty);
+  auto *Type =
+      llvm::FunctionType::get(BoolType, {CGF.Int8PtrTy, CGF.Int8PtrTy}, false);
+  llvm::Value *Matches = CGF.EmitNounwindRuntimeCall(
+      CGF.CGM.CreateRuntimeFunction(Type, "class_conformsToProtocol"),
+      {ObjectClass, Reference}, "objc3.catch.protocol");
+  return CGF.Builder.CreateIsNotNull(Matches, "objc3.catch.protocol.matches");
+}
+
+llvm::Value *emitPatternMatch(CodeGenFunction &CGF, llvm::Value *Error,
+                              const ObjC3CatchStmt &Clause) {
+  if (Clause.isCatchAll())
+    return CGF.Builder.getTrue();
+  const auto *Pointer =
+      Clause.getCatchTypeInfo()->getType()->getAs<ObjCObjectPointerType>();
+  // A bridge to id<Error> is guaranteed by the admitted error transport. It
+  // also includes Foundation's standard NSError bridge on older SDKs.
+  if (Pointer->isObjCQualifiedIdType() && Pointer->getNumProtocols() == 1 &&
+      (*Pointer->qual_begin())->getName() == "Error")
+    return CGF.Builder.getTrue();
+
+  llvm::Value *Class = emitObjectClass(CGF, Error);
+  llvm::Value *Matches = CGF.Builder.getTrue();
+  if (ObjCInterfaceDecl *Interface = Pointer->getInterfaceDecl())
+    Matches = emitClassMatch(CGF, Class, Interface);
+  for (ObjCProtocolDecl *Protocol : Pointer->quals())
+    Matches =
+        CGF.Builder.CreateAnd(Matches, emitProtocolMatch(CGF, Class, Protocol));
+  return Matches;
+}
+
+void emitCatchBody(CodeGenFunction &CGF, const ObjC3CatchStmt &Clause,
+                   llvm::Value *Error) {
+  CodeGenFunction::RunCleanupsScope Cleanups(CGF);
+  if (DeclStmt *Binding = Clause.getBindingDeclStmt()) {
+    auto *Variable = cast<VarDecl>(Binding->getSingleDecl());
+    auto Emission = CGF.EmitAutoVarAlloca(*Variable);
+    QualType ValueType =
+        CGF.getContext().getUnqualifiedObjCPointerType(Variable->getType());
+    OpaqueValueExpr Value(Clause.getCatchLoc(), ValueType, VK_PRValue);
+    CodeGenFunction::OpaqueValueMapping Mapping(CGF, &Value,
+                                                RValue::get(Error));
+    CGF.EmitScalarInit(
+        &Value, Variable,
+        CGF.MakeAddrLValue(Emission.getObjectAddress(CGF), Variable->getType()),
+        false);
+    CGF.EmitAutoVarCleanups(Emission);
+  }
+  CGF.EmitStmt(Clause.getHandlerBody());
+}
+} // namespace
+
+bool CodeGen::emitObjC3DoCatchStmt(CodeGenFunction &CGF,
+                                   const ObjC3DoCatchStmt &S) {
+  QualType ErrorType, ParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorType, ParameterType)) {
+    CGF.ErrorUnsupported(&S, "Slop typed-error handler ABI");
+    return false;
+  }
+  for (unsigned I = 0; I != S.getNumCatchClauses(); ++I) {
+    auto *Clause = S.getCatchClause(I);
+    if (!Clause->isCatchAll() &&
+        !isObjC3ErrorObjectType(CGF.CGM,
+                                Clause->getCatchTypeInfo()->getType())) {
+      CGF.ErrorUnsupported(&S, "non-object typed-error handler ABI");
+      return false;
+    }
+  }
+
+  CodeGenFunction::RunCleanupsScope HandlerCleanups(CGF);
+  QualType OwnedType = getObjC3OwnedErrorType(CGF, ErrorType);
+  Address Storage = CGF.CreateMemTemp(OwnedType, "objc3.catch.error");
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(OwnedType)),
+      CGF.MakeAddrLValue(Storage, OwnedType), true);
+  CGF.pushDestroy(NormalAndEHCleanup, Storage, OwnedType,
+                  CodeGenFunction::destroyARCStrongPrecise, false);
+  ObjC3ErrorHandler Handler{
+      Storage, CGF.getJumpDestInCurrentScope("objc3.catch.dispatch")};
+  auto *Done = CGF.createBasicBlock("objc3.catch.done");
+  {
+    llvm::SaveAndRestore<ObjC3ErrorHandler *> Active(
+        CGF.ObjC3ActiveErrorHandler, &Handler);
+    CGF.EmitStmt(S.getBody());
+  }
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Handler.Dispatch.getBlock());
+  llvm::Value *Error = CGF.EmitLoadOfScalar(
+      CGF.MakeAddrLValue(Storage, OwnedType), S.getDoLoc());
+  for (unsigned I = 0; I != S.getNumCatchClauses(); ++I) {
+    auto *Clause = S.getCatchClause(I);
+    llvm::Value *Matches = emitPatternMatch(CGF, Error, *Clause);
+    auto *Catch = CGF.createBasicBlock("objc3.catch.body");
+    auto *Next = CGF.createBasicBlock("objc3.catch.next");
+    CGF.Builder.CreateCondBr(Matches, Catch, Next);
+    CGF.EmitBlock(Catch);
+    // This handler is no longer active. Errors raised by a catch body go to
+    // an enclosing handler or the callable, never to a sibling clause.
+    emitCatchBody(CGF, *Clause, Error);
+    CGF.EmitBranch(Done);
+    CGF.EmitBlock(Next);
+  }
+
+  Address Outer = getObjC3ErrorDestinationStorage(CGF);
+  if (Outer.isValid())
+    storeOwnedObjC3Error(
+        CGF, Outer, takeOwnedObjC3Error(CGF, Storage, ErrorType), ErrorType);
+  emitObjC3ErrorTransfer(CGF);
+  CGF.EmitBlock(Done);
+  return true;
+}
diff --git a/clang/lib/CodeGen/CGObjC3ErrorHandlers.h b/clang/lib/CodeGen/CGObjC3ErrorHandlers.h
new file mode 100644
index 000000000..fbe5ef7b7
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ErrorHandlers.h
@@ -0,0 +1,20 @@
+//===--- CGObjC3ErrorHandlers.h - ObjC3 error handlers ------------*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3ERRORHANDLERS_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3ERRORHANDLERS_H
+
+namespace clang {
+class ObjC3DoCatchStmt;
+namespace CodeGen {
+class Address;
+class CodeGenFunction;
+
+Address getObjC3ErrorDestinationStorage(CodeGenFunction &CGF);
+void emitObjC3ErrorTransfer(CodeGenFunction &CGF);
+bool emitObjC3DoCatchStmt(CodeGenFunction &CGF, const ObjC3DoCatchStmt &S);
+
+} // namespace CodeGen
+} // namespace clang
+#endif
