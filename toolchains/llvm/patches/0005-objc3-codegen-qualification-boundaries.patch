+// RUN: %clang_cc1 -triple x86_64-pc-windows-msvc -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -std=c++20 -emit-llvm -o - %s | FileCheck %s
+
+using Maybe = __objc3_optional(int);
+extern "C" void borrow(Maybe &value);
+extern "C" void observe(const Maybe &value);
+extern "C" void consume_reference(Maybe &&value);
+
+extern "C" void reference_calls(Maybe *value) {
+  borrow(*value);
+  observe(*value);
+  consume_reference(static_cast<Maybe &&>(*value));
+}
+
+// CHECK-LABEL: define{{.*}} @reference_calls
+// CHECK: call void @borrow(ptr{{.*}})
+// CHECK: call void @observe(ptr{{.*}})
+// CHECK: call void @consume_reference(ptr{{.*}})
diff --git a/clang/test/ObjC3/CodeGen/carrier-transfer-cxx.cpp b/clang/test/ObjC3/CodeGen/carrier-transfer-cxx.cpp
new file mode 100644
index 000000000..b7798cade
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/carrier-transfer-cxx.cpp
@@ -0,0 +1,86 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -std=c++20 -fexceptions -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s
+
+struct Item {
+  int value;
+  Item(const Item &other) : value(other.value) {}
+  Item(Item &&other) : value(other.value) { other.value = -1; }
+  ~Item();
+};
+struct Problem {
+  int value;
+  Problem(const Problem &other) : value(other.value) {}
+  Problem(Problem &&other) : value(other.value) { other.value = -1; }
+  ~Problem();
+};
+using Maybe = __objc3_optional(Item);
+using Outcome = __objc3_result(Item, Problem);
