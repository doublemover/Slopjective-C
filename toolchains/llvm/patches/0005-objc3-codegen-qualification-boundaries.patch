diff --git a/clang/lib/CodeGen/CGObjC3ResourceOperations.cpp b/clang/lib/CodeGen/CGObjC3ResourceOperations.cpp
new file mode 100644
index 000000000..1b52a1ecf
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ResourceOperations.cpp
@@ -0,0 +1,57 @@
+//===--- CGObjC3ResourceOperations.cpp - Native resource operations --------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3Resources.h"
+#include "CodeGenFunction.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Expr.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+struct InvalidateResourceOnEH final : EHScopeStack::Cleanup {
+  const VarDecl *Variable;
+  const Expr *StorageOperand;
+  InvalidateResourceOnEH(const VarDecl *Variable, const Expr *StorageOperand)
+      : Variable(Variable), StorageOperand(StorageOperand) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    const auto *Resource = Variable->getAttr<ObjCResourceAttr>();
+    CGF.EmitStoreThroughLValue(
+        RValue::get(CGF.EmitScalarExpr(Resource->getInvalid())),
+        CGF.EmitLValue(StorageOperand));
+  }
+};
+} // namespace
+
+llvm::Value *clang::CodeGen::emitObjC3ResourceExpr(
+    CodeGenFunction &CGF, const ObjC3ResourceExpr &Expression) {
+  const VarDecl *Variable = Expression.getResourceVariable();
+  assert(Variable && "resource operation must be resolved before CodeGen");
+  const auto *Resource = Variable->getAttr<ObjCResourceAttr>();
+  assert(Resource && "resource operation requires validated ownership");
+  if (Expression.getKind() == ObjC3ResourceExpr::Kind::Take) {
+    LValue Handle = CGF.EmitLValue(Expression.getOperand());
+    llvm::Value *Value = CGF.EmitLoadOfLValue(
+        Handle, Expression.getBuiltinLoc()).getScalarVal();
+    CGF.EmitStoreThroughLValue(
+        RValue::get(CGF.EmitScalarExpr(Resource->getInvalid())), Handle);
+    return Value;
+  }
+  {
+    // The close callback observes the original variable value/address. If it
+    // throws, invalidate that variable before the enclosing registered action
+    // runs; it must not close the same owned handle a second time.
+    CodeGenFunction::RunCleanupsScope InvalidationScope(CGF);
+    CGF.EHStack.pushCleanup<InvalidateResourceOnEH>(
+        EHCleanup, Variable, Expression.getOperand());
+    emitObjC3ResourceCleanup(CGF, *Variable, Expression.getOperand());
+  }
+  if (Expression.getKind() == ObjC3ResourceExpr::Kind::Reset) {
+    // Part 8's close-then-assign order also controls replacement evaluation.
+    // A failed replacement leaves the variable invalid, with no old owner.
+    llvm::Value *Replacement = CGF.EmitScalarExpr(Expression.getReplacement());
+    CGF.EmitStoreThroughLValue(RValue::get(Replacement),
+                                CGF.EmitLValue(Expression.getOperand()));
+  }
+  return nullptr;
+}
