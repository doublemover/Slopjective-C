+// Standalone executable companion to optional-expression-lowering.c.
+// Run after the focused CodeGen fixture passes:
+//   pwsh -NoProfile -File temp/full-compatibility/H4-optional-expressions/run_optional_runtime.ps1 -Clang <clang.exe> -TargetTriple <native-triple>
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(_Bool) OptionalBool;
+typedef __objc3_optional(void *) OptionalPointer;
+typedef __objc3_optional(void) OptionalVoid;
+struct Pair { int value; double fraction; };
+typedef __objc3_optional(struct Pair) OptionalPair;
+
+static void copy_int_optional(OptionalInt *destination,
+                              const OptionalInt *source) {
+  *destination = *source;
+}
+
+static int calls;
+static int return_zero_once(void) {
+  ++calls;
+  return 0;
+}
+static void increment_once(void) { ++calls; }
+
+int main(void) {
+  OptionalInt zero = __objc3_some(int, 0);
+  OptionalInt absent = __objc3_none(int);
+  OptionalBool false_value = __objc3_some(_Bool, 0);
+  OptionalPointer null_value = __objc3_some(void *, (void *)0);
+  struct Pair source = {17, 0.5};
+  OptionalPair aggregate = __objc3_some(struct Pair, source);
+
+  if (!__objc3_has_value(zero) || __objc3_has_value(absent) ||
+      !__objc3_has_value(false_value) || !__objc3_has_value(null_value))
+    return 1;
+  if (!__objc3_has_value(aggregate))
+    return 4;
+
+  if (!__objc3_has_value(__objc3_some(int, return_zero_once())) || calls != 1)
+    return 2;
+
+  OptionalVoid present_void =
+      __objc3_some(void, increment_once());
+  OptionalVoid absent_void = __objc3_none(void);
+  if (!__objc3_has_value(present_void) || __objc3_has_value(absent_void) ||
+      calls != 2)
+    return 3;
+
+  OptionalInt copied_zero = __objc3_none(int);
+  copy_int_optional(&copied_zero, &zero);
+  if (!__objc3_has_value(copied_zero))
+    return 5;
+  copy_int_optional(&copied_zero, &absent);
+  if (__objc3_has_value(copied_zero))
+    return 6;
+  return 0;
+}
