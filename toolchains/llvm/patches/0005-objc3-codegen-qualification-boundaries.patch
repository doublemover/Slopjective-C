--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/nested-throws-pointer-unsupported.cpp
@@ -0,0 +1,10 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -emit-llvm -o /dev/null -verify %s
+
+struct Error {};
+using ThrowingFunction = void(int) __objc3_throws(Error);
+using ThrowingFunctionPointer = ThrowingFunction *;
+using NestedThrowingFunctionPointer = ThrowingFunctionPointer *;
+
+// Recursive pointer aliases must still reach and reject the effect-bearing
