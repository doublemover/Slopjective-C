@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+
+@protocol Error @end
+@protocol Marker <Error> @end
+__attribute__((objc_root_class)) @interface First <Error> @end
+__attribute__((objc_root_class)) @interface Second <Error> @end
+
+void first(void) __objc3_throws(First *);
+void second(void) __objc3_throws(Second *);
+void marked(void) __objc3_throws(id<Marker>);
+
+int ordered(int which) {
+  __objc3_do {
+    if (which) __objc3_try(first());
+    else __objc3_try(second());
+  } __objc3_catch(First *error) {
+    return error != (id)0;
+  } __objc3_catch(Second *) {
+    return 2;
+  }
+  return 0;
+}
+// CHECK-LABEL: define{{.*}} i32 @ordered(
+// CHECK: call void @first(ptr
+// CHECK: objc3.try.failed
+// CHECK: call void @second(ptr
+// CHECK: objc3.catch.dispatch:
