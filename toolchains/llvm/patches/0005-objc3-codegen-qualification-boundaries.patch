+@protocol Error @end
+typedef id<Error> E;
+@protocol Checked
+- (int)value:(int)fail error:(E)error __objc3_throws(E);
+@end
+__attribute__((objc_root_class)) @interface Receiver <Checked>
+- (void)note:(E)error __objc3_throws(E);
++ (int)classValue __objc3_throws;
+@end
+@implementation Receiver
+- (int)value:(int)fail error:(E)error __objc3_throws(E) {
+  if (fail) __objc3_throw(error);
+  return 0;
+}
+- (void)note:(E)error __objc3_throws(E) { __objc3_throw(error); }
++ (int)classValue __objc3_throws { return 0; }
+@end
+@interface Subclass : Receiver @end
+@implementation Subclass
+- (int)value:(int)fail error:(E)error __objc3_throws(E) {
+  return __objc3_try([super value:fail error:error]);
+}
+@end
+// CHECK: c"value:error:\00"
+// CHECK: c"i36@0:8i16@20^@28\00"
+int instance(id<Checked> receiver, E error) { return __objc3_try_force([receiver value:0 error:error]); }
