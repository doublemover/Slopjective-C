+bool CodeGenTypes::diagnoseUnsupportedObjC3Effects(QualType T,
+                                                   const Decl *D) {
+  // Callable prototypes can share type nodes with declarations whose implicit
+  // ABI remains unsupported. Visit both roles so a supported pointer type does
+  // not hide an unsupported declaration in the same type graph.
+  llvm::SmallPtrSet<const Type *, 16> SeenErrorOut, SeenPrefixed;
+  bool FoundUnsupportedEffect = false;
+  auto Visit = [&](auto &&VisitSelf, QualType Current, bool ErrorOutABI) -> void {
+    if (Current.isNull())
+      return;
+    Current = Context.getCanonicalType(Current);
+    const Type *Ty = Current.getTypePtr();
+    auto &Seen = ErrorOutABI ? SeenErrorOut : SeenPrefixed;
+    if (!Seen.insert(Ty).second)
+      return;
+
+    if (const auto *FPT = dyn_cast<FunctionProtoType>(Ty)) {
+      ObjC3FunctionEffectInfo Effects = FPT->getObjC3FunctionEffects();
+      const bool SupportedThrows = ErrorOutABI &&
+          supportsObjC3ErrorOutFunction(CGM, FPT, nullptr, false);
+      if (Effects.Async ||
+          (Effects.Throws != ObjC3ThrowsKind::None && !SupportedThrows)) {
+        FoundUnsupportedEffect = true;
+        if (DiagnosedObjC3EffectTypes.insert(Ty).second) {
+          if (D)
+            CGM.ErrorUnsupported(D, "ObjC3 async/throws callable ABI lowering");
+          else
+            CGM.Error(SourceLocation(),
+                      "cannot compile ObjC3 async/throws callable type without ABI lowering");
+        }
+      }
+      VisitSelf(VisitSelf, FPT->getReturnType(), true);
+      for (QualType Param : FPT->param_types())
+        VisitSelf(VisitSelf, Param, true);
+    } else if (const auto *FT = dyn_cast<FunctionNoProtoType>(Ty)) {
+      VisitSelf(VisitSelf, FT->getReturnType(), true);
+    } else if (const auto *PT = dyn_cast<PointerType>(Ty)) {
+      VisitSelf(VisitSelf, PT->getPointeeType(), true);
+    } else if (const auto *BPT = dyn_cast<BlockPointerType>(Ty)) {
+      VisitSelf(VisitSelf, BPT->getPointeeType(), true);
+    } else if (const auto *RefTy = dyn_cast<ReferenceType>(Ty)) {
+      VisitSelf(VisitSelf, RefTy->getPointeeType(), true);
+    } else if (const auto *MPT = dyn_cast<MemberPointerType>(Ty)) {
+      VisitSelf(VisitSelf, MPT->getPointeeType(), true);
+    } else if (const auto *AT = dyn_cast<ArrayType>(Ty)) {
+      VisitSelf(VisitSelf, AT->getElementType(), true);
+    } else if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Ty)) {
+      VisitSelf(VisitSelf, Optional->getElementType(), true);
+    } else if (const auto *Result = dyn_cast<ObjC3ResultType>(Ty)) {
+      VisitSelf(VisitSelf, Result->getSuccessType(), true);
+      VisitSelf(VisitSelf, Result->getErrorType(), true);
+    } else if (const auto *OPT = dyn_cast<ObjCObjectPointerType>(Ty)) {
+      VisitSelf(VisitSelf, OPT->getPointeeType(), true);
+    } else if (const auto *RecordTy = dyn_cast<RecordType>(Ty)) {
+      if (const RecordDecl *RD = RecordTy->getDecl()->getDefinition()) {
+        if (const auto *CXXRD = dyn_cast<CXXRecordDecl>(RD))
+          for (const CXXBaseSpecifier &Base : CXXRD->bases())
+            VisitSelf(VisitSelf, Base.getType(), true);
+        for (const FieldDecl *Field : RD->fields())
+          VisitSelf(VisitSelf, Field->getType(), true);
+      }
+    }
+  };
+  const bool PrefixedDeclaration = !T.isNull() && T->isFunctionType() && D &&
+      isa<ObjCMethodDecl, CXXConstructorDecl, CXXDestructorDecl>(D);
+  Visit(Visit, T, !PrefixedDeclaration);
+  return FoundUnsupportedEffect;
+}
