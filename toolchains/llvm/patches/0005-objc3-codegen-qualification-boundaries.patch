 using namespace clang;
 
+// A noreturn attribute on a virtual declaration is not inherited by an
+// overriding method. An unqualified call through an extensible class may
+// dispatch to an override that returns normally.
+static bool mayCallReturningOverride(const CallExpr *Call) {
+  const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Call->getDirectCallee());
+  if (!Method || !Method->isVirtual() || Method->hasAttr<FinalAttr>() ||
+      Method->getParent()->hasAttr<FinalAttr>())
+    return false;
+  const auto *Member = dyn_cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts());
+  return !Member || !Member->hasQualifier();
+}
+
+static bool mayThrowNative(const FunctionDecl *Function) {
+  if (!Function)
+    return true;
+  if (Function->hasAttr<NoThrowAttr>())
+    return false;
+  const auto *Prototype = Function->getType()->getAs<FunctionProtoType>();
+  return !Prototype ||
+         isUnresolvedExceptionSpec(Prototype->getExceptionSpecType()) ||
+         !Prototype->isNothrow();
+}
+
+// Allocation failure is an operation boundary. A throwing initializer needs a
+// separate deallocation-on-failure path; admit initialized new only when that
+// path is impossible. Keep this query deliberately structural and bounded.
+static bool isNonThrowingNewInitializer(const Stmt *Statement) {
+  if (!Statement)
+    return true;
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement))
+    return isNonThrowingNewInitializer(Argument->getExpr());
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement))
+    return isNonThrowingNewInitializer(Initializer->getExpr());
+  if (const auto *Call = dyn_cast<CallExpr>(Statement)) {
+    if (mayThrowNative(Call->getDirectCallee()))
+      return false;
+  } else if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Statement)) {
+    if (mayThrowNative(Constructor->getConstructor()))
+      return false;
+  } else if (!isa<IntegerLiteral, CharacterLiteral, FloatingLiteral,
+                  StringLiteral, CXXBoolLiteralExpr, CXXNullPtrLiteralExpr,
+                  GNUNullExpr, ImplicitValueInitExpr, CXXScalarValueInitExpr,
+                  DeclRefExpr, CXXThisExpr, ParenExpr, ImplicitCastExpr,
+                  InitListExpr, MemberExpr, UnaryOperator, BinaryOperator>(
+                 Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (!isNonThrowingNewInitializer(Child))
+      return false;
+  return true;
+}
