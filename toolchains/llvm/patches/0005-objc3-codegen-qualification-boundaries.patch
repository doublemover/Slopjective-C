+ObjC3DeferState *CodeGenFunction::getObjC3DeferState() {
+  if (!getLangOpts().ObjC3)
+    return nullptr;
+  if (!ObjC3Defers)
+    ObjC3Defers = std::make_unique<ObjC3DeferState>(
+        CurCodeDecl ? CurCodeDecl->getBody() : nullptr);
+  return ObjC3Defers.get();
+}
+
+void CodeGenFunction::enterObjC3SourceScope(const Stmt *Owner) {
+  auto *State = getObjC3DeferState();
+  if (!State || !State->Sources.CleanupScopes.contains(Owner)) return;
+  for (const auto &Scope : llvm::reverse(State->Scopes))
+    if (Scope->Active && Scope->Owner == Owner) return;
+  auto Scope = std::make_unique<ObjC3ReleaseScope>();
+  Scope->Owner = Owner;
+  EHStack.pushCleanup<EmitObjC3SourceReleases>(NormalAndEHCleanup, Scope.get());
+  Scope->Depth = EHStack.stable_begin();
+  State->Scopes.push_back(std::move(Scope));
+}
+
+ObjC3ReleaseScope *CodeGenFunction::getObjC3ReleaseScope(const VarDecl *Variable) {
+  auto *State = getObjC3DeferState();
+  if (!State) return nullptr;
+  const Stmt *Owner = State->Sources.Variables.lookup(Variable);
+  if (!Owner) return nullptr;
+  for (const auto &Scope : llvm::reverse(State->Scopes))
+    if (Scope->Active && Scope->Owner == Owner) return Scope.get();
+  return nullptr;
+}
+
+ObjC3ReleaseScope *CodeGenFunction::getObjC3ReleaseScope(const BlockExpr *Block) {
+  auto *State = getObjC3DeferState();
+  if (!State) return nullptr;
+  const Stmt *Owner = State->Sources.Blocks.lookup(Block);
+  if (!Owner) return nullptr;
+  for (const auto &Scope : llvm::reverse(State->Scopes))
+    if (Scope->Active && Scope->Owner == Owner) return Scope.get();
+  return nullptr;
+}
+
+bool CodeGenFunction::hasObjC3DeferredSourceOwner(const VarDecl *Variable) {
+  return getObjC3ReleaseScope(Variable) != nullptr;
+}
+
+ObjC3PendingRelease *CodeGenFunction::registerObjC3SourceRelease(
+    const VarDecl *Variable, Address Storage, bool ReleaseOnEH,
+    ObjC3ReleaseEmitter Emit) {
+  return registerObjC3SourceRelease(getObjC3ReleaseScope(Variable), Storage,
+                                   ReleaseOnEH, std::move(Emit));
+}
+
+ObjC3PendingRelease *CodeGenFunction::registerObjC3SourceRelease(
+    ObjC3ReleaseScope *Scope, Address Storage, bool ReleaseOnEH,
+    ObjC3ReleaseEmitter Emit) {
+  if (!Scope) return nullptr;
+  auto Release = std::make_unique<ObjC3PendingRelease>();
+  Release->Scope = Scope;
+  Release->Pointer = CreateTempAlloca(Int8PtrTy, getPointerAlign(),
+                                      "scope.release.pointer");
+  Release->Pending = CreateTempAlloca(Builder.getInt1Ty(), CharUnits::One(),
+                                      "scope.release.pending");
+  Release->ElementType = Storage.getElementType();
+  Release->Alignment = Storage.getAlignment();
+  Release->Destination = CreateTempAlloca(Builder.getInt32Ty(), CharUnits::fromQuantity(4),
+                                          "scope.release.destination");
+  Release->ReleaseOnEH = ReleaseOnEH;
+  Release->Emit = std::move(Emit);
+  CGBuilderTy EntryBuilder(CGM, AllocaInsertPt);
+  EntryBuilder.CreateStore(Builder.getFalse(), Release->Pending);
+  EntryBuilder.CreateStore(Builder.getInt32(-1), Release->Destination);
+  // A runtime slot also handles VLAs and independently emitted cleanup copies:
+  // their storage SSA value need not dominate every exit of the source scope.
+  Builder.CreateStore(Storage.emitRawPointer(*this), Release->Pointer);
+  auto *Result = Release.get();
+  Scope->Releases.push_back(std::move(Release));
+  return Result;
+}
+
+void CodeGenFunction::emitObjC3OrderedRelease(
+    ObjC3PendingRelease &Release, EHScopeStack::Cleanup::Flags Flags) {
+  assert(Flags.isForEHCleanup() || ObjC3CleanupDestination);
+  Builder.CreateStore(Flags.isForEHCleanup() ? Builder.getInt32(-1)
+                                            : ObjC3CleanupDestination,
+                      Release.Destination);
+  Builder.CreateStore(Builder.getTrue(), Release.Pending);
+}
+
+namespace {
+void emitPendingSourceRelease(CodeGenFunction &CGF, ObjC3PendingRelease &Release,
+                              EHScopeStack::Cleanup::Flags Flags,
+                              std::optional<unsigned> Destination = std::nullopt) {
+  if (Flags.isForEHCleanup() && !Release.ReleaseOnEH) return;
+  auto *Run = CGF.createBasicBlock("scope.release");
+  auto *Done = CGF.createBasicBlock("scope.release.next");
+  llvm::Value *Pending = CGF.Builder.CreateLoad(Release.Pending);
+  if (Destination)
+    Pending = CGF.Builder.CreateAnd(
+        Pending, CGF.Builder.CreateICmpEQ(
+                     CGF.Builder.CreateLoad(Release.Destination),
+                     CGF.Builder.getInt32(*Destination)));
+  CGF.Builder.CreateCondBr(Pending, Run, Done);
+  CGF.EmitBlock(Run);
+  CGF.Builder.CreateStore(CGF.Builder.getFalse(), Release.Pending);
+  Address Storage(CGF.Builder.CreateLoad(Release.Pointer), Release.ElementType,
+                  Release.Alignment);
+  Release.Emit(CGF, Storage, Flags);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
+}
+
+void CodeGenFunction::emitObjC3ScopeReleases(
+    ObjC3ReleaseScope &Scope, EHScopeStack::Cleanup::Flags Flags) {
+  for (const auto &Release : llvm::reverse(Scope.Releases))
+    emitPendingSourceRelease(*this, *Release, Flags);
+}
+
+llvm::BasicBlock *CodeGenFunction::getObjC3PartialReleaseEdge(
+    llvm::BasicBlock *Target, unsigned Index) {
+  if (!ObjC3Defers || !Index) return Target;
+  ObjC3PartialReleaseEdge Edge;
+  Edge.Index = Index;
+  for (const auto &Scope : ObjC3Defers->Scopes)
+    if (Scope->Active) Edge.Scopes.push_back(Scope.get());
+  if (Edge.Scopes.empty()) return Target;
+  Edge.Entry = createBasicBlock("scope.release.edge");
+  // Keep an IR use until this deferred edge is emitted. Finished-block
+  // deletion and forwarding-block simplification must see this continuation.
+  llvm::UncondBrInst::Create(Target, Edge.Entry);
+  auto *Result = Edge.Entry;
+  ObjC3Defers->Edges.push_back(std::move(Edge));
+  return Result;
+}
+
+void CodeGenFunction::noteObjC3SourceScopePop(EHScopeStack::stable_iterator Depth) {
+  if (ObjC3Defers)
+    for (const auto &Scope : ObjC3Defers->Scopes)
+      if (Scope->Active && Scope->Depth == Depth) {
+        Scope->Active = false;
+        return;
+      }
+}
+
+void CodeGenFunction::emitObjC3PartialReleaseEdges() {
+  if (!ObjC3Defers) return;
+  auto SavedIP = Builder.saveAndClearIP();
+  // These edges are emitted after fixups resolve and all source release
+  // records exist. Destination identity keeps a local jump inside a running
+  // deferred body from draining the enclosing transfer's pending releases.
+  for (const auto &Edge : ObjC3Defers->Edges) {
+    auto *Continuation = cast<llvm::UncondBrInst>(Edge.Entry->getTerminator());
+    llvm::BasicBlock *Destination = Continuation->getSuccessor();
+    Continuation->eraseFromParent();
+    EmitBlock(Edge.Entry);
+    EHScopeStack::Cleanup::Flags Normal;
+    for (auto *Scope : llvm::reverse(Edge.Scopes))
+      for (const auto &Release : llvm::reverse(Scope->Releases))
+        emitPendingSourceRelease(*this, *Release, Normal, Edge.Index);
+    EmitBranch(Destination);
+    Builder.ClearInsertionPoint();
+  }
+  Builder.restoreIP(SavedIP);
+}
