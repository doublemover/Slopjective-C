+  MirrorOptionalPointer null_value =
+      echo_optional_pointer(make_optional_null());
+  if (null_value.state != 1 || null_value.payload.value != (void *)0)
+    return 5;
+
+  MirrorResultIntLong success = echo_result(make_result_ok(0));
+  if (success.is_ok != 1 || success.payload.ok_value != 0)
+    return 6;
+
+  MirrorResultIntLong error_zero = echo_result(make_result_err(0));
+  if (error_zero.is_ok != 0 || error_zero.payload.error_value != 0)
+    return 7;
