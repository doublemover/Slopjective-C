+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3ASYNC_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3ASYNC_H
+namespace llvm {
+class Value;
+template <class T> class ArrayRef;
+template <class T> class SmallVectorImpl;
+}
+namespace clang {
+class CoawaitExpr;
+class CallExpr;
+namespace CodeGen {
+class CodeGenFunction;
+class Address;
+llvm::Value *emitObjC3AsyncGroupNextPlan(CodeGenFunction &, const CallExpr &);
+// A C++ coroutine owns slots, never live thread-local pool tokens, across a
+// suspension. C frames keep their corresponding private slot vector.
+llvm::SmallVectorImpl<Address> *getObjC3CxxAutoreleasePools(CodeGenFunction &);
+void drainObjC3AsyncAutoreleasePools(CodeGenFunction &, llvm::ArrayRef<Address>);
+void reopenObjC3AsyncAutoreleasePools(CodeGenFunction &, llvm::ArrayRef<Address>);
+void pushObjC3AsyncPoolReopenCleanup(CodeGenFunction &, llvm::ArrayRef<Address>);
+
+/// On an admitted checked error, transfer to the enclosing try failure edge.
+/// Cancellation and foreign failures bypass checked handlers.
+bool emitObjC3CAsyncCheckedFailure(CodeGenFunction &, const CoawaitExpr &,
+                                    llvm::Value *Kind, llvm::Value *Error);
+}
+}
+#endif
