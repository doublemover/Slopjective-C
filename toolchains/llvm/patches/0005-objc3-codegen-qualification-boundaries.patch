+  UnsafeOptional value = __objc3_some(id __unsafe_unretained, object);
+  (void)__objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}unsafe_optional_local
+// CHECK-NOT: @llvm.objc.retain
+// CHECK-NOT: @llvm.objc.initWeak
+// CHECK-NOT: @llvm.objc.destroyWeak
