diff --git a/clang/test/ObjC3/CodeGen/Inputs/defer-public-runtime.c b/clang/test/ObjC3/CodeGen/Inputs/defer-public-runtime.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/defer-public-runtime.c
@@ -0,0 +1,24 @@
+// Public contextual defer: scope registration, LIFO, loop exits and return.
+static int events;
+static void record(int event) { events = events * 10 + event; }
+static int defer(int value) { return value; }
+static int scoped(int take_return) {
+  defer { record(1); }
+  defer { record(2); }
+  if (take_return) return defer(7);
+  { defer { record(3); } }
+  return 0;
+}
+int main(void) {
+  if (scoped(1) != 7 || events != 21) return 1;
+  events = 0;
+  if (scoped(0) != 0 || events != 321) return 2;
+  events = 0;
+  for (int i = 0; i != 3; ++i) {
+    defer { record(i + 1); }
+    if (i == 0) continue;
+    if (i == 1) break;
+    return 3;
+  }
+  return events == 12 ? 0 : 4;
+}
diff --git a/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-arc-runtime.inc b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-arc-runtime.inc
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-arc-runtime.inc
@@ -0,0 +1,151 @@
+#include "typed-error-managed-runtime.h"
+
+static TestError managed_object(TestError value, TestError error)
+    __objc3_throws(TestError) {
+  if (error) __objc3_throw(error);
+  return value;
+}
+static TestError managed_owned(TestError error)
+    __objc3_throws(TestError) __attribute__((ns_returns_retained)) {
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    return (TestError)make_zero_code_error();
+  }
+}
+static TestError managed_pooled(TestError error) __objc3_throws(TestError) {
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    return (TestError)make_zero_code_error();
+  }
+}
+static ManagedSuccessBlock managed_block(TestError value, TestError error)
+    __objc3_throws(TestError) {
+  if (error) __objc3_throw(error);
+  return ^{ return [value code] + 42; };
+}
+static TestError managed_propagated(TestError value, TestError error)
+    __objc3_throws(TestError) {
+  @autoreleasepool { return __objc3_try(managed_object(value, error)); }
+}
+struct ManagedMember {
+  TestError object(TestError value, TestError error) __objc3_throws(TestError) {
+    return __objc3_try(managed_object(value, error));
+  }
+  ManagedSuccessBlock block(TestError value, TestError error) __objc3_throws(TestError) {
+    return __objc3_try(managed_block(value, error));
+  }
+};
+@interface ManagedSuccessReceiver : ZeroCodeError
+- (TestError)object:(TestError)value error:(TestError)error __objc3_throws(TestError);
+- (ManagedSuccessBlock)block:(TestError)value error:(TestError)error __objc3_throws(TestError);
+@end
+@implementation ManagedSuccessReceiver
+- (TestError)object:(TestError)value error:(TestError)error __objc3_throws(TestError) {
+  return __objc3_try(managed_object(value, error));
+}
+- (ManagedSuccessBlock)block:(TestError)value error:(TestError)error __objc3_throws(TestError) {
+  return __objc3_try(managed_block(value, error));
+}
+@end
+
+static TestError managed_native_exception() __objc3_throws(TestError) {
+  TestError owner = (TestError)make_zero_code_error();
+  ManagedSuccessBlock block = __objc3_try_force(managed_block(owner, nil));
+  if (block() != 42) __builtin_trap();
+  throw 73;
+}
+#include "typed-error-managed-optional-runtime.inc"
+
+static int run_managed_success_checks() {
+  int optional_result = run_managed_optional_checks();
+  if (optional_result) return optional_result;
+  int result = run_mrc_managed_checks();
+  if (result) return result;
+  int before = zero_code_error_deallocations();
+  __weak ZeroCodeError *weak;
+  @autoreleasepool {
+    TestError owner = (TestError)make_zero_code_error();
+    weak = owner;
+    if (__objc3_try_force(managed_object(owner, nil)) != owner) return 186;
+    auto callback = managed_object;
+    if (__objc3_try_force(callback(owner, nil)) != owner) return 187;
+    TestError (^object_block)(TestError, TestError) __objc3_throws(TestError) =
+        ^TestError(TestError value, TestError error) __objc3_throws(TestError) {
+          return __objc3_try(managed_object(value, error));
+        };
+    if (__objc3_try_force(object_block(owner, nil)) != owner) return 188;
+    ManagedMember member;
+    auto pointer = &ManagedMember::object;
+    if (__objc3_try_force((member.*pointer)(owner, nil)) != owner) return 189;
+    ManagedSuccessReceiver *receiver = (ManagedSuccessReceiver *)make_named_zero_code_error("ManagedSuccessReceiver");
+    if (__objc3_try_force([receiver object:owner error:nil]) != owner) return 190;
+    if (__objc3_try_force(managed_propagated(owner, nil)) != owner) return 191;
+    if (__objc3_try_force(managed_mrc_object(owner, nil)) != owner) return 192;
+    TestError owned = __objc3_try_force(managed_owned(nil));
+    TestError pooled = __objc3_try_force(managed_pooled(nil));
+    TestError mrc_owned = __objc3_try_force(managed_mrc_owned(nil));
+    if (!owned || !pooled || !mrc_owned) return 193;
+    ManagedSuccessBlock direct = __objc3_try_force(managed_block(owner, nil));
+    auto block_callback = managed_block;
+    ManagedSuccessBlock indirect = __objc3_try_force(block_callback(owner, nil));
+    ManagedSuccessBlock member_block = __objc3_try_force(member.block(owner, nil));
+    ManagedSuccessBlock message_block = __objc3_try_force([receiver block:owner error:nil]);
+    ManagedSuccessBlock (^block_block)(TestError, TestError) __objc3_throws(TestError) =
+        ^ManagedSuccessBlock(TestError value, TestError error) __objc3_throws(TestError) {
+          return __objc3_try(managed_block(value, error));
+        };
+    ManagedSuccessBlock nested = __objc3_try_force(block_block(owner, nil));
+    if (direct() != 42 || indirect() != 42 || member_block() != 42 ||
+        message_block() != 42 || nested() != 42 ||
+        __objc3_try_force(managed_mrc_block(nil))() != 42) return 194;
+    int caught = 0;
+    __objc3_do { (void)__objc3_try(managed_propagated(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try(callback(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try(object_block(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try(member.block(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try([receiver block:owner error:owner]); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    ManagedMRCMember mrc_member;
+    ManagedMRCReceiver *mrc_receiver = (ManagedMRCReceiver *)make_named_zero_code_error("ManagedMRCReceiver");
+    if (__objc3_try_force(mrc_member.object(owner, nil)) != owner ||
+        __objc3_try_force(mrc_member.block(nil))() != 42 ||
+        __objc3_try_force([mrc_receiver object:owner error:nil]) != owner ||
+        __objc3_try_force([mrc_receiver block:nil])() != 42) return 202;
+    __objc3_do { (void)__objc3_try(mrc_member.object(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try([mrc_receiver block:owner]); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    if (caught != 7) return 195;
+  }
+  if (weak || zero_code_error_deallocations() != before + 6) return 196;
+  ManagedSuccessBlock escaped;
+  before = zero_code_error_deallocations();
+  @autoreleasepool {
+    TestError owner = (TestError)make_zero_code_error();
+    weak = owner;
+    escaped = __objc3_try_force(managed_block(owner, nil));
+  }
+  if (!weak || escaped() != 42 || zero_code_error_deallocations() != before) return 197;
+  escaped = nil;
+  if (weak || zero_code_error_deallocations() != before + 1) return 198;
+  before = zero_code_error_deallocations();
+  @autoreleasepool {
+    TestError owner = (TestError)make_zero_code_error();
+    weak = owner;
+    escaped = __objc3_try_force(managed_mrc_owned_block(owner, nil));
+  }
+  if (!weak || escaped() != 42) return 204;
+  escaped = nil;
+  if (weak || zero_code_error_deallocations() != before + 1) return 205;
+  before = zero_code_error_deallocations();
+  int native_caught = 0;
+  @autoreleasepool {
+    try { (void)__objc3_try_force(managed_native_exception()); }
+    catch (int value) { native_caught = value == 73; }
+  }
+  return native_caught && zero_code_error_deallocations() == before + 1 ? 0 : 206;
+}
