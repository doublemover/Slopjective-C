+#ifndef CARRIER_NATIVE_ABI_C_MIRROR_H
+#define CARRIER_NATIVE_ABI_C_MIRROR_H
+#include <stddef.h>
+
+/* Test-only native-layout mirrors. These do not define a public ABI. */
+typedef struct {
+  _Bool state;
+  union { int value; } payload;
+} MirrorOptionalInt;
+typedef struct {
+  _Bool state;
+  union { _Bool value; } payload;
+} MirrorOptionalBool;
+typedef struct {
+  _Bool state;
+  union { void *value; } payload;
+} MirrorOptionalPointer;
+typedef struct {
+  _Bool is_ok;
+  union { int ok_value; long long error_value; } payload;
+} MirrorResultIntLong;
+
+/* Win64 target facts captured from the compiler-owned hidden records. */
+_Static_assert(sizeof(MirrorOptionalInt) == 8, "Win64 Optional<int> mirror size");
+_Static_assert(_Alignof(MirrorOptionalInt) == 4, "Win64 Optional<int> mirror alignment");
+_Static_assert(offsetof(MirrorOptionalInt, state) == 0, "Optional<int> tag offset");
+_Static_assert(offsetof(MirrorOptionalInt, payload) == 4, "Optional<int> payload offset");
+_Static_assert(sizeof(MirrorOptionalBool) == 2, "Win64 Optional<bool> mirror size");
+_Static_assert(_Alignof(MirrorOptionalBool) == 1, "Win64 Optional<bool> mirror alignment");
+_Static_assert(offsetof(MirrorOptionalBool, state) == 0, "Optional<bool> tag offset");
+_Static_assert(offsetof(MirrorOptionalBool, payload) == 1, "Optional<bool> payload offset");
+_Static_assert(sizeof(MirrorOptionalPointer) == 16, "Win64 Optional<pointer> mirror size");
+_Static_assert(_Alignof(MirrorOptionalPointer) == 8, "Win64 Optional<pointer> mirror alignment");
+_Static_assert(offsetof(MirrorOptionalPointer, state) == 0, "Optional<pointer> tag offset");
+_Static_assert(offsetof(MirrorOptionalPointer, payload) == 8, "Optional<pointer> payload offset");
+_Static_assert(sizeof(MirrorResultIntLong) == 16, "Win64 Result mirror size");
+_Static_assert(_Alignof(MirrorResultIntLong) == 8, "Win64 Result mirror alignment");
+_Static_assert(offsetof(MirrorResultIntLong, is_ok) == 0, "Result tag offset");
+_Static_assert(offsetof(MirrorResultIntLong, payload) == 8, "Result payload offset");
+
+#ifdef CARRIER_NATIVE_PROVIDER
+typedef __objc3_optional(int) NativeOptionalInt;
+typedef __objc3_optional(_Bool) NativeOptionalBool;
+typedef __objc3_optional(void *) NativeOptionalPointer;
+typedef __objc3_result(int, long long) NativeResultIntLong;
+
+/* Tie native extension carriers directly to the private mirrors above. */
+_Static_assert(sizeof(NativeOptionalInt) == sizeof(MirrorOptionalInt), "Optional<int> mirror size match");
+_Static_assert(_Alignof(NativeOptionalInt) == _Alignof(MirrorOptionalInt), "Optional<int> mirror alignment match");
+_Static_assert(sizeof(NativeOptionalBool) == sizeof(MirrorOptionalBool), "Optional<bool> mirror size match");
+_Static_assert(_Alignof(NativeOptionalBool) == _Alignof(MirrorOptionalBool), "Optional<bool> mirror alignment match");
+_Static_assert(sizeof(NativeOptionalPointer) == sizeof(MirrorOptionalPointer), "Optional<pointer> mirror size match");
+_Static_assert(_Alignof(NativeOptionalPointer) == _Alignof(MirrorOptionalPointer), "Optional<pointer> mirror alignment match");
+_Static_assert(sizeof(NativeResultIntLong) == sizeof(MirrorResultIntLong), "Result mirror size match");
+_Static_assert(_Alignof(NativeResultIntLong) == _Alignof(MirrorResultIntLong), "Result mirror alignment match");
+
+NativeOptionalInt make_optional_int(int present, int value);
+NativeOptionalInt echo_optional_int(NativeOptionalInt value);
+NativeOptionalBool make_optional_false(void);
+NativeOptionalBool echo_optional_bool(NativeOptionalBool value);
+NativeOptionalPointer make_optional_null(void);
+NativeOptionalPointer echo_optional_pointer(NativeOptionalPointer value);
+NativeResultIntLong make_result_ok(int value);
+NativeResultIntLong make_result_err(long long value);
+NativeResultIntLong echo_result(NativeResultIntLong value);
+#else
+/* Plain C declarations intentionally use only private mirror records. */
+MirrorOptionalInt make_optional_int(int present, int value);
+MirrorOptionalInt echo_optional_int(MirrorOptionalInt value);
+MirrorOptionalBool make_optional_false(void);
+MirrorOptionalBool echo_optional_bool(MirrorOptionalBool value);
+MirrorOptionalPointer make_optional_null(void);
+MirrorOptionalPointer echo_optional_pointer(MirrorOptionalPointer value);
+MirrorResultIntLong make_result_ok(int value);
+MirrorResultIntLong make_result_err(long long value);
+MirrorResultIntLong echo_result(MirrorResultIntLong value);
+#endif
+
+#endif
