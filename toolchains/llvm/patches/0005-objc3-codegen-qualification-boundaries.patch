+// CHECK: call void @_ZN7TrackedD1Ev
+// CHECK: objc3.carrier.dtor.done:
+
+void result_ok_selected_cleanup() {
+  TrackedResult local = __objc3_ok(Tracked, Failure, Tracked(2));
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} void @_Z26result_ok_selected_cleanupv
+// CHECK: store i8 1
+// CHECK: load i8
+// CHECK: call void @_ZN7TrackedD1Ev
+// CHECK: call void @_ZN7FailureD1Ev
+
+struct alignas(32) Empty {
+  Empty();
+  ~Empty();
+};
+typedef __objc3_optional(Empty) MaybeEmpty;
+void empty_aligned_payload_cleanup() {
+  const MaybeEmpty local = __objc3_some(Empty, Empty());
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} void @_Z29empty_aligned_payload_cleanupv
+// CHECK: getelementptr inbounds i8, ptr {{.*}}, i64 32
+// CHECK: call void @_ZN5EmptyC1Ev
+// CHECK: store i8 1
+// CHECK: load i8
+// CHECK: call void @_ZN5EmptyD1Ev
+
+void result_err_selected_cleanup() {
+  TrackedResult local = __objc3_err(Tracked, Failure, Failure(3));
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} void @_Z27result_err_selected_cleanupv
+// CHECK: store i8 0
+// CHECK: load i8
+// CHECK: call void @_ZN7TrackedD1Ev
+// CHECK: call void @_ZN7FailureD1Ev
+
+void optional_some_unwinds_through_payload_cleanup() {
