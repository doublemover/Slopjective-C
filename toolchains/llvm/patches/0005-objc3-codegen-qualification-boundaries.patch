new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/carrier-arc-transfer.mm
@@ -0,0 +1,91 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -std=c++20 -emit-llvm -o - %s | FileCheck %s
