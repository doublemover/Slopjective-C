diff --git a/clang/lib/CodeGen/CGObjC3KeyPath.cpp b/clang/lib/CodeGen/CGObjC3KeyPath.cpp
new file mode 100644
index 000000000..aedd5dbde
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3KeyPath.cpp
@@ -0,0 +1,100 @@
+//===--- CGObjC3KeyPath.cpp - Native key-path operand ownership ------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3KeyPath.h"
+#include "CGObjC3BlockCaptures.h"
+#include "CodeGenFunction.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/ObjC3KeyPath.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+struct ReleaseKeyPathOperand final : EHScopeStack::Cleanup {
+  llvm::Value *Owner;
+  explicit ReleaseKeyPathOperand(llvm::Value *Owner) : Owner(Owner) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.EmitARCRelease(Owner, ARCPreciseLifetime);
+  }
+};
+
+struct ReleasePendingKeyPathOperand final : EHScopeStack::Cleanup {
+  Address Storage;
+  explicit ReleasePendingKeyPathOperand(Address Storage) : Storage(Storage) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.EmitARCRelease(CGF.Builder.CreateLoad(Storage), ARCPreciseLifetime);
+  }
+};
+
+llvm::Value *acquireOperand(CodeGenFunction &CGF, const Expr *Source) {
+  if (const auto *Parens = dyn_cast<ParenExpr>(Source))
+    return acquireOperand(CGF, Parens->getSubExpr());
+  if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Source)) {
+    // Acquire the snapshot before the operand's own temporary destruction.
+    // Keep a rollback slot below that temporary stack so a throwing C++
+    // destructor also releases a completed object/Block snapshot. The source
+    // capture guard remains responsible for its own partial field rollback.
+    Address Pending = CGF.CreateMemTemp(Source->getType(),
+                                         "objc3.keypath.pending");
+    auto *Start = CGF.Builder.CreateStore(llvm::Constant::getNullValue(
+        CGF.ConvertType(Source->getType())), Pending);
+    CGF.EHStack.pushCleanup<ReleasePendingKeyPathOperand>(EHCleanup, Pending);
+    auto Rollback = CGF.EHStack.stable_begin();
+    llvm::Value *Owner;
+    {
+      ObjC3BlockCaptureFullExprScope Captures(CGF, Cleanups);
+      CodeGenFunction::RunCleanupsScope Temporaries(CGF);
+      Owner = acquireOperand(CGF, Cleanups->getSubExpr());
+      CGF.Builder.CreateStore(Owner, Pending);
+    }
+    CGF.DeactivateCleanupBlock(Rollback, Start);
+    return Owner;
+  }
+  // ARC performs owned weak loads and consumes an already-owned production.
+  // MRC acquires an independent retain even for a conventional +1 operand;
+  // this snapshot must not consume the caller's original ownership claim.
+  // Block retention invokes the actual potentially throwing native copy.
+  return CGF.getLangOpts().ObjCAutoRefCount
+      ? CGF.EmitARCRetainScalarExpr(Source)
+      : CGF.EmitARCRetain(Source->getType(), CGF.EmitScalarExpr(Source));
+}
+} // namespace
+
+llvm::Value *clang::CodeGen::emitObjC3KeyPathOperandSnapshot(
+    CodeGenFunction &CGF, const Expr *Source) {
+  assert(Source->getType()->isObjCRetainableType());
+  llvm::Value *Owner = acquireOperand(CGF, Source);
+  CGF.pushFullExprCleanup<ReleaseKeyPathOperand>(NormalAndEHCleanup, Owner);
+  return Owner;
+}
+
+llvm::Value *clang::CodeGen::tryEmitObjC3KeyPathGetterReturn(
+    CodeGenFunction &CGF, const Expr *Source) {
+  if (CGF.getLangOpts().ObjCAutoRefCount ||
+      !Source->getType()->isObjCRetainableType())
+    return nullptr;
+  const auto *Function = dyn_cast_or_null<FunctionDecl>(CGF.CurCodeDecl);
+  if (!Function || !Function->isImplicit())
+    return nullptr;
+  bool Getter = false;
+  for (const auto *Attribute : Function->specific_attrs<AnnotateAttr>())
+    Getter |= Attribute->getAnnotation() == "objc3.keypath.getter.v2";
+  if (!Getter)
+    return nullptr;
+
+  llvm::Value *Value = CGF.EmitScalarExpr(Source);
+  const auto *Message =
+      dyn_cast<ObjCMessageExpr>(Source->IgnoreParenImpCasts());
+  const ObjCMethodDecl *Method = Message ? Message->getMethodDecl() : nullptr;
+  // The synthesized function has the ordinary +0 return convention even when
+  // its selected native getter produces a +1 value. Balance that ownership
+  // before receiver cleanup; otherwise acquire an independent autoreleased
+  // owner so a precise intermediate release cannot invalidate the result.
+  if (doesObjC3KeyPathGetterReturnRetained(Method))
+    return CGF.EmitARCAutorelease(Value);
+  return CGF.EmitARCRetainAutorelease(Source->getType(), Value);
+}
