+// The shared plan is compiler-owned, including canonical descriptors, complete
+// carrier copy/destruction operations and AST field offsets. No operand runs.
+int evaluated;
+const void *integer_plan(void) {
+  return __builtin_objc3_async_group_next_plan((Optional(int) *)++evaluated);
+}
+#if __has_feature(objc_arc)
+const void *object_plan(void) {
+  return __builtin_objc3_async_group_next_plan((Optional(id) *)0);
+}
+typedef int (^Reader)(void);
+const void *block_plan(void) {
+  return __builtin_objc3_async_group_next_plan((Optional(Reader) *)0);
+}
+#endif
+const void *void_plan(void) {
+  return __builtin_objc3_async_group_next_plan((Optional(void) *)0);
+}
+struct __attribute__((aligned(64))) Wide { int value; };
+const void *aligned_plan(void) {
+  return __builtin_objc3_async_group_next_plan((Optional(struct Wide) *)0);
+}
+// CHECK-DAG: @__objc3_async_group_next_plan{{.*}} = private constant {{.*}}i32 56, i32 1
+// CHECK-DAG: @__objc3_c_async_value_ops{{.*}} = private constant
+// CHECK-DAG: c"objc3.async.v1:_ZTSi\00"
+// CHECK-LABEL: define{{.*}} ptr @integer_plan(
+// CHECK-NOT: load i32, ptr @evaluated
+// CHECK-NOT: store i32 {{.*}}@evaluated
