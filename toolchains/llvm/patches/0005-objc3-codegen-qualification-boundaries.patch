+typedef __objc3_optional(void) OptionalVoid;
+struct Pair { int value; double fraction; };
+typedef __objc3_optional(struct Pair) OptionalPair;
+
+extern int side_effect_int(void);
+extern void side_effect_void(void);
+
+int zero_is_present(void) {
+  OptionalInt value = __objc3_some(int, 0);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @zero_is_present()
+// CHECK: store i8 1
+// CHECK: load i8
+
+int none_is_absent(void) {
+  OptionalInt value = __objc3_none(int);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @none_is_absent()
+// CHECK: store i8 0
+// CHECK: load i8
+
+int false_is_present(void) {
+  OptionalBool value = __objc3_some(_Bool, 0);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @false_is_present()
+// CHECK: store i8 1
+
+int null_is_present(void) {
+  OptionalPointer value = __objc3_some(void *, (void *)0);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @null_is_present()
+// CHECK: store i8 1
+
+int aggregate_is_present(struct Pair source) {
+  OptionalPair value = __objc3_some(struct Pair, source);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @aggregate_is_present(
+// CHECK: store i8 1
+// CHECK: load i8
+
+void void_some_evaluates_once(void) {
+  OptionalVoid value = __objc3_some(void, side_effect_void());
+  (void)value;
+}
+// CHECK-LABEL: define{{.*}} void @void_some_evaluates_once()
+// CHECK-COUNT-1: call void @side_effect_void()
+// CHECK: store i8 1
+
+int has_value_evaluates_payload_once(void) {
+  return __objc3_has_value(__objc3_some(int, side_effect_int()));
+}
+// CHECK-LABEL: define{{.*}} i32 @has_value_evaluates_payload_once()
+// CHECK-COUNT-1: call i32 @side_effect_int()
+// CHECK: store i8 1
+// CHECK: load i8
