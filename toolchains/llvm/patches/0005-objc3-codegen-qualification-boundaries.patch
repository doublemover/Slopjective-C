+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -std=c++20 -DTEST_SCALAR -emit-llvm -o %t.scalar.ll -verify %s
+// RUN: test ! -e %t.scalar.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -std=c++20 -DTEST_AGGREGATE -emit-llvm -o %t.aggregate.ll -verify %s
+// RUN: test ! -e %t.aggregate.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -std=c++20 -DTEST_COMPLEX -emit-llvm -o %t.complex.ll -verify %s
+// RUN: test ! -e %t.complex.ll
+
+// Each builtin is accepted by Clang's source semantics and reaches a distinct
+// CGExpr visitor for CK_LValueToRValueBitCast. Generic representation reads
+// must reject a wrapper containing a carrier on the source side.
+typedef __objc3_optional(int) OptionalInt;
+struct CarrierWrapper { OptionalInt value; };
+struct PlainBlob { unsigned long long bits; };
+
+#if defined(TEST_SCALAR)
+unsigned long long expose_scalar_representation(CarrierWrapper &value) {
+  return __builtin_bit_cast(unsigned long long, value); // expected-error {{ObjC3 carrier operation 'object representation bitcast'}}
+}
+#elif defined(TEST_AGGREGATE)
+PlainBlob expose_aggregate_representation(CarrierWrapper &value) {
+  return __builtin_bit_cast(PlainBlob, value); // expected-error {{ObjC3 carrier operation 'object representation bitcast'}}
+}
+#elif defined(TEST_COMPLEX)
+__complex__ int expose_complex_representation(CarrierWrapper &value) {
+  return __builtin_bit_cast(__complex__ int, value); // expected-error {{ObjC3 carrier operation 'object representation bitcast'}}
+}
+#endif
