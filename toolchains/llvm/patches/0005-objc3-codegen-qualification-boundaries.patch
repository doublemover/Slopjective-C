+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c11 -DTEST_ATOMIC_BUILTIN_LOAD -emit-llvm -o %t.load.ll -verify %s
+// RUN: test ! -e %t.load.ll
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c11 -DTEST_ATOMIC_LVALUE_DISCARD -emit-llvm -o %t.load-lvalue.ll -verify %s
+// RUN: test ! -e %t.load-lvalue.ll
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c11 -DTEST_ATOMIC_BUILTIN_STORE -emit-llvm -o %t.store.ll -verify %s
+// RUN: test ! -e %t.store.ll
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c11 -DTEST_ATOMIC_LVALUE_STORE -emit-llvm -o %t.lvalue-store.ll -verify %s
+// RUN: test ! -e %t.lvalue-store.ll
+//
+// Atomic operations must not copy inactive carrier payload bytes. External
+// storage keeps local lifetime checks from masking the atomic CodeGen boundary.
+
+typedef __objc3_optional(int) OptionalInt;
+struct Wrapper { OptionalInt value; };
+_Atomic(struct Wrapper) atomic_value;
+extern struct Wrapper source_value;
+
+#if defined(TEST_ATOMIC_BUILTIN_LOAD)
+void atomic_builtin_load(void) {
+  (void)__c11_atomic_load(&atomic_value, __ATOMIC_SEQ_CST); // expected-error {{ObjC3 carrier operation 'atomic access'}}
+}
+#elif defined(TEST_ATOMIC_LVALUE_DISCARD)
+void atomic_lvalue_discard(void) {
+  (void)atomic_value; // expected-error {{ObjC3 carrier operation 'atomic access'}}
+}
+#elif defined(TEST_ATOMIC_BUILTIN_STORE)
+void atomic_builtin_store(void) {
+  __c11_atomic_store(&atomic_value, source_value, __ATOMIC_SEQ_CST); // expected-error {{ObjC3 carrier operation 'atomic access'}}
+}
+#elif defined(TEST_ATOMIC_LVALUE_STORE)
+void atomic_lvalue_store(void) {
+  atomic_value = source_value; // expected-error {{ObjC3 carrier operation 'enclosing aggregate copy'}}
+}
+#endif
