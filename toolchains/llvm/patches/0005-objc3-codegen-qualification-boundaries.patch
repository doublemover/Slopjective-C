+// A noreturn attribute on a virtual declaration is not inherited by an
+// overriding method. An unqualified call through an extensible class may
+// dispatch to an override that returns normally.
+static bool mayCallReturningOverride(const CallExpr *Call) {
+  const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Call->getDirectCallee());
+  if (!Method || !Method->isVirtual() || Method->hasAttr<FinalAttr>() ||
+      Method->getParent()->hasAttr<FinalAttr>())
+    return false;
+  const auto *Member = dyn_cast<MemberExpr>(Call->getCallee()->IgnoreParenImpCasts());
+  return !Member || !Member->hasQualifier();
+}
