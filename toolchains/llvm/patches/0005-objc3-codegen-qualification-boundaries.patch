 namespace {
+QualType findUnqualifiedCarrierDynamicStorage(
+    CodeGenModule &CGM, QualType Type, bool IsDirect,
+    llvm::SmallPtrSetImpl<const clang::Type *> &Seen) {
+  Type = CGM.getContext().getCanonicalType(Type);
+  if (!Seen.insert(Type.getTypePtr()).second)
+    return {};
+  if (isa<ObjC3OptionalType, ObjC3ResultType>(Type.getTypePtr())) {
+    // Source C++ records already have native ARC field special members.
+    // Direct carrier allocations and nontrivial C++ carrier fields need a
+    // separate allocation/placement lifetime adapter before they can use new.
+    if (!supportsPlainObjC3CarrierStorageLifetime(CGM, Type) &&
+        (IsDirect || !supportsObjC3CarrierARCLocalLifetime(CGM, Type)))
+      return Type;
+    return {};
+  }
+  if (const auto *Array = CGM.getContext().getAsArrayType(Type))
+    return findUnqualifiedCarrierDynamicStorage(
+        CGM, Array->getElementType(), IsDirect, Seen);
+  if (const auto *Record = Type->getAs<RecordType>()) {
+    if (supportsObjC3CarrierCppRecordLifetime(CGM, Type))
+      return {};
+    const RecordDecl *RD = Record->getDecl()->getDefinition();
+    if (!RD)
+      return {};
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD))
+      for (const CXXBaseSpecifier &Base : CXX->bases())
+        if (QualType Found = findUnqualifiedCarrierDynamicStorage(
+                CGM, Base.getType(), false, Seen); !Found.isNull())
+          return Found;
+    for (const FieldDecl *Field : RD->fields())
+      if (QualType Found = findUnqualifiedCarrierDynamicStorage(
+              CGM, Field->getType(), false, Seen); !Found.isNull())
+        return Found;
+  }
+  return {};
+}
+
+bool diagnoseUnqualifiedCarrierDynamicStorage(CodeGenModule &CGM, QualType Type,
+                                               SourceLocation Loc,
+                                               const char *Operation) {
+  llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+  QualType Carrier =
+      findUnqualifiedCarrierDynamicStorage(CGM, Type, true, Seen);
+  if (Carrier.isNull())
+    return false;
+  diagnoseUnsupportedObjC3CarrierOperation(CGM, Loc, Carrier, Operation);
+  return true;
+}
