+}
+
+Qualifiers::ObjCLifetime effectiveARCStorageLifetime(QualType T) {
+  switch (T.getObjCLifetime()) {
+  case Qualifiers::OCL_None:
+    // Sema normalizes implicit ARC carrier payload ownership to OCL_Strong.
+    // CodeGen deliberately does not supply that default itself.
+    return Qualifiers::OCL_None;
+  case Qualifiers::OCL_Strong:
+  case Qualifiers::OCL_Weak:
+  case Qualifiers::OCL_ExplicitNone:
+    return T.getObjCLifetime();
+  case Qualifiers::OCL_Autoreleasing:
+    return Qualifiers::OCL_Autoreleasing;
+  }
+  llvm_unreachable("unknown Objective-C lifetime qualifier");
+}
+
+bool isPlainLeaf(ASTContext &Ctx, QualType T, unsigned Depth = 0) {
+  if (T.isNull() || Depth > 64)
+    return false;
+  if (T->isVoidType() || T->isIntegerType() || T->isEnumeralType() ||
+      T->isRealFloatingType())
+    return T.getObjCLifetime() == Qualifiers::OCL_None;
+  if (T->isPointerType())
+    return !T->isObjCObjectPointerType() && !T->isBlockPointerType() &&
+           T.getObjCLifetime() == Qualifiers::OCL_None;
+  if (const auto *RT = T->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    if (isa<CXXRecordDecl>(RD) || !RD->isCompleteDefinition())
+      return false;
+    for (const FieldDecl *Field : RD->fields())
+      if (!isPlainLeaf(Ctx, Field->getType(), Depth + 1))
+        return false;
+    return true;
+  }
+  return false;
+}
+
+bool isARCPointerField(QualType T) {
+  if (!isRetainablePointer(T))
+    return false;
+  switch (effectiveARCStorageLifetime(T)) {
+  case Qualifiers::OCL_Strong:
+  case Qualifiers::OCL_Weak:
+  case Qualifiers::OCL_ExplicitNone:
+    return true;
+  case Qualifiers::OCL_None:
+  case Qualifiers::OCL_Autoreleasing:
+    return false;
+  }
+  return false;
+}
+
+bool isSupportedField(ASTContext &Ctx, QualType T) {
+  if (T.isNull())
+    return true;
+  if (isRetainablePointer(T))
+    return isARCPointerField(T);
+  return isPlainLeaf(Ctx, T);
+}
+
+FieldDecl *getSelectedField(const ObjC3CarrierRepresentationInfo &Info,
+                            ObjC3CarrierPayloadArm Arm) {
+  switch (Arm) {
+  case ObjC3CarrierPayloadArm::Value:
+    return Info.ValueField;
+  case ObjC3CarrierPayloadArm::Success:
+    return Info.SuccessField;
+  case ObjC3CarrierPayloadArm::Error:
+    return Info.ErrorField;
+  }
+  llvm_unreachable("unknown ObjC3 carrier arm");
+}
+
+QualType getSelectedPayloadType(ASTContext &Ctx, QualType CarrierType,
+                                ObjC3CarrierPayloadArm Arm) {
+  const Type *Ty = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  if (Arm == ObjC3CarrierPayloadArm::Value) {
+    if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Ty))
+      return Optional->getElementType();
+    return QualType();
+  }
+  if (const auto *Result = dyn_cast<ObjC3ResultType>(Ty))
+    return Arm == ObjC3CarrierPayloadArm::Success
+               ? Result->getSuccessType()
+               : Result->getErrorType();
+  return QualType();
+}
+
+bool hasLifetime(QualType T, Qualifiers::ObjCLifetime Life) {
+  return isRetainablePointer(T) &&
+         effectiveARCStorageLifetime(T) == Life;
+}
+
+bool emitInitArm(CodeGenFunction &CGF, QualType CarrierType,
+                 Address Destination, ObjC3CarrierPayloadArm Arm,
+                 QualType PayloadType, Expr *Payload,
+                 SourceLocation Loc) {
+  if (!PayloadType->isVoidType()) {
+    auto Info = CGF.getContext().getObjC3CarrierRepresentationType(CarrierType);
+    FieldDecl *Field = getSelectedField(Info, Arm);
+    Address PayloadStorage = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, Arm);
+    if (!Field || !PayloadStorage.isValid())
+      return false;
+
+    QualType FieldType = Field->getType();
+    if (isRetainablePointer(FieldType)) {
+      Qualifiers::ObjCLifetime Life = effectiveARCStorageLifetime(FieldType);
+      if (Life == Qualifiers::OCL_None ||
+          Life == Qualifiers::OCL_Autoreleasing)
+        return false;
+      // Feed Clang's normal ARC scalar initializer with the AST-established
+      // field ownership. This preserves retain/autorelease and weak-init rules.
+      LValue PayloadLV = CGF.MakeAddrLValue(PayloadStorage, FieldType);
+      CGF.EmitScalarInit(Payload, /*D=*/nullptr, PayloadLV,
+                         /*capturedByInit=*/false);
+    } else {
+      // Only plain native fields arrive here. ARC subobjects within C/C++
+      // aggregates were rejected by the field classifier above.
+      CGF.EmitAnyExprToMem(Payload, PayloadStorage,
+                           FieldType.getQualifiers(), /*IsInit=*/true);
+    }
+  } else if (Payload) {
+    // A void arm has presence but no storage; evaluate its effect before the
+    // tag is committed, preserving the expression's full-expression cleanup.
+    (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(),
+                          /*ignoreResult=*/true);
+  }
+
+  const bool Engaged = Arm != ObjC3CarrierPayloadArm::Error;
+  return emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                  CGF.Builder.getInt1(Engaged),
+                                  /*IsInitialization=*/true,
+                                  /*IsVolatile=*/false);
+}
+
+bool emitARCLocalExpr(CodeGenFunction &CGF, QualType CarrierType,
+                      Address Destination, bool IsLocalInitialization,
+                      bool DestinationIsIgnored, bool DestinationIsVolatile,
+                      Expr *Payload, ObjC3CarrierPayloadArm Arm,
+                      bool IsNone, SourceLocation Loc) {
+  if (!containsObjC3CarrierARCPayload(CGF.CGM, CarrierType))
+    return false;
+  if (!supportsObjC3CarrierARCLocalLifetime(CGF.CGM, CarrierType) ||
+      !IsLocalInitialization || DestinationIsIgnored ||
+      DestinationIsVolatile || !Destination.isValid()) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, CarrierType, "ARC carrier local initialization");
+    return true;
+  }
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      Destination.getElementType() != Layout.StorageType ||
+      !CGF.isObjC3CarrierLocalInitialization(Destination, CarrierType)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, CarrierType, "ARC carrier destination context");
+    return true;
+  }
+
+  if (!IsNone && !emitInitArm(CGF, CarrierType, Destination, Arm,
+                              getSelectedPayloadType(CGF.getContext(),
+                                                     CarrierType, Arm),
+                              Payload, Loc)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, CarrierType, "ARC carrier selected payload init");
+  } else if (IsNone &&
+             !emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                       CGF.Builder.getInt1(false),
+                                       /*IsInitialization=*/true,
+                                       /*IsVolatile=*/false)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, CarrierType, "ARC carrier None tag init");
+  }
+  return true;
+}
+
+} // namespace
+
+namespace {
+bool isARCInitializer(const Expr *E) {
+  if (!E)
+    return false;
+  while (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+    E = Cleanups->getSubExpr();
+  E = E->IgnoreParenImpCasts();
+  if (E->getType().isVolatileQualified())
+    return false;
+  if (E->isGLValue() || isa<ObjC3CarrierTransferExpr, CallExpr>(E))
+    return true;
+  if (const auto *Optional = dyn_cast<ObjC3OptionalExpr>(E))
+    return Optional->getKind() == ObjC3OptionalExpr::Kind::Some ||
+           Optional->getKind() == ObjC3OptionalExpr::Kind::None;
+  if (const auto *Result = dyn_cast<ObjC3ResultExpr>(E))
+    return Result->getKind() == ObjC3ResultExpr::Kind::Ok ||
+           Result->getKind() == ObjC3ResultExpr::Kind::Err;
+  if (const auto *Try = dyn_cast<ObjC3TryExpr>(E))
+    return Try->getKind() == ObjC3TryExpr::Kind::Optionalize;
+  if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+    return Binary->getOpcode() == BO_Assign;
+  if (const auto *Conditional = dyn_cast<ConditionalOperator>(E))
+    return isARCInitializer(Conditional->getTrueExpr()) &&
+           isARCInitializer(Conditional->getFalseExpr());
+  return false;
+}
+
+struct DestroyARCSnapshot final : EHScopeStack::Cleanup {
+  QualType Type;
+  Address Storage;
+  DestroyARCSnapshot(QualType Type, Address Storage)
+      : Type(Type), Storage(Storage) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    emitObjC3CarrierDestroyActiveARCPayload(
+        CGF, Type, Storage, /*PreciseLifetime=*/true,
+        /*DestroyStrong=*/true, /*DestroyWeak=*/true);
+  }
+};
+
+// Both endpoints are distinct, fresh storage here. Move is used only to consume
+// an internal snapshot, never to change the source-level copy contract.
+void emitARCSelectedInit(CodeGenFunction &CGF, QualType Type,
+                         Address Destination, Address Source, bool Move,
+                         SourceLocation Loc) {
+  auto Info = CGF.getContext().getObjC3CarrierRepresentationType(Type);
+  auto EmitArm = [&](FieldDecl *Field, ObjC3CarrierPayloadArm Arm) {
+    if (!Field || Field->getType()->isVoidType())
+      return;
+    QualType PayloadType = Field->getType();
+    Address Src = getObjC3CarrierPayloadAddress(CGF, Source, Type, Arm);
+    Address Dst = getObjC3CarrierPayloadAddress(CGF, Destination, Type, Arm);
+    if (isRetainablePointer(PayloadType)) {
+      if (effectiveARCStorageLifetime(PayloadType) == Qualifiers::OCL_Weak) {
+        if (Move)
+          CGF.EmitARCMoveWeak(Dst, Src);
+        else
+          CGF.EmitARCCopyWeak(Dst, Src);
+        return;
+      }
+      llvm::Value *Value = CGF.EmitLoadOfScalar(Src, false, PayloadType, Loc);
+      if (effectiveARCStorageLifetime(PayloadType) == Qualifiers::OCL_Strong) {
+        if (!Move)
+          Value = CGF.EmitARCRetain(PayloadType, Value);
+        else
+          CGF.EmitStoreOfScalar(llvm::Constant::getNullValue(Value->getType()),
+                                Src, false, PayloadType,
+                                AlignmentSource::Type, false);
+      }
+      CGF.EmitStoreOfScalar(Value, Dst, false, PayloadType,
+                            AlignmentSource::Type, true);
+      return;
+    }
+    bool Emitted = emitObjC3CarrierCopyPayload(
+        CGF, PayloadType, Dst, Src, false, false, true, Loc);
+    assert(Emitted && "admitted plain ARC carrier arm must copy");
+    (void)Emitted;
+  };
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(CGF, Source, Type, Loc, false);
+  llvm::BasicBlock *Active = CGF.createBasicBlock("objc3.arc.copy.active");
+  llvm::BasicBlock *Inactive = CGF.createBasicBlock("objc3.arc.copy.inactive");
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.arc.copy.done");
+  CGF.Builder.CreateCondBr(Tag, Active, Inactive);
+  CGF.EmitBlock(Active);
+  EmitArm(Info.ValueField ? Info.ValueField : Info.SuccessField,
+          Info.ValueField ? ObjC3CarrierPayloadArm::Value
+                          : ObjC3CarrierPayloadArm::Success);
+  emitObjC3CarrierStoreTag(CGF, Destination, Type, CGF.Builder.getTrue(), true,
+                           false);
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Inactive);
+  EmitArm(Info.ErrorField, ObjC3CarrierPayloadArm::Error);
+  emitObjC3CarrierStoreTag(CGF, Destination, Type, CGF.Builder.getFalse(), true,
+                           false);
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+}
+} // namespace
+
+bool CodeGen::isObjC3CarrierARCLocalInitializer(CodeGenModule &CGM,
+                                                const VarDecl &D) {
+  return !D.getType().isVolatileQualified() && D.getInit() &&
+         CGM.getContext().hasSameUnqualifiedType(D.getType(),
+                                                 D.getInit()->getType()) &&
+         isARCInitializer(D.getInit());
+}
+
+bool CodeGen::supportsObjC3CarrierARCCallABI(CodeGenModule &CGM,
+                                           QualType CarrierType) {
+  const auto &Triple = CGM.getTarget().getTriple();
+  return Triple.getArch() == llvm::Triple::x86_64 && Triple.isOSLinux() &&
+         Triple.isGNUEnvironment() &&
+         CGM.getTarget().getCXXABI().isItaniumFamily() &&
+         !CarrierType.isVolatileQualified() &&
+         supportsObjC3CarrierARCLocalLifetime(CGM, CarrierType);
+}
+
+void CodeGen::emitObjC3CarrierARCValueInit(CodeGenFunction &CGF, const Expr *E,
+                                          Address Destination) {
+  auto Saved = CGF.getObjC3CarrierLocalInitState();
+  QualType Type = CGF.getContext().getCanonicalType(E->getType()).getUnqualifiedType();
+  CGF.setObjC3CarrierLocalInitState({Destination, Type});
+  CGF.EmitAnyExprToMem(E, Destination, Qualifiers(), /*IsInit=*/true);
+  CGF.setObjC3CarrierLocalInitState(Saved);
+}
+
+void CodeGen::pushObjC3CarrierARCTemporaryCleanup(CodeGenFunction &CGF,
+                                                QualType Type,
+                                                Address Storage) {
+  CGF.pushFullExprCleanup<DestroyARCSnapshot>(NormalAndEHCleanup, Type, Storage);
+}
+
+bool CodeGen::emitObjC3CarrierARCCopy(
+    CodeGenFunction &CGF, QualType CarrierType, Address Destination,
+    Address Source, bool DestinationIsVolatile, bool SourceIsVolatile,
+    bool IsInitialization, SourceLocation Loc) {
+  if (!containsObjC3CarrierARCPayload(CGF.CGM, CarrierType))
+    return false;
+  CarrierType = CGF.getContext().getCanonicalType(CarrierType).getUnqualifiedType();
+  ObjC3CarrierStorageLayout Layout;
+  if (!supportsObjC3CarrierARCLocalLifetime(CGF.CGM, CarrierType) ||
+      DestinationIsVolatile || SourceIsVolatile ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || !Source.isValid() || Destination.isSigned() ||
+      Source.isSigned() || Destination.getElementType() != Layout.StorageType ||
+      Source.getElementType() != Layout.StorageType) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "ARC carrier copy");
+    return true;
+  }
+  if (IsInitialization) {
+    if (!CGF.isObjC3CarrierLocalInitialization(Destination, CarrierType)) {
+      diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                               "ARC carrier copy destination");
+      return true;
+    }
+    emitARCSelectedInit(CGF, CarrierType, Destination, Source, false, Loc);
+    return true;
+  }
+  Address Snapshot = CGF.CreateMemTemp(CarrierType.getUnqualifiedType(),
+                                       "objc3.arc.copy.snapshot");
+  emitARCSelectedInit(CGF, CarrierType, Snapshot, Source, false, Loc);
+  emitObjC3CarrierDestroyActiveARCPayload(CGF, CarrierType, Destination, true,
+                                          true, true);
+  emitARCSelectedInit(CGF, CarrierType, Destination, Snapshot, true, Loc);
+  emitObjC3CarrierDestroyActiveARCPayload(CGF, CarrierType, Snapshot, true,
+                                          true, true);
+  return true;
+}
+
+LValue CodeGen::emitObjC3CarrierARCAssignment(CodeGenFunction &CGF,
+                                             const BinaryOperator &E) {
+  QualType Type = CGF.getContext().getCanonicalType(E.getType()).getUnqualifiedType();
+  if (!supportsObjC3CarrierARCLocalLifetime(CGF.CGM, Type) ||
+      E.getLHS()->getType().isVolatileQualified() ||
+      !isARCInitializer(E.getRHS())) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, E.getOperatorLoc(), Type,
+                                             "ARC carrier assignment");
+    return CGF.MakeAddrLValue(CGF.CreateMemTemp(Type), Type);
+  }
+
+  CodeGenFunction::RunCleanupsScope Scope(CGF);
+  Address Snapshot = CGF.CreateMemTemp(Type, "objc3.arc.assign.snapshot");
+  auto Saved = CGF.getObjC3CarrierLocalInitState();
+  CGF.setObjC3CarrierLocalInitState({Snapshot, Type});
+  CGF.EmitAnyExprToMem(E.getRHS(), Snapshot, Qualifiers(), /*IsInit=*/true);
+  CGF.setObjC3CarrierLocalInitState(Saved);
+  // The LHS can throw (for example, a call returning a reference). Register
+  // cleanup only after the entire selected RHS has initialized successfully.
+  CGF.EHStack.pushCleanup<DestroyARCSnapshot>(NormalAndEHCleanup, Type, Snapshot);
+  LValue LHS = CGF.EmitCheckedLValue(E.getLHS(), CodeGenFunction::TCK_Store);
+  emitObjC3CarrierDestroyActiveARCPayload(CGF, Type, LHS.getAddress(), true,
+                                          true, true);
+  emitARCSelectedInit(CGF, Type, LHS.getAddress(), Snapshot, true,
+                      E.getOperatorLoc());
+  return LHS;
+}
+
+bool CodeGen::containsObjC3CarrierARCPayload(CodeGenModule &CGM,
+                                             QualType CarrierType) {
+  ASTContext &Ctx = CGM.getContext();
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  if (!isa<ObjC3OptionalType>(Canonical) && !isa<ObjC3ResultType>(Canonical))
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  auto IsObjCPointer = [](FieldDecl *Field) {
+    return Field && isRetainablePointer(Field->getType());
+  };
+  return IsObjCPointer(Info.ValueField) || IsObjCPointer(Info.SuccessField) ||
+         IsObjCPointer(Info.ErrorField);
+}
+
+bool CodeGen::supportsObjC3CarrierARCLocalLifetime(CodeGenModule &CGM,
+                                                   QualType CarrierType) {
+  if (!CGM.getLangOpts().ObjCAutoRefCount ||
+      !containsObjC3CarrierARCPayload(CGM, CarrierType))
+    return false;
+  ASTContext &Ctx = CGM.getContext();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return false;
+  return isSupportedField(Ctx, Info.ValueField ? Info.ValueField->getType()
+                                               : QualType()) &&
+         isSupportedField(Ctx, Info.SuccessField ? Info.SuccessField->getType()
+                                                 : QualType()) &&
+         isSupportedField(Ctx, Info.ErrorField ? Info.ErrorField->getType()
+                                               : QualType());
+}
+
+bool CodeGen::hasObjC3CarrierARCCleanup(CodeGenModule &CGM,
+                                         QualType CarrierType) {
+  return hasObjC3CarrierStrongPayload(CGM, CarrierType) ||
+         hasObjC3CarrierWeakPayload(CGM, CarrierType);
+}
+
+bool CodeGen::hasObjC3CarrierStrongPayload(CodeGenModule &CGM,
+                                            QualType CarrierType) {
+  if (!supportsObjC3CarrierARCLocalLifetime(CGM, CarrierType))
+    return false;
+  auto Info = CGM.getContext().getObjC3CarrierRepresentationType(CarrierType);
+  return hasLifetime(Info.ValueField ? Info.ValueField->getType() : QualType(),
+                     Qualifiers::OCL_Strong) ||
+         hasLifetime(Info.SuccessField ? Info.SuccessField->getType()
+                                       : QualType(),
+                     Qualifiers::OCL_Strong) ||
+         hasLifetime(Info.ErrorField ? Info.ErrorField->getType() : QualType(),
+                     Qualifiers::OCL_Strong);
+}
+
+bool CodeGen::hasObjC3CarrierWeakPayload(CodeGenModule &CGM,
+                                          QualType CarrierType) {
+  if (!supportsObjC3CarrierARCLocalLifetime(CGM, CarrierType))
+    return false;
+  auto Info = CGM.getContext().getObjC3CarrierRepresentationType(CarrierType);
+  return hasLifetime(Info.ValueField ? Info.ValueField->getType() : QualType(),
+                     Qualifiers::OCL_Weak) ||
+         hasLifetime(Info.SuccessField ? Info.SuccessField->getType()
+                                       : QualType(),
+                     Qualifiers::OCL_Weak) ||
+         hasLifetime(Info.ErrorField ? Info.ErrorField->getType() : QualType(),
+                     Qualifiers::OCL_Weak);
+}
+
+bool CodeGen::emitObjC3OptionalARCLocalExpr(
+    CodeGenFunction &CGF, const ObjC3OptionalExpr &E, Address Destination,
+    bool IsLocalInitialization, bool DestinationIsIgnored,
+    bool DestinationIsVolatile) {
+  const bool IsNone = E.getKind() == ObjC3OptionalExpr::Kind::None;
+  return emitARCLocalExpr(
+      CGF, E.getCarrierType(), Destination, IsLocalInitialization,
+      DestinationIsIgnored, DestinationIsVolatile, E.getPayload(),
+      ObjC3CarrierPayloadArm::Value, IsNone, E.getKeywordLoc());
+}
+
+bool CodeGen::emitObjC3ResultARCLocalExpr(
+    CodeGenFunction &CGF, const ObjC3ResultExpr &E, Address Destination,
+    bool IsLocalInitialization, bool DestinationIsIgnored,
+    bool DestinationIsVolatile) {
+  const bool IsErr = E.getKind() == ObjC3ResultExpr::Kind::Err;
+  const ObjC3CarrierPayloadArm Arm = IsErr ? ObjC3CarrierPayloadArm::Error
+                                           : ObjC3CarrierPayloadArm::Success;
+  return emitARCLocalExpr(
+      CGF, E.getCarrierType(), Destination, IsLocalInitialization,
+      DestinationIsIgnored, DestinationIsVolatile, E.getPayload(), Arm,
+      /*IsNone=*/false, E.getKeywordLoc());
+}
+
+llvm::Value *CodeGen::emitObjC3CarrierARCTagQuery(
+    CodeGenFunction &CGF, QualType CarrierType, Expr *Operand, bool IsResult,
+    SourceLocation Loc) {
+  auto Fail = [&]() -> llvm::Value * {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, Loc, CarrierType, IsResult ? "isOk query" : "hasValue query");
+    return llvm::PoisonValue::get(CGF.ConvertType(CGF.getContext().BoolTy));
+  };
+  const Type *Canonical =
+      CGF.getContext().getCanonicalType(CarrierType).getTypePtr();
+  if (!supportsObjC3CarrierARCLocalLifetime(CGF.CGM, CarrierType) ||
+      IsResult != isa<ObjC3ResultType>(Canonical) ||
+      !Operand ||
+      Operand->getType().isVolatileQualified())
+    return Fail();
+  Address Storage = Address::invalid();
+  if (Operand->isGLValue()) {
+    if (const auto *Ref = dyn_cast<DeclRefExpr>(Operand->IgnoreParenCasts()))
+      if (const auto *VD = dyn_cast<VarDecl>(Ref->getDecl()))
+        if (!isa<ParmVarDecl>(VD) && VD->isLocalVarDecl() &&
+            !VD->hasGlobalStorage() &&
+            !isObjC3CarrierARCLocalInitializer(CGF.CGM, *VD))
+          return Fail();
+    // Borrow initialized storage. By-value parameters are caller-owned slots;
+    // reference and pointer views use the same active-tag read.
+    Storage = CGF.EmitLValue(Operand).getAddress();
+  } else {
+    if (!isa<CallExpr>(Operand->IgnoreParenImpCasts()) ||
+        !supportsObjC3CarrierARCCallABI(CGF.CGM, CarrierType))
+      return Fail();
+    Storage = CGF.CreateMemTemp(CarrierType, "objc3.arc.query.return");
+    emitObjC3CarrierARCValueInit(CGF, Operand, Storage);
+    pushObjC3CarrierARCTemporaryCleanup(CGF, CarrierType, Storage);
+  }
+  if (!Storage.isValid())
+    return Fail();
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, Storage, CarrierType, Loc, /*IsVolatile=*/false);
+  if (!Tag)
+    return Fail();
+  (void)IsResult; // Both supported queries read the explicit active tag.
+  return Tag;
+}
+void CodeGen::emitObjC3CarrierDestroyActiveARCPayload(
+    CodeGenFunction &CGF, QualType CarrierType, Address Storage,
+    bool PreciseLifetime, bool DestroyStrong, bool DestroyWeak) {
+  ASTContext &Ctx = CGF.getContext();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  const Type *Canonical = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const bool IsOptional = isa<ObjC3OptionalType>(Canonical);
+  const bool IsResult = isa<ObjC3ResultType>(Canonical);
+  assert((IsOptional || IsResult) &&
+         supportsObjC3CarrierARCLocalLifetime(CGF.CGM, CarrierType));
+
+  llvm::Value *Tag = emitObjC3CarrierLoadTag(
+      CGF, Storage, CarrierType, SourceLocation(), /*IsVolatile=*/false);
+  assert(Tag && "admitted ARC carrier has a readable tag");
+  auto HasSelectedCleanup = [&](FieldDecl *Field) {
+    if (!Field)
+      return false;
+    Qualifiers::ObjCLifetime Life = effectiveARCStorageLifetime(Field->getType());
+    return (DestroyStrong && Life == Qualifiers::OCL_Strong) ||
+           (DestroyWeak && Life == Qualifiers::OCL_Weak);
+  };
+  const bool SuccessDestroys =
+      HasSelectedCleanup(Info.ValueField) ||
+      HasSelectedCleanup(Info.SuccessField);
+  const bool ErrorDestroys = HasSelectedCleanup(Info.ErrorField);
+  if (!SuccessDestroys && !ErrorDestroys)
+    return;
+
+  auto Destroy = [&](ObjC3CarrierPayloadArm Arm) {
+    FieldDecl *Field = getSelectedField(Info, Arm);
+    if (!Field || !HasSelectedCleanup(Field))
+      return;
+    Address Payload = getObjC3CarrierPayloadAddress(CGF, Storage,
+                                                    CarrierType, Arm);
+    assert(Payload.isValid());
+    switch (effectiveARCStorageLifetime(Field->getType())) {
+    case Qualifiers::OCL_Strong:
+      CGF.EmitARCDestroyStrong(
+          Payload, PreciseLifetime ? ARCPreciseLifetime : ARCImpreciseLifetime);
+      break;
+    case Qualifiers::OCL_Weak:
+      CGF.EmitARCDestroyWeak(Payload);
+      break;
+    case Qualifiers::OCL_ExplicitNone:
+    case Qualifiers::OCL_None:
+    case Qualifiers::OCL_Autoreleasing:
+      llvm_unreachable("non-owning/unsupported payload has no ARC cleanup");
+    }
+  };
+
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.arc.carrier.destroy.done");
+  if (IsOptional) {
+    if (SuccessDestroys) {
+      llvm::BasicBlock *Present =
+          CGF.createBasicBlock("objc3.arc.optional.destroy.present");
+      CGF.Builder.CreateCondBr(Tag, Present, Done);
+      CGF.EmitBlock(Present);
+      Destroy(ObjC3CarrierPayloadArm::Value);
+      CGF.Builder.CreateBr(Done);
+    } else {
+      CGF.Builder.CreateBr(Done);
+    }
+  } else if (SuccessDestroys && ErrorDestroys) {
+    llvm::BasicBlock *Success =
+        CGF.createBasicBlock("objc3.arc.result.destroy.success");
+    llvm::BasicBlock *Error =
+        CGF.createBasicBlock("objc3.arc.result.destroy.error");
+    CGF.Builder.CreateCondBr(Tag, Success, Error);
+    CGF.EmitBlock(Success);
+    Destroy(ObjC3CarrierPayloadArm::Success);
+    CGF.Builder.CreateBr(Done);
+    CGF.EmitBlock(Error);
+    Destroy(ObjC3CarrierPayloadArm::Error);
+    CGF.Builder.CreateBr(Done);
+  } else if (SuccessDestroys || ErrorDestroys) {
+    ObjC3CarrierPayloadArm Arm = SuccessDestroys
+                                     ? ObjC3CarrierPayloadArm::Success
+                                     : ObjC3CarrierPayloadArm::Error;
+    llvm::BasicBlock *Selected =
+        CGF.createBasicBlock("objc3.arc.result.destroy.selected");
+    CGF.Builder.CreateCondBr(Tag, SuccessDestroys ? Selected : Done,
+                             ErrorDestroys ? Selected : Done);
+    CGF.EmitBlock(Selected);
+    Destroy(Arm);
+    CGF.Builder.CreateBr(Done);
+  }
+  CGF.EmitBlock(Done);
+}
+
+
+
+
+
