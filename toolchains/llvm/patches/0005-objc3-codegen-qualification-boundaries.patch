+bool CFGBuilder::supportsDeferredNativeEH(const Stmt *Statement,
+                                         bool FullExpressionTemporary) const {
+  if (!Statement)
+    return true;
+  if (const auto *Resource = dyn_cast<ObjC3ResourceExpr>(Statement)) {
+    const VarDecl *Variable = Resource->getResourceVariable();
+    return Variable && Variable->hasAttr<ObjCResourceAttr>() &&
+           supportsDeferredNativeEH(Resource->getOperand(),
+                                    FullExpressionTemporary) &&
+           supportsDeferredNativeEH(Resource->getReplacement(),
+                                    FullExpressionTemporary);
+  }
+  if (const auto *Coalesce = dyn_cast<ObjC3CoalesceExpr>(Statement))
+    return Coalesce->getSemanticExpr() &&
+           supportsDeferredNativeEH(Coalesce->getSemanticExpr());
+  if (const auto *Access = dyn_cast<ObjC3OptionalAccessExpr>(Statement))
+    // ARC owns a receiver snapshot whose implicit release needs its own
+    // cleanup region. MRC uses the ordinary semantic conditional directly.
+    return Access->getSemanticExpr() &&
+           !Context->getLangOpts().ObjCAutoRefCount &&
+           supportsDeferredNativeEH(Access->getSemanticExpr());
+  if (isa<ObjC3MatchExpr, ObjC3MatchStmt>(Statement)) {
+    const auto *Expression = dyn_cast<ObjC3MatchExpr>(Statement);
+    const auto *MatchStatement = dyn_cast<ObjC3MatchStmt>(Statement);
+    const Expr *Source = Expression ? Expression->getScrutinee()
+                                    : MatchStatement->getScrutinee();
+    if (!supportsObjC3MatchStorage(Source->getType()) ||
+        containsFullExpressionTemporary(Source) ||
+        !supportsDeferredNativeEH(Source) ||
+        (Expression && !supportsObjC3MatchStorage(Expression->getType())))
+      return false;
+    auto SupportsArmExpression = [&](const Expr *Body) {
+      if (!Body)
+        return true;
+      if (isa<ExprWithCleanups>(Body))
+        return supportsDeferredNativeEH(Body);
+      DeferredTemporaryMap Pending;
+      return collectDeferredTemporaryCleanups(Body, Pending) &&
+             (Pending.empty() ||
+              (BuildOpts.AddImplicitDtors && BuildOpts.AddTemporaryDtors)) &&
+             supportsDeferredNativeEH(Body, !Pending.empty());
+    };
+    unsigned Count = Expression ? Expression->getNumArms()
+                                : MatchStatement->getNumArms();
+    for (unsigned I = 0; I != Count; ++I) {
+      const ObjC3MatchArm *Arm = Expression ? Expression->getArm(I)
+                                           : MatchStatement->getArm(I);
+      if ((Arm->getBindingDecl() &&
+           !supportsObjC3MatchStorage(Arm->getBindingDecl()->getType())) ||
+          !supportsDeferredNativeEH(Arm->getBindingStatement()) ||
+          !SupportsArmExpression(Arm->getGuard()))
+        return false;
+      if (const auto *Body = dyn_cast<Expr>(Arm->getBody())) {
+        if (!SupportsArmExpression(Body))
+          return false;
+      } else if (!supportsDeferredNativeEH(Arm->getBody()))
+        return false;
+    }
+    return true;
+  }
+  // Partial arrays, full-expression temporaries and managed runtime cleanups
+  // still need registration-aware unwind models. Refuse them rather than
+  // routing an unwind around their cleanup or an already registered action.
+  if ((isa<CXXBindTemporaryExpr>(Statement) && !FullExpressionTemporary) ||
+      isa<ObjCAutoreleasePoolStmt,
+          ObjCAtSynchronizedStmt, ObjCAtFinallyStmt, ObjCForCollectionStmt,
+          SEHTryStmt>(Statement))
+    return false;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement))
+    return !Typeid->isPotentiallyEvaluated() ||
+           supportsDeferredNativeEH(Typeid->getExprOperand(),
+                                    FullExpressionTemporary);
+  if (const auto *Return = dyn_cast<ReturnStmt>(Statement))
+    if (const Expr *Value = Return->getRetValue())
+      if (Value->getType()->isBlockPointerType() && !isObjC3SimpleBlockInitializer(Value))
+        return false;
+  if (const auto *Block = dyn_cast<BlockExpr>(Statement))
+    return supportsObjC3SimpleBlockCaptures(Block);
+  if (const auto *Expression = dyn_cast<Expr>(Statement)) {
+    QualType Type = Expression->getType();
+    bool BlockValue = Type->isBlockPointerType();
+    bool BlockLoad = isa<DeclRefExpr>(Expression);
+    if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Expression))
+      BlockLoad |= Cast->getCastKind() == CK_LValueToRValue;
+    bool BlockWrapper = isa<ExprWithCleanups, ParenExpr>(Expression) ||
+                        isObjC3SimpleBlockInitializer(Expression);
+    if (Expression->isTypeDependent() || (BlockValue && !BlockLoad && !BlockWrapper) ||
+        containsObjC3CarrierThrowingCopy(Type))
+      return false;
+  }
+  if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Statement)) {
+    DeferredTemporaryMap Pending;
+    if (!collectDeferredTemporaryCleanups(Cleanups->getSubExpr(), Pending))
+      return false;
+    if (!Pending.empty() &&
+        (!BuildOpts.AddImplicitDtors || !BuildOpts.AddTemporaryDtors))
+      return false;
+    return supportsDeferredNativeEH(Cleanups->getSubExpr(), !Pending.empty());
+  }
+  if (const auto *New = dyn_cast<CXXNewExpr>(Statement)) {
+    // A failed initializer must call the matching deallocator; arrays must
+    // additionally destroy their constructed prefix. Neither sequence is yet
+    // represented. Plain scalar allocation has a complete operation boundary.
+    if (New->isArray() ||
+        !isNonThrowingNewInitializer(New->getInitializer()) ||
+        (New->getInitializer() && New->shouldNullCheckAllocation()))
+      return false;
+  }
+  if (const auto *Delete = dyn_cast<CXXDeleteExpr>(Statement)) {
+    QualType Type = Delete->getDestroyedType();
+    if (Type.isNull() || Type->isDependentType() ||
+        (Delete->isArrayForm() &&
+         Context->getBaseElementType(Type)->isRecordType()))
+      return false;
+    if (const auto *Record = Type->getAsCXXRecordDecl())
+      if (const CXXDestructorDecl *Destructor = Record->getDestructor())
+        if (Destructor->isCalledByDelete(Delete->getOperatorDelete()) &&
+            mayThrowNative(Destructor))
+          return false; // Deallocation after a failed destructor is implicit.
+  }
+  if (const auto *Catch = dyn_cast<CXXCatchStmt>(Statement))
+    if (const VarDecl *Exception = Catch->getExceptionDecl())
+      if (!Exception->getType()->isReferenceType())
+        if (const auto *Record = Exception->getType()->getAsCXXRecordDecl())
+          if (!hasTrivialDestructor(Exception) ||
+              !Record->hasTrivialCopyConstructor())
+            return false; // The handler's exception-object copy is implicit.
+  if (const auto *Catch = dyn_cast<ObjCAtCatchStmt>(Statement))
+    if (const VarDecl *Exception = Catch->getCatchParamDecl())
+      if (Exception->getType().isDestructedType() != QualType::DK_none)
+        return false; // ARC's implicit catch binding cleanup is not a call.
+  if (const auto *Throw = dyn_cast<CXXThrowExpr>(Statement))
+    if (const Expr *Operand = Throw->getSubExpr())
+      if (const auto *Record = Operand->getType()->getAsCXXRecordDecl())
+        if (!Record->hasTrivialDestructor())
+          return false; // Exception-object destruction is not a local action.
+  if (const auto *Initializer = dyn_cast<InitListExpr>(Statement))
+    if (const auto *Record = Initializer->getType()->getAsCXXRecordDecl())
+      if (!Record->hasTrivialDestructor() &&
+          !isNonThrowingNewInitializer(Initializer))
+        return false; // A failed aggregate must destroy its completed fields.
+  if (const auto *Declarations = dyn_cast<DeclStmt>(Statement))
+    for (const Decl *Declaration : Declarations->decls())
+      if (const auto *Variable = dyn_cast<VarDecl>(Declaration)) {
+        QualType Type = Variable->getType();
+        bool SimpleBlock = Type->isBlockPointerType() &&
+                           isObjC3SimpleBlockInitializer(Variable->getInit());
+        // The native initializer guard protects ownership acquired before a
+        // full-expression temporary throws on destruction. Its conditional
+        // registration has no EH CFG element yet.
+        if (Variable->hasAttr<ObjC3LifetimeBindingAttr>() &&
+            containsFullExpressionTemporary(Variable->getInit()))
+          return false;
+        if (Type->isDependentType() ||
+            hasObjC3CarrierDestructor(Variable) ||
+            ((Variable->hasAttr<CleanupAttr>() ||
+              Variable->hasAttr<ObjCCleanupAttr>()) &&
+             !hasTrivialDestructor(Variable)) ||
+            (needsAutomaticDestruction(Variable) &&
+             !BuildOpts.AddImplicitDtors &&
+             !Variable->hasAttr<ObjCResourceAttr>() &&
+             !Variable->hasAttr<ObjCCleanupAttr>() &&
+             !Variable->hasAttr<ObjC3LifetimeBindingAttr>() &&
+             !hasObjC3ARCObjectLifetime(Variable)) ||
+            (Type->isReferenceType() && !hasTrivialDestructor(Variable)) ||
+            (Type->isBlockPointerType() && !SimpleBlock) ||
+            containsObjC3CarrierThrowingCopy(Type))
+          return false;
+        if (Type->isArrayType() && !hasTrivialDestructor(Variable)) {
+          const auto *Array = Context->getAsConstantArrayType(Type);
+          const auto *Record =
+              Context->getBaseElementType(Type)->getAsCXXRecordDecl();
+          // The existing automatic-object dtor represents the whole array.
+          // A singleton is equivalent to scalar cleanup. Larger arrays are
+          // sufficient when construction cannot fail partway and every element
+          // destructor is nonthrowing. Partial construction and a second
+          // exception during destruction still need an element representation.
+          bool SingleElement =
+              Array && Context->getConstantArrayElementCount(Array) == 1;
+          if (!Array || !Record ||
+              (!SingleElement &&
+               (mayThrowNative(Record->getDestructor()) ||
+                !isNonThrowingNewInitializer(Variable->getInit()) ||
+                (!Variable->getInit() &&
+                 !Record->hasTrivialDefaultConstructor()))))
+            return false;
+        }
+        // Native C++ cleanup is modeled below. ARC releases and managed C
+        // record cleanup have their own recipes and remain explicitly gated.
+        auto Destruction = Type.isDestructedType();
+        if (Destruction != QualType::DK_none &&
+            Destruction != QualType::DK_cxx_destructor &&
+            !Variable->hasAttr<ObjC3LifetimeBindingAttr>() && !SimpleBlock &&
+            !hasObjC3ARCObjectLifetime(Variable))
+          return false;
+      }
+  if (const auto *Call = dyn_cast<CallExpr>(Statement))
+    if (const auto *Callee = Call->getDirectCallee())
+      if (Callee->getIdentifier() && (Callee->getName() == "longjmp" ||
+                                      Callee->getName() == "siglongjmp" ||
+                                      Callee->getName() == "__builtin_longjmp"))
+        return false;
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement))
+    return isNonThrowingNewInitializer(Argument->getExpr()) &&
+           supportsDeferredNativeEH(Argument->getExpr());
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement))
+    return isNonThrowingNewInitializer(Initializer->getExpr()) &&
+           supportsDeferredNativeEH(Initializer->getExpr());
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    if (!Lambda->getLambdaClass()->hasTrivialDestructor())
+      return false; // A failed capture must destroy its completed prefix.
+    for (const Expr *Capture : Lambda->capture_inits())
+      if (containsFullExpressionTemporary(Capture) ||
+          !supportsDeferredNativeEH(Capture))
+        return false;
+    return true;
+  }
+  if (isa<BlockExpr>(Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (!supportsDeferredNativeEH(Child, FullExpressionTemporary))
+      return false;
+  return true;
+}
+
+const FunctionDecl *CFGObjC3ResourceAction::getCloseFunction() const {
+  const auto *Call = cast<CallExpr>(getResourceAttr()->getCall());
+  return Call->getDirectCallee();
+}
+
+CFGBlock *CFGBuilder::resourceNativeExceptionEntry(
+    const VarDecl *Variable, Stmt *Trigger, bool InvalidateOnException) {
+  CFGBlock *Destination = EmittingNativeUnwind
+                              ? getDeferredTerminateBlock()
+                              : deferredNativeExceptionEntry(Trigger);
+  if (!InvalidateOnException)
+    return Destination;
+  SaveAndRestore SaveBlock(Block), SaveSucc(Succ);
+  Block = createBlock(false);
+  Block->appendObjC3Resource(CFGElement::ObjC3ResourceInvalidate, Variable,
+                            Trigger, cfg->getBumpVectorContext());
+  addSuccessor(Block, Destination);
+  return Block;
+}
+
+CFGBlock *CFGBuilder::emitObjC3ResourceClose(const VarDecl *Variable,
+                                            Stmt *Trigger,
+                                            bool InvalidateOnException) {
+  const auto *Attribute = Variable->getAttr<ObjCResourceAttr>();
+  const auto *Call = Attribute ? dyn_cast_or_null<CallExpr>(Attribute->getCall())
+                               : nullptr;
+  const FunctionDecl *Function = Call ? Call->getDirectCallee() : nullptr;
+  if (!Call || !Function) {
+    badCFG = true;
+    return nullptr;
+  }
+  CFGBlock *Continuation = Block ? Block : Succ;
+  Block = nullptr;
+  Succ = Continuation;
+  autoCreateBlock();
+  Block->appendObjC3Resource(CFGElement::ObjC3ResourceInvalidate, Variable,
+                            Trigger, cfg->getBumpVectorContext());
+  Succ = Block;
+  bool NoReturn = Function->isNoReturn() || Function->isAnalyzerNoReturn();
+  Block = NoReturn ? createNoReturnBlock() : createBlock();
+  Block->appendObjC3Resource(CFGElement::ObjC3ResourceClose, Variable, Trigger,
+                            cfg->getBumpVectorContext());
+  if (deferredNativeEHEdgesEnabled() && mayThrowNative(Function))
+    addSuccessor(Block, resourceNativeExceptionEntry(
+                            Variable, Trigger, InvalidateOnException));
+  CFGBlock *Valid = Block;
+  Block = createBlock(false);
+  Block->appendObjC3Resource(CFGElement::ObjC3ResourceRead, Variable, Trigger,
+                            cfg->getBumpVectorContext());
+  Block->setTerminator(
+      CFGTerminator(Trigger, CFGTerminator::ObjC3ResourceBranch));
+  addSuccessor(Block, Valid);
+  addSuccessor(Block, Continuation);
+  return Block;
+}
+
+CFGBlock *CFGBuilder::VisitObjC3ResourceExpr(ObjC3ResourceExpr *Expression) {
+  const VarDecl *Variable = Expression->getResourceVariable();
+  if (!Variable || !Variable->hasAttr<ObjCResourceAttr>()) {
+    badCFG = true;
+    return nullptr;
+  }
+  autoCreateBlock();
+  if (Expression->getKind() == ObjC3ResourceExpr::Kind::Take) {
+    // Capture the value before invalidation. The source operand is a direct
+    // variable lvalue, so it has no second value evaluation or address recipe.
+    Block->appendObjC3Resource(CFGElement::ObjC3ResourceInvalidate, Variable,
+                              Expression, cfg->getBumpVectorContext());
+    appendStmt(Block, Expression);
+    Block->appendObjC3Resource(CFGElement::ObjC3ResourceRead, Variable,
+                              Expression, cfg->getBumpVectorContext());
+    return Visit(Expression->getOperand(), AddStmtChoice::AlwaysAdd);
+  }
+  // This statement is the reset's final assignment, or discard's completion.
+  // Replacement evaluation follows the completed close/invalidation sequence.
+  appendStmt(Block, Expression);
+  if (Expr *Replacement = Expression->getReplacement())
+    Visit(Replacement, AddStmtChoice::AlwaysAdd);
+  if (badCFG)
+    return nullptr;
+  emitObjC3ResourceClose(Variable, Expression, true);
+  if (badCFG)
+    return nullptr;
+  return Visit(Expression->getOperand(), AddStmtChoice::AlwaysAdd);
+}
+
+CFGBlock *CFGBuilder::VisitObjC3MatchFullExpression(Expr *Expression) {
+  if (isa<ExprWithCleanups>(Expression))
+    return Visit(Expression, AddStmtChoice::AlwaysAdd);
+  SaveAndRestore SaveTemporaries(PendingTemporaryCleanups);
+  if (HasScopeExitActions && BuildOpts.AddEHEdges) {
+    PendingTemporaryCleanups.clear();
+    if (!collectDeferredTemporaryCleanups(Expression,
+                                          PendingTemporaryCleanups)) {
+      badCFG = true;
+      return nullptr;
+    }
+  }
+  if (BuildOpts.AddTemporaryDtors || BuildOpts.AddLifetime) {
+    TempDtorContext Temporaries;
+    VisitForTemporaries(Expression, false, Temporaries);
+    if (!Temporaries.CollectedMTEs.empty()) {
+      // Match's native arm is a full-expression boundary even when source
+      // parsing did not attach an ExprWithCleanups wrapper to the arm itself.
+      auto *Boundary = ExprWithCleanups::Create(*Context, Expression, true, {});
+      addFullExprCleanupMarker(Temporaries, Boundary);
+    }
+  }
+  return Visit(Expression, AddStmtChoice::AlwaysAdd);
+}
+
+CFGBlock *CFGBuilder::VisitObjC3Match(Expr *Scrutinee,
+                                     ArrayRef<ObjC3MatchArm *> Arms,
+                                     Stmt *Owner, QualType ResultType) {
+  QualType SourceType = Scrutinee->getType();
+  QualType Canonical = SourceType.getCanonicalType();
+  bool IsCarrier = isa<ObjC3OptionalType, ObjC3ResultType>(Canonical.getTypePtr());
+  if (Arms.empty() || !supportsObjC3MatchStorage(SourceType) ||
+      containsFullExpressionTemporary(Scrutinee) ||
+      (!IsCarrier && !SourceType->isIntegralOrEnumerationType() &&
+       !SourceType->isPointerType() && !SourceType->isNullPtrType() &&
+       !SourceType->isObjCRetainableType()) ||
+      (!ResultType.isNull() && !supportsObjC3MatchStorage(ResultType))) {
+    // Nontrivial snapshots, owned bindings and completed results require
+    // selected-payload cleanup distinct from the source's own lifetime.
+    badCFG = true;
+    return nullptr;
+  }
+  SmallVector<objc3::MatchCoverageArm, 8> CoverageArms;
+  for (const ObjC3MatchArm *Arm : Arms) {
+    using Pattern = objc3::MatchPatternKind;
+    if (Arm->getPatternKind() == Pattern::StringLiteral ||
+        Arm->getPatternKind() == Pattern::TypeTest ||
+        Arm->getPatternKind() == Pattern::MoveBinding ||
+        containsMatchGuardLabels(Arm->getGuard()) ||
+        (Arm->getBindingDecl() &&
+         !supportsObjC3MatchStorage(Arm->getBindingDecl()->getType()))) {
+      badCFG = true;
+      return nullptr;
+    }
+    CoverageArms.push_back(
+        {Arm->getPatternKind(), Arm->getCaseLoc(), Arm->getGuard() != nullptr,
+         Arm->getCanonicalPatternType().getAsOpaquePtr()});
+  }
+  auto Coverage = objc3::analyzeMatchCoverage(*Context, SourceType, CoverageArms);
+
+  SaveAndRestore SaveScope(ScopePos);
+  auto Incoming = ScopePos;
+  if (!ResultType.isNull()) {
+    autoCreateBlock();
+    appendStmt(Block, Owner);
+  }
+  CFGBlock *Continuation = Block ? Block : Succ;
+  CFGBlock *Next = Continuation;
+  if (!ResultType.isNull() || Coverage.IsExhaustive) {
+    // The last false edge is semantically unreachable. Finite-domain tests
+    // below also correlate complementary patterns, so it cannot fabricate a
+    // fallthrough path after an exhaustive statement match.
+    Succ = Continuation;
+    Next = createNoReturnBlock();
+  }
+
+  const bool FiniteDomain = Coverage.Domain != objc3::MatchDomain::Open;
+  CFGBlock *NextForTag[] = {Next, Next};
+  auto PatternMask = [&](const ObjC3MatchArm *Arm) {
+    using Pattern = objc3::MatchPatternKind;
+    switch (Arm->getPatternKind()) {
+    case Pattern::BooleanTrue:
+    case Pattern::OptionalSome:
+    case Pattern::ResultOK:
+      return 1u;
+    case Pattern::BooleanFalse:
+    case Pattern::OptionalNone:
+    case Pattern::ResultErr:
+      return 2u;
+    case Pattern::Wildcard:
+    case Pattern::Binding:
+    case Pattern::Default:
+      return 3u;
+    default:
+      if (Coverage.Domain == objc3::MatchDomain::Boolean &&
+          Arm->getPatternValue()) {
+        TryResult Value = tryEvaluateBool(Arm->getPatternValue());
+        if (Value.isKnown())
+          return Value.isTrue() ? 1u : 2u;
+      }
+      return 0u;
+    }
+  };
+
+  for (unsigned I = Arms.size(); I; --I) {
+    ObjC3MatchArm *Arm = Arms[I - 1];
+    ScopePos = Incoming;
+    if (Stmt *Declaration = Arm->getBindingStatement())
+      addLocalScopeForStmt(Declaration);
+    auto Bound = ScopePos;
+
+    Block = nullptr;
+    Succ = Continuation;
+    addAutomaticObjHandling(Bound, Incoming, Arm);
+    if (auto *Value = dyn_cast<Expr>(Arm->getBody()))
+      VisitObjC3MatchFullExpression(Value);
+    else
+      Visit(Arm->getBody(), AddStmtChoice::AlwaysAdd);
+    if (badCFG)
+      return nullptr;
+    CFGBlock *Selected = Block ? Block : Succ;
+
+    auto BuildSelected = [&](CFGBlock *GuardFailure) -> CFGBlock * {
+      CFGBlock *Entry = Selected;
+      if (Expr *Guard = Arm->getGuard()) {
+        ScopePos = Bound;
+        Block = nullptr;
+        Succ = GuardFailure;
+        addAutomaticObjHandling(Bound, Incoming, Arm);
+        CFGBlock *Failed = Block ? Block : Succ;
+        Block = createBlock(false);
+        Block->setTerminator(
+            CFGTerminator(Guard, CFGTerminator::ObjC3ConditionBranch));
+        TryResult KnownGuard = tryEvaluateBool(Guard);
+        addSuccessor(Block, Selected, !KnownGuard.isFalse());
+        addSuccessor(Block, Failed, !KnownGuard.isTrue());
+        VisitObjC3MatchFullExpression(Guard);
+        if (badCFG)
+          return nullptr;
+        Entry = Block ? Block : Succ;
+      }
+
+      ScopePos = Bound;
+      Block = nullptr;
+      Succ = Entry;
+      if (auto *Declaration =
+              dyn_cast_or_null<DeclStmt>(Arm->getBindingStatement())) {
+        // Forward order is declaration, native payload initialization, guard,
+        // body. The runtime recipe initializes only this selected arm's binding.
+        autoCreateBlock();
+        appendStmt(Block, Arm);
+        VisitDeclSubExpr(Declaration);
+      }
+      return badCFG ? nullptr : (Block ? Block : Succ);
+    };
+
+    if (FiniteDomain) {
+      unsigned Mask = PatternMask(Arm);
+      if (!Mask) {
+        badCFG = true;
+        return nullptr;
+      }
+      // Split on the stable tag once. A failed Some/OK/true guard continues
+      // only among arms compatible with that same snapshot; it cannot skip
+      // the guard and later pretend that the opposite tag matched.
+      for (unsigned Tag = 0; Tag != 2; ++Tag)
+        if (Mask & (1u << Tag)) {
+          NextForTag[Tag] = BuildSelected(NextForTag[Tag]);
+          if (badCFG)
+            return nullptr;
+        }
+      continue;
+    }
+
+    Selected = BuildSelected(Next);
+    if (badCFG)
+      return nullptr;
+
+    ScopePos = Incoming;
+    Block = createBlock(false);
+    Block->setTerminator(
+        CFGTerminator(Arm, CFGTerminator::ObjC3ConditionBranch));
+    addSuccessor(Block, Selected);
+    addSuccessor(Block, Next, PatternMask(Arm) != 3);
+    if (Expr *Pattern = Arm->getPatternValue())
+      Visit(Pattern, AddStmtChoice::AlwaysAdd);
+    Next = Block;
+  }
+  ScopePos = Incoming;
+  Block = nullptr;
+  if (FiniteDomain) {
+    Block = createBlock(false);
+    Block->setTerminator(
+        CFGTerminator(Owner, CFGTerminator::ObjC3ConditionBranch));
+    TryResult Known;
+    if (Coverage.Domain == objc3::MatchDomain::Boolean)
+      Known = tryEvaluateBool(Scrutinee);
+    addSuccessor(Block, NextForTag[0], !Known.isFalse());
+    addSuccessor(Block, NextForTag[1], !Known.isTrue());
+    Next = Block;
+  }
+  Block = nullptr;
+  Succ = Next;
+  return Visit(Scrutinee, AddStmtChoice::AlwaysAdd);
+}
+
+bool CFGBuilder::deferredNativeEHEdgesEnabled() const {
+  return HasScopeExitActions && BuildOpts.AddEHEdges &&
+         (Context->getLangOpts().Exceptions ||
+          Context->getLangOpts().ObjCExceptions);
+}
+
+void CFGBuilder::addDeferredNativeOperation(const Stmt *Operation, bool CanThrow,
+                                           bool NoReturn) {
+  const bool AddEHEdge = CanThrow && deferredNativeEHEdgesEnabled();
+  if (AddEHEdge || NoReturn) {
+    Succ = Block ? Block : Succ;
+    Block = NoReturn ? createNoReturnBlock() : createBlock();
+  } else
+    autoCreateBlock();
+  if (AddEHEdge)
+    addSuccessor(Block, EmittingNativeUnwind
+                            ? getDeferredTerminateBlock()
+                            : deferredNativeExceptionEntry(Operation));
+}
+
+CFGBlock *CFGBuilder::getDeferredTerminateBlock() {
+  if (!DeferredTerminateBlock)
+    DeferredTerminateBlock = createNoReturnBlock();
+  return DeferredTerminateBlock;
+}
+
+CFGBlock *CFGBuilder::deferredNativeExceptionEntry(const Stmt *Operation) {
+  DeferredTemporaryList Temporaries = PendingTemporaryCleanups.lookup(Operation);
+  SaveAndRestore SaveTemporaries(PendingTemporaryCleanups,
+                                 DeferredTemporaryMap());
+  SaveAndRestore SaveBlock(Block), SaveSucc(Succ);
+  SaveAndRestore SaveScope(ScopePos);
+  SaveAndRestore SaveUnwind(EmittingNativeUnwind, true);
+  Block = createBlock(false);
+  if (!TryTerminatedBlock)
+    Block->setNativeExceptionExit();
+  addSuccessor(Block,
+               TryTerminatedBlock ? TryTerminatedBlock : &cfg->getExit());
+  addAutomaticObjHandling(ScopePos, NativeExceptionScope,
+                          const_cast<Stmt *>(Operation));
+  // Prepending in construction order executes the completed temporary prefix
+  // in reverse order, before any lexical object or deferred action. A second
+  // exception from these destructors terminates the original unwind.
+  for (const CXXBindTemporaryExpr *Temporary : Temporaries) {
+    const CXXDestructorDecl *Destructor =
+        Temporary->getTemporary()->getDestructor();
+    addDeferredNativeOperation(
+        Temporary, mayThrowNative(Destructor),
+        Destructor->getParent()->isAnyDestructorNoReturn());
+    appendTemporaryDtor(Block,
+                        const_cast<CXXBindTemporaryExpr *>(Temporary));
+  }
+  return Block;
+}
+
+LocalScope *CFGBuilder::addLocalScopeForDefer(DeferStmt *Statement,
+                                              LocalScope *Scope) {
+  auto *Action =
+      new (cfg->getAllocator()) DeferredScopeAction{Statement,
+                                                    ScopePos,
+                                                    TryTerminatedBlock,
+                                                    ObjC3ErrorDispatchBlock,
