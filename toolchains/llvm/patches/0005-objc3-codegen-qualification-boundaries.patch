+
+struct Pair { int left; double right; };
+typedef int (^Callback)(int);
+int fetch(int) __objc3_async __asm__("native_frame_int");
+void empty(void) __objc3_async __asm__("native_frame_void");
+struct Pair pair(void) __objc3_async __asm__("native_frame_pair");
