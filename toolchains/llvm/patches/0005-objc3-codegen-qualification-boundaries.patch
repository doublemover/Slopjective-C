diff --git a/clang/lib/CodeGen/CGObjC3Isolation.cpp b/clang/lib/CodeGen/CGObjC3Isolation.cpp
new file mode 100644
index 000000000..efc74f478
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Isolation.cpp
@@ -0,0 +1,162 @@
+//===--- CGObjC3Isolation.cpp - Executor entry for private frames
+//-----------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3Isolation.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/ObjC3Isolation.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+llvm::Value *runtimeCall(CodeGenFunction &CGF, StringRef Name,
+                         llvm::Type *Result,
+                         ArrayRef<llvm::Value *> Arguments) {
+  SmallVector<llvm::Type *, 3> Types;
+  for (llvm::Value *Argument : Arguments)
+    Types.push_back(Argument->getType());
+  auto Callee = CGF.CGM.CreateRuntimeFunction(
+      llvm::FunctionType::get(Result, Types, false), Name);
+  return CGF.EmitNounwindRuntimeCall(Callee, Arguments);
+}
+
+llvm::Value *lookupExecutor(CodeGenFunction &CGF,
+                            const ObjCExecutorAttr &Executor,
+                            Address Destination) {
+  StringRef Identity = Executor.getExecutor();
+  if (Identity == "main" || Identity == "global")
+    return runtimeCall(CGF,
+                       Identity == "main" ? "objc3_executor_get_main"
+                                          : "objc3_executor_get_global",
+                       CGF.Int32Ty, {Destination.emitRawPointer(CGF)});
+  assert(Identity.starts_with("named:") && "unknown executor identity");
+  Identity = Identity.drop_front(6);
+  llvm::Value *Name = CGF.CGM.GetAddrOfConstantCString(Identity.str()).getPointer();
+  return runtimeCall(CGF, "objc3_executor_get_named", CGF.Int32Ty,
+                     {Name, Destination.emitRawPointer(CGF)});
+}
+
+ObjC3IsolationEntry emitActorEntry(CodeGenFunction &CGF,
+                                   const FunctionDecl &Callable,
+                                   const ObjCExecutorAttr *Executor,
+                                   llvm::Value *Owner) {
+  auto *Null = llvm::ConstantPointerNull::get(CGF.Int8PtrTy);
+  Address Actor = CGF.CreateTempAlloca(CGF.Int8PtrTy, CGF.getPointerAlign(),
+                                       "objc3.isolation.actor");
+  Address Status = CGF.CreateTempAlloca(CGF.Int32Ty, CharUnits::fromQuantity(4),
+                                        "objc3.actor.entry.status");
+  Address Suspend = CGF.CreateTempAlloca(
+      CGF.Builder.getInt1Ty(), CharUnits::One(), "objc3.actor.entry.suspend");
+  CGF.Builder.CreateStore(Null, Actor);
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(0), Status);
+  CGF.Builder.CreateStore(CGF.Builder.getFalse(), Suspend);
+  llvm::Value *Receiver =
+      CGF.Builder.CreateLoad(CGF.GetAddrOfLocalVar(Callable.getParamDecl(0)));
+  auto *Lookup = CGF.createBasicBlock("objc3.actor.lookup");
+  auto *Ready = CGF.createBasicBlock("objc3.actor.ready");
+  auto *Done = CGF.createBasicBlock("objc3.actor.entry");
+  // Sending a message to nil still evaluates its source arguments, but needs
+  // no mailbox association. The original nil message supplies its zero result.
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNull(Receiver), Done, Lookup);
+  CGF.EmitBlock(Lookup);
+  llvm::Value *Found =
+      runtimeCall(CGF, "objc3_actor_get_for_object", CGF.Int32Ty,
+                  {Receiver, Actor.emitRawPointer(CGF)});
+  CGF.Builder.CreateStore(Found, Status);
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNull(Found), Ready, Done);
+  CGF.EmitBlock(Ready);
+  llvm::Value *Target = CGF.Builder.CreateLoad(Actor);
+  if (Executor) {
+    Address Required = CGF.CreateTempAlloca(
+        CGF.Int8PtrTy, CGF.getPointerAlign(), "objc3.actor.required.executor");
+    CGF.Builder.CreateStore(Null, Required);
+    llvm::Value *Resolved = lookupExecutor(CGF, *Executor, Required);
+    CGF.Builder.CreateStore(Resolved, Status);
+    auto *Check = CGF.createBasicBlock("objc3.actor.check.executor");
+    auto *Failed = CGF.createBasicBlock("objc3.actor.lookup.failed");
+    auto *Match = CGF.createBasicBlock("objc3.actor.executor.matched");
+    auto *Mismatch = CGF.createBasicBlock("objc3.actor.executor.mismatch");
+    CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNull(Resolved), Check, Failed);
+    CGF.EmitBlock(Failed);
+    runtimeCall(CGF, "objc3_actor_release", CGF.VoidTy, {Target});
+    CGF.Builder.CreateBr(Done);
+    CGF.EmitBlock(Check);
+    llvm::Value *RequiredExecutor = CGF.Builder.CreateLoad(Required);
+    llvm::Value *RequiredIdentity = runtimeCall(
+        CGF, "objc3_executor_identity", CGF.Int64Ty, {RequiredExecutor});
+    llvm::Value *ActorIdentity = runtimeCall(
+        CGF, "objc3_actor_executor_identity", CGF.Int64Ty, {Target});
+    runtimeCall(CGF, "objc3_executor_release", CGF.VoidTy, {RequiredExecutor});
+    CGF.Builder.CreateCondBr(
+        CGF.Builder.CreateICmpEQ(RequiredIdentity, ActorIdentity), Match,
+        Mismatch);
+    CGF.EmitBlock(Mismatch);
+    // The explicit association disagrees with the declaration's executor.
+    CGF.Builder.CreateStore(CGF.Builder.getInt32(1), Status);
+    runtimeCall(CGF, "objc3_actor_release", CGF.VoidTy, {Target});
+    CGF.Builder.CreateBr(Done);
+    CGF.EmitBlock(Match);
+  }
+  llvm::Value *Hopped =
+      runtimeCall(CGF, "objc3_task_hop", CGF.Int32Ty, {Owner, Null, Target});
+  CGF.Builder.CreateStore(Hopped, Status);
+  CGF.Builder.CreateStore(CGF.Builder.CreateIsNull(Hopped), Suspend);
+  runtimeCall(CGF, "objc3_actor_release", CGF.VoidTy, {Target});
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+  return {CGF.Builder.CreateLoad(Status), CGF.Builder.CreateLoad(Suspend)};
+}
+} // namespace
+
+ObjC3IsolationEntry clang::CodeGen::emitObjC3IsolationEntry(
+    CodeGenFunction &CGF, const Decl &Callable, llvm::Value *Owner) {
+  const auto *Executor = getObjC3Executor(&Callable);
+  const auto *Marker = Callable.getAttr<ObjC3IsolationThunkAttr>();
+  assert(Marker && (Executor || Marker->getActorEntry()) &&
+         "isolation entry requires a synthesized executor frame");
+  if (Marker->getActorEntry())
+    return emitActorEntry(CGF, cast<FunctionDecl>(Callable), Executor, Owner);
+  Address Destination = CGF.CreateTempAlloca(
+      CGF.Int8PtrTy, CGF.getPointerAlign(), "objc3.isolation.destination");
+  auto *Null = llvm::ConstantPointerNull::get(CGF.Int8PtrTy);
+  CGF.Builder.CreateStore(Null, Destination);
+  llvm::Value *Lookup = lookupExecutor(CGF, *Executor, Destination);
+  auto *LookupEnd = CGF.Builder.GetInsertBlock();
+  auto *Ready = CGF.createBasicBlock("objc3.isolation.ready");
+  auto *Hop = CGF.createBasicBlock("objc3.isolation.hop");
+  auto *Current = CGF.createBasicBlock("objc3.isolation.current");
+  auto *Done = CGF.createBasicBlock("objc3.isolation.entry");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNull(Lookup), Ready, Done);
+  CGF.EmitBlock(Ready);
+  llvm::Value *Target = CGF.Builder.CreateLoad(Destination);
+  llvm::Value *IsCurrent =
+      runtimeCall(CGF, "objc3_executor_is_current", CGF.Int32Ty, {Target});
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(IsCurrent), Current,
+                           Hop);
+  CGF.EmitBlock(Current);
+  runtimeCall(CGF, "objc3_executor_release", CGF.VoidTy, {Target});
+  auto *CurrentEnd = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Hop);
+  llvm::Value *Status =
+      runtimeCall(CGF, "objc3_task_hop", CGF.Int32Ty, {Owner, Target, Null});
+  // The task retains its new destination before publishing its continuation.
+  // Release our lookup lease on both success and failure.
+  runtimeCall(CGF, "objc3_executor_release", CGF.VoidTy, {Target});
+  llvm::Value *Suspend = CGF.Builder.CreateIsNull(Status);
+  auto *HopEnd = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+  auto *Result =
+      CGF.Builder.CreatePHI(CGF.Int32Ty, 3, "objc3.isolation.status");
+  Result->addIncoming(Lookup, LookupEnd);
+  Result->addIncoming(CGF.Builder.getInt32(0), CurrentEnd);
+  Result->addIncoming(Status, HopEnd);
+  auto *MustSuspend = CGF.Builder.CreatePHI(CGF.Builder.getInt1Ty(), 3,
+                                            "objc3.isolation.suspend");
+  MustSuspend->addIncoming(CGF.Builder.getFalse(), LookupEnd);
+  MustSuspend->addIncoming(CGF.Builder.getFalse(), CurrentEnd);
+  MustSuspend->addIncoming(Suspend, HopEnd);
+  return {Result, MustSuspend};
+}
diff --git a/clang/lib/CodeGen/CGObjC3Isolation.h b/clang/lib/CodeGen/CGObjC3Isolation.h
new file mode 100644
index 000000000..571cfc877
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Isolation.h
@@ -0,0 +1,23 @@
+//===--- CGObjC3Isolation.h - Executor entry for private frames ---*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3ISOLATION_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3ISOLATION_H
+namespace llvm {
+class Value;
+}
+namespace clang {
+class Decl;
+namespace CodeGen {
+class CodeGenFunction;
+struct ObjC3IsolationEntry {
+  llvm::Value *Status;
+  llvm::Value *Suspend;
+};
+/// Called with an active frame owner. A successful hop queues this same owner;
+/// the caller must suspend before evaluating the synchronous thunk body.
+ObjC3IsolationEntry emitObjC3IsolationEntry(CodeGenFunction &, const Decl &,
+                                            llvm::Value *Owner);
+} // namespace CodeGen
+} // namespace clang
+#endif
diff --git a/clang/test/ObjC3/CodeGen/Inputs/native-c-async-entry-abi.h b/clang/test/ObjC3/CodeGen/Inputs/native-c-async-entry-abi.h
