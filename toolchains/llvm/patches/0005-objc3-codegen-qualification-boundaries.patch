@@ -0,0 +1,33 @@
+//===--- CGObjC3ResultExpr.h - Private Result expression lowering
+//----------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3RESULTEXPR_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3RESULTEXPR_H
+
+#include "Address.h"
+#include "clang/AST/Type.h"
+#include "clang/Basic/SourceLocation.h"
+#include "clang/Basic/LLVM.h"
+
+namespace clang {
+class ObjC3ResultExpr;
+namespace CodeGen {
+class CodeGenFunction;
+
+bool emitObjC3ResultAggregateExpr(CodeGenFunction &CGF,
+                                  const ObjC3ResultExpr &E, Address Destination,
+                                  bool DestinationIsIgnored,
+                                  bool DestinationIsVolatile,
+                                  bool IsLocalCarrierInitialization = false);
+llvm::Value *emitObjC3ResultIsOkExpr(CodeGenFunction &CGF,
+                                     const ObjC3ResultExpr &E);
+/// Copy a Result through its tag and only the selected active arm. Sema has
+/// already admitted the copy; this performs no Move or call-ABI adaptation.
+bool emitObjC3ResultCopy(CodeGenFunction &CGF, QualType CarrierType,
+                         Address Destination, Address Source,
+                         bool DestinationIsVolatile, bool SourceIsVolatile,
+                         bool IsInitialization, SourceLocation Loc);
+} // namespace CodeGen
+} // namespace clang
+#endif
diff --git a/clang/test/ObjC3/CodeGen/Inputs/carrier-copy-adversarial-runtime.c b/clang/test/ObjC3/CodeGen/Inputs/carrier-copy-adversarial-runtime.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/carrier-copy-adversarial-runtime.c
@@ -0,0 +1,69 @@
+// Standalone runtime regression companion to carrier-copy-adversarial.c.
+// Nested payload-arm routing is checked structurally in the IR fixture because
+// this source subset exposes carrier tags but no payload-unwrapping operation.
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_result(int, long long) PlainResult;
+typedef __objc3_result(OptionalInt, OptionalInt) InnerResult;
+typedef __objc3_result(InnerResult, OptionalInt) NestedResult;
+static int calls;
+static void side_effect(void) { ++calls; }
+static void copy_optional(OptionalInt *destination, const OptionalInt *source) {
+  *destination = *source;
+}
+static void copy_result(PlainResult *destination, const PlainResult *source) {
+  *destination = *source;
+}
+static void copy_nested_result(NestedResult *destination,
+                               const NestedResult *source) {
+  *destination = *source;
+}
+static void copy_volatile_optional(volatile OptionalInt *destination,
+                                   const volatile OptionalInt *source) {
+  *destination = *source;
+}
+static void copy_volatile_result(volatile PlainResult *destination,
+                                 const volatile PlainResult *source) {
+  *destination = *source;
+}
+
+int main(void) {
+  OptionalInt present = __objc3_some(int, 0);
+  OptionalInt absent = __objc3_none(int);
+  copy_optional(&present, &present);
+  copy_optional(&absent, &absent);
+  if (!__objc3_has_value(present) || __objc3_has_value(absent)) return 1;
+
+  PlainResult success = __objc3_ok(int, long long, 0);
+  PlainResult error = __objc3_err(int, long long, 0);
+  copy_result(&success, &success);
+  copy_result(&error, &error);
+  if (!__objc3_is_ok(success) || __objc3_is_ok(error)) return 2;
+
+  NestedResult nested = __objc3_ok(
+      InnerResult, OptionalInt,
+      __objc3_err(OptionalInt, OptionalInt, __objc3_some(int, 0)));
+  copy_nested_result(&nested, &nested);
+  if (!__objc3_is_ok(nested)) return 9;
+
+  volatile OptionalInt volatile_present = __objc3_some(int, 0);
+  volatile OptionalInt volatile_destination = __objc3_none(int);
+  copy_volatile_optional(&volatile_destination, &volatile_present);
+  if (!__objc3_has_value(volatile_destination)) return 3;
+  copy_volatile_optional(&volatile_destination, &absent);
+  if (__objc3_has_value(volatile_destination)) return 4;
+
+  volatile PlainResult volatile_error = __objc3_err(int, long long, 0);
+  volatile PlainResult volatile_result_destination =
+      __objc3_ok(int, long long, 0);
+  copy_volatile_result(&volatile_result_destination, &volatile_error);
+  if (__objc3_is_ok(volatile_result_destination)) return 5;
+  copy_volatile_result(&volatile_result_destination, &success);
+  if (!__objc3_is_ok(volatile_result_destination)) return 6;
+
+  if (!__objc3_is_ok(__objc3_ok(void, int, side_effect())) || calls != 1)
+    return 7;
+  if (__objc3_is_ok(__objc3_err(int, void, side_effect())) || calls != 2)
+    return 8;
+  return 0;
+}
\ No newline at end of file
diff --git a/clang/test/ObjC3/CodeGen/Inputs/carrier-cxx-local-lifetime-runtime.cpp b/clang/test/ObjC3/CodeGen/Inputs/carrier-cxx-local-lifetime-runtime.cpp
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/carrier-cxx-local-lifetime-runtime.cpp
@@ -0,0 +1,119 @@
+#include <stddef.h>
+
+extern "C" int lifetime_events[1024];
+extern "C" void lifetime_event(int code) { ++lifetime_events[code]; }
+extern "C" int lifetime_events[1024] = {};
+
+struct Source {
+  int value;
+  explicit Source(int value) : value(value) { lifetime_event(500 + value); }
+  ~Source() { lifetime_event(600 + value); }
+};
+struct Tracked {
+  int value;
+  explicit Tracked(int value) : value(value) { lifetime_event(100 + value); }
+  Tracked(Source &&source) : value(source.value) {
+    lifetime_event(100 + value);
+  }
+  Tracked(const Tracked &) = delete;
+  Tracked(Tracked &&) = delete;
+  ~Tracked() { lifetime_event(200 + value); }
+};
+struct Failure {
+  int value;
+  explicit Failure(int value) : value(value) { lifetime_event(300 + value); }
+  Failure(const Failure &) = delete;
+  Failure(Failure &&) = delete;
+  ~Failure() { lifetime_event(400 + value); }
+};
+struct Throwing {
+  explicit Throwing(int) { throw 9; }
+  ~Throwing() { lifetime_event(700); }
+};
+struct alignas(32) Empty {
+  Empty() {
+    lifetime_event(710);
+    if (reinterpret_cast<__UINTPTR_TYPE__>(this) % alignof(Empty))
+      lifetime_event(712);
+  }
+  ~Empty() { lifetime_event(711); }
+};
+typedef __objc3_optional(Tracked) MaybeTracked;
+typedef __objc3_optional(Throwing) MaybeThrowing;
+typedef __objc3_result(Tracked, Failure) TrackedResult;
+typedef __objc3_optional(Empty) MaybeEmpty;
+typedef __objc3_result(Empty, Failure) EmptyResult;
+
+static void unwind_optional() {
+  MaybeTracked local = __objc3_some(Tracked, Tracked(7));
+  throw 1;
+}
+static void unwind_result_error() {
+  TrackedResult local = __objc3_err(Tracked, Failure, Failure(8));
+  throw 2;
+}
+static void throw_during_payload_construction() {
+  MaybeThrowing local = __objc3_some(Throwing, Throwing(9));
+  (void)local;
+}
+
+int main() {
+  {
+    MaybeTracked some = __objc3_some(Tracked, Tracked(1));
+    if (lifetime_events[201] != 0) return 1;
+  }
+  if (lifetime_events[201] != 1) return 2;
+  {
+    MaybeTracked fromSource = __objc3_some(Tracked, Source(6));
+    if (lifetime_events[606] != 1 || lifetime_events[206] != 0) return 8;
+  }
+  if (lifetime_events[206] != 1) return 9;
+  {
+    MaybeTracked none = __objc3_none(Tracked);
+    (void)none;
+  }
+  if (lifetime_events[201] != 1) return 3;
+  {
+    TrackedResult ok = __objc3_ok(Tracked, Failure, Tracked(2));
+    (void)ok;
+  }
+  if (lifetime_events[202] != 1 || lifetime_events[402] != 0) return 4;
+  {
+    TrackedResult err = __objc3_err(Tracked, Failure, Failure(3));
+    (void)err;
+  }
+  if (lifetime_events[403] != 1 || lifetime_events[203] != 0) return 5;
+  try { unwind_optional(); } catch (...) {}
+  if (lifetime_events[207] != 1) return 6;
+  try { unwind_result_error(); } catch (...) {}
+  if (lifetime_events[408] != 1 || lifetime_events[208] != 0) return 7;
+  try { throw_during_payload_construction(); } catch (...) {}
+  if (lifetime_events[700] != 0) return 10;
+  {
+    const MaybeTracked local = __objc3_some(Tracked, Tracked(10));
+    if (lifetime_events[210] != 0) return 11;
+  }
+  if (lifetime_events[210] != 1) return 12;
+  {
+    const MaybeEmpty local = __objc3_some(Empty, Empty());
+    if (lifetime_events[710] != 1 || lifetime_events[711] != 0) return 13;
+  }
+  if (lifetime_events[711] != 1 || lifetime_events[712] != 0) return 14;
+  {
+    MaybeEmpty absent = __objc3_none(Empty);
+    (void)absent;
+  }
+  if (lifetime_events[710] != 1 || lifetime_events[711] != 1) return 15;
+  {
+    EmptyResult present = __objc3_ok(Empty, Failure, Empty());
+    (void)present;
+  }
+  if (lifetime_events[710] != 2 || lifetime_events[711] != 2 ||
+      lifetime_events[712] != 0) return 16;
+  {
