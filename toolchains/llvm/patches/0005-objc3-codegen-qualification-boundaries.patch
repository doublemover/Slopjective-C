+// CHECK: call void @_ZN11NativeOwnerD{{[12]}}Ev
+
+void move_owner(NativeOwner &source) {
+  NativeOwner moved(static_cast<NativeOwner &&>(source));
+}
+// CHECK-LABEL: define{{.*}} @_Z10move_ownerR11NativeOwner
+// CHECK: call void @_ZN11NativeOwnerC{{[12]}}EOS_
+// CHECK: call void @_ZN11NativeOwnerD{{[12]}}Ev
+
+NativeOwner pass_owner(NativeOwner value) { return value; }
+// CHECK-LABEL: define{{.*}} @_Z10pass_owner11NativeOwner(ptr{{.*}} sret(%struct.NativeOwner)
+// CHECK-SAME: ptr{{.*}} %value
+// CHECK: call void @_ZN11NativeOwnerC{{[12]}}EOS_
+
+struct AggregateOwner { Inner first, second; };
+void aggregate_owner(const Inner &source) {
+  AggregateOwner value{source, __objc3_some(Leaf, Leaf(5))};
+}
+// CHECK-LABEL: define{{.*}} @_Z15aggregate_ownerRKU16__objc3_optional4Leaf
+// CHECK: load i8
+// CHECK: invoke void @_ZN4LeafC1ERKS_
+// CHECK: invoke void @_ZN4LeafC1Ei
+// CHECK: call void @_ZN14AggregateOwnerD{{[12]}}Ev
