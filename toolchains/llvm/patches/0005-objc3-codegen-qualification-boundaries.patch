+//===--- CGObjC3BlockCaptures.h - Explicit Block capture owners -*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3BLOCKCAPTURES_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3BLOCKCAPTURES_H
+#include "Address.h"
+#include "EHScopeStack.h"
+#include "clang/AST/Type.h"
+#include <cstdint>
+namespace clang {
+class VarDecl;
+class Expr;
+class Stmt;
+class ReturnStmt;
+namespace CodeGen {
+class CodeGenFunction;
+class CodeGenModule;
+struct ObjC3BlockCaptureCleanup {
+  ObjC3BlockCaptureCleanup *Next = nullptr;
+  Address StoragePointer, Live;
+  llvm::Type *ElementType;
+  CharUnits Alignment;
+  QualType Type;
+  void (*Destroyer)(CodeGenFunction &, Address, QualType);
+  bool UseArrayEHCleanup;
+};
+struct ObjC3BlockCaptureFullExprData;
+/// Keep a rollback owner below the ordinary full-expression temporary stack.
+/// A throwing temporary destructor can run after the immediate construction
+/// cleanups were deactivated and before permanent lexical cleanups exist.
+class ObjC3BlockCaptureFullExprScope {
+  CodeGenFunction &CGF;
+  ObjC3BlockCaptureFullExprScope *Previous = nullptr;
+  ObjC3BlockCaptureFullExprData *Data = nullptr;
+  EHScopeStack::stable_iterator Cleanup;
+  llvm::Instruction *DominatingIP = nullptr;
+
+public:
+  ObjC3BlockCaptureFullExprScope(CodeGenFunction &CGF, const Expr *Expression);
+  ~ObjC3BlockCaptureFullExprScope();
+  void finish();
+  void addCleanup(ObjC3BlockCaptureCleanup *Capture);
+};
+/// The same live flag guards construction rollback and committed disposal.
+/// Storage is saved in an entry alloca so untaken branches need no SSA value
+/// from a capture initialization which did not execute.
+ObjC3BlockCaptureCleanup *registerObjC3BlockCaptureCleanup(
+    CodeGenFunction &CGF, Address Field, QualType Type,
+    void (*Destroyer)(CodeGenFunction &, Address, QualType),
+    bool UseArrayEHCleanup);
+void emitObjC3BlockCaptureCleanup(CodeGenFunction &CGF,
+                                ObjC3BlockCaptureCleanup *Capture,
+                                bool ForEHCleanup);
+void emitObjC3ARCReturnProlog(CodeGenFunction &CGF);
+/// Commit only a native ARC-produced +1 result in ordinary scalar storage.
+void commitObjC3ARCReturn(CodeGenFunction &CGF, const ReturnStmt &Return);
+/// A catch abandons only returns originating in its protected source body.
+void abandonObjC3ARCReturnForCatch(CodeGenFunction &CGF, const Stmt *TryBody);
+void abandonObjC3ARCReturn(CodeGenFunction &CGF);
+void disarmObjC3ARCReturn(CodeGenFunction &CGF);
+uint64_t getObjC3BlockResourcePayloadOffset(CodeGenModule &CGM,
+                                            const VarDecl &Variable);
+/// The closure field contains an owner pointer. Its payload has the original
+/// handle type; sharing the owner never copies the handle's cleanup obligation.
+Address getObjC3BlockResourcePayload(CodeGenFunction &CGF, Address Field,
+                                    const VarDecl &Variable);
+void initializeObjC3BlockResource(CodeGenFunction &CGF, Address Field,
+                                  Address Source, const VarDecl &Variable);
+void copyObjC3BlockResource(CodeGenFunction &CGF, Address Destination,
+                            Address Source);
+/// Active-arm move has already transferred strong/weak leaves. Clear remaining
+/// selected scalar/unsafe leaves while retaining a valid source discriminant.
+void clearObjC3MovedCaptureCarrier(CodeGenFunction &CGF, QualType Type,
+                                   Address Source);
+/// Destroyer compatible with native lexical/lifetime-extended capture cleanup.
+/// The owner callback frees only the resource; this operation always frees its
+/// allocation, including when the native cleanup callback throws.
+void destroyObjC3BlockResource(CodeGenFunction &CGF, Address Field,
+                               QualType FieldType);
+} // namespace CodeGen
+} // namespace clang
+#endif
