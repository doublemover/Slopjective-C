+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_BY_VALUE -emit-llvm -o %t.by-value.ll -verify %s
+// RUN: test ! -e %t.by-value.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_LIFETIME -emit-llvm -o %t.lifetime.ll -verify %s
+// RUN: test ! -e %t.lifetime.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_COPY -emit-llvm -o %t.copy.ll -verify %s
+// RUN: test ! -e %t.copy.ll
