+static bool containsMatchGuardLabels(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<LabelStmt, GotoStmt, AddrLabelExpr, IndirectGotoStmt>(Statement))
+    return true;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Capture : Lambda->capture_inits())
+      if (containsMatchGuardLabels(Capture))
+        return true;
+    return false;
+  }
+  if (isa<BlockExpr>(Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsMatchGuardLabels(Child))
+      return true;
+  return false;
+}
