+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -x objective-c++ -std=c++20 -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s
+// REQUIRES: x86-registered-target
+#include "../AST/Inputs/carrier-heap-pch.h"
+@implementation HeapBox
+@synthesize value=_value, weak=_weak, record=_record;
+- (struct HeapRecord)echo:(struct HeapRecord)record { return record; }
+@end
+#ifdef __cplusplus
+extern "C"
+#endif
+struct HeapRecord runtime_record(HeapBox *receiver, struct HeapRecord input) {
+  receiver.value = input.value;
