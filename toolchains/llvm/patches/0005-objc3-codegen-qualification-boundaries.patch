+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_BY_VALUE -emit-llvm -o %t.by-value.ll -verify %s
+// RUN: test ! -e %t.by-value.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_LIFETIME -emit-llvm -o %t.lifetime.ll -verify %s
+// RUN: test ! -e %t.lifetime.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_COPY -emit-llvm -o %t.copy.ll -verify %s
+// RUN: test ! -e %t.copy.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_CARRIER_ARC -emit-llvm -o %t.arc.ll -verify %s
+// RUN: test ! -e %t.arc.ll
+//
+// Keep each expected CodeGen rejection in its own translation unit so an
+// earlier diagnostic cannot suppress coverage of later operation boundaries.
+
+struct Owned {
+  Owned(const Owned &);
+  Owned(Owned &&) noexcept;
+  ~Owned();
+  int value;
+};
+typedef __objc3_optional(Owned) MaybeOwned;
+
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete;
+  MoveOnly(MoveOnly &&) noexcept;
+  ~MoveOnly();
+};
+typedef __objc3_optional(MoveOnly) MaybeMoveOnly;
+
+typedef __objc3_optional(long long) MaybeLong;
+extern MaybeLong external_long;
+
+@interface Object
+@end
+typedef __objc3_optional(Object *) MaybeObject;
+
+#if defined(TEST_CARRIER_BY_VALUE)
+MaybeOwned by_value(MaybeOwned value) { // expected-error-re {{ObjC3 carrier operation 'by-value call ABI' for type {{.*}} has no qualified lowering: {{.*}}}}
+  return value;
+}
+#elif defined(TEST_CARRIER_LIFETIME)
+void scope_lifetime(void) {
+  MaybeOwned value; // expected-error-re {{ObjC3 carrier operation 'local lifetime' for type {{.*}} has no qualified lowering: {{.*}}}}
+}
+#elif defined(TEST_CARRIER_COPY)
+void copy_trivial_carrier(void) { // expected-error-re {{ObjC3 carrier operation 'copy' for type {{.*}} has no qualified lowering: {{.*}}}}
+  MaybeLong local = external_long;
+  (void)local;
+}
+#elif defined(TEST_CARRIER_ARC)
+void arc_lifetime(void) {
+  MaybeObject value; // expected-error-re {{ObjC3 carrier operation 'local lifetime' for type {{.*}} has no qualified lowering: {{.*}}}}
+}
+#endif
