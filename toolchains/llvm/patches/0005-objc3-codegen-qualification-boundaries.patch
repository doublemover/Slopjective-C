@@ -0,0 +1,63 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -x objective-c -std=c17 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -x objective-c++ -std=c++20 -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -x objective-c++ -std=c++23 -fcxx-exceptions -O2 -emit-obj -o %t.o %s
+// REQUIRES: x86-registered-target
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+id make_owner(void) __attribute__((ns_returns_retained));
+void observe(id) __attribute__((nothrow));
+void release_marker(int *) __attribute__((nothrow));
+void may_throw(void);
+void (^saved_block)(void);
+
+// A cleanup attribute is itself a source action. Implicit ARC destruction
+// must be delayed even when there is no defer anywhere in this function.
+void cleanup_only(void) {
+  int marker __attribute__((cleanup(release_marker))) = 1;
+  id value = make_owner();
+  observe(value);
+}
+// CHECK-LABEL: define{{.*}} void @cleanup_only(
+// CHECK: scope.release.pending
+// CHECK: call void @release_marker(
+// CHECK: scope.release:
+// CHECK: call void @llvm.objc.storeStrong(
+// CHECK: ret void
+
+// Moving a byref record onto the heap transfers its ownership out of the
+// original stack storage. Ordering only the stack destructor is insufficient.
+struct ManagedRecord { id value; };
+void cleanup_byref_record(void) {
+  int marker __attribute__((cleanup(release_marker))) = 1;
+  __block struct ManagedRecord value = {make_owner()};
+  saved_block = ^{ observe(value.value); };
+  saved_block();
+  saved_block = (id)0;
+}
+// CHECK-LABEL: define{{.*}} void @cleanup_byref_record(
+// CHECK: call void @release_marker(
+// CHECK: scope.release:
+// CHECK: call void @_Block_object_dispose(
+// CHECK: ret void
+
+void cleanup_byref_carrier(void) {
+  int marker __attribute__((cleanup(release_marker))) = 1;
+  id source = make_owner();
+  __block __objc3_optional(id) value = __objc3_some(id, source);
+  source = (id)0;
+  saved_block = ^{ (void)__objc3_has_value(value); };
+  saved_block();
+  saved_block = (id)0;
+  may_throw();
+}
+// CHECK-LABEL: define{{.*}} void @cleanup_byref_carrier(
+// CHECK: invoke void @may_throw(
+// CHECK: call void @release_marker(
+// CHECK: scope.release:
+// CHECK: call void @_Block_object_dispose(
+// CHECK: ret void
+#ifdef __cplusplus
+}
+#endif
diff --git a/clang/test/ObjC3/Analysis/defer-native-cxx.mm b/clang/test/ObjC3/Analysis/defer-native-cxx.mm
