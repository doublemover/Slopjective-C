+//===--- CGObjC3Carriers.h - ObjC3 carrier CodeGen adapter ------*- C++ -*-===//
+//
+// Staged adapter for canonical ObjC3 Optional/Result storage.  This header is
+// intentionally private to Clang CodeGen; it does not declare a source ABI.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3CARRIERS_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3CARRIERS_H
+
+#include "Address.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/Basic/LLVM.h"
+
+namespace llvm {
+class StructType;
+class Type;
+} // namespace llvm
+
+namespace clang {
+class QualType;
+class SourceLocation;
+class ObjC3OptionalExpr;
+class Expr;
+namespace CodeGen {
+class CodeGenModule;
+class CodeGenFunction;
+
+enum class ObjC3CarrierPayloadArm : unsigned char { Value, Success, Error };
+
+/// Physical memory type and tag field for the AST-owned hidden carrier record.
+/// A payload can have storage even when an empty C++ field is omitted from the
+/// physical LLVM record. Payload addresses use AST field offsets instead.
+struct ObjC3CarrierStorageLayout {
+  llvm::StructType *StorageType = nullptr;
+  unsigned TagField = ~0U;
+  bool HasPayloadStorage = false;
+
+  bool hasPayloadStorage() const { return HasPayloadStorage; }
+};
+
+/// Translate only the representation already owned by ASTContext. This uses
+/// Clang's target record converter and field maps, preserving target padding,
+/// alignment, zero-sized/void-arm tags, and union offsets.
+bool getObjC3CarrierStorageLayout(CodeGenModule &CGM, QualType CarrierType,
+                                  ObjC3CarrierStorageLayout &Result);
+
+/// Field-address and discriminant hooks for address-backed carrier values.
+/// PayloadAddress returns invalid for a void/unavailable arm. The caller must
+/// test the discriminant before reading an arm and must initialize the active
+/// arm before storing a present tag.
+Address getObjC3CarrierTagAddress(CodeGenFunction &CGF, Address CarrierStorage,
+                                  QualType CarrierType);
+Address getObjC3CarrierPayloadAddress(CodeGenFunction &CGF,
+                                      Address CarrierStorage,
+                                      QualType CarrierType,
+                                      ObjC3CarrierPayloadArm Arm);
+llvm::Value *emitObjC3CarrierLoadTag(CodeGenFunction &CGF,
+                                     Address CarrierStorage,
+                                     QualType CarrierType, SourceLocation Loc,
+                                     bool IsVolatile = false);
+bool emitObjC3CarrierStoreTag(CodeGenFunction &CGF, Address CarrierStorage,
+                              QualType CarrierType, llvm::Value *TagValue,
+                              bool IsInitialization,
+                              bool IsVolatile = false);
+
+/// Emit the first qualified Optional expression subset. Aggregate construction
+/// accepts only payloads whose storage/lifetime facts are already proven plain;
+/// the caller must not fall back to an ordinary aggregate copy on false.
+bool emitObjC3OptionalAggregateExpr(CodeGenFunction &CGF,
+                                    const ObjC3OptionalExpr &E,
+                                    Address Destination,
+                                    bool DestinationIsIgnored,
+                                    bool DestinationIsVolatile,
+                                    bool IsLocalCarrierInitialization = false);
+
+/// Evaluate HasValue's carrier operand once, then read only the explicit tag.
+/// Unsupported payload ownership is diagnosed before any generic copy path.
+llvm::Value *emitObjC3OptionalHasValueExpr(CodeGenFunction &CGF,
+                                           const ObjC3OptionalExpr &E);
+
+/// Copy an initialized Optional using only its discriminant and active
+/// payload. Sema must already have admitted this copy operation. This helper
+/// performs no move, destruction, or by-value call-ABI adaptation. The caller
+/// must not fall back to whole-carrier copying when it returns true.
+bool emitObjC3OptionalCopy(CodeGenFunction &CGF, QualType CarrierType,
+                           Address Destination, Address Source,
+                           bool DestinationIsVolatile,
+                           bool SourceIsVolatile, bool IsInitialization,
+                           SourceLocation Loc);
+
+/// Shared private payload-copy checks used by Optional and Result transfer.
+/// Nested carriers recurse through the corresponding copy helper; aggregates
+/// containing carrier subobjects remain unsupported by this packet.
+bool supportsObjC3CarrierCopyPayload(CodeGenModule &CGM, QualType PayloadType,
+                                     unsigned Depth = 0);
+bool validateObjC3CarrierCopyStorage(CodeGenFunction &CGF,
+                                     QualType CarrierType,
+                                     Address Destination, Address Source,
+                                     unsigned Depth = 0);
+bool emitObjC3CarrierCopyPayload(CodeGenFunction &CGF, QualType PayloadType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile,
+                                 bool IsInitialization, SourceLocation Loc,
+                                 unsigned Depth = 0);
+
+/// Compute the target's ordinary C argument and result classifications for a
+/// one-argument probe whose argument and result are the carrier record. This
+/// is deliberately available only for recursively trivial, non-ARC payloads
+/// without nested carriers. It is diagnostic/probe data only; function
+/// signature normalization and source parameter/result adapters are not wired.
+struct ObjC3CarrierCallABI {
+  unsigned ResultKind = 0;
+  unsigned ArgumentKind = 0;
+  llvm::Type *ResultCoerceType = nullptr;
+  llvm::Type *ArgumentCoerceType = nullptr;
+};
+
+bool classifyObjC3CarrierCallABI(CodeGenModule &CGM, QualType CarrierType,
+                                 ObjC3CarrierCallABI &Result);
+
+/// Project a plain Optional/Result source type to its exact AST-owned native
+/// record for the admitted Windows x86_64 C calling convention. Returns true
+/// only when SourceType is a carrier and the complete payload tree is eligible.
+/// The returned QualType is an ABI classification type, not a source type.
+bool getObjC3CarrierABIProjectionType(CodeGenModule &CGM, QualType SourceType,
+                                      QualType &ABIType);
+
+/// Create a zero-initialized ABI snapshot of a carrier, then copy only its
+/// discriminant and active payload. Destination must be fresh, disjoint
+/// storage with the AST-owned representation type; Source remains untouched.
+/// This is for native ABI coercion only and does not imply carrier ownership
+/// semantics beyond the copy operation admitted by Sema.
+bool emitObjC3CarrierABISnapshot(CodeGenFunction &CGF, QualType CarrierType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile, SourceLocation Loc);
+
+/// Diagnose by-value carriers in an ordinary free-function type unless every
+/// direct carrier parameter/result is eligible for the narrow Windows x64 C ABI
+/// projection. Carriers nested in an ordinary aggregate remain unsupported.
+bool diagnoseUnsupportedObjC3CarrierFreeFunctionABI(
+    CodeGenModule &CGM, QualType FunctionType, SourceLocation Loc);
+
+/// Variadic actual arguments have no formal source type to project. Reject a
+/// carrier or aggregate containing one before CodeGen arranges the ellipsis.
+bool diagnoseUnsupportedObjC3CarrierVariadicArgument(
+    CodeGenModule &CGM, QualType ArgumentType, SourceLocation Loc);
+
+/// True only when the carrier can be materialized as plain local storage with
+/// no C++ special-member or ARC lifetime operation. This does not qualify
+/// initialization, copy, move, destruction, or call-ABI lowering.
+bool supportsPlainObjC3CarrierStorageLifetime(CodeGenModule &CGM,
+                                              QualType CarrierType);
+
+/// True for materialized direct Optional/Result storage whose selected payload
+/// can use ordinary C++ construction/destruction. Nested carriers, ARC-bearing
+/// subobjects, nontrivial C records, and incomplete payloads remain rejected.
+bool supportsObjC3CarrierCppLocalLifetime(CodeGenModule &CGM,
+                                           QualType CarrierType);
+bool hasObjC3CarrierCppLocalDestructor(CodeGenModule &CGM,
+                                        QualType CarrierType);
+/// Destroy only the active C++ payload arm using Clang's ordinary destroyer.
+/// The caller must have registered a NormalAndEH cleanup after successful
+/// aggregate initialization; the discriminant is never read earlier.
+bool emitObjC3CarrierDestroyActivePayload(CodeGenFunction &CGF,
+                                          QualType CarrierType,
+                                          Address CarrierStorage,
+                                          bool IsVolatile);
+
+/// Diagnose a function type that passes a carrier itself, or a complete
+/// aggregate containing a carrier, by value. Pointer pointees are not walked.
+bool diagnoseUnsupportedObjC3CarrierByValue(CodeGenModule &CGM,
+                                            QualType FunctionType,
+                                            SourceLocation Loc);
+
+/// Emit a precise error before ordinary call lowering can silently apply a
+/// wrong ABI to an unsupported payload operation.
+void diagnoseUnsupportedObjC3CarrierOperation(CodeGenModule &CGM,
+                                              SourceLocation Loc,
+                                              QualType CarrierType,
+                                              const char *Operation);
+
+} // namespace CodeGen
+} // namespace clang
+
+#endif
diff --git a/clang/lib/CodeGen/CGObjC3ResultExpr.cpp b/clang/lib/CodeGen/CGObjC3ResultExpr.cpp
new file mode 100644
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ResultExpr.cpp
@@ -0,0 +1,276 @@
+//===--- CGObjC3ResultExpr.cpp - Private Result expression lowering
+//---------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3ResultExpr.h"
+#include "CGObjC3Carriers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/Type.h"
+#include "llvm/IR/Constants.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+bool CodeGen::emitObjC3ResultAggregateExpr(CodeGenFunction &CGF,
+                                           const ObjC3ResultExpr &E,
+                                           Address Destination,
+                                           bool DestinationIsIgnored,
+                                           bool DestinationIsVolatile,
+                                           bool IsLocalCarrierInitialization) {
+  const bool IsOk = E.getKind() == ObjC3ResultExpr::Kind::Ok;
+  const bool IsErr = E.getKind() == ObjC3ResultExpr::Kind::Err;
+  if (!IsOk && !IsErr)
+    return false;
+
+  const QualType CarrierType = E.getCarrierType();
+  ASTContext &Ctx = CGF.getContext();
+  const Type *CanonicalCarrier = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const auto *Result = dyn_cast<ObjC3ResultType>(CanonicalCarrier);
+  const auto Representation =
+      Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (!Result ||
+      Representation.State !=
+          ObjC3CarrierRepresentationInfo::Status::Materialized ||
+      !Representation.Record || !Representation.TagField) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "unmaterialized Result construction");
+    return true;
+  }
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) &&
+      !(IsLocalCarrierInitialization && !DestinationIsIgnored &&
+        supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        IsOk ? "Ok construction" : "Err construction");
+    return true;
+  }
+  Expr *Payload = E.getPayload();
+  TypeSourceInfo *PayloadInfo =
+      IsOk ? E.getSuccessTypeInfo() : E.getErrorTypeInfo();
+  if (!Payload || !PayloadInfo) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result payload construction");
+    return true;
+  }
+  QualType ExpectedPayloadType =
+      IsOk ? Result->getSuccessType() : Result->getErrorType();
+  FieldDecl *SelectedPayloadField =
+      IsOk ? Representation.SuccessField : Representation.ErrorField;
+  if (!Ctx.hasSameType(PayloadInfo->getType(), ExpectedPayloadType) ||
+      (ExpectedPayloadType->isVoidType() ? SelectedPayloadField != nullptr
+                                         : !SelectedPayloadField) ||
+      (SelectedPayloadField &&
+       !Ctx.hasSameType(SelectedPayloadField->getType(),
+                        ExpectedPayloadType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "mismatched Result active payload");
+    return true;
+  }
+
+  // Discarding the constructed value still evaluates the selected payload once.
+  if (DestinationIsIgnored) {
+    (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(), true);
+    return true;
+  }
+  ObjC3CarrierStorageLayout Layout;
+  if (!Destination.isValid() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      Destination.getElementType() != Layout.StorageType) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result storage construction");
+    return true;
+  }
+
+  QualType PayloadType = PayloadInfo->getType();
+  if (PayloadType->isVoidType()) {
+    (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(), true);
+  } else {
+    Address PayloadStorage = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType,
+        IsOk ? ObjC3CarrierPayloadArm::Success : ObjC3CarrierPayloadArm::Error);
+    if (!PayloadStorage.isValid()) {
+      diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, E.getKeywordLoc(),
+                                               CarrierType,
+                                               "Result active payload storage");
+      return true;
+    }
+    // Match Optional lowering: EmitAnyExprToMem loses qualifiers that exist
+    // only on the carrier destination for scalar expressions.
+    const bool PayloadIsVolatile =
+        DestinationIsVolatile || PayloadType.isVolatileQualified();
+    if (PayloadType->isScalarType()) {
+      llvm::Value *Value = CGF.EmitScalarExpr(Payload);
+      CGF.EmitStoreOfScalar(Value, PayloadStorage, PayloadIsVolatile,
+                            PayloadType, AlignmentSource::Type,
+                            /*isInit=*/true);
+    } else {
+      Qualifiers Quals = PayloadType.getQualifiers();
+      if (DestinationIsVolatile)
+        Quals.addVolatile();
+      CGF.EmitAnyExprToMem(Payload, PayloadStorage, Quals, true);
+    }
+  }
+
+  // Tag true denotes success; an error with a zero/false/void payload is an
+  // actual error. Commit the tag after initialization of only its active arm.
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(IsOk), true,
+                                DestinationIsVolatile)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result tag initialization");
+  }
+  return true;
+}
+
+llvm::Value *CodeGen::emitObjC3ResultIsOkExpr(CodeGenFunction &CGF,
+                                              const ObjC3ResultExpr &E) {
+  QualType CarrierType = E.getCarrierType();
+  auto Fail = [&](const char *Operation) -> llvm::Value * {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, E.getKeywordLoc(),
+                                             CarrierType, Operation);
+    return llvm::PoisonValue::get(CGF.ConvertType(E.getType()));
+  };
+  const Type *CanonicalCarrier =
+      CGF.getContext().getCanonicalType(CarrierType).getTypePtr();
+  if (!isa<ObjC3ResultType>(CanonicalCarrier))
+    return Fail("non-Result IsOk carrier");
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType))
+    return Fail("IsOk query");
+  Expr *Operand = E.getPayload();
+  if (!Operand)
+    return Fail("IsOk operand");
+
+  Address Storage = Address::invalid();
+  if (Operand->isGLValue()) {
+    Storage = CGF.EmitLValue(Operand).getAddress();
+  } else {
+    Storage = CGF.CreateMemTemp(CarrierType, "objc3.result.isok");
+    Qualifiers TempQualifiers;
+    if (Operand->getType().isVolatileQualified())
+      TempQualifiers.addVolatile();
+    CGF.EmitAnyExprToMem(Operand, Storage, TempQualifiers, true);
+  }
+  Address Tag = getObjC3CarrierTagAddress(CGF, Storage, CarrierType);
+  if (!Tag.isValid())
+    return Fail("IsOk tag read");
+  return CGF.EmitLoadOfScalar(Tag, Operand->getType().isVolatileQualified(),
+                              CGF.getContext().BoolTy, E.getExprLoc());
+}
+
+namespace {
+bool emitResultCopyImpl(CodeGenFunction &CGF, QualType CarrierType,
+                        Address Destination, Address Source,
+                        bool DestinationIsVolatile, bool SourceIsVolatile,
+                        bool IsInitialization, SourceLocation Loc) {
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || !Source.isValid() || Destination.isSigned() ||
+      Source.isSigned() || Destination.getElementType() != Layout.StorageType ||
+      Source.getElementType() != Layout.StorageType ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source))
+    return false;
+
+  ASTContext &Ctx = CGF.getContext();
+  const auto *Result = dyn_cast<ObjC3ResultType>(
+      Ctx.getCanonicalType(CarrierType).getTypePtr());
+  if (!Result)
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  Address SrcSuccess = Address::invalid();
+  Address DstSuccess = Address::invalid();
+  Address SrcError = Address::invalid();
+  Address DstError = Address::invalid();
+  if (Info.SuccessField) {
+    SrcSuccess = getObjC3CarrierPayloadAddress(
+        CGF, Source, CarrierType, ObjC3CarrierPayloadArm::Success);
+    DstSuccess = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Success);
+    if (!SrcSuccess.isValid() || !DstSuccess.isValid())
+      return false;
+  }
+  if (Info.ErrorField) {
+    SrcError = getObjC3CarrierPayloadAddress(
+        CGF, Source, CarrierType, ObjC3CarrierPayloadArm::Error);
+    DstError = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Error);
+    if (!SrcError.isValid() || !DstError.isValid())
+      return false;
+  }
+
+  llvm::Value *IsOk = emitObjC3CarrierLoadTag(
+      CGF, Source, CarrierType, Loc, SourceIsVolatile);
+  if (!IsOk)
+    return false;
+  llvm::BasicBlock *CopySuccess =
+      CGF.createBasicBlock("objc3.result.copy.ok");
+  llvm::BasicBlock *CopyError =
+      CGF.createBasicBlock("objc3.result.copy.error");
+  llvm::BasicBlock *Continue = CGF.createBasicBlock("objc3.result.copy.cont");
+  CGF.Builder.CreateCondBr(IsOk, CopySuccess, CopyError);
+
+  CGF.EmitBlock(CopySuccess);
+  if (Info.SuccessField &&
+      !emitObjC3CarrierCopyPayload(
+          CGF, Result->getSuccessType(), DstSuccess, SrcSuccess,
+          DestinationIsVolatile, SourceIsVolatile, IsInitialization, Loc))
+    return false;
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(true), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+
+  CGF.EmitBlock(CopyError);
+  if (Info.ErrorField &&
+      !emitObjC3CarrierCopyPayload(
+          CGF, Result->getErrorType(), DstError, SrcError,
+          DestinationIsVolatile, SourceIsVolatile, IsInitialization, Loc))
+    return false;
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(false), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+  CGF.EmitBlock(Continue);
+  return true;
+}
+} // namespace
+
+bool CodeGen::emitObjC3ResultCopy(CodeGenFunction &CGF, QualType CarrierType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile,
+                                 bool IsInitialization, SourceLocation Loc) {
+  ASTContext &Ctx = CGF.getContext();
+  const auto *Result = dyn_cast<ObjC3ResultType>(
+      Ctx.getCanonicalType(CarrierType).getTypePtr());
+  if (!Result ||
+      !supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) ||
+      !supportsObjC3CarrierCopyPayload(CGF.CGM, Result->getSuccessType()) ||
+      !supportsObjC3CarrierCopyPayload(CGF.CGM, Result->getErrorType()) ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source)) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Result copy");
+    return true;
+  }
+
+  // Capture the complete active arm before touching the destination. This
+  // gives self/overlapping copies safe source-read ordering without copying
+  // either inactive union arm.
+  QualType SnapshotType = Ctx.getCanonicalType(CarrierType).getUnqualifiedType();
+  Address Snapshot = CGF.CreateMemTemp(SnapshotType,
+                                       "objc3.result.copy.snapshot");
+  if (!emitResultCopyImpl(CGF, SnapshotType, Snapshot, Source,
+                          /*DestinationIsVolatile=*/false, SourceIsVolatile,
+                          /*IsInitialization=*/true, Loc) ||
+      !emitResultCopyImpl(CGF, CarrierType, Destination, Snapshot,
+                          DestinationIsVolatile,
+                          /*SourceIsVolatile=*/false, IsInitialization, Loc))
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Result copy storage");
+  return true;
+}
