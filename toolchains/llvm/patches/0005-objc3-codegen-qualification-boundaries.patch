+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-llvm -o /dev/null %s
+// REQUIRES: x86-registered-target
+// Executed by the admitted development coalescing source matrix.
+
+typedef Optional(int) Maybe;
+static int source_calls, fallback_calls, order;
+static Maybe source(int value, int present) {
+  ++source_calls;
+  order = order * 10 + value;
+  return present ? Some(int, value) : None(int);
+}
+static int fallback(void) {
+  ++fallback_calls;
+  order = order * 10 + 9;
+  return 9;
+}
+static int same(id left, id right) { return left == right; }
+
+int main(void) {
+  if ((source(1, 1) ?? fallback()) != 1 || source_calls != 1 || fallback_calls)
+    return 1;
+  if ((source(2, 0) ?? fallback()) != 9 || source_calls != 2 || fallback_calls != 1)
+    return 2;
+  order = 0;
+  if ((source(1, 0) ?? source(2, 1) ?? fallback()) != 2 || order != 12)
+    return 3;
+  order = 0;
+  if ((source(1, 0) ?? source(2, 0) ?? fallback()) != 9 || order != 129)
+    return 4;
+  order = 0;
+  if ((source(1, 1) ?? source(2, 1) ?? fallback()) != 1 || order != 1)
+    return 5;
+  if ((Some(int, 0) ?? 1 || 1) != 0)
+    return 6;
+  if ((Some(int, 2) ?? 0 ? 3 : 4) != 3)
+    return 7;
+
+  Maybe carrier = None(int) ?? Some(int, 41);
+  if (!hasValue(carrier) || (carrier ?? 0) != 41)
+    return 8;
+  Optional(Maybe) nested = Some(Maybe, None(int));
+  carrier = nested ?? Some(int, 42);
+  if (hasValue(carrier))
+    return 9;
+  nested = None(Maybe);
+  carrier = nested ?? Some(int, 43);
+  if ((carrier ?? 0) != 43)
+    return 10;
+  Optional(void) unit = None(void) ?? Some(void, (void)0);
+  if (!hasValue(unit))
+    return 11;
+
+  // A tagged nil payload is present and must not select its nonnil fallback.
+  id marker = (id)(__UINTPTR_TYPE__)1;
+  Optional(void *) present_nil = Some(void *, (void *)0);
+  if (!same((id)(present_nil ?? (void *)marker), (id)0))
+    return 12;
+  if (!same((id)0 ?? marker, marker) || !same(marker ?? (id)0, marker))
+    return 13;
+  return 0;
+}
