+typedef __objc3_optional(id) Strong;
+typedef __objc3_optional(id __weak) Weak;
+Strong make_value(id object) { return __objc3_some(id, object); }
+// CHECK-LABEL: define{{.*}} void {{.*}}make_value{{.*}}sret(
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: store i8 1
+// CHECK: ret void
+Strong echo_value(Strong value) { return value; }
+// CHECK-LABEL: define{{.*}} void {{.*}}echo_value{{.*}}sret(
+// CHECK-NOT: byval
+// CHECK-NOT: dead_on_return
+// CHECK-NOT: llvm.memcpy
+// CHECK: br i1
+// CHECK: call ptr @llvm.objc.retain
+// CHECK-NOT: llvm.memcpy
+// CHECK: ret void
+Weak echo_weak(Weak value) { return value; }
+// CHECK-LABEL: define{{.*}} void {{.*}}echo_weak{{.*}}sret(
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK-NOT: llvm.objc.destroyWeak
+// CHECK-NOT: llvm.memcpy
+// CHECK: ret void
+void call_values(Strong *source, Weak *weak) {
+  Strong copy = echo_value(*source);
+  Weak weak_copy = echo_weak(*weak);
+  echo_value(*source);
+}
+// CHECK-LABEL: define{{.*}} void {{.*}}call_values
+// CHECK: objc3.arc.discarded.return = alloca
+// CHECK: objc3.arc.argument
+// CHECK: call void {{.*}}echo_value{{.*}}sret(
+// CHECK: call void @llvm.objc.storeStrong
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK: call void {{.*}}echo_weak{{.*}}sret(
+// CHECK: call void @llvm.objc.destroyWeak
+// CHECK: call void {{.*}}echo_value{{.*}}sret(
+// CHECK: call void @llvm.objc.storeStrong
diff --git a/clang/test/ObjC3/CodeGen/carrier-arc-call-boundaries.mm b/clang/test/ObjC3/CodeGen/carrier-arc-call-boundaries.mm
