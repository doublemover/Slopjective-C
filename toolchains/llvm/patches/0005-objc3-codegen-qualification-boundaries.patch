+// Runtime companion for carrier-expression-adversarial.c. It exercises
+// ordinary local/global/field storage and conditional/comma sequencing only;
+// it does not test or claim a carrier call ABI.
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_result(int, long long) IntResult;
+typedef __objc3_result(OptionalInt, OptionalInt) InnerResult;
+typedef __objc3_result(InnerResult, OptionalInt) NestedResult;
+
+static OptionalInt global_optional;
+struct Holder { unsigned marker; OptionalInt member; };
+static struct Holder global_holder;
+static int calls;
+static int order;
+
+static int optional_payload(void) { ++calls; return 0; }
+static int ok_payload(void) { ++calls; return 0; }
+static long long error_payload(void) { ++calls; return 0; }
+static void comma_left(void) { if (order != 0) order = -100; else order = 1; }
+static int comma_payload(void) {
+  if (order != 1) order = -100;
+  else order = 2;
+  ++calls;
+  return 0;
+}
+static void discarded(void) { ++calls; }
+static void discarded_void(void) { ++calls; }
+static void copy_nested(NestedResult *dst, const NestedResult *src) {
+  *dst = *src;
+}
+
+int main(void) {
+  calls = 0;
+  OptionalInt present = 0 ? __objc3_some(int, optional_payload())
+                           : __objc3_none(int);
+  if (__objc3_has_value(present) || calls != 0) return 1;
+  present = 1 ? __objc3_some(int, optional_payload())
+              : __objc3_none(int);
+  if (!__objc3_has_value(present) || calls != 1) return 2;
+
+  IntResult result = 1 ? __objc3_ok(int, long long, ok_payload())
+                       : __objc3_err(int, long long, error_payload());
+  if (!__objc3_is_ok(result) || calls != 2) return 3;
+  result = 0 ? __objc3_ok(int, long long, ok_payload())
+             : __objc3_err(int, long long, error_payload());
+  if (__objc3_is_ok(result) || calls != 3) return 4;
+
+  order = 0;
+  OptionalInt comma_value = (comma_left(),
+                              __objc3_some(int, comma_payload()));
+  if (!__objc3_has_value(comma_value) || order != 2 || calls != 4) return 5;
+
+  (void)__objc3_some(int, (discarded(), 0));
+  (void)__objc3_some(void, discarded_void());
+  if (calls != 6) return 6;
+
+  global_optional = __objc3_none(int);
+  global_holder.member = __objc3_none(int);
+  if (__objc3_has_value(global_optional) ||
+      __objc3_has_value(global_holder.member)) return 7;
+  global_optional = __objc3_some(int, 0);
+  global_holder.marker = 17;
+  global_holder.member = __objc3_some(int, 0);
+  if (!__objc3_has_value(global_optional) ||
+      !__objc3_has_value(global_holder.member) || global_holder.marker != 17)
+    return 8;
+
+  NestedResult destination = __objc3_ok(
+      InnerResult, OptionalInt,
+      __objc3_ok(OptionalInt, OptionalInt, __objc3_some(int, 0)));
+  NestedResult source = __objc3_err(
+      InnerResult, OptionalInt, __objc3_some(int, 0));
+  copy_nested(&destination, &source);
+  if (__objc3_is_ok(destination)) return 9;
+  source = __objc3_ok(
+      InnerResult, OptionalInt,
+      __objc3_err(OptionalInt, OptionalInt, __objc3_none(int)));
+  copy_nested(&destination, &source);
+  if (!__objc3_is_ok(destination)) return 10;
+
+  volatile OptionalInt volatile_value = __objc3_some(int, 0);
+  if (!__objc3_has_value(volatile_value)) return 11;
+  volatile_value = __objc3_none(int);
+  if (__objc3_has_value(volatile_value)) return 12;
+  return 0;
+}
