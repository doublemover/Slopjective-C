+- (int)direct:(int)n __objc3_async __attribute__((objc_direct)) { return n; }
++ (void)empty __objc3_async {}
+@end
+Value relay(Worker *worker, id<Error> error) __objc3_async __objc3_throws(id<Error>) {
+  return __objc3_try(__objc3_await [worker checked:error]);
+}
+int optional(Worker *worker, id<Error> error) __objc3_async {
+  auto result = __objc3_try_optional(__objc3_await [worker checked:error]);
+  return __objc3_has_value(result);
+}
+void ignored(Worker *worker) { [worker value:42]; [worker direct:42]; }
diff --git a/clang/test/ObjC3/CodeGen/native-async-blocks.mm b/clang/test/ObjC3/CodeGen/native-async-blocks.mm
new file mode 100644
index 000000000..20a145342
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/native-async-blocks.mm
@@ -0,0 +1,37 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -fexceptions -fcxx-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-async-task.h"
+@protocol Error @end
+struct Value { int n; Value() = delete; Value(int); Value(const Value &); ~Value(); };
+using Async = int (^)(int) __objc3_async;
+using Checked = Value (^)(id<Error>) __objc3_async __objc3_throws(id<Error>);
+int leaf(int) __objc3_async;
+Async make(int bias) __objc3_async {
+  return ^int(int n) __objc3_async {
+    return bias + __objc3_await leaf(n);
+  };
+}
+Checked checked(int n) __objc3_async {
+  return ^Value(id<Error> error) __objc3_async __objc3_throws(id<Error>) {
+    if (error) __objc3_throw(error);
+    return Value(__objc3_await leaf(n));
+  };
+}
+int invoke(Async block) __objc3_async { return __objc3_await block(2); }
+Value relay(Checked block, id<Error> error) __objc3_async __objc3_throws(id<Error>) {
+  return __objc3_try(__objc3_await block(error));
+}
+void empty() {
+  auto block = ^void() __objc3_async {};
+  (void)block();
+}
