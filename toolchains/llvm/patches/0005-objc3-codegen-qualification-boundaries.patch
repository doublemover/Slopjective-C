+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fblocks -fobjc-arc -DTEST_BLOCK=1 -emit-llvm -o /dev/null -verify %s
