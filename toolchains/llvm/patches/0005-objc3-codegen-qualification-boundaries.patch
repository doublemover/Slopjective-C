+
+#include "CGObjC3ManagedStorage.h"
+#include "CGCleanup.h"
+#include "CGDebugInfo.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3Carriers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/SHA256.h"
+using namespace clang;
+using namespace clang::CodeGen;
+namespace {
+using Operation = ObjC3StorageOperation;
+
+bool describe(ASTContext &Ctx, CodeGenModule &CGM, QualType T,
+              std::string &Description, unsigned &Budget, unsigned Depth = 0) {
+  if (T.isNull() || T->isDependentType() || T.isVolatileQualified() ||
+      Depth > 64 || Budget == 0)
+    return false;
+  --Budget;
+  if (T->isVoidType()) {
+    Description += 'V';
+    return true;
+  }
+  if (T->isIncompleteType())
+    return false;
+  Description += "q" + std::to_string(T.getObjCLifetime());
+  Description += "s" + std::to_string(Ctx.getTypeSize(T)) + "a" +
+                 std::to_string(Ctx.getTypeAlign(T)) + ":";
+  auto Child = [&](QualType C) {
+    return describe(Ctx, CGM, C, Description, Budget, Depth + 1);
+  };
+  if (const auto *Array = Ctx.getAsArrayType(T)) {
+    const auto *Constant = dyn_cast<ConstantArrayType>(Array);
+    if (!Constant)
+      return false;
+    Description += "A" + llvm::toString(Constant->getSize(), 10, false);
+    return Child(Array->getElementType());
+  }
+  if (isa<ObjC3OptionalType, ObjC3ResultType>(
+          T.getCanonicalType().getTypePtr())) {
+    if (!supportsObjC3CarrierARCLocalLifetime(CGM, T) &&
+        !supportsPlainObjC3CarrierStorageLifetime(CGM, T))
+      return false;
+    if (const auto *Optional = T->getAs<ObjC3OptionalType>()) {
+      Description += 'O';
+      return Child(Optional->getElementType());
+    }
+    const auto *Result = T->castAs<ObjC3ResultType>();
+    Description += 'R';
+    return Child(Result->getSuccessType()) && Child(Result->getErrorType());
+  }
+  if (T->isObjCObjectPointerType() || T->isBlockPointerType()) {
+    Description += T->isBlockPointerType() ? 'B' : 'I';
+    Description += std::to_string(T.getObjCLifetime());
+    return T.getObjCLifetime() != Qualifiers::OCL_Autoreleasing;
+  }
+  if (const auto *Record = T->getAs<RecordType>()) {
+    const RecordDecl *RD = Record->getDecl()->getDefinition();
+    if (!RD || RD->isUnion() || RD->hasAttr<PackedAttr>())
+      return false;
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD)) {
+      // C++ enclosing objects use their source-level special members. A C
+      // helper may only encounter a trivially copyable C++ payload.
+      if (!CXX->isTriviallyCopyable() || !CXX->hasTrivialDestructor())
+        return false;
+    }
+    Description += isa<CXXRecordDecl>(RD) ? "C{" : "S{";
+    const auto &Layout = Ctx.getASTRecordLayout(RD);
+    for (const FieldDecl *Field : RD->fields()) {
+      Description +=
+          std::to_string(Layout.getFieldOffset(Field->getFieldIndex()));
+      if (Field->isBitField())
+        Description += "b" + std::to_string(Field->getBitWidthValue());
+      if (!Child(Field->getType()))
+        return false;
+    }
+    Description += "}";
+    return true;
+  }
+  // Ordinary leaves are copied as object representations; no scalar load can
+  // accidentally evaluate an indeterminate plain field during a record copy.
+  Description += 'P';
+  return T->isScalarType() || T->isAnyComplexType() || T->isVectorType();
+}
+
+struct DestroyPrefix final : EHScopeStack::Cleanup {
+  llvm::Value *Begin;
+  Address End;
+  QualType Element;
+  CharUnits Alignment;
+  DestroyPrefix(llvm::Value *Begin, Address End, QualType Element,
+                CharUnits Alignment)
+      : Begin(Begin), End(End), Element(Element), Alignment(Alignment) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.emitArrayDestroy(Begin, CGF.Builder.CreateLoad(End), Element, Alignment,
+                         destroyObjC3ManagedStorage, true, false);
+  }
+};
+
+void emitOperation(CodeGenFunction &CGF, QualType Type, Address Dst,
+                   Address Src, Operation Op);
+
+void emitArray(CodeGenFunction &CGF, QualType Type, Address Dst, Address Src,
+               Operation Op) {
+  QualType Element;
+  auto *Array = CGF.getContext().getAsArrayType(Type);
+  llvm::Value *Count = CGF.emitArrayLength(Array, Element, Dst);
+  if (Src.isValid()) {
+    QualType SourceElement;
+    (void)CGF.emitArrayLength(Array, SourceElement, Src);
+  }
+  if (Op == Operation::Destroy) {
+    auto *Begin = Dst.emitRawPointer(CGF);
+    auto *End =
+        CGF.Builder.CreateInBoundsGEP(Dst.getElementType(), Begin, Count);
+    CGF.emitArrayDestroy(Begin, End, Element, Dst.getAlignment(),
+                         destroyObjC3ManagedStorage, true, false);
+    return;
+  }
+  CodeGenFunction::RunCleanupsScope PrefixScope(CGF);
+  llvm::Value *Begin = Dst.emitRawPointer(CGF);
+  Address End = CGF.CreateTempAlloca(CGF.VoidPtrTy, CGF.getPointerAlign(),
+                                     "objc3.storage.prefix");
+  CGF.Builder.CreateStore(Begin, End);
+  if (CGF.getLangOpts().Exceptions)
+    CGF.EHStack.pushCleanup<DestroyPrefix>(EHCleanup, Begin, End, Element,
+                                           Dst.getAlignment());
+  auto *Header = CGF.createBasicBlock("objc3.storage.array.header");
+  auto *Body = CGF.createBasicBlock("objc3.storage.array.body");
+  auto *Done = CGF.createBasicBlock("objc3.storage.array.done");
+  auto *Entry = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Header);
+  CGF.EmitBlock(Header);
+  auto *Index =
+      CGF.Builder.CreatePHI(Count->getType(), 2, "objc3.storage.index");
+  Index->addIncoming(llvm::ConstantInt::get(Count->getType(), 0), Entry);
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateICmpULT(Index, Count), Body, Done);
+  CGF.EmitBlock(Body);
+  auto At = [&](Address A, llvm::Value *I) {
+    return Address(CGF.Builder.CreateInBoundsGEP(A.getElementType(),
+                                                 A.emitRawPointer(CGF), I),
+                   A.getElementType(),
+                   CGF.getContext().getTypeAlignInChars(Element));
+  };
+  emitOperation(CGF, Element, At(Dst, Index),
+                Src.isValid() ? At(Src, Index) : Address::invalid(), Op);
+  auto *Next =
+      CGF.Builder.CreateAdd(Index, llvm::ConstantInt::get(Count->getType(), 1));
+  CGF.Builder.CreateStore(At(Dst, Next).emitRawPointer(CGF), End);
+  auto *Latch = CGF.Builder.GetInsertBlock();
+  CGF.Builder.CreateBr(Header);
+  Index->addIncoming(Next, Latch);
+  CGF.EmitBlock(Done);
+}
+
+void emitOperation(CodeGenFunction &CGF, QualType Type, Address Dst,
+                   Address Src, Operation Op) {
+  Type = CGF.getContext().getCanonicalType(Type);
+  if (Type->isArrayType())
+    return emitArray(CGF, Type, Dst, Src, Op);
+  if (hasObjC3CarrierManagedPayload(Type)) {
+    if (Op == Operation::DefaultInitialize)
+      CGF.EmitNullInitialization(Dst, Type);
+    else if (Op == Operation::Destroy)
+      emitObjC3CarrierDestroyActiveARCPayload(CGF, Type, Dst, true, true, true);
+    else
+      emitObjC3CarrierARCStorageCopy(CGF, Type, Dst, Src,
+                                     Op == Operation::Move);
+    return;
+  }
+  auto Life = Type.getObjCLifetime();
+  if (Life == Qualifiers::OCL_Strong || Life == Qualifiers::OCL_Weak) {
+    if (Op == Operation::DefaultInitialize) {
+      CGF.EmitNullInitialization(Dst, Type);
+      return;
+    }
+    if (Op == Operation::Destroy) {
+      if (Life == Qualifiers::OCL_Weak)
+        CGF.EmitARCDestroyWeak(Dst);
+      else
+        CGF.destroyARCStrongPrecise(CGF, Dst, Type);
+      return;
+    }
+    if (Life == Qualifiers::OCL_Weak) {
+      if (Op == Operation::Move)
+        CGF.EmitARCMoveWeak(Dst, Src);
+      else
+        CGF.EmitARCCopyWeak(Dst, Src);
+      return;
+    }
+    auto *Value = CGF.EmitLoadOfScalar(Src, false, Type, SourceLocation());
+    if (Op == Operation::Move)
+      CGF.EmitStoreOfScalar(llvm::Constant::getNullValue(Value->getType()), Src,
+                            false, Type, AlignmentSource::Type, false);
+    else
+      Value = CGF.EmitARCRetain(Type, Value);
+    CGF.EmitStoreOfScalar(Value, Dst, false, Type, AlignmentSource::Type, true);
+    return;
+  }
+  if (const auto *Record = Type->getAs<RecordType>()) {
+    const RecordDecl *RD = Record->getDecl();
+    if (!isa<CXXRecordDecl>(RD)) {
+      CodeGenFunction::RunCleanupsScope Fields(CGF);
+      auto DstLV = CGF.MakeAddrLValue(Dst, Type);
+      auto SrcLV = Src.isValid() ? CGF.MakeAddrLValue(Src, Type) : LValue();
+      auto EmitField = [&](const FieldDecl *Field) {
+        auto D = CGF.EmitLValueForFieldInitialization(DstLV, Field);
+        if (Field->isBitField()) {
+          if (Op == Operation::Copy || Op == Operation::Move) {
+            auto S = CGF.EmitLValueForField(SrcLV, Field);
+            CGF.EmitStoreThroughLValue(
+                CGF.EmitLoadOfLValue(S, SourceLocation()), D);
+          }
+          return;
+        }
+        Address S = Src.isValid()
+                        ? CGF.EmitLValueForField(SrcLV, Field).getAddress()
+                        : Address::invalid();
+        emitOperation(CGF, Field->getType(), D.getAddress(), S, Op);
+        if (Op != Operation::Destroy && Field->getType().isDestructedType() &&
+            CGF.getLangOpts().Exceptions)
+          CGF.pushDestroy(EHCleanup, D.getAddress(), Field->getType(),
+                          destroyObjC3ManagedStorage, false);
+      };
+      if (Op == Operation::Destroy) {
+        SmallVector<const FieldDecl *, 16> Ordered(RD->field_begin(),
+                                                   RD->field_end());
+        for (const FieldDecl *Field : llvm::reverse(Ordered))
+          EmitField(Field);
+      } else {
+        for (const FieldDecl *Field : RD->fields())
+          EmitField(Field);
+      }
+      return;
+    }
+  }
+  if (Op == Operation::Copy || Op == Operation::Move)
+    CGF.Builder.CreateMemCpy(
+        Dst, Src, CGF.getContext().getTypeSizeInChars(Type).getQuantity());
+}
+} // namespace
+
+bool CodeGen::supportsObjC3ManagedRecordLifetime(CodeGenModule &CGM,
+                                                 QualType Type) {
+  if (!containsObjC3CarrierManagedStorage(Type))
+    return false;
+  QualType ArrayElement = Type;
+  unsigned ArrayDepth = 0;
+  while (const auto *Array = CGM.getContext().getAsArrayType(ArrayElement)) {
+    if (!isa<ConstantArrayType>(Array) || ++ArrayDepth > 64)
+      return false;
+    ArrayElement = Array->getElementType();
+  }
+  if (ArrayDepth)
+    return supportsObjC3ManagedRecordLifetime(CGM, ArrayElement) ||
+           supportsObjC3CarrierARCLocalLifetime(CGM, ArrayElement);
+  if (const auto *CXX = Type->getAsCXXRecordDecl()) {
+    if (!CXX->hasDefinition() || CXX->isUnion() || CXX->hasAttr<PackedAttr>())
+      return false;
+    for (const auto &Base : CXX->bases())
+      if (containsObjC3CarrierManagedStorage(Base.getType()) &&
+          !supportsObjC3ManagedRecordLifetime(CGM, Base.getType()))
+        return false;
+    for (const auto *Field : CXX->fields())
+      if (containsObjC3CarrierManagedStorage(Field->getType()) &&
+          !(supportsObjC3CarrierARCLocalLifetime(CGM, Field->getType()) ||
+            supportsObjC3CarrierARCLocalArray(CGM, Field->getType()) ||
+            supportsObjC3ManagedRecordLifetime(CGM, Field->getType())))
+        return false;
+    return true;
+  }
+  std::string Description;
+  unsigned Budget = 256;
+  return describe(CGM.getContext(), CGM, Type, Description, Budget);
+}
+
+bool CodeGen::supportsObjC3ManagedRecordCallABI(CodeGenModule &CGM,
+                                                QualType Type) {
+  const auto &Triple = CGM.getTarget().getTriple();
+  return !Type.isNull() && Type->isRecordType() &&
+         CGM.getLangOpts().ObjCAutoRefCount && Triple.isOSLinux() &&
+         Triple.isGNUEnvironment() &&
+         Triple.getArch() == llvm::Triple::x86_64 &&
+         CGM.getLangOpts().ObjCRuntime.getAsString() == "gnustep-2.2" &&
+         supportsObjC3ManagedRecordLifetime(CGM, Type);
+}
+
+bool CodeGen::supportsObjC3ManagedRuntimeStorage(CodeGenModule &CGM, QualType Type) {
+  if (Type.isNull() || !containsObjC3CarrierManagedStorage(Type))
+    return false;
+  unsigned Budget = 256;
+  auto Encodable = [&](auto &&Self, QualType T, unsigned Depth) -> bool {
+    if (T.isNull() || T->isDependentType() || T.isVolatileQualified() ||
+        Depth > 64 || Budget == 0)
+      return false;
+    --Budget;
+    if (T->isVoidType()) return true;
+    if (T->isIncompleteType() || T->isReferenceType() || T->isMemberPointerType())
+      return false;
+    if (hasObjC3CarrierManagedPayload(T))
+      return supportsObjC3CarrierRuntimeCallABI(CGM, T);
+    if (const auto *Array = CGM.getContext().getAsArrayType(T))
+      return isa<ConstantArrayType>(Array) &&
+             Self(Self, Array->getElementType(), Depth + 1);
+    if (const auto *RD = T->getAsRecordDecl()) {
+      if (RD->isUnion() || RD->hasAttr<PackedAttr>()) return false;
+      if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD))
+        if (!CXX->isAggregate() || CXX->getNumBases() ||
+            CXX->hasUserDeclaredConstructor() || CXX->hasUserDeclaredDestructor() ||
+            CXX->hasUserDeclaredCopyAssignment() || CXX->hasUserDeclaredMoveAssignment() ||
+            CXX->getTemplateSpecializationKind() != TSK_Undeclared)
+          return false;
+      for (const auto *Field : RD->fields())
+        if (!Self(Self, Field->getType(), Depth + 1)) return false;
+      return true;
+    }
+    if (T.getObjCLifetime() == Qualifiers::OCL_Autoreleasing)
+      return false;
+    return T->isScalarType() || T->isAnyComplexType();
+  };
+  return (supportsObjC3CarrierRuntimeCallABI(CGM, Type) ||
+          supportsObjC3ManagedRecordLifetime(CGM, Type)) && Encodable(Encodable, Type, 0);
+}
+
+bool CodeGen::supportsObjC3ManagedRecordRuntimeABI(CodeGenModule &CGM, QualType Type) {
+  return !Type.isNull() && Type->isRecordType() &&
+         supportsObjC3ManagedRecordCallABI(CGM, Type) &&
+         supportsObjC3ManagedRuntimeStorage(CGM, Type);
+}
+
+llvm::Function *CodeGen::getObjC3ManagedStorageFunction(CodeGenModule &CGM,
+                                                        QualType Type,
+                                                        Operation Op) {
+  std::string Description;
+  unsigned Budget = 256;
+  if (!describe(CGM.getContext(), CGM, Type, Description, Budget)) {
+    CGM.Error(
+        SourceLocation(),
+        "ObjC3 enclosing managed storage lifetime has no qualified lowering");
+    return nullptr;
+  }
+  llvm::SHA256 Hash;
+  Hash.update(Description);
+  std::string Name = "__objc3_v12_storage_" + std::to_string(unsigned(Op)) +
+                     "_" + llvm::toHex(Hash.final());
+  if (auto *F = CGM.getModule().getFunction(Name))
+    return F;
+  bool Binary = Op != Operation::DefaultInitialize && Op != Operation::Destroy;
+  auto &Ctx = CGM.getContext();
+  FunctionArgList Args;
+  SmallVector<CanQualType, 2> Types;
+  for (unsigned I = 0; I != (Binary ? 2u : 1u); ++I) {
+    auto *Arg =
+        ImplicitParamDecl::Create(Ctx, nullptr, SourceLocation(),
+                                  &Ctx.Idents.get(I ? "source" : "destination"),
+                                  Ctx.VoidPtrTy, ImplicitParamKind::Other);
+    Args.push_back(Arg);
+    Types.push_back(Ctx.VoidPtrTy);
+  }
+  const auto &FI =
+      CGM.getTypes().arrangeBuiltinFunctionDeclaration(Ctx.VoidTy, Types);
+  auto *F = llvm::Function::Create(CGM.getTypes().GetFunctionType(FI),
+                                   llvm::GlobalValue::InternalLinkage, Name,
+                                   &CGM.getModule());
+  CGM.SetLLVMFunctionAttributes(GlobalDecl(), FI, F, false);
+  CGM.SetLLVMFunctionAttributesForDefinition(nullptr, F);
+  CodeGenFunction CGF(CGM);
+  CGF.StartFunction(GlobalDecl(), Ctx.VoidTy, F, FI, Args);
+  auto Debug = ApplyDebugLocation::CreateArtificial(CGF);
+  auto Argument = [&](unsigned I) {
+    return Address(CGF.Builder.CreateLoad(CGF.GetAddrOfLocalVar(Args[I])),
+                   CGF.ConvertTypeForMem(Type), Ctx.getTypeAlignInChars(Type));
+  };
+  Address Dst = Argument(0), Src = Binary ? Argument(1) : Address::invalid();
+  if (Op == Operation::CopyAssign || Op == Operation::MoveAssign) {
+    CodeGenFunction::RunCleanupsScope Snapshot(CGF);
+    Address Copy = CGF.CreateMemTemp(Type, "objc3.storage.assign.snapshot");
+    emitOperation(CGF, Type, Copy, Src,
+                  Op == Operation::MoveAssign ? Operation::Move
+                                              : Operation::Copy);
+    CGF.pushDestroy(NormalAndEHCleanup, Copy, Type, destroyObjC3ManagedStorage,
+                    false);
+    emitOperation(CGF, Type, Dst, Address::invalid(), Operation::Destroy);
+    emitOperation(CGF, Type, Dst, Copy, Operation::Move);
+  } else
+    emitOperation(CGF, Type, Dst, Src, Op);
+  CGF.FinishFunction();
+  F->removeFnAttr(llvm::Attribute::NoUnwind);
+  return F;
+}
+
+bool CodeGen::emitObjC3ManagedStorageCall(CodeGenFunction &CGF, LValue Dst,
+                                          Operation Op) {
+  if (!containsObjC3CarrierManagedStorage(Dst.getType()))
+    return false;
+  if (auto *F = getObjC3ManagedStorageFunction(CGF.CGM, Dst.getType(), Op))
+    CGF.EmitRuntimeCallOrInvoke(F, {Dst.getAddress().emitRawPointer(CGF)});
+  return true;
+}
+bool CodeGen::emitObjC3ManagedStorageCall(CodeGenFunction &CGF, LValue Dst,
+                                          LValue Src, Operation Op) {
+  if (!containsObjC3CarrierManagedStorage(Dst.getType()))
+    return false;
+  if (Src.getType().isConstQualified()) {
+    if (Op == Operation::Move)
+      Op = Operation::Copy;
+    if (Op == Operation::MoveAssign)
+      Op = Operation::CopyAssign;
+  }
+  if (auto *F = getObjC3ManagedStorageFunction(CGF.CGM, Dst.getType(), Op))
+    CGF.EmitRuntimeCallOrInvoke(F, {Dst.getAddress().emitRawPointer(CGF),
+                                    Src.getAddress().emitRawPointer(CGF)});
+  return true;
+}
+void CodeGen::destroyObjC3ManagedStorage(CodeGenFunction &CGF, Address Storage,
+                                         QualType Type) {
+  if (const auto *CXX = Type->getAsCXXRecordDecl()) {
+    if (!CXX->hasTrivialDestructor())
+      CGF.destroyCXXObject(CGF, Storage, Type);
+    return;
+  }
+  emitOperation(CGF, Type, Storage, Address::invalid(), Operation::Destroy);
+}
