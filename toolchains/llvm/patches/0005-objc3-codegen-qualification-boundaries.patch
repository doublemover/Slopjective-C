+  RuntimeErrorBlock Stack = ^int(int fail) __objc3_throws(RuntimeError) {
+    @autoreleasepool { if (fail) __objc3_throw(error); }
+    return Sequence++;
+  };
+  return (RuntimeErrorBlock)_Block_copy((const void *)Stack);
+}
+extern "C" int run_mrc_block_checks(void) {
+  int Before = zero_code_error_deallocations();
+  int Live = 0, Cleanups = 0;
+  @autoreleasepool {
+    OwnedError Owner;
+    RuntimeErrorBlock Arc = make_arc_error_block(Owner.Object, &Live, &Cleanups);
+    RuntimeErrorBlock MRC = make_mrc_error_block(Owner.Object);
+    if (Live != 1 || __objc3_try_force(Arc(0)) != 0 ||
+        __objc3_try_force(MRC(0)) != 0) return 144;
+    int Caught = 0;
+    __objc3_do { __objc3_try(Arc(1)); }
+    __objc3_catch(RuntimeError error) { if (error != Owner.Object) return 145; ++Caught; }
+    if (Caught != 1 || Cleanups != 2 ||
+        __objc3_has_value(__objc3_try_optional(MRC(1)))) return 146;
+    _Block_release((const void *)Arc);
+    _Block_release((const void *)MRC);
+    if (Live != 0) return 147;
+  }
+  return zero_code_error_deallocations() == Before + 1 ? 0 : 148;
+}
+
+extern "C" void mrc_block_trap(int kind) {
+  @autoreleasepool {
