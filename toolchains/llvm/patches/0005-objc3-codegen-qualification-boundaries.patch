diff --git a/clang/test/ObjC3/CodeGen/Inputs/native-async-task.h b/clang/test/ObjC3/CodeGen/Inputs/native-async-task.h
new file mode 100644
index 000000000..771b59585
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/native-async-task.h
@@ -0,0 +1,53 @@
+#ifndef NATIVE_ASYNC_TASK_TEST_H
+#define NATIVE_ASYNC_TASK_TEST_H
+#include "../../../CodeGenCoroutines/Inputs/coroutine.h"
+namespace objc3 {
+template<class T> struct task {
+  void *frame;
+  task();
+  task(task &&);
+  ~task();
+  struct promise_type {
+    promise_type() = default;
+    void *__objc3_error = nullptr;
+    bool __objc3_error_raised = false;
+    task get_return_object();
+    std::suspend_always initial_suspend() noexcept;
+    std::suspend_always final_suspend() noexcept;
+    void unhandled_exception();
+    void return_value(T);
+  };
+  bool await_ready() noexcept;
+  void await_suspend(std::coroutine_handle<>) noexcept;
+  T await_resume();
+};
+template<> struct task<void> {
+  void *frame;
+  task();
+  task(task &&);
+  ~task();
+  struct promise_type {
+    promise_type() = default;
+    void *__objc3_error = nullptr;
+    bool __objc3_error_raised = false;
+    task get_return_object();
+    std::suspend_always initial_suspend() noexcept;
+    std::suspend_always final_suspend() noexcept;
+    void unhandled_exception();
+    void return_void();
+  };
+  bool await_ready() noexcept;
+  void await_suspend(std::coroutine_handle<>) noexcept;
+  void await_resume();
+};
+}
+template<class T> struct checked_async_adapter {
+  void __objc3_check_error();
+  bool await_ready() noexcept;
+  void await_suspend(std::coroutine_handle<>) noexcept;
+  T await_resume();
+};
+template<class T>
+checked_async_adapter<T> __objc3_async_checked(objc3::task<T>, void **);
+template<class T> using __objc3_async_task = objc3::task<T>;
+#endif
diff --git a/clang/test/ObjC3/CodeGen/native-async-functions.mm b/clang/test/ObjC3/CodeGen/native-async-functions.mm
