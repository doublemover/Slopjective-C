+CFGBlock *CFGBuilder::VisitObjC3Conditions(ArrayRef<Stmt *> Conditions,
+                                           LocalScope::const_iterator Incoming,
+                                           CFGBlock *Success, CFGBlock *Failure,
+                                           Stmt *Owner) {
+  SmallVector<LocalScope::const_iterator, 4> Before(Conditions.size());
+  SmallVector<LocalScope::const_iterator, 4> After(Conditions.size());
+  auto Position = ScopePos;
+  for (unsigned I = Conditions.size(); I; --I) {
+    After[I - 1] = Position;
+    if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Conditions[I - 1]))
+      if (Position && Position.getVarDecl() == Binding->getBindingDecl())
+        ++Position;
+    Before[I - 1] = Position;
+  }
+  assert(Position == Incoming && "condition scopes must end at incoming scope");
+  CFGBlock *Next = Success;
+  for (unsigned I = Conditions.size(); I; --I) {
+    Stmt *Condition = Conditions[I - 1];
+    auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition);
+    ScopePos = Before[I - 1];
+    // Failure releases only the successfully completed prefix. Its source
+    // cleanup runs before these bindings, outside the mandatory else body.
+    Block = nullptr;
+    Succ = Failure;
+    addAutomaticObjHandling(ScopePos, Incoming, Owner);
+    if (Binding)
+      addObjC3SourceCleanup(Binding);
+    CFGBlock *Failed = Block ? Block : Succ;
+
+    ScopePos = After[I - 1];
+    Block = nullptr;
+    Succ = Next;
+    if (Binding) {
+      addObjC3SourceCleanup(Binding);
+      CFGBlock *Initialized = VisitDeclSubExpr(Binding->getBindingStatement());
+      Next = Initialized ? Initialized : Succ;
+    }
+    Block = createBlock(false);
+    Block->setTerminator(
+        CFGTerminator(Condition, CFGTerminator::ObjC3ConditionBranch));
+    TryResult Known;
+    if (!Binding)
+      Known = tryEvaluateBool(cast<Expr>(Condition));
+    addSuccessor(Block, Next, !Known.isFalse());
+    addSuccessor(Block, Failed, !Known.isTrue());
+    ScopePos = Before[I - 1];
+    if (Binding)
+      Block = VisitDeclSubExpr(Binding->getSnapshotStatement(), true);
+    else
+      Visit(Condition, AddStmtChoice::AlwaysAdd);
+    if (badCFG)
+      return nullptr;
+    Next = Block ? Block : Succ;
+  }
+  ScopePos = Incoming;
+  return Block = Next;
+}
+
+CFGBlock *CFGBuilder::VisitObjC3GuardStmt(ObjC3GuardStmt *Guard) {
+  auto Completed = ScopePos;
+  auto Incoming = Completed;
+  for (Stmt *Condition : llvm::reverse(Guard->getConditions()))
+    if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition))
+      if (Incoming && Incoming.getVarDecl() == Binding->getBindingDecl())
+        ++Incoming;
+  CFGBlock *Success = Block ? Block : Succ;
+  ScopePos = Incoming;
+  Block = nullptr;
+  // Failed guards do not enter their success scope. Sema requires this body
+  // to leave the source region; keep a conservative successor for invalid ASTs.
+  Succ = Success;
+  Visit(Guard->getElse(), AddStmtChoice::AlwaysAdd);
+  CFGBlock *Failure = Block ? Block : Succ;
+  ScopePos = Completed;
+  return VisitObjC3Conditions(Guard->getConditions(), Incoming, Success,
+                              Failure, Guard);
+}
+
+CFGBlock *CFGBuilder::VisitObjC3IfBindingStmt(ObjC3IfBindingStmt *If) {
+  SaveAndRestore Scope(ScopePos);
+  auto Incoming = ScopePos;
+  CFGBlock *Continuation = Block ? Block : Succ;
+  Block = nullptr;
+  Succ = Continuation;
+  if (If->getElse())
+    Visit(If->getElse(), AddStmtChoice::AlwaysAdd);
+  CFGBlock *Failure = Block ? Block : Succ;
+  ScopePos = Incoming;
+  LocalScope *Bindings = nullptr;
+  for (Stmt *Condition : If->getConditions())
+    if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition))
+      Bindings = addLocalScopeForVarDecl(Binding->getBindingDecl(), Bindings);
+  auto Completed = ScopePos;
+  Block = nullptr;
+  Succ = Continuation;
+  addAutomaticObjHandling(Completed, Incoming, If);
+  Visit(If->getThen(), AddStmtChoice::AlwaysAdd);
+  CFGBlock *Success = Block ? Block : Succ;
+  ScopePos = Completed;
+  return VisitObjC3Conditions(If->getConditions(), Incoming, Success, Failure,
+                              If);
+}
+
+CFGBlock *
+CFGBuilder::VisitObjC3CarrierTransferExpr(ObjC3CarrierTransferExpr *Transfer) {
+  autoCreateBlock();
+  appendStmt(Block, Transfer);
+  CFGBlock *Continuation = Block;
+  Block = nullptr;
+  Succ = Continuation;
+  Expr *Present = Transfer->getValueInit();
+  if (!Transfer->getCarrierType()->getAs<ObjC3OptionalType>())
+    Present = Transfer->getSuccessInit();
+  if (Present)
+    Visit(Present, AddStmtChoice::AlwaysAdd);
+  CFGBlock *True = Block ? Block : Succ;
+  Block = nullptr;
+  Succ = Continuation;
+  if (Expr *Absent = Transfer->getErrorInit())
+    Visit(Absent, AddStmtChoice::AlwaysAdd);
+  CFGBlock *False = Block ? Block : Succ;
+  Block = createBlock(false);
+  Block->setTerminator(
+      CFGTerminator(Transfer, CFGTerminator::ObjC3ConditionBranch));
+  addSuccessor(Block, True);
+  addSuccessor(Block, False);
+  return Visit(Transfer->getSource(), AddStmtChoice::AlwaysAdd);
+}
+
+CFGBlock *
+CFGBuilder::VisitObjC3TransferForTemporaries(ObjC3CarrierTransferExpr *Transfer,
+                                             bool ExternallyDestructed,
+                                             TempDtorContext &Context) {
+  VisitForTemporaries(Transfer->getSource(), false, Context);
+  CFGBlock *SourceBlock = Block, *SourceSucc = Succ;
+  TempDtorContext Present(bothKnownTrue(Context.KnownExecuted, TryResult()));
+  if (Expr *Init = Transfer->getValueInit() ? Transfer->getValueInit()
+                                            : Transfer->getSuccessInit())
+    VisitForTemporaries(Init, ExternallyDestructed, Present);
+  CFGBlock *True = Block;
+  Block = SourceBlock;
+  Succ = SourceSucc;
+  TempDtorContext Absent(bothKnownTrue(Context.KnownExecuted, TryResult()));
+  if (Transfer->getErrorInit())
+    VisitForTemporaries(Transfer->getErrorInit(), ExternallyDestructed, Absent);
+  if (Present.TerminatorExpr && Absent.TerminatorExpr)
+    InsertTempDecisionBlock(Absent, True);
+  else if (Present.TerminatorExpr) {
+    Block = True;
+    InsertTempDecisionBlock(Present);
+  } else
+    InsertTempDecisionBlock(Absent);
+  Context.CollectedMTEs.append(Present.CollectedMTEs);
+  Context.CollectedMTEs.append(Absent.CollectedMTEs);
+  return Block;
+}
+
+LocalScope *CFGBuilder::addLocalScopeForDefer(DeferStmt *Statement,
+                                              LocalScope *Scope) {
+  auto *Action = new (cfg->getAllocator())
+      DeferredScopeAction{Statement, ScopePos, TryTerminatedBlock,
+                          ObjC3ErrorDispatchBlock, ObjC3ErrorDispatchScope};
+  Scope = createOrReuseLocalScope(Scope);
+  Scope->addDefer(Action);
+  ScopePos = Scope->begin();
+  return Scope;
+}
+
+CFGBlock *CFGBuilder::VisitDeferStmt(DeferStmt *Statement) {
+  if (!ScopePos || !ScopePos.getDeferredAction() ||
+      ScopePos.getDeferredAction()->Statement != Statement) {
+    badCFG = true;
+    return nullptr;
+  }
+  ++ScopePos; // Registration has no execution of the deferred body.
+  return Block;
+}
+
+static bool collectDeferredLabels(Stmt *Statement,
+                                  SmallVectorImpl<LabelDecl *> &Labels) {
+  if (!Statement)
+    return true;
+  // A copied cleanup needs its own local label namespace. Computed labels and
+  // asm-goto need a separate qualified model before they can participate.
+  if (isa<IndirectGotoStmt, AddrLabelExpr>(Statement))
+    return false;
+  if (auto *Asm = dyn_cast<GCCAsmStmt>(Statement))
+    if (Asm->isAsmGoto())
+      return false;
+  if (auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (Expr *Capture : Lambda->capture_inits())
+      if (!collectDeferredLabels(Capture, Labels))
+        return false;
+    return true;
+  }
+  if (isa<BlockExpr>(Statement))
+    return true;
+  if (auto *Label = dyn_cast<LabelStmt>(Statement))
+    Labels.push_back(Label->getDecl());
+  for (Stmt *Child : Statement->children())
+    if (!collectDeferredLabels(Child, Labels))
+      return false;
+  return true;
+}
+
+void CFGBuilder::emitDeferredScopeAction(const DeferredScopeAction &Action) {
+  SmallVector<LabelDecl *, 8> Labels;
+  if (!collectDeferredLabels(Action.Statement->getBody(), Labels)) {
+    badCFG = true;
+    return;
+  }
+  SmallVector<std::pair<LabelDecl *, std::optional<JumpTarget>>, 8> Previous;
+  for (LabelDecl *Label : Labels) {
+    auto Found = LabelMap.find(Label);
+    Previous.push_back({Label, Found == LabelMap.end()
+                                   ? std::nullopt
+                                   : std::make_optional(Found->second)});
+    LabelMap.erase(Label);
+  }
+  SaveAndRestore SaveScope(ScopePos, Action.Before);
+  SaveAndRestore SaveNative(TryTerminatedBlock, Action.NativeHandler);
+  SaveAndRestore SaveChecked(ObjC3ErrorDispatchBlock, Action.CheckedHandler);
+  SaveAndRestore SaveCheckedScope(ObjC3ErrorDispatchScope,
+                                  Action.CheckedHandlerScope);
+  size_t PatchStart = BackpatchBlocks.size();
+  CFGBlock *Continuation = Block ? Block : Succ;
+  Block = nullptr;
+  Succ = Continuation;
+  CFGBlock *Body = Visit(Action.Statement->getBody(), AddStmtChoice::AlwaysAdd);
+  if (!badCFG) {
+    Block = Body ? Body : Continuation;
+    // Finish this copy's local gotos before restoring another copy's labels.
+    // Scope-changing backpatches can recursively emit more deferred bodies.
+    size_t PatchEnd = BackpatchBlocks.size();
+    for (size_t Index = PatchStart; Index != PatchEnd; ++Index) {
+      JumpSource Source = BackpatchBlocks[Index];
+      auto *Goto = dyn_cast<GotoStmt>(Source.block->getTerminatorStmt());
+      auto Target = Goto ? LabelMap.find(Goto->getLabel()) : LabelMap.end();
+      if (!Goto || Target == LabelMap.end()) {
+        badCFG = true;
+        break;
+      }
+      JumpTarget Destination = Target->second;
+      addSuccessor(Source.block,
+                   createScopeChangesHandlingBlock(
+                       Source.scopePosition, Source.block,
+                       Destination.scopePosition, Destination.block));
+    }
+  }
+  BackpatchBlocks.resize(PatchStart);
+  for (auto &Entry : Previous)
+    if (Entry.second)
+      LabelMap[Entry.first] = *Entry.second;
+    else
+      LabelMap.erase(Entry.first);
+}
