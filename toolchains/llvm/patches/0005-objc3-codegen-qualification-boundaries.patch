+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-optional-runtime.inc
@@ -0,0 +1,178 @@
+// Managed try? keeps a strong success payload beyond the call's ordinary
+// full-expression cleanup. Failed calls must never inspect inactive storage.
+static __weak ZeroCodeError *optional_observed;
+static int optional_calls;
+
+static TestError optional_owned(TestError error) __objc3_throws(TestError)
+    __attribute__((ns_returns_retained)) {
+  ++optional_calls;
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return value;
+  }
+}
+static TestError optional_borrowed() __objc3_throws(TestError) {
+  ++optional_calls;
+  @autoreleasepool {
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return value;
+  }
+}
+static ManagedSuccessBlock optional_owned_block(TestError error)
+    __objc3_throws(TestError) __attribute__((ns_returns_retained)) {
+  ++optional_calls;
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return ^{ return [value code] + 42; };
+  }
+}
+static ManagedSuccessBlock optional_borrowed_block() __objc3_throws(TestError) {
+  @autoreleasepool {
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return ^{ return [value code] + 42; };
+  }
+}
+extern "C" void *objc_autoreleasePoolPush(void);
+extern "C" void objc_autoreleasePoolPop(void *);
+
+static void optional_native_unwind() {
+  __objc3_optional(TestError) value = __objc3_try_optional(optional_owned(nil));
+  if (!__objc3_has_value(value) || !optional_observed) __builtin_trap();
+  throw 311;
+}
+
+static int run_managed_optional_checks() {
+  int before = zero_code_error_deallocations();
+  int calls = optional_calls;
+  {
+    __objc3_optional(TestError) value = __objc3_try_optional(optional_owned(nil));
+    if (!__objc3_has_value(value) || !optional_observed) return 211;
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1 ||
+      optional_calls != calls + 1) return 212;
+
+  // Pop the callee's return-value autorelease pool while the Optional remains
+  // live. Its own reference, rather than an ambient pool, must keep it alive.
+  before = zero_code_error_deallocations();
+  void *pool = objc_autoreleasePoolPush();
+  {
+    __objc3_optional(TestError) value = __objc3_try_optional(optional_borrowed());
+    objc_autoreleasePoolPop(pool);
+    if (!__objc3_has_value(value) || !optional_observed ||
+        zero_code_error_deallocations() != before) return 213;
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 214;
+
+  before = zero_code_error_deallocations();
+  {
+    __objc3_optional(ZeroCodeError *) value =
+        __objc3_try_optional(managed_mrc_owned(nil));
+    if (!__objc3_has_value(value)) return 215;
+  }
+  if (zero_code_error_deallocations() != before + 1) return 216;
+
+  @autoreleasepool {
+    TestError owner = (TestError)make_zero_code_error();
+    auto callback = managed_object;
+    __objc3_optional(TestError) indirect = __objc3_try_optional(callback(owner, nil));
+    TestError (^block)(TestError, TestError) __objc3_throws(TestError) =
+        ^TestError(TestError value, TestError error) __objc3_throws(TestError) {
+          return __objc3_try(managed_object(value, error));
+        };
+    __objc3_optional(TestError) block_call = __objc3_try_optional(block(owner, nil));
+    ManagedMember member;
+    auto pointer = &ManagedMember::object;
+    __objc3_optional(TestError) member_call =
+        __objc3_try_optional((member.*pointer)(owner, nil));
+    ManagedSuccessReceiver *receiver = (ManagedSuccessReceiver *)
+        make_named_zero_code_error("ManagedSuccessReceiver");
+    __objc3_optional(TestError) message =
+        __objc3_try_optional([receiver object:owner error:nil]);
+    __objc3_optional(TestError) nil_success =
+        __objc3_try_optional(managed_object(nil, nil));
+    __objc3_optional(TestError) failure = __objc3_try_optional(optional_owned(owner));
+    if (!__objc3_has_value(indirect) || !__objc3_has_value(block_call) ||
+        !__objc3_has_value(member_call) || !__objc3_has_value(message) ||
+        !__objc3_has_value(nil_success) || __objc3_has_value(failure)) return 217;
+  }
+  before = zero_code_error_deallocations();
+  (void)__objc3_try_optional(optional_owned(nil));
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 218;
+  before = zero_code_error_deallocations();
+  int caught = 0;
+  try { optional_native_unwind(); }
+  catch (int value) { caught = value == 311; }
+  if (!caught || optional_observed ||
+      zero_code_error_deallocations() != before + 1) return 219;
+
+  before = zero_code_error_deallocations();
+  {
+    __objc3_optional(ManagedSuccessBlock) block =
+        __objc3_try_optional(optional_owned_block(nil));
+    if (!__objc3_has_value(block) || !optional_observed) return 221;
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 222;
+  before = zero_code_error_deallocations();
+  pool = objc_autoreleasePoolPush();
+  {
+    __objc3_optional(ManagedSuccessBlock) block =
+        __objc3_try_optional(optional_borrowed_block());
+    objc_autoreleasePoolPop(pool);
+    if (!__objc3_has_value(block) || !optional_observed) return 223;
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 224;
+  before = zero_code_error_deallocations();
+  @autoreleasepool {
+    TestError owner = (TestError)make_zero_code_error();
+    optional_observed = owner;
+    {
+      __objc3_optional(ManagedSuccessBlock) direct =
+          __objc3_some(ManagedSuccessBlock, ^{ return [owner code] + 42; });
+      __objc3_result(ManagedSuccessBlock, int) result =
+          __objc3_ok(ManagedSuccessBlock, int, ^{ return [owner code] + 42; });
+      __objc3_result(ManagedSuccessBlock, int) inactive =
+          __objc3_err(ManagedSuccessBlock, int, 7);
+      owner = nil;
+      if (!optional_observed || !__objc3_has_value(direct) ||
+          !__objc3_is_ok(result) || __objc3_is_ok(inactive)) return 225;
+    }
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 226;
+  before = zero_code_error_deallocations();
+  (void)__objc3_try_optional(optional_owned_block(nil));
+  if (optional_observed || zero_code_error_deallocations() != before + 1) return 227;
+
+  before = zero_code_error_deallocations();
+  @autoreleasepool {
+    TestError error = (TestError)make_zero_code_error();
+    __objc3_optional(ManagedSuccessBlock) failure =
+        __objc3_try_optional(optional_owned_block(error));
+    if (__objc3_has_value(failure)) return 228;
+  }
+  if (zero_code_error_deallocations() != before + 1) return 229;
+  before = zero_code_error_deallocations();
+  caught = 0;
+  try {
+    __objc3_optional(ManagedSuccessBlock) block =
+        __objc3_try_optional(optional_owned_block(nil));
+    if (!__objc3_has_value(block) || !optional_observed) return 230;
+    throw 312;
+  } catch (int value) { caught = value == 312; }
+  if (!caught || optional_observed ||
+      zero_code_error_deallocations() != before + 1) return 231;
+
+  before = zero_code_error_deallocations();
+  caught = 0;
+  try {
+    __objc3_optional(TestError) incomplete =
+        __objc3_try_optional(managed_native_exception());
+    (void)__objc3_has_value(incomplete);
+  } catch (int value) { caught = value == 73; }
+  return caught && zero_code_error_deallocations() == before + 1 ? 0 : 220;
+}
diff --git a/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-runtime.h b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-runtime.h
