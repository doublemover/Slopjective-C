+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -x objective-c++-header -emit-pch -o %t %S/Inputs/native-c-async-entry-abi.h
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -include-pch %t -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-c-async-entry-abi.h"
+static_assert(!__is_same(FrameCallback, TaskCallback));
+static_assert(__is_same(decltype(frame_leaf(1)), objc3_async_frame));
+static_assert(__is_same(decltype(task_leaf(1)), objc3::task<int>));
+// CHECK-LABEL: define{{.*}} void @_Z12pch_consumer
+// CHECK: {{call|invoke}} void @frame_leaf
+// CHECK: __objc3_async_from_frame
+// CHECK: {{call|invoke}} void @_Z9task_leafi
+int pch_consumer(int n) __objc3_async {
+  return __objc3_await frame_leaf(n) + __objc3_await task_leaf(n);
+}
diff --git a/clang/test/ObjC3/CodeGen/native-c-async-entry-abi.mm b/clang/test/ObjC3/CodeGen/native-c-async-entry-abi.mm
new file mode 100644
index 000000000..11398c076
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/native-c-async-entry-abi.mm
@@ -0,0 +1,51 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -fobjc-arc -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-c-async-entry-abi.h"
+static_assert(!__is_same(FrameCallback, TaskCallback));
+static_assert(!__is_same(FrameBlock, TaskBlock));
+static_assert(__is_same(decltype(frame_leaf(1)), objc3_async_frame));
+static_assert(__is_same(decltype(task_leaf(1)), objc3::task<int>));
+static_assert(__is_same(decltype(((FrameCallback)0)(1)), objc3_async_frame));
+static_assert(__is_same(decltype(((FrameBlock)0)(1)), objc3_async_frame));
+static_assert(__is_same(decltype([(FrameWorker *)0 value:1]), objc3_async_frame));
+static_assert(__is_same(decltype(frame_object((id)0)), objc3_async_frame));
+
+// Both caches contain logical int at once; each evaluated ABI remains distinct.
+// CHECK-LABEL: define{{.*}} void @_Z11mixed_await
+// CHECK: {{call|invoke}} void @frame_leaf(ptr {{.*}}sret(%struct.objc3_async_frame)
+// CHECK: {{call|invoke}} void {{.*}}__objc3_async_from_frame
+// CHECK: {{call|invoke}} void @_Z9task_leafi
+int mixed_await(int value, FrameCallback fn, FrameBlock block, FrameWorker *worker)
+    __objc3_async {
+  int a = __objc3_await frame_leaf(value);
+  int b = __objc3_await task_leaf(value);
+  int c = __objc3_await fn(value);
+  int d = __objc3_await block(value);
+  int e = __objc3_await [worker value:value];
+  int f = __objc3_await [worker direct:value];
+  int g = __objc3_await [FrameWorker classValue];
+  return a + b + c + d + e + f + g;
+}
+// CHECK-LABEL: define{{.*}} void @_Z13checked_await
+// CHECK: {{call|invoke}} void @frame_checked
+// CHECK: __objc3_async_from_frame
+// CHECK: __objc3_async_checked
+int checked_await(id<FrameError> error) __objc3_async __objc3_throws(id<FrameError>) {
+  return __objc3_try(__objc3_await frame_checked(error));
+}
+void empty_await() __objc3_async { __objc3_await frame_empty(); }
+id object_await(id object) __objc3_async { return __objc3_await frame_object(object); }
+// Physical frame entries remain raw owned carriers when not awaited.
+objc3_async_frame raw_call(FrameCallback fn) { return fn(42); }
+objc3_async_frame raw_message(id<FrameMethods> worker) { return [worker value:42]; }
+// A callback's function type includes the ABI discriminator in its mangling.
+// CHECK-LABEL: define{{.*}} void @_Z6acceptPU17objc3_async_frameFiiE
+void accept(FrameCallback) {}
+// CHECK-LABEL: define{{.*}} void @_Z6acceptPU11objc3_asyncFiiE
+void accept(TaskCallback) {}
+
+template<class Callback>
+int dependent_frame(Callback fn, int n) __objc3_async {
+  return __objc3_await fn(n);
+}
+template int dependent_frame<FrameCallback>(FrameCallback, int) __objc3_async;
