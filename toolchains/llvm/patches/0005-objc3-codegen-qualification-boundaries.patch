+// CPP-LABEL: define{{.*}} void @record_echo(ptr {{.*}}sret(%struct.Record){{.*}}, ptr noundef align 8 dead_on_return %value)
+// CPP: call void @_ZN6RecordC1EOS_
+// CPP: call void @_ZN6RecordD1Ev
+// CPP: ret void
+void record_assign(struct Record *dst,struct Record *src) { *dst=*src; }
