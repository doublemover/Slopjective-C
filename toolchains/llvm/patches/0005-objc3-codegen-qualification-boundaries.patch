+//===--- CGObjC3KeyPath.h - Native key-path operand ownership ----*- C++ -*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3KEYPATH_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3KEYPATH_H
+namespace llvm { class Value; }
+namespace clang {
+class Expr;
+namespace CodeGen {
+class CodeGenFunction;
+/// Create a +1 snapshot before evaluating the next written operand. The
+/// snapshot survives result construction and has precise normal/EH cleanup at
+/// the enclosing full-expression, under both ARC and manual reference counting.
+llvm::Value *emitObjC3KeyPathOperandSnapshot(CodeGenFunction &, const Expr *);
+/// Return a normalized +0 MRC getter result before precise receiver cleanup.
+/// Null means the current return is outside a compiler-owned keypath getter.
+llvm::Value *tryEmitObjC3KeyPathGetterReturn(CodeGenFunction &, const Expr *);
+} // namespace CodeGen
+} // namespace clang
+#endif
