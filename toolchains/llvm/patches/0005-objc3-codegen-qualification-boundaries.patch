+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -std=c++20 -fexceptions -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s
+
+struct Item {
+  int value;
+  Item(const Item &other) : value(other.value) {}
+  Item(Item &&other) : value(other.value) { other.value = -1; }
+  ~Item();
+};
+struct Problem {
+  int value;
+  Problem(const Problem &other) : value(other.value) {}
+  Problem(Problem &&other) : value(other.value) { other.value = -1; }
+  ~Problem();
+};
+using Maybe = __objc3_optional(Item);
+using Outcome = __objc3_result(Item, Problem);
+using MaybeInt = __objc3_optional(int);
+
+void copy_optional_int(const MaybeInt &source) {
+  MaybeInt local = __objc3_copy(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z17copy_optional_intR
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: store i32
+// CHECK: store i8 1
+
+void copy_optional(const Maybe &source) {
+  Maybe local = __objc3_copy(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z13copy_optionalR
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: call void @_ZN4ItemC1ERKS_
+// CHECK: store i8 1
+
+void move_optional(Maybe &source) {
+  Maybe local = __objc3_move(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z13move_optionalR
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: call void @_ZN4ItemC1EOS_
+// CHECK: store i8 1
+
+void move_const_optional(const Maybe &source) {
+  Maybe local = __objc3_move(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z19move_const_optionalR
+// CHECK: call void @_ZN4ItemC1ERKS_
+
+void copy_result(Outcome &source) {
+  Outcome local = __objc3_copy(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z11copy_resultR
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: call void @_ZN4ItemC1ERKS_
+// CHECK: store i8 1
+// CHECK: call void @_ZN7ProblemC1ERKS_
+// CHECK: store i8 0
+
+void move_result(Outcome &source) {
+  Outcome local = __objc3_move(source);
+  (void)local;
+}
+// CHECK-LABEL: define{{.*}} @_Z11move_resultR
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: call void @_ZN4ItemC1EOS_
+// CHECK: store i8 1
+// CHECK: call void @_ZN7ProblemC1EOS_
+// CHECK: store i8 0
+
+template <class Carrier> void dependent_copy(Carrier &source) {
+  Carrier local = __objc3_copy(source);
+  (void)local;
+}
+template void dependent_copy<Maybe>(Maybe &);
+// CHECK-LABEL: define{{.*}} @_Z14dependent_copyI
+// CHECK: call void @_ZN4ItemC1ERKS_
