+extern int increment_once(void);
+void exercise_payload_tags(void) {
+  OptionalInt zero = __objc3_some(int, 0);
+  OptionalInt absent = __objc3_none(int);
+  OptionalBool false_value = __objc3_some(_Bool, 0);
+  OptionalPointer null_value = __objc3_some(void *, (void *)0);
+  ResultVoid ok_void = __objc3_ok(void, int, (void)increment_once());
+  ResultVoid err_zero = __objc3_err(void, int, 0);
+  (void)carrier_int_identity(zero);
+  (void)carrier_int_identity(absent);
+  (void)carrier_bool_identity(false_value);
+  (void)carrier_pointer_identity(null_value);
+  (void)carrier_void_result_identity(ok_void);
+  (void)carrier_void_result_identity(err_zero);
+}
+
+int native_zero_present(void) {
+  return __objc3_has_value(__objc3_some(int, 0));
+}
+int native_false_present(void) {
+  return __objc3_has_value(__objc3_some(_Bool, 0));
+}
+int native_null_present(void) {
+  return __objc3_has_value(__objc3_some(void *, (void *)0));
+}
+int native_void_success_once(void) {
+  return __objc3_is_ok(__objc3_ok(void, int, (void)increment_once()));
+}
+int native_void_error(void) {
