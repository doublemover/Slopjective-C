+// Nested payload-arm routing is checked structurally in the IR fixture because
+// this source subset exposes carrier tags but no payload-unwrapping operation.
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_result(int, long long) PlainResult;
+typedef __objc3_result(OptionalInt, OptionalInt) InnerResult;
+typedef __objc3_result(InnerResult, OptionalInt) NestedResult;
+static int calls;
+static void side_effect(void) { ++calls; }
+static void copy_optional(OptionalInt *destination, const OptionalInt *source) {
+  *destination = *source;
+}
+static void copy_result(PlainResult *destination, const PlainResult *source) {
+  *destination = *source;
+}
+static void copy_nested_result(NestedResult *destination,
+                               const NestedResult *source) {
+  *destination = *source;
+}
+static void copy_volatile_optional(volatile OptionalInt *destination,
+                                   const volatile OptionalInt *source) {
+  *destination = *source;
+}
+static void copy_volatile_result(volatile PlainResult *destination,
+                                 const volatile PlainResult *source) {
+  *destination = *source;
+}
+
+int main(void) {
+  OptionalInt present = __objc3_some(int, 0);
+  OptionalInt absent = __objc3_none(int);
