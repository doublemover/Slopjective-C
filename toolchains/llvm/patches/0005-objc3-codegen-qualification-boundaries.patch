+// CHECK-LABEL: define{{.*}} void @_Z45optional_some_unwinds_through_payload_cleanupv
+// CHECK: landingpad
+// CHECK: call void @_ZN7TrackedD1Ev
+
+struct Throwing {
+  explicit Throwing(int) { throw 9; }
+  ~Throwing() { lifetime_event(700); }
+};
+typedef __objc3_optional(Throwing) MaybeThrowing;
+struct Guard {
