+#elif defined(TEST_ARC)
+@interface Object @end
+typedef __objc3_optional(Object *) MaybeObject;
+void query_after_rejected_lifetime(void) {
+  MaybeObject value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)__objc3_has_value(value); // expected-error {{ObjC3 carrier operation 'hasValue query'}}
+}
+#endif
diff --git a/clang/test/ObjC3/CodeGen/carrier-indirect-call-abi.c b/clang/test/ObjC3/CodeGen/carrier-indirect-call-abi.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/carrier-indirect-call-abi.c
@@ -0,0 +1,12 @@
+// RUN: not %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -emit-llvm -o /dev/null %s 2>&1 | FileCheck %s
+//
+// A typed indirect function signature is representable, but its by-value ABI
+// is unavailable on this target. The guard must reject it before target ABIInfo sees it.
+
+typedef __objc3_optional(long long) OptionalI64;
+typedef OptionalI64 (*CarrierFunction)(OptionalI64);
+void call_indirect(CarrierFunction function) {
+  OptionalI64 local;
+  function(local);
+}
+// CHECK: ObjC3 carrier operation 'by-value call ABI'
