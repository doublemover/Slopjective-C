+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -triple x86_64-unknown-linux-gnu -emit-llvm -o - %s | FileCheck %s
+// Adversarial aggregate-expression coverage; no carrier by-value ABI claim.
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_result(int, long long) IntResult;
+typedef __objc3_optional(IntResult) OptionalResult;
+typedef __objc3_result(IntResult, OptionalInt) NestedResult;
+
+static OptionalInt global_optional;
+struct Holder { unsigned marker; OptionalInt member; };
+static struct Holder global_holder;
+
+extern int next_optional_payload(void);
+extern int next_ok_payload(void);
+extern long long next_error_payload(void);
+extern void mark_comma_left(void);
+extern void discarded_side_effect(void);
+extern void discarded_void_side_effect(void);
+
+void optional_from_conditional(int choose, int use_input) {
+  OptionalInt selected = choose
+      ? __objc3_some(int, use_input ? next_optional_payload() : 0)
+      : __objc3_none(int);
+  global_optional = selected;
+}
+// CHECK-LABEL: define{{.*}} @optional_from_conditional(
+// The payload call occurs only on the Some edge; both edges initialize a tag.
+// CHECK-DAG: call i32 @next_optional_payload()
+// CHECK-DAG: store i8 1
+// CHECK-DAG: store i8 0
+
+void result_from_conditional(int choose) {
+  IntResult selected = choose
+      ? __objc3_ok(int, long long, next_ok_payload())
+      : __objc3_err(int, long long, next_error_payload());
+  global_holder.member = __objc3_some(int, __objc3_is_ok(selected));
+}
+// CHECK-LABEL: define{{.*}} @result_from_conditional(
+// Each arm's operand is lowered in its selected branch, then the active tag is
+// written. The final Optional records the queried result without returning a
+// carrier through the function ABI.
+// CHECK: call i32 @next_ok_payload()
+// CHECK: store i8 1
+// CHECK: call i64 @next_error_payload()
+// CHECK: store i8 0
+
+void optional_from_comma(void) {
+  OptionalInt selected = (mark_comma_left(),
+                          __objc3_some(int, next_optional_payload()));
+  global_optional = selected;
+}
+// CHECK-LABEL: define{{.*}} @optional_from_comma()
+// CHECK: call void @mark_comma_left()
+// CHECK: call i32 @next_optional_payload()
+// CHECK: store i8 1
+
+void discard_some(void) {
+  (void)__objc3_some(int, next_optional_payload());
+}
+// CHECK-LABEL: define{{.*}} @discard_some()
+// A discarded constructor still evaluates its child exactly once.
+// CHECK-COUNT-1: call i32 @next_optional_payload()
+// CHECK-NOT: objc3.optional
+
+void discard_void_some(void) {
+  (void)__objc3_some(void, discarded_void_side_effect());
+  (void)__objc3_some(int, (discarded_side_effect(), 0));
+}
+// CHECK-LABEL: define{{.*}} @discard_void_some()
+// CHECK-COUNT-1: call void @discarded_void_side_effect()
+// CHECK-COUNT-1: call void @discarded_side_effect()
+
+void assign_global_and_field(int present, int payload) {
+  global_optional = present ? __objc3_some(int, payload) : __objc3_none(int);
+  global_holder.marker = 7;
+  global_holder.member = present ? __objc3_some(int, payload) : __objc3_none(int);
+}
