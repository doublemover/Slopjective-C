diff --git a/clang/test/ObjC3/CodeGen/native-isolation-executor-entry.m b/clang/test/ObjC3/CodeGen/native-isolation-executor-entry.m
new file mode 100644
index 000000000..c01bde977
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/native-isolation-executor-entry.m
@@ -0,0 +1,63 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -fobjc-arc -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-c-async-frame.h"
+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface Message <Sendable> @end
+extern int source_argument(void);
+extern int main_entry(int, Message *) __attribute__((objc_executor(main)));
+extern int global_entry(int) __attribute__((objc_executor(global)));
+extern int named_entry(int) __attribute__((objc_executor(named("database.serial"))));
+int parent(Message *message) __objc3_async {
+  int a = __objc3_await main_entry(source_argument(), message);
+  int b = __objc3_await global_entry(a);
+  return __objc3_await named_entry(b);
+}
+// Each private frame owns converted arguments before its initial suspension.
+// Calls remain in the child frame after the executor-entry suspension; the
+// parent's dependency resumes through the parent's original destination.
+// CHECK-DAG: {{call|invoke}} i32 @objc3_executor_get_main
+// CHECK-DAG: {{call|invoke}} i32 @objc3_executor_get_global
+// CHECK-DAG: {{call|invoke}} i32 @objc3_executor_get_named
+// CHECK-DAG: {{call|invoke}} i32 @objc3_executor_is_current
+// CHECK-DAG: {{call|invoke}} i32 @objc3_task_hop
+// CHECK-DAG: {{call|invoke}} void @objc3_executor_release
+// CHECK-DAG: {{call|invoke}}{{.*}} @{{llvm.objc.retain|objc_retain}}
+// CHECK-DAG: {{call|invoke}} i32 @objc3_async_frame_start_child
+// CHECK-DAG: {{call|invoke}} i32 @objc3_task_await
+// CHECK-DAG: {{call|invoke}} i32 @objc3_task_copy_result
+// CHECK-DAG: {{call|invoke}} i8 @llvm.coro.suspend
+// CHECK-DAG: {{call|invoke}} i32 @main_entry
+// CHECK-DAG: {{call|invoke}} i32 @global_entry
+// CHECK-DAG: {{call|invoke}} i32 @named_entry
+
+actor class Counter : Message
+- (int)read __attribute__((nothrow));
+- (int)affineRead __attribute__((nothrow, objc_executor(named("database.serial"))));
+@end
+extern Counter *source_receiver(void);
+int actor_parent(void) __objc3_async {
+  int first = __objc3_await [source_receiver() read];
+  return first + __objc3_await [source_receiver() affineRead];
+}
+// CHECK-DAG: {{call|invoke}} i32 @objc3_actor_get_for_object
+// CHECK-DAG: {{call|invoke}} i64 @objc3_actor_executor_identity
+// CHECK-DAG: {{call|invoke}} i64 @objc3_executor_identity
+// CHECK-DAG: {{call|invoke}} void @objc3_actor_release
+
+extern Message *owned_entry(void)
+    __attribute__((objc_executor(global), ns_returns_retained));
+Message *owned_parent(void) __objc3_async {
+  return __objc3_await owned_entry();
+}
+// CHECK-DAG: {{call|invoke}} ptr @owned_entry
+// CHECK-DAG: {{call|invoke}} void @{{llvm.objc.release|objc_release}}
+
+@protocol Error @end
+@protocol HopError <Error, Sendable> @end
+extern int checked_frame(id<HopError>) __objc3_async_frame
+    __objc3_throws(id<HopError>) __attribute__((objc_executor(main)));
+int checked_parent(id<HopError> error) __objc3_async __objc3_throws(id<HopError>) {
+  return __objc3_try(__objc3_await checked_frame(error));
+}
+// CHECK-DAG: {{call|invoke}} void @checked_frame
+// CHECK-DAG: {{call|invoke}} ptr @__objc3_task_error_object
