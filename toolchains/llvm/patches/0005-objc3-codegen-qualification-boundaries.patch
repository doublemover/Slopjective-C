+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3ABIBOUNDARIES_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3ABIBOUNDARIES_H
+#include "clang/AST/Type.h"
