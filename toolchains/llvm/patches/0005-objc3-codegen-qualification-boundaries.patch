+// CHECK: call ptr @llvm.objc.retain
+// CHECK: call void @llvm.objc.storeStrong
+// CHECK: store ptr null
+// CHECK: store ptr
+
+void assign_weak(Weak *destination, const Weak *source) {
+  *destination = *source;
+}
+// CHECK-LABEL: define{{.*}}assign_weak
