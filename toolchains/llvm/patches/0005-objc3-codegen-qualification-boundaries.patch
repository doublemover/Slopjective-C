+
+extern MaybeOwned external_owned;
+extern MaybeOwned other_owned;
+
+@interface Object
+@end
+typedef __objc3_optional(Object *) MaybeObject;
+
+#if defined(TEST_CARRIER_BY_VALUE)
+MaybeOwned by_value(MaybeOwned value) { // expected-error-re {{ObjC3 carrier operation 'by-value call ABI' for type {{.*}} has no qualified lowering: {{.*}}}}
+  return value;
+}
+#elif defined(TEST_CARRIER_LIFETIME)
+void scope_lifetime(void) {
+  MaybeOwned value; // expected-error-re {{ObjC3 carrier operation 'local lifetime' for type {{.*}} has no qualified lowering: {{.*}}}}
+}
+#elif defined(TEST_CARRIER_COPY)
+void copy_nontrivial_carrier(void) {
+  external_owned = other_owned; // expected-error-re {{ObjC3 carrier operation 'Optional copy' for type {{.*}} has no qualified lowering: {{.*}}}}
+}
+#elif defined(TEST_CARRIER_ARC)
+void arc_lifetime(void) {
+  MaybeObject value; // expected-error-re {{ObjC3 carrier operation 'local lifetime' for type {{.*}} has no qualified lowering: {{.*}}}}
+}
+#endif
