diff --git a/clang/test/ObjC3/CodeGen/match-native-control-flow.mm b/clang/test/ObjC3/CodeGen/match-native-control-flow.mm
new file mode 100644
index 000000000..ac7e604f2
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/match-native-control-flow.mm
@@ -0,0 +1,70 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -triple x86_64-pc-windows-msvc -emit-llvm -o - %s | FileCheck %s
+// MATCH-NATIVE-CODEGEN: ordered native scalar and carrier tests, borrowed payload bindings
+// Carrier locals are observed through counted pointer scrutinees; no C++
+// by-value carrier function ABI is required by this witness.
+
+typedef __objc3_optional(int) MaybeInt;
+typedef __objc3_result(int, long long) IntOrWide;
+
+extern "C" {
+int scrutinee_calls;
+int guard_calls;
+
+MaybeInt *next_some_zero(MaybeInt *source) {
+  ++scrutinee_calls;
+  return source;
+}
+
+IntOrWide *next_error(IntOrWide *source) {
+  ++scrutinee_calls;
+  return source;
+}
+
+bool reject_zero(int value) {
+  ++guard_calls;
+  return value != 0;
+}
+
+void match_optional_guard_fallback(void) {
+  MaybeInt source = __objc3_some(int, 0);
+  __objc3_match_stmt (*next_some_zero(&source)) {
+  case __objc3_case_some(let value) where reject_zero(value): {
+    scrutinee_calls += 100;
+  }
+  case __objc3_case_some(let value): {
+    if (value != 0) scrutinee_calls += 100;
+    scrutinee_calls += 1;
+  }
+  case __objc3_case_none: { scrutinee_calls += 100; }
+  }
+}
+
+void match_result_error_zero(void) {
+  IntOrWide source = __objc3_err(int, long long, 0LL);
+  __objc3_match_stmt (*next_error(&source)) {
+  case .Ok(let value): { scrutinee_calls += value + 100; }
+  case .Err(let error): { if (error != 0LL) scrutinee_calls += 100; }
+  }
+}
+
+int match_bool_once(void) {
+  ++scrutinee_calls;
+  return __objc3_match (scrutinee_calls & 1) {
+  case 0 => 0;
+  default => 7;
+  };
+}
+}
+
+// CHECK-LABEL: define{{.*}} @match_optional_guard_fallback
+// CHECK: call{{.*}} @next_some_zero
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: getelementptr{{( inbounds)?}} i8
+// CHECK: call{{.*}} @reject_zero
+// CHECK-LABEL: define{{.*}} @match_result_error_zero
+// CHECK: call{{.*}} @next_error
+// CHECK: load i8
+// CHECK: br i1
+// CHECK-LABEL: define{{.*}} @match_bool_once
+// CHECK: phi i32
