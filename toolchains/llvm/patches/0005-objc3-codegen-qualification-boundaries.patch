+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -emit-llvm -o - %s | FileCheck %s --implicit-check-not=llvm.memcpy
+
+struct Leaf {
+  explicit Leaf(int);
+  Leaf(const Leaf &);
+  Leaf(Leaf &&) noexcept;
+  ~Leaf() noexcept;
+};
+using Inner = __objc3_optional(Leaf);
+using Outer = __objc3_optional(Inner);
+using Field = __objc3_result(Outer, Inner);
+struct NativeOwner {
+  Field first;
+  Inner second;
+  NativeOwner(int value)
+      : first(__objc3_ok(Outer, Inner,
+                         __objc3_some(Inner, __objc3_some(Leaf, Leaf(value))))),
+        second(__objc3_some(Leaf, Leaf(value + 1))) {}
+  NativeOwner(const NativeOwner &) = default;
+  NativeOwner(NativeOwner &&) = default;
+  ~NativeOwner();
+};
+extern void destructor_body();
+NativeOwner::~NativeOwner() { destructor_body(); }
