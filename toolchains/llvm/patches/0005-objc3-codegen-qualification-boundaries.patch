+// directly for both targets. These checks additionally ensure each ABI emits
+// the expected set of function definitions.
+// MSVC-COUNT-3: define{{.*}} @"?optional@@{{.*}}
+// MSVC-COUNT-4: define{{.*}} @"?result@@{{.*}}
+// MSVC-COUNT-1: define{{.*}} @"?alias_same@@{{.*}}
diff --git a/clang/test/ObjC3/CodeGen/carrier-unsupported-lifetime-use.cpp b/clang/test/ObjC3/CodeGen/carrier-unsupported-lifetime-use.cpp
