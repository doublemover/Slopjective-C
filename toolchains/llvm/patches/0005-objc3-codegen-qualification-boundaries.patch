+    OwnedError Owner;
+    if (__objc3_try_force(mixed_arc_value(0, Owner.Object)) != 0 ||
+        __objc3_has_value(__objc3_try_optional(mixed_arc_value(1, Owner.Object))) ||
+        __objc3_has_value(__objc3_try_optional(mixed_mrc_forward_arc(1, Owner.Object))))
+      return 88;
+  }
