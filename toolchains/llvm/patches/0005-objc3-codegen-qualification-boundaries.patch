@@ -0,0 +1,53 @@
+//===--- CGObjC3MixedCarriers.h - Mixed ARC/C++ carrier locals -*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3MIXEDCARRIERS_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3MIXEDCARRIERS_H
+
+#include "Address.h"
+#include "clang/AST/Type.h"
+
+namespace llvm { class Value; }
+namespace clang {
+class Expr;
+class ObjC3OptionalExpr;
+class ObjC3ResultExpr;
+namespace CodeGen {
+class CodeGenFunction;
+class CodeGenModule;
+
+/// Automatic direct carrier trees with native ARC pointer leaves and ordinary
+/// C++ object leaves. This does not admit assignment, capture, enclosing record
+/// storage, or the by-value call ABI of a nontrivial C++ payload.
+bool supportsObjC3MixedCarrierLocalLifetime(CodeGenModule &, QualType);
+
+void emitObjC3MixedCarrierValueInit(CodeGenFunction &, const Expr *, Address);
+bool emitObjC3OptionalMixedLocalExpr(CodeGenFunction &,
+                                    const ObjC3OptionalExpr &, Address,
+                                    bool IsLocalInitialization,
+                                    bool DestinationIsIgnored,
+                                    bool DestinationIsVolatile);
+bool emitObjC3ResultMixedLocalExpr(CodeGenFunction &, const ObjC3ResultExpr &,
+                                  Address, bool IsLocalInitialization,
+                                  bool DestinationIsIgnored,
+                                  bool DestinationIsVolatile);
+llvm::Value *emitObjC3MixedCarrierTagQuery(CodeGenFunction &, QualType, Expr *,
+                                         bool IsResult, SourceLocation);
+
+/// Freeze the active leaf identity before source cleanup actions execute.
+/// Only discriminants on the active path are read; no inactive payload is
+/// evaluated. Each destruction partition captures the same stable selection.
+Address snapshotObjC3MixedCarrierCleanupSelection(CodeGenFunction &, QualType,
+                                                  Address Storage);
+
+/// Native C++ destructor actions and managed releases have distinct source
+/// ordering. Dispatch the selected original leaf using the captured selection,
+/// without re-reading tags after an intervening cleanup action. An omitted
+/// selection snapshots at cleanup entry, for completed-initializer rollback.
+void emitObjC3MixedCarrierDestroyPayload(
+    CodeGenFunction &, QualType, Address Storage, bool PreciseLifetime,
+    bool DestroyCXX, bool DestroyStrong, bool DestroyWeak,
+    Address Selection = Address::invalid());
+
+} // namespace CodeGen
+} // namespace clang
