--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-managed-optional-runtime.inc
@@ -0,0 +1,178 @@
+// Managed try? keeps a strong success payload beyond the call's ordinary
+// full-expression cleanup. Failed calls must never inspect inactive storage.
+static __weak ZeroCodeError *optional_observed;
+static int optional_calls;
+
+static TestError optional_owned(TestError error) __objc3_throws(TestError)
+    __attribute__((ns_returns_retained)) {
+  ++optional_calls;
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return value;
+  }
+}
+static TestError optional_borrowed() __objc3_throws(TestError) {
+  ++optional_calls;
+  @autoreleasepool {
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return value;
+  }
+}
+static ManagedSuccessBlock optional_owned_block(TestError error)
+    __objc3_throws(TestError) __attribute__((ns_returns_retained)) {
+  ++optional_calls;
+  @autoreleasepool {
+    if (error) __objc3_throw(error);
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return ^{ return [value code] + 42; };
+  }
+}
+static ManagedSuccessBlock optional_borrowed_block() __objc3_throws(TestError) {
+  @autoreleasepool {
+    TestError value = (TestError)make_zero_code_error();
+    optional_observed = value;
+    return ^{ return [value code] + 42; };
+  }
+}
+extern "C" void *objc_autoreleasePoolPush(void);
+extern "C" void objc_autoreleasePoolPop(void *);
+
+static void optional_native_unwind() {
+  __objc3_optional(TestError) value = __objc3_try_optional(optional_owned(nil));
+  if (!__objc3_has_value(value) || !optional_observed) __builtin_trap();
+  throw 311;
+}
+
+static int run_managed_optional_checks() {
+  int before = zero_code_error_deallocations();
+  int calls = optional_calls;
+  {
+    __objc3_optional(TestError) value = __objc3_try_optional(optional_owned(nil));
+    if (!__objc3_has_value(value) || !optional_observed) return 211;
+  }
+  if (optional_observed || zero_code_error_deallocations() != before + 1 ||
+      optional_calls != calls + 1) return 212;
+
+  // Pop the callee's return-value autorelease pool while the Optional remains
+  // live. Its own reference, rather than an ambient pool, must keep it alive.
+  before = zero_code_error_deallocations();
+  void *pool = objc_autoreleasePoolPush();
+  {
+    __objc3_optional(TestError) value = __objc3_try_optional(optional_borrowed());
