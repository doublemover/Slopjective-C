diff --git a/clang/lib/CodeGen/CGObjC3TypedErrors.cpp b/clang/lib/CodeGen/CGObjC3TypedErrors.cpp
new file mode 100644
index 000000000..5cafca22e
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3TypedErrors.cpp
@@ -0,0 +1,719 @@
+//===--- CGObjC3TypedErrors.cpp - ObjC3 error-output CodeGen -----*- C++
+//-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "CGObjC3TypedErrors.h"
+
+#include "CGCall.h"
+#include "CGObjC3Carriers.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3ErrorHandlers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "CodeGenTypes.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3Async.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/Stmt.h"
+#include "clang/AST/Type.h"
+#include "clang/CodeGen/CGFunctionInfo.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/Intrinsics.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace clang::CodeGen {
+struct ObjC3AsyncErrorHandler {
+  const Expr *Call;
+  Address Storage;
+  QualType Type;
+  llvm::BasicBlock *Failure;
+};
+} // namespace clang::CodeGen
+
+namespace {
+
+bool protocolAdoptsError(ObjCProtocolDecl *P,
+                         llvm::SmallPtrSetImpl<ObjCProtocolDecl *> &Seen) {
+  if (!P)
+    return false;
+  P = P->getCanonicalDecl();
+  // Match the semantic Error bridge from the payload's declarations. Source
+  // imports may deliberately remove these declarations from TU name lookup.
+  if (P->getName() == "Error")
+    return true;
+  if (!Seen.insert(P).second)
+    return false;
+  for (ObjCProtocolDecl *Inherited : P->protocols())
+    if (protocolAdoptsError(Inherited, Seen))
+      return true;
+  return false;
+}
+
+bool isErrorBoundObjectPointer(CodeGenModule &CGM, QualType T) {
+  const auto *Pointer = CGM.getContext().getCanonicalType(T).getTypePtr()
+                            ->getAs<ObjCObjectPointerType>();
+  if (!Pointer)
+    return false;
+
+  llvm::SmallPtrSet<ObjCProtocolDecl *, 8> Seen;
+  for (ObjCProtocolDecl *Protocol : Pointer->quals())
+    if (protocolAdoptsError(Protocol, Seen))
+      return true;
+  for (ObjCInterfaceDecl *Interface = Pointer->getInterfaceDecl(); Interface;
+       Interface = Interface->getSuperClass()) {
+    // Part 6.2.2 gives NSError standard Error conformance on Foundation
+    // platforms, including SDK declarations predating the protocol.
+    if (Interface->getIdentifier() &&
+        Interface->getIdentifier()->isStr("NSError"))
+      return true;
+    for (ObjCProtocolDecl *Protocol : Interface->all_referenced_protocols())
+      if (protocolAdoptsError(Protocol, Seen))
+        return true;
+    for (ObjCCategoryDecl *Category : Interface->visible_categories())
+      for (ObjCProtocolDecl *Protocol : Category->protocols())
+        if (protocolAdoptsError(Protocol, Seen))
+          return true;
+  }
+  return false;
+}
+
+const FunctionProtoType *getCallFunctionType(CodeGenFunction &CGF,
+                                             const CallExpr *Call) {
+  if (!Call)
+    return nullptr;
+  QualType Callee = Call->getCallee()->getType();
+  if (Call->getCallee()->hasPlaceholderType(BuiltinType::BoundMember))
+    Callee = Expr::findBoundMemberType(Call->getCallee());
+  if (Callee.isNull())
+    return nullptr;
+  Callee = CGF.getContext().getCanonicalType(Callee);
+  if (const auto *Direct = Callee->getAs<FunctionProtoType>())
+    return Direct;
+  if (const auto *Pointer = Callee->getAs<PointerType>())
+    Callee = CGF.getContext().getCanonicalType(Pointer->getPointeeType());
+  else if (const auto *Block = Callee->getAs<BlockPointerType>())
+    Callee = CGF.getContext().getCanonicalType(Block->getPointeeType());
+  return Callee->getAs<FunctionProtoType>();
+}
+
+bool isSupportedTryCall(CodeGenFunction &CGF, const ObjC3TryExpr &E,
+                         const Expr *&Call) {
+  Call = E.getOperand()->IgnoreParenImpCasts();
+  if (getObjC3CheckedAsyncAdapter(Call))
+    return true;
+  return supportsObjC3ErrorOutCall(CGF, Call);
+}
+
+RValue emitQualifiedCall(CodeGenFunction &CGF, const Expr *Call) {
+  if (const auto *Message = dyn_cast<ObjCMessageExpr>(Call))
+    return CGF.EmitObjCMessageExpr(Message);
+  if (getObjC3CheckedAsyncAdapter(Call))
+    return CGF.EmitAnyExpr(Call);
+  return CGF.EmitCallExpr(cast<CallExpr>(Call));
+}
+
+class ScopedObjC3ErrorOutCall {
+  CodeGenFunction &CGF;
+  Address PreviousStorage;
+  QualType PreviousType;
+  const Expr *PreviousCall;
+  std::unique_ptr<CodeGenFunction::OpaqueValueMapping> AsyncSlot;
+  ObjC3AsyncErrorHandler *PreviousAsync;
+  std::unique_ptr<ObjC3AsyncErrorHandler> Async;
+  std::unique_ptr<CodeGenFunction::ConditionalEvaluation> Conditional;
+
+public:
+  ScopedObjC3ErrorOutCall(CodeGenFunction &CGF, Address Storage,
+                          QualType ValueType, const Expr *Call,
+                          llvm::BasicBlock *Failure)
+      : CGF(CGF), PreviousStorage(CGF.ObjC3CallErrorOutStorage),
+        PreviousType(CGF.ObjC3CallErrorOutValueType),
+        PreviousCall(CGF.ObjC3CallErrorOutExpr),
+        PreviousAsync(CGF.ObjC3AsyncError) {
+    if (const auto *Adapter = getObjC3CheckedAsyncAdapter(Call)) {
+      auto *Slot = cast<OpaqueValueExpr>(Adapter->getArg(1)->IgnoreImpCasts());
+      AsyncSlot = std::make_unique<CodeGenFunction::OpaqueValueMapping>(
+          CGF, Slot, RValue::get(Storage.emitRawPointer(CGF)));
+      Async = std::make_unique<ObjC3AsyncErrorHandler>(ObjC3AsyncErrorHandler{
+          Adapter, Storage, ValueType, Failure});
+      CGF.ObjC3AsyncError = Async.get();
+      // Result temporaries only become live on the successful resume edge.
+      Conditional = std::make_unique<CodeGenFunction::ConditionalEvaluation>(CGF);
+      Conditional->begin(CGF);
+    }
+    CGF.ObjC3CallErrorOutStorage = Storage;
+    CGF.ObjC3CallErrorOutValueType = ValueType;
+    CGF.ObjC3CallErrorOutExpr = Call;
+  }
+  ~ScopedObjC3ErrorOutCall() {
+    if (Conditional)
+      Conditional->end(CGF);
+    CGF.ObjC3CallErrorOutStorage = PreviousStorage;
+    CGF.ObjC3CallErrorOutValueType = PreviousType;
+    CGF.ObjC3CallErrorOutExpr = PreviousCall;
+    CGF.ObjC3AsyncError = PreviousAsync;
+  }
+};
+
+} // namespace
+
+const Expr *CodeGen::emitObjC3CheckedAsyncResume(CodeGenFunction &CGF,
+                                                  const CoawaitExpr &E) {
+  const auto *Adapter = getObjC3CheckedAsyncAdapter(&E);
+  if (!Adapter)
+    return E.getResumeExpr();
+  auto *Handler = CGF.ObjC3AsyncError;
+  const auto *Resume = dyn_cast<BinaryOperator>(E.getResumeExpr());
+  if (!Handler || Handler->Call != Adapter || !Resume ||
+      Resume->getOpcode() != BO_Comma) {
+    CGF.CGM.ErrorUnsupported(&E, "checked async resume without error context");
+    return E.getResumeExpr();
+  }
+  CGF.EmitIgnoredExpr(Resume->getLHS());
+  llvm::Value *Error = CGF.EmitLoadOfScalar(
+      CGF.MakeAddrLValue(Handler->Storage, Handler->Type), E.getExprLoc());
+  auto *Failure = CGF.createBasicBlock("objc3.await.failure");
+  auto *Success = CGF.createBasicBlock("objc3.await.success");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Error), Failure, Success);
+  CGF.EmitBlock(Failure);
+  // The enclosing checked expression still owns its awaiter and argument
+  // temporaries. Optional failure rejoins that scope; propagating failure
+  // runs its ordinary transfer cleanups. Success-only result cleanups are
+  // guarded by the scoped ConditionalEvaluation.
+  CGF.Builder.CreateBr(Handler->Failure);
+  CGF.EmitBlock(Success);
+  return Resume->getRHS();
+}
+
+bool CodeGen::isObjC3AsyncThrowingFunction(const CodeGenFunction &CGF) {
+  if (!CGF.getLangOpts().ObjC3)
+    return false;
+  const auto *FPT = getObjC3CallableFunctionType(CGF.CurCodeDecl);
+  if (!FPT)
+    return false;
+  const auto Effects = FPT->getObjC3FunctionEffects();
+  return Effects.Async && Effects.Throws != ObjC3ThrowsKind::None;
+}
+
+bool CodeGen::supportsObjC3ErrorOutMethod(CodeGenModule &CGM,
+                                         const ObjCMethodDecl *Method) {
+  if (!Method || Method->getObjC3FunctionType().isNull() ||
+      Method->getMethodFamily() != OMF_None)
+    return false;
+  return supportsObjC3ErrorOutFunction(
+      CGM, Method->getObjC3FunctionType()->castAs<FunctionProtoType>(),
+      nullptr, false);
+}
+
+bool CodeGen::supportsObjC3ErrorOutCall(CodeGenFunction &CGF,
+                                        const Expr *Expression) {
+  if (const auto *Message = dyn_cast_or_null<ObjCMessageExpr>(Expression))
+    return supportsObjC3ErrorOutMethod(CGF.CGM, Message->getMethodDecl());
+  const auto *Call = dyn_cast_or_null<CallExpr>(Expression);
+  const auto *FPT = getCallFunctionType(CGF, Call);
+  if (!FPT)
+    return false;
+  const FunctionDecl *Callee = Call->getDirectCallee();
+  // An effect conversion can retain a known nonthrowing callee, including a
+  // static C++ member. Check the converted callable value type rather than
+  // accidentally applying the source declaration's nonthrowing prototype.
+  bool SamePrototype = Callee && CGF.getContext().hasSameType(
+      Callee->getType(), QualType(FPT, 0));
+  return supportsObjC3ErrorOutFunction(CGF.CGM, FPT, Callee, SamePrototype);
+}
+
+bool CodeGen::isObjC3ErrorObjectType(CodeGenModule &CGM, QualType Type) {
+  return isErrorBoundObjectPointer(CGM, Type);
+}
+
+QualType CodeGen::getObjC3OwnedErrorType(CodeGenFunction &CGF, QualType ErrorType) {
+  auto &Ctx = CGF.getContext();
+  return Ctx.getLifetimeQualifiedType(
+      Ctx.getUnqualifiedObjCPointerType(ErrorType), Qualifiers::OCL_Strong);
+}
+
+// Adopt a +1 error before any expression or lexical cleanup can run.
+void CodeGen::storeOwnedObjC3Error(CodeGenFunction &CGF, Address Storage,
+                                  llvm::Value *OwnedError, QualType ErrorType) {
+  LValue Slot = CGF.MakeAddrLValue(Storage, getObjC3OwnedErrorType(CGF, ErrorType));
+  llvm::Value *Previous = CGF.EmitLoadOfScalar(Slot, SourceLocation());
+  CGF.EmitStoreOfScalar(OwnedError, Slot);
+  CGF.EmitARCRelease(Previous, ARCPreciseLifetime);
+}
+
+llvm::Value *CodeGen::takeOwnedObjC3Error(CodeGenFunction &CGF, Address Storage,
+                                        QualType ErrorType) {
+  LValue Slot = CGF.MakeAddrLValue(Storage, getObjC3OwnedErrorType(CGF, ErrorType));
+  llvm::Value *Owned = CGF.EmitLoadOfScalar(Slot, SourceLocation());
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(ErrorType)), Slot);
+  return Owned;
+}
+
+bool CodeGen::getObjC3ErrorOutTypes(CodeGenModule &CGM, QualType &ValueType,
+                                    QualType &ParameterType) {
+  if (!CGM.getLangOpts().ObjC)
+    return false;
+  ASTContext &Ctx = CGM.getContext();
+  // The hidden transport erases protocol qualifiers; its semantic payload is
+  // checked separately. Building the physical ABI must not depend on whether
+  // a source-imported Error declaration participates in consumer name lookup.
+  QualType ObjectType = Ctx.getObjCObjectType(Ctx.ObjCBuiltinIdTy, {}, {}, false);
+  ValueType = Ctx.getLifetimeQualifiedType(Ctx.getObjCObjectPointerType(ObjectType),
+                                          Qualifiers::OCL_Autoreleasing);
+  ParameterType = Ctx.getPointerType(ValueType);
+  return true;
+}
+
+bool CodeGen::supportsObjC3ErrorOutFunction(CodeGenModule &CGM,
+                                            const FunctionProtoType *FPT,
+                                            const Decl *D,
+                                            bool RequireDirectFunction) {
+  if (!FPT)
+    return false;
+  ObjC3FunctionEffectInfo Effects = FPT->getObjC3FunctionEffects();
+  if (Effects.Async || Effects.Throws == ObjC3ThrowsKind::None ||
+      FPT->isVariadic() || FPT->getCallConv() != CC_C)
+    return false;
+  if (RequireDirectFunction) {
+    if (D && isa<ObjCMethodDecl>(D))
+      return false;
+    const auto *FD = dyn_cast_or_null<FunctionDecl>(D);
+    if (!FD && !isa_and_nonnull<BlockDecl>(D))
+      return false;
+    if (FD && isa<CXXConstructorDecl, CXXDestructorDecl>(FD))
+      return false;
+  }
+  if (!FPT->getReturnType()->isVoidType() &&
+      !CodeGenFunction::hasScalarEvaluationKind(FPT->getReturnType()) &&
+      !supportsObjC3CarrierARCCallABI(CGM, FPT->getReturnType()))
+    return false;
+
+  if (FPT->getReturnType()->isReferenceType())
+    return false;
+
+  QualType OutValueType, OutParameterType;
+  if (!getObjC3ErrorOutTypes(CGM, OutValueType, OutParameterType))
+    return false;
+  QualType ErrorType = Effects.ErrorType;
+  if (ErrorType.isNull() && Effects.Throws == ObjC3ThrowsKind::Untyped)
+    return true; // The untyped effect has the semantic id<Error> bridge.
+  return !ErrorType.isNull() && isErrorBoundObjectPointer(CGM, ErrorType);
+}
+
+void CodeGen::emitObjC3PendingErrorProlog(CodeGenFunction &CGF) {
+  QualType ValueType, ParameterType;
+  bool HasErrorType = getObjC3ErrorOutTypes(CGF.CGM, ValueType, ParameterType);
+  assert(HasErrorType && "supported error-out function needs Error protocol");
+  (void)HasErrorType;
+  // Register before parameter cleanups. A throwing parameter destructor must
+  // still unwind the pending reference, including on an ordinary return path.
+  QualType PendingType = getObjC3OwnedErrorType(CGF, ValueType);
+  CGF.ObjC3PendingErrorStorage =
+      CGF.CreateMemTemp(PendingType, "objc3.error.pending");
+  LValue Pending =
+      CGF.MakeAddrLValue(CGF.ObjC3PendingErrorStorage, PendingType);
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(PendingType)), Pending,
+      /*isInit=*/true);
+  // Internal error ownership remains exception-safe even when user ARC locals
+  // do not request unwind cleanup. Normal cleanup deliberately leaves this
+  // ownership for the return-block transfer below.
+  if (CGF.getLangOpts().Exceptions || isObjC3AsyncThrowingFunction(CGF))
+    CGF.pushDestroy(isObjC3AsyncThrowingFunction(CGF) ? NormalAndEHCleanup
+                                                     : EHCleanup,
+                    CGF.ObjC3PendingErrorStorage, PendingType,
+                    CodeGenFunction::destroyARCStrongPrecise, false);
+
+}
+
+void CodeGen::emitObjC3ErrorOutProlog(CodeGenFunction &CGF,
+                                      VarDecl *OutErrorDecl) {
+  if (!OutErrorDecl)
+    return;
+  QualType ValueType, ParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ValueType, ParameterType)) {
+    CGF.CGM.ErrorUnsupported(OutErrorDecl,
+                             "missing Error protocol for error-out ABI");
+    return;
+  }
+
+  Address ParameterAddress = CGF.GetAddrOfLocalVar(OutErrorDecl);
+  LValue ParameterLV = CGF.MakeAddrLValue(ParameterAddress, ParameterType);
+  llvm::Value *OutPointer =
+      CGF.EmitLoadOfScalar(ParameterLV, OutErrorDecl->getLocation());
+  CGF.ObjC3FunctionErrorOutPointer = OutPointer;
+
+  llvm::Value *HasOutPointer =
+      CGF.Builder.CreateIsNotNull(OutPointer, "objc3.error.out.present");
+  llvm::BasicBlock *Initialize =
+      CGF.createBasicBlock("objc3.error.out.initialize");
+  llvm::BasicBlock *Continue =
+      CGF.createBasicBlock("objc3.error.out.initialized");
+  CGF.Builder.CreateCondBr(HasOutPointer, Initialize, Continue);
+  CGF.EmitBlock(Initialize);
+  Address ErrorSlot(OutPointer, CGF.ConvertTypeForMem(ValueType),
+                    CGF.getContext().getTypeAlignInChars(ValueType));
+  LValue ErrorSlotLV = CGF.MakeAddrLValue(ErrorSlot, ValueType);
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(ValueType)), ErrorSlotLV,
+      /*isInit=*/true);
+  CGF.Builder.CreateBr(Continue);
+  CGF.EmitBlock(Continue);
+}
+
+void CodeGen::emitObjC3ErrorOutStore(CodeGenFunction &CGF,
+                                     llvm::Value *OutErrorPointer,
+                                     QualType ErrorValueType,
+                                     llvm::Value *ErrorValue,
+                                     SourceLocation Loc) {
+  if (!OutErrorPointer || ErrorValueType.isNull() || !ErrorValue)
+    return;
+
+  llvm::Value *IsNonNull =
+      CGF.Builder.CreateIsNotNull(OutErrorPointer, "objc3.error.out.present");
+  llvm::BasicBlock *Store = CGF.createBasicBlock("objc3.error.out.store");
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.error.out.done");
+  CGF.Builder.CreateCondBr(IsNonNull, Store, Done);
+  CGF.EmitBlock(Store);
+  Address Slot(OutErrorPointer, CGF.ConvertTypeForMem(ErrorValueType),
+               CGF.getContext().getTypeAlignInChars(ErrorValueType));
+  LValue LV = CGF.MakeAddrLValue(Slot, ErrorValueType);
+  CGF.EmitStoreOfScalar(ErrorValue, LV, /*isInit=*/false);
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+}
+
+void CodeGen::emitObjC3ErrorOutEpilog(CodeGenFunction &CGF) {
+  if (!CGF.ObjC3FunctionErrorOutDecl)
+    return;
+  QualType ErrorType, ParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorType, ParameterType))
+    return;
+  LValue Pending = CGF.MakeAddrLValue(CGF.ObjC3PendingErrorStorage,
+                                      getObjC3OwnedErrorType(CGF, ErrorType));
+  llvm::Value *Owned = CGF.EmitLoadOfScalar(Pending, SourceLocation());
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(ErrorType)), Pending);
+  llvm::BasicBlock *Failure = CGF.createBasicBlock("objc3.error.transfer");
+  llvm::BasicBlock *Publish = CGF.createBasicBlock("objc3.error.publish");
+  llvm::BasicBlock *Discard = CGF.createBasicBlock("objc3.error.discard");
+  llvm::BasicBlock *Done = CGF.createBasicBlock("objc3.error.return");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Owned), Failure, Done);
+  CGF.EmitBlock(Failure);
+  finalizeObjC3CarrierARCErrorReturn(CGF);
+  CGF.Builder.CreateCondBr(
+      CGF.Builder.CreateIsNotNull(CGF.ObjC3FunctionErrorOutPointer), Publish,
+      Discard);
+  CGF.EmitBlock(Publish);
+  // All callee cleanups, including its autorelease pools, are now complete.
+  // Transfer the +1 into the caller's pool only on the actual return path.
+  llvm::Value *Borrowed = CGF.EmitARCAutorelease(Owned);
+  emitObjC3ErrorOutStore(CGF, CGF.ObjC3FunctionErrorOutPointer, ErrorType,
+                         Borrowed, SourceLocation());
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Discard);
+  CGF.EmitARCRelease(Owned, ARCPreciseLifetime);
+  CGF.Builder.CreateBr(Done);
+  CGF.EmitBlock(Done);
+}
+
+bool CodeGen::emitObjC3ThrowStmt(CodeGenFunction &CGF,
+                                 const ObjC3ThrowStmt &S) {
+  const Expr *Payload = S.getPayload();
+  Address Storage = getObjC3ErrorDestinationStorage(CGF);
+  if (!Payload || !isErrorBoundObjectPointer(CGF.CGM, Payload->getType()) ||
+      !Storage.isValid() ||
+      (!CGF.ObjC3ActiveErrorHandler && !CGF.ObjC3FunctionErrorOutDecl &&
+       !isObjC3AsyncThrowingFunction(CGF))) {
+    CGF.CGM.ErrorUnsupported(&S, "typed Error-object throw lowering");
+    return false;
+  }
+
+  CodeGenFunction::RunCleanupsScope ExpressionCleanups(CGF);
+  const Expr *Operand = Payload;
+  if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Operand))
+    Operand = Cleanups->getSubExpr();
+  QualType ErrorType, ParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorType, ParameterType))
+    return false;
+  // ARC may consume a naturally +1 expression. MRC evaluates the operand
+  // normally and retains an independent transport reference; any +1 held by
+  // the source expression remains the MRC program's responsibility.
+  llvm::Value *Owned = CGF.getLangOpts().ObjCAutoRefCount
+                           ? CGF.EmitARCRetainScalarExpr(Operand)
+                           : CGF.EmitARCRetainNonBlock(CGF.EmitScalarExpr(Operand));
+  storeOwnedObjC3Error(CGF, Storage, Owned, ErrorType);
+  ExpressionCleanups.ForceCleanup();
+  LValue Pending = CGF.MakeAddrLValue(Storage,
+                                      getObjC3OwnedErrorType(CGF, ErrorType));
+  llvm::Value *Object = CGF.EmitLoadOfScalar(Pending, S.getBeginLoc());
+  llvm::Value *IsNonNull =
+      CGF.Builder.CreateIsNotNull(Object, "objc3.thrown.error.present");
+  llvm::BasicBlock *Store = CGF.createBasicBlock("objc3.throw.store");
+  llvm::BasicBlock *NilTrap = CGF.createBasicBlock("objc3.throw.nil.trap");
+  CGF.Builder.CreateCondBr(IsNonNull, Store, NilTrap);
+
+  CGF.EmitBlock(NilTrap);
+  CGF.EmitTrapCall(llvm::Intrinsic::trap);
+  CGF.Builder.CreateUnreachable();
+
+  CGF.EmitBlock(Store);
+
+  emitObjC3ErrorTransfer(CGF);
+  return true;
+}
+
+RValue CodeGen::emitObjC3TryScalarExpr(CodeGenFunction &CGF,
+                                       const ObjC3TryExpr &E) {
+  const Expr *Call = nullptr;
+  if (E.getKind() == ObjC3TryExpr::Kind::Optionalize ||
+      !isSupportedTryCall(CGF, E, Call)) {
+    CGF.CGM.ErrorUnsupported(&E, "unsupported typed throws call shape");
+    return CGF.GetUndefRValue(E.getType());
+  }
+
+  QualType ErrorValueType, ErrorParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorValueType, ErrorParameterType)) {
+    CGF.CGM.ErrorUnsupported(&E, "missing Error protocol for error-out ABI");
+    return CGF.GetUndefRValue(E.getType());
+  }
+
+  Address ErrorSlot = CGF.CreateMemTemp(ErrorValueType, "objc3.error.out");
+  LValue ErrorSlotLV = CGF.MakeAddrLValue(ErrorSlot, ErrorValueType);
+  llvm::Value *Nil =
+      llvm::Constant::getNullValue(CGF.ConvertType(ErrorValueType));
+  CGF.EmitStoreOfScalar(Nil, ErrorSlotLV, /*isInit=*/true);
+
+  llvm::BasicBlock *Failure = CGF.createBasicBlock("objc3.try.failure");
+  RValue CallValue;
+  {
+    ScopedObjC3ErrorOutCall ErrorOut(CGF, ErrorSlot, ErrorValueType, Call, Failure);
+    // Keep ARC's consume/reclaim casts around managed call results. The raw
+    // call is still the exact key for the hidden error output, but stripping
+    // these casts would leak +1 results or miss return-value ownership.
+    CallValue = E.getOperand()->getType()->isObjCRetainableType()
+                    ? RValue::get(CGF.EmitScalarExpr(E.getOperand()))
+                    : emitQualifiedCall(CGF, Call);
+  }
+
+  llvm::Value *Error = CGF.EmitLoadOfScalar(ErrorSlotLV, E.getExprLoc());
+  llvm::Value *Failed = CGF.Builder.CreateIsNotNull(Error, "objc3.try.failed");
+  llvm::BasicBlock *Success = CGF.createBasicBlock("objc3.try.success");
+  CGF.Builder.CreateCondBr(Failed, Failure, Success);
+
+  CGF.EmitBlock(Failure);
+  // The pre-result await edge bypasses the post-call load.
+  Error = CGF.EmitLoadOfScalar(ErrorSlotLV, E.getExprLoc());
+  switch (E.getKind()) {
+  case ObjC3TryExpr::Kind::Optionalize:
+    llvm_unreachable("aggregate try? is emitted by the aggregate visitor");
+  case ObjC3TryExpr::Kind::Force:
+    CGF.EmitTrapCall(llvm::Intrinsic::trap);
+    CGF.Builder.CreateUnreachable();
+    break;
+  case ObjC3TryExpr::Kind::Propagate: {
+    Address Storage = getObjC3ErrorDestinationStorage(CGF);
+    if (!Storage.isValid()) {
+      CGF.CGM.ErrorUnsupported(
+          &E, "typed error propagation without error-out context");
+      CGF.EmitTrapCall(llvm::Intrinsic::trap);
+      CGF.Builder.CreateUnreachable();
+      break;
+    }
+    storeOwnedObjC3Error(CGF, Storage, CGF.EmitARCRetainNonBlock(Error),
+                         ErrorValueType);
+    emitObjC3ErrorTransfer(CGF);
+    break;
+  }
+  }
+  CGF.EmitBlock(Success);
+
+  if (E.getType()->isVoidType())
+    return RValue();
+  return CallValue;
+}
+
+bool CodeGen::emitObjC3TryAggregateExpr(CodeGenFunction &CGF,
+                                        const ObjC3TryExpr &E,
+                                        AggValueSlot Dest) {
+  if (E.getKind() != ObjC3TryExpr::Kind::Optionalize) {
+    const Expr *Call = nullptr;
+    if ((!getObjC3CheckedAsyncAdapter(E.getOperand()) &&
+         !supportsObjC3CarrierARCCallABI(CGF.CGM, E.getType())) ||
+        !isSupportedTryCall(CGF, E, Call)) {
+      CGF.CGM.ErrorUnsupported(&E, "unsupported aggregate typed throws result");
+      return false;
+    }
+    QualType ErrorType, ParameterType;
+    if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorType, ParameterType))
+      return false;
+    Address ErrorSlot = CGF.CreateMemTemp(ErrorType, "objc3.error.out");
+    LValue ErrorLV = CGF.MakeAddrLValue(ErrorSlot, ErrorType);
+    CGF.EmitStoreOfScalar(
+        llvm::Constant::getNullValue(CGF.ConvertType(ErrorType)), ErrorLV,
+        /*isInit=*/true);
+    auto *Failure = CGF.createBasicBlock("objc3.try.failure");
+    {
+      ScopedObjC3ErrorOutCall ErrorOut(CGF, ErrorSlot, ErrorType, Call, Failure);
+      // Reuse ordinary fresh-sret lowering, including discarded-result and
+      // argument ownership. A typed failure initializes an empty carrier.
+      CGF.EmitAggExpr(E.getOperand(), Dest);
+    }
+    llvm::Value *Error = CGF.EmitLoadOfScalar(ErrorLV, E.getExprLoc());
+    auto *Success = CGF.createBasicBlock("objc3.try.success");
+    CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Error), Failure, Success);
+    CGF.EmitBlock(Failure);
+    Error = CGF.EmitLoadOfScalar(ErrorLV, E.getExprLoc());
+    if (E.getKind() == ObjC3TryExpr::Kind::Force) {
+      CGF.EmitTrapCall(llvm::Intrinsic::trap);
+      CGF.Builder.CreateUnreachable();
+    } else {
+      Address Storage = getObjC3ErrorDestinationStorage(CGF);
+      if (!Storage.isValid()) {
+        CGF.CGM.ErrorUnsupported(&E, "typed error propagation without error-out context");
+        CGF.EmitTrapCall(llvm::Intrinsic::trap);
+        CGF.Builder.CreateUnreachable();
+      } else {
+        storeOwnedObjC3Error(CGF, Storage, CGF.EmitARCRetainNonBlock(Error),
+                            ErrorType);
+        emitObjC3ErrorTransfer(CGF);
+      }
+    }
+    CGF.EmitBlock(Success);
+    return true;
+  }
+  const bool ARCLocal =
+      supportsObjC3CarrierARCLocalLifetime(CGF.CGM, E.getType());
+  const bool CppLocal = getObjC3CheckedAsyncAdapter(E.getOperand()) &&
+      supportsObjC3CarrierCppLocalLifetime(CGF.CGM, E.getType());
+  if (!supportsObjC3CarrierCopyPayload(CGF.CGM, E.getType()) &&
+      (!(ARCLocal || CppLocal) || (!Dest.isIgnored() &&
+                    (Dest.isVolatile() ||
+                     !CGF.isObjC3CarrierLocalInitialization(
+                         Dest.getAddress(), E.getType()))))) {
+    CGF.CGM.ErrorUnsupported(&E, "managed try? Optional initialization");
+    return false;
+  }
+  const Expr *Call = nullptr;
+  const bool AggregateOperand =
+      CodeGenFunction::getEvaluationKind(E.getOperand()->getType()) == TEK_Aggregate;
+  if (!isSupportedTryCall(CGF, E, Call) ||
+      (!E.getOperand()->getType()->isVoidType() &&
+       CodeGenFunction::getEvaluationKind(E.getOperand()->getType()) != TEK_Complex &&
+       !CodeGenFunction::hasScalarEvaluationKind(E.getOperand()->getType()) &&
+       !(AggregateOperand && (CppLocal || supportsObjC3CarrierARCCallABI(CGF.CGM, E.getOperand()->getType()))))) {
+    CGF.CGM.ErrorUnsupported(&E, "unsupported typed throws optional result");
+    return false;
+  }
+
+  QualType ErrorValueType, ErrorParameterType;
+  if (!getObjC3ErrorOutTypes(CGF.CGM, ErrorValueType, ErrorParameterType)) {
+    CGF.CGM.ErrorUnsupported(&E, "missing Error protocol for error-out ABI");
+    return false;
+  }
+  Address ErrorSlot = CGF.CreateMemTemp(ErrorValueType, "objc3.error.out");
+  LValue ErrorSlotLV = CGF.MakeAddrLValue(ErrorSlot, ErrorValueType);
+  CGF.EmitStoreOfScalar(
+      llvm::Constant::getNullValue(CGF.ConvertType(ErrorValueType)),
+      ErrorSlotLV, /*isInit=*/true);
+  llvm::BasicBlock *Failure = CGF.createBasicBlock("objc3.try.failure");
+  RValue CallValue;
+  {
+    ScopedObjC3ErrorOutCall ErrorOut(CGF, ErrorSlot, ErrorValueType, Call, Failure);
+    // Keep ARC's consume/reclaim casts around managed call results. The raw
+    // call is still the exact key for the hidden error output, but stripping
+    // these casts would leak +1 results or miss return-value ownership.
+    if (AggregateOperand) {
+      if (Dest.isIgnored())
+        CGF.EmitAggExpr(E.getOperand(), AggValueSlot::ignored());
+      else {
+        Address Payload = getObjC3CarrierPayloadAddress(
+            CGF, Dest.getAddress(), E.getType(), ObjC3CarrierPayloadArm::Value);
+        if (!Payload.isValid()) {
+          CGF.CGM.ErrorUnsupported(&E, "nested try? payload storage");
+          return false;
+        }
+        if (ARCLocal)
+          emitObjC3CarrierARCValueInit(CGF, E.getOperand(), Payload);
+        else
+          CGF.EmitAnyExprToMem(E.getOperand(), Payload, Qualifiers(),
+                               /*IsInit=*/true);
+      }
+    } else CallValue = E.getOperand()->getType()->isObjCRetainableType()
+                    ? RValue::get(CGF.EmitScalarExpr(E.getOperand()))
+                    : emitQualifiedCall(CGF, Call);
+  }
+
+  llvm::Value *Error = CGF.EmitLoadOfScalar(ErrorSlotLV, E.getExprLoc());
+  llvm::Value *Failed = CGF.Builder.CreateIsNotNull(Error, "objc3.try.failed");
+  llvm::BasicBlock *Success = CGF.createBasicBlock("objc3.try.success");
+  llvm::BasicBlock *Continue = CGF.createBasicBlock("objc3.try.continue");
+  CGF.Builder.CreateCondBr(Failed, Failure, Success);
+
+  ObjC3CarrierStorageLayout Layout;
+  auto Representation =
+      CGF.getContext().getObjC3CarrierRepresentationType(E.getType());
+  if (Representation.State !=
+          ObjC3CarrierRepresentationInfo::Status::Materialized ||
+      (!Dest.isIgnored() &&
+       !getObjC3CarrierStorageLayout(CGF.CGM, E.getType(), Layout))) {
+    CGF.CGM.ErrorUnsupported(&E, "unmaterialized try? Optional layout");
+    return false;
+  }
+
+  CGF.EmitBlock(Failure);
+  if (!Dest.isIgnored())
+    emitObjC3CarrierStoreTag(CGF, Dest.getAddress(), E.getType(),
+                             llvm::ConstantInt::getFalse(CGF.getLLVMContext()),
+                             /*IsInitialization=*/true, Dest.isVolatile());
+  CGF.Builder.CreateBr(Continue);
+
+  CGF.EmitBlock(Success);
+  if (!Dest.isIgnored()) {
+    if (!E.getOperand()->getType()->isVoidType() && !AggregateOperand) {
+      Address Payload = getObjC3CarrierPayloadAddress(
+          CGF, Dest.getAddress(), E.getType(), ObjC3CarrierPayloadArm::Value);
+      if (!Payload.isValid() || (!CallValue.isScalar() && !CallValue.isComplex())) {
+        CGF.CGM.ErrorUnsupported(&E, "unsupported try? Optional payload");
+        return false;
+      }
+      QualType PayloadType = Representation.ValueField->getType();
+      LValue PayloadLV = CGF.MakeAddrLValue(Payload, PayloadType);
+      if (CallValue.isComplex()) {
+        CGF.EmitStoreOfComplex(CallValue.getComplexVal(), PayloadLV, /*isInit=*/true);
+      } else {
+        llvm::Value *Value = CallValue.getScalarVal();
+        if (ARCLocal) {
+          // The operand keeps its ordinary ARC consume/reclaim cleanups. The
+          // engaged Optional needs an independent strong reference after those
+          // full-expression cleanups run. Acquire it only on the success edge.
+          if (PayloadType.getObjCLifetime() != Qualifiers::OCL_Strong) {
+            CGF.CGM.ErrorUnsupported(&E, "non-strong managed try? payload");
+            return false;
+          }
+          Value = PayloadType->isBlockPointerType()
+                      ? CGF.EmitARCRetainBlock(Value, /*mandatory=*/true)
+                      : CGF.EmitARCRetainNonBlock(Value);
+        }
+        CGF.EmitStoreOfScalar(Value, PayloadLV, /*isInit=*/true);
+      }
+    }
+    emitObjC3CarrierStoreTag(CGF, Dest.getAddress(), E.getType(),
+                             llvm::ConstantInt::getTrue(CGF.getLLVMContext()),
+                             /*IsInitialization=*/true, Dest.isVolatile());
+  }
+  CGF.Builder.CreateBr(Continue);
+  CGF.EmitBlock(Continue);
+  return true;
+}
