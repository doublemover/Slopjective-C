+  return __objc3_try(callback(input));
+}
+// CHECK-LABEL: define{{.*}} void {{.*}}invoke{{.*}}sret(
+// CHECK: llvm.objc.copyWeak
+// CHECK: {{call|invoke}} void %{{.*}}sret(
+// CHECK: objc3.try.failure
+// CHECK: llvm.objc.destroyWeak
+__attribute__((objc_root_class))
