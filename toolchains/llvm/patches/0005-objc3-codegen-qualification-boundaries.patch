diff --git a/clang/lib/CodeGen/CGObjC3Defer.h b/clang/lib/CodeGen/CGObjC3Defer.h
new file mode 100644
index 000000000..9475e6d2f
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Defer.h
@@ -0,0 +1,93 @@
+//===--- CGObjC3Defer.h - Native source-scope release ordering ------*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3DEFER_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3DEFER_H
+#include "CodeGenFunction.h"
+#include "clang/AST/ObjC3SourceScopes.h"
+#include "llvm/ADT/SmallSet.h"
+#include <functional>
+namespace clang::CodeGen {
+/// Identify destruction that only releases implicit managed subobjects. User
+/// C++ destructors are source actions and retain their native stack position.
+/// Constructors and access control do not affect implicit destruction. This
+/// includes nonaggregate classes and lambda capture storage, as well as C
+/// records whose managed fields use primitive destruction.
+inline bool hasOnlyObjC3ImplicitManagedDestruction(ASTContext &Context,
+                                                 QualType Type) {
+  llvm::SmallVector<QualType, 8> Pending{Type};
+  llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+  // Shared field types form a DAG. Inspect each type once, without recursive
+  // stack growth or exponential work for repeated aggregate subobjects.
+  while (!Pending.empty()) {
+    QualType Current = Context.getBaseElementType(Pending.pop_back_val());
+    if (!Seen.insert(Current.getCanonicalType().getTypePtr()).second)
+      continue;
+    if (Current->isObjCRetainableType())
+      continue;
+    if (const auto *Optional = Current->getAs<ObjC3OptionalType>()) {
+      Pending.push_back(Optional->getElementType());
+      continue;
+    }
+    if (const auto *Result = Current->getAs<ObjC3ResultType>()) {
+      Pending.push_back(Result->getSuccessType());
+      Pending.push_back(Result->getErrorType());
+      continue;
+    }
+    if (const auto *Record = Current->getAs<RecordType>()) {
+      const RecordDecl *Declaration = Record->getDecl()->getDefinition();
+      if (!Declaration)
+        return false;
+      if (const auto *CXXRecord = dyn_cast<CXXRecordDecl>(Declaration))
+        if (CXXRecord->getNumBases() ||
+            CXXRecord->hasUserDeclaredDestructor())
+          return false;
+      for (const FieldDecl *Field : Declaration->fields())
+        Pending.push_back(Field->getType());
+      continue;
+    }
+    if (Current.isDestructedType() != QualType::DK_none)
+      return false;
+  }
+  return true;
+}
+
+struct ObjC3ReleaseScope;
+using ObjC3ReleaseEmitter = std::function<void(CodeGenFunction &, Address,
+                                               EHScopeStack::Cleanup::Flags)>;
+struct ObjC3PendingRelease {
+  ObjC3ReleaseScope *Scope;
+  Address Pointer = Address::invalid(), Pending = Address::invalid(),
+          Destination = Address::invalid();
+  llvm::Type *ElementType;
+  CharUnits Alignment;
+  bool ReleaseOnEH;
+  ObjC3ReleaseEmitter Emit;
+};
+struct ObjC3ReleaseScope {
+  const Stmt *Owner;
+  EHScopeStack::stable_iterator Depth;
+  bool Active = true;
+  llvm::SmallVector<std::unique_ptr<ObjC3PendingRelease>, 4> Releases;
+};
+struct ObjC3PartialReleaseEdge {
+  llvm::BasicBlock *Entry;
+  unsigned Index;
+  llvm::SmallVector<ObjC3ReleaseScope *, 4> Scopes;
+};
+struct ObjC3DeferState {
+  ObjC3SourceScopes Sources;
+  llvm::SmallVector<std::unique_ptr<ObjC3ReleaseScope>, 4> Scopes;
+  llvm::SmallVector<ObjC3PartialReleaseEdge, 4> Edges;
+  explicit ObjC3DeferState(const Stmt *Body) : Sources(Body) {}
+};
+struct EmitObjC3OrderedRelease final : EHScopeStack::Cleanup {
+  ObjC3PendingRelease *Release;
+  explicit EmitObjC3OrderedRelease(ObjC3PendingRelease *Release)
+      : Release(Release) {}
+  void Emit(CodeGenFunction &CGF, Flags F) override {
+    CGF.emitObjC3OrderedRelease(*Release, F);
+  }
+};
+} // namespace clang::CodeGen
+#endif
