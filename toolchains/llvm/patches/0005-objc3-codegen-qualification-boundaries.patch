--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-native-runtime-support.m
@@ -0,0 +1,174 @@
+// Compile this companion in MRC mode with pinned libobjc2. It supplies a real
+// Error object whose application code is zero and explicit lifetime counters.
+#include <objc/objc.h>
+#include <objc/runtime.h>
+#include <objc/objc-arc.h>
+#include <objc/hooks.h>
+#include "typed-error-runtime-interface.h"
+
+static int Deallocations;
+
+@implementation ZeroCodeError
+- (id)retain {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  ++*Count;
+  return self;
+}
+- (oneway void)release {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  if (--*Count == 0)
+    [self dealloc];
+}
+- (void)dealloc {
+  ++Deallocations;
+  objc_delete_weak_refs(self);
+  object_dispose(self);
+}
+- (id)autorelease {
+  // Before the first explicit pool, libobjc2 delegates autorelease of this
+  // custom MRC root back to this method. Bootstrap its Foundation-free native
+  // pool support with a balanced empty pool, then enqueue the reference.
+  void *Token = objc_autoreleasePoolPush();
+  objc_autoreleasePoolPop(Token);
+  return objc_autorelease(self);
+}
+- (int)code { return Code; }
+@end
+
+@implementation FirstError @end
+@implementation SecondError @end
+@implementation MarkedError @end
+
+// Custom MRC roots own weak teardown and provide libobjc2's live-object hook.
+// This fixture is single-threaded and uses the same indexed count for subclasses.
+static id LoadLiveError(id Object) {
+  return *(unsigned long *)object_getIndexedIvars(Object) ? Object : nil;
+}
+id make_error_kind(int Kind) {
+  _objc_weak_load = LoadLiveError;
+  const char *Name = Kind == 1 ? "FirstError" : Kind == 2 ? "SecondError" :
+                     Kind == 3 ? "MarkedError" : "ZeroCodeError";
+  ZeroCodeError *Value = (ZeroCodeError *)class_createInstance(
+      objc_getClass(Name), sizeof(unsigned long));
+  *(unsigned long *)object_getIndexedIvars(Value) = 1;
+  Value->Code = 0;
+  return Value;
+}
+id make_zero_code_error(void) { return make_error_kind(0); }
+int zero_code_error_deallocations(void) { return Deallocations; }
+int is_nonnull_zero_code_error(id Value) {
+  return Value != nil && [(ZeroCodeError *)Value code] == 0;
+}
+
+// Ordinary Objective-C 2 code sees the physical C ABI, without effect syntax.
+extern int typed_runtime_zero(int argument, id *out_error);
+extern void typed_runtime_void(id *out_error);
+int verify_error_out_abi(void) {
+  id Error = (id)1;
+  if (typed_runtime_zero(0, &Error) != 0 || Error != nil)
+    return 1;
+  typed_runtime_void(&Error);
+  if (Error != nil)
+    return 2;
+  if (typed_runtime_zero(1, &Error) != 0 ||
+      !is_nonnull_zero_code_error(Error))
+    return 3;
+  // A nullable error output must not suppress the call or crash the store.
+  if (typed_runtime_zero(1, 0) != 0)
+    return 4;
+  return 0;
+}
+
+extern int typed_runtime_owned_pool(int argument, id *out_error);
+int verify_owned_error_out_abi(void) {
+  int Before = Deallocations;
+  id Error = (id)1;
+  if (typed_runtime_owned_pool(0, &Error) != 0 || Error != nil)
+    return 1;
+  if (typed_runtime_owned_pool(1, &Error) != 0 ||
+      !is_nonnull_zero_code_error(Error) || Deallocations != Before)
+    return 2;
+  if (typed_runtime_owned_pool(1, 0) != 0 || Deallocations != Before + 1)
+    return 3;
+  return 0;
+}
+int verify_owned_null_error_out(void) {
+  int Before = Deallocations;
+  return typed_runtime_owned_pool(1, 0) == 0 && Deallocations == Before + 1;
+}
+
+
+int zero_code_error_retain_count(id Value) {
+  return Value ? (int)*(unsigned long *)object_getIndexedIvars(Value) : 0;
+}
+// This Objective-C 2 MRC unit uses only the physical C signature. Neither the
+// effect syntax nor ARC is required to exchange the autoreleasing error slot.
+extern int mixed_mrc_value(int fail, ZeroCodeError *error, id *out_error);
+extern int mixed_mrc_owned_pool(int fail, id *out_error);
+int verify_mrc_physical_error_abi(void) {
+  int Before = Deallocations;
+  // No ambient caller pool: discarded errors must release after the callee's
+  // own source ownership and pool cleanup, with no autorelease left behind.
+  if (mixed_mrc_owned_pool(1, 0) != 0 || Deallocations != Before + 1) return 0;
+  Before = Deallocations;
+  ZeroCodeError *Owner = (ZeroCodeError *)make_zero_code_error();
+  if (mixed_mrc_value(1, Owner, 0) != 0 ||
+      zero_code_error_retain_count(Owner) != 1) return 0;
+  [Owner release];
+  if (Deallocations != Before + 1) return 0;
+  @autoreleasepool {
+    Owner = (ZeroCodeError *)make_zero_code_error();
+    id Error = (id)1;
+    if (mixed_mrc_value(0, Owner, &Error) != 0 || Error != nil) return 0;
+    if (mixed_mrc_value(1, Owner, &Error) != 0 || Error != Owner ||
+        zero_code_error_retain_count(Owner) != 2) return 0;
+    [Owner release];
+    if (!is_nonnull_zero_code_error(Error) || Deallocations != Before + 1)
+      return 0;
+  }
+  return Deallocations == Before + 2;
+}
+
+// An ordinary Objective-C 2 client sees the real context-prefix/error-suffix
+// invoke ABI and uses the same platform Block object without a wrapper layout.
+id make_named_zero_code_error(const char *name) {
+  ZeroCodeError *Value = (ZeroCodeError *)class_createInstance(objc_getClass(name), sizeof(unsigned long));
+  *(unsigned long *)object_getIndexedIvars(Value) = 1;
+  return Value;
+}
+int verify_physical_error_message(void *receiver, id expected) {
+  id Receiver = (id)receiver;
+  SEL Selector = sel_registerName("value:error:");
+  Method Method = class_getInstanceMethod(object_getClass(Receiver), Selector);
+  if (!Method || method_getNumberOfArguments(Method) != 5) return 0;
+  typedef int (*PhysicalIMP)(id, SEL, int, id, id *);
+  PhysicalIMP Physical = (PhysicalIMP)method_getImplementation(Method);
+  id Error = (id)1;
+  if (Physical(Receiver, Selector, 0, expected, &Error) != 0 || Error != nil) return 0;
+  @autoreleasepool {
+    if (Physical(Receiver, Selector, 1, expected, &Error) != 0 || Error != expected) return 0;
+    int Before = zero_code_error_retain_count(expected);
+    // Forwarding through super publishes an intermediate borrowed error into
+    // this caller's pool. Discarding the outer transport must not leak either
+    // its owned reference or that temporary publication.
+    @autoreleasepool {
+      if (Physical(Receiver, Selector, 1, expected, 0) != 0) return 0;
+    }
+    if (zero_code_error_retain_count(expected) != Before) return 0;
+  }
+  return 1;
+}
+
+int verify_physical_error_block(void *block, id expected, int success_value) {
+  typedef int (^PhysicalBlock)(int, id *);
+  PhysicalBlock Physical = (PhysicalBlock)block;
+  id Error = (id)1;
+  if (Physical(0, &Error) != success_value || Error != nil) return 0;
+  @autoreleasepool {
+    if (Physical(1, &Error) != 0 || Error != expected) return 0;
+    int Before = zero_code_error_retain_count(expected);
+    if (Physical(1, 0) != 0 || zero_code_error_retain_count(expected) != Before)
+      return 0;
+  }
+  return 1;
+}
diff --git a/clang/test/ObjC3/CodeGen/Inputs/typed-error-out-runtime.mm b/clang/test/ObjC3/CodeGen/Inputs/typed-error-out-runtime.mm
new file mode 100644
index 000000000..b2998dbb4
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/typed-error-out-runtime.mm
@@ -0,0 +1,276 @@
+// Runtime witness for the direct C.4.1 error-out slice. Compile with ARC,
+// C++ exceptions, pinned libobjc2 and the admitted Windows MSVC/UCRT profile.
+#include "typed-error-runtime-interface.h"
+#include <objc/objc-arc.h>
+typedef ZeroCodeError *TestError;
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(void) OptionalVoid;
+
+static int SawNonNullZeroCodeError;
+static int ArgumentEvaluations;
+static int CleanupEvents;
+
+extern "C" int typed_runtime_zero(int argument) __objc3_throws(TestError) {
+  if (argument != 0) {
+    id Error = make_zero_code_error();
+    SawNonNullZeroCodeError = is_nonnull_zero_code_error(Error);
+    __objc3_throw((TestError)Error);
+  }
+  return 0;
+}
+
+static void throw_dynamic(TestError error) __objc3_throws(TestError) {
+  __objc3_throw(error);
+}
+
+extern "C" void typed_runtime_void(void) __objc3_throws(TestError) { ++CleanupEvents; }
+
+struct Tracker {
+  ~Tracker() { ++CleanupEvents; }
+};
+
+static int propagates(int argument) __objc3_throws(TestError) {
+  Tracker Object;
+  return __objc3_try(typed_runtime_zero(argument));
+}
+
+static int next_argument() {
+  ++ArgumentEvaluations;
+  return 1;
+}
+
+static int force_zero_success() {
+  return __objc3_try_force(typed_runtime_zero(__objc3_try_force(typed_runtime_zero(0))));
+}
+
+static void force_void_success() {
+  __objc3_try_force(typed_runtime_void());
+}
+
+static void zero_void(void) __objc3_throws(TestError) {}
+
+static int native_cpp_exception(void) __objc3_throws(TestError) {
+  Tracker Object;
+  return []() -> int { throw 17; }();
+}
+
+static int OwnedCleanupEvents;
+
+struct OwnedTracker {
+  ~OwnedTracker() { ++OwnedCleanupEvents; }
+};
+
+extern "C" int typed_runtime_owned_pool(int argument) __objc3_throws(TestError) {
+  @autoreleasepool {
+    OwnedTracker Object;
+    if (argument)
+      __objc3_throw((TestError)make_zero_code_error());
+    return 0;
+  }
+}
+
+static int propagates_owned_pool(int argument) __objc3_throws(TestError) {
+  @autoreleasepool {
+    OwnedTracker Object;
+    return __objc3_try(typed_runtime_owned_pool(argument));
+  }
+}
+
+struct TemporaryPool {
+  void *Token = objc_autoreleasePoolPush();
+  ~TemporaryPool() { objc_autoreleasePoolPop(Token); }
+  TestError error() { return (TestError)make_zero_code_error(); }
+};
+
+static int expression_pool_cleanup(void) __objc3_throws(TestError) {
+  __objc3_throw(TemporaryPool().error());
+}
+
+struct ThrowingExpression {
+  TestError Object = (TestError)make_zero_code_error();
+  ~ThrowingExpression() noexcept(false) { throw 41; }
+  operator TestError() { return Object; }
+};
+
+static int expression_cleanup_interrupts(void) __objc3_throws(TestError) {
+  __objc3_throw((TestError)ThrowingExpression());
+}
+
+struct ThrowingLocalCleanup {
+  ~ThrowingLocalCleanup() noexcept(false) { throw 37; }
+};
+
+static int function_cleanup_interrupts(void) __objc3_throws(TestError) {
+  @autoreleasepool {
+    ThrowingLocalCleanup Cleanup;
+    TestError Error = (TestError)make_zero_code_error();
+    __objc3_throw(Error);
+  }
+}
+
+static int run_owned_cleanup_checks() {
+  int Before = zero_code_error_deallocations();
+  // A callee with its own pool must discard a nullable output immediately,
+  // without requiring an ambient caller pool or leaving an owned error behind.
+  if (!verify_owned_null_error_out())
+    return 20;
+  if (zero_code_error_deallocations() != Before + 1)
+    return 21;
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (__objc3_try_force(propagates_owned_pool(0)) != 0)
+      return 22;
+    OptionalInt Failed = __objc3_try_optional(propagates_owned_pool(1));
+    if (__objc3_has_value(Failed) || zero_code_error_deallocations() != Before)
+      return 23;
+  }
+  if (zero_code_error_deallocations() != Before + 1 || OwnedCleanupEvents != 5)
+    return 24;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    OptionalInt Failed = __objc3_try_optional(expression_pool_cleanup());
+    if (__objc3_has_value(Failed) || zero_code_error_deallocations() != Before)
+      return 25;
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 26;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    try {
+      __objc3_try_force(expression_cleanup_interrupts());
+      return 27;
+    } catch (int Value) {
+      if (Value != 41 || zero_code_error_deallocations() != Before + 1)
+        return 28;
+    }
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 29;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    try {
+      __objc3_try_force(function_cleanup_interrupts());
+      return 30;
+    } catch (int Value) {
+      if (Value != 37 || zero_code_error_deallocations() != Before + 1)
+        return 31;
+    }
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 32;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (verify_owned_error_out_abi() != 0 ||
+        zero_code_error_deallocations() != Before + 1)
+      return 33;
+  }
+  return zero_code_error_deallocations() == Before + 2 ? 0 : 34;
+}
+
+#include "typed-error-do-catch-runtime.inc"
+#include "typed-error-mixed-arc-runtime.inc"
+#include "typed-error-callback-arc-runtime.inc"
+
+#include "typed-error-block-arc-runtime.inc"
+#include "typed-error-member-arc-runtime.inc"
+#include "typed-error-message-arc-runtime.inc"
+
+#include "typed-error-managed-arc-runtime.inc"
+
+#include "typed-error-noreturn-runtime.inc"
+
+int main(int argc, char **argv) {
+  if (argc == 2) {
+    const char *Case = argv[1];
+    if (__builtin_strcmp(Case, "dynamic-nil") == 0) {
+      auto Callback = throw_dynamic;
+      __objc3_try_force(Callback((TestError)nil));
+    } else if (__builtin_strcmp(Case, "force-error") == 0) {
+      @autoreleasepool { __objc3_try_force(typed_runtime_zero(1)); }
+    } else if (__builtin_strcmp(Case, "mrc-dynamic-nil") == 0) mixed_mrc_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-force-error") == 0) mixed_mrc_trap(2);
+    else if (__builtin_strcmp(Case, "block-dynamic-nil") == 0) block_trap(1);
+    else if (__builtin_strcmp(Case, "block-force-error") == 0) block_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-block-dynamic-nil") == 0) mrc_block_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-block-force-error") == 0) mrc_block_trap(2);
+    else if (__builtin_strcmp(Case, "member-dynamic-nil") == 0) member_trap(1);
+    else if (__builtin_strcmp(Case, "member-force-error") == 0) member_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-member-dynamic-nil") == 0) mrc_member_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-member-force-error") == 0) mrc_member_trap(2);
+    else if (__builtin_strcmp(Case, "message-dynamic-nil") == 0) message_trap(1);
+    else if (__builtin_strcmp(Case, "message-force-error") == 0) message_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-message-dynamic-nil") == 0) mrc_message_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-message-force-error") == 0) mrc_message_trap(2);
+    return 250;
+  }
+  if (argc != 1) return 250;
+  if (force_zero_success() != 0)
+    return 1;
+  force_void_success();
+  if (CleanupEvents != 1)
+    return 2;
+
+  @autoreleasepool {
+    OptionalInt Failed = __objc3_try_optional(propagates(next_argument()));
+    if (__objc3_has_value(Failed) || ArgumentEvaluations != 1 ||
+        CleanupEvents != 2)
+      return 3;
+    // The thrown local has been cleaned up; the error still owns a pool
+    // lifetime through the native autoreleasing output slot.
+    if (zero_code_error_deallocations() != 0)
+      return 6;
+  }
+  if (zero_code_error_deallocations() != 1)
+    return 4;
+  @autoreleasepool {
+    if (verify_error_out_abi() != 0)
+      return 7;
+    if (zero_code_error_deallocations() != 2)
+      return 8;
+  }
+  if (zero_code_error_deallocations() != 3)
+    return 11;
+  OptionalVoid VoidSuccess = __objc3_try_optional(zero_void());
+  if (!__objc3_has_value(VoidSuccess))
+    return 14;
+  @autoreleasepool {
+    TestError Error = (TestError)make_zero_code_error();
+    OptionalVoid VoidFailure = __objc3_try_optional(throw_dynamic(Error));
+    if (__objc3_has_value(VoidFailure))
+      return 15;
+  }
+  if (zero_code_error_deallocations() != 4)
+    return 16;
+  try {
+    __objc3_try_force(native_cpp_exception());
+    return 12;
+  } catch (int value) {
+    if (value != 17 || CleanupEvents != 4)
+      return 13;
+  }
+  int OwnedResult = run_owned_cleanup_checks();
+  if (OwnedResult) return OwnedResult;
+  int HandlerResult = run_handler_checks();
+  if (HandlerResult) return HandlerResult;
+  int MRCResult = run_mrc_error_checks();
+  if (MRCResult) return MRCResult;
+  int MixedARCResult = run_mixed_arc_checks();
+  if (MixedARCResult) return MixedARCResult;
+  int CallbackResult = run_callback_checks();
+  if (CallbackResult) return CallbackResult;
+  int BlockResult = run_block_checks();
+  if (BlockResult) return BlockResult;
+  int MemberResult = run_member_checks();
+  if (MemberResult) return MemberResult;
+  int MessageResult = run_message_checks();
+  if (MessageResult) return MessageResult;
+  int ManagedResult = run_managed_success_checks();
+  if (ManagedResult) return ManagedResult;
+  int NoreturnResult = run_noreturn_checks();
+  if (NoreturnResult) return NoreturnResult;
+  return SawNonNullZeroCodeError == 1 ? 0 : 5;
+}
