new file mode 100644
index 000000000..3b090193d
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/carrier-native-layout.c
@@ -0,0 +1,30 @@
+// RUN: %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -emit-obj -o %t.x86.o %s
+// RUN: llvm-nm --defined-only %t.x86.o | FileCheck %s --check-prefix=OBJ
+//
+// Real local storage escapes through an ordinary void pointer. These checks
+// cover target layout only, not by-value calls or active-arm operations.
+
+typedef __objc3_optional(long long) OptionalI64;
+typedef __objc3_optional(_Bool) OptionalBool;
+typedef __objc3_optional(void) OptionalVoid;
+typedef __objc3_result(long long, void) ResultI64Void;
+struct Pair { long long wide; int narrow; };
+typedef __objc3_optional(struct Pair) OptionalPair;
+typedef __objc3_optional(OptionalI64) NestedOptional;
+extern void consume_storage(void *);
+
+void materialize_i64(void) { OptionalI64 local; consume_storage(&local); }
+void materialize_bool(void) { OptionalBool local; consume_storage(&local); }
+void materialize_void(void) { OptionalVoid local; consume_storage(&local); }
+void materialize_result(void) { ResultI64Void local; consume_storage(&local); }
+void materialize_pair(void) { OptionalPair local; consume_storage(&local); }
+void materialize_nested(void) { NestedOptional local; consume_storage(&local); }
+
+// CHECK: type { i8,
+// CHECK: i64
+// CHECK: define{{.*}} @materialize_i64
+// CHECK: @materialize_void
+// CHECK: define{{.*}} @materialize_pair
+// OBJ-DAG: materialize_i64
+// OBJ-DAG: materialize_pair
