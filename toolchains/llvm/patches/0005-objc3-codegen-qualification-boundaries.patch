+//
+// A typed indirect function signature is representable, but its by-value ABI
+// is unavailable on this target. The guard must reject it before target ABIInfo sees it.
+
+typedef __objc3_optional(long long) OptionalI64;
+typedef OptionalI64 (*CarrierFunction)(OptionalI64);
+void call_indirect(CarrierFunction function) {
+  OptionalI64 local;
+  function(local);
+}
