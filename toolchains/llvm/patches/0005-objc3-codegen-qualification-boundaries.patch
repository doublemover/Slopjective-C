+//===--- CGObjC3Match.h - Native ObjC3 match lowering --------*- C++ -*-===//
+// Private CodeGen adapter. This does not define an ABI for ObjC objects.
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3MATCH_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3MATCH_H
+
+#include "CGValue.h"
+
+namespace clang {
+class ObjC3MatchExpr;
+class ObjC3MatchStmt;
+namespace CodeGen {
+class CodeGenFunction;
+class AggValueSlot;
+RValue emitObjC3MatchComplexExpr(CodeGenFunction &, const ObjC3MatchExpr *);
+void emitObjC3MatchAggregateExpr(CodeGenFunction &, const ObjC3MatchExpr *,
+                                 AggValueSlot);
+}
