+//
+// Debug types use the same AST-owned materialized record as carrier storage.
+// These checks cover native storage/debug identity, not lifetime or call ABI.
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(const int) OptionalConstInt;
+typedef __objc3_result(int, long) IntLongResult;
+typedef __objc3_optional(OptionalInt) NestedOptional;
+extern void consume_storage(void *);
+
+void debug_carriers(OptionalInt *optional_pointer,
+                    IntLongResult *result_pointer) {
+  OptionalInt optional_local;
+  OptionalConstInt qualified_local;
+  IntLongResult result_local;
+  NestedOptional nested_local;
+  consume_storage(&optional_local);
+  consume_storage(&qualified_local);
+  consume_storage(&result_local);
+  consume_storage(&nested_local);
+  consume_storage(optional_pointer);
+  consume_storage(result_pointer);
+}
