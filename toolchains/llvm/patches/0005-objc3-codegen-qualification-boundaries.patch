+// RUN: test ! -e %t.scalar.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -std=c++20 -DTEST_AGGREGATE -emit-llvm -o %t.aggregate.ll -verify %s
