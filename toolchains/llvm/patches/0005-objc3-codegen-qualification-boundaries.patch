+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -fexceptions -fcxx-exceptions -std=c++20 -include-pch %t.pch -emit-llvm -o - /dev/null | FileCheck %s
+
+using Strong = __objc3_optional(id);
+using Weak = __objc3_optional(id __weak);
+using Unsafe = __objc3_optional(id __unsafe_unretained);
+using Outcome = __objc3_result(id, id __weak);
+using Action = void (^)(void);
+using OptionalAction = __objc3_optional(Action);
+
+bool copy_strong(const Strong &source) {
+  Strong copy = __objc3_copy(source);
+  return __objc3_has_value(copy);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_strong
+// CHECK: load i8
+// CHECK: br i1
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: store i8 1
+// CHECK: load i8
+// CHECK: call void @llvm.objc.storeStrong
+
+bool move_strong(Strong &source) {
+  Strong moved = __objc3_move(source);
+  return __objc3_has_value(moved);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}move_strong
+// CHECK: objc3.transfer.active:
+// CHECK: [[MOVED:%.*]] = load ptr, ptr [[SOURCE:%.*]], align
+// CHECK-NEXT: store ptr null, ptr [[SOURCE]]
+// CHECK-NEXT: store ptr [[MOVED]]
+// CHECK: store i8 1
+// CHECK: call void @llvm.objc.storeStrong
+
+bool copy_weak(const Weak &source) {
+  Weak copy = __objc3_copy(source);
+  return __objc3_has_value(copy);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_weak
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK: store i8 1
+// CHECK: call void @llvm.objc.destroyWeak
+
+bool move_weak(Weak &source) {
+  Weak moved = __objc3_move(source);
+  return __objc3_has_value(moved);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}move_weak
+// CHECK: call void @llvm.objc.moveWeak
+// CHECK: store i8 1
+// CHECK: call void @llvm.objc.destroyWeak
+
+bool copy_unsafe(const Unsafe &source) {
+  Unsafe copy = __objc3_copy(source);
+  return __objc3_has_value(copy);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_unsafe
+// CHECK-NOT: @llvm.objc.retain
+// CHECK-NOT: @llvm.objc.copyWeak
+// CHECK: store i8 1
+
+bool copy_result(const Outcome &source) {
+  Outcome copy = __objc3_copy(source);
+  return __objc3_is_ok(copy);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_result
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: store i8 1
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK: store i8 0
+// CHECK-DAG: call void @llvm.objc.storeStrong
+// CHECK-DAG: call void @llvm.objc.destroyWeak
+
+bool copy_block(const OptionalAction &source) {
+  OptionalAction copy = __objc3_copy(source);
+  return __objc3_has_value(copy);
+}
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_block
+// CHECK: call ptr @llvm.objc.retainBlock
+// CHECK: store i8 1
+// CHECK: call void @llvm.objc.storeStrong
+
+template <class Carrier> bool copy_template(const Carrier &source) {
+  Carrier copy = __objc3_copy(source);
+  return __objc3_has_value(copy);
+}
+template bool copy_template<Strong>(const Strong &);
+// CHECK-LABEL: define{{.*}} @{{.*}}copy_template
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: store i8 1
