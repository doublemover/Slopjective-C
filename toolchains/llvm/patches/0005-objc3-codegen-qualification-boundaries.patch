+++ b/clang/test/ObjC3/CodeGen/typed-error-messages.m
@@ -0,0 +1,41 @@
+// RUN: %clang_cc1 -x objective-c -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -emit-llvm -o - %s | FileCheck %s --check-prefixes=CHECK,GNU
+// RUN: %clang_cc1 -x objective-c -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s --check-prefixes=CHECK,GNU
+// RUN: %clang_cc1 -x objective-c -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s --check-prefixes=CHECK,GNU
+// RUN: %clang_cc1 -x objective-c -triple x86_64-apple-macosx14 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s --check-prefixes=CHECK,MAC
+@protocol Error @end
+typedef id<Error> E;
+@protocol Checked
+- (int)value:(int)fail error:(E)error __objc3_throws(E);
+@end
+__attribute__((objc_root_class)) @interface Receiver <Checked>
+- (void)note:(E)error __objc3_throws(E);
++ (int)classValue __objc3_throws;
+@end
+@implementation Receiver
+- (int)value:(int)fail error:(E)error __objc3_throws(E) {
+  if (fail) __objc3_throw(error);
+  return 0;
+}
+- (void)note:(E)error __objc3_throws(E) { __objc3_throw(error); }
++ (int)classValue __objc3_throws { return 0; }
+@end
+@interface Subclass : Receiver @end
+@implementation Subclass
+- (int)value:(int)fail error:(E)error __objc3_throws(E) {
+  return __objc3_try([super value:fail error:error]);
+}
+@end
+// CHECK: c"value:error:\00"
+// CHECK: c"i36@0:8i16@20^@28\00"
+int instance(id<Checked> receiver, E error) { return __objc3_try_force([receiver value:0 error:error]); }
+// CHECK-LABEL: define{{.*}} i32 @instance(
+// GNU: call{{.*}} i32 {{.*}}(ptr {{.*}}, ptr {{.*}}, i32 {{.*}}, ptr {{.*}}, ptr {{.*}})
+// MAC: call{{.*}} i32 {{.*}}objc_msgSend{{.*}}(ptr {{.*}}, ptr {{.*}}, i32 {{.*}}, ptr {{.*}}, ptr {{.*}})
+// CHECK: objc3.try.failed
+int class_call(void) { return __objc3_try_force([Receiver classValue]); }
+// CHECK-LABEL: define{{.*}} i32 @class_call(
+// CHECK: objc3.try.failed
+void local_handler(Receiver *receiver, E error) {
+  __objc3_do { __objc3_try([receiver note:error]); }
+  __objc3_catch(E caught) { (void)caught; }
+}
