@@ -0,0 +1,32 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-async-task.h"
+
+// The source signature and effect retain a logical scalar result; the actual
+// call and coroutine return object use the runtime task class.
+// CHECK-LABEL: define{{.*}} void @_Z4leafi(
+// CHECK: llvm.coro.id
+// CHECK: llvm.coro.suspend
+int leaf(int value) __objc3_async { return value; }
+static_assert(__is_same(decltype(leaf(1)), objc3::task<int>));
+
+// CHECK-LABEL: define{{.*}} void @_Z6parenti(
+// CHECK: llvm.coro.id
+// CHECK: {{call|invoke}} void @_Z4leafi(
+// CHECK: llvm.coro.suspend
+int parent(int value) __objc3_async {
+  auto identity = [](int x) { return x; };
+  return 1 + __objc3_await leaf(identity(value));
+}
+
+// CHECK-LABEL: define{{.*}} void @_Z5emptyv(
+// CHECK: llvm.coro.id
+void empty() __objc3_async {}
+
+using callback = int (*)(int) __objc3_async;
+callback indirect = leaf;
+auto invoke(callback fn) { return fn(2); }
+
+struct Caller {
+  objc3::task<int> call(callback fn) { return fn(3); }
+};
+auto member_callback(callback fn) { return Caller().call(fn); }
