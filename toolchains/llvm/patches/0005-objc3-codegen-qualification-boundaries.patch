+// CHECK: call void @llvm.objc.destroyWeak
+// CHECK: call void @llvm.objc.moveWeak
+// CHECK: call void @llvm.objc.destroyWeak
+
+void assign_mixed(Mixed *destination, const Mixed *source) {
+  *destination = *source;
+}
+// CHECK-LABEL: define{{.*}}assign_mixed
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK: call void @llvm.objc.storeStrong
+// CHECK: call void @llvm.objc.destroyWeak
+// CHECK: call void @llvm.objc.moveWeak
+
+void assign_block(OptionalAction *destination, const OptionalAction *source) {
+  *destination = *source;
+}
+// CHECK-LABEL: define{{.*}}assign_block
+// CHECK: call ptr @llvm.objc.retainBlock
+// CHECK: call void @llvm.objc.storeStrong
+
+void construct_rhs(Strong *destination, id object) {
+  *destination = __objc3_some(id, object);
+  *destination = __objc3_none(id);
+}
+// CHECK-LABEL: define{{.*}}construct_rhs
