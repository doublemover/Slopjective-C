+  MaybeOwned value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)value; // CodeGen must recover from the rejected declaration before this use.
+}
+#elif defined(TEST_ARC)
+@interface Object
+@end
+typedef __objc3_optional(Object *) MaybeObject;
+void read_after_rejected_lifetime(void) {
+  MaybeObject value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)value; // CodeGen must not synthesize an ARC lifetime after rejecting it.
