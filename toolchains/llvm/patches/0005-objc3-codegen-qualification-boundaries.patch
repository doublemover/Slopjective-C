+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -DTEST_BLOCK=0 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -DTEST_BLOCK=1 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DTEST_BLOCK=0 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -DTEST_BLOCK=1 -emit-llvm -o /dev/null -verify %s
+@protocol Error @end
+#if TEST_BLOCK
+typedef int (^Value)(void);
+#else
+typedef id Value;
+#endif
+Value value(void) __objc3_throws(id<Error>);
+void optional(void) {
