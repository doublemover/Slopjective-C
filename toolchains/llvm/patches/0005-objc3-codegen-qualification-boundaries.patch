+// CHECK-LABEL: define{{.*}} void @_Z6readerU13block_pointerFiiE(
+// CHECK: llvm.coro.id
+Reader reader(Reader value) __objc3_async { return value; }
+static_assert(__is_same(decltype(reader((Reader)0)), objc3::task<Reader>));
+
+// CHECK-LABEL: define{{.*}} void @_Z5relayP6Object(
+// CHECK: llvm.coro.id
+// CHECK: {{call|invoke}} void @_Z6objectP6Object(
+Object *relay(Object *value) __objc3_async {
+  return __objc3_await object(value);
+}
