+// A direct capture list whose acquisition/disposal has no implicit throwing
+// copy operation can use the ordinary native EH graph. General block copies
+// and C++ capture subobject cleanup still need separate operation elements.
+static bool supportsObjC3SimpleBlockCaptures(const BlockExpr *Block) {
+  if (!Block || !Block->getBlockDecl()->hasObjC3CaptureList()) return false;
+  for (const auto &Capture : Block->getBlockDecl()->captures()) {
+    QualType Type = Capture.getCaptureType();
+    if (Type.isNull()) Type = Capture.getVariable()->getType();
+    if (Capture.getObjC3InitExpr() || Capture.hasCopyExpr() || Type->isBlockPointerType() ||
+        (!Type->isScalarType() && !Type->isObjCRetainableType())) return false;
+  }
+  return true;
+}
+static bool isObjC3SimpleBlockInitializer(const Expr *Value) {
+  if (!Value) return false;
+  while (const auto *Full = dyn_cast<ExprWithCleanups>(Value))
+    Value = Full->getSubExpr();
+  return supportsObjC3SimpleBlockCaptures(
+      dyn_cast<BlockExpr>(Value->IgnoreParenImpCasts()));
+}
