+
+static int rethrow_handler() {
+  __objc3_do {
+    __objc3_do {
+      __objc3_throw((FirstError *)make_error_kind(1));
+    } __objc3_catch(FirstError *Error) {
+      ++HandlerEvents;
+      __objc3_throw(Error);
+    } __objc3_catch(FirstError *) {
+      return 97;
+    }
+  } __objc3_catch(FirstError *Error) {
+    return is_nonnull_zero_code_error(Error) ? 1 : 98;
+  }
+  return 99;
+}
+
