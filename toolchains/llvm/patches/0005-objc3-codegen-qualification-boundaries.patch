+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_NONTRIVIAL -emit-llvm -o %t.cxx.ll -verify %s
+// RUN: test ! -e %t.cxx.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -DTEST_ARC -emit-llvm -o %t.arc.ll -verify %s
+// RUN: test ! -e %t.arc.ll
+
+#if defined(TEST_NONTRIVIAL)
+struct Owned {
+  Owned(const Owned &);
+  ~Owned();
+};
+typedef __objc3_optional(Owned) MaybeOwned;
+void read_after_rejected_lifetime(void) {
+  MaybeOwned value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)value; // CodeGen must recover from the rejected declaration before this use.
+}
+#elif defined(TEST_ARC)
+@interface Object
+@end
+typedef __objc3_optional(Object *) MaybeObject;
+void read_after_rejected_lifetime(void) {
+  MaybeObject value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)value; // CodeGen must not synthesize an ARC lifetime after rejecting it.
+}
+#endif
