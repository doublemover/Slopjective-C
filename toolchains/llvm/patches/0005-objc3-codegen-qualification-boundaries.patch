+static bool containsFullExpressionTemporary(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<CXXBindTemporaryExpr>(Statement))
+    return true;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement))
+    if (!Typeid->isPotentiallyEvaluated())
+      return false;
+  // Match arm temporaries end within the selected arm, rather than in the
+  // enclosing full expression. The match visitor owns those cleanup regions.
+  if (isa<CXXNoexceptExpr, UnaryExprOrTypeTraitExpr, LambdaExpr, BlockExpr,
+          ObjC3MatchExpr, ObjC3CoalesceExpr>(
+          Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsFullExpressionTemporary(Child))
+      return true;
+  return false;
+}
+
+static bool recordDeferredTemporaryPrefix(const Stmt *Statement,
+                                          DeferredTemporaryList &Active,
+                                          DeferredTemporaryMap &Pending) {
+  if (!Statement)
+    return true;
+  if (const auto *Resource = dyn_cast<ObjC3ResourceExpr>(Statement)) {
+    // Reset closes the old handle before evaluating its replacement. The
+    // close's exceptional edge owns only the already completed outer prefix.
+    if (!recordDeferredTemporaryPrefix(Resource->getOperand(), Active, Pending))
+      return false;
+    Pending[Statement] = Active;
+    return recordDeferredTemporaryPrefix(Resource->getReplacement(), Active,
+                                         Pending);
+  }
+  // Branch-dependent registration needs the same decision that protects the
+  // normal temporary cleanup. Keep those expressions gated until exceptional
+  // cleanup can replay that decision as well.
+  if (isa<AbstractConditionalOperator, ChooseExpr, StmtExpr, LambdaExpr,
+          BlockExpr, ExprWithCleanups, ObjC3CarrierTransferExpr, PseudoObjectExpr,
+          ObjC3MatchExpr, ObjC3CoalesceExpr,
+          CXXRewrittenBinaryOperator, CXXNewExpr, CoroutineSuspendExpr>(Statement))
+    return false;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement)) {
+    if (!Typeid->isPotentiallyEvaluated()) {
+      Pending[Statement] = Active;
+      return true;
+    }
+  }
+  if (isa<CXXNoexceptExpr>(Statement)) {
+    Pending[Statement] = Active;
+    return true;
+  }
+  if (isa<UnaryExprOrTypeTraitExpr>(Statement))
+    return false; // Variable-length operands can be evaluated.
+  if (const auto *Binary = dyn_cast<BinaryOperator>(Statement)) {
+    if (Binary->isLogicalOp())
+      return false;
+    if (Binary->isAssignmentOp()) {
+      if (!recordDeferredTemporaryPrefix(Binary->getRHS(), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Binary->getLHS(), Active, Pending))
+        return false;
+      Pending[Statement] = Active;
+      return true;
+    }
+    if (Binary->getOpcode() != BO_Comma &&
+        containsFullExpressionTemporary(Binary))
+      return false; // Other operand evaluation does not have a fixed order.
+  }
+  if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(Statement))
+    if (Operator->isAssignmentOp()) {
+      if (!recordDeferredTemporaryPrefix(Operator->getCallee(), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Operator->getArg(1), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Operator->getArg(0), Active, Pending))
+        return false;
+      Pending[Statement] = Active;
+      return true;
+    }
+  // Ordinary argument evaluation has no fixed relative order. A temporary
+  // produced by one argument cannot be assumed alive while another evaluates.
+  // Multiple completed objects are still admitted through sequenced commas,
+  // including nested single-argument calls and constructors.
+  if (const auto *Call = dyn_cast<CallExpr>(Statement)) {
+    if (Call->getNumArgs() > 1)
+      for (const Expr *Argument : Call->arguments())
+        if (containsFullExpressionTemporary(Argument))
+          return false;
+  } else if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Statement)) {
+    if (Constructor->getNumArgs() > 1)
+      for (const Expr *Argument : Constructor->arguments())
+        if (containsFullExpressionTemporary(Argument))
+          return false;
+  }
+  for (const Stmt *Child : Statement->children())
+    if (!recordDeferredTemporaryPrefix(Child, Active, Pending))
+      return false;
+  Pending[Statement] = Active;
+  if (const auto *Temporary = dyn_cast<CXXBindTemporaryExpr>(Statement))
+    Active.push_back(Temporary);
+  return true;
+}
+
+bool CFGBuilder::collectDeferredTemporaryCleanups(
+    const Stmt *Expression, DeferredTemporaryMap &Pending) const {
+  if (!containsFullExpressionTemporary(Expression))
+    return true;
+  DeferredTemporaryList Active;
+  return recordDeferredTemporaryPrefix(Expression, Active, Pending);
+}
+
+bool CFGBuilder::supportsObjC3MatchStorage(QualType Type) const {
+  if (Type.isNull() || Type->isDependentType() ||
+      Type.isDestructedType() != QualType::DK_none ||
+      containsObjC3CarrierManagedStorage(Type) ||
+      containsObjC3CarrierThrowingCopy(Type) ||
+      (Context->getLangOpts().ObjCAutoRefCount &&
+       Type->isObjCRetainableType()))
+    return false;
+  SmallVector<const CXXDestructorDecl *, 4> Destructors;
+  collectObjC3CarrierDestructors(Type, Destructors);
+  return Destructors.empty();
+}
