+// Compile this companion in MRC mode with pinned libobjc2. It supplies a real
+// Error object whose application code is zero and explicit lifetime counters.
+#include <objc/objc.h>
+#include <objc/runtime.h>
+#include <objc/objc-arc.h>
+#include <objc/hooks.h>
+#include "typed-error-runtime-interface.h"
+
+static int Deallocations;
+
+@implementation ZeroCodeError
+- (id)retain {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  ++*Count;
+  return self;
+}
+- (oneway void)release {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  if (--*Count == 0)
+    [self dealloc];
+}
+- (void)dealloc {
+  ++Deallocations;
+  objc_delete_weak_refs(self);
+  object_dispose(self);
+}
+- (id)autorelease {
+  // Before the first explicit pool, libobjc2 delegates autorelease of this
+  // custom MRC root back to this method. Bootstrap its Foundation-free native
+  // pool support with a balanced empty pool, then enqueue the reference.
+  void *Token = objc_autoreleasePoolPush();
+  objc_autoreleasePoolPop(Token);
+  return objc_autorelease(self);
+}
+- (int)code { return Code; }
+@end
+
+@implementation FirstError @end
+@implementation SecondError @end
+@implementation MarkedError @end
+
+// Custom MRC roots own weak teardown and provide libobjc2's live-object hook.
+// This fixture is single-threaded and uses the same indexed count for subclasses.
+static id LoadLiveError(id Object) {
+  return *(unsigned long *)object_getIndexedIvars(Object) ? Object : nil;
+}
+id make_error_kind(int Kind) {
+  _objc_weak_load = LoadLiveError;
+  const char *Name = Kind == 1 ? "FirstError" : Kind == 2 ? "SecondError" :
+                     Kind == 3 ? "MarkedError" : "ZeroCodeError";
+  ZeroCodeError *Value = (ZeroCodeError *)class_createInstance(
+      objc_getClass(Name), sizeof(unsigned long));
+  *(unsigned long *)object_getIndexedIvars(Value) = 1;
+  Value->Code = 0;
+  return Value;
+}
+id make_zero_code_error(void) { return make_error_kind(0); }
+int zero_code_error_deallocations(void) { return Deallocations; }
+int is_nonnull_zero_code_error(id Value) {
+  return Value != nil && [(ZeroCodeError *)Value code] == 0;
+}
+
+// Ordinary Objective-C 2 code sees the physical C ABI, without effect syntax.
+extern int typed_runtime_zero(int argument, id *out_error);
+extern void typed_runtime_void(id *out_error);
+int verify_error_out_abi(void) {
+  id Error = (id)1;
+  if (typed_runtime_zero(0, &Error) != 0 || Error != nil)
+    return 1;
+  typed_runtime_void(&Error);
+  if (Error != nil)
+    return 2;
+  if (typed_runtime_zero(1, &Error) != 0 ||
+      !is_nonnull_zero_code_error(Error))
+    return 3;
+  // A nullable error output must not suppress the call or crash the store.
+  if (typed_runtime_zero(1, 0) != 0)
+    return 4;
+  return 0;
+}
+
+extern int typed_runtime_owned_pool(int argument, id *out_error);
+int verify_owned_error_out_abi(void) {
+  int Before = Deallocations;
+  id Error = (id)1;
+  if (typed_runtime_owned_pool(0, &Error) != 0 || Error != nil)
+    return 1;
+  if (typed_runtime_owned_pool(1, &Error) != 0 ||
+      !is_nonnull_zero_code_error(Error) || Deallocations != Before)
+    return 2;
+  if (typed_runtime_owned_pool(1, 0) != 0 || Deallocations != Before + 1)
+    return 3;
+  return 0;
+}
+int verify_owned_null_error_out(void) {
+  int Before = Deallocations;
+  return typed_runtime_owned_pool(1, 0) == 0 && Deallocations == Before + 1;
+}
+
+
+int zero_code_error_retain_count(id Value) {
+  return Value ? (int)*(unsigned long *)object_getIndexedIvars(Value) : 0;
+}
+// This Objective-C 2 MRC unit uses only the physical C signature. Neither the
+// effect syntax nor ARC is required to exchange the autoreleasing error slot.
+extern int mixed_mrc_value(int fail, ZeroCodeError *error, id *out_error);
+extern int mixed_mrc_owned_pool(int fail, id *out_error);
+int verify_mrc_physical_error_abi(void) {
+  int Before = Deallocations;
+  // No ambient caller pool: discarded errors must release after the callee's
+  // own source ownership and pool cleanup, with no autorelease left behind.
+  if (mixed_mrc_owned_pool(1, 0) != 0 || Deallocations != Before + 1) return 0;
+  Before = Deallocations;
+  ZeroCodeError *Owner = (ZeroCodeError *)make_zero_code_error();
+  if (mixed_mrc_value(1, Owner, 0) != 0 ||
+      zero_code_error_retain_count(Owner) != 1) return 0;
+  [Owner release];
+  if (Deallocations != Before + 1) return 0;
+  @autoreleasepool {
+    Owner = (ZeroCodeError *)make_zero_code_error();
+    id Error = (id)1;
+    if (mixed_mrc_value(0, Owner, &Error) != 0 || Error != nil) return 0;
+    if (mixed_mrc_value(1, Owner, &Error) != 0 || Error != Owner ||
+        zero_code_error_retain_count(Owner) != 2) return 0;
+    [Owner release];
+    if (!is_nonnull_zero_code_error(Error) || Deallocations != Before + 1)
+      return 0;
+  }
+  return Deallocations == Before + 2;
+}
+
+// An ordinary Objective-C 2 client sees the real context-prefix/error-suffix
+// invoke ABI and uses the same platform Block object without a wrapper layout.
+id make_named_zero_code_error(const char *name) {
+  ZeroCodeError *Value = (ZeroCodeError *)class_createInstance(objc_getClass(name), sizeof(unsigned long));
+  *(unsigned long *)object_getIndexedIvars(Value) = 1;
+  return Value;
+}
+int verify_physical_error_message(void *receiver, id expected) {
+  id Receiver = (id)receiver;
+  SEL Selector = sel_registerName("value:error:");
+  Method Method = class_getInstanceMethod(object_getClass(Receiver), Selector);
+  if (!Method || method_getNumberOfArguments(Method) != 5) return 0;
+  typedef int (*PhysicalIMP)(id, SEL, int, id, id *);
+  PhysicalIMP Physical = (PhysicalIMP)method_getImplementation(Method);
+  id Error = (id)1;
+  if (Physical(Receiver, Selector, 0, expected, &Error) != 0 || Error != nil) return 0;
+  @autoreleasepool {
+    if (Physical(Receiver, Selector, 1, expected, &Error) != 0 || Error != expected) return 0;
+    int Before = zero_code_error_retain_count(expected);
+    // Forwarding through super publishes an intermediate borrowed error into
+    // this caller's pool. Discarding the outer transport must not leak either
+    // its owned reference or that temporary publication.
+    @autoreleasepool {
+      if (Physical(Receiver, Selector, 1, expected, 0) != 0) return 0;
+    }
+    if (zero_code_error_retain_count(expected) != Before) return 0;
+  }
+  return 1;
+}
+
+int verify_physical_error_block(void *block, id expected, int success_value) {
+  typedef int (^PhysicalBlock)(int, id *);
+  PhysicalBlock Physical = (PhysicalBlock)block;
+  id Error = (id)1;
+  if (Physical(0, &Error) != success_value || Error != nil) return 0;
+  @autoreleasepool {
+    if (Physical(1, &Error) != 0 || Error != expected) return 0;
+    int Before = zero_code_error_retain_count(expected);
+    if (Physical(1, 0) != 0 || zero_code_error_retain_count(expected) != Before)
+      return 0;
+  }
+  return 1;
+}
