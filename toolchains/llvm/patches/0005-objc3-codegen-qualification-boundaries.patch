+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DTEST_KIND=1 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DTEST_KIND=2 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DTEST_KIND=3 -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -DTEST_KIND=4 -emit-llvm -o /dev/null -verify %s
+@protocol Error @end
+typedef id<Error> E;
+struct Aggregate { int x; };
+@interface Receiver
+#if TEST_KIND <= 2
+- (int)value:(int)x __objc3_throws(E);
+#elif TEST_KIND == 3
+- (int)value __objc3_async __objc3_throws(E); // expected-error {{ObjC3 async/throws method ABI lowering}}
+#else
+- (struct Aggregate)value __objc3_throws(E); // expected-error {{ObjC3 async/throws method ABI lowering}}
+#endif
+@end
+#if TEST_KIND == 1
+int bare(Receiver *receiver) {
+  return [receiver value:0]; // expected-error {{throwing call requires an explicit tryValue, tryOptional or tryForce expression}}
+}
+#elif TEST_KIND == 2
+int nested(Receiver *receiver) {
+  return __objc3_try_force([receiver value:[receiver value:0]]); // expected-error {{throwing call requires an explicit tryValue, tryOptional or tryForce expression}}
+}
+#elif TEST_KIND == 3
+int unsupported(Receiver *receiver) {
+  return __objc3_try_force([receiver value]); // expected-error {{requires a throwing call expression}}
+}
+#else
+struct Aggregate unsupported(Receiver *receiver) { return __objc3_try_force([receiver value]); }
+#endif
