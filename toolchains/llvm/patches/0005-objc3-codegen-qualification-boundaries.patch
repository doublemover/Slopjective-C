diff --git a/clang/lib/CodeGen/CGObjC3OptionalOperators.cpp b/clang/lib/CodeGen/CGObjC3OptionalOperators.cpp
new file mode 100644
index 000000000..93c5aed75
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3OptionalOperators.cpp
@@ -0,0 +1,34 @@
+//===--- CGObjC3OptionalOperators.cpp - Native optional operator lowering -===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3OptionalOperators.h"
+#include "CodeGenFunction.h"
+#include "clang/AST/Expr.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+// Sema's recipe is a native match or binary conditional. Delegate the entire
+// recipe, including destination ownership, to its ordinary emitter. Emitting
+// the written operands here would evaluate the source twice or destroy a
+// selected payload before it has reached the caller's result storage.
+llvm::Value *CodeGen::emitObjC3CoalesceScalarExpr(
+    CodeGenFunction &CGF, const ObjC3CoalesceExpr *E) {
+  assert(E->getSemanticExpr() && "dependent coalescing reached CodeGen");
+  return CGF.EmitScalarExpr(E->getSemanticExpr());
+}
+
+RValue CodeGen::emitObjC3CoalesceComplexExpr(CodeGenFunction &CGF,
+                                            const ObjC3CoalesceExpr *E) {
+  assert(E->getSemanticExpr() && "dependent coalescing reached CodeGen");
+  auto Value = CGF.EmitComplexExpr(E->getSemanticExpr());
+  return RValue::getComplex(Value.first, Value.second);
+}
+
+void CodeGen::emitObjC3CoalesceAggregateExpr(CodeGenFunction &CGF,
+                                            const ObjC3CoalesceExpr *E,
+                                            AggValueSlot Destination) {
+  assert(E->getSemanticExpr() && "dependent coalescing reached CodeGen");
+  CGF.EmitAggExpr(E->getSemanticExpr(), Destination);
+}
