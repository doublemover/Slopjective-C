 }
 
 ABIArgInfo X86_64ABIInfo::classifyReturnType(QualType RetTy) const {
+  if (CGT.isObjC3ARCCarrierABIRecord(RetTy))
+    return getIndirectReturnResult(RetTy);
   // AMD64-ABI 3.2.3p4: Rule 1. Classify the return type with the
   // classification algorithm.
   X86_64ABIInfo::Class Lo, Hi;
@@ -3089,6 +3091,18 @@ void X86_64ABIInfo::computeInfo(CGFunctionInfo &FI) const {
        it != ie; ++it, ++ArgNo) {
     bool IsNamedArg = ArgNo < NumRequiredArgs;
 
+    if (CGT.isObjC3ARCCarrierABIRecord(it->type)) {
+      // A value argument is an initialized caller-owned carrier, borrowed by
+      // the callee for this call. Its pointer consumes one GPR or stack slot;
+      // never fall back to byval copying after register exhaustion (weak
+      // storage is address-sensitive and inactive payload bytes are unread).
+      it->info = ABIArgInfo::getIndirect(
+          getContext().getTypeAlignInChars(it->type), 0, /*ByVal=*/false);
+      if (FreeIntRegs)
+        --FreeIntRegs;
+      continue;
+    }
