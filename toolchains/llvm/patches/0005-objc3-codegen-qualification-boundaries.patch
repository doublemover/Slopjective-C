+
+void strong_result_ok_local(id object) {
+  StrongResult value = __objc3_ok(id, int, object);
+  object = nil;
+  (void)__objc3_is_ok(value);
+}
+// CHECK-LABEL: define{{.*}} @_Z22strong_result_ok_localP11objc_object
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: store i8 1
