@@ -0,0 +1,40 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fobjc-arc-exceptions -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fexceptions -fobjc-arc-exceptions -emit-llvm -o - %s | FileCheck %s
+
+typedef __objc3_optional(id) Strong;
+typedef __objc3_optional(id __weak) Weak;
+typedef __objc3_result(Strong, Weak) Mixed;
+typedef __objc3_optional(Mixed) Nested;
+// All discriminants are followed before any ARC operation. Weak storage is
+// initialized and destroyed at its final address, never copied as bytes.
+Nested copy_nested(Nested *source) { return *source; }
+// CHECK-LABEL: define{{.*}}copy_nested
+// CHECK-NOT: byval
+// CHECK: br i1
+// CHECK: br i1
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: call void @llvm.objc.copyWeak
+// CHECK: ret void
+
+void destroy_nested(Nested value) { value = __objc3_none(Mixed); }
+// CHECK-LABEL: define{{.*}}destroy_nested
+// CHECK: br i1
+// CHECK: br i1
+// CHECK: call void @llvm.objc.storeStrong
+// CHECK: call void @llvm.objc.destroyWeak
+
+int match_snapshot(__objc3_optional(Strong) value) {
+  __objc3_match_stmt(value) {
+    case __objc3_case_some(let child): {
+      value = __objc3_none(Strong);
+      return __objc3_has_value(child);
+    }
+    case __objc3_case_none: { return 0; }
+  }
+  return -1;
+}
+// CHECK-LABEL: define{{.*}}match_snapshot
+// CHECK: objc3.match.owned.scrutinee
+// CHECK: call ptr @llvm.objc.retain
+// CHECK: objc3.match.selected
+// CHECK: call void @llvm.objc.storeStrong
