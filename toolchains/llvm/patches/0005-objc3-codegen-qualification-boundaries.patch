+__attribute__((objc_root_class)) @interface Second <Error> @end
+
+void first(void) __objc3_throws(First *);
+void second(void) __objc3_throws(Second *);
+void marked(void) __objc3_throws(id<Marker>);
+
+int ordered(int which) {
+  __objc3_do {
+    if (which) __objc3_try(first());
+    else __objc3_try(second());
+  } __objc3_catch(First *error) {
+    return error != (id)0;
+  } __objc3_catch(Second *) {
+    return 2;
+  }
+  return 0;
+}
+// CHECK-LABEL: define{{.*}} i32 @ordered(
+// CHECK: call void @first(ptr
+// CHECK: objc3.try.failed
+// CHECK: call void @second(ptr
+// CHECK: objc3.catch.dispatch:
+// CHECK: call ptr @object_getClass(
+// CHECK: call ptr @class_getSuperclass(
+// CHECK: objc3.catch.body:
+// CHECK: call ptr @llvm.objc.retain(
+// CHECK: call ptr @object_getClass(
+// CHECK: call ptr @class_getSuperclass(
+// CHECK: call void @llvm.objc.storeStrong(ptr %objc3.catch.error, ptr null)
+
+void catches_protocol(void) {
+  __objc3_do { __objc3_try(marked()); }
+  __objc3_catch(id<Marker> error) { (void)error; }
+}
+// CHECK-LABEL: define{{.*}} void @catches_protocol(
+// CHECK: call {{i8|i32}} @class_conformsToProtocol(
+// CHECK: objc3.catch.protocol.matches
+
+void bridge(First *error) {
+  __objc3_do { __objc3_throw(error); }
+  __objc3_catch(id<Error> error) { (void)error; }
+}
+// CHECK-LABEL: define{{.*}} void @bridge(
+// CHECK: objc3.thrown.error.present
+// CHECK: objc3.catch.dispatch:
+// CHECK-NOT: @class_conformsToProtocol
+// CHECK: ret void
