 ///  body (compound statement).  The ownership of the returned CFG is
 ///  transferred to the caller.  If CFG construction fails, this method returns
 ///  NULL.
+static bool containsDeferredAction(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<DeferStmt>(Statement))
+    return true;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Capture : Lambda->capture_inits())
+      if (containsDeferredAction(Capture))
+        return true;
+    return false;
+  }
+  if (isa<BlockExpr>(Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsDeferredAction(Child))
+      return true;
+  return false;
+}
+
+static bool containsUnmodeledDeferredJump(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<IndirectGotoStmt, AddrLabelExpr>(Statement))
+    return true;
+  if (const auto *Asm = dyn_cast<GCCAsmStmt>(Statement))
+    if (Asm->isAsmGoto())
+      return true;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Capture : Lambda->capture_inits())
+      if (containsUnmodeledDeferredJump(Capture))
+        return true;
+    return false;
+  }
+  if (isa<BlockExpr>(Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsUnmodeledDeferredJump(Child))
+      return true;
+  return false;
+}
