+//===--- CGObjC3ArcCarriers.h - ARC local carrier adapter ------*- C++ -*-===//
+// Staged private adapter; no source ABI or capability promotion.
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3ARCCARRIERS_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3ARCCARRIERS_H
+#include "Address.h"
+#include "clang/AST/ASTContext.h"
+namespace llvm { class Value; }
+namespace clang {
+class Expr;
+class BinaryOperator;
+class VarDecl;
+class ObjC3OptionalExpr;
+class ObjC3ResultExpr;
+class SourceLocation;
+namespace CodeGen {
+class CodeGenFunction;
+class CodeGenModule;
+class LValue;
+bool supportsObjC3CarrierARCLocalLifetime(CodeGenModule &CGM,
+                                          QualType CarrierType);
+bool supportsObjC3CarrierARCLocalArray(CodeGenModule &CGM, QualType ArrayType);
+void destroyObjC3CarrierARCElement(CodeGenFunction &CGF, Address Storage,
+                                   QualType CarrierType);
+/// Protect a completed initialization until its enclosing expression finishes.
+/// The caller owns a CleanupDeactivationScope and places this flag in its
+/// ObjC3CarrierLocalInitState, so aggregate emission can commit construction.
+Address beginObjC3CarrierInitGuard(CodeGenFunction &CGF, QualType Type,
+                                   Address Storage, bool IsARC);
+bool supportsObjC3CarrierARCCallABI(CodeGenModule &CGM, QualType CarrierType);
+bool supportsObjC3CarrierRuntimeCallABI(CodeGenModule &CGM, QualType CarrierType);
+/// Construct fresh, owned value storage for a local, argument or return slot.
+void emitObjC3CarrierARCValueInit(CodeGenFunction &CGF, const Expr *E,
+                                 Address Destination);
+/// Caller-owned argument and discarded-result storage survives through the
+/// full expression and is destroyed on both normal and exception exits.
+void pushObjC3CarrierARCTemporaryCleanup(CodeGenFunction &CGF, QualType Type,
+                                        Address Storage);
+/// Keep a completed result owned by the callee until all return cleanups finish.
+void emitObjC3CarrierARCReturnProlog(CodeGenFunction &CGF);
+/// A typed failure produces a valid empty result, replacing a completed result
+/// if failure originates in a return cleanup.
+bool emitObjC3CarrierARCErrorReturn(CodeGenFunction &CGF);
+void finalizeObjC3CarrierARCErrorReturn(CodeGenFunction &CGF);
+bool containsObjC3CarrierARCPayload(CodeGenModule &CGM, QualType CarrierType);
+bool hasObjC3CarrierARCCleanup(CodeGenModule &CGM, QualType CarrierType);
+bool hasObjC3CarrierStrongPayload(CodeGenModule &CGM, QualType CarrierType);
+bool hasObjC3CarrierWeakPayload(CodeGenModule &CGM, QualType CarrierType);
+bool isObjC3CarrierARCLocalInitializer(CodeGenModule &CGM, const VarDecl &D);
+/// Initialize a fresh subobject whose owner has established its lifetime.
+void emitObjC3CarrierARCStorageCopy(CodeGenFunction &CGF, QualType Type,
+                                   Address Destination, Address Source,
+                                   bool Move);
+/// Copy only the selected arm. Assignment snapshots before destroying the old
+/// destination, so exact self-copy and aliased source storage are safe.
+bool emitObjC3CarrierARCCopy(CodeGenFunction &CGF, QualType CarrierType,
+                            Address Destination, Address Source,
+                            bool DestinationIsVolatile, bool SourceIsVolatile,
+                            bool IsInitialization, SourceLocation Loc);
+/// Evaluate and preserve the RHS before evaluating the LHS. Return the actual
+/// destination lvalue, including for chained Objective-C++ assignments.
+LValue emitObjC3CarrierARCAssignment(CodeGenFunction &CGF,
+                                    const BinaryOperator &E);
+bool emitObjC3OptionalARCLocalExpr(CodeGenFunction &CGF,
+                                   const ObjC3OptionalExpr &E,
+                                   Address Destination,
+                                   bool IsLocalInitialization,
+                                   bool DestinationIsIgnored,
+                                   bool DestinationIsVolatile);
+bool emitObjC3ResultARCLocalExpr(CodeGenFunction &CGF,
+                                 const ObjC3ResultExpr &E,
+                                 Address Destination,
+                                 bool IsLocalInitialization,
+                                 bool DestinationIsIgnored,
+                                 bool DestinationIsVolatile);
+/// Read only the tag of a direct local lvalue; carrier temporaries and
+/// nonlocal storage remain unqualified.
+llvm::Value *emitObjC3CarrierARCTagQuery(CodeGenFunction &CGF,
+                                         QualType CarrierType,
+                                         Expr *Operand, bool IsResult,
+                                         SourceLocation Loc);
+/// Active-arm destroy operation for a NormalAndEHCleanup registered after a
+/// successful direct local initialization.
+void emitObjC3CarrierDestroyActiveARCPayload(CodeGenFunction &CGF,
+                                             QualType CarrierType,
+                                             Address Storage,
+                                             bool PreciseLifetime,
+                                             bool DestroyStrong,
+                                             bool DestroyWeak);
+} // namespace CodeGen
+} // namespace clang
+#endif
