+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try(callback(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
+    __objc3_do { (void)__objc3_try(object_block(owner, owner)); }
+    __objc3_catch(TestError error) { caught += error == owner; }
