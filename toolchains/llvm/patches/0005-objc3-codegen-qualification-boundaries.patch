+}
+
+static int run_owned_cleanup_checks() {
+  int Before = zero_code_error_deallocations();
+  // A callee with its own pool must discard a nullable output immediately,
+  // without requiring an ambient caller pool or leaving an owned error behind.
+  if (!verify_owned_null_error_out())
+    return 20;
+  if (zero_code_error_deallocations() != Before + 1)
+    return 21;
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (__objc3_try_force(propagates_owned_pool(0)) != 0)
+      return 22;
+    OptionalInt Failed = __objc3_try_optional(propagates_owned_pool(1));
+    if (__objc3_has_value(Failed) || zero_code_error_deallocations() != Before)
+      return 23;
+  }
+  if (zero_code_error_deallocations() != Before + 1 || OwnedCleanupEvents != 5)
+    return 24;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    OptionalInt Failed = __objc3_try_optional(expression_pool_cleanup());
+    if (__objc3_has_value(Failed) || zero_code_error_deallocations() != Before)
+      return 25;
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 26;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    try {
+      __objc3_try_force(expression_cleanup_interrupts());
+      return 27;
+    } catch (int Value) {
+      if (Value != 41 || zero_code_error_deallocations() != Before + 1)
+        return 28;
+    }
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 29;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    try {
+      __objc3_try_force(function_cleanup_interrupts());
+      return 30;
+    } catch (int Value) {
+      if (Value != 37 || zero_code_error_deallocations() != Before + 1)
+        return 31;
+    }
+  }
+  if (zero_code_error_deallocations() != Before + 1)
+    return 32;
+
+  Before = zero_code_error_deallocations();
+  @autoreleasepool {
+    if (verify_owned_error_out_abi() != 0 ||
+        zero_code_error_deallocations() != Before + 1)
+      return 33;
+  }
+  return zero_code_error_deallocations() == Before + 2 ? 0 : 34;
+}
+
+#include "typed-error-do-catch-runtime.inc"
+#include "typed-error-mixed-arc-runtime.inc"
+#include "typed-error-callback-arc-runtime.inc"
+
+#include "typed-error-block-arc-runtime.inc"
+#include "typed-error-member-arc-runtime.inc"
+#include "typed-error-message-arc-runtime.inc"
+
+#include "typed-error-managed-arc-runtime.inc"
+
+int main(int argc, char **argv) {
+  if (argc == 2) {
+    const char *Case = argv[1];
+    if (__builtin_strcmp(Case, "dynamic-nil") == 0) {
+      auto Callback = throw_dynamic;
+      __objc3_try_force(Callback((TestError)nil));
+    } else if (__builtin_strcmp(Case, "force-error") == 0) {
+      @autoreleasepool { __objc3_try_force(typed_runtime_zero(1)); }
+    } else if (__builtin_strcmp(Case, "mrc-dynamic-nil") == 0) mixed_mrc_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-force-error") == 0) mixed_mrc_trap(2);
+    else if (__builtin_strcmp(Case, "block-dynamic-nil") == 0) block_trap(1);
+    else if (__builtin_strcmp(Case, "block-force-error") == 0) block_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-block-dynamic-nil") == 0) mrc_block_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-block-force-error") == 0) mrc_block_trap(2);
+    else if (__builtin_strcmp(Case, "member-dynamic-nil") == 0) member_trap(1);
+    else if (__builtin_strcmp(Case, "member-force-error") == 0) member_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-member-dynamic-nil") == 0) mrc_member_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-member-force-error") == 0) mrc_member_trap(2);
+    else if (__builtin_strcmp(Case, "message-dynamic-nil") == 0) message_trap(1);
+    else if (__builtin_strcmp(Case, "message-force-error") == 0) message_trap(2);
+    else if (__builtin_strcmp(Case, "mrc-message-dynamic-nil") == 0) mrc_message_trap(1);
+    else if (__builtin_strcmp(Case, "mrc-message-force-error") == 0) mrc_message_trap(2);
+    return 250;
+  }
+  if (argc != 1) return 250;
+  if (force_zero_success() != 0)
+    return 1;
+  force_void_success();
+  if (CleanupEvents != 1)
+    return 2;
+
+  @autoreleasepool {
+    OptionalInt Failed = __objc3_try_optional(propagates(next_argument()));
+    if (__objc3_has_value(Failed) || ArgumentEvaluations != 1 ||
+        CleanupEvents != 2)
+      return 3;
+    // The thrown local has been cleaned up; the error still owns a pool
+    // lifetime through the native autoreleasing output slot.
+    if (zero_code_error_deallocations() != 0)
+      return 6;
+  }
+  if (zero_code_error_deallocations() != 1)
+    return 4;
+  @autoreleasepool {
+    if (verify_error_out_abi() != 0)
+      return 7;
+    if (zero_code_error_deallocations() != 2)
+      return 8;
+  }
+  if (zero_code_error_deallocations() != 3)
+    return 11;
+  OptionalVoid VoidSuccess = __objc3_try_optional(zero_void());
+  if (!__objc3_has_value(VoidSuccess))
+    return 14;
+  @autoreleasepool {
+    TestError Error = (TestError)make_zero_code_error();
+    OptionalVoid VoidFailure = __objc3_try_optional(throw_dynamic(Error));
+    if (__objc3_has_value(VoidFailure))
+      return 15;
+  }
+  if (zero_code_error_deallocations() != 4)
+    return 16;
+  try {
+    __objc3_try_force(native_cpp_exception());
+    return 12;
+  } catch (int value) {
+    if (value != 17 || CleanupEvents != 4)
+      return 13;
+  }
+  int OwnedResult = run_owned_cleanup_checks();
+  if (OwnedResult) return OwnedResult;
+  int HandlerResult = run_handler_checks();
+  if (HandlerResult) return HandlerResult;
+  int MRCResult = run_mrc_error_checks();
+  if (MRCResult) return MRCResult;
+  int MixedARCResult = run_mixed_arc_checks();
+  if (MixedARCResult) return MixedARCResult;
+  int CallbackResult = run_callback_checks();
+  if (CallbackResult) return CallbackResult;
+  int BlockResult = run_block_checks();
+  if (BlockResult) return BlockResult;
+  int MemberResult = run_member_checks();
+  if (MemberResult) return MemberResult;
+  int MessageResult = run_message_checks();
+  if (MessageResult) return MessageResult;
+  int ManagedResult = run_managed_success_checks();
+  if (ManagedResult) return ManagedResult;
+  return SawNonNullZeroCodeError == 1 ? 0 : 5;
+}
