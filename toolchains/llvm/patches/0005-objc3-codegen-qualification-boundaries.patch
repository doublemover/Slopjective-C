+bool CodeGenTypes::diagnoseUnsupportedObjC3Effects(QualType T,
+                                                   const Decl *D) {
+  // Callable prototypes can share type nodes with declarations whose implicit
+  // ABI remains unsupported. Visit both roles so a supported pointer type does
+  // not hide an unsupported declaration in the same type graph.
+  llvm::SmallPtrSet<const Type *, 16> Seen[4];
+  bool FoundUnsupportedEffect = false;
+  auto Visit = [&](auto &&VisitSelf, QualType Current, bool ErrorOutABI,
+                   bool AsyncABI) -> void {
+    if (Current.isNull())
+      return;
+    Current = Context.getCanonicalType(Current);
+    const Type *Ty = Current.getTypePtr();
+    auto &RoleSeen = Seen[unsigned(ErrorOutABI) | (unsigned(AsyncABI) << 1)];
+    if (!RoleSeen.insert(Ty).second)
+      return;
+
+    if (const auto *FPT = dyn_cast<FunctionProtoType>(Ty)) {
+      ObjC3FunctionEffectInfo Effects = FPT->getObjC3FunctionEffects();
+      const bool SupportedThrows = ErrorOutABI &&
+          supportsObjC3ErrorOutFunction(CGM, FPT, nullptr, false);
+      bool SupportedAsync = ErrorOutABI && AsyncABI && Effects.Async &&
+          !FPT->isVariadic() &&
+          FPT->getCallConv() == CC_C &&
+          (Context.getLangOpts().CPlusPlus ||
+           (!FPT->getExtInfo().getNoReturn() &&
+            !FPT->getExtInfo().getProducesResult())) &&
+          !Context.getObjC3AsyncReturnType(FPT).isNull() &&
+          (Effects.Throws == ObjC3ThrowsKind::None ||
+           Effects.Throws == ObjC3ThrowsKind::Untyped ||
+           isObjC3ErrorObjectType(CGM, Effects.ErrorType));
+      if (auto *FD = dyn_cast_or_null<FunctionDecl>(D)) {
+        const FunctionDecl *Definition = nullptr;
+        if (Context.getLangOpts().CPlusPlus && !Effects.AsyncFrame &&
+            FPT == FD->getType()->getAs<FunctionProtoType>() &&
+            FD->hasBody(Definition) &&
+            !isa<CoroutineBodyStmt>(Definition->getBody()))
+          SupportedAsync = false;
+      }
+      if (const auto *BD = dyn_cast_or_null<BlockDecl>(D))
+        if (Context.getLangOpts().CPlusPlus && !Effects.AsyncFrame &&
+            FPT == getObjC3CallableFunctionType(BD) && BD->getBody() &&
+            !getObjC3CoroutineBody(BD))
+          SupportedAsync = false;
+      if ((Effects.Async && !SupportedAsync) ||
+          (Effects.Throws != ObjC3ThrowsKind::None &&
+           !SupportedThrows && !SupportedAsync)) {
+        FoundUnsupportedEffect = true;
+        if (DiagnosedObjC3EffectTypes.insert(Ty).second) {
+          if (D)
+            CGM.ErrorUnsupported(D, "ObjC3 async/throws callable ABI lowering");
+          else
+            CGM.Error(SourceLocation(),
+                      "cannot compile ObjC3 async/throws callable type without ABI lowering");
+        }
+      }
+      VisitSelf(VisitSelf, FPT->getReturnType(), true, true);
+      for (QualType Param : FPT->param_types())
+        VisitSelf(VisitSelf, Param, true, true);
+    } else if (const auto *FT = dyn_cast<FunctionNoProtoType>(Ty)) {
+      VisitSelf(VisitSelf, FT->getReturnType(), true, true);
+    } else if (const auto *PT = dyn_cast<PointerType>(Ty)) {
+      VisitSelf(VisitSelf, PT->getPointeeType(), true, AsyncABI);
+    } else if (const auto *BPT = dyn_cast<BlockPointerType>(Ty)) {
+      VisitSelf(VisitSelf, BPT->getPointeeType(), true,
+                !Context.getLangOpts().CPlusPlus || Context.getLangOpts().CPlusPlus20);
+    } else if (const auto *RefTy = dyn_cast<ReferenceType>(Ty)) {
+      VisitSelf(VisitSelf, RefTy->getPointeeType(), true, AsyncABI);
+    } else if (const auto *MPT = dyn_cast<MemberPointerType>(Ty)) {
+      VisitSelf(VisitSelf, MPT->getPointeeType(), true, AsyncABI);
+    } else if (const auto *AT = dyn_cast<ArrayType>(Ty)) {
+      VisitSelf(VisitSelf, AT->getElementType(), true, true);
+    } else if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Ty)) {
+      VisitSelf(VisitSelf, Optional->getElementType(), true, true);
+    } else if (const auto *Result = dyn_cast<ObjC3ResultType>(Ty)) {
+      VisitSelf(VisitSelf, Result->getSuccessType(), true, true);
+      VisitSelf(VisitSelf, Result->getErrorType(), true, true);
+    } else if (const auto *OPT = dyn_cast<ObjCObjectPointerType>(Ty)) {
+      VisitSelf(VisitSelf, OPT->getPointeeType(), true, AsyncABI);
+    } else if (const auto *RecordTy = dyn_cast<RecordType>(Ty)) {
+      if (const RecordDecl *RD = RecordTy->getDecl()->getDefinition()) {
+        if (const auto *CXXRD = dyn_cast<CXXRecordDecl>(RD))
+          for (const CXXBaseSpecifier &Base : CXXRD->bases())
+            VisitSelf(VisitSelf, Base.getType(), true, true);
+        for (const FieldDecl *Field : RD->fields())
+          VisitSelf(VisitSelf, Field->getType(), true, true);
+      }
+    }
+  };
+  const bool PrefixedDeclaration = !T.isNull() && T->isFunctionType() && D &&
+      isa<ObjCMethodDecl, CXXConstructorDecl, CXXDestructorDecl>(D);
+  const auto *Function = dyn_cast_or_null<FunctionDecl>(D);
+  const bool AsyncMember = D && isa<ObjCMethodDecl, BlockDecl>(D);
+  const bool AsyncOperator = Function &&
+      (isa<CXXConversionDecl>(Function) ||
+       Function->getOverloadedOperator() == OO_New ||
+       Function->getOverloadedOperator() == OO_Array_New ||
+       Function->getOverloadedOperator() == OO_Delete ||
+       Function->getOverloadedOperator() == OO_Array_Delete);
+  Visit(Visit, T, !PrefixedDeclaration, !AsyncMember && !AsyncOperator);
+  return FoundUnsupportedEffect;
+}
