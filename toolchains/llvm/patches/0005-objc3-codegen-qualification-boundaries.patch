+    else
+      __objc3_try(throw_second());
+  } __objc3_catch(FirstError *Error) {
+    return is_nonnull_zero_code_error(Error) ? 1 : 90;
+  } __objc3_catch(FirstError *) {
+    return 91;
+  } __objc3_catch(SecondError *Error) {
+    return is_nonnull_zero_code_error(Error) ? 2 : 92;
+  } __objc3_catch {
+    return 93;
+  }
+  return 94;
+}
+
+static int nested_handler(int Kind) {
+  __objc3_do {
+    __objc3_do {
+      if (Kind == 1)
+        __objc3_try(throw_first());
+      else
+        __objc3_try(throw_second());
+    } __objc3_catch(FirstError *) {
+      return 1;
+    }
+  } __objc3_catch(SecondError *Error) {
+    return is_nonnull_zero_code_error(Error) ? 2 : 95;
+  }
+  return 96;
+}
+
+static void unmatched_to_callable(int Kind) __objc3_throws(SecondError *) {
+  __objc3_do {
+    if (Kind == 1)
+      __objc3_try(throw_first());
+    else
+      __objc3_try(throw_second());
+  } __objc3_catch(FirstError *) {
+    ++HandlerEvents;
+  }
