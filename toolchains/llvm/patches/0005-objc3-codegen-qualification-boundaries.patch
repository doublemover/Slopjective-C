+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -fobjc-version=3 -fobjc-runtime=gnustep-2.0 -fobjc-arc -fblocks -emit-llvm -o - %s | FileCheck %s
