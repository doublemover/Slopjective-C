+  }
+  Succ = Continuation;
+  SaveAndRestore SaveDispatch(ObjC3ErrorDispatchBlock, Dispatch);
+  SaveAndRestore SaveDispatchScope(ObjC3ErrorDispatchScope, ScopePos);
+  cfg->addTryDispatchBlock(Dispatch);
+  Block = nullptr;
+  return addStmt(S->getBody());
+}
