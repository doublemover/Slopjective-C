+    if (Caught != 1 || Cleanups != 2 ||
+        __objc3_has_value(__objc3_try_optional(MRC(1)))) return 146;
+    _Block_release((const void *)Arc);
+    _Block_release((const void *)MRC);
+    if (Live != 0) return 147;
