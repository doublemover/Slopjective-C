+#ifndef TYPED_ERROR_RUNTIME_INTERFACE_H
+#define TYPED_ERROR_RUNTIME_INTERFACE_H
+
+#include <objc/objc.h>
+
+@protocol Error
+@end
+
+__attribute__((objc_root_class))
+@interface ZeroCodeError <Error> {
+@public
+  Class isa;
+  int Code;
+}
+- (id)retain;
+- (oneway void)release;
+- (id)autorelease;
+- (void)dealloc;
+- (int)code;
+@end
+
+@protocol Marker <Error> @end
+@interface FirstError : ZeroCodeError @end
+@interface SecondError : ZeroCodeError @end
+@interface MarkedError : FirstError <Marker> @end
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+id make_zero_code_error(void) __attribute__((ns_returns_retained));
+id make_named_zero_code_error(const char *name) __attribute__((ns_returns_retained));
+int verify_physical_error_message(void *receiver, id expected);
+id make_error_kind(int kind) __attribute__((ns_returns_retained));
+int zero_code_error_retain_count(id value);
+int verify_mrc_physical_error_abi(void);
+int verify_physical_error_block(void *block, id expected, int success_value);
+int zero_code_error_deallocations(void);
+int is_nonnull_zero_code_error(id value);
+int verify_error_out_abi(void);
+int verify_owned_error_out_abi(void);
+int verify_owned_null_error_out(void);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
