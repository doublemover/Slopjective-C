+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -fobjc-version=3 -std=c17 -emit-llvm -o - %s | FileCheck %s
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(_Bool) OptionalBool;
+typedef __objc3_optional(void *) OptionalPointer;
+typedef __objc3_optional(void) OptionalVoid;
+struct Pair { int value; double fraction; };
+typedef __objc3_optional(struct Pair) OptionalPair;
+
+extern int side_effect_int(void);
+extern void side_effect_void(void);
+
+int zero_is_present(void) {
+  OptionalInt value = __objc3_some(int, 0);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @zero_is_present()
+// CHECK: store i8 1
+// CHECK: load i8
+
+int none_is_absent(void) {
+  OptionalInt value = __objc3_none(int);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @none_is_absent()
+// CHECK: store i8 0
+// CHECK: load i8
+
+int false_is_present(void) {
+  OptionalBool value = __objc3_some(_Bool, 0);
+  return __objc3_has_value(value);
+}
+// CHECK-LABEL: define{{.*}} i32 @false_is_present()
