+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -DTEST_NONTRIVIAL -emit-llvm -o %t.cxx.ll -verify %s
+// RUN: test ! -e %t.cxx.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -DTEST_ARC -emit-llvm -o %t.arc.ll -verify %s
+// RUN: test ! -e %t.arc.ll
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -DTEST_TEMPORARY -emit-llvm -o %t.temporary.ll -verify %s
+// RUN: test ! -e %t.temporary.ll
+
+#if defined(TEST_NONTRIVIAL) || defined(TEST_TEMPORARY)
+struct Owned { Owned(const Owned &); ~Owned(); };
+typedef __objc3_optional(Owned) MaybeOwned;
+#if defined(TEST_TEMPORARY)
+bool query_rejected_temporary(const Owned &payload) {
+  return __objc3_has_value(__objc3_some(Owned, payload)); // expected-error {{ObjC3 carrier operation 'hasValue query'}}
+}
+#else
+void query_after_rejected_lifetime(void) {
+  MaybeOwned value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  // A borrowed tag query is supported; the earlier invalid local must still
+  // prevent emission without crashing recovery through the later query.
+  (void)__objc3_has_value(value);
+}
+#endif
+#elif defined(TEST_ARC)
+@interface Object @end
+typedef __objc3_optional(Object *) MaybeObject;
+void query_after_rejected_lifetime(void) {
+  MaybeObject value; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+  (void)__objc3_has_value(value); // expected-error {{ObjC3 carrier operation 'hasValue query'}}
+}
+#endif
