+static int mrc_nested_rethrow() {
+  __objc3_do {
+    __objc3_do {
+      __objc3_throw(OwnedError().Object);
+    } __objc3_catch(RuntimeError error) {
+      // The temporary's original +1 is gone; the binding borrows the one
+      // reference owned by the handler. Rethrow must acquire a new retain.
+      if (zero_code_error_retain_count(error) != 1) return 80;
+      __objc3_throw(error);
+    } __objc3_catch { return 81; }
+  } __objc3_catch(RuntimeError error) {
+    if (zero_code_error_retain_count(error) != 1) return 82;
+    return 0;
+  }
+  return 83;
