+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -fobjc-arc -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -x objective-c-header -emit-pch -o %t %S/Inputs/native-c-async-callables.h
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fobjc-exceptions -include-pch %t -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+#include "Inputs/native-c-async-callables.h"
+@implementation NativeCallables
++ (int)classValue __objc3_async { return __objc3_await callable_leaf(42); }
+- (int)value:(int)value __objc3_async {
+  SEL before = _cmd;
+  __objc3_await callable_leaf(0);
+  return self && _cmd == before ? value : 0;
+}
+- (int)direct:(int)value __objc3_async __attribute__((objc_direct)) {
+  SEL before = _cmd;
+  __objc3_await callable_leaf(0);
+  return self && _cmd == before ? value : 0;
+}
+- (id)object:(id)value __objc3_async {
+  id live = value;
+  __objc3_await callable_leaf(0);
+  return live;
+}
+- (int)checked:(id<NativeCallableError>)error __objc3_async __objc3_throws(id<NativeCallableError>) {
+  __objc3_await callable_leaf(0);
+  __objc3_throw(error);
+}
+@end
+@interface NativeDerived : NativeCallables @end
+@implementation NativeDerived
+- (int)value:(int)value __objc3_async { return 1 + __objc3_await [super value:value]; }
+@end
+// CHECK-LABEL: define{{.*}} void @send_dynamic(
+// CHECK: sret(%struct.objc3_async_frame)
+// CHECK: nilReceiverCleanup
+objc3_async_frame send_dynamic(NativeCallables *receiver) { return [receiver value:42]; }
+// CHECK-LABEL: define{{.*}} void @send_protocol(
+// CHECK: sret(%struct.objc3_async_frame)
+objc3_async_frame send_protocol(id<NativeCallable> receiver) { return [receiver value:42]; }
+// CHECK-LABEL: define{{.*}} void @send_direct(
+// CHECK: sret(%struct.objc3_async_frame)
+objc3_async_frame send_direct(NativeCallables *receiver) { return [receiver direct:42]; }
+// CHECK-LABEL: define{{.*}} void @await_dynamic(
+// CHECK: objc3_async_frame_start_child
+// CHECK: objc3_task_await
+// CHECK: llvm.coro.suspend
+int await_dynamic(NativeCallables *receiver) __objc3_async { return __objc3_await [receiver value:42]; }
+// CHECK-LABEL: define{{.*}} void @await_checked_method(
+// CHECK: __objc3_task_error_object
+int await_checked_method(NativeCallables *receiver, id<NativeCallableError> error) __objc3_async __objc3_throws(id<NativeCallableError>) {
+  return __objc3_try(__objc3_await [receiver checked:error]);
+}
+// CHECK-LABEL: define{{.*}} void @invoke_block(
+// CHECK: sret(%struct.objc3_async_frame)
+objc3_async_frame invoke_block(NativeAsyncCallback callback) { return callback(2); }
+// CHECK-LABEL: define{{.*}} void @await_block(
+// CHECK: objc3_async_frame_start_child
+int await_block(NativeAsyncCallback callback) __objc3_async { return __objc3_await callback(2); }
+// CHECK-LABEL: define{{.*}} void @capture_block(
+objc3_async_frame capture_block(id object, int value) {
+  __block int calls = 0;
+  NativeAsyncCallback __unsafe_unretained callback = ^int(int delta) __objc3_async {
+    ++calls;
+    __objc3_await callable_leaf(0);
+    return object ? value + delta + calls : 0;
+  };
+  return callback(2);
+}
+// CHECK-LABEL: define{{.*}} void @checked_block(
+objc3_async_frame checked_block(id<NativeCallableError> error) {
+  NativeCheckedCallback __unsafe_unretained callback = ^int(id<NativeCallableError> value) __objc3_async __objc3_throws(id<NativeCallableError>) {
+    __objc3_await callable_leaf(0);
+    __objc3_throw(value);
+  };
