+static OptionalIntEcho optional_echo_indirect = echo_optional_int;
+static ResultEcho result_echo_indirect = echo_result;
+
+int main(void) {
+  MirrorOptionalInt zero = echo_optional_int(make_optional_int(1, 0));
+  if (zero.state != 1 || zero.payload.value != 0)
+    return 1;
+
+  MirrorOptionalInt nonzero =
+      optional_echo_indirect(make_optional_int(1, 73));
+  if (nonzero.state != 1 || nonzero.payload.value != 73)
+    return 2;
