+  RuntimeError Escaped = nil;
+  __objc3_do { __objc3_throw(OwnedError().Object); }
+  __objc3_catch(RuntimeError error) {
+    if (zero_code_error_retain_count(error) != 1) return 85;
+    Escaped = [error retain];
+  }
+  if (!Escaped || zero_code_error_retain_count(Escaped) != 1 ||
+      zero_code_error_deallocations() != Before)
+    return 86;
+  [Escaped release];
+  if (zero_code_error_deallocations() != Before + 1) return 87;
+
+  Before = zero_code_error_deallocations();
