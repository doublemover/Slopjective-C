+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -emit-llvm -o - %s | FileCheck %s --check-prefix=ITANIUM
+// RUN: %clang_cc1 -triple x86_64-pc-windows-msvc -x objective-c++ -std=c++20 -fobjc-version=3 -emit-llvm -o - %s | FileCheck %s --check-prefix=MSVC
+
+void optional(__objc3_optional(int) *) {}
+void optional(__objc3_optional(long) *) {}
+void optional(__objc3_optional(const int) *) {}
+void result(__objc3_result(int, long) *) {}
+void result(__objc3_result(long, int) *) {}
+void result(__objc3_result(const int, long) *) {}
+void result(__objc3_result(int, const long) *) {}
+
+using OptionalIntAlias = __objc3_optional(int);
+void alias_same(OptionalIntAlias *);
+void alias_same(__objc3_optional(int) *) {}
+
+// ITANIUM-DAG: define{{.*}} @_Z8optionalPU16__objc3_optionali
+// ITANIUM-DAG: define{{.*}} @_Z8optionalPU16__objc3_optionall
+// ITANIUM-DAG: define{{.*}} @_Z8optionalPU16__objc3_optionalKi
+// ITANIUM-DAG: define{{.*}} @_Z6resultPU14__objc3_resultil
+// ITANIUM-DAG: define{{.*}} @_Z6resultPU14__objc3_resultli
+// ITANIUM-DAG: define{{.*}} @_Z6resultPU14__objc3_resultKil
+// ITANIUM-DAG: define{{.*}} @_Z6resultPU14__objc3_resultiKl
+// ITANIUM-DAG: define{{.*}} @_Z10alias_samePU16__objc3_optionali
