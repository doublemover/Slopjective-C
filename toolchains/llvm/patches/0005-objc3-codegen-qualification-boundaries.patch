diff --git a/clang/test/ObjC3/Analysis/defer-match-coalesce.mm b/clang/test/ObjC3/Analysis/defer-match-coalesce.mm
new file mode 100644
index 000000000..77ced353a
--- /dev/null
+++ b/clang/test/ObjC3/Analysis/defer-match-coalesce.mm
@@ -0,0 +1,57 @@
+// RUN: %clang_analyze_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -analyzer-checker=debug.DumpCFG %s 2>&1 | FileCheck %s
+// RUN: %clang_analyze_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -analyzer-checker=debug.DumpCFG -analyzer-config cfg-lifetime=true,cfg-scopes=true %s 2>&1 | FileCheck %s
+// RUN: %clang_analyze_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -analyzer-checker=debug.DumpCFG %s 2>&1 | FileCheck %s
+
+#ifdef __cplusplus
+#define BOOLEAN bool
+#define NOEXCEPT noexcept
+#else
+#define BOOLEAN _Bool
+#define NOEXCEPT __attribute__((nothrow))
+#endif
+
+typedef Optional(int) Maybe;
+Maybe *source(void) NOEXCEPT;
+int selected(void) NOEXCEPT;
+int fallback(void) NOEXCEPT;
+void finish(void) NOEXCEPT;
+BOOLEAN predicate(int) NOEXCEPT;
+
+// CHECK-LABEL: match_ordered
+// CHECK-DAG: ObjC3 match tag
+// CHECK-DAG: predicate
+// CHECK-DAG: selected
+// CHECK-DAG: fallback
+// CHECK-DAG: source
+// CHECK-DAG: finish
+void match_ordered(void) {
+  defer { finish(); }
+  __objc3_match_stmt (*source()) {
+    case .Some(let payload) where predicate(payload): { selected(); }
+    case .Some(_): { fallback(); }
+    case .None: { }
+  }
+}
+
+// CHECK-LABEL: coalesce_once
+// CHECK-DAG: ObjC3 match tag
+// CHECK-DAG: source
+// CHECK-DAG: fallback
+// CHECK-DAG: finish
+int coalesce_once(void) {
+  defer { finish(); }
+  return *source() ?? fallback();
+}
+
+// CHECK-LABEL: selected_expression
+// CHECK-DAG: ObjC3 match pattern
+// CHECK-DAG: selected
+// CHECK-DAG: fallback
+// CHECK-DAG: finish
+int selected_expression(int value) {
+  defer { finish(); }
+  return __objc3_match (value) {
+    case 0 => selected();
+    default => fallback();
+  };
+}
