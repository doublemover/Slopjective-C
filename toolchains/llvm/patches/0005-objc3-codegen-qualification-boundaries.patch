+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -triple x86_64-pc-windows-msvc -fobjc-runtime=gnustep-2.0 -fobjc-version=3 -fblocks -fexceptions -fcxx-exceptions -debug-info-kind=limited -O2 -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
