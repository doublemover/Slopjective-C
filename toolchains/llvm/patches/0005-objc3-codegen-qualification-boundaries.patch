+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -DTEST_CARRIER_BY_VALUE -emit-llvm -o %t.by-value.ll -verify %s
