+// RUN: test ! -e %t.UNINITIALIZED.ll
+
+typedef __objc3_optional(id) Strong;
+
+#ifdef DESTINATION
+void reject_volatile_destination(volatile Strong *destination, Strong *source) {
+  *destination = *source; // expected-error {{ObjC3 carrier operation 'ARC carrier assignment'}}
+}
+#endif
+
+#ifdef SOURCE
+void reject_volatile_source(Strong *destination, volatile Strong *source) {
+  *destination = *source; // expected-error {{ObjC3 carrier operation 'ARC carrier assignment'}}
+}
+#endif
+
+#ifdef LOCAL
+void reject_volatile_local(volatile Strong *source) {
+  Strong copy = *source; // expected-error {{ObjC3 carrier operation 'local lifetime'}}
+}
+#endif
+
+#ifdef UNINITIALIZED
