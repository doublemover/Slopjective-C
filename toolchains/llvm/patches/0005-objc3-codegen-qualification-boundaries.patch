@@ -0,0 +1,57 @@
+// Build this companion with the pinned GNUstep runtime in MRC mode. The ARC
+// executable imports only the native object-return and count functions below.
+#include <objc/objc.h>
+#include <objc/runtime.h>
+#include <objc/objc-arc.h>
+#include <objc/hooks.h>
+
+static int Deallocations;
+
+__attribute__((objc_root_class))
+@interface ArcCarrierProbe {
+  Class isa;
+}
+- (id)retain;
+- (oneway void)release;
+- (unsigned long)retainCount;
+- (void)dealloc;
+@end
+
+@implementation ArcCarrierProbe
+- (id)retain {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  ++*Count;
+  return self;
+}
+- (oneway void)release {
+  unsigned long *Count = (unsigned long *)object_getIndexedIvars(self);
+  if (--*Count == 0)
+    [self dealloc];
+}
+- (unsigned long)retainCount {
+  return *(unsigned long *)object_getIndexedIvars(self);
+}
+- (void)dealloc {
+  ++Deallocations;
+  // A custom MRC root class owns its weak-reference teardown.
+  objc_delete_weak_refs(self);
+  object_dispose(self);
+}
+@end
+
+// libobjc2 requires this hook for custom MRC retain/release classes. The
+// runtime invokes it under its weak table lock; this single-thread fixture
+// owns the corresponding count and explicitly removes weak refs in dealloc.
+static id LoadLiveProbe(id Object) {
+  return *(unsigned long *)object_getIndexedIvars(Object) ? Object : nil;
+}
+
+id make_arc_carrier_probe(void) __attribute__((ns_returns_retained));
+id make_arc_carrier_probe(void) {
+  _objc_weak_load = LoadLiveProbe;
+  id Object = class_createInstance(objc_getClass("ArcCarrierProbe"),
+                                   sizeof(unsigned long));
+  *(unsigned long *)object_getIndexedIvars(Object) = 1;
+  return Object;
+}
+int arc_carrier_probe_deallocations(void) { return Deallocations; }
