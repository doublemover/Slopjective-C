+  if (!__objc3_has_value(aggregate))
+    return 4;
+
+  if (!__objc3_has_value(__objc3_some(int, return_zero_once())) || calls != 1)
+    return 2;
+
+  OptionalVoid present_void =
+      __objc3_some(void, increment_once());
+  OptionalVoid absent_void = __objc3_none(void);
+  if (!__objc3_has_value(present_void) || __objc3_has_value(absent_void) ||
+      calls != 2)
+    return 3;
+  return 0;
+}
diff --git a/clang/test/ObjC3/CodeGen/Inputs/result-expression-runtime.c b/clang/test/ObjC3/CodeGen/Inputs/result-expression-runtime.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/result-expression-runtime.c
@@ -0,0 +1,27 @@
+// Standalone native executable companion; the owned Windows qualification
+// runner compiles and runs this with the explicit admitted target/profile.
+
+static int calls;
+typedef __objc3_result(int, long long) R;
+static void side_effect(void) { ++calls; }
+static int next_value(void) { ++calls; return 0; }
+static void copy_result(R *destination, const R *source) {
+  *destination = *source;
+}
+
+int main(void) {
+  R success = __objc3_ok(int, long long, 0);
+  R error = __objc3_err(int, long long, 0);
+  if (!__objc3_is_ok(success) || __objc3_is_ok(error)) return 1;
+  if (!__objc3_is_ok(__objc3_ok(_Bool, int, 0))) return 2;
+  if (!__objc3_is_ok(__objc3_ok(void *, int, (void *)0))) return 3;
+  if (!__objc3_is_ok(__objc3_ok(void, int, side_effect())) || calls != 1) return 4;
+  if (__objc3_is_ok(__objc3_err(int, void, side_effect())) || calls != 2) return 5;
+  if (__objc3_is_ok(__objc3_err(int, long long, next_value())) || calls != 3) return 6;
+  R copied = __objc3_err(int, long long, 0);
+  copy_result(&copied, &success);
+  if (!__objc3_is_ok(copied)) return 7;
+  copy_result(&copied, &error);
+  if (__objc3_is_ok(copied)) return 8;
+  return 0;
+}
