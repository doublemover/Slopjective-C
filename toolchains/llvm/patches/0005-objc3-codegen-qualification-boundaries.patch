diff --git a/clang/lib/CodeGen/CGObjC3Async.cpp b/clang/lib/CodeGen/CGObjC3Async.cpp
new file mode 100644
index 000000000..d087a9e40
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Async.cpp
@@ -0,0 +1,1124 @@
+//===--- CGObjC3Async.cpp - Native C async frames -------------------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+// The public entry returns objc3_async_frame. LLVM coroutine splitting supplies
+// the private resume/destroy state machine; no C++ promise or task layout is
+// exposed at the C boundary. Clang's ordinary lexical cleanup stack is used on
+// return, suspension destruction, checked failure and cancellation alike.
+//===----------------------------------------------------------------------===//
+#include "CGCleanup.h"
+#include "CGCall.h"
+#include "CGDebugInfo.h"
+#include "CGObjC3Async.h"
+#include "CGObjC3ArcCarriers.h"
+#include "CGObjC3Carriers.h"
+#include "CGObjC3ManagedStorage.h"
+#include "CGObjC3Isolation.h"
+#include "CGObjC3TypedErrors.h"
+#include "CGObjCRuntime.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Mangle.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/ObjC3Async.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "clang/AST/StmtObjC.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/IR/Intrinsics.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace clang::CodeGen {
+struct CGObjC3CAsyncData {
+  llvm::Value *Id = nullptr;
+  llvm::Value *Frame = nullptr;
+  Address Owner = Address::invalid();
+  Address Result = Address::invalid();
+  Address ResultLive = Address::invalid();
+  Address Error = Address::invalid();
+  Address Kind = Address::invalid();
+  Address ScopeEntered = Address::invalid();
+  llvm::Value *ResultOps = nullptr;
+  llvm::Constant *ResultType = nullptr;
+  QualType LogicalResult;
+  CodeGenFunction::JumpDest Destroy;
+  CodeGenFunction::JumpDest Final;
+  llvm::BasicBlock *Suspend = nullptr;
+  const ReturnStmt *ExceptionReturn = nullptr;
+  SmallVector<Address, 4> AutoreleasePools;
+};
+CodeGenFunction::CGObjC3CAsyncInfo::CGObjC3CAsyncInfo() = default;
+CodeGenFunction::CGObjC3CAsyncInfo::~CGObjC3CAsyncInfo() = default;
+} // namespace clang::CodeGen
+
+namespace {
+constexpr unsigned ServiceABI = 4;
+constexpr unsigned AsyncABI = 1;
+constexpr unsigned ValueOpsABI = 1;
+
+llvm::Value *nullPtr(CodeGenFunction &CGF) {
+  return llvm::ConstantPointerNull::get(CGF.Int8PtrTy);
+}
+llvm::FunctionCallee runtime(CodeGenModule &CGM, StringRef Name,
+                             llvm::Type *Result,
+                             ArrayRef<llvm::Type *> Arguments) {
+  return CGM.CreateRuntimeFunction(
+      llvm::FunctionType::get(Result, Arguments, false), Name);
+}
+llvm::Value *call(CodeGenFunction &CGF, StringRef Name, llvm::Type *Result,
+                  ArrayRef<llvm::Value *> Args) {
+  SmallVector<llvm::Type *, 4> Types;
+  for (llvm::Value *Arg : Args) Types.push_back(Arg->getType());
+  return CGF.EmitNounwindRuntimeCall(runtime(CGF.CGM, Name, Result, Types), Args);
+}
+llvm::StructType *completionType(CodeGenModule &CGM) {
+  return llvm::StructType::get(CGM.Int32Ty, CGM.Int32Ty, CGM.Int32Ty,
+                                CGM.Int32Ty, CGM.Int8PtrTy, CGM.Int8PtrTy,
+                                CGM.Int8PtrTy, CGM.Int8PtrTy);
+}
+Address field(CodeGenFunction &CGF, Address Record, unsigned Index) {
+  return CGF.Builder.CreateStructGEP(Record, Index);
+}
+void storeField(CodeGenFunction &CGF, Address Record, unsigned Index,
+                 llvm::Value *Value) {
+  CGF.Builder.CreateStore(Value, field(CGF, Record, Index));
+}
+unsigned resultKind(QualType T) {
+  if (T->isVoidType()) return 3;
+  if (T->isObjCObjectPointerType()) return 1;
+  if (T->isBlockPointerType()) return 2;
+  return 0;
+}
+QualType resultStorageType(ASTContext &Ctx, QualType T) {
+  T = T.getCanonicalType().getUnqualifiedType();
+  if (T->isObjCRetainableType())
+    T = Ctx.getLifetimeQualifiedType(T, Qualifiers::OCL_ExplicitNone);
+  return T;
+}
+
+// The callbacks use native initialization/destruction, including nontrivial C
+// records. A result owner is independent of both the frame and copy-out owner.
+llvm::Function *valueOperation(CodeGenModule &CGM, QualType T, bool Destroy,
+                                bool Move) {
+  auto &Ctx = CGM.getContext();
+  FunctionArgList Args;
+  for (unsigned I = 0; I != (Destroy ? 1u : 2u); ++I)
+    Args.push_back(ImplicitParamDecl::Create(
+        Ctx, Ctx.VoidPtrTy, ImplicitParamKind::Other));
+  QualType Ret = Destroy ? Ctx.VoidTy : Ctx.IntTy;
+  const auto &FI = CGM.getTypes().arrangeBuiltinFunctionDeclaration(Ret, Args);
+  auto *F = llvm::Function::Create(
+      CGM.getTypes().GetFunctionType(FI), llvm::GlobalValue::InternalLinkage,
+      Destroy ? "__objc3_c_async_value_destroy"
+              : Move ? "__objc3_c_async_value_move"
+                     : "__objc3_c_async_value_copy",
+      &CGM.getModule());
+  CGM.SetInternalFunctionAttributes(GlobalDecl(), F, FI);
+  CodeGenFunction CGF(CGM);
+  CGF.StartFunction(GlobalDecl(), Ret, F, FI, Args);
+  auto Debug = ApplyDebugLocation::CreateArtificial(CGF);
+  auto AddressOf = [&](unsigned I) {
+    return Address(CGF.Builder.CreateLoad(CGF.GetAddrOfLocalVar(Args[I])),
+                   CGF.ConvertTypeForMem(T), Ctx.getTypeAlignInChars(T));
+  };
+  llvm::BasicBlock *Catch = nullptr;
+  if (CGF.getLangOpts().ObjCExceptions) {
+    Catch = CGF.createBasicBlock("objc3.value.exception");
+    auto Info = CGM.getObjCRuntime().getCatchAllTypeInfo();
+    CGF.EHStack.pushCatch(1)->setHandler(0, Info, Catch);
+  }
+  Address Dst = AddressOf(0);
+  if (Destroy) {
+    if (!emitObjC3ManagedStorageCall(CGF, CGF.MakeAddrLValue(Dst, T),
+                                    ObjC3StorageOperation::Destroy)) {
+      auto DK = T.isDestructedType();
+      if (DK != QualType::DK_none)
+        CGF.emitDestroy(Dst, T, CGF.getDestroyer(DK), false);
+    }
+  } else {
+    Address Src = AddressOf(1);
+    LValue DstLV = CGF.MakeAddrLValue(Dst, T);
+    LValue SrcLV = CGF.MakeAddrLValue(Src, T);
+    if (!emitObjC3ManagedStorageCall(
+            CGF, DstLV, SrcLV,
+            Move ? ObjC3StorageOperation::Move : ObjC3StorageOperation::Copy)) {
+      if (T.isNonTrivialToPrimitiveCopy() == QualType::PCK_Struct) {
+        if (Move) CGF.callCStructMoveConstructor(DstLV, SrcLV);
+        else CGF.callCStructCopyConstructor(DstLV, SrcLV);
+      } else {
+        CGF.Builder.CreateMemCpy(Dst, Src, Ctx.getTypeSizeInChars(T).getQuantity());
+      }
+    }
+    CGF.Builder.CreateStore(CGF.Builder.getInt32(0), CGF.ReturnValue);
+  }
+  if (Catch) {
+    CGF.popCatchScope();
+    CGF.EmitBranchThroughCleanup(CGF.ReturnBlock);
+    CGF.EmitBlock(Catch);
+    call(CGF, "objc_begin_catch", CGF.Int8PtrTy, {CGF.getExceptionFromSlot()});
+    call(CGF, "objc_end_catch", CGF.VoidTy, {});
+    if (!Destroy)
+      CGF.Builder.CreateStore(CGF.Builder.getInt32(8), CGF.ReturnValue);
+    CGF.EmitBranchThroughCleanup(CGF.ReturnBlock);
+  }
+  CGF.FinishFunction();
+  F->setDoesNotThrow();
+  return F;
+}
+bool hasCxxFrameStorage(CodeGenFunction &CGF, QualType T) {
+  return CGF.getLangOpts().CPlusPlus && T->isRecordType() &&
+         !T.isTriviallyCopyableType(CGF.getContext());
+}
+
+RValue cxxFrameStorageCall(CodeGenFunction &CGF, QualType T, StringRef Name,
+                           ArrayRef<llvm::Value *> Values) {
+  // Sema resolved and instantiated this reserved template. The specialization
+  // is ordinary AST, including when the enclosing definition came from PCH.
+  auto &Ctx = CGF.getContext();
+  for (NamedDecl *D : Ctx.getTranslationUnitDecl()->lookup(&Ctx.Idents.get(Name))) {
+    auto *Template = dyn_cast<FunctionTemplateDecl>(D);
+    if (!Template) continue;
+    for (FunctionDecl *Function : Template->specializations()) {
+      const auto *Args = Function->getTemplateSpecializationArgs();
+      if (!Args || Args->size() != 1 ||
+          !Ctx.hasSameType(Args->get(0).getAsType(), T))
+        continue;
+      CallArgList CallArgs;
+      for (unsigned I = 0; I != Values.size(); ++I)
+        CallArgs.add(RValue::get(Values[I]), Function->getParamDecl(I)->getType());
+      return CGF.EmitCall(CGF.CGM.getTypes().arrangeFunctionDeclaration(Function),
+          CGCallee::forDirect(CGF.CGM.GetAddrOfFunction(Function),
+                             CGCalleeInfo(GlobalDecl(Function))),
+          ReturnValueSlot(), CallArgs);
+    }
+  }
+  llvm_unreachable("Sema did not instantiate explicit C++ frame storage hook");
+}
+
+llvm::Value *valueOps(CodeGenFunction &CGF, QualType T) {
+  unsigned Kind = resultKind(T);
+  if (Kind == 3) return nullPtr(CGF);
+  if (Kind == 1 || Kind == 2)
+    return call(CGF, "objc3_async_reference_ops", CGF.Int8PtrTy,
+                {CGF.Builder.getInt32(Kind)});
+  auto &CGM = CGF.CGM;
+  T = resultStorageType(CGF.getContext(), T);
+  if (hasCxxFrameStorage(CGF, T))
+    return cxxFrameStorageCall(CGF, T, "__objc3_async_frame_value_ops", {})
+        .getScalarVal();
+  if (auto *Existing = CGM.ObjC3CAsyncValueOps.lookup(T))
+    return Existing;
+  auto *Type = llvm::StructType::get(CGF.Int32Ty, CGF.Int32Ty, CGF.Int64Ty,
+                                     CGF.Int64Ty, CGF.Int8PtrTy, CGF.Int8PtrTy,
+                                     CGF.Int8PtrTy);
+  auto *Initializer = llvm::ConstantStruct::get(
+      Type, {CGF.Builder.getInt32(48), CGF.Builder.getInt32(ValueOpsABI),
+             CGF.Builder.getInt64(CGF.getContext().getTypeSizeInChars(T).getQuantity()),
+             CGF.Builder.getInt64(CGF.getContext().getTypeAlignInChars(T).getQuantity()),
+             valueOperation(CGM, T, false, false),
+             valueOperation(CGM, T, false, true),
+             valueOperation(CGM, T, true, false)});
+  auto *Ops = new llvm::GlobalVariable(
+      CGM.getModule(), Type, true, llvm::GlobalValue::PrivateLinkage, Initializer,
+      "__objc3_c_async_value_ops");
+  Ops->setAlignment(llvm::Align(8));
+  CGM.ObjC3CAsyncValueOps[T] = Ops;
+  return Ops;
+}
+llvm::Constant *resultDescriptor(CodeGenFunction &CGF, QualType T) {
+  auto &Ctx = CGF.getContext();
+  T = resultStorageType(Ctx, T);
+  if (auto *Existing = CGF.CGM.ObjC3CAsyncResultTypes.lookup(T))
+    return Existing;
+  std::unique_ptr<ItaniumMangleContext> Mangler(
+      ItaniumMangleContext::create(Ctx, Ctx.getDiagnostics()));
+  QualType IdentityType = T.getCanonicalType().getUnqualifiedType();
+  bool External = IdentityType->getLinkage() == Linkage::External;
+  std::string Identity = External ? "objc3.async.v1:" : "objc3.async.local.v1:";
+  llvm::raw_string_ostream Stream(Identity);
+  Mangler->mangleCanonicalTypeName(IdentityType, Stream);
+  auto *Key = CGF.CGM.GetAddrOfConstantCString(Identity).getPointer();
+  llvm::Constant *Domain = llvm::ConstantPointerNull::get(CGF.Int8PtrTy);
+  if (!External) {
+    // C function results cannot name block-local records. File-private types
+    // remain nominal within this translation unit, even with matching spelling.
+    auto *Token = new llvm::GlobalVariable(
+        CGF.CGM.getModule(), CGF.Int8Ty, true,
+        llvm::GlobalValue::PrivateLinkage, CGF.Builder.getInt8(0),
+        "__objc3_c_async_identity_domain");
+    Domain = Token;
+  }
+  unsigned Kind = resultKind(T);
+  auto *Type = llvm::StructType::get(
+      CGF.Int32Ty, CGF.Int32Ty, CGF.Int64Ty, CGF.Int64Ty, CGF.Int32Ty,
+      CGF.Int32Ty, CGF.Int8PtrTy, CGF.Int64Ty, CGF.Int8PtrTy);
+  auto *Init = llvm::ConstantStruct::get(
+      Type, {CGF.Builder.getInt32(56), CGF.Builder.getInt32(AsyncABI),
+             CGF.Builder.getInt64(Kind == 3 ? 0 : Ctx.getTypeSizeInChars(T).getQuantity()),
+             CGF.Builder.getInt64(Kind == 3 ? 1 : Ctx.getTypeAlignInChars(T).getQuantity()),
+             CGF.Builder.getInt32(Kind), CGF.Builder.getInt32(0), Key,
+             CGF.Builder.getInt64(Identity.size()), Domain});
+  auto *Descriptor = new llvm::GlobalVariable(
+      CGF.CGM.getModule(), Type, true, llvm::GlobalValue::PrivateLinkage, Init,
+      "__objc3_c_async_result_type");
+  Descriptor->setAlignment(llvm::Align(8));
+  CGF.CGM.ObjC3CAsyncResultTypes[T] = Descriptor;
+  return Descriptor;
+}
+llvm::Value *invokeOp(CodeGenFunction &CGF, llvm::Value *Ops, unsigned Index,
+               ArrayRef<llvm::Value *> Args) {
+  auto *OpsType = llvm::StructType::get(
+      CGF.Int32Ty, CGF.Int32Ty, CGF.Int64Ty, CGF.Int64Ty, CGF.Int8PtrTy,
+      CGF.Int8PtrTy, CGF.Int8PtrTy);
+  auto *Fn = CGF.Builder.CreateLoad(
+      CGF.Builder.CreateStructGEP(
+          Address(Ops, OpsType, CharUnits::fromQuantity(8)), Index));
+  SmallVector<llvm::Type *, 2> Types;
+  for (auto *Arg : Args) Types.push_back(Arg->getType());
+  return CGF.EmitNounwindRuntimeCall(
+      llvm::FunctionCallee(
+          llvm::FunctionType::get(Index == 6 ? CGF.VoidTy : CGF.Int32Ty,
+                                   Types, false), Fn), Args);
+}
+struct DestroyResult final : EHScopeStack::Cleanup {
+  Address Result, Live, Error;
+  llvm::Value *Ops;
+  DestroyResult(Address Result, Address Live, Address Error, llvm::Value *Ops)
+      : Result(Result), Live(Live), Error(Error), Ops(Ops) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    call(CGF, "objc3_error_release", CGF.VoidTy,
+         {CGF.Builder.CreateLoad(Error)});
+    if (!Result.isValid()) return;
+    auto *Destroy = CGF.createBasicBlock("objc3.result.destroy");
+    auto *Done = CGF.createBasicBlock("objc3.result.destroyed");
+    CGF.Builder.CreateCondBr(CGF.Builder.CreateLoad(Live), Destroy, Done);
+    CGF.EmitBlock(Destroy);
+    CGF.Builder.CreateStore(CGF.Builder.getFalse(), Live);
+    invokeOp(CGF, Ops, 6, {Result.emitRawPointer(CGF)});
+    CGF.EmitBranch(Done);
+    CGF.EmitBlock(Done);
+  }
+};
+struct ReleaseCapture final : EHScopeStack::Cleanup {
+  llvm::Value *Value;
+  explicit ReleaseCapture(llvm::Value *Value) : Value(Value) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    CGF.EmitARCRelease(Value, ARCPreciseLifetime);
+  }
+};
+struct FreeFrame final : EHScopeStack::Cleanup {
+  llvm::Value *Id, *Frame;
+  FreeFrame(llvm::Value *Id, llvm::Value *Frame) : Id(Id), Frame(Frame) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    auto *Memory = CGF.Builder.CreateCall(
+        CGF.CGM.getIntrinsic(llvm::Intrinsic::coro_free), {Id, Frame});
+    call(CGF, "free", CGF.VoidTy, {Memory});
+  }
+};
+struct DisposeChild final : EHScopeStack::Cleanup {
+  Address Frame, Child;
+  DisposeChild(Address Frame, Address Child) : Frame(Frame), Child(Child) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    call(CGF, "objc3_async_frame_dispose", CGF.Int32Ty,
+         {Frame.emitRawPointer(CGF)});
+    auto *Dependency = CGF.Builder.CreateLoad(Child);
+    // Cancellation after completion is harmless; doing it unconditionally also
+    // handles abandonment while the child is pending, without racing a view.
+    call(CGF, "objc3_task_request_cancel", CGF.VoidTy, {Dependency});
+    call(CGF, "objc3_task_release", CGF.VoidTy, {Dependency});
+    CGF.Builder.CreateStore(nullPtr(CGF), Child);
+  }
+};
+void closeAutoreleasePool(CodeGenFunction &CGF, Address Slot) {
+  llvm::Value *Token = CGF.Builder.CreateLoad(Slot);
+  auto *Active = CGF.createBasicBlock("objc3.pool.active");
+  auto *Done = CGF.createBasicBlock("objc3.pool.closed");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Token), Active, Done);
+  CGF.EmitBlock(Active);
+  // Clear before invoking arbitrary object destruction. An exception or
+  // reentrant cleanup must never pop the same thread-local pool twice.
+  CGF.Builder.CreateStore(nullPtr(CGF), Slot);
+  CGF.EmitObjCAutoreleasePoolPop(Token);
+  CGF.EmitBranch(Done);
+  CGF.EmitBlock(Done);
+}
+struct CloseAutoreleasePool final : EHScopeStack::Cleanup {
+  Address Slot;
+  explicit CloseAutoreleasePool(Address Slot) : Slot(Slot) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    closeAutoreleasePool(CGF, Slot);
+  }
+};
+void suspend(CodeGenFunction &CGF, CGObjC3CAsyncData &Data, bool Final) {
+  // Explicit lexical pools nest inside the scheduler's implicit slice pool.
+  // Drain them before that outer pool, and carry no thread-local token across
+  // suspension. Their storage remains live for cancellation/destruction paths.
+  for (Address Slot : llvm::reverse(Data.AutoreleasePools))
+    closeAutoreleasePool(CGF, Slot);
+  auto *Ready = CGF.createBasicBlock(Final ? "objc3.final.ready" : "objc3.await.ready");
+  auto *Destroy = CGF.createBasicBlock("objc3.suspend.destroy");
+  auto *Token = llvm::ConstantTokenNone::get(CGF.getLLVMContext());
+  auto *State = CGF.Builder.CreateCall(
+      CGF.CGM.getIntrinsic(llvm::Intrinsic::coro_suspend),
+      {Token, CGF.Builder.getInt1(Final)});
+  auto *Switch = CGF.Builder.CreateSwitch(State, Data.Suspend, 2);
+  Switch->addCase(CGF.Builder.getInt8(0), Ready);
+  Switch->addCase(CGF.Builder.getInt8(1), Destroy);
+  CGF.EmitBlock(Destroy);
+  CGF.EmitBranchThroughCleanup(Data.Destroy);
+  CGF.EmitBlock(Ready);
+  if (!Final)
+    for (Address Slot : Data.AutoreleasePools)
+      CGF.Builder.CreateStore(CGF.EmitObjCAutoreleasePoolPush(), Slot);
+  if (Final) {
+    CGF.Builder.CreateUnreachable();
+    CGF.Builder.ClearInsertionPoint();
+  }
+}
+void cancel(CodeGenFunction &CGF, CGObjC3CAsyncData &Data) {
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(2), Data.Kind);
+  CGF.EmitBranchThroughCleanup(Data.Final);
+}
+void checkCancelled(CodeGenFunction &CGF, CGObjC3CAsyncData &Data) {
+  auto *Requested = call(CGF, "objc3_task_is_cancel_requested", CGF.Int32Ty,
+                          {CGF.Builder.CreateLoad(Data.Owner)});
+  auto *Cancelled = CGF.createBasicBlock("objc3.await.cancelled");
+  auto *Continue = CGF.createBasicBlock("objc3.await.continue");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateIsNotNull(Requested), Cancelled, Continue);
+  CGF.EmitBlock(Cancelled);
+  cancel(CGF, Data);
+  CGF.EmitBlock(Continue);
+}
+llvm::Value *serviceError(CodeGenFunction &CGF, llvm::Value *Status) {
+  Address Error = CGF.CreateTempAlloca(CGF.Int8PtrTy,
+      CharUnits::fromQuantity(8), "objc3.service.error");
+  CGF.Builder.CreateStore(nullPtr(CGF), Error);
+  auto *Created = call(CGF, "objc3_async_error_create_service", CGF.Int32Ty,
+                       {Status, Error.emitRawPointer(CGF)});
+  auto *Owner = CGF.Builder.CreateLoad(Error);
+  auto *Ready = CGF.createBasicBlock("objc3.service.error.ready");
+  auto *Invalid = CGF.createBasicBlock("objc3.service.error.invalid");
+  auto *Valid = CGF.Builder.CreateAnd(CGF.Builder.CreateIsNull(Created),
+                                     CGF.Builder.CreateIsNotNull(Owner));
+  CGF.Builder.CreateCondBr(Valid, Ready, Invalid);
+  CGF.EmitBlock(Invalid);
+  // Bounded runtime statuses have allocation-independent owned error values.
+  // A violated runtime/compiler contract is fatal, never a false cancellation.
+  CGF.EmitTrapCall(llvm::Intrinsic::trap);
+  CGF.Builder.CreateUnreachable();
+  CGF.Builder.ClearInsertionPoint();
+  CGF.EmitBlock(Ready);
+  return Owner;
+}
+void replaceError(CodeGenFunction &CGF, CGObjC3CAsyncData &Data,
+                    llvm::Value *Error) {
+  auto *Previous = CGF.Builder.CreateLoad(Data.Error);
+  CGF.Builder.CreateStore(Error, Data.Error);
+  call(CGF, "objc3_error_release", CGF.VoidTy, {Previous});
+}
+void checkStatus(CodeGenFunction &CGF, CGObjC3CAsyncData &Data,
+                  llvm::Value *Status) {
+  auto *Failed = CGF.createBasicBlock("objc3.async.service.failed");
+  auto *Cancelled = CGF.createBasicBlock("objc3.async.service.cancelled");
+  auto *Continue = CGF.createBasicBlock("objc3.async.service.ok");
+  auto *Switch = CGF.Builder.CreateSwitch(Status, Failed, 2);
+  Switch->addCase(CGF.Builder.getInt32(0), Continue);
+  Switch->addCase(CGF.Builder.getInt32(7), Cancelled);
+  CGF.EmitBlock(Cancelled);
+  cancel(CGF, Data);
+  CGF.EmitBlock(Failed);
+  replaceError(CGF, Data, serviceError(CGF, Status));
+  CGF.Builder.CreateStore(CGF.Builder.getInt32(1), Data.Kind);
+  CGF.EmitBranchThroughCleanup(Data.Final);
+  CGF.EmitBlock(Continue);
+}
+
+// An allocation failure is still a typed lazy task, with process-lifetime
+// context and callbacks. Starting or awaiting it reports the original service
+// status; abandoning it needs neither an allocation nor a source-body cleanup.
+llvm::Function *allocationFailureCallback(CodeGenFunction &Parent, bool Destroy) {
+  auto &CGM = Parent.CGM;
+  auto &Ctx = CGM.getContext();
+  FunctionArgList Args;
+  for (unsigned I = 0; I != (Destroy ? 1u : 2u); ++I)
+    Args.push_back(ImplicitParamDecl::Create(
+        Ctx, Ctx.VoidPtrTy, ImplicitParamKind::Other));
+  const auto &FI = CGM.getTypes().arrangeBuiltinFunctionDeclaration(Ctx.VoidTy, Args);
+  auto *F = llvm::Function::Create(CGM.getTypes().GetFunctionType(FI),
+      llvm::GlobalValue::InternalLinkage,
+      Destroy ? "__objc3_c_async_allocation_failed_destroy"
+              : "__objc3_c_async_allocation_failed_resume", &CGM.getModule());
+  CGM.SetInternalFunctionAttributes(GlobalDecl(), F, FI);
+  CodeGenFunction CGF(CGM);
+  CGF.StartFunction(GlobalDecl(), Ctx.VoidTy, F, FI, Args);
+  if (!Destroy) {
+    llvm::Value *Owner = CGF.Builder.CreateLoad(CGF.GetAddrOfLocalVar(Args[0]));
+    llvm::Value *Requested = call(CGF, "objc3_task_is_cancel_requested",
+                                  CGF.Int32Ty, {Owner});
+    llvm::Value *Cancelled = CGF.Builder.CreateIsNotNull(Requested);
+    llvm::Value *Error = serviceError(CGF, CGF.Builder.getInt32(3));
+    Address Completion = CGF.CreateTempAlloca(completionType(CGM),
+        CharUnits::fromQuantity(8), "objc3.allocation.failure");
+    CGF.Builder.CreateMemSet(Completion, CGF.Builder.getInt8(0),
+                             CGF.Builder.getInt64(48));
+    storeField(CGF, Completion, 0, CGF.Builder.getInt32(48));
+    storeField(CGF, Completion, 1, CGF.Builder.getInt32(ServiceABI));
+    storeField(CGF, Completion, 2, CGF.Builder.CreateSelect(
+        Cancelled, CGF.Builder.getInt32(2), CGF.Builder.getInt32(1)));
+    storeField(CGF, Completion, 6,
+               CGF.Builder.CreateSelect(Cancelled, nullPtr(CGF), Error));
+    llvm::Value *Status = call(CGF, "objc3_task_complete", CGF.Int32Ty,
+                                {Owner, Completion.emitRawPointer(CGF)});
+    call(CGF, "objc3_error_release", CGF.VoidTy, {Error});
+    llvm::Value *Accepted = CGF.Builder.CreateOr(CGF.Builder.CreateIsNull(Status),
+        CGF.Builder.CreateICmpEQ(Status, CGF.Builder.getInt32(4)));
+    auto *Done = CGF.createBasicBlock("objc3.allocation.failure.completed");
+    auto *Invalid = CGF.createBasicBlock("objc3.allocation.failure.invalid");
+    CGF.Builder.CreateCondBr(Accepted, Done, Invalid);
+    CGF.EmitBlock(Invalid);
+    CGF.EmitTrapCall(llvm::Intrinsic::trap);
+    CGF.Builder.CreateUnreachable();
+    CGF.Builder.ClearInsertionPoint();
+    CGF.EmitBlock(Done);
+  }
+  CGF.FinishFunction();
+  F->setDoesNotThrow();
+  return F;
+}
+
+// Runtime callback owns no task reference. The scheduler serializes callbacks
+// and destroys the handle after terminal completion and resume return.
+llvm::Function *frameCallback(CodeGenFunction &Parent, bool Destroy) {
+  auto &CGM = Parent.CGM;
+  auto &Ctx = CGM.getContext();
+  FunctionArgList Args;
+  for (unsigned I = 0; I != (Destroy ? 1u : 2u); ++I)
+    Args.push_back(ImplicitParamDecl::Create(
+        Ctx, Ctx.VoidPtrTy, ImplicitParamKind::Other));
+  const auto &FI = CGM.getTypes().arrangeBuiltinFunctionDeclaration(Ctx.VoidTy, Args);
+  auto *F = llvm::Function::Create(CGM.getTypes().GetFunctionType(FI),
+      llvm::GlobalValue::InternalLinkage,
+      Destroy ? "__objc3_c_async_destroy" : "__objc3_c_async_resume", &CGM.getModule());
+  CGM.SetInternalFunctionAttributes(GlobalDecl(), F, FI);
+  CodeGenFunction CGF(CGM);
+  CGF.StartFunction(GlobalDecl(), Ctx.VoidTy, F, FI, Args);
+  llvm::Value *Frame = CGF.Builder.CreateLoad(
+      CGF.GetAddrOfLocalVar(Args[Destroy ? 0 : 1]));
+  llvm::Value *Owner = nullptr;
+  if (!Destroy) {
+    Owner = CGF.Builder.CreateLoad(CGF.GetAddrOfLocalVar(Args[0]));
+    auto *Promise = CGF.Builder.CreateCall(
+        CGM.getIntrinsic(llvm::Intrinsic::coro_promise),
+        {Frame, CGF.Builder.getInt32(8), CGF.Builder.getFalse()});
+    CGF.Builder.CreateStore(Owner,
+        Address(Promise, CGF.Int8PtrTy, CharUnits::fromQuantity(8)));
+  }
+  llvm::BasicBlock *Catch = nullptr;
+  if (CGF.getLangOpts().ObjCExceptions) {
+    Catch = CGF.createBasicBlock("objc3.callback.exception");
+    CGF.EHStack.pushCatch(1)->setHandler(
+        0, CGM.getObjCRuntime().getCatchAllTypeInfo(), Catch);
+  }
+  CGF.EmitRuntimeCallOrInvoke(
+      CGM.getIntrinsic(Destroy ? llvm::Intrinsic::coro_destroy
+                               : llvm::Intrinsic::coro_resume), {Frame});
+  if (Catch) {
+    CGF.popCatchScope();
+    CGF.EmitBranchThroughCleanup(CGF.ReturnBlock);
+    CGF.EmitBlock(Catch);
+    call(CGF, "objc_begin_catch", CGF.Int8PtrTy, {CGF.getExceptionFromSlot()});
+    call(CGF, "objc_end_catch", CGF.VoidTy, {});
+    if (!Destroy) {
+      Address Completion = CGF.CreateTempAlloca(completionType(CGM),
+          CharUnits::fromQuantity(8), "objc3.callback.cancelled");
+      CGF.Builder.CreateMemSet(Completion, CGF.Builder.getInt8(0), CGF.Builder.getInt64(48));
+      storeField(CGF, Completion, 0, CGF.Builder.getInt32(48));
+      storeField(CGF, Completion, 1, CGF.Builder.getInt32(ServiceABI));
+      storeField(CGF, Completion, 2, CGF.Builder.getInt32(2));
+      call(CGF, "objc3_task_complete", CGF.Int32Ty,
+           {Owner, Completion.emitRawPointer(CGF)});
+    }
+    CGF.EmitBranchThroughCleanup(CGF.ReturnBlock);
+  }
+  CGF.FinishFunction();
+  F->setDoesNotThrow();
+  return F;
+}
+} // namespace
+
+void clang::CodeGen::drainObjC3AsyncAutoreleasePools(
+    CodeGenFunction &CGF, llvm::ArrayRef<Address> Pools) {
+  for (Address Slot : llvm::reverse(Pools))
+    closeAutoreleasePool(CGF, Slot);
+}
+
+void clang::CodeGen::reopenObjC3AsyncAutoreleasePools(
+    CodeGenFunction &CGF, llvm::ArrayRef<Address> Pools) {
+  for (Address Slot : Pools) {
+    auto *Closed = CGF.createBasicBlock("objc3.pool.reopen");
+    auto *Ready = CGF.createBasicBlock("objc3.pool.ready");
+    CGF.Builder.CreateCondBr(
+        CGF.Builder.CreateIsNull(CGF.Builder.CreateLoad(Slot)), Closed, Ready);
+    CGF.EmitBlock(Closed);
+    CGF.Builder.CreateStore(CGF.EmitObjCAutoreleasePoolPush(), Slot);
+    CGF.EmitBranch(Ready);
+    CGF.EmitBlock(Ready);
+  }
+}
+
+namespace {
+struct ReopenAutoreleasePools final : EHScopeStack::Cleanup {
+  size_t Count;
+  Address *slots() { return reinterpret_cast<Address *>(this + 1); }
+  static size_t getExtraSize(size_t Count) { return Count * sizeof(Address); }
+  ReopenAutoreleasePools(size_t Count, llvm::ArrayRef<Address> Pools)
+      : Count(Count) {
+    assert(Count == Pools.size());
+    for (size_t I = 0; I != Count; ++I)
+      new (slots() + I) Address(Pools[I]);
+  }
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    reopenObjC3AsyncAutoreleasePools(CGF, {slots(), Count});
+  }
+};
+} // namespace
+
+void clang::CodeGen::pushObjC3AsyncPoolReopenCleanup(
+    CodeGenFunction &CGF, llvm::ArrayRef<Address> Pools) {
+  CGF.EHStack.pushCleanupWithExtra<ReopenAutoreleasePools>(EHCleanup,
+                                                        Pools.size(), Pools);
+}
+
+void CodeGenFunction::EmitObjC3CAsyncBody(const Decl &Callable,
+                                           const Stmt &Body) {
+  ObjC3CAsync.Data = std::make_unique<CGObjC3CAsyncData>();
+  auto &Data = *ObjC3CAsync.Data;
+  const auto *Function = getObjC3CallableFunctionType(&Callable);
+  Data.LogicalResult = resultStorageType(getContext(), Function->getReturnType());
+  ShouldEmitLifetimeMarkers = true;
+  Data.Owner = CreateTempAlloca(Int8PtrTy, CharUnits::fromQuantity(8), "objc3.task.owner");
+  Data.Error = CreateTempAlloca(Int8PtrTy, CharUnits::fromQuantity(8), "objc3.task.error");
+  Data.Kind = CreateTempAlloca(Int32Ty, CharUnits::fromQuantity(4), "objc3.task.kind");
+  if (Callable.hasAttr<ObjCTaskGroupAttr>())
+    Data.ScopeEntered = CreateTempAlloca(Builder.getInt1Ty(), CharUnits::One(),
+                                         "objc3.scope.entered");
+  Data.ResultLive = CreateTempAlloca(Builder.getInt1Ty(), CharUnits::One(), "objc3.result.live");
+  if (!Data.LogicalResult->isVoidType())
+    Data.Result = CreateMemTemp(Data.LogicalResult, "objc3.task.result");
+  Data.ResultType = resultDescriptor(*this, Data.LogicalResult);
+  Data.Suspend = createBasicBlock("objc3.coro.suspend");
+  auto *Free = createBasicBlock("objc3.coro.free");
+  auto *Final = createBasicBlock("objc3.coro.final");
+  auto *Allocate = createBasicBlock("objc3.coro.allocate");
+  auto *Initialize = createBasicBlock("objc3.coro.initialize");
+  auto *Failure = createBasicBlock("objc3.coro.allocation.failed");
+  auto *Entry = Builder.GetInsertBlock();
+  Data.Id = Builder.CreateCall(CGM.getIntrinsic(llvm::Intrinsic::coro_id),
+      {Builder.getInt32(16), Data.Owner.emitRawPointer(*this), nullPtr(*this), nullPtr(*this)});
+  auto *NeedsAllocation = Builder.CreateCall(
+      CGM.getIntrinsic(llvm::Intrinsic::coro_alloc), {Data.Id});
+  Builder.CreateCondBr(NeedsAllocation, Allocate, Initialize);
+  EmitBlock(Allocate);
+  auto *Size = Builder.CreateCall(CGM.getIntrinsic(llvm::Intrinsic::coro_size, {SizeTy}));
+  auto *Alignment = Builder.CreateCall(CGM.getIntrinsic(llvm::Intrinsic::coro_align, {SizeTy}));
+  auto *Rounded = Builder.CreateAnd(
+      Builder.CreateAdd(Size, Builder.CreateSub(Alignment, llvm::ConstantInt::get(SizeTy, 1))),
+      Builder.CreateNeg(Alignment));
+  auto *Memory = call(*this, "aligned_alloc", Int8PtrTy, {Alignment, Rounded});
+  auto *Allocated = Builder.GetInsertBlock();
+  Builder.CreateCondBr(Builder.CreateIsNotNull(Memory), Initialize, Failure);
+  EmitBlock(Failure);
+  storeField(*this, ReturnValue, 0, Builder.getInt32(40));
+  storeField(*this, ReturnValue, 1, Builder.getInt32(AsyncABI));
+  // A descriptor is static, nonnull and shared safely by these immutable
+  // failure frames. No callback mutates or releases this context.
+  storeField(*this, ReturnValue, 2, Data.ResultType);
+  storeField(*this, ReturnValue, 3, allocationFailureCallback(*this, false));
+  storeField(*this, ReturnValue, 4, allocationFailureCallback(*this, true));
+  storeField(*this, ReturnValue, 5, Data.ResultType);
+  EmitBranchThroughCleanup(ReturnBlock);
+  EmitBlock(Initialize);
+  auto *Storage = Builder.CreatePHI(Int8PtrTy, 2);
+  Storage->addIncoming(nullPtr(*this), Entry);
+  Storage->addIncoming(Memory, Allocated);
+  Data.Frame = Builder.CreateCall(CGM.getIntrinsic(llvm::Intrinsic::coro_begin),
+                                   {Data.Id, Storage});
+  {
+    RunCleanupsScope FrameScope(*this);
+    EHStack.pushCleanup<FreeFrame>(NormalAndEHCleanup, Data.Id, Data.Frame);
+    Builder.CreateStore(nullPtr(*this), Data.Owner);
+    Builder.CreateStore(nullPtr(*this), Data.Error);
+    Builder.CreateStore(Builder.getInt32(0), Data.Kind);
+    Builder.CreateStore(Builder.getFalse(), Data.ResultLive);
+    if (Data.ScopeEntered.isValid())
+      Builder.CreateStore(Builder.getFalse(), Data.ScopeEntered);
+    Data.ResultOps = valueOps(*this, Data.LogicalResult);
+    EHStack.pushCleanup<DestroyResult>(NormalAndEHCleanup, Data.Result,
+        Data.ResultLive, Data.Error, Data.ResultOps);
+
+    // A separate copy belongs to the lazy frame. Original ABI parameter slots
+    // and their ARC cleanups stay in the ramp. Isolation thunks own transferred
+    // retainable arguments in both memory modes before the first suspension;
+    // ordinary MRC async parameter borrowing keeps its source contract.
+    SmallVector<const VarDecl *, 8> Parameters;
+    const auto *Method = dyn_cast<ObjCMethodDecl>(&Callable);
+    if (const auto *FD = dyn_cast<FunctionDecl>(&Callable))
+      llvm::append_range(Parameters, FD->parameters());
+    else if (Method) {
+      Parameters.push_back(Method->getSelfDecl());
+      // Direct prologues synthesize _cmd only when source references it.
+      if (LocalDeclMap.count(Method->getCmdDecl()))
+        Parameters.push_back(Method->getCmdDecl());
+      llvm::append_range(Parameters, Method->parameters());
+    } else if (const auto *Block = dyn_cast<BlockDecl>(&Callable)) {
+      // The caller may discard its original stack Block as soon as this ramp
+      // returns. This copy roots all captures and __block forwarding before
+      // initial suspension, under ARC and MRC alike.
+      BlockPointer = EmitARCRetainBlock(BlockPointer, true);
+      if (ObjC3AsyncBlockDebugAddress.isValid())
+        Builder.CreateStore(BlockPointer, ObjC3AsyncBlockDebugAddress);
+      EHStack.pushCleanup<ReleaseCapture>(NormalAndEHCleanup, BlockPointer);
+      llvm::append_range(Parameters, Block->parameters());
+    }
+    SmallVector<std::pair<const VarDecl *, Address>, 8> Originals;
+    for (const VarDecl *P : Parameters) {
+      QualType T = P->getType();
+      Address Original = GetAddrOfLocalVar(P);
+      if (auto *Alloca = dyn_cast<llvm::AllocaInst>(Original.getBasePointer()))
+        Alloca->setMetadata(llvm::LLVMContext::MD_coro_outside_frame,
+                            llvm::MDNode::get(getLLVMContext(), {}));
+      Address Copy = CreateMemTemp(T, Twine(P->getName()) + ".async.capture");
+      Originals.push_back({P, Original});
+      auto *Reference = DeclRefExpr::Create(getContext(), NestedNameSpecifierLoc(),
+          SourceLocation(), const_cast<VarDecl *>(P), false,
+          P->getLocation(), T, VK_LValue);
+      auto *Synthetic = VarDecl::Create(getContext(),
+          const_cast<VarDecl *>(P)->getDeclContext(), P->getLocation(), P->getLocation(),
+          nullptr, T, getContext().getTrivialTypeSourceInfo(T), SC_None);
+      Expr *Initializer = Reference;
+      if (getEvaluationKind(T) != TEK_Aggregate)
+        Initializer = ImplicitCastExpr::Create(getContext(), T,
+            CK_LValueToRValue, Reference, nullptr, VK_PRValue, FPOptionsOverride());
+      bool Receiver = Method && P == Method->getSelfDecl();
+      bool TransferredReference = Callable.hasAttr<ObjC3IsolationThunkAttr>() &&
+          (T->isObjCObjectPointerType() || T->isBlockPointerType());
+      if (Receiver || TransferredReference) {
+        auto *Value = EmitLoadOfScalar(MakeAddrLValue(Original, T), P->getLocation());
+        auto *Owned = T->isBlockPointerType() ? EmitARCRetainBlock(Value, true)
+                                             : EmitARCRetainNonBlock(Value);
+        EmitStoreOfScalar(Owned, MakeAddrLValue(Copy, T), true);
+        EHStack.pushCleanup<ReleaseCapture>(NormalAndEHCleanup, Owned);
+      } else if (hasCxxFrameStorage(*this, T)) {
+        // Construct an independent owner from the ABI value parameter. Native
+        // construction failure unwinds the ramp and already-built captures;
+        // the source body and initial suspension have not executed yet.
+        cxxFrameStorageCall(*this, T, "__objc3_async_frame_capture",
+            {Copy.emitRawPointer(*this), Original.emitRawPointer(*this)});
+      } else {
+        EmitExprAsInit(Initializer, Synthetic, MakeAddrLValue(Copy, T), false);
+      }
+      LocalDeclMap.find(P)->second = Copy;
+      if (Receiver || TransferredReference) {
+        // Dedicated owners cover MRC transfers and pseudo-strong self, too.
+      } else if (containsObjC3CarrierManagedStorage(T))
+        pushDestroy(NormalAndEHCleanup, Copy, T, destroyObjC3ManagedStorage, false);
+      else if (auto DK = T.isDestructedType(); DK != QualType::DK_none)
+        pushDestroy(NormalAndEHCleanup, Copy, T, getDestroyer(DK), false);
+    }
+    if (isObjC3AsyncThrowingFunction(*this))
+      emitObjC3PendingErrorProlog(*this);
+    // Destroy source scopes on the way to Free; the frame scope itself owns
+    // these captures and destroys them once when Free forces its cleanups.
+    Data.Destroy = getJumpDestInCurrentScope(Free);
+    Data.Final = getJumpDestInCurrentScope(Final);
+
+    storeField(*this, ReturnValue, 0, Builder.getInt32(40));
+    storeField(*this, ReturnValue, 1, Builder.getInt32(AsyncABI));
+    storeField(*this, ReturnValue, 2, Data.Frame);
+    storeField(*this, ReturnValue, 3, frameCallback(*this, false));
+    storeField(*this, ReturnValue, 4, frameCallback(*this, true));
+    storeField(*this, ReturnValue, 5, Data.ResultType);
+    suspend(*this, Data, false);
+    if (Data.ScopeEntered.isValid()) {
+      auto *Status = call(*this, "objc3_task_group_scope_enter", Int32Ty,
+                           {Builder.CreateLoad(Data.Owner)});
+      Builder.CreateStore(Builder.CreateIsNull(Status), Data.ScopeEntered);
+      checkStatus(*this, Data, Status);
+    }
+    checkCancelled(*this, Data);
+    if (Callable.hasAttr<ObjC3IsolationThunkAttr>()) {
+      auto Entry = emitObjC3IsolationEntry(*this, Callable,
+                                          Builder.CreateLoad(Data.Owner));
+      checkStatus(*this, Data, Entry.Status);
+      auto *Hop = createBasicBlock("objc3.isolation.hop");
+      auto *Entered = createBasicBlock("objc3.isolation.entered");
+      Builder.CreateCondBr(Entry.Suspend, Hop, Entered);
+      EmitBlock(Hop);
+      suspend(*this, Data, false);
+      checkCancelled(*this, Data);
+      EmitBranch(Entered);
+      EmitBlock(Entered);
+    }
+
+    // A native exception may be handled by a source @catch. An exception that
+    // escapes the async body has no checked-error conversion and cannot cross
+    // the C resume callback; match the existing foreign-exception cancellation
+    // channel, running all native unwind cleanup first.
+    if (getLangOpts().ObjCExceptions) {
+      auto Loc = Body.getBeginLoc();
+      auto *Return = ReturnStmt::Create(getContext(), Loc, nullptr, nullptr);
+      Data.ExceptionReturn = Return;
+      auto *CatchBody = CompoundStmt::Create(getContext(), Return,
+                                              FPOptionsOverride(), Loc, Loc);
+      Stmt *Catch = new (getContext()) ObjCAtCatchStmt(Loc, Loc, nullptr, CatchBody);
+      auto *Try = ObjCAtTryStmt::Create(getContext(), Loc,
+          const_cast<Stmt *>(&Body), &Catch, 1, nullptr);
+      EmitObjCAtTryStmt(*Try);
+    } else {
+      EmitStmt(&Body);
+    }
+    if (HaveInsertPoint()) {
+      if (!Data.LogicalResult->isVoidType())
+        Builder.CreateStore(Builder.getInt32(2), Data.Kind);
+      EmitBranchThroughCleanup(Data.Final);
+    }
+    EmitBlock(Final);
+    if (Data.ScopeEntered.isValid()) {
+      auto *Join = createBasicBlock("objc3.scope.join");
+      auto *Joined = createBasicBlock("objc3.scope.joined");
+      Builder.CreateCondBr(Builder.CreateLoad(Data.ScopeEntered), Join, Joined);
+      EmitBlock(Join);
+      Address JoinStatus = CreateTempAlloca(Int32Ty, CharUnits::fromQuantity(4),
+                                            "objc3.scope.status");
+      Builder.CreateStore(Builder.getInt32(5), JoinStatus);
+      auto *Owner = Builder.CreateLoad(Data.Owner);
+      auto *Cancel = Builder.CreateOr(
+          Builder.CreateICmpNE(Builder.CreateLoad(Data.Kind), Builder.getInt32(0)),
+          Builder.CreateIsNotNull(call(*this, "objc3_task_is_cancel_requested",
+                                         Int32Ty, {Owner})));
+      auto *Status = call(*this, "objc3_task_group_scope_finish", Int32Ty,
+          {Owner, Builder.CreateZExt(Cancel, Int32Ty),
+           JoinStatus.emitRawPointer(*this)});
+      auto *Wait = createBasicBlock("objc3.scope.wait");
+      auto *NotRegistered = createBasicBlock("objc3.scope.registration.failed");
+      Builder.CreateCondBr(Builder.CreateIsNull(Status), Wait, NotRegistered);
+      EmitBlock(NotRegistered);
+      // A forced scope cleanup may already have completed this active task.
+      // Every other failure violates the compiler/runtime reservation contract;
+      // never publish success or destroy live scope work on that path.
+      auto *Invalid = createBasicBlock("objc3.scope.invalid");
+      Builder.CreateCondBr(Builder.CreateICmpEQ(Status, Builder.getInt32(4)),
+                            Joined, Invalid);
+      EmitBlock(Invalid);
+      EmitTrapCall(llvm::Intrinsic::trap);
+      Builder.CreateUnreachable();
+      Builder.ClearInsertionPoint();
+      EmitBlock(Wait);
+      suspend(*this, Data, false);
+      auto *Failed = createBasicBlock("objc3.scope.cleanup.failed");
+      auto *Finished = createBasicBlock("objc3.scope.cleanup.finished");
+      Builder.CreateCondBr(Builder.CreateIsNotNull(Builder.CreateLoad(JoinStatus)),
+                            Failed, Finished);
+      EmitBlock(Failed);
+      replaceError(*this, Data, serviceError(*this, Builder.CreateLoad(JoinStatus)));
+      Builder.CreateStore(Builder.getInt32(1), Data.Kind);
+      EmitBranch(Finished);
+      EmitBlock(Finished);
+      auto *Cancelled = call(*this, "objc3_task_is_cancel_requested", Int32Ty,
+                               {Builder.CreateLoad(Data.Owner)});
+      Builder.CreateStore(Builder.CreateSelect(Builder.CreateIsNotNull(Cancelled),
+          Builder.getInt32(2), Builder.CreateLoad(Data.Kind)), Data.Kind);
+      EmitBranch(Joined);
+      EmitBlock(Joined);
+    }
+    Address Completion = CreateTempAlloca(completionType(CGM),
+        CharUnits::fromQuantity(8), "objc3.completion");
+    Builder.CreateMemSet(Completion, Builder.getInt8(0), Builder.getInt64(48));
+    storeField(*this, Completion, 0, Builder.getInt32(48));
+    storeField(*this, Completion, 1, Builder.getInt32(ServiceABI));
+    auto *Kind = Builder.CreateLoad(Data.Kind);
+    storeField(*this, Completion, 2, Kind);
+    auto *Success = createBasicBlock("objc3.complete.success");
+    auto *Error = createBasicBlock("objc3.complete.error");
+    auto *Publish = createBasicBlock("objc3.complete.publish");
+    auto *Switch = Builder.CreateSwitch(Kind, Publish, 2);
+    Switch->addCase(Builder.getInt32(0), Success);
+    Switch->addCase(Builder.getInt32(1), Error);
+    EmitBlock(Success);
+    storeField(*this, Completion, 7, Data.ResultType);
+    if (Data.Result.isValid()) {
+      storeField(*this, Completion, 3, Builder.getInt32(1));
+      storeField(*this, Completion, 4, Data.Result.emitRawPointer(*this));
+      storeField(*this, Completion, 5, Data.ResultOps);
+    }
+    EmitBranch(Publish);
+    EmitBlock(Error);
+    storeField(*this, Completion, 6, Builder.CreateLoad(Data.Error));
+    EmitBranch(Publish);
+    EmitBlock(Publish);
+    auto *Status = call(*this, "objc3_task_complete", Int32Ty,
+        {Builder.CreateLoad(Data.Owner), Completion.emitRawPointer(*this)});
+    auto *Fallback = createBasicBlock("objc3.complete.copy.failed");
+    auto *Completed = createBasicBlock("objc3.complete.done");
+    auto *Accepted = Builder.CreateOr(Builder.CreateICmpEQ(Status, Builder.getInt32(0)),
+                                      Builder.CreateICmpEQ(Status, Builder.getInt32(4)));
+    Builder.CreateCondBr(Accepted, Completed, Fallback);
+    EmitBlock(Fallback);
+    Builder.CreateMemSet(Completion, Builder.getInt8(0), Builder.getInt64(48));
+    storeField(*this, Completion, 0, Builder.getInt32(48));
+    storeField(*this, Completion, 1, Builder.getInt32(ServiceABI));
+    auto *CancelledCopy = createBasicBlock("objc3.complete.copy.cancelled");
+    auto *ServiceFailure = createBasicBlock("objc3.complete.copy.service.error");
+    auto *PublishFailure = createBasicBlock("objc3.complete.failure.publish");
+    Builder.CreateCondBr(Builder.CreateICmpEQ(Status, Builder.getInt32(7)),
+                         CancelledCopy, ServiceFailure);
+    EmitBlock(CancelledCopy);
+    storeField(*this, Completion, 2, Builder.getInt32(2));
+    EmitBranch(PublishFailure);
+    EmitBlock(ServiceFailure);
+    // Preserve copy/publication service failures as failures. Static service
+    // error owners cannot be confused with checked Objective-C errors.
+    replaceError(*this, Data, serviceError(*this, Status));
+    storeField(*this, Completion, 2, Builder.getInt32(1));
+    storeField(*this, Completion, 6, Builder.CreateLoad(Data.Error));
+    EmitBranch(PublishFailure);
+    EmitBlock(PublishFailure);
+    auto *FailureStatus = call(*this, "objc3_task_complete", Int32Ty,
+         {Builder.CreateLoad(Data.Owner), Completion.emitRawPointer(*this)});
+    auto *FailureAccepted = Builder.CreateOr(
+        Builder.CreateIsNull(FailureStatus),
+        Builder.CreateICmpEQ(FailureStatus, Builder.getInt32(4)));
+    auto *InvalidCompletion = createBasicBlock("objc3.complete.invalid");
+    Builder.CreateCondBr(FailureAccepted, Completed, InvalidCompletion);
+    EmitBlock(InvalidCompletion);
+    EmitTrapCall(llvm::Intrinsic::trap);
+    Builder.CreateUnreachable();
+    Builder.ClearInsertionPoint();
+    EmitBlock(Completed);
+    suspend(*this, Data, true);
+    EmitBlock(Free);
+    FrameScope.ForceCleanup();
+    for (auto [P, SavedAddress] : Originals)
+      LocalDeclMap.find(P)->second = SavedAddress;
+  }
+  EmitBranch(Data.Suspend);
+  EmitBlock(Data.Suspend);
+  Builder.CreateCall(CGM.getIntrinsic(llvm::Intrinsic::coro_end),
+      {nullPtr(*this), Builder.getFalse(),
+       llvm::ConstantTokenNone::get(getLLVMContext())});
+  EmitBranchThroughCleanup(ReturnBlock);
+  CurFn->setPresplitCoroutine();
+}
+
+void CodeGenFunction::EmitObjC3CAsyncAutoreleasePoolStmt(
+    const ObjCAutoreleasePoolStmt &Statement) {
+  auto &Pools = ObjC3CAsync.Data ? ObjC3CAsync.Data->AutoreleasePools
+                                 : *getObjC3CxxAutoreleasePools(*this);
+  const auto &Body = cast<CompoundStmt>(*Statement.getSubStmt());
+  if (auto *DI = getDebugInfo())
+    DI->EmitLexicalBlockStart(Builder, Body.getLBracLoc());
+  RunCleanupsScope Scope(*this);
+  Address Token = CreateTempAlloca(Int8PtrTy, getPointerAlign(),
+                                    "objc3.pool.token");
+  Builder.CreateStore(EmitObjCAutoreleasePoolPush(), Token);
+  Pools.push_back(Token);
+  EHStack.pushCleanup<CloseAutoreleasePool>(NormalAndEHCleanup, Token);
+  for (const Stmt *Child : Body.body())
+    EmitStmt(Child);
+  Scope.ForceCleanup();
+  Pools.pop_back();
+  if (auto *DI = getDebugInfo())
+    DI->EmitLexicalBlockEnd(Builder, Body.getRBracLoc());
+}
+
+void CodeGenFunction::EmitObjC3CAsyncReturn(const ReturnStmt &S) {
+  auto &Data = *ObjC3CAsync.Data;
+  if (&S == Data.ExceptionReturn) {
+    cancel(*this, Data);
+    return;
+  }
+  RunCleanupsScope ExpressionScope(*this);
+  const Expr *E = S.getRetValue();
+  if (Data.LogicalResult->isVoidType()) {
+    if (E) EmitIgnoredExpr(E);
+  } else if (E) {
+    Address Source = CreateMemTemp(Data.LogicalResult, "objc3.return.source");
+    const auto *Thunk = CurCodeDecl->getAttr<ObjC3IsolationThunkAttr>();
+    bool OwnedReference = Data.LogicalResult->isObjCRetainableType() &&
+        (getLangOpts().ObjCAutoRefCount || (Thunk && Thunk->getOwnedResult()));
+    if (OwnedReference) {
+      // ARC claims a natural +1 or retains/copies a +0 expression independently
+      // of lexical/full-expression owners. An MRC isolation thunk instead
+      // adopts exactly the original synchronous declaration's +1 result.
+      // Unsafe source storage has this explicit owner until resultOps copies;
+      // success, service failure and native exception edges all balance it.
+      llvm::Value *Owned = getLangOpts().ObjCAutoRefCount
+                               ? EmitARCRetainScalarExpr(E) : EmitScalarExpr(E);
+      EHStack.pushCleanup<ReleaseCapture>(NormalAndEHCleanup, Owned);
+      EmitStoreOfScalar(Owned, MakeAddrLValue(Source, Data.LogicalResult), true);
+    } else if (getEvaluationKind(Data.LogicalResult) == TEK_Scalar) {
+      EmitStoreOfScalar(EmitScalarExpr(E),
+          MakeAddrLValue(Source, Data.LogicalResult), true);
+    } else if (getLangOpts().ObjCAutoRefCount &&
+               containsObjC3CarrierManagedStorage(Data.LogicalResult)) {
+      // A native frame stages a complete independent owner before any return
+      // cleanup or scope suspension. Grant the same destination/initialization
+      // guard used by qualified ARC locals, arguments and ordinary returns.
+      emitObjC3CarrierARCValueInit(*this, E, Source);
+    } else {
+      EmitAnyExprToMem(E, Source, Qualifiers(), true);
+    }
+    if (containsObjC3CarrierManagedStorage(Data.LogicalResult))
+      pushDestroy(NormalAndEHCleanup, Source, Data.LogicalResult,
+                   destroyObjC3ManagedStorage, false);
+    else if (auto DK = Data.LogicalResult.isDestructedType(); DK != QualType::DK_none)
+      pushDestroy(NormalAndEHCleanup, Source, Data.LogicalResult,
+                   getDestroyer(DK), false);
+    auto *Replace = createBasicBlock("objc3.return.replace");
+    auto *Initialize = createBasicBlock("objc3.return.initialize");
+    Builder.CreateCondBr(Builder.CreateLoad(Data.ResultLive), Replace, Initialize);
+    EmitBlock(Replace);
+    Builder.CreateStore(Builder.getFalse(), Data.ResultLive);
+    invokeOp(*this, Data.ResultOps, 6, {Data.Result.emitRawPointer(*this)});
+    EmitBranch(Initialize);
+    EmitBlock(Initialize);
+    auto *Status = invokeOp(*this, Data.ResultOps, 4,
+              {Data.Result.emitRawPointer(*this), Source.emitRawPointer(*this)});
+    checkStatus(*this, Data, Status);
+    Builder.CreateStore(Builder.getTrue(), Data.ResultLive);
+  } else {
+    cancel(*this, Data);
+    return;
+  }
+  Builder.CreateStore(Builder.getInt32(0), Data.Kind);
+  EmitBranchThroughCleanup(Data.Final);
+}
+
+bool CodeGenFunction::EmitObjC3CAsyncErrorReturn(llvm::Value *OwnedError) {
+  auto &Data = *ObjC3CAsync.Data;
+  auto *Error = call(*this, "__objc3_task_error_create", Int8PtrTy, {OwnedError});
+  auto *Ready = createBasicBlock("objc3.error.materialized");
+  auto *Invalid = createBasicBlock("objc3.error.materialization.invalid");
+  Builder.CreateCondBr(Builder.CreateIsNotNull(Error), Ready, Invalid);
+  EmitBlock(Invalid);
+  // The runtime consumes the source +1 and supplies an allocation-independent
+  // service error if typed-error allocation fails. Null violates that contract.
+  EmitTrapCall(llvm::Intrinsic::trap);
+  Builder.CreateUnreachable();
+  Builder.ClearInsertionPoint();
+  EmitBlock(Ready);
+  replaceError(*this, Data, Error);
+  Builder.CreateStore(Builder.getInt32(1), Data.Kind);
+  EmitBranchThroughCleanup(Data.Final);
+  return true;
+}
+
+RValue CodeGenFunction::EmitObjC3CAwaitExpr(const CoawaitExpr &E,
+                                            AggValueSlot Slot,
+                                            bool IgnoreResult) {
+  auto &Data = *ObjC3CAsync.Data;
+  RunCleanupsScope AwaitScope(*this);
+  checkCancelled(*this, Data);
+  Address Frame = CreateMemTemp(E.getOperand()->getType(), "objc3.await.frame");
+  EmitAnyExprToMem(E.getOperand(), Frame, Qualifiers(), true);
+  Address Child = CreateTempAlloca(Int8PtrTy, CharUnits::fromQuantity(8), "objc3.await.child");
+  Builder.CreateStore(nullPtr(*this), Child);
+  EHStack.pushCleanup<DisposeChild>(NormalAndEHCleanup, Frame, Child);
+  auto *Owner = Builder.CreateLoad(Data.Owner);
+  auto *Status = call(*this, "objc3_async_frame_start_child", Int32Ty,
+      {Frame.emitRawPointer(*this), Owner, Child.emitRawPointer(*this)});
+  checkStatus(*this, Data, Status);
+  auto *Dependency = Builder.CreateLoad(Child);
+  Status = call(*this, "objc3_task_await", Int32Ty, {Owner, Dependency});
+  checkStatus(*this, Data, Status);
+  suspend(*this, Data, false);
+  checkCancelled(*this, Data);
+
+  Address Completion = CreateTempAlloca(completionType(CGM),
+      CharUnits::fromQuantity(8), "objc3.await.completion");
+  Builder.CreateMemSet(Completion, Builder.getInt8(0), Builder.getInt64(48));
+  storeField(*this, Completion, 0, Builder.getInt32(48));
+  storeField(*this, Completion, 1, Builder.getInt32(ServiceABI));
+  Status = call(*this, "objc3_task_get_completion", Int32Ty,
+      {Dependency, Completion.emitRawPointer(*this)});
+  checkStatus(*this, Data, Status);
+  auto *Kind = Builder.CreateLoad(field(*this, Completion, 2));
+  auto *Success = createBasicBlock("objc3.await.success");
+  auto *Failure = createBasicBlock("objc3.await.failure");
+  Builder.CreateCondBr(Builder.CreateIsNull(Kind), Success, Failure);
+  EmitBlock(Failure);
+  auto *Error = Builder.CreateLoad(field(*this, Completion, 6));
+  if (!emitObjC3CAsyncCheckedFailure(*this, E, Kind, Error)) {
+    auto *Retained = call(*this, "objc3_error_retain", Int8PtrTy, {Error});
+    replaceError(*this, Data, Retained);
+    Builder.CreateStore(Kind, Data.Kind);
+    EmitBranchThroughCleanup(Data.Final);
+  }
+  EmitBlock(Success);
+  QualType T = resultStorageType(getContext(), E.getType());
+  llvm::Constant *Descriptor = resultDescriptor(*this, T);
+  llvm::Value *Ops = valueOps(*this, T);
+  bool Temporary = T->isVoidType() || Slot.isIgnored();
+  Address Result = T->isVoidType() ? Address::invalid()
+      : Temporary ? Address(CreateMemTemp(T, "objc3.await.result"))
+                  : Address(Slot.getAddress());
+  Status = call(*this, "objc3_task_copy_result", Int32Ty,
+      {Dependency, Descriptor, Ops,
+       Result.isValid() ? Result.emitRawPointer(*this) : nullPtr(*this)});
+  checkStatus(*this, Data, Status);
+  // Copy-out established a complete owned carrier before child cleanup runs.
+  // Its enclosing initialization guard must protect that ownership on unwind.
+  auto Init = getObjC3CarrierLocalInitState();
+  if (Result.isValid() && Init.Initialized.isValid() &&
+      isObjC3CarrierLocalInitialization(Result, T))
+    Builder.CreateStore(Builder.getTrue(), Init.Initialized);
+  // Cleanup dispatch also serves cancellation/failure exits. Reload copied
+  // values after its continuation so SSA dominance does not depend on the
+  // runtime cleanup destination selector. Result ownership outlives the child.
+  AwaitScope.ForceCleanup();
+  RValue Value = RValue::getIgnored();
+  if (T->isObjCRetainableType()) {
+    auto *Pointer = Builder.CreateLoad(Result);
+    Value = RValue::get(EmitARCAutorelease(Pointer));
+  } else if (!T->isVoidType()) {
+    if (getEvaluationKind(T) == TEK_Complex)
+      Value = RValue::getComplex(EmitLoadOfComplex(MakeAddrLValue(Result, T), E.getExprLoc()));
+    else if (getEvaluationKind(T) == TEK_Scalar)
+      Value = RValue::get(EmitLoadOfScalar(MakeAddrLValue(Result, T), E.getExprLoc()));
+    else {
+      Value = RValue::getAggregate(Result);
+      if (Temporary && containsObjC3CarrierManagedStorage(T))
+        pushDestroy(NormalAndEHCleanup, Result, T, destroyObjC3ManagedStorage, false);
+      else if (Temporary && T.isDestructedType() != QualType::DK_none)
+        pushDestroy(NormalAndEHCleanup, Result, T, getDestroyer(T.isDestructedType()), false);
+    }
+  }
+  (void)IgnoreResult;
+  return Value;
+}
+
+// Metadata comes from the same AST representation and operation emitters as a
+// native async Optional result. The library never guesses carrier field layout.
+llvm::Value *clang::CodeGen::emitObjC3AsyncGroupNextPlan(
+    CodeGenFunction &CGF, const CallExpr &E) {
+  auto &Ctx = CGF.getContext();
+  QualType Result = E.getArg(0)->getType()->getPointeeType().getCanonicalType();
+  QualType Element = cast<ObjC3OptionalType>(Result.getTypePtr())->getElementType();
+  auto Info = Ctx.getObjC3CarrierRepresentationType(Result);
+  auto *Type = llvm::StructType::get(
+      CGF.Int32Ty, CGF.Int32Ty, CGF.Int8PtrTy, CGF.Int8PtrTy, CGF.Int8PtrTy,
+      CGF.Int64Ty, CGF.Int64Ty, CGF.Int32Ty, CGF.Int32Ty);
+  auto *Init = llvm::ConstantStruct::get(
+      Type, {CGF.Builder.getInt32(56), CGF.Builder.getInt32(1),
+             resultDescriptor(CGF, Element), resultDescriptor(CGF, Result),
+             cast<llvm::Constant>(valueOps(CGF, Result)),
+             CGF.Builder.getInt64(Info.ValueOffsetBits / Ctx.getCharWidth()),
+             CGF.Builder.getInt64(Info.TagOffsetBits / Ctx.getCharWidth()),
+             CGF.Builder.getInt32(1), CGF.Builder.getInt32(0)});
+  auto *Plan = new llvm::GlobalVariable(
+      CGF.CGM.getModule(), Type, true, llvm::GlobalValue::PrivateLinkage, Init,
+      "__objc3_async_group_next_plan");
+  Plan->setAlignment(llvm::Align(8));
+  return Plan;
+}
