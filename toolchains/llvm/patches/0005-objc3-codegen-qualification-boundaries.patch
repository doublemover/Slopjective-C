diff --git a/clang/lib/CodeGen/CGObjC3Resources.cpp b/clang/lib/CodeGen/CGObjC3Resources.cpp
new file mode 100644
index 000000000..16356ee71
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3Resources.cpp
@@ -0,0 +1,98 @@
+//===--- CGObjC3Resources.cpp - Native scalar resource cleanup -------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "CGObjC3Resources.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+struct CallObjC3Cleanup final : EHScopeStack::Cleanup {
+  const VarDecl *Variable;
+  explicit CallObjC3Cleanup(const VarDecl *Variable) : Variable(Variable) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    const auto *Attribute = Variable->getAttr<ObjCCleanupAttr>();
+    const auto *Call = cast<CallExpr>(Attribute->getCall());
+    const auto *Operand =
+        cast<OpaqueValueExpr>(Call->getArg(0)->IgnoreParenImpCasts());
+    DeclRefExpr Reference(CGF.getContext(), const_cast<VarDecl *>(Variable),
+                          false, Variable->getType(), VK_LValue,
+                          Variable->getLocation());
+    LValue Storage = CGF.EmitLValue(&Reference);
+    if (Attribute->getByAddress()) {
+      // Address callbacks must not introduce an extra volatile/atomic read.
+      CodeGenFunction::OpaqueValueMapping Binding(
+          CGF, Operand, RValue::get(Storage.getAddress().emitRawPointer(CGF)));
+      CGF.EmitIgnoredExpr(Call);
+    } else {
+      // Let native argument conversion perform the final load or bind a C++
+      // reference, rather than pretending an existing object is a prvalue.
+      CodeGenFunction::OpaqueValueMapping Binding(CGF, Operand, Storage);
+      CGF.EmitIgnoredExpr(Call);
+    }
+  }
+};
+struct CallResourceCleanup final : EHScopeStack::Cleanup {
+  const VarDecl *Variable;
+  explicit CallResourceCleanup(const VarDecl *Variable) : Variable(Variable) {}
+  void Emit(CodeGenFunction &CGF, Flags) override {
+    emitObjC3ResourceCleanup(CGF, *Variable);
+  }
+};
+} // namespace
+
+void clang::CodeGen::pushObjC3Cleanup(CodeGenFunction &CGF,
+                                      const VarDecl &Variable) {
+  CGF.EHStack.pushCleanup<CallObjC3Cleanup>(NormalAndEHCleanup, &Variable);
+}
+
+void clang::CodeGen::pushObjC3ResourceCleanup(CodeGenFunction &CGF,
+                                              const VarDecl &Variable) {
+  CGF.EHStack.pushCleanup<CallResourceCleanup>(NormalAndEHCleanup, &Variable);
+}
+
+void clang::CodeGen::emitObjC3ResourceCleanup(CodeGenFunction &CGF,
+                                              const VarDecl &Variable,
+                                              const Expr *StorageOperand) {
+  const auto *Resource = Variable.getAttr<ObjCResourceAttr>();
+  assert(Resource && "resource cleanup requires its validated attribute");
+  QualType HandleType = Variable.getType();
+  DeclRefExpr ValueReference(CGF.getContext(),
+                              const_cast<VarDecl *>(&Variable), false,
+                              HandleType, VK_LValue, Variable.getLocation());
+  // Explicit capture storage is reached through its original DeclRefExpr.
+  // Reconstructing an uncaptured reference here would address an outer local
+  // which is absent from the Block invocation's local declaration map.
+  const Expr *StorageReference = StorageOperand ? StorageOperand : &ValueReference;
+  LValue Handle = CGF.EmitLValue(StorageReference);
+  llvm::Value *Current =
+      CGF.EmitLoadOfLValue(Handle, Variable.getLocation()).getScalarVal();
+  llvm::Value *Invalid = CGF.EmitScalarExpr(Resource->getInvalid());
+
+  auto *CloseBlock = CGF.createBasicBlock("resource.close");
+  auto *DoneBlock = CGF.createBasicBlock("resource.done");
+  CGF.Builder.CreateCondBr(CGF.Builder.CreateICmpNE(Current, Invalid),
+                           CloseBlock, DoneBlock);
+  CGF.EmitBlock(CloseBlock);
+  llvm::Value *Argument = Resource->getByAddress()
+                              ? Handle.getAddress().emitRawPointer(CGF)
+                              : Current;
+  const auto *Call = cast<CallExpr>(Resource->getCall());
+  const auto *Operand =
+      cast<OpaqueValueExpr>(Call->getArg(0)->IgnoreParenImpCasts());
+  CodeGenFunction::OpaqueValueMapping Binding(CGF, Operand,
+                                               RValue::get(Argument));
+  CGF.EmitIgnoredExpr(Call);
+  // The cleanup has been removed from the EH stack before it runs. If close
+  // throws, native unwinding cannot register or execute the same action twice.
+  // A close callback may copy a block and move a __block handle into a new
+  // forwarding cell. Invalidate the variable's current storage afterward.
+  CGF.EmitStoreThroughLValue(RValue::get(Invalid),
+                              CGF.EmitLValue(StorageReference));
+  CGF.EmitBranch(DoneBlock);
+  CGF.EmitBlock(DoneBlock);
+}
