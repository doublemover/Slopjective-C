diff --git a/clang/lib/CodeGen/CGObjC3ResultExpr.cpp b/clang/lib/CodeGen/CGObjC3ResultExpr.cpp
new file mode 100644
index 000000000..ddc268d6d
--- /dev/null
+++ b/clang/lib/CodeGen/CGObjC3ResultExpr.cpp
@@ -0,0 +1,278 @@
+//===--- CGObjC3ResultExpr.cpp - Private Result expression lowering
+//---------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "CGObjC3ResultExpr.h"
+#include "CGObjC3Carriers.h"
+#include "CodeGenFunction.h"
+#include "CodeGenModule.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/Type.h"
+#include "llvm/IR/Constants.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+bool CodeGen::emitObjC3ResultAggregateExpr(CodeGenFunction &CGF,
+                                           const ObjC3ResultExpr &E,
+                                           Address Destination,
+                                           bool DestinationIsIgnored,
+                                           bool DestinationIsVolatile,
+                                           bool IsLocalCarrierInitialization) {
+  const bool IsOk = E.getKind() == ObjC3ResultExpr::Kind::Ok;
+  const bool IsErr = E.getKind() == ObjC3ResultExpr::Kind::Err;
+  if (!IsOk && !IsErr)
+    return false;
+
+  const QualType CarrierType = E.getCarrierType();
+  ASTContext &Ctx = CGF.getContext();
+  const Type *CanonicalCarrier = Ctx.getCanonicalType(CarrierType).getTypePtr();
+  const auto *Result = dyn_cast<ObjC3ResultType>(CanonicalCarrier);
+  const auto Representation =
+      Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  if (!Result ||
+      Representation.State !=
+          ObjC3CarrierRepresentationInfo::Status::Materialized ||
+      !Representation.Record || !Representation.TagField) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "unmaterialized Result construction");
+    return true;
+  }
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) &&
+      !(IsLocalCarrierInitialization && !DestinationIsIgnored &&
+        supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        IsOk ? "Ok construction" : "Err construction");
+    return true;
+  }
+  Expr *Payload = E.getPayload();
+  TypeSourceInfo *PayloadInfo =
+      IsOk ? E.getSuccessTypeInfo() : E.getErrorTypeInfo();
+  if (!Payload || !PayloadInfo) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result payload construction");
+    return true;
+  }
+  QualType ExpectedPayloadType =
+      IsOk ? Result->getSuccessType() : Result->getErrorType();
+  FieldDecl *SelectedPayloadField =
+      IsOk ? Representation.SuccessField : Representation.ErrorField;
+  if (!Ctx.hasSameType(PayloadInfo->getType(), ExpectedPayloadType) ||
+      (ExpectedPayloadType->isVoidType() ? SelectedPayloadField != nullptr
+                                         : !SelectedPayloadField) ||
+      (SelectedPayloadField &&
+       !Ctx.hasSameType(SelectedPayloadField->getType(),
+                        ExpectedPayloadType))) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType,
+        "mismatched Result active payload");
+    return true;
+  }
+
+  // Discarding the constructed value still evaluates the selected payload once.
+  if (DestinationIsIgnored) {
+    (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(), true);
+    return true;
+  }
+  ObjC3CarrierStorageLayout Layout;
+  if (!Destination.isValid() ||
+      !getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      Destination.getElementType() != Layout.StorageType) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result storage construction");
+    return true;
+  }
+
+  QualType PayloadType = PayloadInfo->getType();
+  if (PayloadType->isVoidType()) {
+    (void)CGF.EmitAnyExpr(Payload, AggValueSlot::ignored(), true);
+  } else {
+    Address PayloadStorage = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType,
+        IsOk ? ObjC3CarrierPayloadArm::Success : ObjC3CarrierPayloadArm::Error);
+    if (!PayloadStorage.isValid()) {
+      diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, E.getKeywordLoc(),
+                                               CarrierType,
+                                               "Result active payload storage");
+      return true;
+    }
+    // Match Optional lowering: EmitAnyExprToMem loses qualifiers that exist
+    // only on the carrier destination for scalar expressions.
+    const bool PayloadIsVolatile =
+        DestinationIsVolatile || PayloadType.isVolatileQualified();
+    if (PayloadType->isScalarType()) {
+      llvm::Value *Value = CGF.EmitScalarExpr(Payload);
+      CGF.EmitStoreOfScalar(Value, PayloadStorage, PayloadIsVolatile,
+                            PayloadType, AlignmentSource::Type,
+                            /*isInit=*/true);
+    } else {
+      Qualifiers Quals = PayloadType.getQualifiers();
+      if (DestinationIsVolatile)
+        Quals.addVolatile();
+      CGF.EmitAnyExprToMem(Payload, PayloadStorage, Quals, true);
+    }
+  }
+
+  // Tag true denotes success; an error with a zero/false/void payload is an
+  // actual error. Commit the tag after initialization of only its active arm.
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(IsOk), true,
+                                DestinationIsVolatile)) {
+    diagnoseUnsupportedObjC3CarrierOperation(
+        CGF.CGM, E.getKeywordLoc(), CarrierType, "Result tag initialization");
+  }
+  return true;
+}
+
+llvm::Value *CodeGen::emitObjC3ResultIsOkExpr(CodeGenFunction &CGF,
+                                              const ObjC3ResultExpr &E) {
+  QualType CarrierType = E.getCarrierType();
+  auto Fail = [&](const char *Operation) -> llvm::Value * {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, E.getKeywordLoc(),
+                                             CarrierType, Operation);
+    return llvm::PoisonValue::get(CGF.ConvertType(E.getType()));
+  };
+  const Type *CanonicalCarrier =
+      CGF.getContext().getCanonicalType(CarrierType).getTypePtr();
+  if (!isa<ObjC3ResultType>(CanonicalCarrier))
+    return Fail("non-Result IsOk carrier");
+  Expr *Operand = E.getPayload();
+  if (!supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) &&
+      !(Operand && Operand->isGLValue() &&
+        supportsObjC3CarrierCppLocalLifetime(CGF.CGM, CarrierType)))
+    return Fail("IsOk query");
+  if (!Operand)
+    return Fail("IsOk operand");
+
+  Address Storage = Address::invalid();
+  if (Operand->isGLValue()) {
+    Storage = CGF.EmitLValue(Operand).getAddress();
+  } else {
+    Storage = CGF.CreateMemTemp(CarrierType, "objc3.result.isok");
+    Qualifiers TempQualifiers;
+    if (Operand->getType().isVolatileQualified())
+      TempQualifiers.addVolatile();
+    CGF.EmitAnyExprToMem(Operand, Storage, TempQualifiers, true);
+  }
+  Address Tag = getObjC3CarrierTagAddress(CGF, Storage, CarrierType);
+  if (!Tag.isValid())
+    return Fail("IsOk tag read");
+  return CGF.EmitLoadOfScalar(Tag, Operand->getType().isVolatileQualified(),
+                              CGF.getContext().BoolTy, E.getExprLoc());
+}
+
+namespace {
+bool emitResultCopyImpl(CodeGenFunction &CGF, QualType CarrierType,
+                        Address Destination, Address Source,
+                        bool DestinationIsVolatile, bool SourceIsVolatile,
+                        bool IsInitialization, SourceLocation Loc) {
+  ObjC3CarrierStorageLayout Layout;
+  if (!getObjC3CarrierStorageLayout(CGF.CGM, CarrierType, Layout) ||
+      !Destination.isValid() || !Source.isValid() || Destination.isSigned() ||
+      Source.isSigned() || Destination.getElementType() != Layout.StorageType ||
+      Source.getElementType() != Layout.StorageType ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source))
+    return false;
+
+  ASTContext &Ctx = CGF.getContext();
+  const auto *Result = dyn_cast<ObjC3ResultType>(
+      Ctx.getCanonicalType(CarrierType).getTypePtr());
+  if (!Result)
+    return false;
+  auto Info = Ctx.getObjC3CarrierRepresentationType(CarrierType);
+  Address SrcSuccess = Address::invalid();
+  Address DstSuccess = Address::invalid();
+  Address SrcError = Address::invalid();
+  Address DstError = Address::invalid();
+  if (Info.SuccessField) {
+    SrcSuccess = getObjC3CarrierPayloadAddress(
+        CGF, Source, CarrierType, ObjC3CarrierPayloadArm::Success);
+    DstSuccess = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Success);
+    if (!SrcSuccess.isValid() || !DstSuccess.isValid())
+      return false;
+  }
+  if (Info.ErrorField) {
+    SrcError = getObjC3CarrierPayloadAddress(
+        CGF, Source, CarrierType, ObjC3CarrierPayloadArm::Error);
+    DstError = getObjC3CarrierPayloadAddress(
+        CGF, Destination, CarrierType, ObjC3CarrierPayloadArm::Error);
+    if (!SrcError.isValid() || !DstError.isValid())
+      return false;
+  }
+
+  llvm::Value *IsOk = emitObjC3CarrierLoadTag(
+      CGF, Source, CarrierType, Loc, SourceIsVolatile);
+  if (!IsOk)
+    return false;
+  llvm::BasicBlock *CopySuccess =
+      CGF.createBasicBlock("objc3.result.copy.ok");
+  llvm::BasicBlock *CopyError =
+      CGF.createBasicBlock("objc3.result.copy.error");
+  llvm::BasicBlock *Continue = CGF.createBasicBlock("objc3.result.copy.cont");
+  CGF.Builder.CreateCondBr(IsOk, CopySuccess, CopyError);
+
+  CGF.EmitBlock(CopySuccess);
+  if (Info.SuccessField &&
+      !emitObjC3CarrierCopyPayload(
+          CGF, Result->getSuccessType(), DstSuccess, SrcSuccess,
+          DestinationIsVolatile, SourceIsVolatile, IsInitialization, Loc))
+    return false;
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(true), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+
+  CGF.EmitBlock(CopyError);
+  if (Info.ErrorField &&
+      !emitObjC3CarrierCopyPayload(
+          CGF, Result->getErrorType(), DstError, SrcError,
+          DestinationIsVolatile, SourceIsVolatile, IsInitialization, Loc))
+    return false;
+  if (!emitObjC3CarrierStoreTag(CGF, Destination, CarrierType,
+                                CGF.Builder.getInt1(false), IsInitialization,
+                                DestinationIsVolatile))
+    return false;
+  CGF.Builder.CreateBr(Continue);
+  CGF.EmitBlock(Continue);
+  return true;
+}
+} // namespace
+
+bool CodeGen::emitObjC3ResultCopy(CodeGenFunction &CGF, QualType CarrierType,
+                                 Address Destination, Address Source,
+                                 bool DestinationIsVolatile,
+                                 bool SourceIsVolatile,
+                                 bool IsInitialization, SourceLocation Loc) {
+  ASTContext &Ctx = CGF.getContext();
+  const auto *Result = dyn_cast<ObjC3ResultType>(
+      Ctx.getCanonicalType(CarrierType).getTypePtr());
+  if (!Result ||
+      !supportsPlainObjC3CarrierStorageLifetime(CGF.CGM, CarrierType) ||
+      !supportsObjC3CarrierCopyPayload(CGF.CGM, Result->getSuccessType()) ||
+      !supportsObjC3CarrierCopyPayload(CGF.CGM, Result->getErrorType()) ||
+      !validateObjC3CarrierCopyStorage(CGF, CarrierType, Destination, Source)) {
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Result copy");
+    return true;
+  }
+
+  // Capture the complete active arm before touching the destination. This
+  // gives self/overlapping copies safe source-read ordering without copying
+  // either inactive union arm.
+  QualType SnapshotType = Ctx.getCanonicalType(CarrierType).getUnqualifiedType();
+  Address Snapshot = CGF.CreateMemTemp(SnapshotType,
+                                       "objc3.result.copy.snapshot");
+  if (!emitResultCopyImpl(CGF, SnapshotType, Snapshot, Source,
+                          /*DestinationIsVolatile=*/false, SourceIsVolatile,
+                          /*IsInitialization=*/true, Loc) ||
+      !emitResultCopyImpl(CGF, CarrierType, Destination, Snapshot,
+                          DestinationIsVolatile,
+                          /*SourceIsVolatile=*/false, IsInitialization, Loc))
+    diagnoseUnsupportedObjC3CarrierOperation(CGF.CGM, Loc, CarrierType,
+                                             "Result copy storage");
+  return true;
+}
