diff --git a/lldb/source/Plugins/SymbolFile/DWARF/ObjCRuntimeName.h b/lldb/source/Plugins/SymbolFile/DWARF/ObjCRuntimeName.h
new file mode 100644
index 000000000..639d83f48
--- /dev/null
+++ b/lldb/source/Plugins/SymbolFile/DWARF/ObjCRuntimeName.h
@@ -0,0 +1,26 @@
+//===-- ObjCRuntimeName.h - Objective-C native type identities -*- C++ -*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLDB_SOURCE_PLUGINS_SYMBOLFILE_DWARF_OBJCRUNTIMENAME_H
+#define LLDB_SOURCE_PLUGINS_SYMBOLFILE_DWARF_OBJCRUNTIMENAME_H
+#include "DWARFDIE.h"
+#include "llvm/BinaryFormat/Dwarf.h"
+namespace lldb_private::plugin::dwarf {
+inline llvm::StringRef GetObjCRuntimeName(const DWARFDIE &DIE) {
+  if (!DIE)
+    return {};
+  for (const auto &Child : DIE.children()) {
+    if (Child.Tag() != llvm::dwarf::DW_TAG_LLVM_annotation)
+      continue;
+    const auto *Name = Child.GetName();
+    if (Name && llvm::StringRef(Name) == "objc_runtime_name")
+      if (const auto *Value = Child.GetAttributeValueAsString(
+              llvm::dwarf::DW_AT_const_value, nullptr))
+        if (*Value)
+          return Value;
+  }
+  const auto *Name = DIE.GetName();
+  return Name ? llvm::StringRef(Name) : llvm::StringRef();
+}
+} // namespace lldb_private::plugin::dwarf
+#endif
