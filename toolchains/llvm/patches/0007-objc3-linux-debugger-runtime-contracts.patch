+bool IRForTarget::InitializeGNUObjCSelectors(llvm::Function &Wrapper) {
+  llvm::FunctionCallee Register;
+  auto *Pointer = llvm::PointerType::getUnqual(m_module->getContext());
+  llvm::IRBuilder<> Builder(&*Wrapper.getEntryBlock().getFirstInsertionPt());
+  for (auto &Global : m_module->globals()) {
+    if (!Global.getName().starts_with(".objc_selector_") ||
+        !Global.hasInitializer())
+      continue;
+    const auto *Initializer =
+        llvm::dyn_cast<llvm::ConstantStruct>(Global.getInitializer());
+    if (!Initializer || Initializer->getNumOperands() != 2 ||
+        !Initializer->getOperand(0)->getType()->isPointerTy() ||
+        !Initializer->getOperand(1)->getType()->isPointerTy()) {
+      m_error_stream.Printf("Unsupported GNUstep selector layout\n");
+      return false;
+    }
+    if (!Register) {
+      bool MissingWeak = false;
+      const auto Address = m_execution_unit.FindSymbol(
+          lldb_private::ConstString("sel_registerTypedName_np"), MissingWeak);
+      if (Address == LLDB_INVALID_ADDRESS || MissingWeak) {
+        m_error_stream.Printf(
+            "Couldn't find GNUstep typed selector registration\n");
+        return false;
+      }
+      auto *Type = llvm::FunctionType::get(Pointer, {Pointer, Pointer}, false);
+      auto *Callee = llvm::ConstantExpr::getIntToPtr(
+          llvm::ConstantInt::get(m_intptr_ty, Address), Pointer);
+      Register = {Type, Callee};
+    }
+    // JIT modules do not execute the ELF image's Objective-C loader. Register
+    // each selector and initialize this module's two-pointer selector storage.
+    // Keeping its address also covers selectors embedded in constant arrays.
+    Global.setLinkage(llvm::GlobalValue::InternalLinkage);
+    Global.setVisibility(llvm::GlobalValue::DefaultVisibility);
+    Global.setComdat(nullptr);
+    Global.setConstant(false);
+    auto *Canonical = Builder.CreateCall(
+        Register, {Initializer->getOperand(0), Initializer->getOperand(1)},
+        "objc.selector");
+    const auto Alignment =
+        m_target_data->getABITypeAlign(Global.getValueType());
+    Builder.CreateMemCpy(
+        &Global, Alignment, Canonical, Alignment,
+        m_target_data->getTypeAllocSize(Global.getValueType()));
+  }
+  return true;
+}
