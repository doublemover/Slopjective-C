diff --git a/lldb/source/Plugins/ExpressionParser/Clang/ObjC3MethodNames.h b/lldb/source/Plugins/ExpressionParser/Clang/ObjC3MethodNames.h
new file mode 100644
index 000000000..81a3347a9
--- /dev/null
+++ b/lldb/source/Plugins/ExpressionParser/Clang/ObjC3MethodNames.h
@@ -0,0 +1,60 @@
+//===-- ObjC3MethodNames.h - Owned GNUstep method symbols ---------*- C++
+//-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#ifndef LLDB_PLUGINS_EXPRESSIONPARSER_CLANG_OBJC3METHODNAMES_H
+#define LLDB_PLUGINS_EXPRESSIONPARSER_CLANG_OBJC3METHODNAMES_H
+
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/ADT/StringRef.h"
+#include <optional>
+#include <string>
+
+namespace lldb_private {
+struct ObjC3MethodNames {
+  std::string Class;
+  std::string Category;
+  std::string Selector;
+  bool IsClassMethod = false;
+  bool IsDirect = false;
+};
+
+inline std::optional<ObjC3MethodNames>
+ParseObjC3MethodNames(llvm::StringRef Name) {
+  Name.consume_front("\01");
+  if (!Name.consume_front("__objc3_method_"))
+    return std::nullopt;
+  ObjC3MethodNames Result;
+  if (Name.consume_front("c_"))
+    Result.IsClassMethod = true;
+  else if (!Name.consume_front("i_"))
+    return std::nullopt;
+  auto Field = [&](llvm::StringRef Tag, std::string &Value) {
+    if (!Name.consume_front(Tag))
+      return false;
+    const auto Split = Name.split('_');
+    size_t Size = 0;
+    if (Split.first.empty() || Split.first.getAsInteger(10, Size))
+      return false;
+    Name = Split.second;
+    if (Size > Name.size() / 2 ||
+        !llvm::tryGetFromHex(Name.take_front(Size * 2), Value))
+      return false;
+    Name = Name.drop_front(Size * 2);
+    return Name.consume_front("_");
+  };
+  if (!Field("R", Result.Class) || !Field("C", Result.Category) ||
+      !Field("S", Result.Selector) || Result.Class.empty() ||
+      Result.Selector.empty())
+    return std::nullopt;
+  if (Name == "D")
+    Result.IsDirect = true;
+  else if (Name != "M")
+    return std::nullopt;
+  return Result;
+}
+} // namespace lldb_private
+#endif
