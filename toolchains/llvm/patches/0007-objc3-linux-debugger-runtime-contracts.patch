@@ -0,0 +1,61 @@
+// REQUIRES: native, system-linux
+// UNSUPPORTED: remote-linux
+// RUN: %clangxx_host -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -g -O0 %s -o %t
+// RUN: %lldb -b -x %t \
+// RUN:   -o "settings set target.disable-aslr false" \
+// RUN:   -o "breakpoint set -n carrier_first_stop" \
+// RUN:   -o "breakpoint set -n carrier_second_stop" \
+// RUN:   -o run -o up \
+// RUN:   -o "frame variable number absent nested result unit" \
+// RUN:   -o "frame variable number.value result.success" \
+// RUN:   -o "expression number.__objc3_payload.__objc3_value + result.__objc3_payload.__objc3_success" \
+// RUN:   -o continue -o up -o "frame variable number result" \
+// RUN:   -o "frame variable result.error" -o continue 2>&1 | FileCheck %s
+
+typedef Optional(int) Number;
+typedef Optional(Number) Nested;
+typedef Result(int, long) Outcome;
+
+__attribute__((noinline)) void carrier_first_stop() {
+  __asm__ volatile("" ::: "memory");
+}
+__attribute__((noinline)) void carrier_second_stop() {
+  __asm__ volatile("" ::: "memory");
+}
+
+int main() {
+  Number number = Some(int, 7);
+  Number absent = None(int);
+  Nested nested = Some(Number, Some(int, 9));
+  Outcome result = Ok(int, long, 42);
+  Optional(void) unit = Some(void, (void)0);
+  carrier_first_stop();
+  number = None(int);
+  result = Err(int, long, -5L);
+  carrier_second_stop();
+  return hasValue(number) || isOk(result);
+}
+
+// CHECK: (lldb) frame variable number absent nested result unit
+// CHECK: number = Some(7)
+// CHECK: value = 7
+// CHECK: absent = None
+// CHECK-NOT: __objc3_
+// CHECK: nested = Some(Some(9))
+// CHECK: result = Ok(42)
+// CHECK: success = 42
+// CHECK-NOT: error =
+// CHECK: unit = Some(void)
+// CHECK: (lldb) frame variable number.value result.success
+// CHECK: number.value = 7
+// CHECK: result.success = 42
+// CHECK: (int) $0 = 49
+// CHECK: (lldb) frame variable number result
+// CHECK: number = None
+// CHECK-NOT: value =
+// CHECK: result = Err(-5)
+// CHECK: error = -5
+// CHECK-NOT: success =
+// CHECK: (lldb) frame variable result.error
+// CHECK: result.error = -5
+// CHECK: exited with status = 0
