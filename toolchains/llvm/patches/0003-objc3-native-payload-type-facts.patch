+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source,
+                               std::vector<std::string> Args) {
+  return tooling::buildASTFromCodeWithArgs(Source, Args, "objc3-value-types.mm");
+}
+
+const NamedDecl *lookup(ASTContext &Context, llvm::StringRef Name) {
+  IdentifierInfo &II = Context.Idents.get(Name);
+  auto Decls = Context.getTranslationUnitDecl()->lookup(&II);
+  return Decls.empty() ? nullptr : Decls.front();
+}
+
+const VarDecl *findVar(ASTContext &Context, llvm::StringRef Name) {
+  if (const auto *D = dyn_cast_or_null<VarDecl>(lookup(Context, Name)))
+    return D;
+  return nullptr;
+}
+
+const FunctionDecl *findFunction(ASTContext &Context, llvm::StringRef Name) {
+  if (const auto *D = dyn_cast_or_null<FunctionDecl>(lookup(Context, Name)))
+    return D;
+  return nullptr;
+}
+
+const RecordDecl *findRecord(ASTContext &Context, llvm::StringRef Name) {
+  if (const auto *D = dyn_cast_or_null<RecordDecl>(lookup(Context, Name)))
+    return D;
+  return nullptr;
+}
+
+class LocalVarFinder : public RecursiveASTVisitor<LocalVarFinder> {
+public:
+  explicit LocalVarFinder(llvm::StringRef Name) : Name(Name) {}
+  bool VisitVarDecl(VarDecl *Decl) {
+    if (Decl->getName() == Name)
+      Found = Decl;
+    return Found == nullptr;
+  }
+  const VarDecl *get() const { return Found; }
+private:
+  llvm::StringRef Name;
+  const VarDecl *Found = nullptr;
+};
+
+const VarDecl *findLocalVar(ASTContext &Context, llvm::StringRef Name) {
+  LocalVarFinder Finder(Name);
+  Finder.TraverseDecl(Context.getTranslationUnitDecl());
+  return Finder.get();
+}
