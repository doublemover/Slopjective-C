+TEST(ObjC3TypeContracts, EnclosingManagedRecordsHaveNativeLifetimeFacts) {
+  for (bool CXX : {false, true}) {
+    auto AST = parse(R"objc(
+      typedef __objc3_optional(id) Strong;
+      typedef __objc3_optional(id __weak) Weak;
+      typedef void (^Action)(void);
+      struct Managed { Strong value; Weak weak; Strong array[2]; };
+      struct Nested { struct Managed values[2]; };
+      struct Hybrid { Strong value; Action action; };
+      struct View { struct Managed *pointer; };
+    )objc", {"-x", CXX ? "objective-c++" : "objective-c",
+             CXX ? "-std=c++20" : "-std=c17", "-fobjc-version=3",
+             "-fobjc-runtime=gnustep-2.2", "-fobjc-arc", "-fblocks",
+             "-target", "x86_64-unknown-linux-gnu"});
+    ASSERT_TRUE(AST);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    ASTContext &Context = AST->getASTContext();
+    for (llvm::StringRef Name : {"Managed", "Nested", "Hybrid"}) {
+      const RecordDecl *RD = findRecord(Context, Name);
+      ASSERT_NE(RD, nullptr);
+      QualType T = Context.getCanonicalTagType(RD);
+      EXPECT_TRUE(containsObjC3CarrierManagedStorage(T));
+      auto Facts = getObjC3ValueTypeFacts(
+          Context, T, ObjC3PayloadPosition::OptionalElement);
+      EXPECT_TRUE(Facts.HasARCManagedRecordFields);
+      EXPECT_FALSE(Facts.IsTriviallyCopyable);
+      EXPECT_TRUE(Facts.Destroy.NeedsGeneratedOperation);
+      if (CXX) {
+        const auto *Class = cast<CXXRecordDecl>(RD);
+        EXPECT_FALSE(Class->hasTrivialDestructor());
+        EXPECT_TRUE(Class->isParamDestroyedInCallee());
+      }
+    }
+    EXPECT_TRUE(containsObjC3CarrierThrowingCopy(
+        Context.getCanonicalTagType(findRecord(Context, "Hybrid"))));
+    EXPECT_FALSE(containsObjC3CarrierThrowingCopy(
+        Context.getCanonicalTagType(findRecord(Context, "Managed"))));
+    EXPECT_FALSE(containsObjC3CarrierManagedStorage(
+        Context.getCanonicalTagType(findRecord(Context, "View"))));
+  }
+}
