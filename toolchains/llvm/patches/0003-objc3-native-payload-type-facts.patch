+//===--- ObjC3Async.h - Reserved checked async AST bridge --------*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3ASYNC_H
+#define LLVM_CLANG_AST_OBJC3ASYNC_H
+#include "clang/AST/Decl.h"
+#include "clang/AST/ExprCXX.h"
+namespace clang {
+inline const CallExpr *getObjC3CheckedAsyncAdapter(const Expr *E) {
+  const auto *Await = dyn_cast<CoawaitExpr>(E->IgnoreImplicit());
+  if (!Await)
+    return nullptr;
+  const auto *Call = dyn_cast<CallExpr>(Await->getOperand()->IgnoreImplicit());
+  const auto *FD = Call ? Call->getDirectCallee() : nullptr;
+  if (!FD || !FD->getIdentifier() ||
+      !FD->getIdentifier()->isStr("__objc3_async_checked") ||
+      Call->getNumArgs() != 2 ||
+      !isa<OpaqueValueExpr>(Call->getArg(1)->IgnoreImpCasts()))
+    return nullptr;
+  return Call;
+}
+inline const Expr *getObjC3AsyncSourceCall(const Expr *E) {
+  if (const auto *Adapter = getObjC3CheckedAsyncAdapter(E))
+    return Adapter->getArg(0)->IgnoreImplicit();
+  if (const auto *Await = dyn_cast<CoawaitExpr>(E->IgnoreImplicit()))
+    return Await->getOperand()->IgnoreImplicit();
+  return E->IgnoreParenImpCasts();
+}
+} // namespace clang
+#endif
