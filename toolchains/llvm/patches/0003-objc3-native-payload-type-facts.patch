+TEST(ObjC3TypeContracts, MarksAtomicAndFlexibleArrayForSpecializedAdapters) {
+  auto AST = parse(R"c(
+    _Atomic(int) AtomicValue;
+    struct FlexibleRecord { int Count; int Data[]; };
+    struct FlexibleRecord FlexibleValue;
+  )c", {"-x", "c", "-std=c11"});
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  auto Atomic = getObjC3ValueTypeFacts(
+      Context, findVar(Context, "AtomicValue")->getType(),
+      ObjC3PayloadPosition::OptionalElement);
+  EXPECT_EQ(Atomic.Kind, ObjC3PayloadTypeKind::Atomic);
+  EXPECT_EQ(Atomic.Issue, ObjC3PayloadTypeIssue::AtomicNeedsAtomicOperations);
+
+  auto Flexible = getObjC3ValueTypeFacts(
+      Context, findVar(Context, "FlexibleValue")->getType(),
+      ObjC3PayloadPosition::ResultSuccess);
+  EXPECT_EQ(Flexible.Kind, ObjC3PayloadTypeKind::Record);
+  EXPECT_EQ(Flexible.Issue,
+            ObjC3PayloadTypeIssue::RecordHasFlexibleArrayMember);
+}
