+TEST(ObjC3TypeContracts, RecursiveCarrierOperationsAndRuntimeEncoding) {
+  auto AST = parse(R"objc(
+    typedef __objc3_optional(id) Strong;
+    typedef __objc3_optional(id __weak) Weak;
+    typedef __objc3_result(Strong, Weak) Mixed;
+    extern __objc3_optional(Mixed) NestedValue;
+    extern __objc3_optional(__objc3_optional(int)) PlainValue;
+  )objc", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+           "-fobjc-runtime=gnustep-2.2", "-fobjc-arc",
+           "-target", "x86_64-unknown-linux-gnu"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  QualType Nested = findVar(Context, "NestedValue")->getType();
+  QualType Plain = findVar(Context, "PlainValue")->getType();
+  auto Managed = getObjC3ValueTypeFacts(Context, Nested,
+                                       ObjC3PayloadPosition::OptionalElement);
+  EXPECT_TRUE(Managed.isValid());
+  EXPECT_FALSE(Managed.IsTriviallyCopyable);
+  EXPECT_TRUE(Managed.Copy.NeedsGeneratedOperation);
+  EXPECT_TRUE(Managed.Move.NeedsGeneratedOperation);
+  EXPECT_TRUE(Managed.Destroy.NeedsGeneratedOperation);
+  auto Trivial = getObjC3ValueTypeFacts(Context, Plain,
+                                       ObjC3PayloadPosition::OptionalElement);
+  EXPECT_TRUE(Trivial.IsTriviallyCopyable);
+  EXPECT_TRUE(Trivial.Copy.IsTrivial);
+  EXPECT_TRUE(Trivial.Destroy.IsTrivial);
+  std::string Encoding;
+  ASSERT_TRUE(getObjC3CarrierRuntimeEncoding(Context, Nested, Encoding));
+  EXPECT_NE(Encoding.find("__objc3_v12_optional_N"), std::string::npos);
+  EXPECT_NE(Encoding.find("__objc3_v12_optional_W40="), std::string::npos);
+  EXPECT_LT(Encoding.size(), 600u);
+  // The runtime representation remains linear for a long Optional chain.
+  QualType Deep = Nested;
+  for (unsigned I = 0; I != 30; ++I)
+    Deep = Context.getObjC3OptionalType(Deep);
+  Encoding.clear();
+  ASSERT_TRUE(getObjC3CarrierRuntimeEncoding(Context, Deep, Encoding));
+  EXPECT_LT(Encoding.size(), 5000u);
+  for (unsigned I = 0; I != 40; ++I)
+    Deep = Context.getObjC3OptionalType(Deep);
+  Encoding = "unchanged";
+  EXPECT_FALSE(getObjC3CarrierRuntimeEncoding(Context, Deep, Encoding));
+  EXPECT_EQ(Encoding, "unchanged");
+  QualType Shared = Nested;
+  for (unsigned I = 0; I != 14; ++I)
+    Shared = Context.getObjC3ResultType(Shared, Shared);
+  auto SharedFacts = getObjC3ValueTypeFacts(Context, Shared,
+                                            ObjC3PayloadPosition::ResultSuccess);
+  EXPECT_TRUE(SharedFacts.Destroy.NeedsGeneratedOperation);
+  // Runtime encodings and lowering deliberately bound expanded arm work.
+  EXPECT_FALSE(getObjC3CarrierRuntimeEncoding(Context, Shared, Encoding));
+  EXPECT_EQ(Encoding, "unchanged");
+}
