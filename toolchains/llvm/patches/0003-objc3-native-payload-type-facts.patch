diff --git a/clang/include/clang/AST/ObjC3TypeContracts.h b/clang/include/clang/AST/ObjC3TypeContracts.h
new file mode 100644
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3TypeContracts.h
@@ -0,0 +1,133 @@
+//===--- ObjC3TypeContracts.h - Clang-backed value type facts ---*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Query-only type and target-layout facts used by Slopjective-C value carriers.
+// This is deliberately not a second type system: both input and canonical
+// Clang QualTypes remain the identity of the source and payload.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_AST_OBJC3TYPECONTRACTS_H
+#define LLVM_CLANG_AST_OBJC3TYPECONTRACTS_H
+
+#include "clang/AST/CharUnits.h"
+#include "clang/AST/Type.h"
+#include "clang/Basic/Specifiers.h"
+
+namespace clang {
+
+class ASTContext;
+
+/// The carrier position is context for callers and diagnostics. It does not
+/// enable optional/result syntax or impose a general copyability policy.
+enum class ObjC3PayloadPosition : unsigned char {
+  OptionalElement,
+  ResultSuccess,
+  ResultError,
+  ThrowsPayload,
+};
+
+enum class ObjC3PayloadTypeKind : unsigned char {
+  Invalid,
+  Void,
+  Builtin,
+  Enumeration,
+  CPointer,
+  ObjCObjectPointer,
+  BlockPointer,
+  MemberPointer,
+  Function,
+  Reference,
+  Record,
+  Array,
+  Atomic,
+  ObjCObject,
+  OtherObject,
+};
+
+/// A reason the current carrier layout adapter cannot describe this shape.
+/// These are implementation facts for diagnostics and future adapters, not
+/// declarations that C/Objective-C types of that shape are generally illegal.
+enum class ObjC3PayloadTypeIssue : unsigned char {
+  None,
+  NullType,
+  Dependent,
+  VariablyModified,
+  Incomplete,
+  Function,
+  Reference,
+  ArrayNeedsElementOperations,
+  AtomicNeedsAtomicOperations,
+  RecordHasFlexibleArrayMember,
+  NotAnObjectType,
+};
+
+enum class ObjC3ValueOperation : unsigned char { Copy, Move, Destroy };
+
+/// Facts about an operation, not permission to use it. Sema must resolve
+/// overloads, accessibility, deleted functions, and language conversions for
+/// the actual expression/context. `KnownDeleted` is only positive evidence.
+struct ObjC3ValueOperationFacts {
+  bool IsTrivial = true;
+  bool NeedsGeneratedOperation = false;
+  bool RequiresSemaResolution = false;
+  bool KnownDeleted = false;
+};
+
+/// A value-like snapshot tied to one ASTContext and target. Do not persist this
+/// instead of QualType or treat it as a parallel canonical type graph.
+struct ObjC3ValueTypeFacts {
+  QualType WrittenType;
+  QualType CanonicalType;
+  ObjC3PayloadPosition Position = ObjC3PayloadPosition::OptionalElement;
+  ObjC3PayloadTypeKind Kind = ObjC3PayloadTypeKind::Invalid;
+  ObjC3PayloadTypeIssue Issue = ObjC3PayloadTypeIssue::NullType;
+
+  /// Void is a tag-only value form; it has no object layout or payload bytes.
+  /// A complete object type has target-owned Size and Alignment, which may be
+  /// zero-sized where the target and language permit it.
+  bool HasObjectLayout = false;
+  CharUnits Size = CharUnits::Zero();
+  CharUnits Alignment = CharUnits::Zero();
+
+  /// ObjC object and block pointers retain their native QualType identity.
+  /// Effective lifetime records ARC's implicit lifetime when ARC is enabled.
+  bool IsObjCObjectPointer = false;
+  bool IsBlockPointer = false;
+  bool HasExplicitObjCLifetime = false;
+  Qualifiers::ObjCLifetime WrittenObjCLifetime = Qualifiers::OCL_None;
+  Qualifiers::ObjCLifetime EffectiveObjCLifetime = Qualifiers::OCL_None;
+
+  bool IsRecord = false;
+  bool IsUnion = false;
+  bool IsAbstractRecord = false;
+  bool HasARCManagedRecordFields = false;
+  bool IsTriviallyCopyable = false;
+
+  ObjC3ValueOperationFacts Copy;
+  ObjC3ValueOperationFacts Move;
+  ObjC3ValueOperationFacts Destroy;
+
+  bool isValid() const { return Issue == ObjC3PayloadTypeIssue::None; }
+  bool isVoidTagOnly() const {
+    return isValid() && Kind == ObjC3PayloadTypeKind::Void;
+  }
+};
+
+/// Classify one payload using Clang's canonical QualType, record facts, ARC
+/// ownership, and target layout. The returned facts do not replace Sema's
+/// context-sensitive special-member checks or CodeGen's ABI classification.
+[[nodiscard]] ObjC3ValueTypeFacts getObjC3ValueTypeFacts(
+    const ASTContext &Context, QualType PayloadType,
+    ObjC3PayloadPosition Position);
+
+} // namespace clang
+
+#endif // LLVM_CLANG_AST_OBJC3TYPECONTRACTS_H
+
+
+
