+TEST(ObjC3TypeContracts, ReportsRecordOperationsAndDefersUseSiteAccessToSema) {
+  auto AST = parse(R"cpp(
+    struct Nontrivial {
+      Nontrivial(const Nontrivial &);
+      Nontrivial(Nontrivial &&);
+      ~Nontrivial();
+    };
+    struct DeletedCopy {
+      DeletedCopy(const DeletedCopy &) = delete;
+    };
+    extern Nontrivial NontrivialValue;
+    extern DeletedCopy DeletedCopyValue;
+  )cpp", {"-std=c++20"});
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  auto Nontrivial = getObjC3ValueTypeFacts(
+      Context, findVar(Context, "NontrivialValue")->getType(),
+      ObjC3PayloadPosition::ResultSuccess);
+  ASSERT_TRUE(Nontrivial.isValid());
+  EXPECT_EQ(Nontrivial.Kind, ObjC3PayloadTypeKind::Record);
+  EXPECT_TRUE(Nontrivial.Copy.NeedsGeneratedOperation);
+  EXPECT_TRUE(Nontrivial.Copy.RequiresSemaResolution);
+  EXPECT_TRUE(Nontrivial.Move.NeedsGeneratedOperation);
+  EXPECT_TRUE(Nontrivial.Destroy.NeedsGeneratedOperation);
+
+  auto DeletedCopy = getObjC3ValueTypeFacts(
+      Context, findVar(Context, "DeletedCopyValue")->getType(),
+      ObjC3PayloadPosition::OptionalElement);
+  ASSERT_TRUE(DeletedCopy.isValid());
+  EXPECT_TRUE(DeletedCopy.Copy.RequiresSemaResolution);
+  // Carrier shape queries do not globally ban noncopyable C++ types. Sema
+  // decides whether a particular source expression needs the deleted copy.
+  EXPECT_FALSE(DeletedCopy.Move.KnownDeleted);
+}
