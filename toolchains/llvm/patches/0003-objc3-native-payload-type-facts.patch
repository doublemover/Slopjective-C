+  ASTContext &Context = AST->getASTContext();
+  std::string Strong, Weak, Unsafe;
+  ASSERT_TRUE(getObjC3CarrierRuntimeEncoding(
+      Context, findVar(Context, "Strong")->getType(), Strong));
+  ASSERT_TRUE(getObjC3CarrierRuntimeEncoding(
+      Context, findVar(Context, "Weak")->getType(), Weak));
+  ASSERT_TRUE(getObjC3CarrierRuntimeEncoding(
+      Context, findVar(Context, "Unsafe")->getType(), Unsafe));
+  EXPECT_NE(Strong, Weak);
+  EXPECT_NE(Weak, Unsafe);
+  EXPECT_NE(Strong, Unsafe);
+  EXPECT_NE(Strong.find("optional_S403F="), std::string::npos);
+  EXPECT_NE(Weak.find("optional_W403F="), std::string::npos);
+  EXPECT_NE(Unsafe.find("optional_U403F="), std::string::npos);
+}
