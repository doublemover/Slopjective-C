+TEST(ObjC3TypeContracts, ImportedManagedRecordsPreserveLifetimeAndCallABI) {
+  for (bool CXX : {false, true}) {
+    const std::string Code = R"objc(
+      typedef __objc3_optional(id) Strong;
+      typedef __objc3_optional(id __weak) Weak;
+      struct Imported { Strong value; Weak weak; Strong values[2]; };
+      struct Outer { struct Imported child; };
+    )objc";
+    std::vector<std::string> Args = {
+        "-x", CXX ? "objective-c++" : "objective-c",
+        CXX ? "-std=c++20" : "-std=c17", "-fobjc-version=3",
+        "-fobjc-runtime=gnustep-2.2", "-fobjc-arc",
+        "-target", "x86_64-unknown-linux-gnu"};
+    auto From = tooling::buildASTFromCodeWithArgs(Code, Args, "record-from.mm");
+    auto To = tooling::buildASTFromCodeWithArgs(
+        "", Args, "record-to.mm", "clang-tool",
+        std::make_shared<PCHContainerOperations>(),
+        tooling::getClangStripDependencyFileAdjuster(),
+        {{"record-from.mm", Code}});
+    ASSERT_TRUE(From);
+    ASSERT_TRUE(To);
+    ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                         From->getASTContext(), From->getFileManager(), false);
+    for (llvm::StringRef Name : {"Imported", "Outer"}) {
+      auto *Source = const_cast<RecordDecl *>(
+          findRecord(From->getASTContext(), Name));
+      ASSERT_NE(Source, nullptr);
+      auto Result = Importer.Import(Source);
+      if (!Result)
+        FAIL() << llvm::toString(Result.takeError());
+      const auto *Target = cast<RecordDecl>(*Result);
+      EXPECT_EQ(Target->hasObjectMember(), Source->hasObjectMember());
+      EXPECT_EQ(Target->isNonTrivialToPrimitiveDefaultInitialize(),
+                Source->isNonTrivialToPrimitiveDefaultInitialize());
+      EXPECT_EQ(Target->isNonTrivialToPrimitiveCopy(),
+                Source->isNonTrivialToPrimitiveCopy());
+      EXPECT_EQ(Target->isNonTrivialToPrimitiveDestroy(),
+                Source->isNonTrivialToPrimitiveDestroy());
+      EXPECT_EQ(Target->isParamDestroyedInCallee(),
+                Source->isParamDestroyedInCallee());
+      EXPECT_EQ(Target->getArgPassingRestrictions(),
+                Source->getArgPassingRestrictions());
+    }
+  }
+}
+
+TEST(ObjC3SourceImports, MultiplexPreservesClaimsErrorsAndNativeFallback) {
+  class Source final : public ExternalSemaSource {
+  public:
+    ObjC3SourceImportResult Import = ObjC3SourceImportResult::NotHandled;
+    ObjC3QualifiedNameLookupStatus Lookup = ObjC3QualifiedNameLookupStatus::NotHandled;
+    NamedDecl *Candidate = nullptr;
+    unsigned Imports = 0, Lookups = 0;
+    ObjC3SourceImportResult HandleObjC3SourceImport(
+        llvm::StringRef, SourceLocation) override {
+      ++Imports;
+      return Import;
+    }
+    ObjC3QualifiedNameLookupStatus LookupObjC3QualifiedName(
+        llvm::ArrayRef<IdentifierInfo *>, unsigned,
+        llvm::SmallVectorImpl<NamedDecl *> &Declarations) override {
+      ++Lookups;
+      if (Candidate) Declarations.push_back(Candidate);
+      return Lookup;
+    }
+  };
+  auto Native = llvm::makeIntrusiveRefCnt<Source>();
+  auto Registry = llvm::makeIntrusiveRefCnt<Source>();
+  auto Multiplex = llvm::makeIntrusiveRefCnt<MultiplexExternalSemaSource>(Native, Registry);
+  Registry->Import = ObjC3SourceImportResult::Handled;
+  EXPECT_EQ(Multiplex->HandleObjC3SourceImport("Locked.Data", {}), ObjC3SourceImportResult::Handled);
+  EXPECT_EQ(Native->Imports, 1u);
+  EXPECT_EQ(Registry->Imports, 1u);
+  Native->Import = ObjC3SourceImportResult::Error;
+  EXPECT_EQ(Multiplex->HandleObjC3SourceImport("Locked.Data", {}), ObjC3SourceImportResult::Error);
+  EXPECT_EQ(Registry->Imports, 1u);
+  Native->Import = Registry->Import = ObjC3SourceImportResult::NotHandled;
+  EXPECT_EQ(Multiplex->HandleObjC3SourceImport("Native.Module", {}), ObjC3SourceImportResult::NotHandled);
+
+  auto AST = parse("int prior; int exported;", {"-x", "c++", "-std=c++20"});
+  ASSERT_TRUE(AST);
+  Native->Candidate = const_cast<NamedDecl *>(lookup(AST->getASTContext(), "prior"));
+  Registry->Candidate = const_cast<NamedDecl *>(lookup(AST->getASTContext(), "exported"));
+  ASSERT_TRUE(Native->Candidate && Registry->Candidate);
+  Registry->Lookup = ObjC3QualifiedNameLookupStatus::Found;
+  SmallVector<NamedDecl *, 4> Declarations;
+  EXPECT_EQ(Multiplex->LookupObjC3QualifiedName({}, 0, Declarations), ObjC3QualifiedNameLookupStatus::Found);
+  ASSERT_EQ(Declarations.size(), 1u);
+  EXPECT_EQ(Declarations.front(), Registry->Candidate);
+  Native->Candidate = nullptr;
+  for (auto Status : {ObjC3QualifiedNameLookupStatus::ModuleNotVisible,
+                      ObjC3QualifiedNameLookupStatus::NotFound,
+                      ObjC3QualifiedNameLookupStatus::Ambiguous}) {
+    Native->Lookup = Status;
+    unsigned Before = Registry->Lookups;
+    Declarations.clear();
+    EXPECT_EQ(Multiplex->LookupObjC3QualifiedName({}, 0, Declarations), Status);
+    EXPECT_EQ(Registry->Lookups, Before);
+    EXPECT_TRUE(Declarations.empty());
+  }
+  Native->Lookup = Registry->Lookup = ObjC3QualifiedNameLookupStatus::NotHandled;
+  EXPECT_EQ(Multiplex->LookupObjC3QualifiedName({}, 0, Declarations), ObjC3QualifiedNameLookupStatus::NotHandled);
+  EXPECT_TRUE(Declarations.empty());
+}
