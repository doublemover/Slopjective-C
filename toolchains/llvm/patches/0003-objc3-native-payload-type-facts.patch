@@ -0,0 +1,455 @@
+//===--- ObjC3TypeContracts.cpp - Clang-backed value type facts ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ObjC3TypeContracts.h"
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Type.h"
+#include "clang/Basic/LangOptions.h"
+#include "clang/Basic/TargetInfo.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/SHA256.h"
+
+using namespace clang;
+
+namespace {
+
+ObjC3ValueOperationFacts trivialOperation() { return {}; }
+
+ObjC3ValueOperationFacts generatedOperation(bool trivial,
+                                            bool knownDeleted = false,
+                                            bool needsSema = false) {
+  ObjC3ValueOperationFacts Facts;
+  Facts.IsTrivial = trivial;
+  Facts.NeedsGeneratedOperation = !trivial && !knownDeleted;
+  Facts.RequiresSemaResolution = needsSema;
+  Facts.KnownDeleted = knownDeleted;
+  return Facts;
+}
+
+bool isRetainablePointer(QualType QT) {
+  const Type *Ty = QT.getTypePtr();
+  return Ty->isObjCObjectPointerType() || Ty->isBlockPointerType() ||
+         Ty->isObjCNSObjectType();
+}
+
+bool hasARCManagedRecordField(QualType QT) {
+  llvm::SmallPtrSet<const Type *, 16> Seen;
+  auto Visit = [&](auto &&Self, QualType T) -> bool {
+    const auto Lifetime = T.getObjCLifetime();
+    if (Lifetime == Qualifiers::OCL_Strong || Lifetime == Qualifiers::OCL_Weak)
+      return true;
+    if (!Seen.insert(T.getCanonicalType().getTypePtr()).second) return false;
+    if (const auto *Array = T->getAsArrayTypeUnsafe())
+      return Self(Self, Array->getElementType());
+    if (const auto *Optional = T->getAs<ObjC3OptionalType>())
+      return Self(Self, Optional->getElementType());
+    if (const auto *Result = T->getAs<ObjC3ResultType>())
+      return Self(Self, Result->getSuccessType()) || Self(Self, Result->getErrorType());
+    if (const auto *Record = T->getAs<RecordType>()) {
+      const auto *RD = Record->getDecl()->getDefinition();
+      if (!RD) return false;
+      if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD))
+        for (const auto &Base : CXX->bases())
+          if (Self(Self, Base.getType())) return true;
+      for (const auto *Field : RD->fields())
+        if (Self(Self, Field->getType())) return true;
+    }
+    return false;
+  };
+  return Visit(Visit, QT);
+}
+
+void classifyLifetime(const ASTContext &Context, QualType QT,
+                      ObjC3ValueTypeFacts &Facts) {
+  Facts.IsObjCObjectPointer = QT->isObjCObjectPointerType();
+  Facts.IsBlockPointer = QT->isBlockPointerType();
+  Facts.HasExplicitObjCLifetime =
+      QT.hasQualifiers() && QT.getQualifiers().hasObjCLifetime();
+  Facts.WrittenObjCLifetime = QT.getObjCLifetime();
+  Facts.EffectiveObjCLifetime = Facts.WrittenObjCLifetime;
+  if (Context.getLangOpts().ObjCAutoRefCount && isRetainablePointer(QT) &&
+      Facts.EffectiveObjCLifetime == Qualifiers::OCL_None)
+    Facts.EffectiveObjCLifetime = QT->getObjCARCImplicitLifetime();
+}
+
+ObjC3ValueOperationFacts recordOperationFacts(const CXXRecordDecl *Record,
+                                              ObjC3ValueOperation Operation,
+                                              bool IsTrivial) {
+  if (!Record)
+    return generatedOperation(IsTrivial);
+
+  bool KnownDeleted = false;
+  // Even a trivial C++ special member may be private, deleted, or select a
+  // different overload for this expression. Facts cannot authorize its use.
+  const bool RequiresSema = true;
+  switch (Operation) {
+  case ObjC3ValueOperation::Copy:
+    if (!Record->needsOverloadResolutionForCopyConstructor())
+      KnownDeleted = Record->defaultedCopyConstructorIsDeleted();
+    break;
+  case ObjC3ValueOperation::Move:
+    // A missing move constructor may still select a copy constructor. Sema
+    // decides that at the use site; never infer move-only or noncopyable
+    // policy.
+    if (Record->hasMoveConstructor() &&
+        !Record->needsOverloadResolutionForMoveConstructor())
+      KnownDeleted = Record->defaultedMoveConstructorIsDeleted();
+    break;
+  case ObjC3ValueOperation::Destroy:
+    if (!Record->needsOverloadResolutionForDestructor())
+      KnownDeleted = Record->defaultedDestructorIsDeleted();
+    if (const CXXDestructorDecl *Dtor = Record->getDestructor())
+      KnownDeleted |= Dtor->isDeleted();
+    break;
+  }
+  return generatedOperation(IsTrivial, KnownDeleted, RequiresSema);
+}
+
+ObjC3PayloadTypeIssue reject(ObjC3ValueTypeFacts &Facts,
+                             ObjC3PayloadTypeIssue Issue) {
+  Facts.Issue = Issue;
+  return Issue;
+}
+
+} // namespace
+
+bool clang::hasObjC3CarrierManagedPayload(QualType Type) {
+  unsigned Budget = 256;
+  auto Visit = [&](auto &&Self, QualType T, unsigned Depth) -> bool {
+    if (T.isNull()) return false;
+    if (Depth > 64 || Budget == 0) return true;
+    --Budget;
+    if (T->isObjCObjectPointerType() || T->isBlockPointerType()) return true;
+    if (const auto *O = T->getAs<ObjC3OptionalType>())
+      return Self(Self, O->getElementType(), Depth + 1);
+    if (const auto *R = T->getAs<ObjC3ResultType>())
+      return Self(Self, R->getSuccessType(), Depth + 1) ||
+             Self(Self, R->getErrorType(), Depth + 1);
+    return false;
+  };
+  return !Type.isNull() && isa<ObjC3OptionalType, ObjC3ResultType>(
+      Type.getCanonicalType().getTypePtr()) && Visit(Visit, Type, 0);
+}
+
+namespace {
+bool containsStorage(QualType Type, bool ThrowingCopy, unsigned &Budget,
+                     unsigned Depth = 0, bool InCarrier = false) {
+  if (Type.isNull()) return false;
+  if (Depth > 64 || Budget == 0) return true;
+  --Budget;
+  if (const auto *Array = Type->getAsArrayTypeUnsafe())
+    return containsStorage(Array->getElementType(), ThrowingCopy, Budget,
+                           Depth + 1, InCarrier);
+  if (const auto *Optional = Type->getAs<ObjC3OptionalType>())
+    return ThrowingCopy ? containsStorage(Optional->getElementType(), true,
+        Budget, Depth + 1, true) : hasObjC3CarrierManagedPayload(Type);
+  if (const auto *Result = Type->getAs<ObjC3ResultType>())
+    return ThrowingCopy ?
+        containsStorage(Result->getSuccessType(), true, Budget, Depth + 1, true) ||
+        containsStorage(Result->getErrorType(), true, Budget, Depth + 1, true) :
+        hasObjC3CarrierManagedPayload(Type);
+  if (ThrowingCopy && InCarrier && Type->isBlockPointerType())
+    return Type.getObjCLifetime() == Qualifiers::OCL_Strong;
+  if (const auto *Record = Type->getAs<RecordType>()) {
+    if (ThrowingCopy && containsObjC3CarrierManagedStorage(Type)) InCarrier = true;
+    const auto *RD = Record->getDecl()->getDefinition();
+    if (!RD) return false;
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD))
+      for (const auto &Base : CXX->bases())
+        if (containsStorage(Base.getType(), ThrowingCopy, Budget, Depth + 1,
+                            InCarrier)) return true;
+    for (const auto *Field : RD->fields())
+      if (containsStorage(Field->getType(), ThrowingCopy, Budget, Depth + 1,
+                          InCarrier)) return true;
+  }
+  return false;
+}
+}
+bool clang::containsObjC3CarrierManagedStorage(QualType Type) {
+  unsigned Budget = 256;
+  return containsStorage(Type, false, Budget);
+}
+bool clang::containsObjC3CarrierThrowingCopy(QualType Type) {
+  unsigned Budget = 256;
+  return containsStorage(Type, true, Budget);
+}
+
+static ObjC3ValueTypeFacts
+getValueTypeFacts(const ASTContext &Context, QualType PayloadType,
+                  ObjC3PayloadPosition Position,
+                  llvm::DenseMap<QualType, ObjC3ValueTypeFacts> &Children) {
+  ObjC3ValueTypeFacts Facts;
+  Facts.WrittenType = PayloadType;
+  Facts.Position = Position;
+  if (PayloadType.isNull())
+    return Facts;
+  Facts.CanonicalType = Context.getCanonicalType(PayloadType);
+
+  const Type *Ty = PayloadType.getTypePtr();
+  if (Ty->isDependentType()) {
+    reject(Facts, ObjC3PayloadTypeIssue::Dependent);
+    return Facts;
+  }
+  if (Ty->isVariablyModifiedType()) {
+    reject(Facts, ObjC3PayloadTypeIssue::VariablyModified);
+    return Facts;
+  }
+  if (Ty->isFunctionType()) {
+    Facts.Kind = ObjC3PayloadTypeKind::Function;
+    reject(Facts, ObjC3PayloadTypeIssue::Function);
+    return Facts;
+  }
+  if (Ty->isReferenceType()) {
+    Facts.Kind = ObjC3PayloadTypeKind::Reference;
+    reject(Facts, ObjC3PayloadTypeIssue::Reference);
+    return Facts;
+  }
+  if (Ty->isVoidType()) {
+    Facts.Kind = ObjC3PayloadTypeKind::Void;
+    Facts.Issue = ObjC3PayloadTypeIssue::None;
+    Facts.Copy = trivialOperation();
+    Facts.Move = trivialOperation();
+    Facts.Destroy = trivialOperation();
+    return Facts;
+  }
+  if (Ty->isIncompleteType()) {
+    reject(Facts, ObjC3PayloadTypeIssue::Incomplete);
+    return Facts;
+  }
+  if (Ty->isArrayType()) {
+    Facts.Kind = ObjC3PayloadTypeKind::Array;
+    reject(Facts, ObjC3PayloadTypeIssue::ArrayNeedsElementOperations);
+    return Facts;
+  }
+  if (Ty->isAtomicType()) {
+    Facts.Kind = ObjC3PayloadTypeKind::Atomic;
+    reject(Facts, ObjC3PayloadTypeIssue::AtomicNeedsAtomicOperations);
+    return Facts;
+  }
+  if (!Ty->isObjectType()) {
+    reject(Facts, ObjC3PayloadTypeIssue::NotAnObjectType);
+    return Facts;
+  }
+
+  if (Ty->isBuiltinType())
+    Facts.Kind = ObjC3PayloadTypeKind::Builtin;
+  else if (Ty->isEnumeralType())
+    Facts.Kind = ObjC3PayloadTypeKind::Enumeration;
+  else if (Ty->isObjCObjectPointerType())
+    Facts.Kind = ObjC3PayloadTypeKind::ObjCObjectPointer;
+  else if (Ty->isBlockPointerType())
+    Facts.Kind = ObjC3PayloadTypeKind::BlockPointer;
+  else if (Ty->isPointerType())
+    Facts.Kind = ObjC3PayloadTypeKind::CPointer;
+  else if (Ty->isMemberPointerType())
+    Facts.Kind = ObjC3PayloadTypeKind::MemberPointer;
+  else if (Ty->isRecordType())
+    Facts.Kind = ObjC3PayloadTypeKind::Record;
+  else if (Ty->isObjCObjectType())
+    Facts.Kind = ObjC3PayloadTypeKind::ObjCObject;
+  else
+    Facts.Kind = ObjC3PayloadTypeKind::OtherObject;
+
+  if (Facts.Kind == ObjC3PayloadTypeKind::ObjCObject) {
+    reject(Facts, ObjC3PayloadTypeIssue::NotAnObjectType);
+    return Facts;
+  }
+
+  if (const RecordType *RecordTy = Ty->getAs<RecordType>()) {
+    const RecordDecl *Record = RecordTy->getDecl();
+    Facts.IsRecord = true;
+    Facts.IsUnion = Record->isUnion();
+    Facts.HasARCManagedRecordFields = hasARCManagedRecordField(PayloadType);
+    Facts.IsAbstractRecord = false;
+    Facts.IsTriviallyCopyable = PayloadType.isTriviallyCopyableType(Context);
+    if (Record->hasFlexibleArrayMember()) {
+      reject(Facts, ObjC3PayloadTypeIssue::RecordHasFlexibleArrayMember);
+      return Facts;
+    }
+
+    if (const auto *CXXRecord = dyn_cast<CXXRecordDecl>(Record)) {
+      Facts.IsAbstractRecord = CXXRecord->isAbstract();
+      Facts.Copy = recordOperationFacts(CXXRecord, ObjC3ValueOperation::Copy,
+                                        CXXRecord->hasTrivialCopyConstructor());
+      Facts.Move = recordOperationFacts(CXXRecord, ObjC3ValueOperation::Move,
+                                        CXXRecord->hasTrivialMoveConstructor());
+      Facts.Destroy =
+          recordOperationFacts(CXXRecord, ObjC3ValueOperation::Destroy,
+                               CXXRecord->hasTrivialDestructor());
+    } else {
+      const auto CopyKind = PayloadType.isNonTrivialToPrimitiveCopy();
+      const auto MoveKind =
+          PayloadType.isNonTrivialToPrimitiveDestructiveMove();
+      Facts.Copy = generatedOperation(CopyKind == QualType::PCK_Trivial);
+      Facts.Move = generatedOperation(MoveKind == QualType::PCK_Trivial);
+      Facts.Destroy = generatedOperation(PayloadType.isDestructedType() ==
+                                         QualType::DK_none);
+    }
+  } else if (isa<ObjC3OptionalType, ObjC3ResultType>(
+                 Context.getCanonicalType(PayloadType).getTypePtr())) {
+    SmallVector<QualType, 2> Arms;
+    if (const auto *O = PayloadType->getAs<ObjC3OptionalType>())
+      Arms.push_back(O->getElementType());
+    else {
+      const auto *R = PayloadType->castAs<ObjC3ResultType>();
+      Arms.push_back(R->getSuccessType());
+      Arms.push_back(R->getErrorType());
+    }
+    bool Copy = true, Move = true, Destroy = true;
+    for (QualType Arm : Arms) {
+      auto Found = Children.find(Arm);
+      if (Found == Children.end()) {
+        auto Child = getValueTypeFacts(Context, Arm, Position, Children);
+        Found = Children.try_emplace(Arm, Child).first;
+      }
+      const auto &Child = Found->second;
+      Copy &= Child.Copy.IsTrivial;
+      Move &= Child.Move.IsTrivial;
+      Destroy &= Child.Destroy.IsTrivial;
+    }
+    Facts.Copy = generatedOperation(Copy);
+    Facts.Move = generatedOperation(Move);
+    Facts.Destroy = generatedOperation(Destroy);
+    Facts.IsTriviallyCopyable = Copy && Destroy;
+  } else {
+    classifyLifetime(Context, PayloadType, Facts);
+    const bool ARCManaged =
+        Context.getLangOpts().ObjCAutoRefCount &&
+        (Facts.EffectiveObjCLifetime == Qualifiers::OCL_Strong ||
+         Facts.EffectiveObjCLifetime == Qualifiers::OCL_Weak);
+    Facts.IsTriviallyCopyable = PayloadType.isTriviallyCopyableType(Context);
+    const bool IsNonTrivialBlock = Facts.IsBlockPointer;
+    Facts.Copy = generatedOperation(!ARCManaged && !IsNonTrivialBlock);
+    Facts.Move = generatedOperation(!ARCManaged && !IsNonTrivialBlock);
+    Facts.Destroy =
+        generatedOperation(!ARCManaged && !IsNonTrivialBlock &&
+                           PayloadType.isDestructedType() == QualType::DK_none);
+  }
+
+  const TypeInfoChars Layout = Context.getTypeInfoInChars(PayloadType);
+  Facts.Size = Layout.Width;
+  Facts.Alignment = Layout.Align;
+  Facts.HasObjectLayout = true;
+  Facts.Issue = ObjC3PayloadTypeIssue::None;
+  return Facts;
+}
+
+ObjC3ValueTypeFacts
+clang::getObjC3ValueTypeFacts(const ASTContext &Context, QualType PayloadType,
+                            ObjC3PayloadPosition Position) {
+  // Shared carrier types form a DAG. Reuse child facts so Result<T,T> chains
+  // cost the number of distinct types rather than every expanded arm path.
+  llvm::DenseMap<QualType, ObjC3ValueTypeFacts> Children;
+  return getValueTypeFacts(Context, PayloadType, Position, Children);
+}
+
+bool clang::getObjC3CarrierRuntimeEncoding(const ASTContext &Ctx, QualType Type,
+                                           std::string &Encoding) {
+  const auto &Triple = Ctx.getTargetInfo().getTriple();
+  const auto &Lang = Ctx.getLangOpts();
+  if (!Lang.ObjCAutoRefCount || Type.isNull() || Type.isVolatileQualified() ||
+      Triple.getArch() != llvm::Triple::x86_64 || !Triple.isOSLinux() ||
+      !Triple.isGNUEnvironment() ||
+      Lang.ObjCRuntime.getKind() != ObjCRuntime::GNUstep ||
+      Lang.ObjCRuntime.getVersion() != VersionTuple(2, 2))
+    return false;
+  if (!hasObjC3CarrierManagedPayload(Type))
+    return false;
+  unsigned Budget = 256;
+  auto Encode = [&](auto &&Self, QualType Carrier, std::string &Out,
+                    unsigned Depth) -> bool {
+    if (Depth > 64 || Budget == 0 || Carrier.isVolatileQualified())
+      return false;
+    --Budget;
+    Carrier = Ctx.getCanonicalType(Carrier);
+    SmallVector<QualType, 2> Leaves;
+    bool IsOptional = false;
+    if (const auto *Optional = Carrier->getAs<ObjC3OptionalType>()) {
+      IsOptional = true;
+      Leaves.push_back(Optional->getElementType());
+    } else if (const auto *Result = Carrier->getAs<ObjC3ResultType>()) {
+      Leaves.push_back(Result->getSuccessType());
+      Leaves.push_back(Result->getErrorType());
+    } else {
+      return false;
+    }
+    std::string Name = IsOptional ? "__objc3_v12_optional" : "__objc3_v12_result";
+    std::string Fields;
+    for (QualType Leaf : Leaves) {
+      if (Leaf.isVolatileQualified())
+        return false;
+      char Ownership = 'P';
+      std::string Field;
+      const bool Nested = isa<ObjC3OptionalType, ObjC3ResultType>(
+          Ctx.getCanonicalType(Leaf).getTypePtr());
+      if (Nested) {
+        Ownership = 'N';
+        if (!Self(Self, Leaf, Field, Depth + 1))
+          return false;
+      } else {
+        if (Leaf->isObjCObjectPointerType() || Leaf->isBlockPointerType()) {
+          switch (Leaf.getObjCLifetime()) {
+          case Qualifiers::OCL_Strong:
+            Ownership = 'S';
+            break;
+          case Qualifiers::OCL_Weak:
+            Ownership = 'W';
+            break;
+          case Qualifiers::OCL_ExplicitNone:
+            Ownership = 'U';
+            break;
+          default:
+            return false;
+          }
+        } else if (!(Leaf->isVoidType() || Leaf->isIntegerType() ||
+                     Leaf->isEnumeralType() || Leaf->isRealFloatingType() ||
+                     Leaf->isPointerType())) {
+          return false;
+        }
+        QualType NotEncoded;
+        Ctx.getObjCEncodingForType(Leaf, Field, nullptr, &NotEncoded);
+        if (!NotEncoded.isNull() || Field.empty())
+          return false;
+        // Match the shipped GNU runtime codec, including its scalar bounds.
+        if (!((Field.size() == 1 &&
+               StringRef("v@#:*cCsSiIlLqQBfdD").contains(Field[0])) ||
+              Field == "@?" || Field == "^v"))
+          return false;
+      }
+      Name += '_';
+      Name += Ownership;
+      if (Nested) {
+        // Hash only the nominal child identity. Embedding its hex-encoded
+        // encoding here would make a linear nesting chain grow exponentially.
+        llvm::SHA256 Hash;
+        Hash.update(Field);
+        Name += llvm::toHex(Hash.final());
+      } else {
+        Name += llvm::toHex(Field);
+      }
+      if (!Leaf->isVoidType())
+        Fields += Field;
+    }
+    auto Representation = Ctx.getObjC3CarrierRepresentationType(Carrier);
+    if (Representation.State !=
+        ObjC3CarrierRepresentationInfo::Status::Materialized)
+      return false;
+    // Recursively mirror native boolean/union layout and ownership identity.
+    Out = "{" + Name + "=B(__objc3_v12_payload=" + Fields + ")}";
+    return true;
+  };
+  std::string Result;
+  if (!Encode(Encode, Type, Result, 0))
+    return false;
+  Encoding += Result;
+  return true;
+}
