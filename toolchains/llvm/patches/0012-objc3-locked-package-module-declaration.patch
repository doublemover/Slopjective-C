diff --git a/clang/lib/Parse/ParseObjc.cpp b/clang/lib/Parse/ParseObjc.cpp
index 265e88a..990c877 100644
--- a/clang/lib/Parse/ParseObjc.cpp
+++ b/clang/lib/Parse/ParseObjc.cpp
@@ -65,6 +65,48 @@ Parser::ParseObjCAtDirectives(ParsedAttributes &DeclAttrs,
     return nullptr;
   }
 
+  // The package graph has already selected the owning interface identity.
+  // A source declaration makes that identity explicit without changing it.
+  if (getLangOpts().ObjC3 && Tok.is(tok::identifier) &&
+      Tok.getIdentifierInfo()->isStr("module")) {
+    ConsumeToken();
+    if (!DeclAttrs.empty() || AtLoc.isMacroID() ||
+        !PP.getSourceManager().isWrittenInMainFile(AtLoc)) {
+      Diag(AtLoc, diag::err_objc3_module_context);
+      SkipUntil(tok::semi, StopAtSemi);
+      TryConsumeToken(tok::semi);
+      return nullptr;
+    }
+    const SourceLocation NameLoc = Tok.getLocation();
+    llvm::SmallString<128> Name;
+    do {
+      if (Tok.isNot(tok::identifier)) {
+        Diag(Tok, diag::err_expected_ident);
+        SkipUntil(tok::semi, StopAtSemi);
+        TryConsumeToken(tok::semi);
+        return nullptr;
+      }
+      if (!Name.empty())
+        Name.push_back('.');
+      Name += Tok.getIdentifierInfo()->getName();
+      ConsumeToken();
+    } while (TryConsumeToken(tok::period));
+    if (ExpectAndConsume(tok::semi, diag::err_module_expected_semi))
+      return nullptr;
+    if (!PP.markObjC3PackageDeclaration()) {
+      Diag(AtLoc, diag::err_objc3_module_duplicate);
+      return nullptr;
+    }
+    StringRef Owner = PP.getObjC3PackageOwner();
+    if (Owner.empty())
+      Owner = getLangOpts().CurrentModule;
+    if (Owner.empty())
+      Diag(NameLoc, diag::err_objc3_module_no_owner) << Name.str();
+    else if (Owner != Name)
+      Diag(NameLoc, diag::err_objc3_module_owner_mismatch) << Name.str() << Owner;
+    return nullptr;
+  }
+
   switch (Tok.getObjCKeywordID()) {
   case tok::objc_interface:
   case tok::objc_protocol:
