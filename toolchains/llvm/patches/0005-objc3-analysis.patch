+bool CFGBuilder::supportsObjC3NewInitialization(const CXXNewExpr *New) const {
+  const Expr *Initializer = New->getInitializer();
+  if (Initializer && New->shouldNullCheckAllocation()) return false;
+  if (New->isArray()) {
+    const Expr *Size = New->getArraySize().value_or(nullptr);
+    auto Count = Size ? Size->getIntegerConstantExpr(*Context) : std::nullopt;
+    if (!Count || Count->isNegative() || Count->getLimitedValue() > 64 ||
+        (!isNonThrowingNewInitializer(Initializer) &&
+         (!isObjC3ArrayConstructorGroup(Initializer, *Context) ||
+          New->getNumPlacementArgs() || !New->getOperatorDelete()))) return false;
+    QualType Element = New->getAllocatedType();
+    if (Element->isIncompleteType() || Element->isDependentType() || Element->isArrayType()) return false;
+    uint64_t Bytes = Context->getTypeSizeInChars(Element).getQuantity();
+    unsigned Width = Context->getIntWidth(Context->getSizeType());
+    if (Width > 64 || Bytes > (1ULL << 30)) return false;
+    uint64_t Limit = Width == 64 ? ~0ULL : (1ULL << Width) - 1;
+    uint64_t Overhead = 2 * std::max<uint64_t>(Bytes, Width / 8);
+    if (Overhead > Limit || Bytes > (Limit - Overhead) / std::max<uint64_t>(Count->getLimitedValue(), 1)) return false;
+    // Repeated default arguments with source effects need per-element facts.
+    SmallVector<const Stmt *, 8> Pending{Initializer};unsigned Budget = 256;
+    while (!Pending.empty()) {
+      const Stmt *Node = Pending.pop_back_val();if (!Node) continue;
+      if (!Budget--) return false;
+      if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Node))
+        if (Constructor->getNumArgs()) return false;
+      if (isa<CallExpr, ObjCMessageExpr, LambdaExpr, BlockExpr>(Node)) return false;
+      if (const auto *List = dyn_cast<InitListExpr>(Node))
+        if (const Expr *Filler = List->getArrayFiller()) Pending.push_back(Filler);
+      for (const Stmt *Child : Node->children()) Pending.push_back(Child);
+    }
+    return true;
+  }
+  if (isNonThrowingNewInitializer(Initializer)) return true;
+  if (!Initializer || !New->getConstructExpr() || New->getNumPlacementArgs() ||
+      !New->getOperatorDelete() || containsFullExpressionTemporary(Initializer)) return false;
+  // This recipe registers ordinary scalar storage around primitive constructor
+  // arguments. Managed argument temporaries and nested allocations keep gates.
+  SmallVector<const Stmt *, 16> Pending{Initializer};unsigned Budget = 256;
+  while (!Pending.empty()) {
+    const Stmt *Node = Pending.pop_back_val();if (!Node) continue;
+    if (!Budget--) return false;
+    if (isa<LambdaExpr, BlockExpr, CXXNewExpr, StmtExpr, CoroutineSuspendExpr,
+            ObjC3MatchExpr, ObjC3ResourceExpr, ObjCMessageExpr>(Node)) return false;
+    if (const auto *Expression = dyn_cast<Expr>(Node); Expression && Node != Initializer)
+      if ((!Expression->getType()->isScalarType() && !Expression->getType()->isFunctionType() &&
+           !Expression->getType()->isArrayType() && !Expression->getType()->isVoidType()) ||
+          Expression->getType()->isObjCRetainableType() ||
+          (Expression->getType()->isArrayType() &&
+           Context->getBaseElementType(Expression->getType())->isObjCRetainableType())) return false;
+    for (const Stmt *Child : Node->children()) Pending.push_back(Child);
+  }
+  return true;
+}
