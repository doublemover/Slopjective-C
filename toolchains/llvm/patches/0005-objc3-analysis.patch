+bool CFGBuilder::collectObjC3InitLeaves(QualType Type, Expr *Initializer,
+    SmallVectorImpl<std::pair<QualType, Expr *>> &Leaves,
+    SmallVectorImpl<const InitListExpr *> &Lists, unsigned &Budget) const {
+  if (!Initializer || !Budget || Leaves.size() >= 64 ||
+      Type.isNull() || Type->isDependentType()) return false;
+  --Budget;
+  Expr *Value = Initializer->IgnoreParens();
+  while (auto *Cleanups = dyn_cast<ExprWithCleanups>(Value))
+    Value = Cleanups->getSubExpr()->IgnoreParens();
+  auto *List = dyn_cast<InitListExpr>(Value);
+  if (List) {
+    if (List->isSyntacticForm() && List->getSemanticForm())
+      List = List->getSemanticForm();
+    Lists.push_back(List);
+  }
+  if (const auto *Array = Context->getAsConstantArrayType(Type)) {
+    if (!List || Array->getSize().getLimitedValue() > 64) return false;
+    for (Expr *Element : List->inits())
+      if (!collectObjC3InitLeaves(Array->getElementType(), Element,
+                                 Leaves, Lists, Budget)) return false;
+    return true; // Missing entries are implicit zeroes, without owner claims.
+  }
+  if (const auto *Record = Type->getAs<RecordType>()) {
+    if (!List) return false;
+    const RecordDecl *Definition = Record->getDecl()->getDefinition();
+    if (!Definition || Definition->isUnion()) return false;
+    auto Fields = Definition->field_begin();
+    for (Expr *Element : List->inits()) {
+      while (Fields != Definition->field_end() && (*Fields)->isUnnamedBitField()) ++Fields;
+      if (Fields == Definition->field_end()) return false;
+      QualType FieldType = (*Fields++)->getType();
+      if (!collectObjC3InitLeaves(FieldType, Element, Leaves, Lists, Budget)) return false;
+    }
+    return true;
+  }
+  if (List) {
+    if (List->getNumInits() != 1) return false;
+    return collectObjC3InitLeaves(Type, List->getInit(0), Leaves, Lists, Budget);
+  }
+  Leaves.emplace_back(Type, Initializer);return true;
+}
+
+bool CFGBuilder::prepareObjC3PartialInitializers(Stmt *Body) {
+  SmallVector<Stmt *, 32> Pending{Body};
+  llvm::SmallPtrSet<const Stmt *, 32> Seen;
+  unsigned WalkBudget = 8192;
+  while (!Pending.empty()) {
+    Stmt *Node = Pending.pop_back_val();
+    if (!Node || !Seen.insert(Node).second) continue;
+    if (!WalkBudget--) return false;
+    SmallVector<std::pair<QualType, Expr *>, 16> Leaves;
+    SmallVector<const InitListExpr *, 8> Lists;
+    VarDecl *Variable = nullptr;
+    auto *Lambda = dyn_cast<LambdaExpr>(Node);
+    bool Candidate = false;
+    unsigned Budget = 256;
+    if (auto *Declarations = dyn_cast<DeclStmt>(Node); Declarations && Declarations->isSingleDecl()) {
+      Variable = dyn_cast<VarDecl>(Declarations->getSingleDecl());
+      if (Variable && Variable->hasInit() && Variable->hasLocalStorage() &&
+          !Variable->isStaticLocal() && !Variable->getType()->isReferenceType()) {
+        Expr *Init = Variable->getInit();
+        if (auto *Cleanups = dyn_cast<ExprWithCleanups>(Init)) Init = Cleanups->getSubExpr();
+        if (auto *Binding = dyn_cast<CXXBindTemporaryExpr>(Init))
+          if (isa<LambdaExpr>(Binding->getSubExpr())) ObjC3LocalClosureBindings.insert(Binding);
+      }
+      if (Variable && Variable->hasLocalStorage() && !Variable->isStaticLocal() &&
+          Variable->hasInit() && !Variable->getType()->isObjCRetainableType() &&
+          Variable->getType().isDestructedType() != QualType::DK_none &&
+          hasPrimitiveARCStorage(Variable->getType()) &&
+          !containsFullExpressionTemporary(Variable->getInit()))
+        Candidate = collectObjC3InitLeaves(Variable->getType(), Variable->getInit(),
+                                         Leaves, Lists, Budget);
+      if (Candidate && llvm::all_of(Leaves, [](const auto &Leaf) {
+            return isObjC3PassiveInitialization(Leaf.second);
+          })) Candidate = false;
+    } else if (Lambda && !Lambda->getLambdaClass()->hasTrivialDestructor() &&
+               hasPrimitiveARCStorage(Lambda->getType())) {
+      const bool Passive = llvm::all_of(Lambda->capture_inits(), [](const Expr *Init) {
+        return isObjC3PassiveInitialization(Init);
+      });
+      if (Passive) ObjC3InitClosures[Lambda] = {};
+      auto Field = Lambda->getLambdaClass()->field_begin();
+      Candidate = !Passive;
+      for (Expr *Init : Lambda->capture_inits()) {
+        if (Passive) break;
+        if (Field == Lambda->getLambdaClass()->field_end() ||
+            containsFullExpressionTemporary(Init) ||
+            !collectObjC3InitLeaves((*Field++)->getType(), Init, Leaves, Lists, Budget)) {
+          Candidate = false;break;
+        }
+      }
+    }
+    if (Candidate) {
+      llvm::SmallPtrSet<const Expr *, 32> Unique;
+      for (auto [Type, Init] : Leaves)
+        if (!Unique.insert(Init).second || ObjC3InitPrefixes.count(Init)) Candidate = false;
+    }
+    if (Candidate) {
+      ObjC3InitPinList Pins;
+      for (auto [Type, Init] : Leaves) {
+        ObjC3InitPrefixes[Init] = Pins;
+        if (!Type->isObjCObjectPointerType() ||
+            Type.getObjCLifetime() != Qualifiers::OCL_Strong) continue;
+        VarDecl *Pin = createObjC3RuntimeVariable("__objc3_cfg_initialized_owner",
+            Type, Init, "objc3.cfg.initialized-owner", Init->getBeginLoc());
+        Pin->addAttr(ObjC3LifetimeBindingAttr::CreateImplicit(*Context));
+        ObjC3InitAcquisitions[Init] = Pin;Pins.push_back(Pin);
+      }
+      if (ObjC3InitAcquisitions.size() > 64 || ObjC3InitPrefixes.size() > 4096)
+        return false;
+      for (const InitListExpr *List : Lists) ObjC3InitLists.insert(List);
+      if (Variable) ObjC3InitVariables[Variable] = Pins;
+      else ObjC3InitClosures[Lambda] = Pins;
+    }
+    if (Lambda) {
+      for (Expr *Init : Lambda->capture_inits()) Pending.push_back(Init);
+    } else if (!isa<BlockExpr>(Node))
+      for (Stmt *Child : Node->children()) Pending.push_back(Child);
+  }
+  return true;
+}
