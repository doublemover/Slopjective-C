+FunctionDecl *CFGBuilder::createObjC3RuntimeHelper(StringRef Name,
+    QualType Result, ArrayRef<QualType> Parameters, bool NoThrow,
+    SourceLocation Loc) {
+  FunctionProtoType::ExtProtoInfo Info;
+  QualType Type = Context->getFunctionType(Result, Parameters, Info);
+  auto *Function = FunctionDecl::Create(*Context, Context->getTranslationUnitDecl(),
+      Loc, Loc, &Context->Idents.get(Name), Type,
+      Context->getTrivialTypeSourceInfo(Type, Loc), SC_Static);
+  Function->setImplicit();
+  Function->addAttr(AnnotateAttr::CreateImplicit(*Context,
+      "objc3.cfg.runtime-helper", nullptr, 0));
+  if (NoThrow) Function->addAttr(NoThrowAttr::CreateImplicit(*Context));
+  SmallVector<ParmVarDecl *, 1> Declarations;
+  for (QualType Parameter : Parameters)
+    Declarations.push_back(ParmVarDecl::Create(*Context, Function, Loc, Loc,
+        nullptr, Parameter, Context->getTrivialTypeSourceInfo(Parameter, Loc),
+        SC_None, nullptr));
+  Function->setParams(Declarations);
+  return Function;
+}
+
+VarDecl *CFGBuilder::createObjC3RuntimeVariable(StringRef Name, QualType Type,
+    Expr *Initializer, StringRef Kind, SourceLocation Loc) {
+  auto *Variable = VarDecl::Create(*Context, ObjC3RuntimeOwner, Loc, Loc,
+      &Context->Idents.get(Name), Type,
+      Context->getTrivialTypeSourceInfo(Type, Loc), SC_None);
+  Variable->setImplicit();Variable->setInit(Initializer);
+  Variable->addAttr(AnnotateAttr::CreateImplicit(*Context, Kind, nullptr, 0));
+  return Variable;
+}
