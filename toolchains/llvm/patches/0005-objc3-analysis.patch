+CFGBlock *CFGBuilder::VisitObjC3RuntimeScope(Stmt *Statement, Stmt *Body,
+                                           Expr *Lock) {
+  assert(ObjC3RuntimeOwner && HasScopeExitActions);
+  const SourceLocation Loc = Statement->getBeginLoc();
+  SaveAndRestore SaveScope(ScopePos);
+  const auto Before = ScopePos;
+  LocalScope *Scope = nullptr;
+  VarDecl *Snapshot = nullptr;
+  Expr *Token = nullptr;
+  if (Lock) {
+    QualType Type = Lock->getType();
+    if (Context->getLangOpts().ObjCAutoRefCount) {
+      Qualifiers Quals = Type.getQualifiers();
+      Quals.setObjCLifetime(Qualifiers::OCL_Strong);
+      Type = Context->getQualifiedType(Type.getUnqualifiedType(), Quals);
+    }
+    Snapshot = createObjC3RuntimeVariable("__objc3_cfg_sync_receiver", Type,
+        Lock, Context->getLangOpts().ObjCAutoRefCount
+                  ? "objc3.cfg.sync-owner" : "objc3.cfg.sync-unowned", Loc);
+    if (Context->getLangOpts().ObjCAutoRefCount)
+      Snapshot->addAttr(ObjC3LifetimeBindingAttr::CreateImplicit(*Context));
+    Scope = addLocalScopeForVarDecl(Snapshot, Scope);
+    auto *Reference = DeclRefExpr::Create(*Context, NestedNameSpecifierLoc{},
+        SourceLocation(), Snapshot, false,
+        DeclarationNameInfo(Snapshot->getDeclName(), Loc), Type, VK_LValue);
+    Expr *Value = ImplicitCastExpr::Create(*Context, Type, CK_LValueToRValue,
+        Reference, nullptr, VK_PRValue, FPOptionsOverride());
+    Token = ImplicitCastExpr::Create(*Context, Context->VoidPtrTy, CK_BitCast,
+        Value, nullptr, VK_PRValue, FPOptionsOverride());
+  } else {
+    auto *Push = createObjC3RuntimeHelper("__objc3_cfg_pool_push",
+        Context->VoidPtrTy, {}, true, Loc);
+    Expr *Reference = DeclRefExpr::Create(*Context, NestedNameSpecifierLoc{},
+        SourceLocation(), Push, false,
+        DeclarationNameInfo(Push->getDeclName(), Loc), Push->getType(), VK_LValue);
+    Expr *Function = ImplicitCastExpr::Create(*Context,
+        Context->getPointerType(Push->getType()), CK_FunctionToPointerDecay,
+        Reference, nullptr, VK_PRValue, FPOptionsOverride());
+    Token = CallExpr::Create(*Context, Function, {}, Context->VoidPtrTy,
+        VK_PRValue, Loc, FPOptionsOverride());
+  }
+  auto *Guard = createObjC3RuntimeVariable(Lock ? "__objc3_cfg_sync_guard"
+                                              : "__objc3_cfg_pool_guard",
+      Context->VoidPtrTy, Token,
+      Lock ? "objc3.cfg.sync" : "objc3.cfg.pool", Loc);
+  QualType Address = Context->getPointerType(Context->VoidPtrTy);
+  auto *Cleanup = createObjC3RuntimeHelper(Lock ? "__objc3_cfg_sync_exit"
+                                               : "__objc3_cfg_pool_pop",
+      Context->VoidTy, {Address}, Lock != nullptr, Loc);
+  Guard->addAttr(CleanupAttr::CreateImplicit(*Context, Cleanup));
+  if (!Lock) {
+    ObjC3RuntimePoolGuards.insert(Guard);
+    if (!ObjC3AsyncRuntimePools) ObjC3NormalOnlyRuntimeGuards.insert(Guard);
+  }
+  Scope = addLocalScopeForVarDecl(Guard, Scope);
+  addAutomaticObjHandling(ScopePos, Before, Statement);
+  CFGBlock *Continuation = Block ? Block : Succ;
+  Block = nullptr;Succ = Continuation;
+  if (CFGBlock *Entry = addStmt(Body)) Block = Entry;
+  else if (!badCFG) Block = Continuation;
+  if (badCFG) return nullptr;
+  autoCreateBlock();
+  // Unlike optional diagnostic scope markers, this is a semantic registration
+  // event: acquisition completed, and only now is its cleanup active.
+  Block->appendScopeBegin(Guard, Statement, cfg->getBumpVectorContext());
+  auto *Registration = new (*Context) DeclStmt(DeclGroupRef(Guard), Loc, Loc);
+  VisitDeclStmt(Registration);
+  if (badCFG) return nullptr;
+  if (Snapshot) {
+    auto *Initialization = new (*Context) DeclStmt(DeclGroupRef(Snapshot), Loc, Loc);
+    VisitDeclStmt(Initialization);
+  }
+  return Block;
+}
