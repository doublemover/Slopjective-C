+CFGBlock *CFGBuilder::VisitObjC3CatchStmt(ObjC3CatchStmt *S) {
+  SaveAndRestore SaveScope(ScopePos);
+  if (DeclStmt *Binding = S->getBindingDeclStmt()) {
+    auto *Variable = cast<VarDecl>(Binding->getSingleDecl());
+    LocalScope::const_iterator Begin = ScopePos;
+    addLocalScopeForVarDecl(Variable);
+    addAutomaticObjHandling(ScopePos, Begin, S);
+  }
+  addStmt(S->getHandlerBody());
+  CFGBlock *Entry = Block ? Block : createBlock();
+  appendStmt(Entry, S);
+  Entry->setLabel(S);
+  return Entry;
+}
