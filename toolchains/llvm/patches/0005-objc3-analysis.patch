+bool CFGBuilder::prepareObjC3Subobjects(const Decl *D, const Stmt *Body) {
+  ObjC3SubobjectBody = Body;
+  const auto *Method = dyn_cast<CXXMethodDecl>(D);
+  if (!Method || !Method->getParent()->hasDefinition()) return false;
+  ObjC3FunctionTryBody = dyn_cast_or_null<CXXTryStmt>(Body);
+  const auto *Constructor = dyn_cast<CXXConstructorDecl>(D);
+  ObjC3DestructorOwner = dyn_cast<CXXDestructorDecl>(D);
+  ObjC3SubobjectNoexcept = !mayThrowNative(Method);
+  const auto *Record = Method->getParent();
+  auto Add = [&](FieldDecl *Field, const CXXBaseSpecifier *Base, QualType Type) {
+    if (Type.isNull() || Type->isDependentType() || Type->isIncompleteType() ||
+        getObjC3ResourceTypeContract(*Context, Type).Cleanup ||
+        (Field && (Field->hasAttr<ObjCResourceAttr>() || Field->hasAttr<ObjCCleanupAttr>() || Field->hasAttr<CleanupAttr>()))) return false;
+    uint64_t Elements = 1;
+    if (const auto *Array = Context->getAsConstantArrayType(Type))
+      Elements = Context->getConstantArrayElementCount(Array);
+    if (!Elements || Type.isDestructedType() == QualType::DK_none) return true;
+    const auto *Class = Context->getBaseElementType(Type)->getAsCXXRecordDecl();
+    // Anonymous union lifetime is controlled by its active member. The parent
+    // destructor never implicitly destroys the anonymous union's deleted dtor.
+    if (Class && Class->isUnion() && Class->isAnonymousStructOrUnion()) return true;
+    const auto *Destructor = Class ? Class->getDestructor() : nullptr;
+    if (Class && !Class->hasTrivialDestructor() && !Destructor) return false;
+    if (!Class && !hasPrimitiveARCStorage(Type)) {
+      // ARC Block slot destruction is a nonthrowing runtime release, distinct
+      // from the potentially throwing heap-copy operation in its initializer.
+      // Do not relax the primitive copy/capture predicate to admit that copy.
+      QualType Element = Context->getBaseElementType(Type);
+      if ((!Type->isBlockPointerType() && !Context->getAsConstantArrayType(Type)) ||
+          Elements > 64 || !Context->getLangOpts().ObjCAutoRefCount || !Element->isBlockPointerType() ||
+          (Element.getObjCLifetime() != Qualifiers::OCL_Strong &&
+           Element.getObjCLifetime() != Qualifiers::OCL_Weak)) return false;
+    }
+    if (ObjC3Subobjects.size() == 64) return false;
+    ObjC3Subobjects.push_back({Field, Base, Destructor, Elements});return true;
+  };
+  if (Constructor) {
+    if (Constructor->getNumCtorInitializers() > 256) return false;
+    for (auto *Initializer : Constructor->inits()) {
+      if (ObjC3BaseObject && Initializer->isBaseInitializer() && Initializer->isBaseVirtual()) continue;
+      ObjC3SubobjectPrefixes[Initializer] = ObjC3Subobjects.size();
+      if (Initializer->isDelegatingInitializer()) {
+        if (!Record->hasTrivialDestructor()) {
+          const auto *Destructor = Record->getDestructor();
+          if (!Destructor) return false;
+          auto *Whole = createObjC3RuntimeVariable("__objc3_cfg_delegated_object",
+              Context->getCanonicalTagType(Record), nullptr, "objc3.cfg.delegated-object", Constructor->getLocation());
+          if (ObjC3BaseObject) {
+            // The base-object form of a delegating constructor calls D2 on
+            // failure, preserving virtual bases owned by the outer object.
+            auto *Base = new (*Context) CXXBaseSpecifier(SourceRange(Constructor->getLocation()),
+                false, Record->isClass(), AS_public, Context->getTrivialTypeSourceInfo(
+                    Context->getCanonicalTagType(Record), Constructor->getLocation()), SourceLocation());
+            ObjC3Subobjects.push_back({nullptr, Base, Destructor, 1});
+          } else ObjC3Subobjects.push_back({nullptr, nullptr, Destructor, 1, Whole});
+        }
+      } else if (Initializer->isAnyMemberInitializer()) {
+        auto *Field = Initializer->getAnyMember();
+        QualType Type = Field->getType();
+        if (Context->getLangOpts().ObjCAutoRefCount && Type->isArrayType() &&
+            Context->getBaseElementType(Type)->isBlockPointerType() &&
+            !supportsObjC3BlockArrayInitializer(Initializer->getInit(), Type, *Context)) return false;
+        if (Context->getLangOpts().ObjCAutoRefCount && Type->isArrayType() &&
+            Context->getBaseElementType(Type)->isBlockPointerType()) {
+          SmallVector<const Expr *, 8> Elements;
+          SmallVector<const InitListExpr *, 8> Lists;
+          if (!collectObjC3BlockArrayInitializers(Initializer->getInit(), Type, *Context, Elements, Lists)) return false;
+          for (const InitListExpr *List : Lists) ObjC3InitLists.insert(List);
+        }
+        if (!Add(Field, nullptr, Type)) return false;
+      } else if (Initializer->isBaseInitializer()) {
+        const CXXBaseSpecifier *Base = nullptr;
+        if (Initializer->isBaseVirtual()) {
+          for (const auto &Candidate : Record->vbases())
+            if (Candidate.getType()->getAsCXXRecordDecl() == Initializer->getBaseClass()->getAsCXXRecordDecl()) Base = &Candidate;
+        } else for (const auto &Candidate : Record->bases())
+          if (Candidate.getType()->getAsCXXRecordDecl() == Initializer->getBaseClass()->getAsCXXRecordDecl()) Base = &Candidate;
+        if (!Base || !Add(nullptr, Base, Base->getType())) return false;
+      }
+      const Expr *Value = Initializer->getInit();
+      if (Value && Value->getType()->isArrayType() && isa<CXXConstructExpr>(Value->IgnoreParenImpCasts()) &&
+          !isObjC3ArrayConstructorGroup(Value, *Context)) return false;
+    }
+  } else {
+    if (!ObjC3BaseObject)
+      for (const auto &Base : Record->vbases()) if (!Add(nullptr, &Base, Base.getType())) return false;
+    for (const auto &Base : Record->bases())
+      if (!Base.isVirtual() && !Add(nullptr, &Base, Base.getType())) return false;
+    if (!Record->isUnion())
+      for (auto *Field : Record->fields()) if (!Add(Field, nullptr, Field->getType())) return false;
+  }
+  ObjC3PendingSubobjects = ObjC3Subobjects;return true;
+}
