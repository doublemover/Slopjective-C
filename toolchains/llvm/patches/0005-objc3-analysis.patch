+// Allocation failure is an operation boundary. A throwing initializer needs a
+// separate deallocation-on-failure path; admit initialized new only when that
+// path is impossible. Keep this query deliberately structural and bounded.
+static bool isNonThrowingNewInitializer(const Stmt *Statement) {
+  if (!Statement)
+    return true;
+  if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement))
+    return isNonThrowingNewInitializer(Argument->getExpr());
+  if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement))
+    return isNonThrowingNewInitializer(Initializer->getExpr());
+  if (const auto *Call = dyn_cast<CallExpr>(Statement)) {
+    if (mayThrowNative(Call->getDirectCallee()))
+      return false;
+  } else if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Statement)) {
+    if (mayThrowNative(Constructor->getConstructor()))
+      return false;
+  } else if (!isa<IntegerLiteral, CharacterLiteral, FloatingLiteral,
+                  StringLiteral, CXXBoolLiteralExpr, CXXNullPtrLiteralExpr,
+                  GNUNullExpr, ImplicitValueInitExpr, CXXScalarValueInitExpr,
+                  DeclRefExpr, CXXThisExpr, ParenExpr, ImplicitCastExpr,
+                  InitListExpr, MemberExpr, UnaryOperator, BinaryOperator,
+                  AbstractConditionalOperator>(Statement))
+    return false;
+  if (const auto *List = dyn_cast<InitListExpr>(Statement))
+    if (const Expr *Filler = List->getArrayFiller())
+      if (!isNonThrowingNewInitializer(Filler)) return false;
+  for (const Stmt *Child : Statement->children())
+    if (!isNonThrowingNewInitializer(Child))
+      return false;
+  return true;
+}
+
+// Native array construction is one operation group. The callee completes
+// reverse cleanup of its initialized element prefix before reporting failure.
+// No repeated source operands are hidden by this zero-argument recipe.
+static bool isObjC3ArrayConstructorGroup(const Expr *Initializer, ASTContext &Context) {
+  if (!Initializer) return false;
+  const auto *Constructor = dyn_cast<CXXConstructExpr>(Initializer->IgnoreParenImpCasts());
+  const auto *Array = Constructor ? Context.getAsConstantArrayType(Constructor->getType()) : nullptr;
+  return Array && !Constructor->getNumArgs() &&
+         Context.getConstantArrayElementCount(Array) <= 64 &&
+         !Array->getElementType()->isArrayType();
+}
+
+static bool isObjC3PassiveInitialization(const Stmt *Statement, unsigned Depth = 0) {
+  if (!Statement) return true;
+  if (Depth > 32) return false;
+  if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Statement))
+    return isObjC3PassiveInitialization(Cleanups->getSubExpr(), Depth + 1);
+  if (isa<CallExpr, ObjCMessageExpr, BlockExpr>(Statement)) return false;
+  if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Statement))
+    if (mayThrowNative(Constructor->getConstructor()) ||
+        Constructor->getConstructor()->isUserProvided()) return false;
+  if (const auto *Unary = dyn_cast<UnaryOperator>(Statement))
+    if (Unary->isIncrementDecrementOp()) return false;
+  if (const auto *Binary = dyn_cast<BinaryOperator>(Statement))
+    if (Binary->isAssignmentOp()) return false;
+  if (!isNonThrowingNewInitializer(Statement)) return false;
+  for (const Stmt *Child : Statement->children())
+    if (!isObjC3PassiveInitialization(Child, Depth + 1)) return false;
+  return true;
+}
