+void CFGBuilder::appendObjC3Subobjects(ArrayRef<ObjC3SubobjectCleanup> Parts, const Stmt *Trigger) {
+  // Copy before recursive EH construction changes the pending prefix.
+  const ObjC3SubobjectList Stable(Parts.begin(), Parts.end());
+  // Subobject destruction is in the function epilogue, outside every handler
+  // and local scope in its body, including a return from a protected region.
+  SaveAndRestore SaveHandler(TryTerminatedBlock, ObjC3FunctionTryDispatch);
+  SaveAndRestore SaveHandlerScope(NativeExceptionScope, LocalScope::const_iterator());
+  SaveAndRestore SaveScope(ScopePos, LocalScope::const_iterator());
+  for (unsigned I = 0; I != Stable.size(); ++I) {
+    const auto &Part = Stable[I];
+    ObjC3SubobjectList Remaining(Stable.begin(), Stable.begin() + I);
+    SaveAndRestore SaveParts(ObjC3PendingSubobjects, std::move(Remaining));
+    const auto *Destructor = Part.Destructor;
+    const bool Throws = Destructor && mayThrowNative(Destructor);
+    addDeferredNativeOperation(Trigger, Throws,
+        Destructor && Destructor->getParent()->isAnyDestructorNoReturn());
+    if (Throws && Part.Elements > 1 && deferredNativeEHEdgesEnabled() && !EmittingNativeUnwind)
+      addSuccessor(Block, getDeferredTerminateBlock());
+    if (Destructor) {
+      if (Part.WholeObject) appendAutomaticObjDtor(Block, Part.WholeObject, const_cast<Stmt *>(Trigger));
+      else if (Part.Field) appendMemberDtor(Block, Part.Field);
+      else appendBaseDtor(Block, Part.Base);
+    } else {
+      SourceLocation Loc = Trigger ? Trigger->getBeginLoc() : SourceLocation();
+      SmallVector<QualType, 1> Parameters;
+      SmallVector<Expr *, 1> Arguments;
+      if (Part.Field && Part.Field->getType()->isArrayType()) {
+        QualType Size = Context->getSizeType();Parameters.push_back(Size);
+        Arguments.push_back(IntegerLiteral::Create(*Context,
+            llvm::APInt(Context->getTypeSize(Size), Part.Elements), Size, Loc));
+      }
+      auto *Release = createObjC3RuntimeHelper("__objc3_cfg_arc_subobject_release",
+          Context->VoidTy, Parameters, true, Loc);
+      Expr *Reference = DeclRefExpr::Create(*Context, NestedNameSpecifierLoc{},
+          SourceLocation(), Release, false, DeclarationNameInfo(Release->getDeclName(), Loc), Release->getType(), VK_LValue);
+      Expr *Callee = ImplicitCastExpr::Create(*Context, Context->getPointerType(Release->getType()),
+          CK_FunctionToPointerDecay, Reference, nullptr, VK_PRValue, FPOptionsOverride());
+      appendStmt(Block, CallExpr::Create(*Context, Callee, Arguments, Context->VoidTy, VK_PRValue, Loc, FPOptionsOverride()));
+    }
+  }
+}
