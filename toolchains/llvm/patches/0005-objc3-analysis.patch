+CFGBlock *
+CFGBuilder::VisitObjC3CarrierTransferExpr(ObjC3CarrierTransferExpr *Transfer) {
+  autoCreateBlock();
+  appendStmt(Block, Transfer);
+  CFGBlock *Continuation = Block;
+  Block = nullptr;
+  Succ = Continuation;
+  Expr *Present = Transfer->getValueInit();
+  if (!Transfer->getCarrierType()->getAs<ObjC3OptionalType>())
+    Present = Transfer->getSuccessInit();
+  if (Present)
+    Visit(Present, AddStmtChoice::AlwaysAdd);
+  CFGBlock *True = Block ? Block : Succ;
+  Block = nullptr;
+  Succ = Continuation;
+  if (Expr *Absent = Transfer->getErrorInit())
+    Visit(Absent, AddStmtChoice::AlwaysAdd);
+  CFGBlock *False = Block ? Block : Succ;
+  Block = createBlock(false);
+  Block->setTerminator(
+      CFGTerminator(Transfer, CFGTerminator::ObjC3ConditionBranch));
+  addSuccessor(Block, True);
+  addSuccessor(Block, False);
+  return Visit(Transfer->getSource(), AddStmtChoice::AlwaysAdd);
+}
+
+CFGBlock *
+CFGBuilder::VisitObjC3TransferForTemporaries(ObjC3CarrierTransferExpr *Transfer,
+                                             bool ExternallyDestructed,
+                                             TempDtorContext &Context) {
+  VisitForTemporaries(Transfer->getSource(), false, Context);
+  CFGBlock *SourceBlock = Block, *SourceSucc = Succ;
+  TempDtorContext Present(bothKnownTrue(Context.KnownExecuted, TryResult()));
+  if (Expr *Init = Transfer->getValueInit() ? Transfer->getValueInit()
+                                            : Transfer->getSuccessInit())
+    VisitForTemporaries(Init, ExternallyDestructed, Present);
+  CFGBlock *True = Block;
+  Block = SourceBlock;
+  Succ = SourceSucc;
+  TempDtorContext Absent(bothKnownTrue(Context.KnownExecuted, TryResult()));
+  if (Transfer->getErrorInit())
+    VisitForTemporaries(Transfer->getErrorInit(), ExternallyDestructed, Absent);
+  if (Present.TerminatorExpr && Absent.TerminatorExpr)
+    InsertTempDecisionBlock(Absent, True);
+  else if (Present.TerminatorExpr) {
+    Block = True;
+    InsertTempDecisionBlock(Present);
+  } else
+    InsertTempDecisionBlock(Absent);
+  Context.CollectedMTEs.append(Present.CollectedMTEs);
+  Context.CollectedMTEs.append(Absent.CollectedMTEs);
+  return Block;
+}
+
+static bool containsFullExpressionTemporary(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<CXXBindTemporaryExpr>(Statement))
+    return true;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement))
+    if (!Typeid->isPotentiallyEvaluated())
+      return false;
+  // Match arm temporaries end within the selected arm, rather than in the
+  // enclosing full expression. The match visitor owns those cleanup regions.
+  if (isa<CXXNoexceptExpr, UnaryExprOrTypeTraitExpr, LambdaExpr, BlockExpr,
+          ObjC3MatchExpr, ObjC3CoalesceExpr>(
+          Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsFullExpressionTemporary(Child))
+      return true;
+  return false;
+}
+
+static bool recordDeferredTemporaryPrefix(const Stmt *Statement,
+                                          DeferredTemporaryList &Active,
+                                          DeferredTemporaryMap &Pending) {
+  if (!Statement)
+    return true;
+  if (const auto *Resource = dyn_cast<ObjC3ResourceExpr>(Statement)) {
+    // Reset closes the old handle before evaluating its replacement. The
+    // close's exceptional edge owns only the already completed outer prefix.
+    if (!recordDeferredTemporaryPrefix(Resource->getOperand(), Active, Pending))
+      return false;
+    Pending[Statement] = Active;
+    return recordDeferredTemporaryPrefix(Resource->getReplacement(), Active,
+                                         Pending);
+  }
+  // Branch-dependent registration needs the same decision that protects the
+  // normal temporary cleanup. Keep those expressions gated until exceptional
+  // cleanup can replay that decision as well.
+  if (isa<AbstractConditionalOperator, ChooseExpr, StmtExpr, LambdaExpr,
+          BlockExpr, ExprWithCleanups, ObjC3CarrierTransferExpr, PseudoObjectExpr,
+          ObjC3MatchExpr, ObjC3CoalesceExpr,
+          CXXRewrittenBinaryOperator, CXXNewExpr, CoroutineSuspendExpr>(Statement))
+    return false;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement)) {
+    if (!Typeid->isPotentiallyEvaluated()) {
+      Pending[Statement] = Active;
+      return true;
+    }
+  }
+  if (isa<CXXNoexceptExpr>(Statement)) {
+    Pending[Statement] = Active;
+    return true;
+  }
+  if (isa<UnaryExprOrTypeTraitExpr>(Statement))
+    return false; // Variable-length operands can be evaluated.
+  if (const auto *Binary = dyn_cast<BinaryOperator>(Statement)) {
+    if (Binary->isLogicalOp())
+      return false;
+    if (Binary->isAssignmentOp()) {
+      if (!recordDeferredTemporaryPrefix(Binary->getRHS(), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Binary->getLHS(), Active, Pending))
+        return false;
+      Pending[Statement] = Active;
+      return true;
+    }
+    if (Binary->getOpcode() != BO_Comma &&
+        containsFullExpressionTemporary(Binary))
+      return false; // Other operand evaluation does not have a fixed order.
+  }
+  if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(Statement))
+    if (Operator->isAssignmentOp()) {
+      if (!recordDeferredTemporaryPrefix(Operator->getCallee(), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Operator->getArg(1), Active, Pending) ||
+          !recordDeferredTemporaryPrefix(Operator->getArg(0), Active, Pending))
+        return false;
+      Pending[Statement] = Active;
+      return true;
+    }
+  // Ordinary argument evaluation has no fixed relative order. A temporary
+  // produced by one argument cannot be assumed alive while another evaluates.
+  // Multiple completed objects are still admitted through sequenced commas,
+  // including nested single-argument calls and constructors.
+  if (const auto *Call = dyn_cast<CallExpr>(Statement)) {
+    if (Call->getNumArgs() > 1)
+      for (const Expr *Argument : Call->arguments())
+        if (containsFullExpressionTemporary(Argument))
+          return false;
+  } else if (const auto *Constructor = dyn_cast<CXXConstructExpr>(Statement)) {
+    if (Constructor->getNumArgs() > 1)
+      for (const Expr *Argument : Constructor->arguments())
+        if (containsFullExpressionTemporary(Argument))
+          return false;
+  }
+  for (const Stmt *Child : Statement->children())
+    if (!recordDeferredTemporaryPrefix(Child, Active, Pending))
+      return false;
+  Pending[Statement] = Active;
+  if (const auto *Temporary = dyn_cast<CXXBindTemporaryExpr>(Statement))
+    Active.push_back(Temporary);
+  return true;
+}
+
+bool CFGBuilder::collectDeferredTemporaryCleanups(
+    const Stmt *Expression, DeferredTemporaryMap &Pending) const {
+  if (!containsFullExpressionTemporary(Expression) || isObjC3LocalClosureBinding(Expression))
+    return true;
+  DeferredTemporaryList Active;
+  return recordDeferredTemporaryPrefix(Expression, Active, Pending);
+}
+
+bool CFGBuilder::supportsObjC3MatchStorage(QualType Type) const {
+  if (Type.isNull() || Type->isDependentType() ||
+      Type.isDestructedType() != QualType::DK_none ||
+      containsObjC3CarrierManagedStorage(Type) ||
+      containsObjC3CarrierThrowingCopy(Type) ||
+      (Context->getLangOpts().ObjCAutoRefCount &&
+       Type->isObjCRetainableType()))
+    return false;
+  SmallVector<const CXXDestructorDecl *, 4> Destructors;
+  collectObjC3CarrierDestructors(Type, Destructors);
+  return Destructors.empty();
+}
+
+static bool containsMatchGuardLabels(const Stmt *Statement) {
+  if (!Statement)
+    return false;
+  if (isa<LabelStmt, GotoStmt, AddrLabelExpr, IndirectGotoStmt>(Statement))
+    return true;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (const Expr *Capture : Lambda->capture_inits())
+      if (containsMatchGuardLabels(Capture))
+        return true;
+    return false;
+  }
+  if (isa<BlockExpr>(Statement))
+    return false;
+  for (const Stmt *Child : Statement->children())
+    if (containsMatchGuardLabels(Child))
+      return true;
+  return false;
+}
+
+// A direct capture list whose acquisition/disposal has no implicit throwing
+// copy operation can use the ordinary native EH graph. General block copies
+// and C++ capture subobject cleanup still need separate operation elements.
+static bool supportsObjC3SimpleBlockCaptures(const BlockExpr *Block) {
+  if (!Block) return false;
+  if (!Block->getBlockDecl()->hasObjC3CaptureList()) {
+    ASTContext &Context = Block->getBlockDecl()->getASTContext();
+    const bool ARC = Context.getLangOpts().ObjCAutoRefCount;
+    for (const auto &Capture : Block->getBlockDecl()->captures()) {
+      QualType Type = Capture.getCaptureType();
+      if (Type.isNull()) Type = Capture.getVariable()->getType();
+      if (Capture.isByRef() || Capture.getObjC3InitExpr() || Type->isReferenceType() ||
+          Type->isBlockPointerType() ||
+          (ARC ? !hasObjC3PrimitiveARCStorage(Type, Context)
+               : Type.isDestructedType() != QualType::DK_none || !Type.isTriviallyCopyableType(Context))) return false;
+      if (Capture.hasCopyExpr()) {
+        const auto *Copy = dyn_cast<CXXConstructExpr>(Capture.getCopyExpr()->IgnoreParenImpCasts());
+        if (!Copy || (ARC ? Copy->getConstructor()->isUserProvided() || mayThrowNative(Copy->getConstructor())
+                          : !Copy->getConstructor()->isTrivial())) return false;
+      }
+    }
+    return true;
+  }
+  for (const auto &Capture : Block->getBlockDecl()->captures()) {
+    QualType Type = Capture.getCaptureType();
+    if (Type.isNull()) Type = Capture.getVariable()->getType();
+    if (Capture.getObjC3InitExpr() || Capture.hasCopyExpr() || Type->isBlockPointerType() ||
+        (!Type->isScalarType() && !Type->isObjCRetainableType())) return false;
+  }
+  return true;
+}
+static bool isObjC3SimpleBlockInitializer(const Expr *Value) {
+  if (!Value) return false;
+  while (const auto *Full = dyn_cast<ExprWithCleanups>(Value))
+    Value = Full->getSubExpr();
+  return supportsObjC3SimpleBlockCaptures(
+      dyn_cast<BlockExpr>(Value->IgnoreParenImpCasts()));
+}
+
+static bool isObjC3NullBlockValue(const Expr *Value, ASTContext &Context) {
+  if (!Value) return false;
+  Value = Value->IgnoreParenImpCasts();
+  if (const auto *Cast = dyn_cast<ExplicitCastExpr>(Value);
+      Cast && (Cast->getCastKind() == CK_NoOp || Cast->getCastKind() == CK_NullToPointer))
+    return isObjC3NullBlockValue(Cast->getSubExpr(), Context);
+  return isa<ImplicitValueInitExpr>(Value) ||
+         Value->isNullPointerConstant(Context, Expr::NPC_ValueDependentIsNotNull);
+}
+
+// A plain Block slot load has no temporary subobjects. Its implicit heap copy
+// can throw independently of the surrounding declaration or consumed call.
+static bool isObjC3BlockSlotLoad(const Expr *Value) {
+  if (!Value || containsFullExpressionTemporary(Value)) return false;
+  while (const auto *Full = dyn_cast<ExprWithCleanups>(Value))
+    Value = Full->getSubExpr();
+  const auto *Reference = dyn_cast<DeclRefExpr>(Value->IgnoreParenImpCasts());
+  const auto *Source = Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+  if (!Source || !Source->getType()->isBlockPointerType() ||
+      Source->getType().isVolatileQualified() || Source->getType()->isAtomicType())
+    return false;
+  const auto Lifetime = Source->getType().getObjCLifetime();
+  return Lifetime != Qualifiers::OCL_Weak &&
+         Lifetime != Qualifiers::OCL_ExplicitNone;
+}
+namespace {
+// These expressions can compute a Block value without introducing a temporary
+// owner. Calls/branches in scalar operands keep their ordinary native EH edges.
+static bool isObjC3ScalarBlockOperand(const Stmt *Statement, ASTContext &Context,
+                                     unsigned &Budget, unsigned Depth = 0) {
+  if (!Statement) return true;
+  if (!Budget-- || Depth > 64) return false;
+  const auto *Value = dyn_cast<Expr>(Statement);
+  if (!Value || Value->isTypeDependent() ||
+      isa<StmtExpr, BlockExpr, LambdaExpr, PseudoObjectExpr, ObjCMessageExpr,
+          CXXNewExpr, CXXDeleteExpr, CXXConstructExpr, CXXBindTemporaryExpr,
+          CoroutineSuspendExpr, ObjC3ResourceExpr, ObjC3CarrierTransferExpr>(Value)) return false;
+  if (const auto *Default = dyn_cast<CXXDefaultArgExpr>(Value)) {
+    const Expr *Argument = Default->getExpr()->IgnoreParenImpCasts();
+    return isa<IntegerLiteral, FloatingLiteral, CharacterLiteral, CXXBoolLiteralExpr, CXXNullPtrLiteralExpr>(Argument) &&
+           isObjC3ScalarBlockOperand(Argument, Context, Budget, Depth + 1);
+  }
+  if (isa<CXXDefaultInitExpr>(Value)) return false;
+  QualType Type = Value->getType();
+  if ((!Type->isScalarType() && !Type->isVoidType() && !Type->isFunctionType()) ||
+      Type->isObjCRetainableType() || Type.isVolatileQualified() || Type->isAtomicType() ||
+      getObjC3ResourceTypeContract(Context, Type).Cleanup) return false;
+  if (const auto *Reference = dyn_cast<DeclRefExpr>(Value))
+    if (Reference->getDecl()->hasAttr<ObjCResourceAttr>()) return false;
+  for (const Stmt *Child : Value->children())
+    if (!isObjC3ScalarBlockOperand(Child, Context, Budget, Depth + 1)) return false;
+  return true;
+}
+static bool isObjC3DirectBlockProducerImpl(const Expr *Value, ASTContext &Context,
+                                           unsigned &Budget, unsigned Depth = 0) {
+  if (!Value || !Budget-- || Depth > 64 || containsFullExpressionTemporary(Value)) return false;
+  Value = getObjC3BlockArrayValue(Value);
+  if (const auto *Cast = dyn_cast<CastExpr>(Value)) {
+    if (Cast->getCastKind()!=CK_NoOp && Cast->getCastKind()!=CK_ARCConsumeObject &&
+        Cast->getCastKind()!=CK_ARCReclaimReturnedObject && Cast->getCastKind()!=CK_ARCProduceObject) return false;
+    return isObjC3DirectBlockProducerImpl(Cast->getSubExpr(), Context, Budget, Depth + 1);
+  }
+  if (const auto *Comma = dyn_cast<BinaryOperator>(Value); Comma && Comma->getOpcode()==BO_Comma)
+    return isObjC3ScalarBlockOperand(Comma->getLHS(), Context, Budget, Depth + 1) &&
+           isObjC3DirectBlockProducerImpl(Comma->getRHS(), Context, Budget, Depth + 1);
+  const auto *Call = dyn_cast<CallExpr>(Value);
+  const auto *Function = Call ? Call->getDirectCallee() : nullptr;
+  const auto *Type = Function ? Function->getType()->getAs<FunctionProtoType>() : nullptr;
+  if (!Type || !Type->getReturnType()->isBlockPointerType() || Type->isVariadic() ||
+      getObjC3ResourceTypeContract(Context, Type->getReturnType()).Cleanup ||
+      Type->hasObjC3BorrowedResult() || Type->getObjC3FunctionEffects().Async ||
+      Type->getObjC3FunctionEffects().Throws!=ObjC3ThrowsKind::None ||
+      (isa<CXXMethodDecl>(Function) && !cast<CXXMethodDecl>(Function)->isStatic()) ||
+      !isObjC3ScalarBlockOperand(Call->getCallee(), Context, Budget, Depth + 1)) return false;
+  for (const auto *Parameter : Function->parameters())
+    if (Parameter->hasAttr<ObjCResourceAttr>() || Parameter->hasAttr<NSConsumedAttr>() ||
+        getObjC3ResourceTypeContract(Context, Parameter->getType()).Cleanup) return false;
+  for (const Expr *Argument : Call->arguments())
+    if (!isObjC3ScalarBlockOperand(Argument, Context, Budget, Depth + 1)) return false;
+  return true;
+}
+static bool isObjC3DirectBlockProducer(const Expr *Value, ASTContext &Context) {
+  unsigned Budget = 256;
+  return isObjC3DirectBlockProducerImpl(Value, Context, Budget);
+}
+
+// Native strong member/index loads do not acquire a temporary owner. Admit
+// their address recipe only from stable storage; overloaded/property/temporary
+// bases and weak/unsafe loads retain independent cleanup obligations.
+static bool isObjC3StableBlockSlotAddress(const Expr *Value, ASTContext &Context,
+                                         unsigned &Budget, unsigned Depth = 0) {
+  if (!Value || !Budget-- || Depth > 64) return false;
+  Value = Value->IgnoreParenImpCasts();
+  if (Value->getType().isVolatileQualified() || Value->getType()->isAtomicType()) return false;
+  if (isa<CXXThisExpr>(Value)) return true;
+  if (const auto *Reference = dyn_cast<DeclRefExpr>(Value))
+    return isa<VarDecl>(Reference->getDecl()) && !Reference->getDecl()->hasAttr<ObjCResourceAttr>();
+  if (const auto *Member = dyn_cast<MemberExpr>(Value))
+    return isa<FieldDecl>(Member->getMemberDecl()) &&
+           !Member->getMemberDecl()->hasAttr<ObjCResourceAttr>() &&
+           isObjC3StableBlockSlotAddress(Member->getBase(), Context, Budget, Depth + 1);
+  if (const auto *Index = dyn_cast<ArraySubscriptExpr>(Value))
+    return isObjC3StableBlockSlotAddress(Index->getBase(), Context, Budget, Depth + 1) &&
+           isObjC3ScalarBlockOperand(Index->getIdx(), Context, Budget, Depth + 1);
+  if (const auto *Dereference = dyn_cast<UnaryOperator>(Value); Dereference && Dereference->getOpcode() == UO_Deref)
+    return isObjC3StableBlockSlotAddress(Dereference->getSubExpr(), Context, Budget, Depth + 1);
+  return false;
+}
+static bool isObjC3StableBlockValueImpl(const Expr *Value, ASTContext &Context,
+                                      unsigned &Budget, unsigned Depth = 0) {
+  if (!Value || !Budget-- || Depth > 64 || containsFullExpressionTemporary(Value)) return false;
+  Value = getObjC3BlockArrayValue(Value);
+  if (isObjC3NullBlockValue(Value, Context) || isObjC3BlockSlotLoad(Value)) return true;
+  if (Value->getType()->isBlockPointerType() && Value->isGLValue() &&
+      (isa<MemberExpr, ArraySubscriptExpr, UnaryOperator>(Value)) &&
+      Value->getType().getObjCLifetime() != Qualifiers::OCL_Weak &&
+      Value->getType().getObjCLifetime() != Qualifiers::OCL_ExplicitNone &&
+      isObjC3StableBlockSlotAddress(Value, Context, Budget, Depth + 1)) return true;
+  if (const auto *Cast = dyn_cast<CastExpr>(Value)) {
+    if (Cast->getCastKind() != CK_LValueToRValue && Cast->getCastKind() != CK_NoOp &&
+        Cast->getCastKind() != CK_ARCProduceObject) return false;
+    return isObjC3StableBlockValueImpl(Cast->getSubExpr(), Context, Budget, Depth + 1);
+  }
+  if (const auto *Block = dyn_cast<BlockExpr>(Value)) {
+    // A scalar capture has no stack-disposal operation. Managed/byref captures,
+    // capture initializers and C++ copy expressions need independent regions.
+    for (const auto &Capture : Block->getBlockDecl()->captures()) {
+      QualType Type = Capture.getCaptureType();
+      if (Type.isNull()) Type = Capture.getVariable()->getType();
+      if (Capture.isByRef() || Capture.getObjC3InitExpr() || Capture.hasCopyExpr() ||
+          Capture.isObjC3ResourceCapture() || Capture.getVariable()->hasAttr<ObjCResourceAttr>() ||
+          Type->isReferenceType() || !Type->isScalarType() || Type->isObjCRetainableType() ||
+          Type.isDestructedType() != QualType::DK_none ||
+          getObjC3ResourceTypeContract(Context, Type).Cleanup) return false;
+    }
+    return true;
+  }
+  if (const auto *Comma = dyn_cast<BinaryOperator>(Value); Comma && Comma->getOpcode() == BO_Comma)
+    return isObjC3ScalarBlockOperand(Comma->getLHS(), Context, Budget, Depth + 1) &&
+           isObjC3StableBlockValueImpl(Comma->getRHS(), Context, Budget, Depth + 1);
+  if (const auto *Conditional = dyn_cast<ConditionalOperator>(Value))
+    return isObjC3ScalarBlockOperand(Conditional->getCond(), Context, Budget, Depth + 1) &&
+           isObjC3StableBlockValueImpl(Conditional->getTrueExpr(), Context, Budget, Depth + 1) &&
+           isObjC3StableBlockValueImpl(Conditional->getFalseExpr(), Context, Budget, Depth + 1);
+  return false;
+}
+static bool isObjC3StableBlockValue(const Expr *Value, ASTContext &Context) {
+  unsigned Budget = 256;
+  return isObjC3StableBlockValueImpl(Value, Context, Budget);
+}
+static bool collectObjC3BlockArrayInitializers(const Expr *Value, QualType Type, ASTContext &Context,
+    SmallVectorImpl<const Expr *> &Elements, SmallVectorImpl<const InitListExpr *> &Lists, unsigned Depth) {
+  const auto *Array = Context.getAsConstantArrayType(Type);
+  if (!Array || Depth > 64 || Context.getConstantArrayElementCount(Array) > 64 ||
+      !Context.getBaseElementType(Type)->isBlockPointerType()) return false;
+  Value = getObjC3BlockArrayValue(Value);
+  const InitListExpr *List = dyn_cast_or_null<InitListExpr>(Value);
+  if (List && !List->isSemanticForm()) List = List->getSemanticForm();
+  const auto Count = Array->getZExtSize();
+  if (Value && !List && !isa<ImplicitValueInitExpr, CXXScalarValueInitExpr>(Value)) return false;
+  if (List && List->getNumInits() > Count) return false;
+  if (List) Lists.push_back(List);
+  for (uint64_t Index = 0; Index != Count; ++Index) {
+    const Expr *Element = List ? (Index < List->getNumInits() ? List->getInit(Index) : List->getArrayFiller()) : nullptr;
+    if (Array->getElementType()->isArrayType()) {
+      if (!collectObjC3BlockArrayInitializers(Element, Array->getElementType(), Context, Elements, Lists, Depth + 1)) return false;
+    } else {
+      const bool StrongDestination = !Context.getLangOpts().ObjCAutoRefCount ||
+          Array->getElementType().getObjCLifetime()==Qualifiers::OCL_Strong;
+      if (Elements.size() == 64 || (Element && !isObjC3StableBlockValue(Element, Context) &&
+          !(StrongDestination && isObjC3DirectBlockProducer(Element, Context)))) return false;
+      Elements.push_back(Element);
+    }
+  }
+  return true;
+}
+
+static bool isObjC3StrongBlockAssignment(const BinaryOperator *Assignment, ASTContext &Context) {
+  if (!Assignment || Assignment->getOpcode() != BO_Assign || !Context.getLangOpts().ObjCAutoRefCount) return false;
+  QualType Type = Assignment->getLHS()->getType();
+  unsigned Budget = 256;
+  return Type->isBlockPointerType() && Type.getObjCLifetime() == Qualifiers::OCL_Strong &&
+         isObjC3StableBlockSlotAddress(Assignment->getLHS(), Context, Budget) &&
+         (isObjC3StableBlockValue(Assignment->getRHS(), Context) ||
+          isObjC3DirectBlockProducer(Assignment->getRHS(), Context));
+}
+} // namespace
+
+static bool isObjC3BlockLifetimeLoad(const VarDecl *Variable) {
+  return Variable->hasAttr<ObjC3LifetimeBindingAttr>() &&
+         Variable->getType()->isBlockPointerType() &&
+         isObjC3BlockSlotLoad(Variable->getInit());
+}
+static bool isObjC3ConsumedBlockCopy(const Expr *Expression, ASTContext &Context) {
+  const auto *Cast = dyn_cast<ImplicitCastExpr>(Expression);
+  return Cast && Cast->getCastKind() == CK_ARCProduceObject &&
+         Expression->getType()->isBlockPointerType() &&
+         isObjC3StableBlockValue(Cast->getSubExpr(), Context);
+}
+
+bool CFGBuilder::supportsDeferredNativeEH(const Stmt *Statement,
+                                         bool FullExpressionTemporary,
+                                         bool BlockOwnershipTransfer) const {
+  if (!Statement)
+    return true;
+  if (BlockOwnershipTransfer)
+    if (const auto *Value = dyn_cast<Expr>(Statement); Value && isObjC3DirectBlockProducer(Value, *Context))
+      return true; // The destination adopts the call's native +1 result. No full-expression owner remains.
+  if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Statement);
+      Cast && Cast->getCastKind() == CK_ARCProduceObject && isObjC3DirectBlockProducer(Cast->getSubExpr(), *Context))
+    return true; // A single consumed argument adopts this result; call arity is checked below.
+  if (const auto *Resource = dyn_cast<ObjC3ResourceExpr>(Statement)) {
+    const VarDecl *Variable = Resource->getResourceVariable();
+    return Variable && Variable->hasAttr<ObjCResourceAttr>() &&
+           supportsDeferredNativeEH(Resource->getOperand(),
+                                    FullExpressionTemporary) &&
+           supportsDeferredNativeEH(Resource->getReplacement(),
+                                    FullExpressionTemporary);
+  }
+  if (const auto *Coalesce = dyn_cast<ObjC3CoalesceExpr>(Statement))
+    return Coalesce->getSemanticExpr() &&
+           supportsDeferredNativeEH(Coalesce->getSemanticExpr());
+  if (const auto *Access = dyn_cast<ObjC3OptionalAccessExpr>(Statement))
+    // ARC owns a receiver snapshot whose implicit release needs its own
+    // cleanup region. MRC uses the ordinary semantic conditional directly.
+    return Access->getSemanticExpr() &&
+           !Context->getLangOpts().ObjCAutoRefCount &&
+           supportsDeferredNativeEH(Access->getSemanticExpr());
+  if (isa<ObjC3MatchExpr, ObjC3MatchStmt>(Statement)) {
+    const auto *Expression = dyn_cast<ObjC3MatchExpr>(Statement);
+    const auto *MatchStatement = dyn_cast<ObjC3MatchStmt>(Statement);
+    const Expr *Source = Expression ? Expression->getScrutinee()
+                                    : MatchStatement->getScrutinee();
+    if (!supportsObjC3MatchStorage(Source->getType()) ||
+        containsFullExpressionTemporary(Source) ||
+        !supportsDeferredNativeEH(Source) ||
+        (Expression && !supportsObjC3MatchStorage(Expression->getType())))
+      return false;
+    auto SupportsArmExpression = [&](const Expr *Body) {
+      if (!Body)
+        return true;
+      if (isa<ExprWithCleanups>(Body))
+        return supportsDeferredNativeEH(Body);
+      DeferredTemporaryMap Pending;
+      return collectDeferredTemporaryCleanups(Body, Pending) &&
+             (Pending.empty() ||
+              (BuildOpts.AddImplicitDtors && BuildOpts.AddTemporaryDtors)) &&
+             supportsDeferredNativeEH(Body, !Pending.empty());
+    };
+    unsigned Count = Expression ? Expression->getNumArms()
+                                : MatchStatement->getNumArms();
+    for (unsigned I = 0; I != Count; ++I) {
+      const ObjC3MatchArm *Arm = Expression ? Expression->getArm(I)
+                                           : MatchStatement->getArm(I);
+      if ((Arm->getBindingDecl() &&
+           !supportsObjC3MatchStorage(Arm->getBindingDecl()->getType())) ||
+          !supportsDeferredNativeEH(Arm->getBindingStatement()) ||
+          !SupportsArmExpression(Arm->getGuard()))
+        return false;
+      if (const auto *Body = dyn_cast<Expr>(Arm->getBody())) {
+        if (!SupportsArmExpression(Body))
+          return false;
+      } else if (!supportsDeferredNativeEH(Arm->getBody()))
+        return false;
+    }
+    return true;
+  }
+  if (const auto *Pool = dyn_cast<ObjCAutoreleasePoolStmt>(Statement))
+    return ObjC3RuntimeOwner && Context->getLangOpts().ObjCRuntime.hasNativeARC() &&
+           supportsDeferredNativeEH(Pool->getSubStmt());
+  if (const auto *Sync = dyn_cast<ObjCAtSynchronizedStmt>(Statement))
+    return ObjC3RuntimeOwner && Sync->getSynchExpr()->getType()->isObjCRetainableType() &&
+           !containsFullExpressionTemporary(Sync->getSynchExpr()) &&
+           supportsDeferredNativeEH(Sync->getSynchExpr()) &&
+           supportsDeferredNativeEH(Sync->getSynchBody());
+  // Partial arrays, full-expression temporaries and other runtime cleanups
+  // still need registration-aware unwind models. Refuse them rather than
+  // routing an unwind around their cleanup or an already registered action.
+  if ((isa<CXXBindTemporaryExpr>(Statement) && !FullExpressionTemporary &&
+       !isObjC3LocalClosureBinding(Statement)) ||
+      isa<ObjCAutoreleasePoolStmt,
+          ObjCAtSynchronizedStmt, ObjCForCollectionStmt,
+          SEHTryStmt>(Statement))
+    return false;
+  if (const auto *Typeid = dyn_cast<CXXTypeidExpr>(Statement))
+    return !Typeid->isPotentiallyEvaluated() ||
+           supportsDeferredNativeEH(Typeid->getExprOperand(),
+                                    FullExpressionTemporary);
+  if (const auto *Return = dyn_cast<ReturnStmt>(Statement))
+    if (const Expr *Value = Return->getRetValue())
+      if (Value->getType()->isBlockPointerType() && !isObjC3SimpleBlockInitializer(Value))
+        return false;
+  if (const auto *Block = dyn_cast<BlockExpr>(Statement))
+    return supportsObjC3SimpleBlockCaptures(Block);
+  if (const auto *Expression = dyn_cast<Expr>(Statement)) {
+    QualType Type = Expression->getType();
+    bool BlockValue = Type->isBlockPointerType();
+    bool BlockLoad = isa<DeclRefExpr>(Expression);
+    if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Expression))
+      BlockLoad |= Cast->getCastKind() == CK_LValueToRValue;
+    bool BlockWrapper = isa<ExprWithCleanups, ParenExpr>(Expression) ||
+                        isObjC3SimpleBlockInitializer(Expression) ||
+                        isObjC3ConsumedBlockCopy(Expression, *Context);
+    if (BlockValue)
+      BlockWrapper |= isObjC3NullBlockValue(Expression, *Context) ||
+                      isObjC3StableBlockValue(Expression, *Context) ||
+                      (!Context->getLangOpts().ObjCAutoRefCount && isObjC3DirectBlockProducer(Expression, *Context));
