+CFGBlock *CFGBuilder::VisitObjC3TryExpr(ObjC3TryExpr *E) {
+  if (badCFG)
+    return nullptr;
+
+  const Expr *Call = E->getOperand()->IgnoreParenImpCasts();
+  bool NoReturn = false;
+  if (const auto *C = dyn_cast<CallExpr>(Call)) {
+    QualType CalleeType = C->getCallee()->getType();
+    if (CalleeType == Context->BoundMemberTy)
+      CalleeType = Expr::findBoundMemberType(C->getCallee());
+    if (!CalleeType.isNull())
+      NoReturn = getFunctionExtInfo(*CalleeType).getNoReturn();
+    if (const FunctionDecl *FD = C->getDirectCallee())
+      NoReturn |= FD->isNoReturn() || FD->isAnalyzerNoReturn();
+    if (mayCallReturningOverride(C))
+      NoReturn = false;
+  }
+  // Objective-C messaging a nil receiver can succeed without invoking the
+  // noreturn method. Keep that normal edge unless a separate receiver proof
+  // establishes that the method must actually execute.
+
+  // Keep a distinct normal continuation, even at function end: checked failure
+  // must not hide a successful call's ordinary fallthrough from -Wreturn-type.
+  if (E->getKind() == ObjC3TryExpr::Kind::Optionalize && !NoReturn)
+    return VisitStmt(E, AddStmtChoice::AlwaysAdd);
+  CFGBlock *Continuation = Block ? Block : createBlock();
+
+  CFGBlock *Success = Continuation;
+  if (NoReturn) {
+    Succ = Continuation;
+    Success = createNoReturnBlock();
+  }
+
+  CFGBlock *Failure = Continuation;
+  if (E->getKind() != ObjC3TryExpr::Kind::Optionalize) {
+    Succ = E->getKind() == ObjC3TryExpr::Kind::Force
+               ? &cfg->getExit()
+               : ObjC3ErrorDispatchBlock ? ObjC3ErrorDispatchBlock
+                                        : &cfg->getExit();
+    Block = createBlock();
+    Block->setTerminator(E);
+    // Force traps without leaving through normal scope cleanups. Propagation
+    // runs the same automatic-object cleanup as its checked handler transfer.
+    if (E->getKind() == ObjC3TryExpr::Kind::Propagate)
+      addAutomaticObjHandling(ScopePos, ObjC3ErrorDispatchScope, E);
+    Failure = Block;
+  }
+
+  Block = createBlock(false);
+  Block->setTerminator(E);
+  addSuccessor(Block, Success);
+  addSuccessor(Block, Failure);
+  // A source noreturn promise excludes normal success, but a checked error is
+  // returned through the hidden ABI output. Do not sink the underlying call
+  // before its checked-failure edge. Native exception edges remain independent.
+  SaveAndRestore SaveCall(ObjC3CheckedCall, Call);
+  return VisitStmt(E, AddStmtChoice::AlwaysAdd);
+}
