+using namespace clang;
+
+namespace {
+void reject(Sema &S, SourceLocation Loc, StringRef Message) {
+  S.Diag(Loc, S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                  DiagnosticIDs::Error, Message));
+}
+
+QualType checkMetadataType(Sema &S, QualType Type, StringRef Name,
+                           SourceLocation Loc, bool AllowOpaque = false) {
+  const auto *RT = Type->getAs<RecordType>();
+  const RecordDecl *Declaration = RT ? RT->getDecl() : nullptr;
+  if (!Declaration || !Declaration->isStruct() ||
+      Declaration->getName() != Name) {
+    reject(S, Loc, "objc3.keypath metadata declaration has an incompatible "
+                   "native ABI shape");
+    return {};
+  }
+  if (AllowOpaque) {
+    if (!Declaration->getDefinition() &&
+        !Declaration->hasAttr<PackedAttr>() &&
+        !Declaration->hasAttr<MaxFieldAlignmentAttr>())
+      return Type;
+  }
+  const RecordDecl *Record = Declaration->getDefinition();
+  static const StringRef DescriptorFields[] = {
+      "abi_version", "flags", "component_count", "root_type", "value_type",
+      "path", "components"};
+  static const StringRef ComponentFields[] = {
+      "owner_type", "declaration_owner", "member", "value_type",
+      "getter_selector", "setter_selector", "flags", "reserved"};
+  ArrayRef<StringRef> Fields = Name == "objc3_keypath_descriptor_v2"
+      ? ArrayRef<StringRef>(DescriptorFields)
+      : ArrayRef<StringRef>(ComponentFields);
+  bool Valid = Record && !Record->isUnion() &&
+      !Record->hasAttr<PackedAttr>() &&
+      !Record->hasAttr<MaxFieldAlignmentAttr>() &&
+      std::distance(Record->field_begin(), Record->field_end()) ==
+          static_cast<ptrdiff_t>(Fields.size());
+  if (const auto *CXX = dyn_cast_or_null<CXXRecordDecl>(Record))
+    Valid &= CXX->getNumBases() == 0 && !CXX->isPolymorphic();
+  unsigned Index = 0;
+  if (Valid) {
+    for (const FieldDecl *Field : Record->fields()) {
+      Valid &= Field->getName() == Fields[Index] && !Field->isBitField();
+      const bool IsInteger = Fields[Index] == "abi_version" ||
+          Fields[Index] == "flags" || Fields[Index] == "reserved" ||
+          Fields[Index] == "component_count";
+      if (IsInteger)
+        Valid &= Field->getType()->isUnsignedIntegerType() &&
+            S.Context.getTypeSize(Field->getType()) ==
+                (Fields[Index] == "component_count" ? 64u : 32u);
+      else {
+        Valid &= Field->getType()->isPointerType() &&
+            Field->getType()->getPointeeType().isConstQualified();
+        if (Field->getType()->isPointerType()) {
+          QualType Pointee = Field->getType()->getPointeeType();
+          if (Fields[Index] == "components") {
+            const auto *Component = Pointee->getAs<RecordType>();
+            Valid &= Component && Component->getDecl()->getName() ==
+                                      "objc3_keypath_component_v2";
+          } else {
+            Valid &= S.Context.hasSameUnqualifiedType(Pointee,
+                                                       S.Context.CharTy);
+          }
+        }
+      }
+      ++Index;
+    }
+  }
+  if (Valid)
+    return Type;
+  reject(S, Loc, "objc3.keypath metadata declaration has an incompatible "
+                 "native ABI shape");
+  return {};
+}
+
+QualType importedType(Sema &S, StringRef Name, SourceLocation Loc) {
+  LookupResult Lookup(S, &S.Context.Idents.get(Name), Loc,
+                      Sema::LookupOrdinaryName);
+  S.LookupQualifiedName(Lookup, S.Context.getTranslationUnitDecl());
+  if (Lookup.isSingleResult())
+    if (auto *Alias = dyn_cast<TypedefNameDecl>(Lookup.getFoundDecl()))
+      return checkMetadataType(S, Alias->getUnderlyingType(), Name, Loc);
+  reject(S, Loc, "typed key paths require importing objc3.keypath");
+  return {};
+}
+
+QualType signatureDescriptorType(Sema &S, SourceLocation Loc) {
+  constexpr StringRef Name = "objc3_keypath_descriptor_v2";
+  auto *TU = S.Context.getTranslationUnitDecl();
+  auto *Identifier = &S.Context.Idents.get(Name);
+  LookupResult Ordinary(S, Identifier, Loc, Sema::LookupOrdinaryName);
+  S.LookupQualifiedName(Ordinary, TU);
+  if (Ordinary.isSingleResult()) {
+    if (auto *Alias = dyn_cast<TypedefNameDecl>(Ordinary.getFoundDecl()))
+      return checkMetadataType(S, Alias->getUnderlyingType(), Name, Loc,
+                               /*AllowOpaque=*/true);
+    if (!isa<RecordDecl>(Ordinary.getFoundDecl())) {
+      reject(S, Loc, "key-path metadata name conflicts with an incompatible "
+                     "native declaration");
+      return {};
+    }
+  } else if (!Ordinary.empty()) {
+    reject(S, Loc, "key-path metadata name has ambiguous native declarations");
+    return {};
+  }
+  LookupResult Tag(S, Identifier, Loc, Sema::LookupTagName);
+  S.LookupQualifiedName(Tag, TU);
+  if (Tag.isSingleResult()) {
+    if (auto *Record = dyn_cast<RecordDecl>(Tag.getFoundDecl()))
+      return checkMetadataType(S, S.Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Record), Name, Loc,
+                               /*AllowOpaque=*/true);
+  } else if (Tag.empty()) {
+    // A signature stores only this pointer. Register its public forward tag in
+    // the TU scope so a later objc3.keypath header definition merges normally.
+    RecordDecl *Record = S.Context.buildImplicitRecord(Name);
+    TU->addDecl(Record);
+    S.PushOnScopeChains(Record, S.TUScope, /*AddToContext=*/false);
+    return S.Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Record);
+  }
+  reject(S, Loc, "key-path metadata tag conflicts with an incompatible "
+                 "native declaration");
+  return {};
+}
+
+bool stableIdentity(Sema &S, QualType Type, SourceLocation Loc) {
+  for (QualType Written = Type;;) {
+    if (isa<ObjCTypeParamType>(Written)) {
+      reject(S, Loc, "key-path identity requires concrete Objective-C "
+                     "generic arguments");
+      return false;
+    }
+    QualType Next = Written.getSingleStepDesugaredType(S.Context);
+    if (Next == Written)
+      break;
+    Written = Next;
+  }
+  if (const auto *Object = Type->getAs<ObjCObjectPointerType>()) {
+    if (const auto *Interface = Object->getInterfaceDecl())
+      if (!Interface->hasDefinition()) {
+        reject(S, Loc, "key-path class identity requires a complete "
+                       "Objective-C interface");
+        return false;
+      }
+    for (const auto *Protocol : Object->quals())
+      if (!Protocol->hasDefinition()) {
+        reject(S, Loc, "key-path protocol identity requires a complete "
+                       "Objective-C protocol");
+        return false;
+      }
+    for (QualType Argument : Object->getTypeArgs())
+      if (!stableIdentity(S, Argument, Loc))
+        return false;
+  } else if (Type->isPointerType() || Type->isReferenceType() ||
+             Type->isBlockPointerType()) {
+    return stableIdentity(S, Type->getPointeeType(), Loc);
+  } else if (const auto *Member = Type->getAs<MemberPointerType>()) {
+    return stableIdentity(S, Member->getPointeeType(), Loc);
+  } else if (const auto *Function = Type->getAs<FunctionType>()) {
+    if (!stableIdentity(S, Function->getReturnType(), Loc))
+      return false;
+    if (const auto *Proto = dyn_cast<FunctionProtoType>(Function))
+      for (QualType Parameter : Proto->param_types())
+        if (!stableIdentity(S, Parameter, Loc))
+          return false;
+  } else if (const auto *Array = S.Context.getAsArrayType(Type)) {
+    return stableIdentity(S, Array->getElementType(), Loc);
+  } else if (const auto *Atomic = Type->getAs<AtomicType>()) {
+    return stableIdentity(S, Atomic->getValueType(), Loc);
+  }
+  return true;
+}
+
+QualType normalizeRoot(Sema &S, QualType Root, SourceLocation Loc) {
+  if (!Root.isNull() && Root->isObjCObjectType())
+    Root = S.Context.getObjCObjectPointerType(Root);
+  if (Root.isNull() || Root->isDependentType() ||
+      !Root->isObjCObjectPointerType() ||
+      !Root->castAs<ObjCObjectPointerType>()->getInterfaceDecl()) {
+    reject(S, Loc, "key-path root must name a concrete Objective-C class");
+    return {};
+  }
+  if (!stableIdentity(S, Root, Loc))
+    return {};
+  if (containsObjC3BorrowedType(S.Context, Root)) {
+    reject(S, Loc, "key-path root cannot erase borrowed provenance");
+    return {};
+  }
+  if (Root->getNullability() == NullabilityKind::Nullable ||
+      Root->getNullability() == NullabilityKind::NullableResult) {
+    reject(S, Loc, "key-path root type must not be nullable");
+    return {};
+  }
+  Root = Root.getUnqualifiedType();
+  (void)AttributedType::stripOuterNullability(Root);
+  return S.Context.getAttributedType(attr::TypeNonNull, Root, Root);
+}
+
+QualType normalizeValue(Sema &, QualType Value) {
+  // Canonicalization erases attributed nullability inside generic arguments,
+  // pointer pointees, and callable types. Keep these source-bearing types in
+  // typed accessors; the independent identity encoder canonicalizes aliases.
+  return Value.getUnqualifiedType();
+}
+
+bool erasesOwnership(Sema &S, QualType Value) {
+  llvm::SmallPtrSet<const Type *, 16> Seen;
+  auto Visit = [&](auto &&Self, QualType Type) -> bool {
+    const auto Resource = getObjC3ResourceTypeContract(S.Context, Type);
+    if (isObjC3BorrowedType(S.Context, Type) || Resource.Cleanup ||
+        Resource.Family)
+      return true;
+    if (!Seen.insert(Type.getCanonicalType().getTypePtr()).second)
+      return false;
+    if (const auto *Record = Type->getAs<RecordType>()) {
+      if (const auto *Definition = Record->getDecl()->getDefinition()) {
+        for (const FieldDecl *Field : Definition->fields())
+          if (Self(Self, Field->getType()))
+            return true;
+        if (const auto *CXX = dyn_cast<CXXRecordDecl>(Definition))
+          for (const auto &Base : CXX->bases())
+            if (Self(Self, Base.getType()))
+              return true;
+      }
+    }
+    if (Type->isPointerType() || Type->isReferenceType() ||
+        Type->isBlockPointerType())
+      return Self(Self, Type->getPointeeType());
+    if (const auto *Member = Type->getAs<MemberPointerType>())
+      return Self(Self, Member->getPointeeType());
+    if (const auto *Function = Type->getAs<FunctionType>()) {
+      if (Self(Self, Function->getReturnType()))
+        return true;
+      if (const auto *Proto = dyn_cast<FunctionProtoType>(Function))
+        for (QualType Parameter : Proto->param_types())
+          if (Self(Self, Parameter))
+            return true;
+    }
+    if (const auto *Array = S.Context.getAsArrayType(Type))
+      return Self(Self, Array->getElementType());
+    return false;
+  };
+  return Visit(Visit, Value);
+}
+
+bool unionHasManagedLeaves(QualType Type,unsigned Depth=0) {
+  if(Depth>64)return true;
+  if(Type->isObjCRetainableType() || containsObjC3CarrierManagedStorage(Type))return true;
+  if(const auto *Array=Type->getAsArrayTypeUnsafe())return unionHasManagedLeaves(Array->getElementType(),Depth+1);
+  if(const auto *Record=Type->getAs<RecordType>())
+    if(const auto *Definition=Record->getDecl()->getDefinition()) {
+      for(const auto *Field:Definition->fields())
+        if(unionHasManagedLeaves(Field->getType(),Depth+1))return true;
+    }
+  return false;
+}
+
+std::string typeIdentity(ASTContext &Context, QualType Type) {
+  PrintingPolicy Policy(Context.getLangOpts());
+  Policy.SuppressTagKeyword = false;
+  Policy.Bool = false; // One metadata/record identity across C and C++ spellings.
+  std::string Identity =
+      QualType(Context.getCanonicalType(Type)).getUnqualifiedType().getAsString(Policy);
+  if (Type->canHaveNullability())
+    Identity += ";nullability=" + std::to_string(static_cast<unsigned>(
+        Type->getNullability().value_or(NullabilityKind::Unspecified)));
+  if (const auto *Object = Type->getAs<ObjCObjectPointerType>()) {
+    if (const auto *Interface = Object->getInterfaceDecl())
+      Identity += ";objc-runtime=" +
+                  Interface->getObjCRuntimeNameAsString().str();
+    SmallVector<std::string, 4> Protocols;
+    for (const auto *Protocol : Object->quals())
+      Protocols.push_back(Protocol->getObjCRuntimeNameAsString().str());
+    llvm::sort(Protocols);
+    for (const auto &Protocol : Protocols)
+      Identity += ";protocol-runtime={" + Protocol + "}";
+    for (QualType Argument : Object->getTypeArgs())
+      Identity += ";argument={" + typeIdentity(Context, Argument) + "}";
+  } else if (Type->isPointerType() || Type->isReferenceType() ||
+             Type->isBlockPointerType()) {
+    Identity += ";pointee={" +
+                typeIdentity(Context, Type->getPointeeType()) + "}";
+  } else if (const auto *Member = Type->getAs<MemberPointerType>()) {
+    Identity += ";member-pointee={" +
+                typeIdentity(Context, Member->getPointeeType()) + "}";
+  } else if (const auto *Function = Type->getAs<FunctionType>()) {
+    Identity += ";result={" +
+                typeIdentity(Context, Function->getReturnType()) + "}";
+    if (const auto *Proto = dyn_cast<FunctionProtoType>(Function))
+      for (QualType Parameter : Proto->param_types())
+        Identity += ";parameter={" + typeIdentity(Context, Parameter) + "}";
+  } else if (const auto *Array = Context.getAsArrayType(Type)) {
+    Identity += ";element={" +
+                typeIdentity(Context, Array->getElementType()) + "}";
+  } else if (const auto *Atomic = Type->getAs<AtomicType>()) {
+    Identity += ";atomic={" +
+                typeIdentity(Context, Atomic->getValueType()) + "}";
+  }
+  return Identity;
+}
+
+std::string recordName(Sema &S, QualType Root, QualType Value, bool Writable) {
+  // Canonical source types, rather than addresses, source offsets, typedef
+  // spelling, or runtime Class addresses, define the separate-compilation ABI.
+  std::string Signature = typeIdentity(S.Context, Root) + " -> " +
+                          typeIdentity(S.Context, Value) + ":" +
+                          std::to_string(static_cast<unsigned>(
+                              Value->getNullability().value_or(
+                                  NullabilityKind::Unspecified)));
+  llvm::MD5 Hash;
+  Hash.update(Signature);
+  llvm::MD5::MD5Result Digest;
+  Hash.final(Digest);
+  llvm::SmallString<32> Hex;
+  llvm::MD5::stringifyResult(Digest, Hex);
+  return std::string(Writable ? "__objc3_writable_keypath_v2_"
+                              : "__objc3_keypath_v2_") + Hex.str().str();
+}
+
+FieldDecl *addField(Sema &S, RecordDecl *Record, StringRef Name, QualType Type,
+                    SourceLocation Loc) {
+  auto *Field = FieldDecl::Create(
+      S.Context, Record, Loc, Loc, &S.Context.Idents.get(Name), Type,
+      S.Context.getTrivialTypeSourceInfo(Type, Loc), nullptr, false, ICIS_NoInit);
+  Field->setImplicit();
+  Field->setAccess(AS_public);
+  Record->addDecl(Field);
+  return Field;
+}
+
+CXXConversionDecl *addReadonlyConversion(Sema &S, CXXRecordDecl *Record,
+                                           FieldDecl *Read,
+                                           SourceLocation Loc) {
+  QualType Target = Read->getType();
+  FunctionProtoType::ExtProtoInfo Info;
+  Info.TypeQuals.addConst();
+  QualType FunctionType = S.Context.getFunctionType(Target, {}, Info);
+  DeclarationName Name =
+      S.Context.DeclarationNames.getCXXConversionFunctionName(
+          S.Context.getCanonicalType(Target));
+  DeclarationNameLoc NameLoc = DeclarationNameLoc::makeNamedTypeLoc(
+      S.Context.getTrivialTypeSourceInfo(Target, Loc));
+  auto *Conversion = CXXConversionDecl::Create(
+      S.Context, Record, Loc, DeclarationNameInfo(Name, Loc, NameLoc),
+      FunctionType, S.Context.getTrivialTypeSourceInfo(FunctionType, Loc),
+      S.getCurFPFeatures().isFPConstrained(), true, ExplicitSpecifier(),
+      ConstexprSpecKind::Unspecified, Loc);
+  Conversion->setAccess(AS_public);
+  Conversion->setImplicit();
+  Record->addDecl(Conversion);
+  {
+    Sema::SynthesizedFunctionScope FunctionScope(S, Conversion);
+    QualType ThisType = S.Context.getPointerType(
+        S.Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Record).withConst());
+    auto *This = CXXThisExpr::Create(S.Context, Loc, ThisType, true);
+    Expr *Selected = MemberExpr::CreateImplicit(
+        S.Context, This, true, Read, Target.withConst(), VK_LValue, OK_Ordinary);
+    StmtResult Return = S.BuildReturnStmt(Loc, Selected);
+    if (Return.isInvalid())
+      return nullptr;
+    Stmt *Body[] = {Return.get()};
+    Conversion->setBody(CompoundStmt::Create(
+        S.Context, Body, FPOptionsOverride(), Loc, Loc));
+  }
+  return Conversion;
+}
+
+QualType keyPathType(Sema &S, QualType Root, QualType Value, bool Writable,
+                     QualType Descriptor, SourceLocation Loc) {
+  if (erasesOwnership(S, Value)) {
+    reject(S, Loc, "key paths cannot erase borrowed provenance or scalar "
+                   "resource ownership");
+    return {};
+  }
+  if (Value->isDependentType() || Value->isVoidType() ||
+      Value->isReferenceType() || Value->isArrayType() ||
+      Value->isFunctionType() || Value->isVariablyModifiedType() ||
+      Value->isIncompleteType() || !Value.isTriviallyCopyableType(S.Context)) {
+    reject(S, Loc, "key-path value must be a complete nondependent trivially "
+                   "copyable value or Objective-C object pointer");
+    return {};
+  }
+  if (const auto *Record = Value->getAs<RecordType>()) {
+    const RecordDecl *Declaration = Record->getDecl();
+    if (!Declaration->getIdentifier() &&
+        !Declaration->getTypedefNameForAnonDecl()) {
+      reject(S, Loc, "key-path record values require a stable named type");
+      return {};
+    }
+  }
+  if (!stableIdentity(S, Value, Loc))
+    return {};
+  Value = normalizeValue(S, Value);
+  std::string Name = recordName(S, Root, Value, Writable);
+  auto *TU = S.Context.getTranslationUnitDecl();
+  LookupResult Lookup(S, &S.Context.Idents.get(Name), Loc, Sema::LookupTagName);
+  S.LookupQualifiedName(Lookup, TU);
+  if (!Lookup.empty()) {
+    ObjC3KeyPathInfo Existing;
+    if (Lookup.isSingleResult())
+      if (auto *Record = dyn_cast<RecordDecl>(Lookup.getFoundDecl())) {
+        QualType ExistingType = S.Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Record);
+        if (getObjC3KeyPathInfo(ExistingType, Existing) &&
+            bool(Existing.Read) == Writable &&
+            typeIdentity(S.Context, Existing.Root) ==
+                typeIdentity(S.Context, Root) &&
+            typeIdentity(S.Context, Existing.Value) ==
+                typeIdentity(S.Context, Value))
+          return ExistingType;
+      }
+    reject(S, Loc, "key-path type conflicts with an incompatible native "
+                   "record identity");
+    return {};
+  }
+
+  RecordDecl *Record = S.Context.buildImplicitRecord(Name);
+  TU->addDecl(Record);
+  Record->addAttr(AnnotateAttr::CreateImplicit(
+      S.Context, Writable ? "objc3.keypath.v2.writable" : "objc3.keypath.v2",
+      nullptr, 0));
+  Record->startDefinition();
+  FunctionProtoType::ExtProtoInfo Info;
+  CXXConversionDecl *Conversion = nullptr;
+  QualType Getter = S.Context.getPointerType(
+      S.Context.getFunctionType(Value, {Root}, Info));
+  if (Writable) {
+    QualType ReadOnly = keyPathType(S, Root, Value, false, Descriptor, Loc);
+    if (ReadOnly.isNull())
+      return {};
+    FieldDecl *Read = addField(S, Record, "__objc3_read", ReadOnly, Loc);
+    QualType Setter = S.Context.getPointerType(
+        S.Context.getFunctionType(S.Context.VoidTy, {Root, Value}, Info));
+    addField(S, Record, "__objc3_set", Setter, Loc);
+    if (auto *CXX = dyn_cast<CXXRecordDecl>(Record)) {
+      Conversion = addReadonlyConversion(S, CXX, Read, Loc);
+      if (!Conversion)
+        return {};
+    }
+  } else {
+    addField(S, Record, "__objc3_metadata",
+             S.Context.getPointerType(Descriptor.withConst()), Loc);
+    addField(S, Record, "__objc3_get", Getter, Loc);
+  }
+  if (auto *CXX = dyn_cast<CXXRecordDecl>(Record))
+    CXX->completeDefinition();
+  else
+    Record->completeDefinition();
+  if (Conversion)
+    S.Consumer.HandleInlineFunctionDefinition(Conversion);
+  return S.Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Record);
+}
+
+Expr *field(Sema &S, Expr *Base, FieldDecl *Field) {
+  // C++ member access materializes a record prvalue and produces an xvalue.
+  // Building the MemberExpr directly loses that conversion for descriptor
+  // temporaries, including readonly keypath conversions.
+  if (S.getLangOpts().CPlusPlus) {
+    ExprResult Converted = S.TemporaryMaterializationConversion(Base);
+    assert(!Converted.isInvalid() && "generated keypath base conversion failed");
+    Base = Converted.get();
+  }
+  auto *Selection = MemberExpr::CreateImplicit(
+      S.Context, Base, false, Field, Field->getType(),
+      Base->isLValue() ? VK_LValue : Base->isXValue() ? VK_XValue : VK_PRValue,
+      OK_Ordinary);
+  Selection->setMemberLoc(Base->getEndLoc());
+  return Selection;
+}
+
+Expr *reference(Sema &S, ValueDecl *Decl, SourceLocation Loc) {
+  return S.BuildDeclRefExpr(Decl, Decl->getType(), VK_LValue, Loc);
+}
+
+Expr *text(Sema &S, StringRef Text, SourceLocation Loc) {
+  QualType Array = S.Context.getConstantArrayType(
+      S.Context.CharTy.withConst(), llvm::APInt(64, Text.size() + 1), nullptr,
+      ArraySizeModifier::Normal, 0);
+  auto *String = StringLiteral::Create(S.Context, Text,
+      StringLiteralKind::Ordinary, false, Array, Loc);
+  return S.DefaultFunctionArrayLvalueConversion(String).get();
+}
+
+Expr *integer(Sema &S, unsigned Width, uint64_t Value, SourceLocation Loc) {
+  QualType Type = S.Context.getIntTypeForBitwidth(Width, /*Signed=*/false);
+  return IntegerLiteral::Create(S.Context, llvm::APInt(Width, Value), Type, Loc);
+}
+
+InitListExpr *aggregate(Sema &S, QualType Type, ArrayRef<Expr *> Values,
+                        SourceLocation Loc) {
+  auto *List = new (S.Context) InitListExpr(S.Context, Loc, Values, Loc, /*isExplicit=*/false);
+  List->setType(Type);
+  return List;
+}
+
+std::string uniqueName(Sema &S, StringRef Kind, SourceLocation Loc) {
+  std::string Prefix = ("__objc3_keypath_" + Kind + "_" +
+                        llvm::Twine(Loc.getRawEncoding())).str();
+  std::string Name = Prefix;
+  unsigned Suffix = 0;
+  auto *TU = S.Context.getTranslationUnitDecl();
+  while (!TU->lookup(&S.Context.Idents.get(Name)).empty())
+    Name = Prefix + "_" + std::to_string(++Suffix);
+  return Name;
+}
+
+VarDecl *global(Sema &S, StringRef Kind, QualType Type, Expr *Initializer,
+                 SourceLocation Loc) {
+  auto *TU = S.Context.getTranslationUnitDecl();
+  auto *Variable = VarDecl::Create(
+      S.Context, TU, Loc, Loc, &S.Context.Idents.get(uniqueName(S, Kind, Loc)),
+      Type, S.Context.getTrivialTypeSourceInfo(Type, Loc), SC_Static);
+  Variable->setImplicit();
+  Variable->setInit(Initializer);
+  TU->addDecl(Variable);
+  S.Consumer.HandleTopLevelDecl(DeclGroupRef(Variable));
+  return Variable;
+}
+
+struct Component {
+  ObjCPropertyDecl *Property = nullptr;
+  FieldDecl *Field = nullptr;
+  QualType Owner, Value;
+  SourceLocation Loc;
+};
+
+bool readonly(const Component &Part) {
+  return Part.Property ? Part.Property->isReadOnly() ||
+                             !Part.Property->getSetterMethodDecl()
+                       : Part.Field->getType().isConstQualified();
+}
+
+ExprResult readComponent(Sema &S, Expr *Receiver, const Component &Part) {
+  if (Part.Property) {
+    ExprResult Converted = S.DefaultFunctionArrayLvalueConversion(Receiver);
+    if (Converted.isInvalid())
+      return ExprError();
+    Receiver = Converted.get();
+    return S.ObjC().BuildInstanceMessageImplicit(
+        Receiver, Receiver->getType(), Part.Loc, Part.Property->getGetterName(),
+        Part.Property->getGetterMethodDecl(), {});
+  }
+  if (S.getLangOpts().CPlusPlus && Receiver->isPRValue()) {
+    ExprResult Materialized = S.TemporaryMaterializationConversion(Receiver);
+    if (Materialized.isInvalid())
+      return ExprError();
+    Receiver = Materialized.get();
+  }
+  CXXScopeSpec Scope;
+  return S.BuildFieldReferenceExpr(
+      Receiver, false, Part.Loc, Scope, Part.Field,
+      DeclAccessPair::make(Part.Field, Part.Field->getAccess()),
+      DeclarationNameInfo(Part.Field->getDeclName(), Part.Loc));
+}
+
+std::pair<VarDecl *, DeclStmt *> recordSnapshot(Sema &S, Expr *Source,
+                                               SourceLocation Loc) {
+  QualType Type = Source->getType().getUnqualifiedType();
+  auto *Variable = VarDecl::Create(
+      S.Context, S.CurContext, Loc, Loc, &S.Context.Idents.get("snapshot"), Type,
+      S.Context.getTrivialTypeSourceInfo(Type, Loc), SC_None);
+  Variable->setImplicit();
+  ExprResult Init = S.PerformCopyInitialization(
+      InitializedEntity::InitializeVariable(Variable), Loc, Source);
+  if (Init.isInvalid())
+    return {};
+  Init = S.ActOnFinishFullExpr(Init.get(), Loc, false);
+  if (Init.isInvalid())
+    return {};
+  Variable->setInit(Init.get());
+  S.CheckCompleteVariableDeclaration(Variable);
+  if (Variable->isInvalidDecl())
+    return {};
+  S.CurContext->addDecl(Variable);
+  return {Variable,
+          new (S.Context) DeclStmt(DeclGroupRef(Variable), Loc, Loc)};
+}
+
+/// A record property is returned by value. Mutating one of its fields must
+/// update one snapshot and call that property's setter once. Retain the exact
+/// receiver through both calls under ARC and MRC, including native unwinding.
+StmtResult recordFieldSetter(Sema &S, Expr *Root, Expr *Value,
+                             ArrayRef<Component> Components,
+                             SourceLocation Loc) {
+  unsigned Boundary = Components.size() - 1;
+  while (Components[Boundary].Field)
+    --Boundary;
+  ExprResult Receiver = Root;
+  for (unsigned I = 0; I < Boundary; ++I) {
+    Receiver = readComponent(S, Receiver.get(), Components[I]);
+    if (Receiver.isInvalid())
+      return StmtError();
+  }
+  DeclStmt *OwnerBinding = S.BuildObjC3LifetimeBinding(Receiver.get(), Loc);
+  if (!OwnerBinding)
+    return StmtError();
+  auto *Owner = cast<VarDecl>(OwnerBinding->getSingleDecl());
+  ExprResult OwnerValue =
+      S.DefaultLvalueConversion(reference(S, Owner, Loc));
+  if (OwnerValue.isInvalid())
+    return StmtError();
+  ExprResult Read = readComponent(S, OwnerValue.get(), Components[Boundary]);
+  if (Read.isInvalid())
+    return StmtError();
+  auto [Snapshot, SnapshotDecl] = recordSnapshot(S, Read.get(), Loc);
+  if (!Snapshot)
+    return StmtError();
+  ExprResult Selected = reference(S, Snapshot, Loc);
+  for (unsigned I = Boundary + 1; I < Components.size(); ++I) {
+    Selected = readComponent(S, Selected.get(), Components[I]);
+    if (Selected.isInvalid())
+      return StmtError();
+  }
+  ExprResult Assignment = S.BuildBinOp(nullptr, Loc, BO_Assign,
+                                       Selected.get(), Value);
+  if (Assignment.isInvalid())
+    return StmtError();
+  Assignment = S.ActOnFinishFullExpr(Assignment.get(), Loc, true);
+  if (Assignment.isInvalid())
+    return StmtError();
+  OwnerValue = S.DefaultLvalueConversion(reference(S, Owner, Loc));
+  if (OwnerValue.isInvalid())
+    return StmtError();
+  Expr *Arg = reference(S, Snapshot, Loc);
+  const auto &Property = Components[Boundary];
+  ExprResult Write = S.ObjC().BuildInstanceMessageImplicit(
+      OwnerValue.get(), OwnerValue.get()->getType(), Property.Loc,
+      Property.Property->getSetterName(),
+      Property.Property->getSetterMethodDecl(), Arg);
+  if (Write.isInvalid())
+    return StmtError();
+  Write = S.ActOnFinishFullExpr(Write.get(), Loc, true);
+  if (Write.isInvalid())
+    return StmtError();
+  Stmt *Body[] = {SnapshotDecl, Assignment.get(), Write.get()};
+  auto *Compound = CompoundStmt::Create(
+      S.Context, Body, FPOptionsOverride(), Loc, Loc);
+  return S.BuildObjC3LifetimeStmt(OwnerBinding, Compound, Loc, Loc, Loc, Loc);
+}
+
+StmtResult setterBody(Sema &S, Expr *Receiver, Expr *Value,
+                      ArrayRef<Component> Components, SourceLocation Loc) {
+  if (Components.back().Field)
+    return recordFieldSetter(S, Receiver, Value, Components, Loc);
+  ExprResult Current = Receiver;
+  for (unsigned I = 0; I < Components.size(); ++I) {
+    const auto &Part = Components[I];
+    if (I + 1 == Components.size()) {
+      Current = S.DefaultFunctionArrayLvalueConversion(Current.get());
+      if (Current.isInvalid())
+        return StmtError();
+      Current = S.ObjC().BuildInstanceMessageImplicit(
+          Current.get(), Current.get()->getType(), Part.Loc,
+          Part.Property->getSetterName(), Part.Property->getSetterMethodDecl(),
+          Value);
+    } else
+      Current = readComponent(S, Current.get(), Part);
+    if (Current.isInvalid())
+      return StmtError();
+  }
+  ExprResult Finished = S.ActOnFinishFullExpr(Current.get(), Loc, true);
+  return Finished.isInvalid() ? StmtError() : StmtResult(Finished.get());
+}
+
+bool nullable(QualType Type) {
+  return Type->getNullability() == NullabilityKind::Nullable ||
+         Type->getNullability() == NullabilityKind::NullableResult;
+}
+
+StmtResult nullableGetter(Sema &S, Expr *Receiver,
+                           ArrayRef<Component> Components,
+                           unsigned Index, SourceLocation Loc) {
+  const Component &Part = Components[Index];
+  ExprResult Read = readComponent(S, Receiver, Part);
+  if (Read.isInvalid())
+    return StmtError();
+  if (Index + 1 == Components.size())
+    return S.BuildReturnStmt(Loc, Read.get());
+
+  if (Read.get()->getType()->isObjCRetainableType()) {
+    // Keep the actual getter result, including a weak load or copied Block,
+    // alive across the complete remaining chain in both ARC and MRC.
+    DeclStmt *Binding = S.BuildObjC3LifetimeBinding(Read.get(), Part.Loc);
+    if (!Binding)
+      return StmtError();
+    auto *Owner = cast<VarDecl>(Binding->getSingleDecl());
+    ExprResult Snapshot =
+        S.DefaultLvalueConversion(reference(S, Owner, Part.Loc));
+    if (Snapshot.isInvalid())
+      return StmtError();
+    SmallVector<Stmt *, 2> Body;
+    if (nullable(Part.Value)) {
+      ExprResult Missing = S.BuildUnaryOp(nullptr, Part.Loc, UO_LNot,
+                                           Snapshot.get());
+      ExprResult Nil = S.ActOnIntegerConstant(Part.Loc, 0);
+      if (Missing.isInvalid() || Nil.isInvalid())
+        return StmtError();
+      StmtResult ReturnNil = S.BuildReturnStmt(Part.Loc, Nil.get());
+      if (ReturnNil.isInvalid())
+        return StmtError();
+      Body.push_back(IfStmt::Create(S.Context, Part.Loc,
+          IfStatementKind::Ordinary, nullptr, nullptr, Missing.get(),
+          Part.Loc, Part.Loc, ReturnNil.get()));
+    }
+    StmtResult Tail = nullableGetter(S, Snapshot.get(), Components,
+                                     Index + 1, Loc);
+    if (Tail.isInvalid())
+      return StmtError();
+    Body.push_back(Tail.get());
+    auto *Compound = CompoundStmt::Create(
+        S.Context, Body, FPOptionsOverride(), Part.Loc, Loc);
+    return S.BuildObjC3LifetimeStmt(Binding, Compound, Part.Loc,
+                                     Part.Loc, Part.Loc, Loc);
+  }
+
+  // A native record between object components is copied exactly once. This
+  // also preserves native ARC aggregate copy/disposal for managed fields.
+  auto [Snapshot, Declaration] = recordSnapshot(S, Read.get(), Part.Loc);
+  if (!Snapshot)
+    return StmtError();
+  StmtResult Tail = nullableGetter(S, reference(S, Snapshot, Part.Loc),
+                                   Components, Index + 1, Loc);
+  if (Tail.isInvalid())
+    return StmtError();
+  Stmt *Body[] = {Declaration, Tail.get()};
+  return CompoundStmt::Create(S.Context, Body, FPOptionsOverride(),
+                               Part.Loc, Loc);
+}
+
+/// Read and pin the routing prefix through the last nullable receiver. No
+/// record in that prefix is itself modified: the write targets the object
+/// reached through the nullable edge. A missing receiver makes the write a
+/// no-op, after normal evaluation of the application's root/key/value operands.
+StmtResult nullableSetter(Sema &S, Expr *Receiver, Expr *Value,
+                          ArrayRef<Component> Components, unsigned Index,
+                          unsigned LastNullable, SourceLocation Loc) {
+  if (Index > LastNullable)
+    return setterBody(S, Receiver, Value, Components.drop_front(Index), Loc);
+  const auto &Part = Components[Index];
+  ExprResult Read = readComponent(S, Receiver, Part);
+  if (Read.isInvalid())
+    return StmtError();
+  if (Read.get()->getType()->isObjCRetainableType()) {
+    DeclStmt *Binding = S.BuildObjC3LifetimeBinding(Read.get(), Part.Loc);
+    if (!Binding)
+      return StmtError();
+    auto *Owner = cast<VarDecl>(Binding->getSingleDecl());
+    ExprResult Snapshot =
+        S.DefaultLvalueConversion(reference(S, Owner, Part.Loc));
+    if (Snapshot.isInvalid())
+      return StmtError();
+    SmallVector<Stmt *, 2> Body;
+    if (nullable(Part.Value)) {
+      ExprResult Missing =
+          S.BuildUnaryOp(nullptr, Part.Loc, UO_LNot, Snapshot.get());
+      StmtResult Stop = S.BuildReturnStmt(Part.Loc, nullptr);
+      if (Missing.isInvalid() || Stop.isInvalid())
+        return StmtError();
+      Body.push_back(IfStmt::Create(
+          S.Context, Part.Loc, IfStatementKind::Ordinary, nullptr, nullptr,
+          Missing.get(), Part.Loc, Part.Loc, Stop.get()));
+    }
+    StmtResult Tail = nullableSetter(S, Snapshot.get(), Value, Components,
+                                     Index + 1, LastNullable, Loc);
+    if (Tail.isInvalid())
+      return StmtError();
+    Body.push_back(Tail.get());
+    auto *Compound = CompoundStmt::Create(S.Context, Body, FPOptionsOverride(),
+                                          Part.Loc, Loc);
+    return S.BuildObjC3LifetimeStmt(Binding, Compound, Part.Loc, Part.Loc,
+                                    Part.Loc, Loc);
+  }
+  auto [Snapshot, Declaration] = recordSnapshot(S, Read.get(), Part.Loc);
+  if (!Snapshot)
+    return StmtError();
+  StmtResult Tail = nullableSetter(S, reference(S, Snapshot, Part.Loc), Value,
+                                   Components, Index + 1, LastNullable, Loc);
+  if (Tail.isInvalid())
+    return StmtError();
+  Stmt *Body[] = {Declaration, Tail.get()};
+  return CompoundStmt::Create(S.Context, Body, FPOptionsOverride(), Part.Loc,
+                              Loc);
+}
+
+std::string declarationOwner(const ObjCPropertyDecl *Property) {
+  const DeclContext *Owner = Property->getDeclContext();
+  if (const auto *Category = dyn_cast<ObjCCategoryDecl>(Owner)) {
+    std::string Name =
+        Category->getClassInterface()->getQualifiedNameAsString() + "(" +
+        Category->getNameAsString() + ");objc-runtime=" +
+        Category->getClassInterface()->getObjCRuntimeNameAsString().str();
+    for (const auto *Annotation : Category->specific_attrs<AnnotateAttr>())
+      if (Annotation->getAnnotation().starts_with("objc3.module-name:"))
+        Name += ";category-runtime=" +
+                Annotation->getAnnotation().drop_front(18).str();
+    return Name;
+  }
+  if (const auto *Interface = dyn_cast<ObjCInterfaceDecl>(Owner))
+    return Interface->getQualifiedNameAsString() +
+           ";objc-runtime=" + Interface->getObjCRuntimeNameAsString().str();
+  if (const auto *Protocol = dyn_cast<ObjCProtocolDecl>(Owner))
+    return Protocol->getQualifiedNameAsString() +
+           ";objc-runtime=" + Protocol->getObjCRuntimeNameAsString().str();
+  if (const auto *Named = dyn_cast<NamedDecl>(Decl::castFromDeclContext(Owner)))
+    return Named->getQualifiedNameAsString();
+  return "<unknown>";
+}
+
+FunctionDecl *accessor(Sema &S, QualType Root, QualType Value,
+                        ArrayRef<Component> Components, bool Setter,
+                        SourceLocation Loc, bool NullableTraversal = false) {
+  auto *TU = S.Context.getTranslationUnitDecl();
+  SmallVector<QualType, 2> ParamTypes{Root};
+  if (Setter)
+    ParamTypes.push_back(Value);
+  QualType FunctionType = S.Context.getFunctionType(
+      Setter ? S.Context.VoidTy : Value, ParamTypes,
+      FunctionProtoType::ExtProtoInfo());
+  auto *Function = FunctionDecl::Create(
+      S.Context, TU, Loc, Loc,
+      &S.Context.Idents.get(uniqueName(S, Setter ? "set" : "get", Loc)),
+      FunctionType, S.Context.getTrivialTypeSourceInfo(FunctionType, Loc),
+      SC_Static);
+  Function->setImplicit();
+  if (!Setter)
+    Function->addAttr(AnnotateAttr::CreateImplicit(
+        S.Context, "objc3.keypath.getter.v2", nullptr, 0));
+  SmallVector<ParmVarDecl *, 2> Params;
+  for (unsigned I = 0; I != ParamTypes.size(); ++I) {
+    auto *Param = ParmVarDecl::Create(
+        S.Context, Function, Loc, Loc,
+        &S.Context.Idents.get(I ? "value" : "root"), ParamTypes[I],
+        S.Context.getTrivialTypeSourceInfo(ParamTypes[I], Loc), SC_None, nullptr);
+    Param->setImplicit();
+    Function->addDecl(Param);
+    Params.push_back(Param);
+  }
+  Function->setParams(Params);
+  TU->addDecl(Function);
+  {
+    Sema::SynthesizedFunctionScope FunctionScope(S, Function);
+    ExprResult Receiver = S.DefaultLvalueConversion(reference(S, Params[0], Loc));
+    if (Receiver.isInvalid())
+      return nullptr;
+    SmallVector<Stmt *, 1> Body;
+    if (NullableTraversal) {
+      assert(nullable(Value) && Value->isObjCRetainableType());
+      StmtResult Application;
+      if (Setter) {
+        unsigned LastNullable = 0;
+        for (unsigned I = 0; I + 1 < Components.size(); ++I)
+          if (nullable(Components[I].Value))
+            LastNullable = I;
+        Application =
+            nullableSetter(S, Receiver.get(), reference(S, Params[1], Loc),
+                           Components, 0, LastNullable, Loc);
+      } else
+        Application = nullableGetter(S, Receiver.get(), Components, 0, Loc);
+      if (Application.isInvalid())
+        return nullptr;
+      Body.push_back(Application.get());
+    } else if (Setter && Components.back().Field) {
+      StmtResult Set = recordFieldSetter(S, Receiver.get(),
+          reference(S, Params[1], Loc), Components, Loc);
+      if (Set.isInvalid())
+        return nullptr;
+      Body.push_back(Set.get());
+    } else {
+      for (unsigned I = 0; I != Components.size(); ++I) {
+        const auto &Part = Components[I];
+        if (Setter && I + 1 == Components.size()) {
+          Receiver = S.DefaultFunctionArrayLvalueConversion(Receiver.get());
+          if (Receiver.isInvalid())
+            return nullptr;
+          Expr *Arg = reference(S, Params[1], Loc);
+          Receiver = S.ObjC().BuildInstanceMessageImplicit(
+              Receiver.get(), Receiver.get()->getType(), Part.Loc,
+              Part.Property->getSetterName(),
+              Part.Property->getSetterMethodDecl(), Arg);
+        } else {
+          Receiver = readComponent(S, Receiver.get(), Part);
+        }
+        if (Receiver.isInvalid())
+          return nullptr;
+      }
+      if (Setter) {
+        ExprResult Finished = S.ActOnFinishFullExpr(Receiver.get(), Loc, true);
+        if (Finished.isInvalid())
+          return nullptr;
+        Body.push_back(Finished.get());
+      } else {
+        StmtResult Return = S.BuildReturnStmt(Loc, Receiver.get());
+        if (Return.isInvalid())
+          return nullptr;
+        Body.push_back(Return.get());
+      }
+    }
+    Function->setBody(CompoundStmt::Create(
+        S.Context, Body, FPOptionsOverride(), Loc, Loc));
+  }
+  S.Consumer.HandleTopLevelDecl(DeclGroupRef(Function));
+  return Function;
+}
+
+bool nullableOperand(Sema &S, Expr *Operand) {
+  Operand = Operand->IgnoreParens();
+  if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Operand))
+    if (Opaque->getSourceExpr()) return nullableOperand(S, Opaque->getSourceExpr());
+  if (Operand->getType()->getNullability() == NullabilityKind::Nullable ||
+      Operand->getType()->getNullability() == NullabilityKind::NullableResult ||
+      Operand->isNullPointerConstant(S.Context, Expr::NPC_ValueDependentIsNotNull))
+    return true;
+  Expr::EvalResult Value;
+  return !Operand->HasSideEffects(S.Context) && Operand->EvaluateAsRValue(Value, S.Context) &&
+      Value.Val.isLValue() && Value.Val.isNullPointer();
+}
+
+ExprResult captureApplicationOperand(Sema &S, Expr *Source,
+                                      SmallVectorImpl<Expr *> &Semantics) {
+  ExprResult Value;
+  if (Source->getType()->isRecordType()) {
+    Value = S.PerformCopyInitialization(
+        InitializedEntity::InitializeTemporary(Source->getType().getUnqualifiedType()),
+        Source->getExprLoc(), Source);
+  } else {
+    Value = S.DefaultFunctionArrayLvalueConversion(Source);
+  }
+  if (Value.isInvalid())
+    return ExprError();
+  auto *Capture = new (S.Context) OpaqueValueExpr(
+      Source->getExprLoc(), Value.get()->getType(), Value.get()->getValueKind(),
+      Value.get()->getObjectKind(), Value.get());
+  Semantics.push_back(Capture);
+  // Native CodeGen gives retainable operands an independent precise snapshot
+  // before later operands execute. Establish the enclosing full-expression
+  // cleanup boundary in C/MRC as well as ARC/C++.
+  if (Capture->getType()->isObjCRetainableType())
+    S.Cleanup.setExprNeedsCleanups(true);
+  return Capture;
+}
+
+ExprResult application(Sema &S, unsigned Kind, ArrayRef<Expr *> WrittenArgs,
+                         ArrayRef<Expr *> CapturedArgs,
+                         SmallVectorImpl<Expr *> &Semantics, Expr *Result,
+                         SourceLocation Loc, SourceLocation RParenLoc) {
+  SmallVector<QualType, 3> Types;
+  for (Expr *Arg : CapturedArgs)
+    Types.push_back(Arg->getType().getUnqualifiedType());
+  QualType Type = S.Context.getFunctionType(Result->getType(), Types,
+                                            FunctionProtoType::ExtProtoInfo());
+  auto *Function = FunctionDecl::Create(
+      S.Context, S.Context.getTranslationUnitDecl(), Loc, Loc,
+      &S.Context.Idents.get(getObjC3KeyPathOperationName(Kind)), Type,
+      S.Context.getTrivialTypeSourceInfo(Type, Loc), SC_Extern);
+  Function->setImplicit();
+  Function->addAttr(AnnotateAttr::CreateImplicit(
+      S.Context, "objc3.keypath.application.v2", nullptr, 0));
+  SmallVector<ParmVarDecl *, 3> Params;
+  for (QualType ParamType : Types) {
+    auto *Param = ParmVarDecl::Create(
+        S.Context, Function, Loc, Loc, nullptr, ParamType,
+        S.Context.getTrivialTypeSourceInfo(ParamType, Loc), SC_None, nullptr);
+    Param->setImplicit();
+    Function->addDecl(Param);
+    Params.push_back(Param);
+  }
+  Function->setParams(Params);
+  auto *Reference = new (S.Context) DeclRefExpr(
+      S.Context, Function, false, Type, VK_LValue, Loc,
+      DeclarationNameLoc(), NOUR_Unevaluated);
+  auto *Syntax = CallExpr::Create(S.Context, Reference, WrittenArgs,
+      Result->getType(), VK_PRValue, RParenLoc, FPOptionsOverride());
+  unsigned ResultIndex = Semantics.size();
+  if (isa<OpaqueValueExpr>(Result)) {
+    for (unsigned I = 0; I < Semantics.size(); ++I)
+      if (Semantics[I] == Result) {
+        ResultIndex = I;
+        break;
+      }
+  }
+  if (ResultIndex == Semantics.size())
+    Semantics.push_back(Result);
+  if (Result->getType()->isVoidType())
+    ResultIndex = PseudoObjectExpr::NoResult;
+  return PseudoObjectExpr::Create(S.Context, Syntax, Semantics, ResultIndex);
+}
+} // namespace
+
+TypeResult Sema::ActOnObjC3KeyPathType(bool Writable, ParsedType ParsedRoot,
+                                       ParsedType ParsedValue,
+                                       SourceLocation Loc) {
+  QualType Root = normalizeRoot(*this, GetTypeFromParser(ParsedRoot), Loc);
+  QualType Value = GetTypeFromParser(ParsedValue);
+  QualType Descriptor = signatureDescriptorType(*this, Loc);
+  if (Root.isNull() || Value.isNull() || Descriptor.isNull())
+    return TypeError();
+  QualType Type = keyPathType(*this, Root, Value, Writable, Descriptor, Loc);
+  if (Type.isNull())
+    return TypeError();
+  return CreateParsedType(Type, Context.getTrivialTypeSourceInfo(Type, Loc));
+}
+
+ExprResult Sema::ActOnObjC3KeyPathLiteral(
+    ParsedType ParsedRoot, bool SelfRoot, ArrayRef<IdentifierInfo *> Members,
+    ArrayRef<SourceLocation> MemberLocs, SourceLocation Loc,
+    SourceLocation RParenLoc) {
+  QualType Root;
+  if (SelfRoot) {
+    ObjCMethodDecl *Method = getCurMethodDecl();
+    if (!Method || !Method->isInstanceMethod()) {
+      reject(*this, Loc, "@keypath(self, ...) requires an instance method");
+      return ExprError();
+    }
+    Root = Context.getObjCInterfaceType(Method->getClassInterface());
+  } else {
+    Root = GetTypeFromParser(ParsedRoot);
+  }
+  Root = normalizeRoot(*this, Root, Loc);
+  QualType Descriptor = importedType(*this, "objc3_keypath_descriptor_v2", Loc);
+  QualType ComponentType = importedType(*this, "objc3_keypath_component_v2", Loc);
+  if (Root.isNull() || Descriptor.isNull() || ComponentType.isNull())
+    return ExprError();
+
+  SmallVector<Component, 4> Components;
+  QualType Current = Root;
+  bool Writable = true;
+  bool HasFields = false;
+  bool NullableTraversal = false;
+  SourceLocation FirstNullableLoc;
+  auto NoteNullable = [&](QualType Value, unsigned Index) {
+    if (Index + 1 < Members.size() && nullable(Value)) {
+      NullableTraversal = true;
+      if (FirstNullableLoc.isInvalid())
+        FirstNullableLoc = MemberLocs[Index];
+    }
+  };
+  std::string Path;
+  for (unsigned I = 0; I != Members.size(); ++I) {
+    if (const auto *RecordType = Current->getAs<clang::RecordType>()) {
+      RecordDecl *Record = RecordType->getDecl()->getDefinition();
+      if (!Record ||
+          (!Record->getIdentifier() && !Record->getTypedefNameForAnonDecl()) ||
+          !Current.isTriviallyCopyableType(Context) ||
+          erasesOwnership(*this, Current) ||
+          (Record->isUnion() && unionHasManagedLeaves(Current))) {
+        reject(*this, MemberLocs[I],
+               "key-path record traversal requires a complete trivially "
+               "copyable record without borrowed/resource or managed-union ownership");
+        return ExprError();
+      }
+      FieldDecl *Field = nullptr;
+      if (auto *CXX = dyn_cast<CXXRecordDecl>(Record)) {
+        // Native lookup preserves hiding, inherited using declarations,
+        // ambiguous subobjects and effective base/member accessibility.
+        LookupResult Lookup(*this, Members[I], MemberLocs[I], LookupMemberName);
+        Lookup.suppressDiagnostics();
+        LookupQualifiedName(Lookup, CXX);
+        Field = Lookup.getAsSingle<FieldDecl>();
+        if (Field) {
+          // Use the object-aware check, including protected-object rules and
+          // its normal access diagnostic. The quiet type-member probe can
+          // reject an expression without emitting an error.
+          auto *Object = new (Context)
+              OpaqueValueExpr(MemberLocs[I], Current, VK_LValue);
+          if (CheckMemberOperatorAccess(MemberLocs[I], Object,
+                                        SourceRange(MemberLocs[I]),
+                                        Lookup.begin().getPair()) != AR_accessible)
+            return ExprError();
+        }
+      } else {
+        for (FieldDecl *Candidate : Record->fields())
+          if (Candidate->getIdentifier() == Members[I]) {
+            Field = Candidate;
+            break;
+          }
+      }
+      if (!Field) {
+        reject(*this, MemberLocs[I],
+               "key-path component must name an unambiguous visible record field");
+        return ExprError();
+      }
+      if (Field->getType()->isReferenceType()) {
+        reject(*this, MemberLocs[I],
+               "key-path record fields cannot be references");
+        return ExprError();
+      }
+      if (DiagnoseUseOfDecl(Field, MemberLocs[I]))
+        return ExprError();
+      QualType Value = normalizeValue(*this, Field->getType());
+      Component Part{nullptr, Field, Current, Value, MemberLocs[I]};
+      Components.push_back(Part);
+      Writable &= !readonly(Part);
+      HasFields = true;
+      Path += "." + Members[I]->getName().str();
+      NoteNullable(Value, I);
+      Current = Value;
+      continue;
+    }
+    const auto *Object = Current->getAs<ObjCObjectPointerType>();
+    ObjCInterfaceDecl *Interface = Object ? Object->getInterfaceDecl() : nullptr;
+    if (!Interface) {
+      reject(*this, MemberLocs[I],
+             "key-path intermediate component must have a concrete object "
+             "or supported record type");
+      return ExprError();
+    }
+    ObjCPropertyDecl *Property = Interface->FindPropertyDeclaration(
+        Members[I], ObjCPropertyQueryKind::OBJC_PR_query_instance);
+    if (!Property || DiagnoseUseOfDecl(Property, MemberLocs[I])) {
+      if (!Property)
+        reject(*this, MemberLocs[I], "key-path component must name a visible "
+                                    "declared instance property");
+      return ExprError();
+    }
+    if (!Property->getGetterMethodDecl()) {
+      reject(*this, MemberLocs[I],
+             "key-path property requires a declared getter");
+      return ExprError();
+    }
+    if (DiagnoseUseOfDecl(Property->getGetterMethodDecl(), MemberLocs[I]) ||
+        (!Property->isReadOnly() && Property->getSetterMethodDecl() &&
+         DiagnoseUseOfDecl(Property->getSetterMethodDecl(), MemberLocs[I])))
+      return ExprError();
+    auto Isolated = [](const Decl *Declaration) {
+      return isObjC3ActorIsolated(Declaration) ||
+             getObjC3Executor(Declaration) != nullptr;
+    };
+    if (Isolated(Property) || Isolated(Property->getGetterMethodDecl()) ||
+        Isolated(Property->getSetterMethodDecl())) {
+      reject(*this, MemberLocs[I],
+             "synchronous key paths cannot access actor-isolated or "
+             "executor-affine properties");
+      return ExprError();
+    }
+    auto ConsumesCaller = [](ObjCMethodDecl *Accessor) {
+      if (!Accessor)
+        return false;
+      if (Accessor->hasAttr<NSConsumesSelfAttr>() ||
+          Accessor->getMethodFamily() == OMF_init)
+        return true;
+      for (const ParmVarDecl *Parameter : Accessor->parameters())
+        if (Parameter->hasAttr<NSConsumedAttr>())
+          return true;
+      return false;
+    };
+    if (ConsumesCaller(Property->getGetterMethodDecl()) ||
+        ConsumesCaller(Property->getSetterMethodDecl())) {
+      reject(*this, MemberLocs[I],
+             "key paths cannot erase consuming accessor ownership");
+      return ExprError();
+    }
+    auto UnsupportedEffect = [](ObjCMethodDecl *Accessor) {
+      if (!Accessor)
+        return false;
+      auto Effects = Accessor->getObjC3FunctionEffects();
+      return Effects.Async || Effects.Throws != ObjC3ThrowsKind::None;
+    };
+    if (UnsupportedEffect(Property->getGetterMethodDecl()) ||
+        UnsupportedEffect(Property->getSetterMethodDecl())) {
+      reject(*this, MemberLocs[I],
+             "key-path accessors must be synchronous and nonthrowing");
+      return ExprError();
+    }
+    QualType Value = Property->getType().substObjCMemberType(
+        Current, Property->getDeclContext(), ObjCSubstitutionContext::Property);
+    if (erasesOwnership(*this, Value) ||
+        getObjC3BorrowedReturnContract(Property->getGetterMethodDecl()) ||
+        Property->getGetterMethodDecl()->hasAttr<ObjCReturnsInnerPointerAttr>()) {
+      reject(*this, MemberLocs[I],
+             "key paths cannot erase borrowed provenance or scalar "
+             "resource ownership");
+      return ExprError();
+    }
+    Value = normalizeValue(*this, Value);
+    Components.push_back({Property, nullptr, Current, Value, MemberLocs[I]});
+    Writable &= !Property->isReadOnly() && Property->getSetterMethodDecl();
+    if (!Path.empty())
+      Path += ".";
+    Path += Members[I]->getName().str();
+    NoteNullable(Value, I);
+    Current = Value;
+  }
+  if (NullableTraversal) {
+    if (!nullable(Current) || !Current->isObjCRetainableType()) {
+      reject(*this, FirstNullableLoc,
+             "nullable intermediate key-path traversal requires a final "
+             "nullable Objective-C object or Block value");
+      return ExprError();
+    }
+    // Settable nullable chains retain writability. Their setter follows native
+    // Objective-C nil messaging: a missing receiver short-circuits the update.
+  }
+  QualType Type = keyPathType(*this, Root, Current, Writable, Descriptor, Loc);
+  if (Type.isNull())
+    return ExprError();
+  FunctionDecl *Get = accessor(*this, Root, Current, Components, false, Loc,
+                               NullableTraversal);
+  FunctionDecl *Set = Writable
+      ? accessor(*this, Root, Current, Components, true, Loc, NullableTraversal) : nullptr;
+  if (!Get || (Writable && !Set))
+    return ExprError();
+
+  SmallVector<Expr *, 4> ComponentValues;
+  for (const auto &Part : Components) {
+    const bool ReadOnly = readonly(Part);
+    unsigned Flags = ReadOnly ? 1u : 0u;
+    Flags |= (Part.Value->getNullability() == NullabilityKind::Nullable ||
+              Part.Value->getNullability() == NullabilityKind::NullableResult)
+                 ? 2u : 0u;
+    Flags |= Part.Value->getNullability() == NullabilityKind::NonNull ? 64u : 0u;
+    Flags |= Part.Value->isObjCRetainableType() ? 256u : 0u;
+    if (Part.Property) {
+      auto Attributes = Part.Property->getPropertyAttributes();
+      Flags |= Attributes & ObjCPropertyAttribute::kind_weak ? 4u : 0u;
+      Flags |= Attributes & ObjCPropertyAttribute::kind_copy ? 8u : 0u;
+      Flags |= Attributes & (ObjCPropertyAttribute::kind_strong |
+                            ObjCPropertyAttribute::kind_retain) ? 16u : 0u;
+      Flags |= Part.Property->isAtomic() ? 32u : 0u;
+      Flags |= doesObjC3KeyPathGetterReturnRetained(
+                   Part.Property->getGetterMethodDecl()) ? 512u : 0u;
+    } else {
+      Flags |= 128u;
+      auto Lifetime = Part.Field->getType().getObjCLifetime();
+      Flags |= Lifetime == Qualifiers::OCL_Weak ? 4u : 0u;
+      Flags |= Lifetime == Qualifiers::OCL_Strong ? 16u : 0u;
+    }
+    const NamedDecl *Member = Part.Property
+        ? static_cast<NamedDecl *>(Part.Property)
+        : static_cast<NamedDecl *>(Part.Field);
+    std::string DeclaringOwner = Part.Property
+        ? declarationOwner(Part.Property)
+        : typeIdentity(Context, Context.getTypeDeclType(ElaboratedTypeKeyword::None, std::nullopt, Part.Field->getParent()));
+    std::string Getter = Part.Property
+        ? Part.Property->getGetterName().getAsString() : "";
+    std::string Setter = Part.Property && !ReadOnly
+        ? Part.Property->getSetterName().getAsString() : "";
+    Expr *Fields[] = {
+        text(*this, typeIdentity(Context, Part.Owner), Loc),
+        text(*this, DeclaringOwner, Loc),
+        text(*this, Member->getName(), Loc),
+        text(*this, typeIdentity(Context, Part.Value), Loc),
+        text(*this, Getter, Loc), text(*this, Setter, Loc),
+        integer(*this, 32, Flags, Loc), integer(*this, 32, 0, Loc)};
+    ComponentValues.push_back(aggregate(*this, ComponentType, Fields, Loc));
+  }
+  QualType Array = Context.getConstantArrayType(
+      ComponentType.withConst(), llvm::APInt(64, Components.size()), nullptr,
+      ArraySizeModifier::Normal, 0);
+  VarDecl *Parts = global(*this, "components", Array,
+      aggregate(*this, Array, ComponentValues, Loc), Loc);
+  Expr *DescriptorFields[] = {
+      integer(*this, 32, 2, Loc),
+      integer(*this, 32, (Writable ? 1u : 0u) | (HasFields ? 0u : 2u) |
+                            (NullableTraversal ? 4u : 0u) |
+                            (NullableTraversal && Writable ? 8u : 0u), Loc),
+      integer(*this, 64, Components.size(), Loc),
+      text(*this, typeIdentity(Context, Root), Loc),
+      text(*this, typeIdentity(Context, Current), Loc), text(*this, Path, Loc),
+      DefaultFunctionArrayLvalueConversion(reference(*this, Parts, Loc)).get()};
+  VarDecl *Metadata = global(*this, "descriptor", Descriptor.withConst(),
+      aggregate(*this, Descriptor, DescriptorFields, Loc), Loc);
+  ObjC3KeyPathInfo Info;
+  if (!getObjC3KeyPathInfo(Type, Info))
+    llvm_unreachable("constructed a malformed compiler key-path record");
+  ExprResult Address = BuildUnaryOp(nullptr, Loc, UO_AddrOf,
+                                     reference(*this, Metadata, Loc));
+  if (Address.isInvalid())
+    return ExprError();
+  Expr *ReadFields[] = {
+      Address.get(),
+      DefaultFunctionArrayLvalueConversion(reference(*this, Get, Loc)).get()};
+  QualType ReadType = Info.Read ? Info.Read->getType() : Type;
+  Expr *Initializer = aggregate(*this, ReadType, ReadFields, Loc);
+  if (Writable) {
+    Expr *WriteFields[] = {
+        Initializer,
+        DefaultFunctionArrayLvalueConversion(reference(*this, Set, Loc)).get()};
+    Initializer = aggregate(*this, Type, WriteFields, Loc);
+  }
+  return BuildCompoundLiteralExpr(Loc, Context.getTrivialTypeSourceInfo(Type, Loc),
+                                   RParenLoc, Initializer);
+}
+
+namespace {
+ExprResult buildKeyPathApplication(Sema &S, unsigned Kind, ArrayRef<Expr *> Args,
+    SourceLocation Loc, SourceLocation RParenLoc, bool AlreadyCaptured,
+    Expr **SetValue) {
+  ExprResult Checked = S.CheckPlaceholderExpr(Args[0]);
+  if (Checked.isInvalid())
+    return ExprError();
+  Expr *Path = Checked.get();
+  ObjC3KeyPathInfo Info;
+  if (!getObjC3KeyPathInfo(Path->getType(), Info)) {
+    reject(S, Loc, "key-path application requires a typed key-path value");
+    return ExprError();
+  }
+  if (Kind == 2 || Kind == 4) {
+    QualType Descriptor =
+        importedType(S, "objc3_keypath_descriptor_v2", Loc);
+    QualType Component =
+        importedType(S, "objc3_keypath_component_v2", Loc);
+    if (Descriptor.isNull() || Component.isNull())
+      return ExprError();
+  }
+  if (Kind == 1 && !Info.Set) {
+    reject(S, Loc, "KeyPathSet requires a WritableKeyPath value");
+    return ExprError();
+  }
+  if (Kind < 2) {
+    Expr *Root = Args[1];
+    const auto *Object = Root->getType()->getAs<ObjCObjectPointerType>();
+    if (!Object || !Object->getInterfaceDecl() ||
+        !S.Context.canAssignObjCInterfaces(
+            Info.Root->castAs<ObjCObjectPointerType>(), Object)) {
+      reject(S, Root->getExprLoc(),
+             "key-path application root has an incompatible class type");
+      return ExprError();
+    }
+    if (nullableOperand(S, Root)) {
+      reject(S, Root->getExprLoc(),
+             "key-path application requires a nonnull root");
+      return ExprError();
+    }
+    if (Kind == 1 && Info.Value->canHaveNullability()) {
+      Expr *Value = Args[2];
+      if (Info.Value->getNullability() == NullabilityKind::NonNull &&
+          nullableOperand(S, Value)) {
+        reject(S, Value->getExprLoc(),
+               "key-path setter requires a nonnull property value");
+        return ExprError();
+      }
+      const auto *ValueObject = Value->getType()->getAs<ObjCObjectPointerType>();
+      if (ValueObject && Info.Value->isObjCObjectPointerType() &&
+          !S.Context.canAssignObjCInterfaces(
+              Info.Value->castAs<ObjCObjectPointerType>(), ValueObject)) {
+        reject(S, Value->getExprLoc(),
+               "key-path setter value has an incompatible class type");
+        return ExprError();
+      }
+    }
+  }
+  SmallVector<Expr *, 4> Semantics;
+  SmallVector<Expr *, 3> Captured;
+  for (unsigned I = 0; I < Args.size(); ++I) {
+    if (AlreadyCaptured) {Captured.push_back(I ? Args[I] : Path);continue;}
+    ExprResult Value = captureApplicationOperand(S, I ? Args[I] : Path,
+                                                 Semantics);
+    if (Value.isInvalid())
+      return ExprError();
+    Captured.push_back(Value.get());
+  }
+  Path = Captured[0];
+  // Descriptor-only operations have one operand and one use. Defer its
+  // evaluation to that use; eager aggregate OVE storage would be materialized
+  // twice by the constant evaluator's member-access path.
+  if (Kind == 2 || Kind == 3 || Kind == 4)
+    cast<OpaqueValueExpr>(Path)->setIsUnique(true);
+  ExprResult Result;
+  if (Kind == 3) {
+    Result = Info.Read ? field(S, Path, Info.Read) : Path;
+  } else if (Kind == 2 || Kind == 4) {
+    if (Info.Read)Path = field(S, Path, Info.Read);
+    Result = field(S, Path, Info.Metadata);
+    if(Kind == 4) {
+      if(S.getLangOpts().ObjC3Profile)
+        S.Diag(Loc,S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+            DiagnosticIDs::Warning,"explicit KVC conversion loses typed key-path root/value safety; incompatible metadata returns nil"));
+      LookupResult Hook(S,&S.Context.Idents.get("objc3_keypath_kvc_string"),Loc,Sema::LookupOrdinaryName);
+      Hook.suppressDiagnostics();S.LookupQualifiedName(Hook,S.Context.getTranslationUnitDecl());
+      auto *Function=Hook.getAsSingle<FunctionDecl>();
+      if(!Function || Result.isInvalid()) {
+        reject(S,Loc,"KeyPathToKVCString requires the native key-path runtime header");return ExprError();
+      }
+      ExprResult Callee=S.BuildDeclRefExpr(Function,Function->getType(),VK_LValue,Loc);
+      if(Callee.isInvalid())return ExprError();
+      Expr *Argument=Result.get();
+      Result=S.BuildCallExpr(nullptr,Callee.get(),Loc,Argument,RParenLoc);
+    }
+  } else {
+    FieldDecl *Callable = Kind == 1 ? Info.Set : Info.Get;
+    if (Kind == 0 && Info.Read)
+      Path = field(S, Path, Info.Read);
+    Expr *Callee = field(S, Path, Callable);
+    SmallVector<Expr *, 2> CallArgs(Captured.begin() + 1, Captured.end());
+    Result = S.BuildCallExpr(nullptr, Callee, Loc, CallArgs, RParenLoc);
+    if (!Result.isInvalid() && Kind == 1 && SetValue) {
+      auto *Call = cast<CallExpr>(Result.get());
+      *SetValue = Call->getArg(1);
+      Captured[2] = *SetValue;
+    }
+  }
+  if (Result.isInvalid())
+    return ExprError();
+  return application(S, Kind, Args, Captured, Semantics, Result.get(),
+                     Loc, RParenLoc);
+}
+} // namespace
+ExprResult Sema::ActOnObjC3KeyPathApplication(unsigned Kind, ArrayRef<Expr *> Args,
+    SourceLocation Loc, SourceLocation RParenLoc) {
+  return buildKeyPathApplication(*this, Kind, Args, Loc, RParenLoc, false, nullptr);
+}
+ExprResult clang::captureObjC3KeyPathOperand(Sema &S, Expr *Source,
+    SmallVectorImpl<Expr *> &Semantics) {
+  return captureApplicationOperand(S, Source, Semantics);
+}
+ExprResult clang::buildObjC3CapturedKeyPathApplication(Sema &S, unsigned Kind,
+    ArrayRef<Expr *> Args, SourceLocation Loc, SourceLocation RParenLoc,
+    Expr **SetValue) {
+  return buildKeyPathApplication(S, Kind, Args, Loc, RParenLoc, true, SetValue);
+}
