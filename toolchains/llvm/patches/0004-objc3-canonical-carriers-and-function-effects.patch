+  FunctionDecl *Function = nullptr;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      if (FD->hasBody())
+        Function = FD;
+  ASSERT_TRUE(Function);
+  CFG::BuildOptions Options;
+  Options.AddImplicitDtors = Options.AddLifetime = Options.AddScopes = true;
+  Options.setAllAlwaysAdd();
+  auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                             &AST->getASTContext(), Options);
+  ASSERT_TRUE(Graph);
+  const CFGBlock *Failure = nullptr;
+  for (const auto *Block : *Graph)
+    if (isa_and_nonnull<ObjC3TryExpr>(Block->getTerminatorStmt()) &&
+        Block->succ_size() == 2)
+      Failure = (Block->succ_begin() + 1)->getReachableBlock();
+  ASSERT_TRUE(Failure);
+  llvm::SmallPtrSet<const CFGBlock *, 8> Visited;
+  SmallVector<const CFGBlock *, 8> Pending{Failure};
+  SmallVector<std::string, 2> Destroyed;
+  while (!Pending.empty()) {
+    const auto *Block = Pending.pop_back_val();
+    if (!Visited.insert(Block).second)
+      continue;
+    for (const auto &Element : *Block)
+      if (auto Dtor = Element.getAs<CFGAutomaticObjDtor>())
+        Destroyed.push_back(Dtor->getVarDecl()->getNameAsString());
+    for (const auto &Edge : Block->succs())
+      if (auto *Next = Edge.getReachableBlock())
+        Pending.push_back(Next);
+  }
+  EXPECT_EQ((SmallVector<std::string, 2>{"previous"}), Destroyed);
+}
