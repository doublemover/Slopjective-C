+    while (Pending.any()) {
+      int Index = Pending.find_first();
+      Pending.reset(Index);
+      if (Seen.test(Index)) continue;
+      Seen.set(Index);
+      Storage Target = location(Index);
+      Value Nested = storageTargets(Target, storageType(Target), State);
+      Targets |= Nested;
+      Pending |= Nested;
+      Pending.reset(Seen);
+    }
+    return Targets;
+  }
+  bool hasUnknownIndex(Storage Location) const {
+    unsigned Current = path(Location);
+    while (Current) {
+      if (Paths[Current].Index == -2)
+        return true;
+      Current = Paths[Current].Parent;
+    }
+    return false;
+  }
+  Value storedValue(Storage Resolved, QualType Type, const Facts &State) const {
+    Value Result = contents(Resolved, Type, State);
