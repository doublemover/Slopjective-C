+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+void close_handle(int);
+void close_address(int *);
+void valid(void) {
+  int first __attribute__((objc_resource(close=close_handle, invalid=-1))) = 7;
+  int second __attribute__((objc_resource(invalid=0, close=close_address))) = 8;
+}
+void missing_invalid(void) {
+  int value __attribute__((objc_resource(close=close_handle))) = 1; // expected-error {{requires both 'close=F' and 'invalid=X'}}
+}
+void missing_close(void) {
+  int value __attribute__((objc_resource(invalid=0))) = 1; // expected-error {{requires both 'close=F' and 'invalid=X'}}
+}
+void duplicate(void) {
+  int value __attribute__((objc_resource(close=close_handle, close=close_handle, invalid=0))) = 1; // expected-error {{unknown or duplicate objc_resource argument 'close'}}
+}
+void unknown(void) {
+  int value __attribute__((objc_resource(close=close_handle, sentinel=0))) = 1; // expected-error {{unknown or duplicate objc_resource argument 'sentinel'}}
+}
+void positional(void) {
+  int value __attribute__((objc_resource(close_handle, 0))) = 1; // expected-error {{expected '='}}
+}
+void trailing(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0,))) = 1; // expected-error {{expected objc_resource argument after ','}}
+}
