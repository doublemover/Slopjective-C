+    __objc3_optional(int &); // expected-error {{payload type 'int &' is not supported in an Objective-C 3 value carrier}}
+
+// Type formation does not imply a copy/move/destructor operation or call ABI.
+using NoncopyableResult = __objc3_result(MoveOnly, void);
