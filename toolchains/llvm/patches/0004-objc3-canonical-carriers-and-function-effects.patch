diff --git a/clang/include/clang/AST/ObjC3ResourceTypes.h b/clang/include/clang/AST/ObjC3ResourceTypes.h
new file mode 100644
index 000000000..41f1b70a9
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3ResourceTypes.h
@@ -0,0 +1,181 @@
+//===--- ObjC3ResourceTypes.h - Scalar resource typedef contracts -*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3RESOURCETYPES_H
+#define LLVM_CLANG_AST_OBJC3RESOURCETYPES_H
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+#include "llvm/ADT/DenseSet.h"
+
+namespace clang {
+inline const ObjCRetainableFamilyAttr *
+getObjC3RetainableFamily(const ASTContext &Context, QualType Type) {
+  while (!Type.isNull()) {
+    if (const auto *Alias = dyn_cast<TypedefType>(Type.getTypePtr()))
+      if (const auto *Family = Alias->getDecl()->getAttr<ObjCRetainableFamilyAttr>())
+        return Family;
+    QualType Next = Type.getSingleStepDesugaredType(Context);
+    if (Next == Type) break;
+    Type = Next;
+  }
+  return nullptr;
+}
+inline bool sameObjC3RetainableFamilyType(const ASTContext &LeftContext,
+                                         QualType Left,
+                                         const ASTContext &RightContext,
+                                         QualType Right) {
+  SmallVector<std::pair<QualType, QualType>, 16> Pending{{Left, Right}};
+  llvm::SmallDenseSet<std::pair<const Type *, const Type *>, 16> Seen;
+  while (!Pending.empty()) {
+    auto [L, R] = Pending.pop_back_val();
+    if (L.isNull() || R.isNull()) {
+      if (L.isNull() != R.isNull()) return false;
+      continue;
+    }
+    if (!Seen.insert({L.getTypePtr(), R.getTypePtr()}).second) continue;
+    const auto *A = getObjC3RetainableFamily(LeftContext, L);
+    const auto *B = getObjC3RetainableFamily(RightContext, R);
+    if (bool(A) != bool(B) || (A &&
+        (A->getFamily()->getName() != B->getFamily()->getName() ||
+         L->isObjCRetainableType() != R->isObjCRetainableType()))) return false;
+    L = L.getDesugaredType(LeftContext);
+    R = R.getDesugaredType(RightContext);
+    if ((L->isPointerType() && R->isPointerType()) ||
+        (L->isReferenceType() && R->isReferenceType()) ||
+        (L->isBlockPointerType() && R->isBlockPointerType()))
+      Pending.emplace_back(L->getPointeeType(), R->getPointeeType());
+    if (const auto *LF = L->getAs<FunctionType>()) {
+      if (const auto *RF = R->getAs<FunctionType>()) {
+        Pending.emplace_back(LF->getReturnType(), RF->getReturnType());
+        const auto *LP = dyn_cast<FunctionProtoType>(LF);
+        const auto *RP = dyn_cast<FunctionProtoType>(RF);
+        if (LP && RP && LP->getNumParams() == RP->getNumParams())
+          for (unsigned I = 0; I != LP->getNumParams(); ++I)
+            Pending.emplace_back(LP->getParamType(I), RP->getParamType(I));
+      }
+    }
+    if (const auto *LM = L->getAs<MemberPointerType>())
+      if (const auto *RM = R->getAs<MemberPointerType>())
+        Pending.emplace_back(LM->getPointeeType(), RM->getPointeeType());
+    if (const auto *LA = LeftContext.getAsArrayType(L))
+      if (const auto *RA = RightContext.getAsArrayType(R))
+        Pending.emplace_back(LA->getElementType(), RA->getElementType());
+  }
+  return true;
+}
+inline bool sameObjC3RetainableFamilyType(const ASTContext &Context,
+                                         QualType Left, QualType Right) {
+  return sameObjC3RetainableFamilyType(Context, Left, Context, Right);
+}
+inline const IdentifierInfo *getObjC3FamilyOperationName(const Attr *Attribute) {
+  if (const auto *A = dyn_cast<ObjCFamilyRetainAttr>(Attribute)) return A->getFamily();
+  if (const auto *A = dyn_cast<ObjCFamilyReleaseAttr>(Attribute)) return A->getFamily();
+  if (const auto *A = dyn_cast<ObjCFamilyAutoreleaseAttr>(Attribute)) return A->getFamily();
+  return nullptr;
+}
+inline const Attr *getObjC3FamilyOperation(const FunctionDecl *Function) {
+  if (Function)
+    for (const FunctionDecl *Redeclaration : Function->redecls())
+      for (const Attr *Attribute : Redeclaration->attrs())
+        if (getObjC3FamilyOperationName(Attribute)) return Attribute;
+  return nullptr;
+}
+
+struct ObjC3ResourceTypeContract {
+  const ObjCRequiresCleanupAttr *Cleanup = nullptr;
+  const ObjCResourceFamilyAttr *Family = nullptr;
+  const ObjCInvalidAttr *Invalid = nullptr;
+  const FunctionDecl *getCleanupFunction() const {
+    const auto *Reference =
+        Cleanup
+            ? dyn_cast<DeclRefExpr>(Cleanup->getClose()->IgnoreParenImpCasts())
+            : nullptr;
+    const auto *Function =
+        Reference ? dyn_cast<FunctionDecl>(Reference->getDecl()) : nullptr;
+    return Function ? Function->getCanonicalDecl() : nullptr;
+  }
+};
+
+inline ObjC3ResourceTypeContract
+getObjC3ResourceTypeContract(const ASTContext &Context, QualType Type) {
+  ObjC3ResourceTypeContract Result;
+  while (!Type.isNull()) {
+    if (const auto *Alias = dyn_cast<TypedefType>(Type.getTypePtr())) {
+      const TypedefNameDecl *Declaration = Alias->getDecl();
+      if (!Result.Cleanup)
+        Result.Cleanup = Declaration->getAttr<ObjCRequiresCleanupAttr>();
+      if (!Result.Family)
+        Result.Family = Declaration->getAttr<ObjCResourceFamilyAttr>();
+      if (!Result.Invalid)
+        Result.Invalid = Declaration->getAttr<ObjCInvalidAttr>();
+    }
+    QualType Next = Type.getSingleStepDesugaredType(Context);
+    if (Next == Type)
+      break;
+    Type = Next;
+  }
+  return Result;
+}
+
+inline bool isObjC3ResourceCleanupFunction(const FunctionDecl *Function) {
+  if (!Function)
+    return false;
+  for (const FunctionDecl *Redeclaration : Function->redecls())
+    for (const auto *Association :
+         Redeclaration->specific_attrs<ObjCResourceCloseForAttr>())
+      if (!Association->getResourceTypedef()->isInvalidDecl())
+        return true;
+  return false;
+}
+
+inline bool
+acceptsObjC3ResourceCleanup(const ASTContext &Context,
+                            const ObjC3ResourceTypeContract &Contract,
+                            const FunctionDecl *Function) {
+  if (!Function || !Contract.Cleanup)
+    return false;
+  if (Function->getCanonicalDecl() == Contract.getCleanupFunction())
+    return true;
+  if (!Contract.Family)
+    return false;
+  for (const FunctionDecl *Redeclaration : Function->redecls())
+    for (const auto *Association :
+         Redeclaration->specific_attrs<ObjCResourceCloseForAttr>()) {
+      const TypedefNameDecl *Alias = Association->getResourceTypedef();
+      if (Alias->isInvalidDecl())
+        continue;
+      auto Other = getObjC3ResourceTypeContract(
+          Context,
+          Context.getTypedefType(ElaboratedTypeKeyword::None, std::nullopt, Alias));
+      if (Other.Family &&
+          Other.Family->getFamily() == Contract.Family->getFamily())
+        return true;
+    }
+  return false;
+}
+
+inline bool sameObjC3ResourceConstant(const ASTContext &Context,
+                                      const Expr *Left,
+                                      const ASTContext &RightContext,
+                                      const Expr *Right) {
+  Expr::EvalResult A, B;
+  if (!Left || !Right || !Left->EvaluateAsRValue(A, Context) ||
+      !Right->EvaluateAsRValue(B, RightContext) || A.HasSideEffects ||
+      B.HasSideEffects)
+    return false;
+  if (A.Val.isInt() && B.Val.isInt())
+    return llvm::APSInt::isSameValue(A.Val.getInt(), B.Val.getInt());
+  if (A.Val.isLValue() && B.Val.isLValue())
+    return A.Val.getLValueBase() == B.Val.getLValueBase() &&
+           A.Val.getLValueOffset() == B.Val.getLValueOffset() &&
+           A.Val.isLValueOnePastTheEnd() == B.Val.isLValueOnePastTheEnd();
+  return false;
+}
+inline bool sameObjC3ResourceConstant(const ASTContext &Context,
+                                      const Expr *Left, const Expr *Right) {
+  return sameObjC3ResourceConstant(Context, Left, Context, Right);
+}
+} // namespace clang
+#endif
