@@ -0,0 +1,28 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -Wnullable-to-nonnull-conversion -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fblocks -Wnullable-to-nonnull-conversion -fsyntax-only -verify %s
+
+void require_nonnull(id _Nonnull object);
+void require_block(void (^ _Nonnull block)(void));
+
+void object_results(id _Nullable source, id _Nonnull fallback,
+                    id _Nullable nullable_fallback) {
+  require_nonnull(source ?? fallback);
+  require_nonnull(source ?? nullable_fallback); // expected-warning {{implicit conversion from nullable pointer}}
+  require_nonnull(source ?? (id)0); // expected-warning {{implicit conversion from nullable pointer}}
+  require_nonnull(source ?? @"nonnull literal");
+  require_nonnull(fallback ?? nullable_fallback);
+}
+
+void block_results(void (^ _Nullable source)(void),
+                   void (^ _Nonnull fallback)(void),
+                   void (^ _Nullable nullable_fallback)(void)) {
+  require_block(source ?? fallback);
+  require_block(source ?? nullable_fallback); // expected-warning {{implicit conversion from nullable pointer}}
+  require_block(source ?? ^{});
+}
+
+// Tagged presence does not prove an object payload nonnil. Some(nil) succeeds
+// without running the fallback, and its nullable payload remains nullable.
+void tagged_object(Optional(id _Nullable) source, id _Nonnull fallback) {
+  require_nonnull(source ?? fallback); // expected-warning {{implicit conversion from nullable pointer}}
+}
diff --git a/clang/test/ObjC3/Sema/optional-coalescing.m b/clang/test/ObjC3/Sema/optional-coalescing.m
new file mode 100644
index 000000000..c8761fb65
--- /dev/null
+++ b/clang/test/ObjC3/Sema/optional-coalescing.m
@@ -0,0 +1,40 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+
+typedef Optional(int) Maybe;
+struct Record { int value; };
+void rejects_scalar(int scalar, int *pointer) {
+  (void)(scalar ?? 1); // expected-error {{left operand of coalescing operator must be an Optional or Objective-C reference}}
+  (void)(pointer ?? pointer); // expected-error {{left operand of coalescing operator must be an Optional or Objective-C reference}}
+}
+
+void rejects_unrelated_fallback(Maybe source, struct Record record) {
+  (void)(source ?? record); // expected-error {{is not compatible with unwrapped type 'int'}}
+  (void)(source ?? None(long)); // expected-error {{fallback type}}
+  (void)(None(void) ?? 1); // expected-error {{a void payload cannot be unwrapped by coalescing operator}}
+}
+
+void rejects_nonreference_object_fallback(id object) {
+  (void)(object ?? 2); // expected-error {{fallback type 'int' is not compatible with unwrapped type 'id'}}
+}
+
+void recovery_preserves_following_statement(Maybe source) {
+  int rejected = source ?? ; // expected-error {{expected expression}}
+  int accepted = source ?? 42;
+  (void)accepted;
+}
+
+// Result flattening preserves one layer of Optional. A fallback matching the
+// full carrier returns that carrier; a fallback matching its payload unwraps.
+void precise_types(Maybe source, Optional(Maybe) nested) {
+#ifdef __cplusplus
+  static_assert(__is_same(decltype(source ?? 1L), long));
+  static_assert(__is_same(decltype(source ?? None(int)), Maybe));
+  static_assert(__is_same(decltype(nested ?? source), Maybe));
+#else
