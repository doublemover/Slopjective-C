+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_SEMA_SEMAOBJC3EFFECTS_H
+#define LLVM_CLANG_LIB_SEMA_SEMAOBJC3EFFECTS_H
+namespace clang {
+class Decl;
+class FunctionDecl;
+class Sema;
+class Stmt;
+/// Validate the explicit native-C frame-entry boundary. Function effects retain
+/// their logical result; only calls use the physical runtime frame carrier.
+bool checkObjC3CAsyncFrameDeclaration(Sema &S, FunctionDecl *Function,
+                                      bool IsDefinition = false);
+bool checkObjC3CAsyncBody(Sema &S, Decl *Callable, Stmt *Body);
+} // namespace clang
+#endif
diff --git a/clang/lib/Sema/SemaObjC3OptionalAccess.cpp b/clang/lib/Sema/SemaObjC3OptionalAccess.cpp
new file mode 100644
index 000000000..ef0b1bc0a
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3OptionalAccess.cpp
@@ -0,0 +1,156 @@
+//===--- SemaObjC3OptionalAccess.cpp - Reference-only optional access -----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/DeclSpec.h"
+#include "clang/Sema/ParsedTemplate.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Sema/SemaObjC.h"
+#include "llvm/ADT/APInt.h"
+
+using namespace clang;
+
+namespace {
+QualType nullableType(ASTContext &Context, QualType Type, bool Nonnull) {
+  (void)AttributedType::stripOuterNullability(Type);
+  return Context.getAttributedType(
+      Nonnull ? attr::TypeNonNull : attr::TypeNullable, Type, Type);
+}
+
+ExprResult prepareReceiver(Sema &S, Scope *Scope, Expr *&WrittenReceiver,
+                           SourceLocation Loc) {
+  // C++ disambiguation can leave a parenthesized operand as a ParenListExpr,
+  // which has no type. Normalize it just as ordinary postfix member access
+  // does, before checking placeholder types or retaining a written operand.
+  ExprResult Normalized =
+      S.MaybeConvertParenListExprToParenExpr(Scope, WrittenReceiver);
+  if (Normalized.isInvalid())
+    return ExprError();
+  WrittenReceiver = Normalized.get();
+  ExprResult Checked = S.CheckPlaceholderExpr(WrittenReceiver);
+  if (Checked.isInvalid())
+    return ExprError();
+  Expr *Receiver = Checked.get();
+  if (!Receiver->isTypeDependent() &&
+      !Receiver->getType()->isObjCObjectPointerType()) {
+    S.Diag(Loc, diag::err_objc3_optional_access_receiver)
+        << Receiver->getType() << Receiver->getSourceRange();
+    return ExprError();
+  }
+  return S.DefaultFunctionArrayLvalueConversion(Receiver);
+}
+
+OpaqueValueExpr *makeReceiver(Sema &S, Expr *Source, SourceLocation Loc) {
+  QualType Type = Source->getType();
+  if (!Source->isTypeDependent()) {
+    Type = nullableType(S.Context, Type, /*Nonnull=*/true);
+    if (S.getLangOpts().ObjCAutoRefCount) {
+      // Hold one loaded receiver across argument/getter evaluation. The
+      // ordinary ARC casts preserve its cleanup through PCH and replay.
+      Source = ImplicitCastExpr::Create(S.Context, Source->getType(),
+          CK_ARCProduceObject, Source, nullptr, VK_PRValue, FPOptionsOverride());
+      Source = ImplicitCastExpr::Create(S.Context, Source->getType(),
+          CK_ARCConsumeObject, Source, nullptr, VK_PRValue, FPOptionsOverride());
+      S.Cleanup.setExprNeedsCleanups(true);
+    }
+  }
+  return new (S.Context) OpaqueValueExpr(Loc, Type, VK_PRValue, OK_Ordinary,
+                                        Source);
+}
+} // namespace
+
+ExprResult Sema::BuildObjC3OptionalAccess(
+    Expr *WrittenReceiver, OpaqueValueExpr *Receiver, Expr *Access,
+    IdentifierInfo *Member, SourceLocation OperatorLoc, SourceLocation MemberLoc,
+    SourceLocation LBracketLoc, SourceLocation RBracketLoc) {
+  if (WrittenReceiver->isTypeDependent() || Access->isTypeDependent())
+    return ObjC3OptionalAccessExpr::Create(
+        Context, Context.DependentTy, WrittenReceiver, Access, nullptr, Member,
+        OperatorLoc, MemberLoc, LBracketLoc, RBracketLoc);
+  ExprResult Value = CheckPlaceholderExpr(Access);
+  if (Value.isInvalid())
+    return ExprError();
+  Access = Value.get();
+  QualType ResultType = Access->getType();
+  if (!ResultType->isObjCRetainableType() &&
+      !(Member == nullptr && ResultType->isVoidType())) {
+    Diag(OperatorLoc, diag::err_objc3_optional_access_result)
+        << (Member == nullptr) << ResultType << Access->getSourceRange();
+    return ExprError();
+  }
+
+  Expr *Source = Receiver->getSourceExpr();
+  Expr *Zero = IntegerLiteral::Create(
+      Context, llvm::APInt(Context.getIntWidth(Context.IntTy), 0), Context.IntTy,
+      OperatorLoc);
+  Expr *Absent = Zero;
+  if (ResultType->isVoidType())
+    Absent = ImplicitCastExpr::Create(Context, Context.VoidTy, CK_ToVoid, Zero,
+        nullptr, VK_PRValue, FPOptionsOverride());
+  Expr *SelectedAccess = Access;
+  if (ResultType->isObjCRetainableType()) {
+    QualType JoinedType = ResultType;
+    (void)AttributedType::stripOuterNullability(JoinedType);
+    SelectedAccess = ImplicitCastExpr::Create(
+        Context, JoinedType, CK_NoOp, Access, nullptr, Access->getValueKind(),
+        FPOptionsOverride());
+    Absent = ImplicitCastExpr::Create(Context, JoinedType, CK_NullToPointer,
+        Zero, nullptr, VK_PRValue, FPOptionsOverride());
+  }
+  ExprResult Joined = ActOnConditionalOp(OperatorLoc, OperatorLoc, Receiver,
+                                          SelectedAccess, Absent);
+  if (Joined.isInvalid())
+    return ExprError();
+  auto *Conditional = cast<ConditionalOperator>(Joined.get());
+  ResultType = Conditional->getType();
+  if (!ResultType->isVoidType())
+    ResultType = nullableType(Context, ResultType, /*Nonnull=*/false);
+  auto *Semantic = new (Context) BinaryConditionalOperator(
+      Source, Receiver, Conditional->getCond(), Conditional->getTrueExpr(),
+      Conditional->getFalseExpr(), OperatorLoc, OperatorLoc, ResultType,
+      VK_PRValue, OK_Ordinary);
+  return ObjC3OptionalAccessExpr::Create(
+      Context, ResultType, WrittenReceiver, Access, Semantic, Member, OperatorLoc,
+      MemberLoc, LBracketLoc, RBracketLoc);
+}
+
+ExprResult Sema::ActOnObjC3OptionalMemberExpr(
+    Scope *Scope, Expr *Base, SourceLocation OperatorLoc, IdentifierInfo *Member,
+    SourceLocation MemberLoc, Decl *ObjCImplementation) {
+  ExprResult Source = prepareReceiver(*this, Scope, Base, OperatorLoc);
+  if (Source.isInvalid())
+    return ExprError();
+  auto *Receiver = makeReceiver(*this, Source.get(), OperatorLoc);
+  CXXScopeSpec SS;
+  UnqualifiedId Name;
+  Name.setIdentifier(Member, MemberLoc);
+  ExprResult Access = ActOnMemberAccessExpr(
+      Scope, Receiver, OperatorLoc, tok::period, SS, SourceLocation(), Name,
+      ObjCImplementation);
+  if (Access.isInvalid())
+    return ExprError();
+  return BuildObjC3OptionalAccess(Base, Receiver, Access.get(), Member,
+                                  OperatorLoc, MemberLoc, SourceLocation(),
+                                  SourceLocation());
+}
+
+ExprResult Sema::ActOnObjC3OptionalMessageExpr(
+    Scope *Scope, Expr *Base, Selector Sel, SourceLocation LBracketLoc,
+    ArrayRef<SourceLocation> SelectorLocs, SourceLocation RBracketLoc,
+    MultiExprArg Args, SourceLocation OperatorLoc) {
+  ExprResult Source = prepareReceiver(*this, Scope, Base, OperatorLoc);
+  if (Source.isInvalid())
+    return ExprError();
+  auto *Receiver = makeReceiver(*this, Source.get(), OperatorLoc);
+  ExprResult Access = ObjC().ActOnInstanceMessage(
+      Scope, Receiver, Sel, LBracketLoc, SelectorLocs, RBracketLoc, Args);
+  if (Access.isInvalid())
+    return ExprError();
+  return BuildObjC3OptionalAccess(Base, Receiver, Access.get(), nullptr,
+                                  OperatorLoc, SourceLocation(), LBracketLoc,
+                                  RBracketLoc);
+}
diff --git a/clang/lib/Sema/SemaObjC3ResourceFlow.cpp b/clang/lib/Sema/SemaObjC3ResourceFlow.cpp
new file mode 100644
index 000000000..e7cbb2abd
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3ResourceFlow.cpp
@@ -0,0 +1,974 @@
+//===--- SemaObjC3ResourceFlow.cpp - Scalar resource ownership flow
+//--------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "SemaObjC3Resources.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ObjC3ResourceTypes.h"
+#include "clang/AST/ObjC3SourceScopes.h"
+#include "clang/Analysis/CFG.h"
+#include "clang/Basic/ExceptionSpecificationType.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include <memory>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+/// A may analysis over the native graph, including registered cleanup actions
+/// and their exception edges. Empty, moved and discarded all contain the
+/// sentinel at runtime, but retaining their provenance explains unsafe uses.
+class ResourceFlow {
+  enum : unsigned char {
+    Live = 1,
+    Empty = 2,
+    Moved = 4,
+    Discarded = 8,
+    Closed = 16,
+    Sentinel = Empty | Moved | Discarded,
+    Fresh = Live | Empty
+  };
+  using Facts = SmallVector<unsigned char, 16>;
+  Sema &Actions;
+  ASTContext &Context;
+  llvm::DenseMap<const VarDecl *, unsigned> Variables;
+  llvm::DenseMap<const VarDecl *, ObjC3ResourceTypeContract> Contracts;
+  llvm::SmallPtrSet<const VarDecl *, 16> OwnershipDiagnosed, LeakDiagnosed;
+  llvm::SmallPtrSet<const Expr *, 16> CloseAddresses;
+  llvm::SmallPtrSet<const VarDecl *, 8> CapturedOwners;
+  QualType ReturnType;
+  std::unique_ptr<ObjC3SourceScopes> ReturnScopes;
+  llvm::DenseMap<const ObjC3ResourceExpr *, unsigned> TakenValues;
+  llvm::SmallPtrSet<const DeclRefExpr *, 32> Observations;
+  llvm::SmallPtrSet<const ObjC3ResourceExpr *, 16> DroppedTakes;
+  llvm::SmallPtrSet<const Stmt *, 32> Diagnosed;
+  bool Invalid = false;
+
+  const VarDecl *variable(const Expr *Value) const {
+    if (!Value)
+      return nullptr;
+    Value = Value->IgnoreParenCasts();
+    const auto *Reference = dyn_cast<DeclRefExpr>(Value);
+    const auto *Variable =
+        Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+    return Variables.count(Variable) ? Variable : nullptr;
+  }
+
+  void diagnose(const Stmt *Node, const VarDecl *Variable, StringRef Message) {
+    if (!Diagnosed.insert(Node).second)
+      return;
+    Actions.Diag(Node->getBeginLoc(),
+                 Actions.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                     DiagnosticIDs::Error, Message))
+        << Variable;
+    OwnershipDiagnosed.insert(Variable);
+    Invalid = true;
+  }
+
+  const FunctionDecl *registeredCleanup(const VarDecl *Variable) const {
+    if (const auto *Resource = Variable->getAttr<ObjCResourceAttr>())
+      return cast<CallExpr>(Resource->getCall())->getDirectCallee();
+    if (const auto *Cleanup = Variable->getAttr<ObjCCleanupAttr>())
+      return cast<CallExpr>(Cleanup->getCall())->getDirectCallee();
+    return nullptr;
+  }
+  const Expr *invalidSentinel(const VarDecl *Variable) const {
+    if (const auto *Resource = Variable->getAttr<ObjCResourceAttr>())
+      return Resource->getInvalid();
+    auto Contract = Contracts.lookup(Variable);
+    return Contract.Invalid ? Contract.Invalid->getInvalid() : nullptr;
+  }
+  const VarDecl *argumentVariable(const Expr *Argument) const {
+    Argument = Argument->IgnoreParenImpCasts();
+    if (const auto *Address = dyn_cast<UnaryOperator>(Argument))
+      if (Address->getOpcode() == UO_AddrOf)
+        Argument = Address->getSubExpr();
+    return variable(Argument);
+  }
+  bool acceptsCleanup(const VarDecl *Variable,
+                      const FunctionDecl *Function) const {
+    if (!Function)
+      return false;
+    auto Contract = Contracts.lookup(Variable);
+    if (Contract.Cleanup)
+      return acceptsObjC3ResourceCleanup(Context, Contract, Function);
+    const FunctionDecl *Registered = registeredCleanup(Variable);
+    return Registered &&
+           Registered->getCanonicalDecl() == Function->getCanonicalDecl();
+  }
+  bool compatibleTypes(const ObjC3ResourceTypeContract &A,
+                       const ObjC3ResourceTypeContract &B) const {
+    if (!A.Cleanup || !B.Cleanup)
+      return false;
+    if (A.Family || B.Family)
+      return A.Family && B.Family &&
+             A.Family->getFamily() == B.Family->getFamily();
+    return A.getCleanupFunction() == B.getCleanupFunction();
+  }
+  void checkLeak(const VarDecl *Variable, const Facts &Values) {
+    if (CapturedOwners.contains(Variable) || !(state(Variable, Values) & Live) ||
+        !Contracts.lookup(Variable).Cleanup ||
+        OwnershipDiagnosed.contains(Variable) ||
+        !LeakDiagnosed.insert(Variable).second)
+      return;
+    Actions.Diag(Variable->getLocation(),
+                 Actions.getDiagnostics().getCustomDiagID(
+                     DiagnosticsEngine::Error,
+                     "resource %0 may leave its scope without cleanup; close "
+                     "it on every path, return its owned type, or register "
+                     "@resource/@cleanup"))
+        << Variable;
+    Invalid = true;
+  }
+
+  bool noThrow(const FunctionDecl *Function) const {
+    if (!Function)
+      return false;
+    if (Function->hasAttr<NoThrowAttr>())
+      return true;
+    const auto *Prototype = Function->getType()->getAs<FunctionProtoType>();
+    return Prototype &&
+           !isUnresolvedExceptionSpec(Prototype->getExceptionSpecType()) &&
+           Prototype->isNothrow();
+  }
+  bool contains(const Stmt *Owner, const Stmt *Node) const {
+    if (!Owner)
+      return false;
+    if (Owner == Node)
+      return true;
+    if (isa<BlockExpr, LambdaExpr>(Owner))
+      return false;
+    for (const Stmt *Child : Owner->children())
+      if (contains(Child, Node))
+        return true;
+    return false;
+  }
+  bool refersTo(const Stmt *Node, const VarDecl *Variable) const {
+    if (!Node || !Variable)
+      return false;
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Node))
+      if (Reference->getDecl() == Variable)
+        return true;
+    for (const Stmt *Child : Node->children())
+      if (refersTo(Child, Variable))
+        return true;
+    return false;
+  }
+  bool throwingDestructor(QualType Type) const {
+    Type = Context.getBaseElementType(Type);
+    if (const auto *Record = Type->getAsCXXRecordDecl())
+      if (Record->hasDefinition() && !Record->hasTrivialDestructor())
+        return !noThrow(Record->getDestructor());
+    return false;
+  }
+  bool throwingBody(const Stmt *Node) const {
+    if (!Node)
+      return false;
+    if (isa<CXXThrowExpr, ObjCAtThrowStmt, ObjCMessageExpr, ObjC3ThrowStmt,
+            ObjC3TryExpr>(Node))
+      return true;
+    if (const auto *Operation = dyn_cast<ObjC3ResourceExpr>(Node))
+      if (Operation->getKind() != ObjC3ResourceExpr::Kind::Take &&
+          !noThrow(registeredCleanup(Operation->getResourceVariable())))
+        return true;
+    if (const auto *Call = dyn_cast<CallExpr>(Node))
+      if (!noThrow(Call->getDirectCallee()))
+        return true;
+    if (const auto *Construct = dyn_cast<CXXConstructExpr>(Node))
+      if (!noThrow(Construct->getConstructor()))
+        return true;
+    if (const auto *Declarations = dyn_cast<DeclStmt>(Node))
+      for (const Decl *D : Declarations->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(D))
+          if (throwingDestructor(Variable->getType()))
+            return true;
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const Expr *Initializer : Lambda->capture_inits())
+        if (throwingBody(Initializer))
+          return true;
+      return false;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        const Expr *Initializer = Capture.getObjC3InitExpr()
+                                      ? Capture.getObjC3InitExpr() : Capture.getCopyExpr();
+        if (Initializer && throwingBody(Initializer)) return true;
+        if (Capture.getCaptureType()->isBlockPointerType()) return true;
+      }
+      return false;
+    }
+    for (const Stmt *Child : Node->children())
+      if (throwingBody(Child))
+        return true;
+    return false;
+  }
+  bool hasThrowingReturnCleanup(const ReturnStmt *Return) const {
+    if (!ReturnScopes)
+      return false;
+    auto Precedes = [&](SourceLocation Registration) {
+      return Actions.getSourceManager().isBeforeInTranslationUnit(
+          Registration, Return->getReturnLoc());
+    };
+    const auto *Transfer = dyn_cast_or_null<ObjC3ResourceExpr>(
+        Return->getRetValue() ? Return->getRetValue()->IgnoreParenCasts()
+                              : nullptr);
+    const VarDecl *Disarmed =
+        Transfer && Transfer->getKind() == ObjC3ResourceExpr::Kind::Take
+            ? Transfer->getResourceVariable()
+            : nullptr;
+    // A direct take invalidates the source before return cleanup. Keep the
+    // conservative boundary when a later registered body can rearm that slot.
+    for (auto [Deferred, Owner] : ReturnScopes->Defers)
+      if (contains(Owner, Return) && Precedes(Deferred->getBeginLoc()) &&
+          refersTo(Deferred->getBody(), Disarmed))
+        Disarmed = nullptr;
+    for (auto [Deferred, Owner] : ReturnScopes->Defers)
+      if (contains(Owner, Return) && Precedes(Deferred->getBeginLoc()) &&
+          throwingBody(Deferred->getBody()))
+        return true;
+    for (auto [Variable, Owner] : ReturnScopes->Variables)
+      if (contains(Owner, Return) && Precedes(Variable->getLocation())) {
+        const FunctionDecl *Cleanup =
+            Variable == Disarmed ? nullptr : registeredCleanup(Variable);
+        if ((Cleanup && !noThrow(Cleanup)) ||
+            throwingDestructor(Variable->getType()))
+          return true;
+        if (Actions.getLangOpts().ObjCAutoRefCount &&
+            Variable->getType().isDestructedType() != QualType::DK_none &&
+            !Cleanup)
+          return true; // Managed release queues have no owned-return EH model
+                       // yet.
+      }
+    return false;
+  }
+
+  void observe(const Expr *Value) {
+    if (!Value)
+      return;
+    if (const auto *Reference =
+            dyn_cast<DeclRefExpr>(Value->IgnoreParenImpCasts()))
+      Observations.insert(Reference);
+  }
+
+  // Only compare constants after conversion to the handle type. In particular,
+  // truncating a wider comparison constant here could invent a sentinel test.
+  std::optional<bool> isSentinel(const Expr *Value,
+                                 const VarDecl *Variable) const {
+    if (!Value || Value->isValueDependent() ||
+        !Context.hasSameUnqualifiedType(Value->getType(), Variable->getType()))
+      return std::nullopt;
+    Expr::EvalResult Candidate, Invalid;
+    const Expr *Sentinel = invalidSentinel(Variable);
+    if (!Sentinel)
+      return std::nullopt;
+    if (!Value->EvaluateAsRValue(Candidate, Context) ||
+        Candidate.HasSideEffects ||
+        !Sentinel->EvaluateAsRValue(Invalid, Context))
+      return std::nullopt;
+    if (Candidate.Val.isInt() && Invalid.Val.isInt())
+      return llvm::APSInt::isSameValue(Candidate.Val.getInt(),
+                                       Invalid.Val.getInt());
+    if (Candidate.Val.isLValue() && Invalid.Val.isLValue())
+      return Candidate.Val.getLValueBase() == Invalid.Val.getLValueBase() &&
+             Candidate.Val.getLValueOffset() == Invalid.Val.getLValueOffset() &&
+             Candidate.Val.isLValueOnePastTheEnd() ==
+                 Invalid.Val.isLValueOnePastTheEnd();
+    return std::nullopt;
+  }
+
+  bool zeroSentinel(const VarDecl *Variable) const {
+    Expr::EvalResult Result;
+    const Expr *Sentinel = invalidSentinel(Variable);
+    if (!Sentinel || !Sentinel->EvaluateAsRValue(Result, Context))
+      return false;
+    return (Result.Val.isInt() && Result.Val.getInt().isZero()) ||
+           (Result.Val.isLValue() && Result.Val.isNullPointer());
+  }
+
+  void observeCondition(const Expr *Condition) {
+    if (!Condition)
+      return;
+    Condition = Condition->IgnoreParenImpCasts();
+    if (const VarDecl *Variable = variable(Condition)) {
+      if (zeroSentinel(Variable))
+        observe(Condition);
+      return;
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Condition)) {
+      if (Unary->getOpcode() == UO_LNot)
+        observeCondition(Unary->getSubExpr());
+    } else if (const auto *Binary = dyn_cast<BinaryOperator>(Condition)) {
+      if (Binary->isLogicalOp()) {
+        observeCondition(Binary->getLHS());
+        observeCondition(Binary->getRHS());
+      }
+    }
+  }
+
+  void collect(const Stmt *Node, bool Unused = false) {
+    if (!Node)
+      return;
+    if (const auto *Declaration = dyn_cast<DeclStmt>(Node))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(D)) {
+          auto Contract =
+              getObjC3ResourceTypeContract(Context, Variable->getType());
+          if (!Contract.Cleanup && Variable->getInit()) {
+            auto Source = getObjC3ResourceTypeContract(
+                Context, Variable->getInit()->IgnoreParenCasts()->getType());
+            if (Source.Cleanup) {
+              if (Variable->hasAttr<ObjCResourceAttr>() ||
+                  Variable->hasAttr<ObjCCleanupAttr>())
+                Contract = Source;
+              else
+                diagnose(Node, Variable,
+                         "initializing untracked resource %0 erases its "
+                         "cleanup contract; use the acquired value's typedef "
+                         "or register explicit cleanup");
+            }
+          }
+          if (!Variable->isInvalidDecl() && Variable->hasLocalStorage() &&
+              !Variable->getType()->isReferenceType() &&
+              (Variable->hasAttr<ObjCResourceAttr>() || Contract.Cleanup)) {
+            Variables.try_emplace(Variable, Variables.size());
+            Contracts[Variable] = Contract;
+          }
+          collect(Variable->getInit());
+          if (Variable->getType()->isReferenceType())
+            if (const VarDecl *Source = variable(Variable->getInit()))
+              diagnose(Node, Source,
+                       "strict-system cannot track an alias to resource %0; "
+                       "use resource operations on its declaring variable");
+        }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const LambdaCapture &Capture : Lambda->captures()) {
+        const auto *Variable = Capture.capturesVariable()
+                                   ? dyn_cast<VarDecl>(Capture.getCapturedVar())
+                                   : nullptr;
+        if (Variable && Variables.count(Variable))
+          diagnose(Node, Variable,
+                   "strict-system resource %0 requires ownership-aware "
+                   "capture support; keep it in its declaring callable");
+      }
+      for (const Expr *Initializer : Lambda->capture_inits())
+        collect(Initializer);
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      if (Block->getBlockDecl()->isInvalidDecl()) { Invalid = true; return; }
+      for (const BlockDecl::Capture &Capture :
+           Block->getBlockDecl()->captures())
+        if (Variables.count(Capture.getVariable()) && !Capture.isObjC3ResourceCapture())
+          diagnose(Node, Capture.getVariable(),
+                   "strict-system resource %0 requires ownership-aware "
+                   "capture support; keep it in its declaring callable");
+      return;
+    }
+    if (const auto *Operation = dyn_cast<ObjC3ResourceExpr>(Node)) {
+      observe(Operation->getOperand());
+      if (Operation->getKind() == ObjC3ResourceExpr::Kind::Take) {
+        TakenValues.try_emplace(Operation, 0);
+        if (Unused)
+          DroppedTakes.insert(Operation);
+      }
+    }
+    if (const auto *Return = dyn_cast<ReturnStmt>(Node))
+      if (const Expr *Result = Return->getRetValue()) {
+        const VarDecl *SourceVariable = variable(Result);
+        auto Source = SourceVariable
+                          ? Contracts.lookup(SourceVariable)
+                          : getObjC3ResourceTypeContract(
+                                Context, Result->IgnoreParenCasts()->getType());
+        auto Destination = getObjC3ResourceTypeContract(Context, ReturnType);
+        if (Source.Cleanup && !compatibleTypes(Source, Destination)) {
+          if (SourceVariable)
+            diagnose(Return, SourceVariable,
+                     "returning resource %0 erases or changes its cleanup "
+                     "family; return the compatible owned typedef");
+          else if (Diagnosed.insert(Return).second) {
+            Actions.Diag(Return->getReturnLoc(),
+                         Actions.getDiagnostics().getCustomDiagID(
+                             DiagnosticsEngine::Error,
+                             "returning an acquired resource erases or changes "
+                             "its cleanup family; return its owned typedef"));
+            Invalid = true;
+          }
+        }
+        if (Destination.Cleanup && hasThrowingReturnCleanup(Return) &&
+            !(Destination.Invalid &&
+              sameObjC3ResourceConstant(Context, Result,
+                                        Destination.Invalid->getInvalid())) &&
+            Diagnosed.insert(Return).second) {
+          Actions.Diag(Return->getReturnLoc(),
+                       Actions.getDiagnostics().getCustomDiagID(
+                           DiagnosticsEngine::Error,
+                           "owned resource return has no rollback model for "
+                           "throwing scope cleanup; finish throwing actions "
+                           "before transfer or use nonthrowing cleanup"));
+          if (SourceVariable)
+            OwnershipDiagnosed.insert(SourceVariable);
+          Invalid = true;
+        }
+      }
+    if (const auto *Call = dyn_cast<CallExpr>(Node)) {
+      const FunctionDecl *Function = Call->getDirectCallee();
+      if (Unused &&
+          getObjC3ResourceTypeContract(Context, Call->getType()).Cleanup) {
+        Actions.Diag(
+            Call->getExprLoc(),
+            Actions.getDiagnostics().getCustomDiagID(
+                DiagnosticsEngine::Error,
+                "discarding a value with requires_cleanup loses ownership; "
+                "bind it to a resource or call its cleanup"));
+        Invalid = true;
+      }
+      if (isObjC3ResourceCleanupFunction(Function))
+        for (const Expr *Argument : Call->arguments())
+          if (!argumentVariable(Argument)) {
+            auto Contract = getObjC3ResourceTypeContract(
+                Context, Argument->IgnoreParenCasts()->getType());
+            if (Contract.Cleanup &&
+                !acceptsObjC3ResourceCleanup(Context, Contract, Function) &&
+                Diagnosed.insert(Call).second) {
+              Actions.Diag(
+                  Call->getExprLoc(),
+                  Actions.getDiagnostics().getCustomDiagID(
+                      DiagnosticsEngine::Error,
+                      "cleanup function is not associated with the acquired "
+                      "resource's family; use its declared cleanup"));
+              Invalid = true;
+            }
+          }
+      for (const Expr *Argument : Call->arguments())
+        if (const VarDecl *Variable = argumentVariable(Argument))
+          if (acceptsCleanup(Variable, Function) ||
+              isObjC3ResourceCleanupFunction(Function)) {
+            const Expr *Operand = Argument->IgnoreParenImpCasts();
+            if (const auto *Address = dyn_cast<UnaryOperator>(Operand)) {
+              if (Address->getOpcode() == UO_AddrOf) {
+                CloseAddresses.insert(Address);
+                Operand = Address->getSubExpr();
+              }
+            }
+            observe(Operand);
+          }
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Node))
+      if (Unary->getOpcode() == UO_AddrOf && !CloseAddresses.contains(Unary))
+        if (const VarDecl *Variable = variable(Unary->getSubExpr()))
+          diagnose(Node, Variable,
+                   "strict-system cannot track escaped storage of resource "
+                   "%0; use resource operations on its declaring variable");
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Node))
+      if (Binary->isComparisonOp()) {
+        // Observing a moved-from sentinel is defined, even when the comparison
+        // does not establish a validity proof for a later operation.
+        observe(Binary->getLHS());
+        observe(Binary->getRHS());
+      }
+    if (const auto *If = dyn_cast<IfStmt>(Node))
+      observeCondition(If->getCond());
+    if (const auto *While = dyn_cast<WhileStmt>(Node))
+      observeCondition(While->getCond());
+    if (const auto *Do = dyn_cast<DoStmt>(Node))
+      observeCondition(Do->getCond());
+    if (const auto *For = dyn_cast<ForStmt>(Node))
+      observeCondition(For->getCond());
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Node))
+      observeCondition(Conditional->getCond());
+    for (const Stmt *Child : Node->children()) {
+      bool ChildUnused =
+          isa<CompoundStmt>(Node) && isa_and_nonnull<Expr>(Child);
+      if (isa<ParenExpr, ExprWithCleanups>(Node))
+        ChildUnused = Unused;
+      if (const auto *Cast = dyn_cast<ExplicitCastExpr>(Node))
+        ChildUnused = Cast->getType()->isVoidType() || Unused;
+      if (const auto *Binary = dyn_cast<BinaryOperator>(Node))
+        if (Binary->getOpcode() == BO_Comma)
+          ChildUnused = Child == Binary->getLHS() || Unused;
+      if (const auto *For = dyn_cast<ForStmt>(Node))
+        ChildUnused |= Child == For->getInit() || Child == For->getInc();
+      collect(Child, ChildUnused);
+    }
+  }
+
+  unsigned char state(const VarDecl *Variable, const Facts &Values) const {
+    auto Found = Variables.find(Variable);
+    return Found == Variables.end() ? Fresh : Values[Found->second];
+  }
+  void assign(const VarDecl *Variable, unsigned char Value,
+              Facts &Values) const {
+    auto Found = Variables.find(Variable);
+    if (Found != Variables.end())
+      Values[Found->second] = Value;
+  }
+  unsigned char value(const Expr *Expression, const VarDecl *Target,
+                      const Facts &Values) const {
+    if (!Expression)
+      return Empty;
+    if (auto Match = isSentinel(Expression, Target))
+      return *Match ? Empty : Live;
+    Expression = Expression->IgnoreParenImpCasts();
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Expression))
+      return value(Full->getSubExpr(), Target, Values);
+    if (const auto *Operation = dyn_cast<ObjC3ResourceExpr>(Expression)) {
+      auto Found = TakenValues.find(Operation);
+      if (Found != TakenValues.end()) {
+        unsigned char Result = Values[Found->second];
+        return (Result & Live) | ((Result & Sentinel) ? Empty : 0);
+      }
+    }
+    if (const VarDecl *Source = variable(Expression)) {
+      unsigned char Result = state(Source, Values);
+      return (Result & Live) | ((Result & Sentinel) ? Empty : 0);
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Expression))
+      if (Binary->getOpcode() == BO_Comma || Binary->getOpcode() == BO_Assign)
+        return value(Binary->getRHS(), Target, Values);
+    if (const auto *Conditional = dyn_cast<ConditionalOperator>(Expression))
+      return value(Conditional->getTrueExpr(), Target, Values) |
+             value(Conditional->getFalseExpr(), Target, Values);
+    return Fresh;
+  }
+
+  void checkRead(const Stmt *Node, const VarDecl *Variable, const Facts &Values,
+                 bool Diagnose) {
+    if (Diagnose && (state(Variable, Values) & (Moved | Discarded | Closed)))
+      diagnose(Node, Variable,
+               "resource %0 may have been moved or discarded; test its "
+               "invalid sentinel or reinitialize it before using it as valid");
+  }
+
+  void transfer(const CFGBlock &Block, Facts &Values, bool Diagnose) {
+    for (const CFGElement &Element : Block) {
+      if (auto Move = Element.getAs<CFGObjC3BlockCaptureMove>()) {
+        const VarDecl *Source = Move->getVarDecl();
+        if (Variables.count(Source)) {
+          checkRead(Move->getTriggerStmt(), Source, Values, Diagnose);
+          assign(Source, Moved, Values);
+        }
+        continue;
+      }
+      if (auto End = Element.getAs<CFGLifetimeEnds>()) {
+        const VarDecl *Variable = End->getVarDecl();
+        if (Variables.count(Variable)) {
+          if (Diagnose)
+            checkLeak(Variable, Values);
+          assign(Variable, Empty, Values);
+        }
+        continue;
+      }
+      if (auto Cleanup = Element.getAs<CFGCleanupFunction>()) {
+        if (Variables.count(Cleanup->getVarDecl()))
+          assign(Cleanup->getVarDecl(), Closed, Values);
+        continue;
+      }
+      if (auto Resource = Element.getAs<CFGObjC3ResourceAction>()) {
+        if (Element.getKind() == CFGElement::ObjC3ResourceClose)
+          assign(Resource->getVarDecl(), Closed, Values);
+        if (Element.getKind() == CFGElement::ObjC3ResourceInvalidate) {
+          const auto *Operation =
+              dyn_cast<ObjC3ResourceExpr>(Resource->getTriggerStmt());
+          assign(Resource->getVarDecl(),
+                 Operation &&
+                         Operation->getKind() == ObjC3ResourceExpr::Kind::Take
+                     ? Moved
+                     : Discarded,
+                 Values);
+        }
+        continue;
+      }
+      auto Statement = Element.getAs<CFGStmt>();
+      if (!Statement)
+        continue;
+      const Stmt *Node = Statement->getStmt();
+      if (const auto *Cast = dyn_cast<ImplicitCastExpr>(Node))
+        if (Cast->getCastKind() == CK_LValueToRValue)
+          if (const auto *Reference =
+                  dyn_cast<DeclRefExpr>(Cast->getSubExpr()->IgnoreParens()))
+            if (!Observations.contains(Reference))
+              if (const VarDecl *Variable = variable(Reference))
+                checkRead(Cast, Variable, Values, Diagnose);
+      if (const auto *Operation = dyn_cast<ObjC3ResourceExpr>(Node)) {
+        const VarDecl *Variable = Operation->getResourceVariable();
+        switch (Operation->getKind()) {
+        case ObjC3ResourceExpr::Kind::Take:
+          checkRead(Operation, Variable, Values, Diagnose);
+          Values[TakenValues.lookup(Operation)] = state(Variable, Values);
+          if (Diagnose && DroppedTakes.contains(Operation))
+            diagnose(Operation, Variable,
+                     "taking resource %0 discards its ownership result; "
+                     "use discard to close it immediately");
+          break;
+        case ObjC3ResourceExpr::Kind::Reset:
+          if (Diagnose) {
+            auto Replacement = getObjC3ResourceTypeContract(
+                Context,
+                Operation->getReplacement()->IgnoreParenCasts()->getType());
+            auto Target = Contracts.lookup(Variable);
+            if (Replacement.Cleanup &&
+                ((Target.Cleanup && !compatibleTypes(Replacement, Target)) ||
+                 !acceptsObjC3ResourceCleanup(Context, Replacement,
+                                              registeredCleanup(Variable))))
+              diagnose(Node, Variable,
+                       "reset of resource %0 mixes incompatible cleanup "
+                       "families; preserve the replacement's resource type");
+          }
+          assign(Variable, value(Operation->getReplacement(), Variable, Values),
+                 Values);
+          break;
+        case ObjC3ResourceExpr::Kind::Discard:
+          assign(Variable, Discarded, Values);
+          break;
+        }
+      }
+      auto Initialize = [&](const VarDecl *Target, const Expr *Source,
+                            bool Assignment) {
+        const VarDecl *Origin = variable(Source);
+        if (!Variables.count(Target)) {
+          if (Origin && Contracts.lookup(Origin).Cleanup && Diagnose)
+            diagnose(Node, Origin,
+                     "copying resource %0 into untracked storage erases its "
+                     "cleanup contract; preserve typed ownership or borrow it "
+                     "through a call");
+          return;
+        }
+        if (Diagnose && (Assignment || Source) &&
+            (state(Target, Values) & Live))
+          diagnose(Node, Target,
+                   "assignment may overwrite live resource %0; use reset to "
+                   "close the current value first");
+        if (Diagnose && Origin)
+          diagnose(Node, Target,
+                   "initializing resource %0 from another resource copies "
+                   "ownership; use take to transfer it");
+        if (Source && Diagnose) {
+          auto SourceContract = getObjC3ResourceTypeContract(
+              Context, Source->IgnoreParenCasts()->getType());
+          auto TargetContract = Contracts.lookup(Target);
+          if (SourceContract.Cleanup && TargetContract.Cleanup &&
+              !compatibleTypes(SourceContract, TargetContract))
+            diagnose(Node, Target,
+                     "initializing resource %0 mixes distinct cleanup "
+                     "families; preserve the source resource type");
+          if (SourceContract.Cleanup)
+            if (const FunctionDecl *Cleanup = registeredCleanup(Target))
+              if (!acceptsObjC3ResourceCleanup(Context, SourceContract,
+                                               Cleanup))
+                diagnose(Node, Target,
+                         "cleanup for resource %0 does not match the "
+                         "acquired value's family; use its declared cleanup");
+        }
+        assign(Target, value(Source, Target, Values), Values);
+      };
+      if (const auto *Declaration = dyn_cast<DeclStmt>(Node))
+        for (const Decl *D : Declaration->decls())
+          if (const auto *Variable = dyn_cast<VarDecl>(D))
+            Initialize(Variable, Variable->getInit(), false);
+      if (const auto *Binary = dyn_cast<BinaryOperator>(Node))
+        if (Binary->isAssignmentOp())
+          if (const auto *Reference = dyn_cast<DeclRefExpr>(
+                  Binary->getLHS()->IgnoreParenImpCasts()))
+            Initialize(dyn_cast<VarDecl>(Reference->getDecl()),
+                       Binary->getRHS(), true);
+      if (const auto *Unary = dyn_cast<UnaryOperator>(Node))
+        if (Unary->isIncrementDecrementOp())
+          if (const VarDecl *Variable = variable(Unary->getSubExpr())) {
+            checkRead(Node, Variable, Values, Diagnose);
+            if (Diagnose)
+              diagnose(Node, Variable,
+                       "modifying resource %0 requires an ownership-aware "
+                       "reset operation");
+            assign(Variable, Fresh, Values);
+          }
+      if (const auto *Return = dyn_cast<ReturnStmt>(Node)) {
+        const Expr *Result = Return->getRetValue();
+        if (Result) {
+          const VarDecl *Source = variable(Result);
+          auto SourceContract =
+              Source ? Contracts.lookup(Source)
+                     : getObjC3ResourceTypeContract(
+                           Context, Result->IgnoreParenCasts()->getType());
+          if (SourceContract.Cleanup) {
+            auto Destination =
+                getObjC3ResourceTypeContract(Context, ReturnType);
+            if (!compatibleTypes(SourceContract, Destination)) {
+              if (Diagnose) {
+                if (Source)
+                  diagnose(
+                      Node, Source,
+                      "returning resource %0 erases or changes its cleanup "
+                      "family; return the compatible owned typedef");
+                else if (Diagnosed.insert(Return).second) {
+                  Actions.Diag(
+                      Return->getReturnLoc(),
+                      Actions.getDiagnostics().getCustomDiagID(
+                          DiagnosticsEngine::Error,
+                          "returning an acquired resource erases or changes "
+                          "its cleanup family; return its owned typedef"));
+                  Invalid = true;
+                }
+              }
+            } else if (Source) {
+              if (registeredCleanup(Source)) {
+                if (Diagnose)
+                  diagnose(
+                      Node, Source,
+                      "returning registered resource %0 copies ownership; "
+                      "use take from a resource with an invalid sentinel");
+              } else {
+                checkRead(Node, Source, Values, Diagnose);
+                assign(Source, Moved, Values);
+              }
+            }
+          }
+        }
+      }
+      if (const auto *Call = dyn_cast<CallExpr>(Node)) {
+        const FunctionDecl *Function = Call->getDirectCallee();
+        for (const Expr *Argument : Call->arguments()) {
+          const VarDecl *Variable = argumentVariable(Argument);
+          auto Contract =
+              Variable ? Contracts.lookup(Variable)
+                       : getObjC3ResourceTypeContract(
+                             Context, Argument->IgnoreParenCasts()->getType());
+          bool Closing =
+              Variable
+                  ? acceptsCleanup(Variable, Function)
+                  : acceptsObjC3ResourceCleanup(Context, Contract, Function);
+          bool KnownCleanup = isObjC3ResourceCleanupFunction(Function);
+          if (!Variable) {
+            if (Diagnose && Contract.Cleanup && KnownCleanup && !Closing &&
+                Diagnosed.insert(Call).second) {
+              Actions.Diag(
+                  Call->getExprLoc(),
+                  Actions.getDiagnostics().getCustomDiagID(
+                      DiagnosticsEngine::Error,
+                      "cleanup function is not associated with the acquired "
+                      "resource's family; use its declared cleanup"));
+              Invalid = true;
+            }
+            continue;
+          }
+          if (KnownCleanup && !Closing && Diagnose)
+            diagnose(
+                Node, Variable,
+                "cleanup function for resource %0 is not associated with its "
+                "type contract or family; use its declared cleanup");
+          if (Closing) {
+            if (registeredCleanup(Variable)) {
+              if (Diagnose)
+                diagnose(Node, Variable,
+                         "manual close of registered resource %0 can close "
+                         "it twice; use discard or close the result of take");
+            } else {
+              if (Diagnose &&
+                  (state(Variable, Values) & (Moved | Discarded | Closed)))
+                diagnose(
+                    Node, Variable,
+                    "resource %0 may already be closed, moved, or invalid; "
+                    "test its sentinel or reinitialize it before cleanup");
+              unsigned char Previous = state(Variable, Values);
+              assign(Variable,
+                     (Previous & Live ? Closed : 0) |
+                         (Previous & (Empty | Moved | Discarded | Closed)),
+                     Values);
+            }
+          } else if (Argument->isGLValue() && Diagnose)
+            diagnose(Node, Variable,
+                     "strict-system cannot expose resource %0 through a "
+                     "reference argument; use resource operations directly");
+        }
+      }
+    }
+  }
+
+  bool refineVariable(const VarDecl *Variable, bool Valid,
+                      Facts &Values) const {
+    if (!Variable || Variable->getType().isVolatileQualified())
+      return true;
+    // A manual close consumes ownership without promising sentinel stores.
+    // Comparing the unchanged scalar must never resurrect a closed handle.
+    unsigned char Remaining =
+        (state(Variable, Values) & (Valid ? Live : Sentinel)) |
+        (state(Variable, Values) & Closed);
+    assign(Variable, Remaining, Values);
+    return Remaining != 0;
+  }
+  bool refine(const Expr *Condition, bool Truth, Facts &Values) const {
+    if (!Condition)
+      return true;
+    Condition = Condition->IgnoreParenImpCasts();
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Condition)) {
+      if (Full->cleanupsHaveSideEffects())
+        return true;
+      return refine(Full->getSubExpr(), Truth, Values);
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Condition))
+      if (Unary->getOpcode() == UO_LNot)
+        return refine(Unary->getSubExpr(), !Truth, Values);
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Condition)) {
+      if (Binary->HasSideEffects(Context))
+        return true;
+      if (Binary->isEqualityOp()) {
+        const VarDecl *Variable = variable(Binary->getLHS());
+        const Expr *Constant = Binary->getRHS();
+        if (!Variable) {
+          Variable = variable(Binary->getRHS());
+          Constant = Binary->getLHS();
+        }
+        if (Variable && isSentinel(Constant, Variable) == true)
+          return refineVariable(
+              Variable, Truth == (Binary->getOpcode() == BO_NE), Values);
+      }
+      // Individual short-circuit CFG branches retain the earlier operand's
+      // facts. Replaying a compound test can resurrect a value already moved
+      // by the later operand, so only handle side-effect-free conjunctions.
+      if ((Binary->getOpcode() == BO_LAnd && Truth) ||
+          (Binary->getOpcode() == BO_LOr && !Truth))
+        return refine(Binary->getLHS(), Truth, Values) &&
+               refine(Binary->getRHS(), Truth, Values);
+    }
+    if (const VarDecl *Variable = variable(Condition))
+      if (zeroSentinel(Variable))
+        return refineVariable(Variable, Truth, Values);
+    return true;
+  }
+
+public:
+  explicit ResourceFlow(Sema &Actions)
+      : Actions(Actions), Context(Actions.Context) {}
+
+  bool check(Decl *Callable, Stmt *Body) {
+    if (const auto *Function = dyn_cast_or_null<FunctionDecl>(Callable))
+      ReturnType = Function->getReturnType();
+    else if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Callable))
+      ReturnType = Method->getReturnType();
+    else if (const auto *Block = dyn_cast_or_null<BlockDecl>(Callable))
+      if (const TypeSourceInfo *Signature = Block->getSignatureAsWritten())
+        if (const auto *Prototype =
+                Signature->getType()->getAs<FunctionProtoType>())
+          ReturnType = Prototype->getReturnType();
+    if (const auto *Block = dyn_cast_or_null<BlockDecl>(Callable))
+      for (const auto &Capture : Block->captures())
+        if (Capture.isObjC3ResourceCapture()) {
+          const VarDecl *Variable = Capture.getVariable();
+          Variables.try_emplace(Variable, Variables.size());
+          Contracts[Variable] = getObjC3ResourceTypeContract(Context, Variable->getType());
+          CapturedOwners.insert(Variable);
+        }
+    if (getObjC3ResourceTypeContract(Context, ReturnType).Cleanup)
+      ReturnScopes = std::make_unique<ObjC3SourceScopes>(Body);
+    collect(Body);
+    if (Invalid) return true;
+    if (Variables.empty())
+      return Invalid;
+    CFG::BuildOptions Options;
+    Options.setAllAlwaysAdd();
+    Options.AddEHEdges = true;
+    Options.AddLifetime = true;
+    Options.AddInitializers = true;
+    Options.AddImplicitDtors = true;
+    Options.AddTemporaryDtors = true;
+    std::unique_ptr<CFG> Graph =
+        CFG::buildCFG(Callable, Body, &Context, Options);
+    if (!Graph) {
+      diagnose(Body, Variables.begin()->first,
+               "strict-system cannot prove ownership of resource %0 across "
+               "this control flow; simplify the callable's cleanup boundary");
+      return true;
+    }
+    unsigned NumFacts = Variables.size();
+    for (auto &Entry : TakenValues)
+      Entry.second = NumFacts++;
+    struct State {
+      Facts Values;
+      bool Reachable = false;
+    };
+    std::vector<State> Inputs(Graph->getNumBlockIDs());
+    const CFGBlock *Entry = &Graph->getEntry();
+    Facts Initial(NumFacts, Empty);
+    for (const VarDecl *Owner : CapturedOwners)
+      Initial[Variables.lookup(Owner)] = Fresh;
+    Inputs[Entry->getBlockID()] = {std::move(Initial), true};
+    SmallVector<const CFGBlock *, 16> Work{Entry};
+    while (!Work.empty()) {
+      const CFGBlock *Block = Work.pop_back_val();
+      Facts Output = Inputs[Block->getBlockID()].Values;
+      transfer(*Block, Output, false);
+      unsigned Index = 0;
+      for (auto Successor : Block->succs()) {
+        unsigned EdgeIndex = Index++;
+        const CFGBlock *Next = Successor.getReachableBlock();
+        if (!Next)
+          continue;
+        // A terminating call (including a second exception during cleanup)
+        // never leaves the scope normally. Preserve its exceptional edges to
+        // handlers, but do not merge its synthetic exit edge into leak facts.
+        if (Block->hasNoReturnElement() && Next == &Graph->getExit())
+          continue;
+        Facts Edge = Output;
+        bool Reachable = true;
+        auto Kind = Block->getTerminator().getKind();
+        if (Kind == CFGTerminator::ObjC3ResourceBranch) {
+          for (const CFGElement &Element : *Block)
+            if (Element.getKind() == CFGElement::ObjC3ResourceRead)
+              Reachable &= refineVariable(
+                  Element.castAs<CFGObjC3ResourceAction>().getVarDecl(),
+                  EdgeIndex == 0, Edge);
+        } else if (Block->succ_size() == 2 &&
+                   (Kind == CFGTerminator::ObjC3ConditionBranch ||
+                    isa_and_nonnull<IfStmt, ForStmt, WhileStmt, DoStmt,
+                                    AbstractConditionalOperator, BinaryOperator,
+                                    ChooseExpr>(Block->getTerminatorStmt()))) {
+          const Expr *Condition = Block->getLastCondition();
+          if (!Condition)
+            Condition = dyn_cast_or_null<Expr>(Block->getTerminatorCondition());
+          Reachable = refine(Condition, EdgeIndex == 0, Edge);
+        }
+        if (!Reachable)
+          continue;
+        State &Input = Inputs[Next->getBlockID()];
+        if (!Input.Reachable) {
+          Input = {std::move(Edge), true};
+          Work.push_back(Next);
+        } else {
+          bool Changed = false;
+          for (unsigned I = 0; I != NumFacts; ++I) {
+            unsigned char Joined = Input.Values[I] | Edge[I];
+            Changed |= Joined != Input.Values[I];
+            Input.Values[I] = Joined;
+          }
+          if (Changed)
+            Work.push_back(Next);
+        }
+      }
+    }
+    for (const CFGBlock *Block : *Graph)
+      if (Inputs[Block->getBlockID()].Reachable) {
+        Facts Values = Inputs[Block->getBlockID()].Values;
+        transfer(*Block, Values, true);
+      }
+    // General native EH paths can leave trivial locals without lifetime
+    // elements. Their live facts still reach the function exit.
+    const State &Exit = Inputs[Graph->getExit().getBlockID()];
+    if (Exit.Reachable)
+      for (auto [Variable, Index] : Variables)
+        checkLeak(Variable, Exit.Values);
+    return Invalid;
+  }
+};
+} // namespace
+
+bool clang::checkObjC3ResourceFlow(Sema &S, Decl *Callable, Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile != 3 || !Body ||
+      (Callable && Callable->isInvalidDecl()))
+    return false;
+  return ResourceFlow(S).check(Callable, Body);
+}
