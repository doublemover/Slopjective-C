+  auto CreateRecord = [&](TagTypeKind Kind, DeclContext *DC) -> RecordDecl * {
+    RecordDecl *RD;
+    if (getLangOpts().CPlusPlus)
+      RD = CXXRecordDecl::Create(*this, Kind, DC, SourceLocation(),
+                                 SourceLocation(), nullptr);
+    else
+      RD = RecordDecl::Create(*this, Kind, DC, SourceLocation(),
+                              SourceLocation(), nullptr);
+    RD->setImplicit();
+    RD->startDefinition();
+    return RD;
+  };
+  auto AddField = [&](RecordDecl *RD, StringRef Name,
+                      QualType FieldType) -> FieldDecl * {
+    auto *Field = FieldDecl::Create(
+        *this, RD, SourceLocation(), SourceLocation(), &Idents.get(Name),
+        FieldType, nullptr, nullptr, false, ICIS_NoInit);
+    Field->setImplicit();
+    if (isa<CXXRecordDecl>(RD))
+      Field->setAccess(AS_public);
+    RD->addDecl(Field);
+    return Field;
+  };
+  auto CompleteRecord = [](RecordDecl *RD) {
+    if (auto *CXXRD = dyn_cast<CXXRecordDecl>(RD))
+      CXXRD->completeDefinition();
+    else
+      RD->completeDefinition();
+  };
+
+  auto *Outer = CreateRecord(TagTypeKind::Struct, getTranslationUnitDecl());
+  Info.Record = Outer;
+  Info.TagField = AddField(Outer, "__objc3_state", BoolTy);
+
+  const bool HasFirstStorage = !FirstPayload->isVoidType();
+  const bool HasSecondStorage = !IsOptional && !SecondPayload->isVoidType();
+  if (HasFirstStorage || HasSecondStorage) {
+    auto *PayloadUnion = CreateRecord(TagTypeKind::Union, getTranslationUnitDecl());
+    Info.PayloadUnion = PayloadUnion;
+    if (HasFirstStorage) {
+      if (IsOptional)
+        Info.ValueField = AddField(PayloadUnion, "__objc3_value", FirstPayload);
+      else
