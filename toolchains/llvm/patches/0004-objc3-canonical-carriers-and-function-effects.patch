+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    auto From = tooling::buildASTFromCodeWithArgs(
+        "struct Base { int b; constexpr Base(int n):b(n) {} }; "
+        "struct Value:Base { int first; int second=2; "
+        "constexpr Value(int n):first(n),Base(40) {} "
+        "constexpr Value():Value(42) {} };", {"-xc++", Standard});
+    auto To = tooling::buildASTFromCodeWithArgs("", {"-xc++", Standard});
+    ASSERT_TRUE(From && To);
+    ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                         From->getASTContext(), From->getFileManager(), false);
+    unsigned Written = 0;
+    for (auto *D : From->getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *Record = dyn_cast<CXXRecordDecl>(D); Record && Record->isCompleteDefinition()) {
+        auto Imported = Importer.Import(Record);
+        ASSERT_TRUE(static_cast<bool>(Imported)) << llvm::toString(Imported.takeError());
+        auto *Copy = cast<CXXRecordDecl>(*Imported);
+        for (auto *Constructor : Record->ctors()) {
+          if (Constructor->isImplicit()) continue;
+          CXXConstructorDecl *CopyConstructor = nullptr;
+          for (auto *Candidate : Copy->ctors())
+            if (!Candidate->isImplicit() && Candidate->getNumParams() == Constructor->getNumParams())
+              CopyConstructor = Candidate;
+          ASSERT_NE(nullptr, CopyConstructor);
+          ASSERT_EQ(Constructor->getNumCtorInitializers(), CopyConstructor->getNumCtorInitializers());
+          for (unsigned I = 0; I < Constructor->getNumCtorInitializers(); ++I) {
+            const auto *Original = Constructor->init_begin()[I];
+            const auto *ImportedInit = CopyConstructor->init_begin()[I];
+            EXPECT_EQ(Original->isWritten(), ImportedInit->isWritten());
+            if (Original->isWritten()) {
+              EXPECT_EQ(Original->getSourceOrder(), ImportedInit->getSourceOrder());
+              ++Written;
+            }
+          }
+        }
+      }
+    EXPECT_EQ(4u, Written);
+  }
+}
