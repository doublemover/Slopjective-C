+  bool hasValidShape() const {
+    switch (Throws) {
+    case ObjC3ThrowsKind::None:
+    case ObjC3ThrowsKind::Untyped:
+      return ErrorType.isNull();
+    case ObjC3ThrowsKind::Typed:
