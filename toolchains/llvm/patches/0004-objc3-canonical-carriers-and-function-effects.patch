diff --git a/clang/lib/Sema/SemaObjC3Async.cpp b/clang/lib/Sema/SemaObjC3Async.cpp
new file mode 100644
index 000000000..b1f400f38
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Async.cpp
@@ -0,0 +1,267 @@
+//===--- SemaObjC3Async.cpp - Native C async definitions -------------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "SemaObjC3Effects.h"
+#include "SemaObjC3ErrorContext.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/Sema/Lookup.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/StmtObjC.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "clang/AST/ObjC3Async.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Basic/Builtins.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Basic/DiagnosticParse.h"
+#include "llvm/ADT/STLExtras.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+ExprResult Sema::BuildObjC3CxxFrameAwaitOperand(SourceLocation Loc,
+                                               Expr *Operand) {
+  if (getObjC3FrameAdapterSource(Operand) != Operand->IgnoreImplicit())
+    return Operand;
+  const auto *Function = getObjC3AsyncCalleeFunctionType(Operand);
+  if (!Function || !Function->getObjC3FunctionEffects().AsyncFrame)
+    return Operand;
+  if (BuildObjC3AsyncTaskType(Function, Loc).isNull())
+    return ExprError();
+  LookupResult Hook(*this, &Context.Idents.get("__objc3_async_from_frame"),
+                    Loc, LookupOrdinaryName);
+  Hook.suppressDiagnostics();
+  LookupQualifiedName(Hook, Context.getTranslationUnitDecl());
+  if (Hook.isAmbiguous() || !llvm::any_of(Hook, [](NamedDecl *D) {
+        return isa<FunctionTemplateDecl>(D);
+      })) {
+    Diag(Loc, diag::err_objc3_async_task_header);
+    return ExprError();
+  }
+  TemplateArgumentListInfo Arguments(Loc, Loc);
+  QualType Result = Function->getReturnType();
+  Arguments.addArgument(TemplateArgumentLoc(
+      TemplateArgument(Result), Context.getTrivialTypeSourceInfo(Result, Loc)));
+  CXXScopeSpec SS;
+  ExprResult Callee = BuildTemplateIdExpr(SS, SourceLocation(), Hook, false,
+                                         &Arguments);
+  if (Callee.isInvalid()) return ExprError();
+  Expr *Args[] = {Operand};
+  return BuildCallExpr(nullptr, Callee.get(), Loc, Args, Loc);
+}
+
+ExprResult Sema::ActOnObjC3CAwaitExpr(SourceLocation Loc, Expr *Operand) {
+  const Decl *Callable = Decl::castFromDeclContext(CurContext);
+  const auto *Enclosing = getObjC3CallableFunctionType(Callable);
+  if (!Enclosing ||
+      !Enclosing->getObjC3FunctionEffects().AsyncFrame) {
+    Diag(Loc, diag::err_objc3_await_context);
+    return ExprError();
+  }
+  // Keep the source call and its logical function type. The call expression's
+  // evaluated result is the common ABI carrier, not the logical await result.
+  const auto *Function = getObjC3AsyncCalleeFunctionType(Operand);
+  const bool TaskABI = Function && getLangOpts().CPlusPlus &&
+      Function->getObjC3FunctionEffects().Async &&
+      !Function->getObjC3FunctionEffects().AsyncFrame;
+  if (!Function || (!Function->getObjC3FunctionEffects().AsyncFrame && !TaskABI)) {
+    // Isolation checking runs at the parser's shared await entry before this
+    // identity path. A synchronous expression needs no frame continuation.
+    if (isObjC3NonSuspendingAwait(Operand))
+      return ActOnObjC3NonSuspendingAwait(Loc, Operand);
+    Diag(Loc, diag::err_objc3_async_c_await_operand);
+    return ExprError();
+  }
+  if (llvm::is_contained(ObjC3DeferOwnerStack,
+                         getCurrentObjC3CallableContext(*this))) {
+    Diag(Loc, diag::err_objc3_async_defer_suspend);
+    return ExprError();
+  }
+  if (BuildObjC3AsyncTaskType(Function, Loc).isNull())
+    return ExprError();
+  if (TaskABI) {
+    // A C++ task already owns the same runtime frame protocol. Transfer its
+    // lazy frame before registering the child; the moved-from task's ordinary
+    // temporary cleanup then owns no carrier, including on failure/cancel.
+    LookupResult Hook(*this, &Context.Idents.get("__objc3_async_to_frame"),
+                      Loc, LookupOrdinaryName);
+    Hook.suppressDiagnostics();
+    LookupQualifiedName(Hook, Context.getTranslationUnitDecl());
+    if (Hook.isAmbiguous() || !llvm::any_of(Hook, [](NamedDecl *D) {
+          return isa<FunctionTemplateDecl>(D);
+        })) {
+      Diag(Loc, diag::err_objc3_async_task_header);
+      return ExprError();
+    }
+    TemplateArgumentListInfo Arguments(Loc, Loc);
+    QualType Result = Function->getReturnType();
+    Arguments.addArgument(TemplateArgumentLoc(
+        TemplateArgument(Result), Context.getTrivialTypeSourceInfo(Result, Loc)));
+    CXXScopeSpec SS;
+    ExprResult Callee = BuildTemplateIdExpr(SS, SourceLocation(), Hook, false,
+                                           &Arguments);
+    if (Callee.isInvalid()) return ExprError();
+    Expr *Args[] = {Operand};
+    ExprResult Frame = BuildCallExpr(nullptr, Callee.get(), Loc, Args, Loc);
+    if (Frame.isInvalid()) return ExprError();
+    Operand = Frame.get();
+  }
+  // Reuse the serialized suspension expression contract. C has no awaiter
+  // class: these opaque operations describe the compiler-owned frame protocol
+  // and are emitted by the native C lowering, never as C++ member calls.
+  auto *Common = new (Context)
+      OpaqueValueExpr(Loc, Operand->getType(), VK_PRValue);
+  auto *Ready = new (Context) OpaqueValueExpr(Loc, Context.BoolTy, VK_PRValue);
+  auto *Suspend = new (Context) OpaqueValueExpr(Loc, Context.VoidTy, VK_PRValue);
+  auto *Resume = new (Context)
+      OpaqueValueExpr(Loc, Function->getReturnType(), VK_PRValue);
+  return new (Context)
+      CoawaitExpr(Loc, Operand, Operand, Ready, Suspend, Resume, Common);
+}
+
+namespace {
+bool instantiateCxxFrameStorageHook(Sema &S, QualType T, SourceLocation Loc,
+                                     StringRef Name, bool Capture) {
+  LookupResult Hook(S, &S.Context.Idents.get(Name), Loc, Sema::LookupOrdinaryName);
+  Hook.suppressDiagnostics();
+  S.LookupQualifiedName(Hook, S.Context.getTranslationUnitDecl());
+  if (Hook.isAmbiguous() || !llvm::any_of(Hook, [](NamedDecl *D) {
+        return isa<FunctionTemplateDecl>(D);
+      })) {
+    S.Diag(Loc, diag::err_objc3_async_frame_cpp_hook) << Name;
+    return true;
+  }
+  TemplateArgumentListInfo Arguments(Loc, Loc);
+  Arguments.addArgument(TemplateArgumentLoc(TemplateArgument(T),
+      S.Context.getTrivialTypeSourceInfo(T, Loc)));
+  CXXScopeSpec SS;
+  ExprResult Callee = S.BuildTemplateIdExpr(SS, SourceLocation(), Hook, false,
+                                           &Arguments);
+  if (Callee.isInvalid()) return true;
+  SmallVector<Expr *, 2> Args;
+  if (Capture)
+    for (unsigned I = 0; I != 2; ++I)
+      Args.push_back(new (S.Context) ImplicitValueInitExpr(S.Context.VoidPtrTy));
+  ExprResult Call = S.BuildCallExpr(nullptr, Callee.get(), Loc, Args, Loc);
+  if (Call.isInvalid()) return true;
+  auto *Function = cast<CallExpr>(Call.get())->getDirectCallee();
+  if (Capture ? !Function->getReturnType()->isVoidType()
+              : !Function->getReturnType()->isPointerType()) {
+    S.Diag(Loc, diag::err_objc3_async_frame_cpp_hook) << Name;
+    return true;
+  }
+  S.InstantiateFunctionDefinition(Loc, Function, true, true);
+  return Function->isInvalidDecl();
+}
+
+bool requireCxxFrameStorage(Sema &S, QualType T, SourceLocation Loc,
+                            bool Capture) {
+  if (T->isDependentType()) return false;
+  if (!Capture) T = T.getCanonicalType().getUnqualifiedType();
+  if (T->isRecordType() && !T.isTriviallyCopyableType(S.Context))
+    if (instantiateCxxFrameStorageHook(S, T, Loc,
+            Capture ? "__objc3_async_frame_capture"
+                    : "__objc3_async_frame_value_ops", Capture))
+      return true;
+  if (!Capture && (T->isRecordType() || T->isEnumeralType()) &&
+      T->getLinkage() != Linkage::External)
+    return instantiateCxxFrameStorageHook(S, T, Loc,
+                                          "__objc3_async_frame_result_type", false);
+  return false;
+}
+
+class AsyncMonitorVisitor : public RecursiveASTVisitor<AsyncMonitorVisitor> {
+  Sema &S;
+  SmallVector<SourceLocation, 4> Monitors;
+  llvm::SmallPtrSet<const Expr *, 8> Diagnosed;
+  void check(Expr *E, SourceLocation Loc) {
+    if (Monitors.empty() || !Diagnosed.insert(E).second) return;
+    S.Diag(Loc, diag::err_objc3_async_synchronized_suspend);
+    S.Diag(Monitors.back(), diag::note_objc3_async_synchronized_scope);
+    Failed = true;
+  }
+public:
+  bool Failed = false;
+  explicit AsyncMonitorVisitor(Sema &S) : S(S) {}
+  // Closure creation does not execute its body. A nested async callable checks
+  // only its own monitor scopes when its definition is completed.
+  bool TraverseBlockExpr(BlockExpr *) { return true; }
+  bool TraverseLambdaExpr(LambdaExpr *) { return true; }
+  bool TraverseObjCAtSynchronizedStmt(ObjCAtSynchronizedStmt *Statement) {
+    // The lock expression runs before monitor acquisition and may suspend.
+    if (!TraverseStmt(Statement->getSynchExpr())) return false;
+    Monitors.push_back(Statement->getAtSynchronizedLoc());
+    bool Result = TraverseStmt(Statement->getSynchBody());
+    Monitors.pop_back();
+    return Result;
+  }
+  bool VisitCoawaitExpr(CoawaitExpr *E) {
+    check(E, E->getKeywordLoc());
+    return true;
+  }
+  bool VisitDependentCoawaitExpr(DependentCoawaitExpr *E) {
+    check(E, E->getKeywordLoc());
+    return true;
+  }
+  bool VisitCoyieldExpr(CoyieldExpr *E) {
+    check(E, E->getKeywordLoc());
+    return true;
+  }
+};
+
+class CAsyncStorageVisitor : public RecursiveASTVisitor<CAsyncStorageVisitor> {
+  Sema &S;
+public:
+  bool Failed = false;
+  explicit CAsyncStorageVisitor(Sema &S) : S(S) {}
+  // Nested callable storage belongs to a different invocation.
+  bool TraverseBlockExpr(BlockExpr *) { return true; }
+  bool TraverseLambdaExpr(LambdaExpr *) { return true; }
+  bool VisitCoawaitExpr(CoawaitExpr *E) {
+    if (S.getLangOpts().CPlusPlus)
+      Failed |= requireCxxFrameStorage(S, E->getType(), E->getKeywordLoc(), false);
+    return true;
+  }
+
+};
+} // namespace
+
+bool clang::checkObjC3CAsyncBody(Sema &S, Decl *Callable, Stmt *Body) {
+  if (!Callable || !Body || !S.getLangOpts().ObjC3)
+    return false;
+  const auto *Type = getObjC3CallableFunctionType(Callable);
+  if (!Type || !Type->getObjC3FunctionEffects().Async)
+    return false;
+  AsyncMonitorVisitor Monitors(S);
+  Monitors.TraverseStmt(Body);
+  if (!Type->getObjC3FunctionEffects().AsyncFrame) return Monitors.Failed;
+  if (Callable->hasAttr<ObjCTaskGroupAttr>() && S.getLangOpts().Exceptions &&
+      !S.getLangOpts().ObjCExceptions) {
+    S.Diag(Callable->getLocation(), diag::err_objc3_group_scope_exceptions);
+    return true;
+  }
+  if (S.getLangOpts().CPlusPlus) {
+    // Value parameters own independent captures. Reference parameters and the
+    // implicit C++ receiver retain ordinary coroutine borrowing: the caller
+    // keeps their referents alive until the task and frame have quiesced.
+    if (requireCxxFrameStorage(S, Type->getReturnType(),
+                               Callable->getLocation(), false))
+      return true;
+    auto CheckParameter = [&](const ParmVarDecl *P) {
+      return requireCxxFrameStorage(S, P->getType(), P->getLocation(), true);
+    };
+    if (const auto *F = dyn_cast<FunctionDecl>(Callable)) {
+      if (llvm::any_of(F->parameters(), CheckParameter)) return true;
+    } else if (const auto *M = dyn_cast<ObjCMethodDecl>(Callable)) {
+      if (llvm::any_of(M->parameters(), CheckParameter)) return true;
+    } else if (const auto *B = dyn_cast<BlockDecl>(Callable)) {
+      if (llvm::any_of(B->parameters(), CheckParameter)) return true;
+    }
+  }
+  if (S.BuildObjC3AsyncTaskType(Type, Callable->getLocation()).isNull())
+    return true;
+  CAsyncStorageVisitor Visitor(S);
+  Visitor.TraverseStmt(Body);
+  return Visitor.Failed || Monitors.Failed;
+}
