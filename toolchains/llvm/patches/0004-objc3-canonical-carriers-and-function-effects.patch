+    __objc3_defer { __objc3_throw(error); } // expected-error {{an ObjC3 error may not escape a defer body}}
+  } __objc3_catch { }
+}
+void local_defer_handler(E error) {
+  __objc3_defer {
+    __objc3_do { __objc3_throw(error); }
+    __objc3_catch(E bound) { (void)bound; }
+  }
+}
+void independent_callable_in_defer(E error) {
+  __objc3_defer {
+    struct Local {
+      static void f(E e) __objc3_throws(E) { __objc3_throw(e); }
+    };
+  }
+}
+
+template<class F> void dependent_escape(F f) __objc3_throws(E) {
+  __objc3_defer { __objc3_try(f()); } // expected-error {{an ObjC3 error may not escape a defer body}}
+}
+void instantiate_escape() {
+  __objc3_try_optional(dependent_escape(raises)); // expected-note {{in instantiation of function template specialization}}
+}
+
+@protocol Extra @end
+void extra_protocol_is_not_a_universal_bridge(E error) {
+  __objc3_do {
+    __objc3_throw(error); // expected-error {{ObjC3 error is neither caught here nor compatible}}
+  } __objc3_catch(id<Error, Extra>) { // expected-error {{is incompatible with thrown error type}}
+  }
+}
