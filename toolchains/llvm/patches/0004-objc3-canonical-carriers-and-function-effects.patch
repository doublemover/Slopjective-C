+static void checkObjC3CarrierLocalDestruction(Sema &S, VarDecl *VD) {
+  if (!S.getLangOpts().ObjC3 || !S.getLangOpts().CPlusPlus ||
+      !VD->hasLocalStorage() || !VD->hasInit() ||
+      VD->getType()->isDependentType() || VD->getInit()->containsErrors())
+    return;
+  QualType Carrier = S.Context.getCanonicalType(VD->getType());
+  const Type *Ty = Carrier.getTypePtr();
+  if (!isa<ObjC3OptionalType>(Ty) && !isa<ObjC3ResultType>(Ty))
+    return;
+  auto Info = S.Context.getObjC3CarrierRepresentationType(Carrier);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return;
+
+  // The synthetic carrier record describes layout only. Reference actual
+  // payload destructors in the user's access context, including empty/inactive
+  // arms, without binding a stored member as a full-expression temporary.
+  for (FieldDecl *Field : {Info.ValueField, Info.SuccessField, Info.ErrorField}) {
+    if (!Field)
+      continue;
+    QualType Payload = Field->getType();
+    CXXRecordDecl *RD = Payload->getAsCXXRecordDecl();
+    if (!RD || RD->isDependentContext())
+      continue;
+    CXXDestructorDecl *Dtor = S.LookupDestructor(RD);
+    if (!Dtor) {
+      VD->setInvalidDecl();
+      continue;
+    }
+    S.CheckDestructorAccess(VD->getLocation(), Dtor,
+                            S.PDiag(diag::err_access_dtor_var)
+                                << VD->getDeclName() << Payload);
+    S.MarkFunctionReferenced(VD->getLocation(), Dtor);
+    if (S.DiagnoseUseOfDecl(Dtor, VD->getLocation()))
+      VD->setInvalidDecl();
+  }
+}
