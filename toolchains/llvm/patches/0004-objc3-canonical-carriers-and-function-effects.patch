+// RUN: %clang_cc1 -fsyntax-only -verify -x objective-c -std=c17 -fobjc-version=3 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// RUN: %clang_cc1 -fsyntax-only -verify -x objective-c++ -std=c++20 -fexceptions -fcxx-exceptions -fobjc-version=3 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// expected-no-diagnostics
+int checked(int value) throws(int) { if (value < 0) throwError(value); return value; }
+int forward(int value) throws(int) { return tryValue(checked(value)); }
+int recover(int value) {
+  int answer = 0;
+  handle { answer = tryValue(forward(value)); }
+  catch(int error) { answer = -error; }
+  Optional(int) maybe = tryOptional(checked(value));
+  return answer + hasValue(maybe);
+}
+#ifdef __cplusplus
+int native_unwind() {
+  try { throw 7; } catch (int value) { return value; }
+}
+#endif
