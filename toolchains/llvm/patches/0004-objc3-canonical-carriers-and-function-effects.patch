+TEST(ObjC3ConditionCFG, CarrierDestructionKeepsLexicallyCaughtExceptionPaths) {
+  auto AST =
+      tooling::buildASTFromCodeWithArgs(R"(
+    struct Payload {
+      Payload() noexcept;
+      Payload(const Payload &) noexcept;
+      ~Payload() noexcept(false);
+    };
+    typedef __objc3_optional(Payload) Maybe;
+    void fail_caught(bool accept, Maybe &input) {
+      if (accept) {} else {
+        try { Maybe local = __objc3_copy(input); return; }
+        catch (...) {}
+      }
+    }
+    void fail_outward_goto(bool accept, Maybe &input) {
+      {
+        if (accept) {} else {
+          try { Maybe local = __objc3_copy(input); goto outside; }
+          catch (...) {}
+        }
+      }
+      outside:;
+    }
+  )",
+                                        {"-x", "objective-c++", "-std=c++20",
+                                         "-fobjc-version=3", "-fexceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto *Messages = new Diagnostics;
+  AST->getDiagnostics().setClient(Messages, true);
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    ++Cases;
+    auto *Guard = replacePlaceholder(AST->getASTContext(), Function);
+    ASSERT_TRUE(Guard);
+    Sema::SynthesizedFunctionScope Scope(AST->getSema(), Function);
+    EXPECT_TRUE(AST->getSema().CheckObjC3Guards(Function, Function->getBody()));
+    CFG::BuildOptions Options;
+    Options.AddImplicitDtors = true;
+    Options.setAllAlwaysAdd();
+    auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                               &AST->getASTContext(), Options);
+    ASSERT_TRUE(Graph);
+    unsigned CarrierCleanups = 0, CarrierBranches = 0;
+    for (const auto *Block : *Graph) {
+      for (const auto &Element : *Block)
+        if (auto Dtor = Element.getAs<CFGObjC3CarrierDtor>()) {
+          ++CarrierCleanups;
+          EXPECT_EQ(CFGElement::ObjC3CarrierDtor, Element.getKind());
+          SmallVector<const CXXDestructorDecl *, 2> Destructors;
+          Dtor->getPossibleDestructors(Destructors);
+          ASSERT_EQ(1u, Destructors.size());
+          EXPECT_EQ("~Payload", Destructors.front()->getNameAsString());
+        }
+      if (isa_and_nonnull<ObjC3CarrierTransferExpr>(Block->getTerminatorStmt()))
+        ++CarrierBranches;
+    }
+    EXPECT_GT(CarrierCleanups, 0u);
+    EXPECT_EQ(1u, CarrierBranches);
+  }
+  EXPECT_EQ(2u, Cases);
+  EXPECT_EQ(2u, Messages->Errors);
+}
+TEST(ObjC3ConditionCFG, CheckedInitializerFailureDestroysOnlyCompletedLocals) {
+  auto AST = tooling::buildASTFromCodeWithArgs(
