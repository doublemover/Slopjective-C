diff --git a/clang/test/ObjC3/Parser/optional-access.mm b/clang/test/ObjC3/Parser/optional-access.mm
new file mode 100644
index 000000000..b9d2008b1
--- /dev/null
+++ b/clang/test/ObjC3/Parser/optional-access.mm
@@ -0,0 +1,65 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -ast-print %s > %t.mm
+// RUN: FileCheck %s --check-prefix=PRINT < %t.mm
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fsyntax-only %t.mm
+// expected-no-diagnostics
+
+@interface Receiver
+@property(readonly) Receiver * _Nonnull next;
+@property(readonly) void (^ _Nonnull callback)(void);
+- (id _Nonnull)take:(id)value other:(id)other;
+- (void)record:(int)value;
+@end
+Receiver *source();
+id argument();
+
+id native_chain(Receiver * _Nullable receiver) {
+  id first = receiver?.next?.next;
+  id result = [source()? take:argument() other:argument()];
+  [receiver? record:3];
+  (void)receiver?.callback;
+  return result ?? first;
+}
+
+id ordinary_conditionals(bool condition, Receiver *first, Receiver *second) {
+  id result = [condition ? first : second take:argument() other:argument()];
+  result = [first ? first : second next];
+  result = [first ? first : (Receiver *)0 next];
+  return [(first ? first : second)? take:result other:argument()];
+}
+
+id parenthesized_receivers(Receiver *receiver) {
+  id result = (receiver)?.next;
+  result = ((receiver))?.next;
+  result = (argument(), receiver)?.next;
+  (void)(receiver)?.callback;
+  return [(receiver)? take:result other:argument()];
+}
+
+template<class T> auto dependent_member(T source) { return source?.next; }
+template<class T> auto dependent_parenthesized(T source) {
+  return (source)?.next;
+}
+template<class T> auto dependent_message(T source) {
+  return [source? take:argument() other:argument()];
+}
+void instantiate(Receiver *receiver) {
+  (void)dependent_member(receiver);
+  (void)dependent_parenthesized(receiver);
+  (void)dependent_message(receiver);
+}
+
+#define OPTIONAL_MEMBER ?.
+#define OPTIONAL_SEND ?
+id macro_punctuation(Receiver *receiver) {
+  return [receiver OPTIONAL_SEND take:receiver OPTIONAL_MEMBER next other:argument()];
+}
+id escaped_optional_member(Receiver *receiver) {
+  return receiver ?\
+.next;
+}
+
+// PRINT: (receiver)?.next)?.next
+// PRINT: [(source())? take:argument() other:argument()]
+// PRINT: [(receiver)? record:3]
diff --git a/clang/test/ObjC3/Sema/carrier-source-records.mm b/clang/test/ObjC3/Sema/carrier-source-records.mm
new file mode 100644
index 000000000..2f2e8ac82
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-source-records.mm
@@ -0,0 +1,80 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+struct Leaf {
+  explicit Leaf(int);
+  Leaf(const Leaf &);
+  Leaf(Leaf &&) noexcept;
+  ~Leaf() noexcept;
+};
+using Inner = __objc3_optional(Leaf);
+using Outer = __objc3_optional(Inner);
+using Field = __objc3_result(Outer, Inner);
+
+struct Owner {
+  Field field;
+  Inner second;
+  Owner(int value)
+      : field(__objc3_ok(Outer, Inner,
+                         __objc3_some(Inner, __objc3_some(Leaf, Leaf(value))))),
+        second(__objc3_none(Leaf)) {}
+};
+static_assert(__is_constructible(Owner, const Owner &));
+static_assert(__is_constructible(Owner, Owner &&));
+static_assert(!__is_constructible(Owner));
+static_assert(!__is_trivially_copyable(Owner));
+static_assert(!__is_trivially_constructible(Owner, const Owner &));
+static_assert(!__is_trivially_constructible(Owner, Owner &&));
+static_assert(!__is_trivially_destructible(Owner));
+static_assert(!__is_nothrow_constructible(Owner, const Owner &));
+static_assert(__is_nothrow_constructible(Owner, Owner &&));
+static_assert(__is_nothrow_destructible(Owner));
+static_assert(!__is_assignable(Owner &, const Owner &));
+static_assert(!__is_assignable(Owner &, Owner &&));
+
+struct Initialized {
+  Inner field = __objc3_none(Leaf);
+};
+struct Aggregate { Inner first, second; };
+static_assert(__is_constructible(Initialized));
+static_assert(!__is_constructible(Aggregate));
+void field_initializers(Inner &source) {
+  Aggregate first{__objc3_some(Leaf, Leaf(1)), __objc3_none(Leaf)};
+  Aggregate copied{source, first.first};
+  Aggregate moved{static_cast<Inner &&>(source), __objc3_none(Leaf)};
+  Initialized initialized;
+}
+
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete;
+  MoveOnly(MoveOnly &&) noexcept;
+  ~MoveOnly();
+};
+struct MoveOwner { __objc3_optional(MoveOnly) field; };
+static_assert(!__is_constructible(MoveOwner, const MoveOwner &));
+static_assert(__is_constructible(MoveOwner, MoveOwner &&));
+
+struct NonConstCopy {
+  NonConstCopy(NonConstCopy &);
+  ~NonConstCopy();
+};
+struct NonConstOwner { __objc3_optional(NonConstCopy) field; };
+static_assert(__is_constructible(NonConstOwner, NonConstOwner &));
+static_assert(!__is_constructible(NonConstOwner, const NonConstOwner &));
+
+struct ThrowingDtor { ~ThrowingDtor() noexcept(false); };
+struct ThrowingOwner { __objc3_optional(ThrowingDtor) field; };
+static_assert(!__is_nothrow_destructible(ThrowingOwner));
+
+class PrivateDtor { ~PrivateDtor(); };
+struct PrivateOwner { __objc3_optional(PrivateDtor) field; };
+static_assert(!__is_destructible(PrivateOwner));
+static_assert(!__is_constructible(PrivateOwner, const PrivateOwner &));
+
+template <class T> struct GenericOwner {
+  __objc3_optional(T) field;
+};
+static_assert(__is_constructible(GenericOwner<Leaf>, const GenericOwner<Leaf> &));
+static_assert(!__is_constructible(GenericOwner<MoveOnly>,
+                                  const GenericOwner<MoveOnly> &));
diff --git a/clang/test/ObjC3/Sema/error-factory-contract.m b/clang/test/ObjC3/Sema/error-factory-contract.m
new file mode 100644
index 000000000..cbabc751b
--- /dev/null
+++ b/clang/test/ObjC3/Sema/error-factory-contract.m
@@ -0,0 +1,36 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=compatibility -fsyntax-only -verify=compat %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc3-profile=strict-system -fsyntax-only -verify=strict %s
+// compat-no-diagnostics
+@protocol Error @end
+@protocol MoreError <Error> @end
+__attribute__((objc_root_class)) @interface Good <Error> @end
+@interface Derived : Good @end
+__attribute__((objc_root_class)) @interface Bad @end
+@interface Bad (ErrorAdoption) <Error> @end
+__attribute__((objc_root_class)) @interface Wrong @end
+
+id<Error> good(id<Error> value) { return __builtin_objc3_checked_error(value); }
+id<MoreError> refined(id<MoreError> value) { return __builtin_objc3_checked_error(value); }
+Good *concrete(Good *value) { return __builtin_objc3_checked_error(value); }
+Derived *inherited(Derived *value) { return __builtin_objc3_checked_error(value); }
+Bad *category(Bad *value) { return __builtin_objc3_checked_error(value); }
+int integer(int value) {
+  return __builtin_objc3_checked_error(value); // strict-error {{must conform to Objective-C protocol 'Error'}}
+}
+id unbounded(id value) {
+  return __builtin_objc3_checked_error(value); // strict-error {{must conform to Objective-C protocol 'Error'}}
+}
+Wrong *nonconforming(Wrong *value) {
+  return __builtin_objc3_checked_error(value); // strict-error {{must conform to Objective-C protocol 'Error'}}
+}
+int evaluated_once(int *calls) {
+  // This compile-only compatibility case is also an AST identity check: there
+  // must be no residual runtime builtin call or eager second evaluation.
+#if __OBJC3_PROFILE__ == 0
+  return __builtin_objc3_checked_error(++*calls);
+#else
+  return ++*calls;
+#endif
+}
diff --git a/clang/test/ObjC3/Sema/error-factory-template.mm b/clang/test/ObjC3/Sema/error-factory-template.mm
