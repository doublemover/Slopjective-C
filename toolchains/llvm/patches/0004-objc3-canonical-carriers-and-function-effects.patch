+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+__attribute__((objc_root_class))
+@interface NarrowPathRoot
+@property(nonatomic) int count;
+@end
+
+// Signature/application support needs only the compiler-known opaque metadata
+// tag. A later real header definition must merge with that exact forward tag.
+WritableKeyPath<NarrowPathRoot *, int> make_writable(void);
+KeyPath<NarrowPathRoot *, int> narrow_return(void) {
+  return make_writable();
+}
+static int consume(KeyPath<NarrowPathRoot *, int> path,
+                    NarrowPathRoot * _Nonnull root) {
+  return KeyPathGet(path, root);
+}
+int narrow_call_and_assignment(NarrowPathRoot * _Nonnull root,
+    const WritableKeyPath<NarrowPathRoot *, int> source) {
+  KeyPath<NarrowPathRoot *, int> local = source;
+  local = make_writable();
+  return consume(make_writable(), root) + KeyPathGet(local, root);
+}
+
+#include "../Inputs/keypath-abi.h"
+WritableKeyPath<NarrowPathRoot *, int> make_writable(void) {
+  return @keypath(NarrowPathRoot, count);
+}
