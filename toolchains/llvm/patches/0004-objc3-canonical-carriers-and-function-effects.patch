index 000000000..d3dacc3b0
--- /dev/null
+++ b/clang/test/ObjC3/AST/Inputs/condition-module/conditions.h
@@ -0,0 +1,21 @@
+#ifndef OBJC3_CONDITION_MODULE_H
+#define OBJC3_CONDITION_MODULE_H
+
+typedef Optional(int) ModuleMaybe;
+
+static inline int imported_guard(ModuleMaybe source, bool enabled) {
+  guard let first = source, enabled,
+        var second = Some(int, first + 1) else { return -1; }
+  second += first;
+  return second;
+}
+
+static inline int imported_if(ModuleMaybe source) {
+  if let first = source, second = Some(int, first + 1) {
+    return first + second;
+  } else {
+    return 0;
+  }
+}
+
+#endif
