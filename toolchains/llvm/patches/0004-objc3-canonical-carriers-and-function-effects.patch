+using Alias = E;
+using Different = id<Other>;
+struct Base {
+  virtual int exact() __objc3_throws(E); // expected-note 2 {{overridden virtual function is here}}
+  virtual int untyped() __objc3_throws; // expected-note {{overridden virtual function is here}}
+  virtual int plain(); // expected-note {{overridden virtual function is here}}
