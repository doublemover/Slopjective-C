diff --git a/clang/test/ObjC3/Sema/typed-keypath-nullable-traversal.m b/clang/test/ObjC3/Sema/typed-keypath-nullable-traversal.m
new file mode 100644
index 000000000..b358f00b4
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-nullable-traversal.m
@@ -0,0 +1,43 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-arc -fsyntax-only -verify %s
+#include "../Inputs/keypath-abi.h"
+typedef int (^ _Nullable NullablePathBlock)(void);
+typedef struct NullablePathPair { long first, second; } NullablePathPair;
+__attribute__((objc_root_class))
+@interface NullablePathNode
+@property(nonatomic, strong) NullablePathNode * _Nullable next;
+@property(nonatomic, strong) NullablePathNode * _Nullable value;
+@property(nonatomic, strong) NullablePathNode * _Nonnull required;
+@property(nonatomic, copy) NullablePathBlock callback;
+@property(nonatomic, readonly) NullablePathNode * _Nullable observed;
+@property(nonatomic) long count;
+@property(nonatomic) NullablePathPair pair;
+@end
+KeyPath<NullablePathNode *, NullablePathNode * _Nullable> nullable_path(void) {
+  return @keypath(NullablePathNode, next.next.value);
+}
+KeyPath<NullablePathNode *, NullablePathBlock> nullable_block_path(void) {
+  return @keypath(NullablePathNode, next.callback);
+}
+NullablePathNode * _Nullable apply(NullablePathNode * _Nonnull root) {
+  return KeyPathGet(nullable_path(), root);
+}
+WritableKeyPath<NullablePathNode *, NullablePathNode * _Nullable> nullable_write_path(void) {
+  return @keypath(NullablePathNode, next.next.value);
+}
+void valid_nullable_writes(NullablePathNode * _Nonnull root) {
+  KeyPathSet(@keypath(NullablePathNode, next.value), root, root);
+  root[nullable_write_path()] = root;
+  KeyPathSet(@keypath(NullablePathNode, next.callback), root, (NullablePathBlock)0);
+}
+void invalid_nullable_paths(NullablePathNode * _Nonnull root) {
+  KeyPath<NullablePathNode *, NullablePathNode * _Nullable> read = nullable_write_path();
+  KeyPathSet(read, root, root); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(@keypath(NullablePathNode, next.observed), root, root); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(@keypath(NullablePathNode, observed.value), root, root); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  (void)@keypath(NullablePathNode, next.required); // expected-error {{nullable intermediate key-path traversal requires a final nullable Objective-C object or Block value}}
+  (void)@keypath(NullablePathNode, next.count); // expected-error {{nullable intermediate key-path traversal requires a final nullable Objective-C object or Block value}}
+  (void)@keypath(NullablePathNode, next.pair); // expected-error {{nullable intermediate key-path traversal requires a final nullable Objective-C object or Block value}}
+  (void)@keypath(NullablePathNode, next.pair.first); // expected-error {{nullable intermediate key-path traversal requires a final nullable Objective-C object or Block value}}
+}
