diff --git a/clang/test/ObjC3/Sema/typed-keypaths.m b/clang/test/ObjC3/Sema/typed-keypaths.m
new file mode 100644
index 000000000..2ab3c034f
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypaths.m
@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+
+#include "../Inputs/keypath-abi.h"
+__attribute__((objc_root_class))
+@interface PathNode
+@property(nonatomic) int count;
+@property(nonatomic, readonly) int identity;
+@property(nonatomic, strong) PathNode * _Nonnull child;
+@property(nonatomic, strong) PathNode * _Nullable optionalChild;
+@end
+__attribute__((objc_root_class))
+@interface OtherNode
+@end
+
+WritableKeyPath<PathNode *, int> count_path(void) {
+  return @keypath(PathNode, count);
+}
+KeyPath<PathNode *, int> readonly_path(void) {
+  return KeyPathAsReadOnly(count_path());
+}
+KeyPath<PathNode *, int> identity_path(void) {
+  return @keypath(PathNode, identity);
+}
+void applications(PathNode * _Nonnull root, PathNode * _Nullable maybe,
+                  OtherNode * _Nonnull other) {
+  WritableKeyPath<PathNode *, int> kp = @keypath(PathNode, child.count);
+  int value = KeyPathGet(kp, root);
+  KeyPathSet(kp, root, value + 1);
+  const objc3_keypath_descriptor_v2 *metadata = KeyPathMetadata(kp);
+  (void)metadata;
+  (void)KeyPathGet(kp, other); // expected-error {{key-path application root has an incompatible class type}}
+  (void)KeyPathGet(kp, maybe); // expected-error {{key-path application requires a nonnull root}}
+  (void)KeyPathGet(42, root); // expected-error {{key-path application requires a typed key-path value}}
+  KeyPathSet(identity_path(), root, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(KeyPathAsReadOnly(kp), root, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(@keypath(PathNode, child), root, maybe); // expected-error {{key-path setter requires a nonnull property value}}
+  (void)@keypath(PathNode, absent); // expected-error {{key-path component must name a visible declared instance property}}
+  (void)@keypath(PathNode, count.child); // expected-error {{key-path intermediate component must have a concrete object or supported record type}}
+  (void)@keypath(PathNode, optionalChild.count); // expected-error {{nullable intermediate key-path traversal requires a final nullable Objective-C object or Block value}}
+  (void)@keypath(int, count); // expected-error {{key-path root must name a concrete Objective-C class}}
+  (void)@keypath(self, count); // expected-error {{@keypath(self, ...) requires an instance method}}
+}
+
+@interface PathNode (Path)
+- (WritableKeyPath<PathNode *, int>)selfPath;
+@end
+@implementation PathNode (Path)
+- (WritableKeyPath<PathNode *, int>)selfPath {
+  return @keypath(self, count);
+}
+@end
