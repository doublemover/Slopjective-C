+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fsyntax-only -verify %s
+@protocol Error @end
+@protocol Other @end
+typedef id<Error> E;
+typedef E Alias;
+@protocol Checked
+- (int)value:(int)x __objc3_throws(E); // expected-note {{previous declaration}}
+@end
+__attribute__((objc_root_class)) @interface Receiver
+- (int)value:(int)x __objc3_throws(E); // expected-note {{previous declaration}}
++ (void)classValue __objc3_throws;
+@end
+@interface Good : Receiver
+- (int)value:(int)x __objc3_throws(Alias);
+@end
+@interface Bad : Receiver
+- (int)value:(int)x; // expected-error {{effects of method 'value:' do not match}}
+@end
+__attribute__((objc_root_class)) @interface BadProtocol <Checked>
+- (int)value:(int)x __objc3_throws(id<Other>); // expected-error {{effects of method 'value:' do not match}}
+@end
+@implementation Receiver
+- (int)value:(int)x __objc3_throws(E) {
+  if (x) { E error = (E)0; __objc3_throw(error); }
+  return 0;
+}
++ (void)classValue __objc3_throws { return; }
+@end
+int propagate(Receiver *r) __objc3_throws(E) { return __objc3_try([r value:0]); }
+void wrong(Receiver *r) { __objc3_try([r value:0]); } // expected-error {{requires a matching throwing function}}
