+//===--- ParseObjC3KeyPath.cpp - Native typed key paths --------------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/Parse/Parser.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+TypeResult Parser::ParseObjC3KeyPathType(SourceLocation &EndLoc) {
+  const bool Writable = Tok.getIdentifierInfo()->isStr("WritableKeyPath");
+  SourceLocation KeywordLoc = ConsumeToken();
+  if (Tok.isNot(tok::less)) {
+    Diag(Tok, diag::err_expected) << tok::less;
+    return TypeError();
+  }
+  SourceLocation LAngleLoc = ConsumeToken();
+  GreaterThanIsOperatorScope GreaterThan(GreaterThanIsOperator, false);
+  TypeResult Root = ParseTypeName();
+  if (Root.isInvalid())
+    return TypeError();
+  if (ExpectAndConsume(tok::comma))
+    return TypeError();
+  TypeResult Value = ParseTypeName();
+  if (Value.isInvalid() ||
+      ParseGreaterThanInTemplateList(LAngleLoc, EndLoc,
+                                    /*ConsumeLastToken=*/true,
+                                    /*ObjCGenericList=*/true))
+    return TypeError();
+  return Actions.ActOnObjC3KeyPathType(Writable, Root.get(), Value.get(),
+                                       KeywordLoc);
+}
+
+ExprResult Parser::ParseObjC3KeyPathLiteral(SourceLocation AtLoc) {
+  ConsumeToken(); // keypath
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, "@keypath"))
+    return ExprError();
+
+  ParsedType Root;
+  const bool SelfRoot = Tok.is(tok::identifier) &&
+                        Tok.getIdentifierInfo()->isStr("self");
+  if (SelfRoot) {
+    ConsumeToken();
+  } else {
+    TypeResult Type = ParseTypeName();
+    if (Type.isInvalid()) {
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    Root = Type.get();
+  }
+  if (ExpectAndConsume(tok::comma)) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+
+  SmallVector<IdentifierInfo *, 4> Members;
+  SmallVector<SourceLocation, 4> MemberLocs;
+  do {
+    if (!Members.empty())
+      ConsumeToken(); // period
+    if (Tok.isNot(tok::identifier)) {
+      Diag(Tok, diag::err_expected) << tok::identifier;
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    Members.push_back(Tok.getIdentifierInfo());
+    MemberLocs.push_back(ConsumeToken());
+  } while (Tok.is(tok::period));
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3KeyPathLiteral(
+      Root, SelfRoot, Members, MemberLocs, AtLoc, Parens.getCloseLocation());
+}
+
+ExprResult Parser::ParseObjC3KeyPathApplication() {
+  IdentifierInfo *Operation = Tok.getIdentifierInfo();
+  SourceLocation KeywordLoc = ConsumeToken();
+  const unsigned Kind = Operation->isStr("KeyPathGet") ? 0
+                      : Operation->isStr("KeyPathSet") ? 1
+                      : Operation->isStr("KeyPathMetadata") ? 2
+                      : Operation->isStr("KeyPathAsReadOnly") ? 3 : 4;
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after,
+                              Operation->getNameStart()))
+    return ExprError();
+  SmallVector<Expr *, 3> Args;
+  const unsigned Count = Kind == 0 ? 2 : Kind == 1 ? 3 : 1;
+  for (unsigned I = 0; I < Count; ++I) {
+    if (I && ExpectAndConsume(tok::comma)) {
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    ExprResult Arg = ParseAssignmentExpression();
+    if (Arg.isInvalid()) {
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    Args.push_back(Arg.get());
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3KeyPathApplication(
+      Kind, Args, KeywordLoc, Parens.getCloseLocation());
+}
