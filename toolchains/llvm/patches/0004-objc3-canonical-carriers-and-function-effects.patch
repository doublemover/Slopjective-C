+#include "Inputs/typed-keypath-subscripts.h"
+void ordered_operands(IndexNode *_Nonnull root,WritableKeyPath<IndexNode*,int> path,
+    KeyPath<IndexNode*,int> read,int i) {
+  (void)KeyPathGet((i++,read),(i++,root));
+  KeyPathSet((i++,path),(i++,root),i++);
+  root[(i++,path)]=i++;
+  root[(i++,path)]+=i++;
+  (void)KeyPathGet(((void)(i++ + i),read),root); // expected-warning {{unsequenced modification and access to 'i'}}
+  root[path]=i++ + i; // expected-warning {{unsequenced modification and access to 'i'}}
+  (void)(root[(i++,read)]+i); // expected-warning {{unsequenced modification and access to 'i'}}
+}
