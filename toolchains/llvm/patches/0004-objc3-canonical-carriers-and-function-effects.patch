+}
+@end
+__attribute__((objc_root_class)) @interface NonReleasingOwner
+- (void)release __attribute__((objc_method_family(none)));
+@end
+void no_family_effect(NonReleasingOwner *_Nonnull owner) {
+  const char *pointer=manual_bytes(owner);
+  [owner release];
+  manual_use(pointer);
+}
+#ifdef __cplusplus
+void nested_lambda(ManualOwner *_Nonnull owner) {
