+#ifndef OBJC3_OPTIONAL_COALESCING_PCH_H
+#define OBJC3_OPTIONAL_COALESCING_PCH_H
+typedef Optional(int) CoalescingMaybe;
+inline int pch_coalesce(CoalescingMaybe source, CoalescingMaybe other) {
+  return source ?? other ?? 42;
+}
+template <class T, class U> auto pch_dependent_coalesce(T source, U other) {
+  return source ?? other;
+}
+#define OBJC3_PCH_COALESCE ??
