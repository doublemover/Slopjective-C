+TEST(ObjC3Conditions, BuildsOwnedSnapshotsAndPreservesTaggedNullablePayloads) {
+  for (const char *Standard : {"c17", "c++20", "c++23"}) {
+    for (bool ARC : {false, true}) {
+      SCOPED_TRACE(Standard);
+      SCOPED_TRACE(ARC);
+      std::vector<std::string> Args = {
+          "-x", Standard[1] == '+' ? "objective-c++" : "objective-c",
+          std::string("-std=") + Standard, "-fobjc-version=3",
+          "-fobjc-runtime=gnustep-2.2", "-Wno-nullability-completeness"};
+      if (ARC) Args.push_back("-fobjc-arc");
+      auto AST = tooling::buildASTFromCodeWithArgs(R"(
+        typedef __objc3_optional(int) MaybeInt;
+        typedef __objc3_optional(id _Nullable) MaybeReference;
+        void test(MaybeInt scalar, id _Nullable reference, MaybeReference tagged) {}
+      )", Args, "binding-semantics.m");
+      ASSERT_TRUE(AST);
+      ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+      FunctionDecl *Function = nullptr;
+      for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+        if (auto *FD = dyn_cast<FunctionDecl>(D)) Function = FD;
+      ASSERT_TRUE(Function);
+      Sema &S = AST->getSema();
+      Sema::SynthesizedFunctionScope Scope(S, Function);
+      ASTContext &C = AST->getASTContext();
+      for (unsigned I = 0; I != 3; ++I) {
+        auto *Parameter = Function->getParamDecl(I);
+        SourceLocation Loc = Parameter->getLocation();
+        Expr *Source = S.BuildDeclRefExpr(Parameter, Parameter->getType(),
+                                           VK_LValue, Loc);
+        for (bool Mutable : {false, true}) {
+          auto &Name = C.Idents.get(Mutable ? "mutableValue" : "immutableValue");
+          StmtResult Result = S.ActOnObjC3BindingCondition(
+              nullptr, &Name, Loc, Mutable, Loc, Loc, Source);
+          ASSERT_FALSE(Result.isInvalid());
+          auto *Binding = cast<ObjC3BindingCondition>(Result.get());
+          auto *Snapshot = Binding->getSnapshotDecl();
+          EXPECT_TRUE(Snapshot->isImplicit());
+          EXPECT_EQ(nullptr, Snapshot->getIdentifier());
+          EXPECT_TRUE(Snapshot->hasInit());
+          EXPECT_TRUE(Snapshot->getType().isConstQualified());
+          auto *Variable = Binding->getBindingDecl();
+          EXPECT_EQ(!Mutable, Variable->getType().isConstQualified());
+          EXPECT_TRUE(Variable->hasInit());
+          if (I == 0) {
+            EXPECT_TRUE(Variable->getType()->isIntegerType());
+          } else {
+            EXPECT_TRUE(Variable->getType()->isObjCRetainableType());
+            EXPECT_EQ(I == 1 ? NullabilityKind::NonNull : NullabilityKind::Nullable,
+                      Variable->getType()->getNullability());
+            EXPECT_EQ(ARC ? Qualifiers::OCL_Strong : Qualifiers::OCL_None,
+                      Variable->getType().getObjCLifetime());
+            if (I == 1 && ARC)
+              EXPECT_EQ(Qualifiers::OCL_Strong,
+                        Snapshot->getType().getObjCLifetime());
+          }
+        }
+      }
+      ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    }
+  }
+}
