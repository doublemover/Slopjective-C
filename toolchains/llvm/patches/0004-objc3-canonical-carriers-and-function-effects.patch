+    TypeResult ParsedErrorType = ParseTypeName(&PayloadRange);
+    if (ParsedErrorType.isInvalid()) {
+      Diag(EffectLoc, diag::err_objc3_invalid_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    if (Tok.is(tok::comma)) {
+      Diag(Tok, diag::err_objc3_invalid_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    if (!Tok.is(tok::r_paren)) {
+      Diag(Tok, diag::err_objc3_unterminated_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    Payload.consumeClose();
+    ThrowsKind = 2; // ObjC3ThrowsKind::Typed
+    ErrorType = ParsedErrorType.get();
+    Actions.GetTypeFromParser(ErrorType, &ErrorTypeInfo);
+  }
