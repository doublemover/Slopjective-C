--- /dev/null
+++ b/clang/test/ObjC3/Sema/resource-ownership.m
@@ -0,0 +1,65 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+void close_handle(int);
+int close_status(int);
+void close_address(int *);
+void close_pointer(void *);
+void close_pointer_address(void **);
+void wrong_close(long *);
+void cleanup_handle(int *);
+int sentinel(void);
+void valid(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=-1))) = 1;
+  int addressed __attribute__((objc_resource(close=close_address, invalid=0))) = 2;
+  int status __attribute__((objc_resource(close=close_status, invalid=0))) = 3;
+  void *pointer __attribute__((objc_resource(close=close_pointer, invalid=0))) = 0;
+  void *pointer_address __attribute__((objc_resource(close=close_pointer_address, invalid=0))) = 0;
+  volatile int qualified __attribute__((objc_resource(close=close_status, invalid=0))) = 4;
+}
+int global __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{only applies to local variables}}
+struct ResourceField {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))); // expected-error {{only applies to local variables}}
+};
+void invalid_handles(void) {
+  const int immutable __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+  float floating __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+  id managed __attribute__((objc_resource(close=close_pointer, invalid=0))) = (id)0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+}
+typedef void *RetainableHandle __attribute__((NSObject));
+void close_retainable(RetainableHandle);
+void retainable_family_is_not_a_scalar_resource(void) {
+  RetainableHandle value __attribute__((objc_resource(close=close_retainable, invalid=0))) = 0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+#if __has_feature(objc_arc)
+  __weak RetainableHandle weak_value __attribute__((objc_resource(close=close_retainable, invalid=0))) = 0; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}} expected-warning {{'__weak' only applies to Objective-C object or block pointer types}}
+#endif
+}
+void incompatible_close(void) {
+  int value __attribute__((objc_resource(close=wrong_close, invalid=0))) = 1; // expected-error {{cannot accept the handle value or its address}}
+}
+void runtime_sentinel(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=sentinel()))) = 1; // expected-error {{invalid sentinel must be constant}}
+}
+void needs_initializer(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))); // expected-error {{requires an initializer}}
+}
+void duplicate_resource(void) {
+  int value __attribute__((objc_resource(close=close_handle, invalid=0), objc_resource(close=close_handle, invalid=-1))) = 1; // expected-error {{may have only one objc_resource attribute}}
+}
+void jump_into_resource(void) {
+  goto after; // expected-error {{cannot jump from this goto statement to its label}}
+  int value __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-note {{jump bypasses initialization of a variable with objc_resource}}
+after:;
+}
+void switch_into_resource(int choice) {
+  switch(choice) {
+  case 0:;
+    int value __attribute__((objc_resource(close=close_handle, invalid=0))) = 1; // expected-note {{jump bypasses initialization of a variable with objc_resource}}
+  case 1:; // expected-error {{cannot jump from switch statement to this case label}}
+  }
+}
+#ifdef __cplusplus
+template<class T> void dependent_handle(void) {
+  T value __attribute__((objc_resource(close=close_handle, invalid=0))) = {}; // expected-error {{requires a mutable nondependent integer, enum, or ordinary pointer handle}}
+}
+#endif
