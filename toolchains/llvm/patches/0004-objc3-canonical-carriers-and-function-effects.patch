diff --git a/clang/test/ObjC3/Parser/guard-lookahead.mm b/clang/test/ObjC3/Parser/guard-lookahead.mm
new file mode 100644
index 000000000..1af590702
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-lookahead.mm
@@ -0,0 +1,48 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+template <class T, class U> bool predicate(T value, U other) {
+  return value == other;
+}
+struct Truth {
+  bool value;
+  bool get() const { return value; }
+};
+struct Obj;
+@interface Receiver
+- (bool)check:(int)value other:(int)other;
+@end
+
+void nested_delimiters(Receiver *receiver, bool flag) {
+  guard ([&] {
+    if (flag) { return true; } else { return false; }
+  }()), predicate<int, int>(1, 1), Truth{flag}.get(),
+  [receiver check:1 other:2] else { return; }
+
+  guard ({ bool local = flag; if (!flag) local = true; local; }) else {
+    return;
+  }
+  guard []() -> bool {
+    int values[2] = {1, 2};
+    return values[0] < values[1];
+  }() else { return; }
+}
+
+bool guard(bool);
+void ordinary_calls_stop_at_semicolon(bool flag) {
+  guard([&] { if (flag) return true; else return false; }());
+  if (flag) {
+    guard(flag);
+  } else {
+    guard(false);
+  }
+}
+
+// Template commas and a braced initializer are parsed by the ordinary
+// expression parser after lookahead identifies the outer else.
+void bound_template_expressions() {
+  guard let value = Some(int, predicate<int, int>(1, 1)),
+        another = Some(int, Truth{true}.get()) else { return; }
+  (void)value;
+  (void)another;
+}
