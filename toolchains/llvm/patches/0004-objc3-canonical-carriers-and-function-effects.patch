+  // payload destructors in the user's access context, including empty/inactive
+  // arms, without binding a stored member as a full-expression temporary.
+  for (FieldDecl *Field : {Info.ValueField, Info.SuccessField, Info.ErrorField}) {
+    if (!Field)
+      continue;
+    QualType Payload = Field->getType();
+    CXXRecordDecl *RD = Payload->getAsCXXRecordDecl();
+    if (!RD || RD->isDependentContext())
+      continue;
+    CXXDestructorDecl *Dtor = S.LookupDestructor(RD);
+    if (!Dtor) {
+      VD->setInvalidDecl();
+      continue;
+    }
+    S.CheckDestructorAccess(VD->getLocation(), Dtor,
+                            S.PDiag(diag::err_access_dtor_var)
+                                << VD->getDeclName() << Payload);
+    S.MarkFunctionReferenced(VD->getLocation(), Dtor);
+    if (S.DiagnoseUseOfDecl(Dtor, VD->getLocation()))
+      VD->setInvalidDecl();
+  }
