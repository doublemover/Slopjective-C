+//===--- ObjC3Resources.cpp - Native resource operation AST ---------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+
+using namespace clang;
+
+ObjC3ResourceExpr::ObjC3ResourceExpr(
+    Kind Operation, QualType ResultType, Expr *Operand, Expr *Replacement,
+    SourceLocation BuiltinLoc, SourceLocation RParenLoc)
+    : Expr(ObjC3ResourceExprClass, ResultType, VK_PRValue, OK_Ordinary),
+      Operation(Operation), Operands{Operand, Replacement},
+      BuiltinLoc(BuiltinLoc), RParenLoc(RParenLoc) {
+  setDependence(toExprDependenceForImpliedType(ResultType->getDependence()) |
+                Operand->getDependence() |
+                (Replacement ? Replacement->getDependence()
+                             : ExprDependence::None));
+}
+
+ObjC3ResourceExpr *ObjC3ResourceExpr::Create(
+    ASTContext &Context, Kind Operation, QualType ResultType, Expr *Operand,
+    Expr *Replacement, SourceLocation BuiltinLoc, SourceLocation RParenLoc) {
+  return new (Context) ObjC3ResourceExpr(Operation, ResultType, Operand,
+                                         Replacement, BuiltinLoc, RParenLoc);
+}
+
+const VarDecl *ObjC3ResourceExpr::getResourceVariable() const {
+  const auto *Reference =
+      dyn_cast<DeclRefExpr>(getOperand()->IgnoreParenImpCasts());
+  return Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+}
