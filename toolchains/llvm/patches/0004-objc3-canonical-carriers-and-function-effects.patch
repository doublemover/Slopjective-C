+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+using OptionalInt = __objc3_optional(int);
+using OptionalIntAlias = __objc3_optional(int);
+using IntLongResult = __objc3_result(int, long);
+using LongIntResult = __objc3_result(long, int);
+
+int nonthrowing_value() noexcept;
+int potentially_throwing_value();
+
+static_assert(__is_same(decltype(__objc3_some(int, 0)), OptionalInt));
+static_assert(__is_same(decltype(__objc3_ok(int, long, 0)), IntLongResult));
+static_assert(!__is_same(IntLongResult, LongIntResult));
+static_assert(noexcept(__objc3_none(int)));
+static_assert(noexcept(__objc3_some(int, nonthrowing_value())));
+static_assert(!noexcept(__objc3_some(int, potentially_throwing_value())));
+static_assert(noexcept(__objc3_has_value(__objc3_none(int))));
+static_assert(noexcept(__objc3_is_ok(__objc3_ok(int, long, 0))));
+static_assert(noexcept(__objc3_ok(int, long, nonthrowing_value())));
+static_assert(!noexcept(__objc3_err(int, long, potentially_throwing_value())));
+
+static_assert(__is_same(decltype(false ? __objc3_some(int, 0)
+                                      : __objc3_none(int)),
+                        OptionalIntAlias));
+static_assert(__is_same(decltype(false ? __objc3_ok(int, long, 0)
+                                      : __objc3_err(int, long, 0L)),
+                        IntLongResult));
+
+template <class T> using Optional = __objc3_optional(T);
+template <class T> auto select_optional(bool choose, T value) {
+  return choose ? __objc3_some(T, value) : __objc3_none(T);
