+        secondCalls != ZERO_SECOND || filters != EXPECTED_FILTERS || badOrder) return 2;
+    reset();
+    if (exercise(&some, &none) != -1 || firstCalls != 1 ||
+        secondCalls != 1 || filters != EXPECTED_FILTERS || badOrder) return 3;
+    some = __objc3_some(int, 2);
