diff --git a/clang/unittests/ASTMatchers/ObjC3MatchersTest.cpp b/clang/unittests/ASTMatchers/ObjC3MatchersTest.cpp
new file mode 100644
index 000000000..6dcb1f806
--- /dev/null
+++ b/clang/unittests/ASTMatchers/ObjC3MatchersTest.cpp
@@ -0,0 +1,206 @@
+//===--- ObjC3MatchersTest.cpp - Native ObjC3 matcher consumers -----------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/ASTMatchers/ASTMatchFinder.h"
+#include "clang/ASTMatchers/ASTMatchers.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+
+using namespace clang;
+using namespace clang::ast_matchers;
+
+namespace {
+
+std::unique_ptr<ASTUnit> buildObjC3AST(StringRef Code) {
+  return tooling::buildASTFromCodeWithArgs(
+      Code, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-matchers.mm");
+}
+
+constexpr llvm::StringLiteral Conditions = R"(
+  using Maybe = Optional(int);
+  int conditions(Maybe source, bool enabled) {
+    guard let first = source, enabled else { return -1; }
+    if var second = source, second > first {
+      second += first;
+      return second;
+    } else {
+      return first;
+    }
+  }
+)";
+
+} // namespace
+
+TEST(ObjC3Matchers, PreservesOrderedConditionsAndUserBindingIdentity) {
+  auto AST = buildObjC3AST(Conditions);
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto Enabled = ignoringParenImpCasts(
+      declRefExpr(to(parmVarDecl(hasName("enabled")))));
+  auto Results = match(
+      objc3GuardStmt(
+          objc3ConditionCountIs(2),
+          hasObjC3Condition(
+              0, objc3BindingCondition(
+                     unless(isObjC3MutableBinding()),
+                     hasObjC3Binding(varDecl(hasName("first")).bind("binding")))
+                     .bind("condition")),
+          hasObjC3Condition(1, expr(Enabled)))
+          .bind("guard"),
+      AST->getASTContext());
+  ASSERT_EQ(1u, Results.size());
+  const auto *Condition =
+      Results.front().getNodeAs<ObjC3BindingCondition>("condition");
+  ASSERT_TRUE(Condition);
+  EXPECT_EQ(Condition->getBindingDecl(),
+            Results.front().getNodeAs<VarDecl>("binding"));
+  EXPECT_EQ(Condition,
+            Results.front().getNodeAs<ObjC3GuardStmt>("guard")->getCondition(0));
+  EXPECT_TRUE(match(objc3GuardStmt(hasObjC3Condition(2, stmt())),
+                    AST->getASTContext()).empty());
+  EXPECT_TRUE(match(objc3GuardStmt(objc3ConditionCountIs(1)),
+                    AST->getASTContext()).empty());
+  auto MutableSecond = objc3BindingCondition(
+      isObjC3MutableBinding(), hasObjC3Binding(varDecl(hasName("second"))));
+  EXPECT_EQ(1u, match(objc3IfBindingStmt(hasObjC3Condition(0, MutableSecond)),
+                      AST->getASTContext()).size());
+}
+
+TEST(ObjC3Matchers, BranchMatchersApplyToNativeConditionStatements) {
+  auto AST = buildObjC3AST(Conditions);
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  EXPECT_EQ(1u,
+            match(objc3GuardStmt(hasElse(compoundStmt(has(returnStmt())))),
+                  AST->getASTContext()).size());
+  EXPECT_EQ(1u,
+            match(objc3IfBindingStmt(
+                      hasThen(compoundStmt(hasDescendant(
+                          binaryOperator(hasOperatorName("+="))))),
+                      hasElse(compoundStmt(has(returnStmt())))),
+                  AST->getASTContext()).size());
+  auto WithoutElse = buildObjC3AST(R"(
+    void use(Optional(int) source) { if let value = source { (void)value; } }
+  )");
+  ASSERT_TRUE(WithoutElse);
+  ASSERT_FALSE(WithoutElse->getDiagnostics().hasErrorOccurred());
+  EXPECT_TRUE(match(objc3IfBindingStmt(hasElse(stmt())),
+                    WithoutElse->getASTContext()).empty());
+  // Existing IfStmt consumers retain the same matcher syntax.
+  auto Ordinary = tooling::buildASTFromCode("void f() { if (true) {} else {} }");
+  ASSERT_TRUE(Ordinary);
+  EXPECT_EQ(1u, match(ifStmt(hasThen(compoundStmt()), hasElse(compoundStmt())),
+                      Ordinary->getASTContext()).size());
+}
+
+TEST(ObjC3Matchers, SourceMatcherFindsWrittenSourceWithoutSnapshotNames) {
+  auto AST = buildObjC3AST(Conditions);
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto SourceParameter = declRefExpr(to(parmVarDecl(hasName("source"))));
+  auto SourceExpression = expr(anyOf(SourceParameter,
+                                     hasDescendant(SourceParameter)));
+  EXPECT_EQ(2u, match(objc3BindingCondition(hasObjC3Source(SourceExpression)),
+                      AST->getASTContext()).size());
+  EXPECT_TRUE(match(objc3BindingCondition(hasObjC3Binding(varDecl(isImplicit()))),
+                    AST->getASTContext()).empty());
+  EXPECT_EQ(2u,
+            match(traverse(TK_IgnoreUnlessSpelledInSource,
+                           declRefExpr(to(parmVarDecl(hasName("source"))))),
+                  AST->getASTContext()).size());
+  EXPECT_EQ(2u,
+            match(traverse(TK_IgnoreUnlessSpelledInSource,
+                           declRefExpr(to(parmVarDecl(hasName("source"))),
+                                       hasParent(objc3BindingCondition()))),
+                  AST->getASTContext()).size());
+  EXPECT_TRUE(match(declRefExpr(to(parmVarDecl(hasName("source"))),
+                                hasParent(objc3BindingCondition())),
+                    AST->getASTContext()).empty());
+  EXPECT_EQ(2u,
+            match(declRefExpr(to(parmVarDecl(hasName("source"))),
+                              hasAncestor(varDecl(isImplicit()))),
+                  AST->getASTContext()).size());
+  EXPECT_TRUE(match(traverse(TK_IgnoreUnlessSpelledInSource,
+                             declRefExpr(to(parmVarDecl(hasName("source"))),
+                                         hasAncestor(varDecl(isImplicit())))),
+                    AST->getASTContext()).empty());
+  EXPECT_EQ(1u,
+            match(traverse(TK_IgnoreUnlessSpelledInSource,
+                           declRefExpr(to(parmVarDecl(hasName("source"))),
+                                       hasAncestor(objc3GuardStmt()))),
+                  AST->getASTContext()).size());
+}
+
+TEST(ObjC3Matchers, NativeExpressionErrorAndMatchKindsRemainQueryable) {
+  auto AST = buildObjC3AST(R"(
+    struct Error {};
+    using Maybe = Optional(int);
+    int typed() throws(Error);
+    void expressions(Maybe source) {
+      Maybe present = Some(int, 1);
+      Result(int, long) result = Ok(int, long, 4);
+      Maybe copied = copyValue(source);
+      handle { (void)tryValue(typed()); }
+      catch(Error error) { (void)error; }
+      catch { }
+    }
+    int raise() throws(Error) { throwError(Error{}); }
+    void statement_match(Maybe source) {
+      match(source) {
+        case .Some(var payload): { ++payload; }
+        case .None: { }
+      }
+    }
+    int expression_match(Maybe source) {
+      return match(source) {
+        case .Some(let payload) => payload;
+        case .None => 0;
+      };
+    }
+  )");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &C = AST->getASTContext();
+  EXPECT_FALSE(match(objc3OptionalExpr(), C).empty());
+  EXPECT_FALSE(match(objc3ResultExpr(), C).empty());
+  EXPECT_EQ(1u, match(objc3CarrierTransferExpr(), C).size());
+  EXPECT_EQ(1u, match(objc3TryExpr(), C).size());
+  EXPECT_EQ(1u, match(objc3ThrowStmt(), C).size());
+  EXPECT_EQ(2u, match(objc3CatchStmt(), C).size());
+  EXPECT_EQ(1u, match(objc3DoCatchStmt(), C).size());
+  EXPECT_EQ(1u, match(objc3MatchStmt(), C).size());
+  EXPECT_EQ(1u, match(objc3MatchExpr(), C).size());
+  EXPECT_EQ(4u, match(objc3MatchArm(), C).size());
+  EXPECT_EQ(1u,
+            match(objc3MatchArm(isObjC3MutableBinding(),
+                                hasObjC3Binding(varDecl(hasName("payload")))), C)
+                .size());
+  EXPECT_EQ(2u,
+            match(objc3MatchArm(hasObjC3Binding(varDecl(hasName("payload")))), C)
+                .size());
+}
+
+TEST(ObjC3Matchers, LifetimeOwnersExposeWrittenReferencesAndParents) {
+  auto AST = buildObjC3AST(R"(
+    void example(id source) { keepAlive(source); withLifetime(source) {} }
+  )");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto &Ctx = AST->getASTContext();
+  EXPECT_EQ(1u, match(objc3LifetimeStmt(isObjC3KeepAlive()), Ctx).size());
+  EXPECT_EQ(1u,
+            match(objc3LifetimeStmt(unless(isObjC3KeepAlive())), Ctx).size());
+  EXPECT_EQ(2u, match(objc3LifetimeStmt(hasObjC3LifetimeOperand(
+                          declRefExpr(to(parmVarDecl(hasName("source")))))),
+                      Ctx)
+                    .size());
+  auto Written = match(traverse(TK_IgnoreUnlessSpelledInSource,
+                                declRefExpr(to(parmVarDecl(hasName("source"))),
+                                            hasParent(objc3LifetimeStmt()))),
+                       Ctx);
+  EXPECT_EQ(2u, Written.size());
+}
