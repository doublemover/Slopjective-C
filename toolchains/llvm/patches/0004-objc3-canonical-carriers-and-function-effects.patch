+QualType ASTContext::getObjC3OptionalType(QualType ElementType) const {
+  assert(!ElementType.isNull() && "optional element type must be non-null");
+  llvm::FoldingSetNodeID ID;
+  ObjC3OptionalType::Profile(ID, ElementType);
+  void *InsertPos = nullptr;
+  if (ObjC3OptionalType *T =
+          ObjC3OptionalTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(T, 0);
+
+  QualType Canonical;
+  if (!ElementType.isCanonical()) {
+    Canonical = getObjC3OptionalType(getCanonicalType(ElementType));
+    auto *Existing = ObjC3OptionalTypes.FindNodeOrInsertPos(ID, InsertPos);
+    assert(!Existing && "carrier unexpectedly inserted during canonicalization");
+    (void)Existing;
+  }
+  auto *T = new (*this, alignof(ObjC3OptionalType))
+      ObjC3OptionalType(ElementType, Canonical);
+  Types.push_back(T);
+  ObjC3OptionalTypes.InsertNode(T, InsertPos);
+  return QualType(T, 0);
+}
+
+QualType ASTContext::getObjC3ResultType(QualType SuccessType,
+                                       QualType ErrorType) const {
+  assert(!SuccessType.isNull() && !ErrorType.isNull() &&
+         "result arm types must be non-null");
+  llvm::FoldingSetNodeID ID;
+  ObjC3ResultType::Profile(ID, SuccessType, ErrorType);
+  void *InsertPos = nullptr;
+  if (ObjC3ResultType *T = ObjC3ResultTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(T, 0);
+
+  QualType Canonical;
+  if (!SuccessType.isCanonical() || !ErrorType.isCanonical()) {
+    Canonical = getObjC3ResultType(getCanonicalType(SuccessType),
+                                    getCanonicalType(ErrorType));
+    auto *Existing = ObjC3ResultTypes.FindNodeOrInsertPos(ID, InsertPos);
+    assert(!Existing && "carrier unexpectedly inserted during canonicalization");
+    (void)Existing;
+  }
+  auto *T = new (*this, alignof(ObjC3ResultType))
+      ObjC3ResultType(SuccessType, ErrorType, Canonical);
+  Types.push_back(T);
+  ObjC3ResultTypes.InsertNode(T, InsertPos);
+  return QualType(T, 0);
+}
