+++ b/clang/test/ObjC3/Parser/guard-conditions.mm
@@ -0,0 +1,57 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s --check-prefix=AST
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-print %s > %t.mm
+// RUN: FileCheck %s --check-prefix=PRINT < %t.mm
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only %t.mm
+// expected-no-diagnostics
+
+typedef Optional(int) Maybe;
+Maybe next_value(int);
+bool check(int);
+void use(int);
+
+void ordered_bindings(Maybe source) {
+  guard let first = source, second = next_value(first),
+        check(second), var third = next_value(second), fourth = next_value(third)
+  else { return; }
+  third += first;
+  fourth += second;
+  use(first + second + third + fourth);
+}
+
+void assignment_after_boolean(Maybe source, bool flag) {
+  // A Boolean ends binding continuation. Assigning to the ordinary bool flag
+  // is a Boolean condition, rather than an attempt to bind a bool payload.
+  guard let value = source, check(value), (flag = check(value)) else { return; }
+  use(value);
+}
+
+void if_lists(Maybe source) {
+  if let first = source, second = next_value(first) {
+    use(first + second);
+  } else {
+    use(0);
+  }
+  if var first = source, second = next_value(first) {
+    first += second;
+    second += first;
+    use(first + second);
+  }
+}
+
+// AST-LABEL: FunctionDecl {{.*}} ordered_bindings
+// AST: ObjC3GuardStmt
+// AST: ObjC3BindingCondition
+// AST: ObjC3BindingCondition
+// AST: CallExpr
+// AST: ObjC3BindingCondition
+// AST: ObjC3BindingCondition
+// AST-LABEL: FunctionDecl {{.*}} assignment_after_boolean
+// AST: ObjC3GuardStmt
+// AST: BinaryOperator {{.*}} '='
+// AST-LABEL: FunctionDecl {{.*}} if_lists
+// AST: ObjC3IfBindingStmt
+// AST: ObjC3IfBindingStmt
+// PRINT: guard let first = source, let second = next_value(first), check(second), var third = next_value(second), var fourth = next_value(third) else
+// PRINT: if let first = source, second = next_value(first)
+// PRINT: if var first = source, second = next_value(first)
diff --git a/clang/test/ObjC3/Parser/guard-contextual.mm b/clang/test/ObjC3/Parser/guard-contextual.mm
