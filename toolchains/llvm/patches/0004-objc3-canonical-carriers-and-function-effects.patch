+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fblocks -std=c17 -fsyntax-only -verify %s
+
+typedef struct Error { int value; } Error;
+typedef struct OtherError { int value; } OtherError;
+typedef void (^PlainBlock)(void);
+typedef void (^NoPrototypeBlock)();
+typedef void (^TypedBlock)(void) __objc3_throws(Error);
+typedef void (^OtherTypedBlock)(void) __objc3_throws(OtherError);
+typedef void (^UntypedBlock)(void) __objc3_throws;
+typedef void (^AsyncBlock)(void) __objc3_async;
+
+void block_effect_conversions(PlainBlock plain, NoPrototypeBlock no_prototype,
+                              TypedBlock typed,
+                              OtherTypedBlock other, UntypedBlock untyped,
+                              AsyncBlock async_block) {
+  TypedBlock widen_plain = plain;
+  UntypedBlock widen_untyped = plain;
+  TypedBlock widen_unprototyped = no_prototype;
+  PlainBlock reject_narrow = typed; // expected-error {{incompatible block pointer types}}
