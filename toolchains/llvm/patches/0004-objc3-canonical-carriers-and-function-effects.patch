diff --git a/clang/test/ObjC3/Sema/carrier-expression-adversarial.mm b/clang/test/ObjC3/Sema/carrier-expression-adversarial.mm
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-expression-adversarial.mm
@@ -0,0 +1,76 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++20 -fsyntax-only -verify %s
+
+typedef int Count;
+using CountOptional = __objc3_optional(Count);
+using NestedOptional = __objc3_optional(CountOptional);
+using CountResult = __objc3_result(Count, long);
+using NestedResult = __objc3_result(CountResult, NestedOptional);
+
+NestedOptional make_nested_optional() {
+  return __objc3_some(CountOptional, __objc3_some(Count, 0));
+}
+NestedResult make_nested_success() {
+  return __objc3_ok(CountResult, NestedOptional,
+                    __objc3_ok(Count, long, 0));
+}
+NestedResult make_nested_error() {
+  return __objc3_err(CountResult, NestedOptional,
+                     __objc3_some(CountOptional, __objc3_some(Count, 0)));
+}
+
+int optional_operand_calls;
+int result_operand_calls;
+NestedOptional next_optional() {
+  ++optional_operand_calls;
+  return make_nested_optional();
+}
+NestedResult next_result() {
+  ++result_operand_calls;
+  return make_nested_success();
+}
+bool query_call_operands() {
+  bool has_value = __objc3_has_value(next_optional());
+  bool is_ok = __objc3_is_ok(next_result());
+  return has_value && is_ok;
+}
+
+bool parenthesized_and_condition_queries() {
+  bool present = (__objc3_has_value(__objc3_some(int, 0)));
+  int sequenced = ((void)__objc3_is_ok(__objc3_ok(int, long, 0)), 42);
+  if (__objc3_has_value(__objc3_none(int)))
+    return false;
+  return present && sequenced == 42;
+}
+
+// The payload type and expression remain dependent until this template is
+// instantiated, including the nested carrier construction.
+template <class T> auto make_dependent_nested(T value) {
+  using Inner = __objc3_optional(T);
+  return __objc3_some(Inner, __objc3_some(T, value));
+}
+auto dependent_instantiation = make_dependent_nested(0);
+
+struct NotConvertible {};
+template <class T> auto defer_invalid_optional(T value) {
+  return __objc3_some(int, value); // expected-error {{no viable conversion from 'NotConvertible' to 'int'}}
+}
+void failed_conversion_after_instantiation() {
+  (void)defer_invalid_optional(NotConvertible{}); // expected-note {{in instantiation of function template specialization 'defer_invalid_optional<NotConvertible>' requested here}}
+}
+
+struct Tracked {
+  Tracked();
+  Tracked(const Tracked &);
+  ~Tracked();
+};
+Tracked make_tracked();
+using TrackedAlias = Tracked;
+using TrackedOptional = __objc3_optional(TrackedAlias);
+TrackedOptional make_tracked_optional();
+void cleanup_boundaries() {
+  __objc3_some(TrackedAlias, make_tracked()); // expected-warning {{expression result unused}}
+  bool present = __objc3_has_value(make_tracked_optional());
+  (void)present;
+}
+
+
