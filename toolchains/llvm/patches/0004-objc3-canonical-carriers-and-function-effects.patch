+      auto Found = Slots.find({Variable, nullptr});
+      if (Found != Slots.end())
+        return State.OwnerIdentities[Found->second];
+    }
+    return Result;
+  }
+  Value evaluatedOwnerIdentity(const Expr *E, const Facts &State) const {
+    if (E)
