+  }
+  ExprResult Payload;
+  if (E->getPayload()) {
+    Payload = getDerived().TransformExpr(E->getPayload());
+    if (Payload.isInvalid()) return ExprError();
+  }
+  if (!getDerived().AlwaysRebuild() && Info == E->getPayloadTypeInfo() &&
+      Payload.get() == E->getPayload())
+    return E;
+  ParsedType Type = Info ? SemaRef.CreateParsedType(Info->getType(), Info) : ParsedType();
+  switch (E->getKind()) {
