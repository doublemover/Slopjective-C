+using namespace clang;
+
+ExprResult Sema::ActOnObjC3ResourceExpr(
+    unsigned Operation, Expr *Operand, Expr *Replacement,
+    SourceLocation BuiltinLoc, SourceLocation RParenLoc) {
+  auto Reject = [&](SourceLocation Loc, StringRef Message) -> ExprResult {
+    Diag(Loc, getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+        DiagnosticIDs::Error, Message));
+    return ExprError();
+  };
+  if (!getLangOpts().ObjC3)
+    return Reject(BuiltinLoc,
+                  "resource ownership operations require Objective-C 3.0");
+  using Kind = ObjC3ResourceExpr::Kind;
+  Kind Action = static_cast<Kind>(Operation);
+  if (!Operand || (Action == Kind::Reset) != bool(Replacement))
+    return ExprError();
+  Operand = Operand->IgnoreParenImpCasts();
+  if (Operand->isTypeDependent())
+    return ObjC3ResourceExpr::Create(
+        Context, Action, Action == Kind::Take ? Context.DependentTy
+                                             : Context.VoidTy,
+        Operand, Replacement, BuiltinLoc, RParenLoc);
+  auto *Reference = dyn_cast<DeclRefExpr>(Operand);
+  auto *Variable = Reference ? dyn_cast<VarDecl>(Reference->getDecl())
+                             : nullptr;
+  if (!Variable || !Variable->hasAttr<ObjCResourceAttr>() ||
+      !Variable->hasLocalStorage() || Variable->isInvalidDecl() ||
+      !Operand->isLValue() || Variable->getType().isConstQualified())
+    return Reject(Operand->getExprLoc(),
+                  "resource operation requires a direct reference to a "
+                  "mutable local variable annotated with objc_resource");
+
+  QualType HandleType = Variable->getType().getUnqualifiedType();
+  if (Replacement && !Replacement->isTypeDependent()) {
+    if (!getLangOpts().CPlusPlus) {
+      ExprResult Checked = Replacement;
+      if (CheckSingleAssignmentConstraints(
+              HandleType, Checked, /*Diagnose=*/false,
+              /*DiagnoseCFAudited=*/false, /*ConvertRHS=*/false) !=
+          AssignConvertType::Compatible)
+        return Reject(Replacement->getExprLoc(),
+                      "resource reset replacement is not compatible with "
+                      "the handle type; convert the replacement explicitly");
+    }
+    ExprResult Converted = PerformCopyInitialization(
+        InitializedEntity::InitializeTemporary(HandleType),
+        Replacement->getExprLoc(), Replacement);
+    if (Converted.isInvalid())
+      return ExprError();
+    Replacement = Converted.get();
+  }
+  return ObjC3ResourceExpr::Create(
+      Context, Action, Action == Kind::Take ? HandleType : Context.VoidTy,
+      Operand, Replacement, BuiltinLoc, RParenLoc);
+}
