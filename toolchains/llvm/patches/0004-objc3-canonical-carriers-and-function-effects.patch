+TEST(ObjC3ConditionCFG, OrderedSourcesShortCircuitAndKeepBranchBoundaries) {
+  for (const char *Standard : {"c17", "c++20", "c++23"})
+    for (bool Cpp : {false, true})
+      for (bool IfBinding : {false, true}) {
+        if (Cpp && llvm::StringRef(Standard) == "c17")
+          continue;
+        SCOPED_TRACE(Cpp);
+        SCOPED_TRACE(Standard);
+        SCOPED_TRACE(IfBinding);
+        std::string Input =
+            std::string("#define CPP_PAYLOAD ") + (Cpp ? "1\n" : "0\n");
+        auto AST = tooling::buildASTFromCodeWithArgs(
+            Input + R"(
+        #ifndef __cplusplus
+        #define bool _Bool
+        #endif
+        #if CPP_PAYLOAD
+        struct Temporary { ~Temporary() noexcept; };
+        struct Payload {
+          Payload(const Payload &, Temporary = Temporary()) noexcept;
+          ~Payload() noexcept;
+        };
+        typedef __objc3_optional(Payload) Maybe;
+        #define LOCAL_SOURCE Maybe &
+        #else
+        typedef __objc3_optional(int) Maybe;
+        #define LOCAL_SOURCE Maybe
+        #endif
+        Maybe *source1(Maybe *input);
+        Maybe *source2(Maybe *input);
+        void failed(void);
+        void succeeded(void);
+        void exercise(Maybe *input, bool accept) {
+          LOCAL_SOURCE first = *source1(input);
+          LOCAL_SOURCE second = *source2(input);
+          if (accept) {} else { failed(); return; }
+          succeeded();
+        }
+      )",
+            {"-x", Standard[1] == '+' ? "objective-c++" : "objective-c",
+             std::string("-std=") + Standard, "-fobjc-version=3"});
+        ASSERT_TRUE(AST);
+        ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+        ASTContext &C = AST->getASTContext();
+        FunctionDecl *Function = nullptr;
+        for (Decl *D : C.getTranslationUnitDecl()->decls())
+          if (auto *FD = dyn_cast<FunctionDecl>(D))
+            if (FD->hasBody())
+              Function = FD;
+        ASSERT_TRUE(Function);
+        auto *Body = cast<CompoundStmt>(Function->getBody());
+        auto *First = cast<VarDecl>(
+            cast<DeclStmt>(Body->body_begin()[0])->getSingleDecl());
+        auto *Second = cast<VarDecl>(
+            cast<DeclStmt>(Body->body_begin()[1])->getSingleDecl());
+        auto *Placeholder = cast<IfStmt>(Body->body_begin()[2]);
+        Sema &S = AST->getSema();
+        Sema::SynthesizedFunctionScope FunctionScope(S, Function);
+        auto Bind = [&](VarDecl *Source) {
+          return S.ActOnObjC3BindingCondition(
+              nullptr, Source->getIdentifier(), Source->getLocation(), false,
+              Source->getLocation(), Source->getLocation(), Source->getInit());
+        };
+        StmtResult FirstBinding = Bind(First), SecondBinding = Bind(Second);
+        ASSERT_FALSE(FirstBinding.isInvalid());
+        ASSERT_FALSE(SecondBinding.isInvalid());
+        SmallVector<Stmt *, 3> Conditions{FirstBinding.get()};
+        if (!IfBinding)
+          Conditions.push_back(Placeholder->getCond());
+        Conditions.push_back(SecondBinding.get());
+        Stmt *Replacement;
+        Stmt *Success = Body->body_begin()[3];
+        if (IfBinding) {
+          auto *Then =
+              CompoundStmt::Create(C, {Success}, FPOptionsOverride(),
+                                   Body->getLBracLoc(), Body->getRBracLoc());
+          Replacement = ObjC3IfBindingStmt::Create(
+              C, Conditions, Then, Placeholder->getElse(),
+              Placeholder->getIfLoc(), Placeholder->getElseLoc());
+        } else
+          Replacement = ObjC3GuardStmt::Create(
+              C, Conditions, Placeholder->getElse(), Placeholder->getIfLoc(),
+              Placeholder->getElseLoc());
+        SmallVector<Stmt *, 2> Statements{Replacement};
+        if (!IfBinding)
+          Statements.push_back(Success);
+        Function->setBody(
+            CompoundStmt::Create(C, Statements, FPOptionsOverride(),
+                                 Body->getLBracLoc(), Body->getRBracLoc()));
+        CFG::BuildOptions Options;
+        Options.AddScopes = Options.AddLifetime = Options.AddImplicitDtors =
+            true;
+        Options.AddTemporaryDtors = true;
+        Options.setAllAlwaysAdd();
+        auto Graph = CFG::buildCFG(Function, Function->getBody(), &C, Options);
+        ASSERT_TRUE(Graph);
+        std::set<std::string> Paths;
+        std::function<void(const CFGBlock *, std::string, unsigned)> Visit =
+            [&](const CFGBlock *Block, std::string Events, unsigned Depth) {
+              ASSERT_LT(Depth, 40u);
+              auto *FirstNode = cast<ObjC3BindingCondition>(FirstBinding.get());
+              auto *SecondNode =
+                  cast<ObjC3BindingCondition>(SecondBinding.get());
+              for (const CFGElement &Element : *Block) {
+                if (auto Statement = Element.getAs<CFGStmt>()) {
+                  if (auto *Call = dyn_cast<CallExpr>(Statement->getStmt()))
+                    if (auto *Callee = Call->getDirectCallee())
+                      Events += Callee->getNameAsString() + ",";
+                  if (Cpp)
+                    if (auto *DS = dyn_cast<DeclStmt>(Statement->getStmt())) {
+                      if (DS->getSingleDecl() == FirstNode->getBindingDecl())
+                        Events += "bind1,";
+                      if (DS->getSingleDecl() == SecondNode->getBindingDecl())
+                        Events += "bind2,";
+                    }
+                } else if (auto Dtor = Element.getAs<CFGObjC3CarrierDtor>()) {
+                  EXPECT_EQ(CFGElement::ObjC3CarrierDtor, Element.getKind());
+                  if (Dtor->getVarDecl() == FirstNode->getSnapshotDecl())
+                    Events += "snapshot1,";
+                  if (Dtor->getVarDecl() == SecondNode->getSnapshotDecl())
+                    Events += "snapshot2,";
+                } else if (auto Dtor = Element.getAs<CFGAutomaticObjDtor>()) {
+                  if (Dtor->getVarDecl() == FirstNode->getBindingDecl())
+                    Events += "destroy1,";
+                  if (Dtor->getVarDecl() == SecondNode->getBindingDecl())
+                    Events += "destroy2,";
+                }
+              }
+              if (Block == &Graph->getExit())
+                Paths.insert(Events);
+              else
+                for (const auto &Edge : Block->succs())
+                  if (auto *Next = Edge.getReachableBlock())
+                    Visit(Next, Events, Depth + 1);
+            };
+        Visit(&Graph->getEntry(), "", 0);
+        if (Cpp) {
+          std::set<std::string> Expected{
+              "source1,snapshot1,failed,",
+              "source1,bind1,snapshot1,source2,snapshot2,destroy1,failed,",
+              "source1,bind1,snapshot1,source2,bind2,snapshot2,succeeded,"
+              "destroy2,destroy1,"};
+          if (!IfBinding)
+            Expected.insert("source1,bind1,snapshot1,destroy1,failed,");
+          EXPECT_EQ(Expected, Paths);
+        } else
+          EXPECT_EQ((std::set<std::string>{"source1,failed,",
+                                           "source1,source2,failed,",
+                                           "source1,source2,succeeded,"}),
+                    Paths);
+        unsigned Branches = 0;
+        for (const CFGBlock *Block : *Graph)
+          if (Block->getTerminator().getKind() ==
+              CFGTerminator::ObjC3ConditionBranch) {
+            ++Branches;
+            if (isa<ObjC3BindingCondition, ObjC3CarrierTransferExpr>(
+                    Block->getTerminatorStmt()))
+              EXPECT_EQ(nullptr, Block->getTerminatorCondition());
+            else
+              EXPECT_TRUE(isa<Expr>(Block->getTerminatorCondition()));
+          }
+        EXPECT_EQ((IfBinding ? 2u : 3u) + (Cpp ? 2u : 0u), Branches);
+      }
+}
