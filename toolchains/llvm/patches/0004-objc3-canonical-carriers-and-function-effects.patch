+namespace {
+class ExerciseFunction : public RecursiveASTVisitor<ExerciseFunction> {
+public:
+  FunctionDecl *Function = nullptr;
+  bool VisitFunctionDecl(FunctionDecl *FD) {
+    if (FD->hasBody() && FD->getIdentifier() && FD->getName() == "exercise")
+      Function = FD;
+    return true;
+  }
+};
+class StatementExpressionFinder
+    : public RecursiveASTVisitor<StatementExpressionFinder> {
+public:
+  StmtExpr *Expression = nullptr;
+  bool VisitStmtExpr(StmtExpr *E) {
+    if (!Expression)
+      Expression = E;
+    return true;
+  }
+};
+class Rebind : public RecursiveASTVisitor<Rebind> {
+  Sema &Actions;
+  VarDecl *Old, *New;
+
+public:
+  Rebind(Sema &Actions, VarDecl *Old, VarDecl *New)
+      : Actions(Actions), Old(Old), New(New) {}
+  bool VisitDeclRefExpr(DeclRefExpr *E) {
+    if (E->getDecl() == Old) {
+      E->setDecl(New);
+      E->setType(New->getType().getNonReferenceType());
+      Actions.MarkDeclRefReferenced(E);
+    }
+    return true;
+  }
+};
+void checkLowering(llvm::StringRef Code, llvm::StringRef Name,
+                   llvm::StringRef Standard, bool ARC, bool IfBinding,
+                   bool Ordered = false, bool StatementExpression = false,
+                   bool TemplateReplay = false, bool Mutable = true,
+                   bool PrefixDefer = false, bool NativeEHCFG = true) {
+  std::vector<std::string> Args = {"-x",
+                                   Standard == "c17" ? "objective-c"
+                                                     : "objective-c++",
+                                   ("-std=" + Standard).str(),
+                                   "-fobjc-version=3",
+                                   "-fobjc-runtime=gnustep-2.2",
+                                   "-fexceptions",
+                                   "-fobjc-exceptions",
+                                   "-fobjc-arc-exceptions",
+                                   "-fblocks"};
+  Args.push_back(ARC ? "-fobjc-arc" : "-fno-objc-arc");
+  std::string Input = Ordered && IfBinding
+                          ? "#define ORDERED_IF_BINDING 1\n" + Code.str()
+                          : Code.str();
+  if (TemplateReplay) {
+    auto Definition = Input.find("int exercise(");
+    ASSERT_NE(std::string::npos, Definition);
+    auto Parameters = Input.find('(', Definition);
+    auto ParameterEnd = Input.find(')', Parameters);
+    auto Opening = Input.find('{', ParameterEnd);
+    ASSERT_NE(std::string::npos, Opening);
+    auto End = Opening;
+    unsigned Depth = 0;
+    do {
+      if (Input[End] == '{')
+        ++Depth;
+      else if (Input[End] == '}')
+        --Depth;
+      ++End;
+    } while (Depth && End < Input.size());
+    ASSERT_EQ(0u, Depth);
+    std::string Explicit =
+        "\nextern template int exercise<int>" +
+        Input.substr(Parameters, ParameterEnd - Parameters + 1) + ";\n";
+    Input.insert(End, Explicit);
+    for (auto Call = Input.find("exercise(", End + Explicit.size());
+         Call != std::string::npos; Call = Input.find("exercise(", Call + 14))
+      Input.insert(Call + 8, "<int>");
+    Input.insert(Definition, "template<class GuardInstantiation> ");
+  }
+  auto AST =
+      tooling::buildASTFromCodeWithArgs(Input, Args, "condition-codegen.m");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ExerciseFunction Finder;
+  Finder.TraverseDecl(AST->getASTContext().getTranslationUnitDecl());
+  FunctionDecl *Function = Finder.Function;
+  FunctionTemplateDecl *Template = nullptr;
+  if (TemplateReplay)
+    for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *Candidate = dyn_cast<FunctionTemplateDecl>(D))
+        if (Candidate->getName() == "exercise") {
+          Template = Candidate;
+          Function = Candidate->getTemplatedDecl();
+        }
+  ASSERT_TRUE(Function);
+  ASSERT_EQ(TemplateReplay, Template != nullptr);
+  auto *Body = cast<CompoundStmt>(Function->getBody());
+  StmtExpr *StatementExpressionNode = nullptr;
+  if (StatementExpression) {
+    StatementExpressionFinder Expressions;
+    Expressions.TraverseStmt(Body);
+    StatementExpressionNode = Expressions.Expression;
+    ASSERT_TRUE(StatementExpressionNode);
+    Body = StatementExpressionNode->getSubStmt();
+  }
+  ASSERT_GE(Body->size(), 4u);
+  auto *SourceStatement = cast<DeclStmt>(Body->body_front());
+  auto *Source = cast<VarDecl>(SourceStatement->getSingleDecl());
+  auto *If = cast<IfStmt>(*(Body->body_begin() + 1));
+  auto *User =
+      cast<VarDecl>(cast<DeclStmt>(*(Body->body_begin() + 2))->getSingleDecl());
+  ASTContext &C = AST->getASTContext();
+  {
+    Sema &S = AST->getSema();
+    Sema::SynthesizedFunctionScope Scope(S, Function);
+    SourceLocation Loc = Source->getLocation();
+    StmtResult Result = S.ActOnObjC3BindingCondition(
+        nullptr, User->getIdentifier(), User->getLocation(), Mutable, Loc, Loc,
+        Source->getInit());
+    ASSERT_FALSE(Result.isInvalid());
+    auto *Binding = cast<ObjC3BindingCondition>(Result.get());
+    SmallVector<Stmt *, 4> Conditions{Binding};
+    VarDecl *SecondUser = nullptr;
+    ObjC3BindingCondition *SecondBinding = nullptr;
+    if (Ordered) {
+      ASSERT_GE(Body->size(), 7u);
+      auto *SecondSource = cast<VarDecl>(
+          cast<DeclStmt>(*(Body->body_begin() + 3))->getSingleDecl());
+      SecondUser = cast<VarDecl>(
+          cast<DeclStmt>(*(Body->body_begin() + 4))->getSingleDecl());
+      auto *Boolean =
+          cast<CStyleCastExpr>(*(Body->body_begin() + 5))->getSubExpr();
+      ASSERT_TRUE(
+          Rebind(S, User, Binding->getBindingDecl()).TraverseStmt(Boolean));
+      ExprResult Checked =
+          S.ActOnObjC3BooleanCondition(nullptr, Boolean, Boolean->getExprLoc());
+      ASSERT_FALSE(Checked.isInvalid());
+      if (!IfBinding)
+        Conditions.push_back(Checked.get());
+      ASSERT_TRUE(Rebind(S, User, Binding->getBindingDecl())
+                      .TraverseStmt(SecondSource->getInit()));
+      StmtResult Next = S.ActOnObjC3BindingCondition(
+          nullptr, SecondUser->getIdentifier(), SecondUser->getLocation(), true,
+          Loc, Loc, SecondSource->getInit());
+      ASSERT_FALSE(Next.isInvalid());
+      SecondBinding = cast<ObjC3BindingCondition>(Next.get());
+      Conditions.push_back(SecondBinding);
+    }
+    SmallVector<Stmt *, 8> Tail(Body->body_begin() + (Ordered ? 6 : 3),
+                                Body->body_end());
+    for (Stmt *Statement : Tail) {
+      ASSERT_TRUE(
+          Rebind(S, User, Binding->getBindingDecl()).TraverseStmt(Statement));
+      if (SecondUser)
+        ASSERT_TRUE(Rebind(S, SecondUser, SecondBinding->getBindingDecl())
+                        .TraverseStmt(Statement));
+    }
+    Stmt *Statement;
+    if (IfBinding) {
+      auto *Then =
+          CompoundStmt::Create(C, Tail, FPOptionsOverride(),
+                               Body->getLBracLoc(), Body->getRBracLoc());
+      Statement = ObjC3IfBindingStmt::Create(C, Conditions, Then, If->getElse(),
+                                             Loc, If->getElseLoc());
+    } else {
+      Statement = ObjC3GuardStmt::Create(C, Conditions, If->getElse(), Loc,
+                                         If->getElseLoc());
+    }
+    SmallVector<Stmt *, 8> Statements;
+    if (PrefixDefer) {
+      ASSERT_FALSE(IfBinding);
+      ASSERT_TRUE(isa<DeferStmt>(Tail.front()));
+      Statements.push_back(Tail.front());
+      Tail.erase(Tail.begin());
+    }
+    Statements.push_back(Statement);
+    if (!IfBinding)
+      Statements.append(Tail);
+    auto *Rebuilt =
+        CompoundStmt::Create(C, Statements, FPOptionsOverride(),
+                             Body->getLBracLoc(), Body->getRBracLoc());
+    if (StatementExpressionNode)
+      StatementExpressionNode->setSubStmt(Rebuilt);
+    else
+      Function->setBody(Rebuilt);
+  }
+  ASSERT_FALSE(AST->getSema().CheckObjC3Guards(Function, Function->getBody()));
+  FunctionDecl *Concrete = nullptr;
+  if (Template) {
+    ASSERT_EQ(1u, std::distance(Template->spec_begin(), Template->spec_end()));
+    Concrete = *Template->spec_begin();
+    Concrete->setTemplateSpecializationKind(TSK_ImplicitInstantiation);
+    AST->getSema().InstantiateFunctionDefinition(Concrete->getLocation(),
+                                                 Concrete, true, true, false);
+    ASSERT_TRUE(Concrete->doesThisDeclarationHaveABody());
+  }
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  CFG::BuildOptions FlowOptions;
+  FlowOptions.AddImplicitDtors = FlowOptions.AddTemporaryDtors = true;
+  FlowOptions.AddEHEdges = FlowOptions.AddLifetime = FlowOptions.AddScopes =
+      true;
+  FlowOptions.setAllAlwaysAdd();
+  FunctionDecl *Emitted = Concrete ? Concrete : Function;
+  if (!NativeEHCFG) {
+    // Managed scope release queues have qualified CodeGen execution, but not
+    // a native-EH CFG ownership model. Keep that boundary explicitly closed.
+    EXPECT_FALSE(CFG::buildCFG(Emitted, Emitted->getBody(), &C, FlowOptions));
+    FlowOptions.AddEHEdges = false;
+  }
+  ASSERT_TRUE(CFG::buildCFG(Emitted, Emitted->getBody(), &C, FlowOptions));
+  // Run each module through the matching native frontend/backend mode. ARC
+  // frontend intrinsics emitted at O2 require the optimizing ARC pipeline.
+  for (unsigned Optimization : {0u, 2u}) {
+    llvm::LLVMContext IRContext;
+    CodeGenOptions Options;
+    Options.OptimizationLevel = Optimization;
+    Options.ObjCAutoRefCountExceptions = ARC;
+    // Match the Linux GNUstep 2.2 driver contract for registration and sends.
+    Options.UseInitArray = true;
+    Options.setObjCDispatchMethod(CodeGenOptions::NonLegacy);
+    Options.setDebugInfo(llvm::codegenoptions::FullDebugInfo);
+    auto Generator = CreateLLVMCodeGen(
+        AST->getDiagnostics(), Name,
+        AST->getFileManager().getVirtualFileSystemPtr(),
+        AST->getPreprocessor().getHeaderSearchInfo().getHeaderSearchOpts(),
+        AST->getPreprocessor().getPreprocessorOpts(), Options, IRContext);
+    Generator->Initialize(C);
+    for (Decl *D : C.getTranslationUnitDecl()->decls()) {
+      // The parser reports method definitions before the implementation
+      // metadata; they are children of the implementation, not translation-unit
+      // siblings.
+      if (auto *Implementation = dyn_cast<ObjCImplDecl>(D))
+        for (ObjCMethodDecl *Method : Implementation->methods())
+          if (Method->hasBody())
+            ASSERT_TRUE(Generator->HandleTopLevelDecl(DeclGroupRef(Method)));
+      ASSERT_TRUE(Generator->HandleTopLevelDecl(DeclGroupRef(D)));
+    }
+    // Forced instantiations are not translation-unit declarations. Replay the
+    // normal definition notification as well as the top-level pattern.
+    if (Concrete)
+      ASSERT_TRUE(Generator->HandleTopLevelDecl(DeclGroupRef(Concrete)));
+    // A parsed C AST still needs the normal end-of-translation-unit callback
+    // when replayed into a new CodeGenerator (for globals such as `int
+    // calls;`).
+    if (!C.getLangOpts().CPlusPlus)
+      for (Decl *D : C.getTranslationUnitDecl()->decls())
+        if (auto *Variable = dyn_cast<VarDecl>(D))
+          if (Variable->getActingDefinition() == Variable)
+            Generator->CompleteTentativeDefinition(Variable);
+    Generator->HandleTranslationUnit(C);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    ASSERT_TRUE(Generator->GetModule());
+    EXPECT_FALSE(llvm::verifyModule(*Generator->GetModule(), &llvm::errs()));
+    std::string IR;
+    llvm::raw_string_ostream Stream(IR);
+    Generator->GetModule()->print(Stream, nullptr);
+    EXPECT_NE(std::string::npos, IR.find("objc3.binding.present"));
+    EXPECT_NE(std::string::npos, IR.find("objc3.binding.absent"));
+    // Optional artifact emission belongs to this test harness, not the
+    // compiler. External qualification compiles and executes these exact
+    // verified modules.
+    if (const char *Directory = std::getenv("OBJC3_CONDITION_TEST_IR_DIR")) {
+      llvm::SmallString<256> Path(Directory);
+      llvm::sys::path::append(
+          Path, (Name + "-O" + std::to_string(Optimization) + ".ll").str());
+      std::error_code Error;
+      llvm::raw_fd_ostream File(Path, Error, llvm::sys::fs::OF_Text);
+      ASSERT_FALSE(Error) << Error.message();
+      File << IR;
+    }
+  }
+}
+const char Plain[] = R"(
+  typedef __objc3_optional(int) Maybe;
+  int calls;
+  Maybe *counted(Maybe *value) { ++calls; return value; }
+  int exercise(Maybe *input) {
+    Maybe source = *counted(input);
+    if (1) {} else { return -1; }
+    int value = 0;
+    value += 5;
+    return value;
+  }
+  int main(void) {
+    Maybe some = __objc3_some(int, 0);
+    Maybe none = __objc3_none(int);
+    if (exercise(&some) != 5 || calls != 1) return 1;
+    if (exercise(&none) != -1 || calls != 2) return 2;
+    return 0;
+  }
+)";
+const char Cpp[] = R"(
+  int copies, live, tempDestructions, throwTemp, throwCopy, payloadDestructions,
+      throwPayload, calls;
+  struct Temporary {
+    ~Temporary() noexcept(false) { if (++tempDestructions == throwTemp) throw 41; }
+  };
+  struct Payload {
+    int number;
+    Payload(int value) : number(value) { ++live; }
+    Payload(const Payload &other, Temporary = Temporary()) : number(other.number) {
+      if (++copies == throwCopy) throw 42;
+      ++live;
+    }
+    ~Payload() noexcept(false) {
+      --live;
+      if (++payloadDestructions == throwPayload) throw 43;
+    }
+  };
+  typedef __objc3_optional(Payload) Maybe;
+  Maybe *counted(Maybe *value) { ++calls; return value; }
+  int exercise(Maybe *input) {
+    Maybe &source = *counted(input);
+    if (true) {} else { return -1; }
+    Payload value(0);
+    return value.number;
+  }
+  int main() {
+    Maybe some = __objc3_some(Payload, Payload(7));
+    if (live != 1) return 1;
+    copies = tempDestructions = payloadDestructions = 0;
+    if (exercise(&some) != 7 || copies != 2 || live != 1 || calls != 1) return 2;
+    for (int failure = 1; failure <= 5; ++failure) {
+      copies = tempDestructions = payloadDestructions = 0;
+      throwCopy = failure == 1 ? 2 : failure == 5 ? 1 : 0;
+      throwTemp = failure == 2 ? 1 : failure == 3 ? 2 : 0;
+      throwPayload = failure == 4 ? 1 : 0;
+      bool caught = false;
+      try { (void)exercise(&some); } catch (int) { caught = true; }
+      if (!caught || live != 1) return 3 + failure;
+    }
+    throwCopy = throwTemp = throwPayload = 0;
+    Maybe none = __objc3_none(Payload);
+    if (exercise(&none) != -1 || live != 1) return 9;
+    return 0;
+  }
+)";
+const char OrderedPlain[] = R"(
+
+#ifdef ORDERED_IF_BINDING
+#define EXPECTED_FILTERS 0
+#define ZERO_RESULT 3
+#define ZERO_SECOND 1
+#else
+#define EXPECTED_FILTERS 1
+#define ZERO_RESULT -1
+#define ZERO_SECOND 0
+#endif
+  typedef __objc3_optional(int) Maybe;
+  int firstCalls, secondCalls, filters, badOrder, expectedFirst;
+  Maybe *observed;
+  Maybe *counted(Maybe *value) { ++firstCalls; observed = value; return value; }
+  Maybe *countedSecond(Maybe *value, int first) {
+    ++secondCalls;
