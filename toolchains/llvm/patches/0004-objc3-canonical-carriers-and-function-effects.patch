diff --git a/clang/lib/Sema/SemaObjC3OptionalOperators.cpp b/clang/lib/Sema/SemaObjC3OptionalOperators.cpp
new file mode 100644
index 000000000..bd0292ed3
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3OptionalOperators.cpp
@@ -0,0 +1,173 @@
+//===--- SemaObjC3OptionalOperators.cpp - Optional operator semantics ----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/ObjC3MatchSemantic.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Overload.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+QualType withNullability(ASTContext &Context, QualType Type,
+                         NullabilityKind Kind) {
+  (void)AttributedType::stripOuterNullability(Type);
+  attr::Kind Attribute = Kind == NullabilityKind::NonNull
+                             ? attr::TypeNonNull
+                         : (Kind == NullabilityKind::Nullable ||
+                            Kind == NullabilityKind::NullableResult)
+                             ? attr::TypeNullable
+                             : attr::TypeNullUnspecified;
+  return Context.getAttributedType(Attribute, Type, Type);
+}
+
+bool isNonnullFallback(Expr *Value) {
+  if (auto Kind = Value->getType()->getNullability())
+    return *Kind == NullabilityKind::NonNull;
+  // These literals have no nullable dynamic case even when their builtin type
+  // carries no explicit nullability sugar.
+  return isa<ObjCStringLiteral, ObjCBoxedExpr, BlockExpr>(
+      Value->IgnoreParenImpCasts());
+}
+
+ExprResult buildOptionalCoalescing(Sema &S, Expr *LHS, Expr *RHS,
+                                    const ObjC3OptionalType *Optional,
+                                    SourceLocation Loc) {
+  QualType Payload = Optional->getElementType();
+  bool ReturnCarrier = S.Context.hasSameUnqualifiedType(LHS->getType(),
+                                                         RHS->getType());
+  if (Payload->isVoidType() && !ReturnCarrier) {
+    S.Diag(Loc, diag::err_objc3_coalesce_void_payload);
+    return ExprError();
+  }
+  if (!Payload->isVoidType() &&
+      S.RequireCompleteType(Loc, Payload, diag::err_typecheck_decl_incomplete_type))
+    return ExprError();
+  if (!ReturnCarrier) {
+    // Nested Optional payloads are unwrapped by one layer. A fallback already
+    // having the payload type must never be wrapped in another Optional.
+    auto Conversion = S.TryImplicitConversion(
+        RHS, Payload, /*SuppressUserConversions=*/false,
+        Sema::AllowedExplicit::None, /*InOverloadResolution=*/false,
+        /*CStyle=*/false, /*AllowObjCWritebackConversion=*/false);
+    if (Conversion.isBad()) {
+      S.Diag(Loc, diag::err_objc3_coalesce_fallback_type)
+          << RHS->getType() << Payload << RHS->getSourceRange();
+      return ExprError();
+    }
+  }
+
+  QualType BoundType = ReturnCarrier ? LHS->getType() : Payload;
+  BoundType = S.Context.getConstType(BoundType.getUnqualifiedType());
+  auto *Binding = VarDecl::Create(
+      S.Context, S.CurContext, Loc, Loc, nullptr, BoundType,
+      S.Context.getTrivialTypeSourceInfo(BoundType, Loc), SC_None);
+  Binding->setImplicit();
+  S.CurContext->addDecl(Binding);
+  auto *BindingStmt = new (S.Context) DeclStmt(DeclGroupRef(Binding), Loc, Loc);
+  Expr *Present = S.BuildDeclRefExpr(Binding, BoundType, VK_LValue, Loc);
+  auto *Some = new (S.Context) ObjC3MatchArm(
+      objc3::MatchPatternKind::OptionalSome, nullptr, BindingStmt, nullptr,
+      Present, Binding,
+      ReturnCarrier ? objc3::MatchBindingKind::Scrutinee
+                    : objc3::MatchBindingKind::OptionalPayload,
+      LHS->getType().getCanonicalType(), false, true, Loc, Loc,
+      SourceLocation(), Loc);
+  auto *None = new (S.Context) ObjC3MatchArm(
+      objc3::MatchPatternKind::OptionalNone, nullptr, nullptr, nullptr, RHS,
+      nullptr, objc3::MatchBindingKind::None,
+      LHS->getType().getCanonicalType(), false, true, Loc, Loc,
+      SourceLocation(), Loc);
+  ObjC3MatchArm *Arms[] = {Some, None};
+  ExprResult Result = S.ActOnObjC3MatchExpr(
+      LHS, Arms, Loc, LHS->getBeginLoc(), LHS->getEndLoc(), Loc,
+      RHS->getEndLoc());
+  if (Result.isInvalid())
+    return ExprError();
+  if (ReturnCarrier) {
+    Result.get()->setType(LHS->getType().getUnqualifiedType());
+  } else if (Result.get()->getType()->isObjCRetainableType()) {
+    // Carrier presence proves the tag, not the payload's pointer value.
+    // Some(nil) remains successful even with a nonnull fallback. Native
+    // match joins canonical types, so restore this operator's nullable join.
+    auto Left = Payload->getNullability();
+    auto Right = RHS->getType()->getNullability();
+    NullabilityKind L = Left ? *Left : NullabilityKind::Nullable;
+    NullabilityKind R = isNonnullFallback(RHS)
+                            ? NullabilityKind::NonNull
+                            : Right ? *Right : NullabilityKind::Nullable;
+    NullabilityKind Joined = NullabilityKind::NonNull;
+    if (L == NullabilityKind::Nullable || R == NullabilityKind::Nullable ||
+        L == NullabilityKind::NullableResult ||
+        R == NullabilityKind::NullableResult)
+      Joined = NullabilityKind::Nullable;
+    else if (L == NullabilityKind::Unspecified ||
+             R == NullabilityKind::Unspecified)
+      Joined = NullabilityKind::Unspecified;
+    Result.get()->setType(
+        withNullability(S.Context, Result.get()->getType(), Joined));
+  }
+  return Result;
+}
+} // namespace
+
+ExprResult Sema::ActOnObjC3CoalesceExpr(Expr *LHS, Expr *RHS,
+                                       SourceLocation OperatorLoc) {
+  if (!LHS || !RHS)
+    return ExprError();
+  ExprResult CheckedLHS = CheckPlaceholderExpr(LHS);
+  ExprResult CheckedRHS = CheckPlaceholderExpr(RHS);
+  if (CheckedLHS.isInvalid() || CheckedRHS.isInvalid())
+    return ExprError();
+  LHS = CheckedLHS.get();
+  RHS = CheckedRHS.get();
+  if (LHS->isTypeDependent() || RHS->isTypeDependent())
+    return ObjC3CoalesceExpr::Create(Context, Context.DependentTy, LHS, RHS,
+                                      nullptr, OperatorLoc);
+
+  ExprResult Semantic;
+  if (const auto *Optional = LHS->getType()->getAs<ObjC3OptionalType>()) {
+    Semantic = buildOptionalCoalescing(*this, LHS, RHS, Optional, OperatorLoc);
+  } else if (LHS->getType()->isObjCRetainableType()) {
+    if (!RHS->getType()->isObjCRetainableType() &&
+        !RHS->isNullPointerConstant(Context, Expr::NPC_ValueDependentIsNotNull)) {
+      Diag(OperatorLoc, diag::err_objc3_coalesce_fallback_type)
+          << RHS->getType() << LHS->getType() << RHS->getSourceRange();
+      return ExprError();
+    }
+    // The successful presence test refines the selected pointer. Do not let
+    // the conditional operator diagnose a conversion from its written nullable
+    // source to a nonnull fallback before this operator computes its own join.
+    QualType LoadedType = LHS->getType();
+    (void)AttributedType::stripOuterNullability(LoadedType);
+    Expr *Loaded = ImplicitCastExpr::Create(
+        Context, LoadedType, CK_NoOp, LHS, nullptr, LHS->getValueKind(),
+        FPOptionsOverride());
+    Semantic = ActOnConditionalOp(OperatorLoc, OperatorLoc, Loaded,
+                                   /*Middle=*/nullptr, RHS);
+    if (!Semantic.isInvalid()) {
+      NullabilityKind Nullability = NullabilityKind::Nullable;
+      if (LHS->getType()->getNullability() == NullabilityKind::NonNull ||
+          isNonnullFallback(RHS))
+        Nullability = NullabilityKind::NonNull;
+      else if (auto Written = RHS->getType()->getNullability())
+        Nullability = *Written;
+      Semantic.get()->setType(
+          withNullability(Context, Semantic.get()->getType(), Nullability));
+    }
+  } else {
+    Diag(OperatorLoc, diag::err_objc3_coalesce_requires_optional)
+        << LHS->getType() << LHS->getSourceRange();
+    return ExprError();
+  }
+  if (Semantic.isInvalid())
+    return ExprError();
+  return ObjC3CoalesceExpr::Create(Context, Semantic.get()->getType(), LHS,
+                                    RHS, Semantic.get(), OperatorLoc);
+}
