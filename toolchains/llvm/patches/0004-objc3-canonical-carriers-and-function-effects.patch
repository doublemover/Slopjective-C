@@ -0,0 +1,15 @@
+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-pch -o %t.pch %S/Inputs/typed-keypaths.h
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -include-pch %t.pch -emit-llvm -o /dev/null -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-pch -o %t.cxx.pch %S/Inputs/typed-keypaths.h
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -include-pch %t.cxx.pch -emit-llvm -o /dev/null -verify %s
+// expected-no-diagnostics
+int consumer(ImportedPathNode * _Nonnull root) {
+  WritableKeyPath<ImportedPathNode *, int> kp = importedPath();
+  KeyPathSet(kp, root, 42);
+  KeyPathSet(importedFieldPath(), root, 41L);
+  KeyPathSet(importedBitsPath(), root, 10U);
+#ifdef __cplusplus
+  KeyPathSet(importedInheritedPath(), root, 42L);
+#endif
+  return KeyPathGet(kp, root) + importedGet(root);
+}
