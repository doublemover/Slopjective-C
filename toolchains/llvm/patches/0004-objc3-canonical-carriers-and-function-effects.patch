@@ -0,0 +1,29 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+@protocol Error @end
+@protocol Other @end
+using E = id<Error>;
+using Alias = E;
+using Different = id<Other>;
+struct Base {
+  virtual int exact() __objc3_throws(E); // expected-note 2 {{overridden virtual function is here}}
+  virtual int untyped() __objc3_throws; // expected-note {{overridden virtual function is here}}
+  virtual int plain(); // expected-note {{overridden virtual function is here}}
+  virtual int async() __objc3_async; // expected-note {{overridden virtual function is here}}
+};
+struct Accepted : Base { int exact() __objc3_throws(Alias) override; };
+struct Missing : Base {
+  int exact() override; // expected-error {{has different attributes}}
+};
+struct Changed : Base {
+  int exact() __objc3_throws(Different) override; // expected-error {{has different attributes}}
+  int untyped() __objc3_throws(E) override; // expected-error {{has different attributes}}
+  int plain() __objc3_throws(E) override; // expected-error {{has different attributes}}
+  int async() override; // expected-error {{has different attributes}}
+};
+struct Special {
+  Special() __objc3_throws(E); // expected-error {{constructor cannot be declared 'ObjC3 async/throws'}}
+  ~Special() __objc3_throws(E); // expected-error {{destructor cannot be declared 'ObjC3 async/throws'}}
+};
+template<class T> struct GenericBase { virtual int get() __objc3_throws(T); };
+template<class T> struct GenericDerived : GenericBase<T> { int get() __objc3_throws(T) override; };
+GenericDerived<E> AcceptedInstantiation;
