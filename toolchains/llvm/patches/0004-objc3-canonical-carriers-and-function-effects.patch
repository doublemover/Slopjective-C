+ObjC3CarrierRepresentationInfo
+ASTContext::getObjC3CarrierRepresentationType(QualType CarrierType) const {
+  ObjC3CarrierRepresentationInfo Info;
+  if (CarrierType.isNull())
+    return Info;
+
+  const Type *T = getCanonicalType(CarrierType).getTypePtr();
+  auto Existing = ObjC3CarrierRepresentations.find(T);
+  if (Existing != ObjC3CarrierRepresentations.end())
+    return Existing->second;
+
+  QualType FirstPayload;
+  QualType SecondPayload;
+  const bool IsOptional = isa<ObjC3OptionalType>(T);
+  if (const auto *Optional = dyn_cast<ObjC3OptionalType>(T)) {
+    FirstPayload = Optional->getElementType();
+  } else if (const auto *Result = dyn_cast<ObjC3ResultType>(T)) {
+    FirstPayload = Result->getSuccessType();
+    SecondPayload = Result->getErrorType();
+  } else {
+    return Info;
+  }
+
+  auto PayloadStatus = [](QualType Payload) {
+    if (Payload->isDependentType())
+      return ObjC3CarrierRepresentationInfo::Status::Deferred;
+    if (Payload->isVoidType())
+      return ObjC3CarrierRepresentationInfo::Status::Materialized;
+    // Arrays remain outside the carrier materialization policy even when an
+    // incomplete array might later acquire a bound through redeclaration.
+    if (Payload->isArrayType() || Payload->isVariablyModifiedType())
+      return ObjC3CarrierRepresentationInfo::Status::Unsupported;
+    // An incomplete record can become materializable later in this TU. Keep
+    // that distinct from a type whose shape is permanently unsupported.
+    if (Payload->isIncompleteType())
+      return ObjC3CarrierRepresentationInfo::Status::Deferred;
+    // Accepting a parsed function/reference type does not establish storage.
+    if (!Payload->isObjectType())
+      return ObjC3CarrierRepresentationInfo::Status::Unsupported;
+    return ObjC3CarrierRepresentationInfo::Status::Materialized;
+  };
+  const auto FirstStatus = PayloadStatus(FirstPayload);
+  const auto SecondStatus = IsOptional
+                                ? ObjC3CarrierRepresentationInfo::Status::Materialized
+                                : PayloadStatus(SecondPayload);
+  if (FirstStatus == ObjC3CarrierRepresentationInfo::Status::Unsupported ||
+      SecondStatus == ObjC3CarrierRepresentationInfo::Status::Unsupported)
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Unsupported;
+  else if (FirstStatus == ObjC3CarrierRepresentationInfo::Status::Deferred ||
+           SecondStatus == ObjC3CarrierRepresentationInfo::Status::Deferred)
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Deferred;
+  else
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Materialized;
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return Info;
+
+  auto CreateRecord = [&](TagTypeKind Kind, DeclContext *DC) -> RecordDecl * {
+    RecordDecl *RD;
+    if (getLangOpts().CPlusPlus)
+      RD = CXXRecordDecl::Create(*this, Kind, DC, SourceLocation(),
+                                 SourceLocation(), nullptr);
+    else
+      RD = RecordDecl::Create(*this, Kind, DC, SourceLocation(),
+                              SourceLocation(), nullptr);
+    RD->setImplicit();
+    RD->startDefinition();
+    return RD;
+  };
+  auto AddField = [&](RecordDecl *RD, StringRef Name,
+                      QualType FieldType) -> FieldDecl * {
+    auto *Field = FieldDecl::Create(
+        *this, RD, SourceLocation(), SourceLocation(), &Idents.get(Name),
+        FieldType, nullptr, nullptr, false, ICIS_NoInit);
+    Field->setImplicit();
+    if (isa<CXXRecordDecl>(RD))
+      Field->setAccess(AS_public);
+    RD->addDecl(Field);
+    return Field;
+  };
+  auto CompleteRecord = [](RecordDecl *RD) {
+    if (auto *CXXRD = dyn_cast<CXXRecordDecl>(RD))
+      CXXRD->completeDefinition();
+    else
+      RD->completeDefinition();
+  };
+
+  auto *Outer = CreateRecord(TagTypeKind::Struct, getTranslationUnitDecl());
+  Info.Record = Outer;
+  Info.TagField = AddField(Outer, "__objc3_state", BoolTy);
+
+  const bool HasFirstStorage = !FirstPayload->isVoidType();
+  const bool HasSecondStorage = !IsOptional && !SecondPayload->isVoidType();
+  if (HasFirstStorage || HasSecondStorage) {
+    auto *PayloadUnion = CreateRecord(TagTypeKind::Union, getTranslationUnitDecl());
+    Info.PayloadUnion = PayloadUnion;
+    if (HasFirstStorage) {
+      if (IsOptional)
+        Info.ValueField = AddField(PayloadUnion, "__objc3_value", FirstPayload);
+      else
+        Info.SuccessField =
+            AddField(PayloadUnion, "__objc3_success", FirstPayload);
+    }
+    if (HasSecondStorage)
+      Info.ErrorField = AddField(PayloadUnion, "__objc3_error", SecondPayload);
+    CompleteRecord(PayloadUnion);
+    Info.PayloadField =
+        AddField(Outer, "__objc3_payload", getCanonicalTagType(PayloadUnion));
+  }
+  CompleteRecord(Outer);
+  Info.Type = getCanonicalTagType(Outer);
+
+  const ASTRecordLayout &OuterLayout = getASTRecordLayout(Outer);
+  Info.TagOffsetBits =
+      OuterLayout.getFieldOffset(Info.TagField->getFieldIndex());
+  if (Info.PayloadField) {
+    const uint64_t PayloadBase =
+        OuterLayout.getFieldOffset(Info.PayloadField->getFieldIndex());
+    const ASTRecordLayout &UnionLayout = getASTRecordLayout(Info.PayloadUnion);
+    if (Info.ValueField)
+      Info.ValueOffsetBits =
+          PayloadBase +
+          UnionLayout.getFieldOffset(Info.ValueField->getFieldIndex());
+    if (Info.SuccessField)
+      Info.SuccessOffsetBits =
+          PayloadBase +
+          UnionLayout.getFieldOffset(Info.SuccessField->getFieldIndex());
+    if (Info.ErrorField)
+      Info.ErrorOffsetBits =
+          PayloadBase +
+          UnionLayout.getFieldOffset(Info.ErrorField->getFieldIndex());
+  }
+  Info.State = ObjC3CarrierRepresentationInfo::Status::Materialized;
+  ObjC3CarrierRepresentations[T] = Info;
+  return Info;
+}
