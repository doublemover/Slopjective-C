+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+
+#include <memory>
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-carrier-type-identity.mm");
+}
+
+TypedefNameDecl *lookupTypedef(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  for (NamedDecl *Decl : Decls)
+    if (auto *Typedef = dyn_cast<TypedefNameDecl>(Decl))
+      return Typedef;
+  return nullptr;
+}
+
+TEST(ObjC3CarrierIdentity, PointerAuthDiscriminatorPreservesCanonicalArms) {
+  auto AST = parse(R"cpp(
+    typedef int IntAlias;
+    using OptionalInt = __objc3_optional(int);
+    using OptionalAlias = __objc3_optional(IntAlias);
+    using OptionalLong = __objc3_optional(long);
+    using ResultIntLong = __objc3_result(int, long);
+    using ResultLongInt = __objc3_result(long, int);
+    using OptionalIntFunction = void (*)(OptionalInt);
+    using OptionalAliasFunction = void (*)(OptionalAlias);
+    using OptionalLongFunction = void (*)(OptionalLong);
+    using ResultIntLongFunction = void (*)(ResultIntLong);
+    using ResultLongIntFunction = void (*)(ResultLongInt);
+    using OptionalIntPointerFunction = void (*)(OptionalInt *);
+    using OptionalLongPointerFunction = void (*)(OptionalLong *);
+    using OptionalIntPointerPointerFunction = void (*)(OptionalInt **);
+    using OptionalLongPointerPointerFunction = void (*)(OptionalLong **);
+    using NativeIntPointerPointerFunction = void (*)(int **);
+    using NativeFloatPointerPointerFunction = void (*)(float **);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto discriminator = [&](llvm::StringRef Name) {
+    auto *Decl = lookupTypedef(Context, Name);
+    EXPECT_NE(Decl, nullptr);
+    return Context.getPointerAuthTypeDiscriminator(
+        Context.getCanonicalType(Context.getTypeDeclType(Decl)));
+  };
+
+  EXPECT_EQ(discriminator("OptionalIntFunction"),
+            discriminator("OptionalAliasFunction"));
+  EXPECT_NE(discriminator("OptionalIntFunction"),
+            discriminator("OptionalLongFunction"));
+  EXPECT_NE(discriminator("ResultIntLongFunction"),
+            discriminator("ResultLongIntFunction"));
+  EXPECT_NE(discriminator("OptionalIntPointerFunction"),
+            discriminator("OptionalLongPointerFunction"));
+  EXPECT_NE(discriminator("OptionalIntPointerPointerFunction"),
+            discriminator("OptionalLongPointerPointerFunction"));
+  EXPECT_EQ(discriminator("NativeIntPointerPointerFunction"),
+            discriminator("NativeFloatPointerPointerFunction"));
+}
+
