+
+// Warnings about redundant arms must not stop analysis before the arm that
+// completes coverage. Guarded arms alone never supply the missing coverage.
+int duplicate_but_complete(bool value) {
+  return __objc3_match(value) {
+  case true => 1;
+  case true => 2; // expected-warning {{duplicate unguarded match case}}
+  case false => 0;
+  };
+}
+int duplicate_but_incomplete(bool value) {
+  return __objc3_match(value) {
+  case true => 1;
+  case true => 2;
+  case false where false => 0;
+  }; // expected-error {{non-exhaustive expression-form match over Bool}}
+}
+void malformed_statement(bool value) {
+  __objc3_match_stmt(value) {
+    ; // expected-error {{expected case}}
+    default: {}
+  }
+}
+void malformed_expression(bool value) {
+  int result = __objc3_match(value) {
+    ; // expected-error {{expected case}}
+    default => 0;
+  };
+  (void)result;
