+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+@protocol Error @end
+typedef __objc3_optional(id) Strong;
+Strong value(Strong input) __objc3_throws(id<Error>);
+Strong force(Strong input) { return __objc3_try_force(value(input)); }
+Strong forward(Strong input) __objc3_throws(id<Error>) { return __objc3_try(value(input)); }
+Strong missing_context(Strong input) {
+  return __objc3_try(value(input)); // expected-error {{requires a matching throwing function}}
+}
+void nested_optional(Strong input) {
+  __objc3_optional(Strong) result = __objc3_try_optional(value(input));
+  (void)result;
+}
+Strong &reference() __objc3_throws(id<Error>);
+void reject_reference() {
+  __objc3_try_force(reference()); // expected-error {{returns a prvalue}}
+}
