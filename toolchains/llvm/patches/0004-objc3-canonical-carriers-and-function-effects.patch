+++ b/clang/test/ObjC3/AST/Inputs/carrier-expression-adversarial-pch.h
@@ -0,0 +1,26 @@
+using PersistedCount = int;
+using PersistedCountOptional = __objc3_optional(PersistedCount);
+using PersistedNestedOptional = __objc3_optional(PersistedCountOptional);
+using PersistedResult = __objc3_result(PersistedCount, long);
+using PersistedNestedResult =
+    __objc3_result(PersistedResult, PersistedNestedOptional);
+
+inline PersistedNestedOptional persisted_nested_optional() {
+  return __objc3_some(PersistedCountOptional,
+                      __objc3_some(PersistedCount, 0));
+}
+inline PersistedNestedResult persisted_nested_result() {
+  return __objc3_err(PersistedResult, PersistedNestedOptional,
+                     __objc3_some(PersistedCountOptional,
+                                  __objc3_some(PersistedCount, 0)));
+}
+inline bool persisted_nested_queries() {
+  return __objc3_has_value(persisted_nested_optional()) &&
+         !__objc3_is_ok(persisted_nested_result());
+}
+
+template <class T> auto persisted_dependent_nested(T value) {
+  using Inner = __objc3_optional(T);
+  return __objc3_some(Inner, __objc3_some(T, value));
+}
+inline auto persisted_template_instance = persisted_dependent_nested(0);
