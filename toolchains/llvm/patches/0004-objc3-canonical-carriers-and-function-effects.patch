+          S.Context.getBaseElementType(VD->getType())))
+    S.setFunctionHasBranchProtectedScope();
+  if (!S.getLangOpts().CPlusPlus)
+    return;
+  QualType Carrier = S.Context.getCanonicalType(VD->getType());
+  const Type *Ty = Carrier.getTypePtr();
+  if (!isa<ObjC3OptionalType>(Ty) && !isa<ObjC3ResultType>(Ty))
+    return;
+  auto Info = S.Context.getObjC3CarrierRepresentationType(Carrier);
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return;
