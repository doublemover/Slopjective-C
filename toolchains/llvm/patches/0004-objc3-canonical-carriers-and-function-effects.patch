+
+using namespace clang;
+
+ObjC3MatchArm *ObjC3MatchArm::CreateEmpty(const ASTContext &C) {
+  return new (C) ObjC3MatchArm(EmptyShell());
+}
+
+ObjC3MatchStmt *ObjC3MatchStmt::Create(
+    const ASTContext &C, Expr *Scrutinee, llvm::ArrayRef<ObjC3MatchArm *> Arms,
+    SourceLocation Keyword, SourceLocation LParen, SourceLocation RParen,
+    SourceLocation LBrace, SourceLocation RBrace) {
+  void *Mem = C.Allocate(totalSizeToAlloc<Stmt *>(Arms.size() + 1),
+                         alignof(ObjC3MatchStmt));
+  auto *Node = new (Mem) ObjC3MatchStmt(
+      Arms.size(), Keyword, LParen, RParen, LBrace, RBrace);
+  Stmt **Children = Node->getTrailingObjects();
+  Children[0] = Scrutinee;
+  for (unsigned I = 0; I != Arms.size(); ++I)
+    Children[I + 1] = Arms[I];
+  return Node;
+}
+
+ObjC3MatchStmt *ObjC3MatchStmt::CreateEmpty(const ASTContext &C,
+                                             unsigned NumArms) {
+  void *Mem = C.Allocate(totalSizeToAlloc<Stmt *>(NumArms + 1),
+                         alignof(ObjC3MatchStmt));
+  auto *Node = new (Mem) ObjC3MatchStmt(
+      NumArms, SourceLocation(), SourceLocation(), SourceLocation(),
+      SourceLocation(), SourceLocation());
+  std::fill_n(Node->getTrailingObjects(), NumArms + 1, nullptr);
+  return Node;
+}
+
+ObjC3MatchExpr *ObjC3MatchExpr::Create(
+    const ASTContext &C, QualType ResultType, Expr *Scrutinee,
+    llvm::ArrayRef<ObjC3MatchArm *> Arms, SourceLocation Keyword,
+    SourceLocation LParen, SourceLocation RParen, SourceLocation LBrace,
+    SourceLocation RBrace) {
+  void *Mem = C.Allocate(totalSizeToAlloc<Stmt *>(Arms.size() + 1),
+                         alignof(ObjC3MatchExpr));
+  auto *Node = new (Mem) ObjC3MatchExpr(
+      ResultType, Arms.size(), Keyword, LParen, RParen, LBrace, RBrace);
+  Stmt **Children = Node->getTrailingObjects();
+  Children[0] = Scrutinee;
+  for (unsigned I = 0; I != Arms.size(); ++I)
+    Children[I + 1] = Arms[I];
+  Node->setDependence(computeDependence(Node));
+  return Node;
+}
+
+ObjC3MatchExpr *ObjC3MatchExpr::CreateEmpty(const ASTContext &C,
+                                             unsigned NumArms) {
+  void *Mem = C.Allocate(totalSizeToAlloc<Stmt *>(NumArms + 1),
+                         alignof(ObjC3MatchExpr));
+  auto *Node = new (Mem) ObjC3MatchExpr(
+      QualType(), NumArms, SourceLocation(), SourceLocation(),
+      SourceLocation(), SourceLocation(), SourceLocation());
+  std::fill_n(Node->getTrailingObjects(), NumArms + 1, nullptr);
+  return Node;
+}
