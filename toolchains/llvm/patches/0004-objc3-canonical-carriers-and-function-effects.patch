+#pragma once
+#include "../../CodeGen/Inputs/native-c-async-frame.h"
+@protocol Error @end
+@protocol DeductionFirst <Error> @end
+@protocol DeductionSecond <Error> @end
+
+template <class T> struct DeductionTaskRepresentation { void *context; };
+template <class T> using __objc3_async_task = DeductionTaskRepresentation<T>;
+
+using TaskFirst = int (^)(void) __objc3_async __objc3_throws(id<DeductionFirst>);
+using TaskSecond = int (^)(void) __objc3_async __objc3_throws(id<DeductionSecond>);
+using FrameFirst = int (^)(void) __objc3_async_frame __objc3_throws(id<DeductionFirst>);
+using PlainTask = int (^)(void) __objc3_async;
+using BareTask = int (^)(void) __objc3_async __objc3_throws;
+using FrameFunction = int (*)(void) __objc3_async_frame __objc3_throws(id<DeductionFirst>);
+
+template <class R, class E>
+E deduceTaskError(R (^)(void) __objc3_async __objc3_throws(E));
+template <class R, class E>
+E deduceFrameError(R (^)(void) __objc3_async_frame __objc3_throws(E));
+template <class R, class E>
+E deduceFunctionError(R (*)(void) __objc3_async_frame __objc3_throws(E));
+
+// The only use of E is in the checked effect. It is a deduced parameter.
+template <class T> struct DeducedEffects { static constexpr bool match = false; };
+template <class R, class E>
+struct DeducedEffects<R (^)(void) __objc3_async __objc3_throws(E)> {
+  static constexpr bool match = true;
+  using result = R;
+  using error = E;
+};
+
+template <class R> char deduceKind(R (^)(void) __objc3_async);
+template <class R> short deduceKind(R (^)(void) __objc3_async __objc3_throws);
+template <class R, class E>
+long deduceKind(R (^)(void) __objc3_async __objc3_throws(E));
+
+template <class R, class E>
+char deduceRepresentation(R (^)(void) __objc3_async __objc3_throws(E));
+template <class R, class E>
+long deduceRepresentation(R (^)(void) __objc3_async_frame __objc3_throws(E));
+
+template <class R, class E>
+void deduceSpecialization(R (*)(void) __objc3_async_frame __objc3_throws(E));
+template <> void deduceSpecialization(FrameFunction);
+
+template <class R> R deduceFrameAddress(R) __objc3_async_frame;
+using FrameAddress = int (*)(int) __objc3_async_frame;
+inline FrameAddress address = deduceFrameAddress;
