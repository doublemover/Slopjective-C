+TEST(ObjC3ClassImporter, PreservesDefaultedSpecialMemberState) {
+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    std::vector<std::string> Args = {"-xc++", Standard};
+    auto From = tooling::buildASTFromCodeWithArgs(
+        "struct Prefix { long p; }; struct Defaults : Prefix { int n; "
+        "Defaults()=default; Defaults(const Defaults&)=default; "
+        "Defaults& operator=(const Defaults&)=default; ~Defaults()=default; }; "
+        "struct Reference { int &n; Reference()=default; }; "
+        "struct Empty {}; class Access : private Prefix, protected Empty { public: Access(int); }; "
+        "void use(Defaults value) { Defaults copy(value); }", Args, "defaults.cpp");
+    auto To = tooling::buildASTFromCodeWithArgs("", Args, "consumer.cpp");
+    ASSERT_TRUE(From && To);
+    ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                         From->getASTContext(), From->getFileManager(), false);
+    unsigned Members = 0;
+    bool DeletedDefault = false;
+    for (Decl *D : From->getASTContext().getTranslationUnitDecl()->decls()) {
+      auto *Record = dyn_cast<CXXRecordDecl>(D);
+      if (!Record || !Record->isCompleteDefinition()) continue;
+      auto ImportedRecord = Importer.Import(Record);
+      ASSERT_TRUE(static_cast<bool>(ImportedRecord))
+          << llvm::toString(ImportedRecord.takeError());
+      auto *CopyRecord = cast<CXXRecordDecl>(*ImportedRecord);
+      EXPECT_EQ(Record->isStandardLayout(), CopyRecord->isStandardLayout());
+      EXPECT_EQ(Record->isAggregate(), CopyRecord->isAggregate());
+      EXPECT_EQ(Record->isEmpty(), CopyRecord->isEmpty());
+      EXPECT_EQ(Record->canPassInRegisters(), CopyRecord->canPassInRegisters());
+      EXPECT_EQ(Record->hasNonTrivialDestructorForCall(), CopyRecord->hasNonTrivialDestructorForCall());
+      for (CXXMethodDecl *Method : Record->methods()) {
+        if (Method->isImplicit()) continue;
+        auto Imported = Importer.Import(Method);
+        ASSERT_TRUE(static_cast<bool>(Imported)) << llvm::toString(Imported.takeError());
+        auto *Copy = cast<CXXMethodDecl>(*Imported);
+        EXPECT_EQ(Method->isDefaulted(), Copy->isDefaulted());
+        EXPECT_EQ(Method->isExplicitlyDefaulted(), Copy->isExplicitlyDefaulted());
+        EXPECT_EQ(Method->isDeleted(), Copy->isDeleted());
+        EXPECT_EQ(Method->isInlined(), Copy->isInlined());
+        EXPECT_EQ(Method->isTrivialForCall(), Copy->isTrivialForCall());
+        DeletedDefault |= Method->isDefaulted() && Copy->isDeleted();
+        ++Members;
+      }
+    }
+    EXPECT_GE(Members, 5u);
+    EXPECT_TRUE(DeletedDefault);
+  }
+}
