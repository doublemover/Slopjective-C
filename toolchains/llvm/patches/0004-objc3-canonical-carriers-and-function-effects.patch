+    return value > 0;
+  }
+  int exercise(Maybe *input, Maybe *other) {
+    Maybe &source = *counted(input);
+    if (true) {} else { if (live != expectedLive) return -100; return -1; }
+    Payload value(0);
+    Maybe &secondSource = *countedSecond(other, value.number);
+    Payload second(0);
+    (void)accept(value.number);
+    phase = 2;
+    return value.number * 10 + second.number;
+  }
+  void reset() {
+    copies = tempDestructions = firstCalls = secondCalls = filters = badOrder = 0;
+    throwTemp = throwCopy = phase = cleanupOrder = 0;
+    expectedLive = live;
+    expectedFirst = 2;
+    checking = true;
+  }
+  int main() {
+    Maybe some = __objc3_some(Payload, Payload(2));
+    Maybe another = __objc3_some(Payload, Payload(3));
+    Maybe zero = __objc3_some(Payload, Payload(0));
+    Maybe none = __objc3_none(Payload);
+    if (live != 3) return 1;
+    reset();
+    if (exercise(&none, &another) != -1 || firstCalls != 1 ||
+        secondCalls || filters || badOrder || live != expectedLive) return 2;
+    reset();
+    expectedFirst = 0;
+    if (exercise(&zero, &another) != ZERO_RESULT || firstCalls != 1 ||
+        secondCalls != ZERO_SECOND || filters != EXPECTED_FILTERS || badOrder || live != expectedLive) return 3;
+    reset();
+    if (exercise(&some, &none) != -1 || firstCalls != 1 ||
+        secondCalls != 1 || filters != EXPECTED_FILTERS || badOrder || live != expectedLive) return 4;
+    reset();
+    if (exercise(&some, &another) != 23 || firstCalls != 1 ||
+        secondCalls != 1 || filters != EXPECTED_FILTERS || badOrder || live != expectedLive ||
+        cleanupOrder != 32) return 5;
+    for (int failure = 0; failure != 4; ++failure) {
+      reset();
+      throwCopy = failure < 2 ? 3 + failure : 0;
+      throwTemp = failure >= 2 ? 1 + failure : 0;
+      bool caught = false;
+      try { (void)exercise(&some, &another); }
+      catch (int error) { caught = error != 91; }
+      if (!caught || live != expectedLive || firstCalls != 1 ||
+          secondCalls != 1 || filters != EXPECTED_FILTERS || badOrder) return 6 + failure;
+    }
+    checking = false;
+    throwTemp = throwCopy = phase = 0;
+    return 0;
+  }
+)";
