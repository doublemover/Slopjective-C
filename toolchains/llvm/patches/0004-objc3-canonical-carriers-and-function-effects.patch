+      second += first;
+      return second;
+    } else {
+      return first;
+    }
+  }
+)";
+
+std::vector<std::string> conditionArgs() {
+  return {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"};
+}
+
+FunctionDecl *findExercise(ASTUnit &AST) {
+  for (Decl *D : AST.getASTContext().getTranslationUnitDecl()->decls())
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      if (FD->getName() == "exercise" && FD->hasBody())
+        return FD;
+  return nullptr;
+}
+
+class SourceVisitor : public RecursiveASTVisitor<SourceVisitor> {
+public:
+  bool Implicit = false, PostOrder = false, StopAtSource = false;
+  unsigned DeclStatements = 0, Snapshots = 0, SourceReferences = 0;
+  SmallVector<ObjC3BindingCondition *, 4> Bindings;
+  std::vector<std::string> Events;
+
+  bool shouldVisitImplicitCode() const { return Implicit; }
+  bool shouldTraversePostOrder() const { return PostOrder; }
+  bool VisitObjC3BindingCondition(ObjC3BindingCondition *S) {
+    Bindings.push_back(S);
+    Events.push_back("binding:" + S->getBindingDecl()->getNameAsString());
+    return true;
+  }
+  bool VisitDeclStmt(DeclStmt *) {
+    ++DeclStatements;
+    return true;
+  }
+  bool VisitVarDecl(VarDecl *D) {
+    Snapshots += D->isImplicit();
+    if (D->getName() == "first" || D->getName() == "second")
+      Events.push_back("decl:" + D->getNameAsString());
+    return true;
+  }
+  bool VisitDeclRefExpr(DeclRefExpr *E) {
+    if (E->getDecl()->getName() == "source") {
+      ++SourceReferences;
+      Events.push_back("source");
+      return !StopAtSource;
+    }
+    return true;
+  }
+};
+
+class BindingReferences : public RecursiveASTVisitor<BindingReferences> {
+public:
+  std::vector<const ValueDecl *> First, Second;
+  bool VisitDeclRefExpr(DeclRefExpr *E) {
+    if (E->getDecl()->getName() == "first")
+      First.push_back(E->getDecl());
+    if (E->getDecl()->getName() == "second")
+      Second.push_back(E->getDecl());
+    return true;
+  }
+};
+
+void findJSONNodes(const llvm::json::Object &Node, StringRef Kind,
+                   SmallVectorImpl<const llvm::json::Object *> &Found) {
+  if (Node.getString("kind") == Kind)
+    Found.push_back(&Node);
+  if (const auto *Inner = Node.getArray("inner"))
+    for (const auto &Child : *Inner)
+      if (const auto *Object = Child.getAsObject())
+        findJSONNodes(*Object, Kind, Found);
+}
+
+std::string dumpJSON(FunctionDecl *FD, TraversalKind Kind) {
+  std::string Buffer;
+  llvm::raw_string_ostream OS(Buffer);
+  ASTContext &C = FD->getASTContext();
+  JSONDumper Dumper(OS, C.getSourceManager(), C, C.getPrintingPolicy(),
+                    nullptr);
+  Dumper.SetTraversalKind(Kind);
+  Dumper.Visit(FD->getBody());
+  return Buffer;
+}
+
+class Occurrences : public index::IndexDataConsumer {
+public:
+  struct Occurrence {
+    const NamedDecl *Declaration;
+    index::SymbolRoleSet Roles;
+    SourceLocation Location;
+  };
+  std::vector<Occurrence> Items;
+  bool handleDeclOccurrence(const Decl *D, index::SymbolRoleSet Roles,
+                            ArrayRef<index::SymbolRelation>, SourceLocation Loc,
+                            ASTNodeInfo) override {
+    if (const auto *ND = dyn_cast<NamedDecl>(D))
+      Items.push_back({ND, Roles, Loc});
+    return true;
+  }
+  unsigned count(StringRef Name, index::SymbolRole Role) const {
+    return std::count_if(Items.begin(), Items.end(), [&](const auto &Item) {
+      return Item.Declaration->getName() == Name &&
+             (Item.Roles & static_cast<unsigned>(Role));
+    });
+  }
+};
+
