+  auto From = tooling::buildASTFromCodeWithArgs(
+      ConditionSource, conditionArgs(), "condition-import.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      "", conditionArgs(), "condition-target.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(),
+      {{"condition-import.mm", ConditionSource.str()}});
