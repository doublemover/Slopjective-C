+struct Worker {
+  int value(int) const __objc3_async;
+  int operator()(int) const __objc3_async;
+};
+int conditions(Worker &worker) __objc3_async {
+  using Member = int (Worker::*)(int) const __objc3_async;
+  Member member = &Worker::value;
+  // Tentative condition parsing must leave the reserved unary spelling intact.
