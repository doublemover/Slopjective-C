+                    Context, Expr::NPC_ValueDependentIsNotNull))
+              V.set(0);
+            const bool Unowned = ownerIsUnowned(Variable->getInit(), State);
+            Value Owner = ownerIdentity(Variable->getInit(), State);
+            if (OwnerRoots.count(Variable) && Owner.none())
+              Owner.set(OwnerRoots.lookup(Variable));
+            Storage Target = referent(Variable->getInit(), &State);
+            Value Targets = possibleTargets(Variable->getInit(), State);
+            if (Targets.any() && Variable->hasLocalStorage() &&
+                !isObjC3BorrowedType(Context, Variable->getType()))
+              V = empty(); // Its address exposes the pointee's current facts.
+            Value Effects = effects(Variable->getInit(), State);
+            if (Targets.any() && !isObjC3BorrowedType(Context, Variable->getType())) Effects = empty();
+            store(Node, {Variable, nullptr}, V, State, Emit, false, &Effects);
+            State.LocalTargets[Slots.lookup({Variable, nullptr})] = Target;
+            State.MayTargets[Slots.lookup({Variable, nullptr})] = std::move(Targets);
+            State.OwnerIdentities[Slots.lookup({Variable, nullptr})] = std::move(Owner);
+            const unsigned OwnerSlot = Slots.lookup({Variable, nullptr});
+            if (Unowned) State.UnownedOwners.set(OwnerSlot);
+            else State.UnownedOwners.reset(OwnerSlot);
+            initializeRecord(Node, Variable, Variable->getInit(), State, Emit);
+            initializeArray(Node, Variable, Variable->getInit(), State, Emit);
+            if (auto Found = Pins.find(Variable); Found != Pins.end()) {
+              bool Released = Unowned;
+              if (const VarDecl *Source = PinSources.lookup(Variable))
