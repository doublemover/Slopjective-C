diff --git a/clang/test/ObjC3/AST/Inputs/resource-ownership.h b/clang/test/ObjC3/AST/Inputs/resource-ownership.h
new file mode 100644
index 000000000..19a5c8736
--- /dev/null
+++ b/clang/test/ObjC3/AST/Inputs/resource-ownership.h
@@ -0,0 +1,38 @@
+#ifndef OBJC3_RESOURCE_OWNERSHIP_PCH_H
+#define OBJC3_RESOURCE_OWNERSHIP_PCH_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+void close_resource(int) __attribute__((nothrow));
+void close_resource_address(int *) __attribute__((nothrow));
+static inline int resource_pch_value(int input) {
+  int value __attribute__((objc_resource(close=close_resource, invalid=-1))) = input;
+  return value;
+}
+static inline void resource_pch_address(int input) {
+  int value __attribute__((objc_resource(invalid=0, close=close_resource_address))) = input;
+}
+#ifdef __cplusplus
+}
+#endif
+static inline int resource_pch_transfer(int input) {
+  @resource(close_resource, invalid: -1) int value = input;
+  reset(value, input + 1);
+  int result = take(value);
+  discard(value);
+  return result;
+}
+static inline void cleanup_pch_value(int input) {
+  @cleanup(close_resource) int value = input;
+  value = input + 1;
+}
+static inline void cleanup_pch_address(int input) {
+  int value __attribute__((cleanup(close_resource_address))) = input;
+}
+#ifdef __cplusplus
+template<int Value> int resource_template_transfer() {
+  @resource(close_resource, invalid: -1) int value = Value;
+  return take(value);
+}
+#endif
+#endif
