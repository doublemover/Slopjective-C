+typedef __objc3_result(int, long) IntLongResult;
+typedef __objc3_result(int, long) IntLongResultAlias;
+
+_Static_assert(__builtin_types_compatible_p(__typeof__(__objc3_some(int, 0)),
+                                            OptionalInt),
+               "typeof preserves the canonical Optional result type");
+_Static_assert(__builtin_types_compatible_p(
+                   __typeof__(__objc3_ok(int, long, 0)), IntLongResult),
+               "typeof preserves the ordered Result arms");
+
+_Static_assert(_Generic(__objc3_some(int, 0), OptionalIntAlias: 1, default: 0),
+               "_Generic matches a carrier through a payload alias");
+_Static_assert(_Generic(__objc3_ok(int, long, 0), IntLongResultAlias: 1,
+                        default: 0),
+               "_Generic matches the exact ordered Result carrier");
+
+OptionalInt choose_optional(_Bool choose, int value) {
+  return choose ? __objc3_some(int, value) : __objc3_none(int);
+}
+IntLongResult choose_result(_Bool choose, int value, long error) {
+  return choose ? __objc3_ok(int, long, value)
+                : __objc3_err(int, long, error);
+}
