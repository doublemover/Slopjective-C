+    auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"factory-value-from.mm");
+    auto Relocated=tooling::buildASTFromCodeWithArgs("\n\n"+Source,Args,"relocated-factory-value.mm");
+    auto To=tooling::buildASTFromCodeWithArgs("",Args,"factory-value-to.mm");
+    ASSERT_TRUE(From && Relocated && To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    auto identities=[](ASTContext &Context) {
+      std::set<std::string> Result;
+      for(auto *D:Context.getTranslationUnitDecl()->decls())
+        if(auto *Function=dyn_cast<FunctionDecl>(D);Function && Function->getName()=="use") {
+          llvm::SmallString<128> USR;
+          EXPECT_FALSE(index::generateUSRForDecl(Function,USR));Result.insert(USR.str().str());
+        }
+      return Result;
+    };
+    const auto Expected=identities(From->getASTContext());EXPECT_EQ(Expected.size(),3u);
+    EXPECT_EQ(Expected,identities(Relocated->getASTContext()));
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+    for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls()) {
+      auto Imported=Importer.Import(D);ASSERT_TRUE(bool(Imported))<<llvm::toString(Imported.takeError());
+    }
+    EXPECT_EQ(Expected,identities(To->getASTContext()));
+  }
+}
