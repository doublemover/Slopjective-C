+++ b/clang/unittests/AST/ObjC3CarrierTypeTest.cpp
@@ -0,0 +1,286 @@
+//===--- ObjC3CarrierTypeTest.cpp - Canonical carrier AST tests
+//------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/TypeLoc.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(Source, {"-std=c++20"},
+                                           "objc3-carrier-types.cpp");
+}
+
+std::unique_ptr<ASTUnit> parseObjC3(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-carrier-effects.mm");
+}
+NamedDecl *lookup(ASTContext &Ctx, llvm::StringRef Name) {
+  auto Decls = Ctx.getTranslationUnitDecl()->lookup(&Ctx.Idents.get(Name));
+  return Decls.empty() ? nullptr : Decls.front();
+}
+
+TEST(ObjC3CarrierTypes, CanonicalIdentityStripsPayloadAliases) {
+  auto AST = parse("typedef int IntAlias; struct Payload {}; ");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *Alias = dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "IntAlias"));
+  ASSERT_NE(Alias, nullptr);
+
+  QualType AliasType = Ctx.getTypeDeclType(Alias);
+  QualType BySpelling = Ctx.getObjC3OptionalType(AliasType);
+  QualType ByCanonical = Ctx.getObjC3OptionalType(Ctx.IntTy);
+  EXPECT_EQ(BySpelling.getCanonicalType().getAsOpaquePtr(),
+            ByCanonical.getCanonicalType().getAsOpaquePtr());
+  EXPECT_EQ(cast<ObjC3OptionalType>(BySpelling)->getElementType(), Ctx.IntTy);
+
+  QualType ResultA = Ctx.getObjC3ResultType(AliasType, Ctx.IntTy);
+  QualType ResultB = Ctx.getObjC3ResultType(Ctx.IntTy, AliasType);
+  EXPECT_EQ(ResultA.getCanonicalType().getAsOpaquePtr(),
+            ResultB.getCanonicalType().getAsOpaquePtr());
+  EXPECT_NE(Ctx.getObjC3ResultType(Ctx.IntTy, Ctx.CharTy)
+                .getCanonicalType()
+                .getAsOpaquePtr(),
+            ResultA.getCanonicalType().getAsOpaquePtr());
+}
+
+TEST(ObjC3CarrierTypes, TemplateSubstitutionBuildsCanonicalCarrierPayload) {
+  auto AST = parseObjC3(R"cpp(
+    typedef int IntAlias;
+    template <class T> using Maybe = __objc3_optional(T);
+    using AliasMaybe = __objc3_optional(IntAlias);
+    using IntMaybe = __objc3_optional(int);
+    using Instantiated = Maybe<const long *>;
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *AliasMaybe =
+      dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "AliasMaybe"));
+  auto *IntMaybe = dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "IntMaybe"));
+  auto *Instantiated =
+      dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "Instantiated"));
+  ASSERT_NE(AliasMaybe, nullptr);
+  ASSERT_NE(IntMaybe, nullptr);
+  ASSERT_NE(Instantiated, nullptr);
+  EXPECT_EQ(AliasMaybe->getUnderlyingType().getCanonicalType(),
+            IntMaybe->getUnderlyingType().getCanonicalType());
+  const auto *Optional =
+      Instantiated->getUnderlyingType()->getAs<ObjC3OptionalType>();
+  ASSERT_NE(Optional, nullptr);
+  EXPECT_TRUE(Optional->getElementType()->isPointerType());
+  EXPECT_TRUE(Optional->getElementType()->getPointeeType().isConstQualified());
+}
+TEST(ObjC3CarrierTypes, UsesTargetRecordLayoutAndRepresentsVoidPresence) {
+  auto AST = parse(R"cpp(
+    struct alignas(16) Aligned { unsigned char bytes[16]; };
+    struct NonTrivial { NonTrivial(); NonTrivial(const NonTrivial &) = delete;
+                       ~NonTrivial(); };
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+
+  QualType AlignedTy =
+      Ctx.getCanonicalTagType(cast<RecordDecl>(lookup(Ctx, "Aligned")));
+  QualType Optional = Ctx.getObjC3OptionalType(AlignedTy);
+  auto Layout = Ctx.getObjC3CarrierRepresentationType(Optional);
+  ASSERT_EQ(Layout.State, ObjC3CarrierRepresentationInfo::Status::Materialized);
+  ASSERT_NE(Layout.Type, QualType());
+  ASSERT_NE(Layout.Record, nullptr);
+  ASSERT_NE(Layout.PayloadUnion, nullptr);
+  ASSERT_NE(Layout.TagField, nullptr);
+  ASSERT_NE(Layout.PayloadField, nullptr);
+  ASSERT_NE(Layout.ValueField, nullptr);
+  EXPECT_EQ(Ctx.getTypeSize(Optional), Ctx.getTypeSize(Layout.Type));
+  EXPECT_EQ(Ctx.getTypeAlign(Optional), Ctx.getTypeAlign(Layout.Type));
+  EXPECT_GE(Ctx.getTypeAlign(Layout.Type), Ctx.getTypeAlign(AlignedTy));
+  EXPECT_FALSE(Layout.CallABIClassificationAvailable);
+
+  QualType OptionalVoid = Ctx.getObjC3OptionalType(Ctx.VoidTy);
+  auto VoidLayout = Ctx.getObjC3CarrierRepresentationType(OptionalVoid);
+  ASSERT_EQ(VoidLayout.State,
+            ObjC3CarrierRepresentationInfo::Status::Materialized);
+  EXPECT_EQ(VoidLayout.PayloadUnion, nullptr);
+  EXPECT_EQ(VoidLayout.PayloadField, nullptr);
+  EXPECT_EQ(VoidLayout.ValueField, nullptr);
+  EXPECT_GT(Ctx.getTypeSize(VoidLayout.Type), 0u);
+
+  QualType Result = Ctx.getObjC3ResultType(Ctx.VoidTy, Ctx.IntTy);
+  auto ResultLayout = Ctx.getObjC3CarrierRepresentationType(Result);
+  ASSERT_EQ(ResultLayout.State,
+            ObjC3CarrierRepresentationInfo::Status::Materialized);
+  EXPECT_EQ(ResultLayout.SuccessField, nullptr);
+  ASSERT_NE(ResultLayout.ErrorField, nullptr);
+  EXPECT_NE(ResultLayout.PayloadUnion, nullptr);
+  EXPECT_GT(ResultLayout.ErrorOffsetBits, 0u);
+}
+
+TEST(ObjC3CarrierTypes, DefersDependentAndRejectsUnrepresentablePayloads) {
+  auto AST = parse(R"cpp(
+    struct NonTrivial { NonTrivial(); NonTrivial(const NonTrivial &) = delete;
+                       ~NonTrivial(); };
+    struct Incomplete;
+    using ArrayPayload = int[4];
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+
+  QualType Dependent = Ctx.getTemplateTypeParmType(0, 0, false);
+  auto Deferred = Ctx.getObjC3CarrierRepresentationType(
+      Ctx.getObjC3OptionalType(Dependent));
+  EXPECT_EQ(Deferred.State, ObjC3CarrierRepresentationInfo::Status::Deferred);
+
+  QualType Incomplete =
+      Ctx.getCanonicalTagType(cast<RecordDecl>(lookup(Ctx, "Incomplete")));
+  auto DeferredIncomplete = Ctx.getObjC3CarrierRepresentationType(
+      Ctx.getObjC3OptionalType(Incomplete));
+  EXPECT_EQ(DeferredIncomplete.State,
+            ObjC3CarrierRepresentationInfo::Status::Deferred);
+
+  QualType Function = Ctx.getFunctionNoProtoType(Ctx.IntTy);
+  auto Unsupported =
+      Ctx.getObjC3CarrierRepresentationType(Ctx.getObjC3OptionalType(Function));
+  EXPECT_EQ(Unsupported.State,
+            ObjC3CarrierRepresentationInfo::Status::Unsupported);
+
+  auto *ArrayDecl =
+      dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "ArrayPayload"));
+  ASSERT_NE(ArrayDecl, nullptr);
+  auto UnsupportedArray = Ctx.getObjC3CarrierRepresentationType(
+      Ctx.getObjC3OptionalType(Ctx.getTypeDeclType(ArrayDecl)));
+  EXPECT_EQ(UnsupportedArray.State,
+            ObjC3CarrierRepresentationInfo::Status::Unsupported);
+
+  auto *Payload = dyn_cast_or_null<RecordDecl>(lookup(Ctx, "NonTrivial"));
+  ASSERT_NE(Payload, nullptr);
+  QualType PayloadTy = Ctx.getCanonicalTagType(Payload);
+  auto NonTrivialLayout = Ctx.getObjC3CarrierRepresentationType(
+      Ctx.getObjC3OptionalType(PayloadTy));
+  ASSERT_EQ(NonTrivialLayout.State,
+            ObjC3CarrierRepresentationInfo::Status::Materialized);
+  EXPECT_EQ(NonTrivialLayout.ValueField->getType(), PayloadTy);
+
+  QualType Nested =
+      Ctx.getObjC3OptionalType(Ctx.getObjC3OptionalType(Ctx.IntTy));
+  auto NestedLayout = Ctx.getObjC3CarrierRepresentationType(Nested);
+  ASSERT_EQ(NestedLayout.State,
+            ObjC3CarrierRepresentationInfo::Status::Materialized);
+  EXPECT_EQ(NestedLayout.ValueField->getType(),
+            Ctx.getObjC3OptionalType(Ctx.IntTy));
+}
+
+TEST(ObjC3CarrierTypes, TypeLocKeepsIndependentChildSourceInfoAndPrints) {
+  auto AST = parse("typedef int IntAlias; ");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *Alias = dyn_cast_or_null<TypedefNameDecl>(lookup(Ctx, "IntAlias"));
+  ASSERT_NE(Alias, nullptr);
+
+  QualType AliasType = Ctx.getTypeDeclType(Alias);
+  QualType Optional = Ctx.getObjC3OptionalType(AliasType);
+  TypeSourceInfo *Root = Ctx.getTrivialTypeSourceInfo(Optional);
+  TypeSourceInfo *Child = Ctx.getTrivialTypeSourceInfo(AliasType);
+  auto TL = Root->getTypeLoc().getAs<ObjC3OptionalTypeLoc>();
+  TL.setKeywordLoc(SourceLocation::getFromRawEncoding(1));
+  TL.setLParenLoc(SourceLocation::getFromRawEncoding(2));
+  TL.setRParenLoc(SourceLocation::getFromRawEncoding(3));
+  TL.setElementLoc(Child);
+  EXPECT_EQ(TL.getElementLoc(), Child);
+  EXPECT_EQ(TL.getLocalSourceRange().getBegin(), TL.getKeywordLoc());
+  EXPECT_EQ(TL.getLocalSourceRange().getEnd(), TL.getRParenLoc());
+  EXPECT_EQ(Optional.getAsString(), "Optional(int)");
+
+  QualType Result = Ctx.getObjC3ResultType(Ctx.IntTy, Ctx.CharTy);
+  TypeSourceInfo *ResultRoot = Ctx.getTrivialTypeSourceInfo(Result);
+  TypeSourceInfo *Success = Ctx.getTrivialTypeSourceInfo(Ctx.IntTy);
+  TypeSourceInfo *Error = Ctx.getTrivialTypeSourceInfo(Ctx.CharTy);
+  auto ResultTL = ResultRoot->getTypeLoc().getAs<ObjC3ResultTypeLoc>();
+  ResultTL.setKeywordLoc(SourceLocation::getFromRawEncoding(4));
+  ResultTL.setLParenLoc(SourceLocation::getFromRawEncoding(5));
+  ResultTL.setCommaLoc(SourceLocation::getFromRawEncoding(6));
+  ResultTL.setRParenLoc(SourceLocation::getFromRawEncoding(7));
+  ResultTL.setSuccessLoc(Success);
+  ResultTL.setErrorLoc(Error);
+  EXPECT_EQ(ResultTL.getSuccessLoc(), Success);
+  EXPECT_EQ(ResultTL.getErrorLoc(), Error);
+  EXPECT_EQ(ResultTL.getCommaLoc(), SourceLocation::getFromRawEncoding(6));
+  EXPECT_EQ(Result.getAsString(), "Result(int, char)");
+}
+
+TEST(ObjC3CarrierTypes, DeferredRepresentationRetriesAfterCompletion) {
+  auto AST = parse("");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *Payload = RecordDecl::Create(
+      Ctx, TagTypeKind::Struct, Ctx.getTranslationUnitDecl(), SourceLocation(),
+      SourceLocation(), &Ctx.Idents.get("LatePayload"));
+  QualType PayloadType = Ctx.getCanonicalTagType(Payload);
+  QualType Carrier = Ctx.getObjC3OptionalType(PayloadType);
+  EXPECT_TRUE(Carrier->isIncompleteType());
+  EXPECT_EQ(Ctx.getObjC3CarrierRepresentationType(Carrier).State,
+            ObjC3CarrierRepresentationInfo::Status::Deferred);
+  Payload->startDefinition();
+  auto *Field =
+      FieldDecl::Create(Ctx, Payload, SourceLocation(), SourceLocation(),
+                        &Ctx.Idents.get("value"), Ctx.IntTy, nullptr, nullptr,
+                        false, ICIS_NoInit);
+  Payload->addDecl(Field);
+  Payload->completeDefinition();
+  EXPECT_FALSE(Carrier->isIncompleteType());
+  auto Representation = Ctx.getObjC3CarrierRepresentationType(Carrier);
+  ASSERT_EQ(Representation.State,
+            ObjC3CarrierRepresentationInfo::Status::Materialized);
+  EXPECT_EQ(Ctx.getTypeSize(Carrier), Ctx.getTypeSize(Representation.Type));
+}
+
+TEST(ObjC3CarrierTypes,
+     ImportPreservesChildAssociationAndConstructorLocations) {
+  auto From = tooling::buildASTFromCodeWithArgs(
+      "typedef __objc3_result(__objc3_optional(const int *), void) Imported;",
+      {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"}, "from.mm");
+  auto To = parse("");
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  auto *FromDecl = dyn_cast_or_null<TypedefNameDecl>(
+      lookup(From->getASTContext(), "Imported"));
+  ASSERT_NE(FromDecl, nullptr);
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  auto Imported = Importer.Import(FromDecl);
+  if (!Imported) {
+    ADD_FAILURE() << llvm::toString(Imported.takeError());
+    return;
+  }
+  auto *ToDecl = cast<TypedefNameDecl>(*Imported);
+  auto Root =
+      ToDecl->getTypeSourceInfo()->getTypeLoc().getAs<ObjC3ResultTypeLoc>();
+  ASSERT_FALSE(Root.isNull());
+  ASSERT_NE(Root.getSuccessLoc(), nullptr);
+  auto Child = Root.getSuccessLoc()->getTypeLoc().getAs<ObjC3OptionalTypeLoc>();
+  ASSERT_FALSE(Child.isNull());
+  ASSERT_NE(Child.getElementLoc(), nullptr);
+  EXPECT_TRUE(Child.getElementLoc()->getType()->isPointerType());
+  EXPECT_TRUE(
+      Child.getElementLoc()->getType()->getPointeeType().isConstQualified());
+  EXPECT_TRUE(Root.getKeywordLoc().isValid());
+  EXPECT_TRUE(Root.getCommaLoc().isValid());
+  EXPECT_TRUE(Child.getLParenLoc().isValid());
+  EXPECT_NE(Root.getSuccessLoc(), FromDecl->getTypeSourceInfo()
+                                      ->getTypeLoc()
+                                      .getAs<ObjC3ResultTypeLoc>()
+                                      .getSuccessLoc());
+}
+
+} // namespace
diff --git a/clang/unittests/AST/ObjC3DoCatchPersistenceTest.cpp b/clang/unittests/AST/ObjC3DoCatchPersistenceTest.cpp
new file mode 100644
index 000000000..a265ccc8e
--- /dev/null
+++ b/clang/unittests/AST/ObjC3DoCatchPersistenceTest.cpp
@@ -0,0 +1,104 @@
+//===--- ObjC3DoCatchPersistenceTest.cpp - do/catch import -----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+
+#include <string>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+class FindDoCatch : public RecursiveASTVisitor<FindDoCatch> {
+public:
+  ObjC3DoCatchStmt *Found = nullptr;
+  bool VisitObjC3DoCatchStmt(ObjC3DoCatchStmt *S) {
+    Found = S;
+    return false;
+  }
+};
+
+class FindCatchBinding : public RecursiveASTVisitor<FindCatchBinding> {
+public:
+  VarDecl *Binding = nullptr;
+  DeclRefExpr *Reference = nullptr;
+  bool VisitVarDecl(VarDecl *D) {
+    if (D->getName() == "error")
+      Binding = D;
+    return true;
+  }
+  bool VisitDeclRefExpr(DeclRefExpr *E) {
+    if (E->getDecl()->getName() == "error")
+      Reference = E;
+    return true;
+  }
+};
+} // namespace
+
+TEST(ObjC3DoCatchPersistence, ImportsOrderedClausesAndBindingIntoTarget) {
+  const std::string FromCode = R"(
+    struct Error { int Value; };
+    void typed() __objc3_throws(Error);
+    void handled() {
+      __objc3_do { __objc3_try(typed()); }
+      __objc3_catch(Error error) { (void)error; }
+      __objc3_catch { }
+    }
+  )";
+  const std::string ToCode = "struct Error { int Value; };\n";
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                         "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(FromCode, Args, "from.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      ToCode, Args, "to.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"from.mm", FromCode}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  auto Decls = FromContext.getTranslationUnitDecl()->lookup(
+      &FromContext.Idents.get("handled"));
+  FunctionDecl *Function = nullptr;
+  for (Decl *D : Decls)
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      Function = FD;
+  ASSERT_NE(Function, nullptr);
+  FindDoCatch FindFrom;
+  FindFrom.TraverseStmt(Function->getBody());
+  ASSERT_NE(FindFrom.Found, nullptr);
+  ASSERT_EQ(FindFrom.Found->getNumCatchClauses(), 2u);
+  EXPECT_TRUE(FindFrom.Found->getCatchClause(0)->getCatchTypeInfo());
+  EXPECT_TRUE(FindFrom.Found->getCatchClause(1)->isCatchAll());
+
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), /*MinimalImport=*/false);
+  auto Imported = Importer.Import(FindFrom.Found);
+  ASSERT_TRUE(static_cast<bool>(Imported))
+      << llvm::toString(Imported.takeError());
+  auto *ImportedDoCatch = dyn_cast<ObjC3DoCatchStmt>(*Imported);
+  ASSERT_NE(ImportedDoCatch, nullptr);
+  EXPECT_EQ(ImportedDoCatch->getNumCatchClauses(), 2u);
+  EXPECT_FALSE(ImportedDoCatch->getCatchClause(0)->isCatchAll());
+  EXPECT_TRUE(ImportedDoCatch->getCatchClause(1)->isCatchAll());
+
+  FindCatchBinding FindTarget;
+  FindTarget.TraverseStmt(ImportedDoCatch);
+  ASSERT_NE(FindTarget.Binding, nullptr);
+  ASSERT_NE(FindTarget.Reference, nullptr);
+  EXPECT_EQ(FindTarget.Reference->getDecl(), FindTarget.Binding);
+  EXPECT_EQ(&FindTarget.Binding->getASTContext(), &ToContext);
+  QualType ImportedCatchType =
+      ImportedDoCatch->getCatchClause(0)->getCatchTypeInfo()->getType();
+  const auto *ImportedRecord = ImportedCatchType->getAs<RecordType>();
+  ASSERT_NE(ImportedRecord, nullptr);
+  EXPECT_EQ(&ImportedRecord->getDecl()->getASTContext(), &ToContext);
+}
diff --git a/clang/unittests/AST/ObjC3FunctionEffectImportTest.cpp b/clang/unittests/AST/ObjC3FunctionEffectImportTest.cpp
new file mode 100644
index 000000000..3d215aace
--- /dev/null
+++ b/clang/unittests/AST/ObjC3FunctionEffectImportTest.cpp
@@ -0,0 +1,261 @@
+//===--- ObjC3FunctionEffectImportTest.cpp - effect type import -----------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Type.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+
+FunctionDecl *findFunction(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls =
+      Context.getTranslationUnitDecl()->lookup(&Context.Idents.get(Name));
+  for (Decl *D : Decls)
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      return FD;
+  return nullptr;
+}
+
+QualType recordType(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls =
+      Context.getTranslationUnitDecl()->lookup(&Context.Idents.get(Name));
+  for (Decl *D : Decls)
+    if (auto *RD = dyn_cast<RecordDecl>(D))
+      return Context.getCanonicalTagType(RD);
+  return {};
+}
+
+bool structurallyEquivalent(ASTContext &FromContext, QualType From,
+                            ASTContext &ToContext, QualType To) {
+  StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalentDecls;
+  StructuralEquivalenceContext Context(
+      FromContext.getLangOpts(), FromContext, ToContext, NonEquivalentDecls,
+      StructuralEquivalenceKind::Default, /*StrictTypeSpelling=*/false,
+      /*Complain=*/false);
+  return Context.IsEquivalent(From, To);
+}
+
+TEST(ObjC3FunctionEffectImport, CanonicalEffectsAndPayloadsImportIntoTarget) {
+  const std::string FromCode = R"(
+    struct Error { int Value; };
+    typedef Error ErrorAlias;
+    struct Other { int Value; };
+    void plain_effect();
+    void async_effect() __objc3_async;
+    void untyped_effect() __objc3_throws;
+    void typed_effect() __objc3_throws(Error);
+    void typed_alias_effect() __objc3_throws(ErrorAlias);
+    void other_payload_effect() __objc3_throws(Other);
+    void qualified_pointer_effect() __objc3_async __objc3_throws(const Error *);
+    void noexcept_effect() noexcept __objc3_throws(Error);
+  )";
+  const std::string ToCode = R"(
+    struct Error { int Value; };
+    typedef Error ErrorAlias;
+    struct Other { int Value; };
+  )";
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                         "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(FromCode, Args, "from.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      ToCode, Args, "to.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"from.mm", FromCode}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+
+  // The mapped source buffer remains available to the target FileManager for
+  // imported declaration/type source locations, without full-test utilities.
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), /*MinimalImport=*/false);
+
+  auto ImportFunctionType = [&](llvm::StringRef Name) -> QualType {
+    FunctionDecl *FD = findFunction(FromContext, Name);
+    EXPECT_NE(FD, nullptr) << Name;
+    if (!FD)
+      return {};
+    auto Imported = Importer.Import(FD->getType());
+    if (!Imported) {
+      ADD_FAILURE() << llvm::toString(Imported.takeError());
+      return {};
+    }
+    return *Imported;
+  };
+
+  QualType Plain = ImportFunctionType("plain_effect");
+  QualType Async = ImportFunctionType("async_effect");
+  QualType Untyped = ImportFunctionType("untyped_effect");
+  QualType Typed = ImportFunctionType("typed_effect");
+  QualType TypedAlias = ImportFunctionType("typed_alias_effect");
+  QualType OtherPayload = ImportFunctionType("other_payload_effect");
+  QualType QualifiedPointer = ImportFunctionType("qualified_pointer_effect");
+  QualType Noexcept = ImportFunctionType("noexcept_effect");
+  ASSERT_FALSE(Plain.isNull());
+  ASSERT_FALSE(Async.isNull());
+  ASSERT_FALSE(Untyped.isNull());
+  ASSERT_FALSE(Typed.isNull());
+  ASSERT_FALSE(TypedAlias.isNull());
+  ASSERT_FALSE(OtherPayload.isNull());
+  ASSERT_FALSE(QualifiedPointer.isNull());
+  ASSERT_FALSE(Noexcept.isNull());
+
+  EXPECT_TRUE(ToContext.hasSameType(Typed, TypedAlias));
+  EXPECT_FALSE(ToContext.hasSameType(Plain, Async));
+  EXPECT_FALSE(ToContext.hasSameType(Plain, Untyped));
+  EXPECT_FALSE(ToContext.hasSameType(Untyped, Typed));
+  EXPECT_FALSE(ToContext.hasSameType(Typed, OtherPayload));
+  EXPECT_FALSE(ToContext.hasSameType(Async, QualifiedPointer));
+
+  const auto *TypedProto = Typed->castAs<FunctionProtoType>();
+  ASSERT_EQ(TypedProto->getObjC3ThrowsKind(), ObjC3ThrowsKind::Typed);
+  QualType ImportedError = TypedProto->getObjC3ErrorType();
+  QualType TargetError = recordType(ToContext, "Error");
+  ASSERT_FALSE(TargetError.isNull());
+  EXPECT_TRUE(ToContext.hasSameType(ImportedError, TargetError));
+  auto *ImportedErrorDecl =
+      cast<RecordType>(ImportedError.getCanonicalType().getTypePtr())
+          ->getDecl();
+  EXPECT_EQ(&ImportedErrorDecl->getASTContext(), &ToContext);
+
+  const auto *QualifiedProto = QualifiedPointer->castAs<FunctionProtoType>();
+  ASSERT_TRUE(QualifiedProto->isObjC3Async());
+  QualType ErrorPointer = QualifiedProto->getObjC3ErrorType();
+  ASSERT_TRUE(ErrorPointer->isPointerType());
+  EXPECT_TRUE(ErrorPointer->getPointeeType().isConstQualified());
+  EXPECT_TRUE(ToContext.hasSameType(ErrorPointer->getPointeeType(),
+                                    TargetError.withConst()));
+
+  const auto *NoexceptProto = Noexcept->castAs<FunctionProtoType>();
+  EXPECT_EQ(NoexceptProto->getExceptionSpecType(), EST_BasicNoexcept);
+  EXPECT_EQ(NoexceptProto->getObjC3ThrowsKind(), ObjC3ThrowsKind::Typed);
+  EXPECT_FALSE(ToContext.hasSameType(Noexcept, Typed));
+
+  QualType ReimportedTyped = ImportFunctionType("typed_effect");
+  EXPECT_EQ(ReimportedTyped, Typed);
+  EXPECT_TRUE(structurallyEquivalent(
+      FromContext, findFunction(FromContext, "typed_effect")->getType(),
+      ToContext, TypedAlias));
+  EXPECT_FALSE(structurallyEquivalent(
+      FromContext, findFunction(FromContext, "typed_effect")->getType(),
+      ToContext, OtherPayload));
+  EXPECT_FALSE(structurallyEquivalent(
+      FromContext, findFunction(FromContext, "typed_effect")->getType(),
+      ToContext, Async));
+}
+
+
+TEST(ObjC3MethodEffectImport, PreservesCanonicalMethodEffect) {
+  const std::string Code = "@interface Widget\n- (int)value __objc3_throws(int);\n@end\n";
+  const std::vector<std::string> Args = {"-x", "objective-c", "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(Code, Args, "method-from.m");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      "", Args, "method-to.m", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"method-from.m", Code}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  auto Decls = From->getASTContext().getTranslationUnitDecl()->lookup(
+      &From->getASTContext().Idents.get("Widget"));
+  auto *Interface = cast<ObjCInterfaceDecl>(Decls.front());
+  auto *Method = *Interface->meth_begin();
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  auto Imported = Importer.Import(Method);
+  ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+  auto *Target = cast<ObjCMethodDecl>(*Imported);
+  EXPECT_EQ(Target->getObjC3FunctionEffects().Throws, ObjC3ThrowsKind::Typed);
+  EXPECT_TRUE(To->getASTContext().hasSameType(
+      Target->getObjC3FunctionEffects().ErrorType, To->getASTContext().IntTy));
+  EXPECT_EQ(&Target->getASTContext(), &To->getASTContext());
+  EXPECT_EQ(Target->getSelector().getAsString(), "value");
+}
+
+
+TEST(ObjC3MethodEffectImport, RejectsEffectChangesWhenMerging) {
+  const std::vector<std::string> Args = {"-x", "objective-c", "-fobjc-version=3"};
+  const char *Effects[] = {"", " __objc3_throws(int)", " __objc3_throws(long)"};
+  for (const char *FromEffect : Effects) {
+    for (const char *ToEffect : Effects) {
+      const std::string FromCode = std::string("@interface Widget\n- (int)value") +
+                                   FromEffect + ";\n@end\n";
+      const std::string ToCode = std::string("@interface Widget\n- (int)value") +
+                                 ToEffect + ";\n@end\n";
+      auto From = tooling::buildASTFromCodeWithArgs(FromCode, Args, "merge-from.m");
+      auto To = tooling::buildASTFromCodeWithArgs(
+          ToCode, Args, "merge-to.m", "clang-tool",
+          std::make_shared<PCHContainerOperations>(),
+          tooling::getClangStripDependencyFileAdjuster(), {{"merge-from.m", FromCode}});
+      ASSERT_TRUE(From);
+      ASSERT_TRUE(To);
+      auto FindMethod = [](ASTContext &Context) {
+        auto Decls = Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("Widget"));
+        return *cast<ObjCInterfaceDecl>(Decls.front())->meth_begin();
+      };
+      auto *Source = FindMethod(From->getASTContext());
+      auto *Target = FindMethod(To->getASTContext());
+      QualType Before = Target->getObjC3FunctionType();
+      ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                           From->getASTContext(), From->getFileManager(), false);
+      auto Imported = Importer.Import(Source);
+      bool Same = std::string(FromEffect) == ToEffect;
+      EXPECT_EQ(bool(Imported), Same) << FromEffect << " -> " << ToEffect;
+      if (!Imported)
+        llvm::consumeError(Imported.takeError());
+      EXPECT_EQ(Target->getObjC3FunctionType(), Before);
+    }
+  }
+}
+
+TEST(ObjC3FunctionEffectImport, DerivedAsyncTaskTypeImportsWithLogicalSignature) {
+  const std::string Code = R"(
+    namespace objc3 { template<class T> struct task { T value; }; }
+    template<class T> using __objc3_async_task = objc3::task<T>;
+    int async_value(int) __objc3_async;
+  )";
+  const std::vector<std::string> Args = {
+      "-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+      "-target", "x86_64-unknown-linux-gnu", "-fobjc-runtime=gnustep-2.2"};
+  auto From = tooling::buildASTFromCodeWithArgs(Code, Args, "async-from.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      "", Args, "async-to.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"async-from.mm", Code}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASTContext &FC = From->getASTContext(), &TC = To->getASTContext();
+  const auto *FD = findFunction(FC, "async_value");
+  ASSERT_NE(FD, nullptr);
+  ASSERT_FALSE(FC.getObjC3AsyncTaskType(FC.IntTy).isNull());
+  EXPECT_TRUE(TC.getObjC3AsyncTaskType(TC.IntTy).isNull());
+  ASTImporter Importer(TC, To->getFileManager(), FC, From->getFileManager(),
+                       /*MinimalImport=*/false);
+  auto Imported = Importer.Import(FD->getType());
+  ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+  const auto *FT = (*Imported)->castAs<FunctionProtoType>();
+  EXPECT_TRUE(FT->getObjC3FunctionEffects().Async);
+  EXPECT_TRUE(TC.hasSameType(FT->getReturnType(), TC.IntTy));
+  QualType Task = TC.getObjC3AsyncTaskType(TC.IntTy);
+  ASSERT_FALSE(Task.isNull());
+  EXPECT_TRUE(Task->isRecordType());
+  EXPECT_FALSE(TC.hasSameType(Task, FT->getReturnType()));
+}
+
+} // namespace
diff --git a/clang/unittests/AST/ObjC3FunctionEffectTest.cpp b/clang/unittests/AST/ObjC3FunctionEffectTest.cpp
new file mode 100644
index 000000000..6b3cc6b29
--- /dev/null
+++ b/clang/unittests/AST/ObjC3FunctionEffectTest.cpp
@@ -0,0 +1,363 @@
+//===--- ObjC3FunctionEffectTest.cpp - function type effects --------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//===----------------------------------------------------------------------===//
+
+#include "../../lib/Sema/TypeLocBuilder.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/PrettyPrinter.h"
+#include "clang/AST/Type.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/ADT/FoldingSet.h"
+#include "gtest/gtest.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(Source, {"-std=c++20"},
+                                           "objc3-effects.mm");
+}
+
+QualType recordType(ASTContext &Context, llvm::StringRef Name) {
+  IdentifierInfo &II = Context.Idents.get(Name);
+  auto Decls = Context.getTranslationUnitDecl()->lookup(&II);
+  assert(!Decls.empty());
+  return Context.getCanonicalTagType(cast<RecordDecl>(Decls.front()));
+}
+
+QualType functionType(ASTContext &Context, ObjC3FunctionEffectInfo Effects,
+                      FunctionProtoType::ExceptionSpecInfo Exception = {}) {
+  FunctionProtoType::ExtProtoInfo EPI;
+  EPI.ExceptionSpec = Exception;
+  EPI.ObjC3Effects = Effects;
+  return Context.getFunctionType(Context.VoidTy, {}, EPI);
+}
+
+TEST(ObjC3FunctionEffects, CanonicalTypedPayloadParticipatesInTypeIdentity) {
+  auto AST =
+      parse("struct Error {}; typedef Error ErrorAlias; struct Other {};");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  QualType Error = recordType(Context, "Error");
+  auto AliasDecls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get("ErrorAlias"));
+  ASSERT_FALSE(AliasDecls.empty());
+  auto *AliasDecl = cast<TypedefNameDecl>(AliasDecls.front());
+  QualType ErrorAlias =
+      Context.getTypedefType(ElaboratedTypeKeyword::None,
+                             NestedNameSpecifier(std::nullopt), AliasDecl);
+  QualType Other = recordType(Context, "Other");
+
+  QualType Typed =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Error});
+  QualType TypedAlias =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, ErrorAlias});
+  QualType TypedOther =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Other});
+  EXPECT_TRUE(Context.hasSameType(Typed, TypedAlias));
+  EXPECT_FALSE(Context.hasSameType(Typed, TypedOther));
+  EXPECT_EQ(Typed->castAs<FunctionProtoType>()->getObjC3ErrorType(), Error);
+}
+
+TEST(ObjC3FunctionEffects, SugaredPayloadProfileMatchesLookupAcrossRehash) {
+  auto AST = parse("struct Error {}; typedef Error ErrorAlias;");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto AliasDecls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get("ErrorAlias"));
+  ASSERT_FALSE(AliasDecls.empty());
+  auto *AliasDecl = cast<TypedefNameDecl>(AliasDecls.front());
+  QualType ErrorAlias =
+      Context.getTypedefType(ElaboratedTypeKeyword::None,
+                             NestedNameSpecifier(std::nullopt), AliasDecl);
+
+  FunctionProtoType::ExtProtoInfo EPI;
+  EPI.ObjC3Effects = {false, ObjC3ThrowsKind::Typed, ErrorAlias};
+
+  QualType First =
+      Context.getFunctionType(Context.VoidTy, {Context.IntTy}, EPI);
+  ASSERT_FALSE(First.isNull());
+  const auto *FirstFPT = First->castAs<FunctionProtoType>();
+  llvm::FoldingSetNodeID LookupProfile;
+  FunctionProtoType::Profile(LookupProfile, Context.VoidTy,
+                             FirstFPT->param_type_begin(),
+                             FirstFPT->getNumParams(), EPI, Context,
+                             /*Canonical=*/true);
+  llvm::FoldingSetNodeID NodeProfile;
+  // FoldingSet's native node profiling API accepts a mutable node.
+  const_cast<FunctionProtoType *>(FirstFPT)->Profile(NodeProfile, Context);
+  EXPECT_EQ(LookupProfile, NodeProfile);
+
+  // Grow the function-type folding set with distinct parameter types, then
+  // look up every non-canonical typed-error node again. This exercises the
+  // node's own profile during FoldingSet rehash as well as later lookups.
+  std::vector<QualType> ParameterTypes;
+  std::vector<QualType> FunctionTypes;
+  QualType Parameter = Context.IntTy;
+  for (unsigned I = 0; I != 256; ++I) {
+    Parameter = Context.getPointerType(Parameter);
+    ParameterTypes.push_back(Parameter);
+    QualType Function =
+        Context.getFunctionType(Context.VoidTy, {Parameter}, EPI);
+    ASSERT_FALSE(Function.isNull());
+    FunctionTypes.push_back(Function);
+  }
+  for (unsigned I = 0; I != ParameterTypes.size(); ++I) {
+    QualType Reused =
+        Context.getFunctionType(Context.VoidTy, {ParameterTypes[I]}, EPI);
+    EXPECT_EQ(Reused, FunctionTypes[I]) << "parameter depth " << I;
+  }
+}
+
+TEST(ObjC3FunctionEffects, AsyncAndThrowsKindsAreCanonicalTypeIdentity) {
+  auto AST = parse("struct Error {};");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  QualType Error = recordType(Context, "Error");
+
+  QualType Plain = functionType(Context, {});
+  QualType Async = functionType(Context, {true, ObjC3ThrowsKind::None, {}});
+  QualType Untyped =
+      functionType(Context, {false, ObjC3ThrowsKind::Untyped, {}});
+  QualType AsyncUntyped =
+      functionType(Context, {true, ObjC3ThrowsKind::Untyped, {}});
+  QualType Typed =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Error});
+  EXPECT_FALSE(Context.hasSameType(Plain, Async));
+  EXPECT_FALSE(Context.hasSameType(Plain, Untyped));
+  EXPECT_FALSE(Context.hasSameType(Untyped, Typed));
+  EXPECT_FALSE(Context.hasSameType(Async, AsyncUntyped));
+
+  const auto *AsyncType = Async->castAs<FunctionProtoType>();
+  EXPECT_TRUE(AsyncType->isObjC3Async());
+  EXPECT_EQ(AsyncType->getObjC3ThrowsKind(), ObjC3ThrowsKind::None);
+}
+
+TEST(ObjC3FunctionEffects, ObjCEffectsDoNotReplaceCppExceptionSpecification) {
+  auto AST = parse("struct Error {};");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  QualType Error = recordType(Context, "Error");
+  FunctionProtoType::ExceptionSpecInfo Noexcept(EST_BasicNoexcept);
+  QualType Typed =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Error});
+  QualType TypedNoexcept =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Error}, Noexcept);
+  EXPECT_FALSE(Context.hasSameType(Typed, TypedNoexcept));
+  EXPECT_EQ(Typed->castAs<FunctionProtoType>()->getObjC3ErrorType(), Error);
+  EXPECT_EQ(TypedNoexcept->castAs<FunctionProtoType>()->getExceptionSpecType(),
+            EST_BasicNoexcept);
+}
+
+TEST(ObjC3FunctionEffects, TypePrinterUsesStableSourceOrder) {
+  auto AST = parse("struct Error {};");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  QualType Error = recordType(Context, "Error");
+  QualType AsyncTyped =
+      functionType(Context, {true, ObjC3ThrowsKind::Typed, Error});
+  EXPECT_EQ(AsyncTyped.getAsString(Context.getPrintingPolicy()),
+            "void () async throws(Error)");
+  PrintingPolicy DeclarationPolicy(Context.getPrintingPolicy());
+  DeclarationPolicy.PolishForDeclaration = true;
+  EXPECT_EQ(AsyncTyped.getAsString(DeclarationPolicy),
+            "void () __objc3_async throws(Error)");
+  EXPECT_EQ(Context.getPointerType(AsyncTyped).getAsString(DeclarationPolicy),
+            "void (*)() __objc3_async throws(Error)");
+  EXPECT_EQ(functionType(Context, {false, ObjC3ThrowsKind::Untyped, {}})
+                .getAsString(DeclarationPolicy),
+            "void () throws");
+}
+
+TEST(ObjC3FunctionEffects, TypedPayloadContributesTemplateDependence) {
+  auto AST = parse("template<class T> struct Box {};"
+                   "template<class... Ts> struct PackBox {};");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto findTemplateTypeParameter = [&](llvm::StringRef Name) {
+    auto Decls =
+        Context.getTranslationUnitDecl()->lookup(&Context.Idents.get(Name));
+    assert(!Decls.empty());
+    auto *Template = cast<ClassTemplateDecl>(Decls.front());
+    return cast<TemplateTypeParmDecl>(
+        Template->getTemplateParameters()->getParam(0));
+  };
+
+  QualType T = Context.getTypeDeclType(findTemplateTypeParameter("Box"));
+  QualType TPayload = functionType(Context, {false, ObjC3ThrowsKind::Typed, T});
+  ASSERT_FALSE(TPayload.isNull());
+  EXPECT_TRUE(TPayload->isInstantiationDependentType());
+  EXPECT_TRUE(TPayload->getDependence() & TypeDependence::Dependent);
+
+  QualType Ts = Context.getTypeDeclType(findTemplateTypeParameter("PackBox"));
+  QualType PackPayload =
+      functionType(Context, {false, ObjC3ThrowsKind::Typed, Ts});
+  ASSERT_FALSE(PackPayload.isNull());
+  EXPECT_TRUE(PackPayload->isInstantiationDependentType());
+  EXPECT_TRUE(PackPayload->getDependence() & TypeDependence::UnexpandedPack);
+}
+
+TEST(ObjC3FunctionEffects, InvalidSerializedEffectShapesFailClosed) {
+  auto AST = parse("");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  FunctionProtoType::ExtProtoInfo MissingPayload;
+  MissingPayload.ObjC3Effects.Throws = ObjC3ThrowsKind::Typed;
+  EXPECT_TRUE(
+      Context.getFunctionType(Context.VoidTy, {}, MissingPayload).isNull());
+
+  FunctionProtoType::ExtProtoInfo InvalidKind;
+  InvalidKind.ObjC3Effects.Throws = static_cast<ObjC3ThrowsKind>(3);
+  EXPECT_TRUE(
+      Context.getFunctionType(Context.VoidTy, {}, InvalidKind).isNull());
+}
+
+TEST(ObjC3FunctionEffect, PolishedAvailabilityContractsRoundTrip) {
+  auto AST = parse(R"(
+    int current(void);
+    __attribute__((deprecated("use current", "current"))) int old(void);
+    __attribute__((unavailable("removed API"))) int removed(void);
+    __attribute__((availability(macos,introduced=10.0,deprecated=11.0,
+                                obsoleted=12.0,replacement="current",message="platform API"))) int platform(void);
+    __attribute__((deprecated("old protocol"))) @protocol Protocol
+    - (int)oldMethod __attribute__((deprecated("use new method")));
+    @end
+    __attribute__((objc_root_class)) @interface Root
+    @property(readonly) int oldProperty __attribute__((deprecated("old property")));
+    @end
+    __attribute__((deprecated("old category"))) @interface Root (Old) @end
+  )");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  PrintingPolicy Policy(AST->getASTContext().getLangOpts());
+  Policy.PolishForDeclaration = true;
+  std::string Printed;
+  llvm::raw_string_ostream Out(Printed);
+  AST->getASTContext().getTranslationUnitDecl()->print(Out, Policy);
+  Out.flush();
+  EXPECT_NE(Printed.find("deprecated(\"use current\", \"current\")"),
+            std::string::npos);
+  EXPECT_NE(Printed.find("unavailable(\"removed API\")"), std::string::npos);
+  EXPECT_NE(Printed.find("availability(macos"), std::string::npos);
+  EXPECT_NE(Printed.find("platform API"), std::string::npos);
+  EXPECT_NE(Printed.find("old protocol"), std::string::npos);
+  EXPECT_NE(Printed.find("old category"), std::string::npos);
+  EXPECT_NE(Printed.find("old property"), std::string::npos);
+  EXPECT_NE(Printed.find("use new method"), std::string::npos);
+  auto Reparsed = parse(Printed);
+  ASSERT_TRUE(Reparsed);
+  EXPECT_FALSE(Reparsed->getDiagnostics().hasErrorOccurred());
+}
+
+TEST(ObjC3FunctionEffect, PolishedSPIAnnotationsRoundTrip) {
+  auto AST = parse(R"(
+    __attribute__((annotate("objc3.spi:Testing"))) int secret(void);
+    extern int global __attribute__((annotate("objc3.spi:Testing")));
+    struct __attribute__((annotate("objc3.spi:Testing"))) Value { int field; };
+    enum __attribute__((annotate("objc3.spi:Testing"))) Choice { item };
+    typedef int Alias __attribute__((annotate("objc3.spi:Testing")));
+    __attribute__((annotate("objc3.spi:Testing"))) @interface Secret @end
+    __attribute__((annotate("objc3.spi:Testing"))) @protocol Protocol @end
+    __attribute__((annotate("unmodeled"))) int ordinary(void);
+  )");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  PrintingPolicy Policy(AST->getASTContext().getLangOpts());
+  Policy.PolishForDeclaration = true;
+  std::string Printed;
+  llvm::raw_string_ostream Out(Printed);
+  AST->getASTContext().getTranslationUnitDecl()->print(Out, Policy);
+  Out.flush();
+  unsigned Count = 0;
+  for (size_t Pos = 0;
+       (Pos = Printed.find("objc3.spi:Testing", Pos)) != std::string::npos;
+       ++Pos)
+    ++Count;
+  EXPECT_EQ(Count, 7u);
+  EXPECT_EQ(Printed.find("unmodeled"), std::string::npos);
+  auto Reparsed = parse(Printed);
+  ASSERT_TRUE(Reparsed);
+  EXPECT_FALSE(Reparsed->getDiagnostics().hasErrorOccurred());
+}
+
+TEST(ObjC3FunctionEffect, PolishedNativeNamesRoundTripInCAndCxx) {
+  for (bool Cxx : {false, true}) {
+    const char *Filename = Cxx ? "names.mm" : "names.m";
+    const std::vector<std::string> Args = {Cxx ? "-std=c++20" : "-std=c17"};
+    auto AST = tooling::buildASTFromCodeWithArgs(R"(
+      int value(void) __asm__("owned_value")
+          __attribute__((annotate("objc3.spi:Testing")));
+      extern int global __asm__("owned_global")
+          __attribute__((deprecated("old global"), annotate("objc3.spi:Testing")));
+      __attribute__((objc_root_class)) @interface Root @end
+      __attribute__((annotate("objc3.module-name:__objc3_m_category")))
+      @interface Root (SourceCategory) @end
+    )",
+                                                 Args, Filename);
+    ASSERT_TRUE(AST);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    PrintingPolicy Policy(AST->getASTContext().getLangOpts());
+    Policy.PolishForDeclaration = true;
+    std::string Printed;
+    llvm::raw_string_ostream Out(Printed);
+    AST->getASTContext().getTranslationUnitDecl()->print(Out, Policy);
+    Out.flush();
+    EXPECT_NE(Printed.find("__asm__(\"owned_value\")"), std::string::npos);
+    const auto Global = Printed.find("__asm__(\"owned_global\")");
+    ASSERT_NE(Global, std::string::npos);
+    EXPECT_LT(Global, Printed.find("deprecated(\"old global\")"));
+    EXPECT_NE(Printed.find("objc3.module-name:__objc3_m_category"),
+              std::string::npos);
+    auto Reparsed = tooling::buildASTFromCodeWithArgs(Printed, Args, Filename);
+    ASSERT_TRUE(Reparsed);
+    EXPECT_FALSE(Reparsed->getDiagnostics().hasErrorOccurred()) << Printed;
+  }
+}
+
+
+TEST(ObjC3FunctionEffects, SynthesizedFunctionLocationsClearReusedEffects) {
+  auto AST = parse("");
+  ASSERT_TRUE(AST);
+  ASTContext &C = AST->getASTContext();
+  QualType F = C.getFunctionType(C.VoidTy, {}, {});
+  TypeLocBuilder Builder;
+  Builder.pushTrivial(C, C.VoidTy, SourceLocation());
+  auto First = Builder.push<FunctionProtoTypeLoc>(F);
+  SourceLocation Old = SourceLocation::getFromRawEncoding(17);
+  First.setObjC3AsyncLoc(Old);
+  First.setObjC3ThrowsLoc(Old);
+  First.setObjC3ThrowsPayloadRange(SourceRange(Old, Old));
+  First.setObjC3ThrowsPayloadInfo(C.getTrivialTypeSourceInfo(C.IntTy));
+  Builder.clear();
+  Builder.pushTrivial(C, C.VoidTy, SourceLocation());
+  auto Reused = Builder.push<FunctionProtoTypeLoc>(F);
+  EXPECT_TRUE(Reused.getObjC3AsyncLoc().isInvalid());
+  EXPECT_TRUE(Reused.getObjC3ThrowsLoc().isInvalid());
+  EXPECT_TRUE(Reused.getObjC3ThrowsPayloadRange().isInvalid());
+  EXPECT_EQ(Reused.getObjC3ThrowsPayloadInfo(), nullptr);
+}
+
+TEST(ObjC3FunctionEffects, DerivedAsyncTaskCachePreservesResultQualifiers) {
+  auto AST = parse("struct Value {}; struct PlainTask {}; struct ConstTask {};");
+  ASSERT_TRUE(AST);
+  ASTContext &C = AST->getASTContext();
+  QualType Value = recordType(C, "Value");
+  QualType Plain = recordType(C, "PlainTask"), Const = recordType(C, "ConstTask");
+  C.setObjC3AsyncTaskType(Value, Plain);
+  C.setObjC3AsyncTaskType(C.getConstType(Value), Const);
+  EXPECT_TRUE(C.hasSameType(C.getObjC3AsyncTaskType(Value), Plain));
+  EXPECT_TRUE(C.hasSameType(C.getObjC3AsyncTaskType(C.getConstType(Value)), Const));
+}
+
+} // namespace
diff --git a/clang/unittests/AST/ObjC3IndexIdentityTest.cpp b/clang/unittests/AST/ObjC3IndexIdentityTest.cpp
new file mode 100644
index 000000000..203b1a0d2
--- /dev/null
+++ b/clang/unittests/AST/ObjC3IndexIdentityTest.cpp
@@ -0,0 +1,97 @@
+//===- ObjC3IndexIdentityTest.cpp - Canonical extension USRs
+//---------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/UnifiedSymbolResolution/USRGeneration.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/ADT/SmallString.h"
+#include "gtest/gtest.h"
+
+#include <iterator>
+#include <string>
+
+using namespace clang;
+
+namespace {
+
+std::string typeUSR(QualType T, ASTContext &Context) {
+  llvm::SmallString<128> Buffer;
+  EXPECT_FALSE(index::generateUSRForType(T, Context, Buffer));
+  return Buffer.str().str();
+}
+
+TEST(ObjC3IndexIdentity, CarrierPayloadsAndKindsRemainDistinct) {
+  auto AST =
+      tooling::buildASTFromCodeWithArgs("typedef int Alias;", {"-std=c++20"});
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto Decls =
+      Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("Alias"));
+  ASSERT_FALSE(Decls.empty());
+  QualType Alias =
+      Context.getTypeDeclType(cast<TypedefNameDecl>(Decls.front()));
+  QualType OptionalInt = Context.getObjC3OptionalType(Context.IntTy);
+  EXPECT_EQ(typeUSR(OptionalInt, Context),
+            typeUSR(Context.getObjC3OptionalType(Alias), Context));
+  EXPECT_NE(typeUSR(OptionalInt, Context),
+            typeUSR(Context.getObjC3OptionalType(Context.LongTy), Context));
+  EXPECT_NE(typeUSR(OptionalInt, Context),
+            typeUSR(Context.getObjC3ResultType(Context.IntTy, Context.VoidTy),
+                    Context));
+  EXPECT_NE(typeUSR(Context.getObjC3ResultType(Context.IntTy, Context.CharTy),
+                    Context),
+            typeUSR(Context.getObjC3ResultType(Context.CharTy, Context.IntTy),
+                    Context));
+  EXPECT_NE(typeUSR(Context.getObjC3OptionalType(OptionalInt), Context),
+            typeUSR(OptionalInt, Context));
+}
+
+TEST(ObjC3IndexIdentity, FunctionPointerEffectsHaveCanonicalUSRIdentity) {
+  auto AST = tooling::buildASTFromCodeWithArgs("", {"-std=c++20"});
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto Pointer = [&](ObjC3FunctionEffectInfo Effects) {
+    FunctionProtoType::ExtProtoInfo Info;
+    Info.ObjC3Effects = Effects;
+    return Context.getPointerType(
+        Context.getFunctionType(Context.VoidTy, {}, Info));
+  };
+  std::string Plain = typeUSR(Pointer({}), Context);
+  EXPECT_NE(Plain,
+            typeUSR(Pointer({true, ObjC3ThrowsKind::None, {}}), Context));
+  std::string Untyped =
+      typeUSR(Pointer({false, ObjC3ThrowsKind::Untyped, {}}), Context);
+  std::string TypedInt =
+      typeUSR(Pointer({false, ObjC3ThrowsKind::Typed, Context.IntTy}), Context);
+  EXPECT_NE(Plain, Untyped);
+  EXPECT_NE(Untyped, TypedInt);
+  EXPECT_NE(TypedInt,
+            typeUSR(Pointer({false, ObjC3ThrowsKind::Typed, Context.CharTy}),
+                    Context));
+}
+
+TEST(ObjC3IndexIdentity, CarrierPointerOverloadsDoNotCollapseInConsumers) {
+  auto AST = tooling::buildASTFromCodeWithArgs(
+      "typedef __objc3_optional(int) A; typedef __objc3_optional(long) B;"
+      "void consume(A *); void consume(B *);",
+      {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-index.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  auto Decls =
+      Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("consume"));
+  ASSERT_EQ(std::distance(Decls.begin(), Decls.end()), 2);
+  auto Iterator = Decls.begin();
+  llvm::SmallString<128> First;
+  llvm::SmallString<128> Second;
+  EXPECT_FALSE(index::generateUSRForDecl(*Iterator++, First));
+  EXPECT_FALSE(index::generateUSRForDecl(*Iterator, Second));
+  EXPECT_NE(First, Second);
+}
+
+} // namespace
diff --git a/clang/unittests/AST/ObjC3MatchImporterTest.cpp b/clang/unittests/AST/ObjC3MatchImporterTest.cpp
new file mode 100644
index 000000000..996fbbd26
--- /dev/null
+++ b/clang/unittests/AST/ObjC3MatchImporterTest.cpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "llvm/ADT/SmallVector.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+
+using namespace clang;
+
+namespace {
+class MatchCollector final : public RecursiveASTVisitor<MatchCollector> {
+public:
+  llvm::SmallVector<ObjC3MatchStmt *, 4> Statements;
+  llvm::SmallVector<ObjC3MatchExpr *, 4> Expressions;
+  bool VisitObjC3MatchStmt(ObjC3MatchStmt *S) {
+    Statements.push_back(S);
+    return true;
+  }
+  bool VisitObjC3MatchExpr(ObjC3MatchExpr *E) {
+    Expressions.push_back(E);
+    return true;
+  }
+};
+
+} // namespace
+
+TEST(ObjC3MatchImporter, PreservesArmBindingsAndCanonicalCarrierTypes) {
+  const std::string FromCode = R"(
+    using MaybeInt = __objc3_optional(int);
+    using IntOrWide = __objc3_result(int, long long);
+    int exercise(MaybeInt optional, IntOrWide result) {
+      __objc3_match_stmt (optional) {
+      case __objc3_case_some(let payload): { (void)payload; }
+      case __objc3_case_none: { }
+      }
+      return __objc3_match (result) {
+        case .Ok(let success) => success;
+        case .Err(let error) => (int)error;
+      };
+    }
+  )";
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(FromCode, Args, "match-import-input.mm");
+  auto To = tooling::buildASTFromCodeWithArgs("", Args, "match-import-output.mm",
+      "clang-tool", std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"match-import-input.mm", FromCode}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  TranslationUnitDecl *FromTU = From->getASTContext().getTranslationUnitDecl();
+  FunctionDecl *FromFunction = nullptr;
+  for (Decl *D : FromTU->lookup(&From->getASTContext().Idents.get("exercise")))
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      FromFunction = FD;
+  ASSERT_TRUE(FromFunction);
+
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+      From->getASTContext(), From->getFileManager(), false);
+  auto ImportedFunction = Importer.Import(FromFunction);
+  ASSERT_TRUE(static_cast<bool>(ImportedFunction)) << llvm::toString(ImportedFunction.takeError());
+  auto *ToFunction = dyn_cast<FunctionDecl>(*ImportedFunction);
+  ASSERT_TRUE(ToFunction);
+  MatchCollector Imported;
+  ASSERT_TRUE(Imported.TraverseDecl(ToFunction));
+  ASSERT_EQ(Imported.Statements.size(), 1u);
+  ASSERT_EQ(Imported.Expressions.size(), 1u);
+
+  ObjC3MatchStmt *Statement = Imported.Statements.front();
+  ASSERT_EQ(Statement->getNumArms(), 2u);
+  ObjC3MatchArm *Some = Statement->getArm(0);
+  ObjC3MatchArm *None = Statement->getArm(1);
+  ASSERT_TRUE(Some->getBindingDecl());
+  EXPECT_EQ(Some->getBindingKind(), objc3::MatchBindingKind::OptionalPayload);
+  ASSERT_TRUE(isa<DeclStmt>(Some->getBindingStatement()));
+  EXPECT_EQ(cast<DeclStmt>(Some->getBindingStatement())->getSingleDecl(),
+            Some->getBindingDecl());
+  EXPECT_EQ(None->getBindingDecl(), nullptr);
+  EXPECT_TRUE(isa<ObjC3OptionalType>(
+      ToFunction->getASTContext()
+          .getCanonicalType(Some->getCanonicalPatternType())
+          .getTypePtr()));
+
+  ObjC3MatchExpr *Expression = Imported.Expressions.front();
+  ASSERT_EQ(Expression->getNumArms(), 2u);
+  ObjC3MatchArm *Success = Expression->getArm(0);
+  ObjC3MatchArm *Error = Expression->getArm(1);
+  ASSERT_TRUE(Success->getBindingDecl());
+  ASSERT_TRUE(Error->getBindingDecl());
+  EXPECT_NE(Success->getBindingDecl(), Error->getBindingDecl());
+  EXPECT_EQ(cast<DeclStmt>(Success->getBindingStatement())->getSingleDecl(),
+            Success->getBindingDecl());
+  EXPECT_EQ(cast<DeclStmt>(Error->getBindingStatement())->getSingleDecl(),
+            Error->getBindingDecl());
+  EXPECT_EQ(Success->getBindingDecl()->getIdentifier()->getName(), "success");
+  EXPECT_EQ(Error->getBindingDecl()->getIdentifier()->getName(), "error");
+  EXPECT_TRUE(isa<ObjC3ResultType>(
+      ToFunction->getASTContext()
+          .getCanonicalType(Success->getCanonicalPatternType())
+          .getTypePtr()));
+  EXPECT_TRUE(isa<ObjC3ResultType>(
+      ToFunction->getASTContext()
+          .getCanonicalType(Error->getCanonicalPatternType())
+          .getTypePtr()));
+  EXPECT_TRUE(ToFunction->getASTContext()
+                  .getCanonicalType(Expression->getType())
+                  ->isIntegerType());
+}
diff --git a/clang/unittests/AST/ObjC3TryThrowConsumerTest.cpp b/clang/unittests/AST/ObjC3TryThrowConsumerTest.cpp
new file mode 100644
index 000000000..c40497364
--- /dev/null
+++ b/clang/unittests/AST/ObjC3TryThrowConsumerTest.cpp
@@ -0,0 +1,146 @@
+//===--- ObjC3TryThrowConsumerTest.cpp - AST consumer identity tests -------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/ADT/FoldingSet.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+
+#include <array>
+#include <string>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+class FindTryExprs : public RecursiveASTVisitor<FindTryExprs> {
+public:
+  std::vector<ObjC3TryExpr *> Nodes;
+  bool VisitObjC3TryExpr(ObjC3TryExpr *E) {
+    Nodes.push_back(E);
+    return true;
+  }
+};
+
+class FindStmtExprs : public RecursiveASTVisitor<FindStmtExprs> {
+public:
+  std::vector<StmtExpr *> Nodes;
+  bool VisitStmtExpr(StmtExpr *E) {
+    Nodes.push_back(E);
+    return true;
+  }
+};
+} // namespace
+
+TEST(ObjC3TryThrowConsumers, ProfilesOperationsAndImportsIntoTargetContext) {
+  const std::string FromCode = R"(
+    struct Error {};
+    __attribute__((const)) int typed() __objc3_throws(Error);
+    int propagate() __objc3_throws(Error) { return __objc3_try(typed()); }
+    __objc3_optional(int) optionalize() {
+      return __objc3_try_optional(typed());
+    }
+    int force() { return __objc3_try_force(typed()); }
+    int statement_expression() __objc3_throws(Error) {
+      return ({ __objc3_throw(Error{}); 0; });
+    }
+  )";
+  const std::string ToCode = R"(
+    struct Error {};
+    __attribute__((const)) int typed() __objc3_throws(Error);
+    int propagate() __objc3_throws(Error) { return __objc3_try(typed()); }
+    __objc3_optional(int) optionalize() {
+      return __objc3_try_optional(typed());
+    }
+    int force() { return __objc3_try_force(typed()); }
+  )";
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                         "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(FromCode, Args, "from.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      ToCode, Args, "to.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), {{"from.mm", FromCode}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+
+  FindTryExprs Finder;
+  Finder.TraverseDecl(From->getASTContext().getTranslationUnitDecl());
+  ASSERT_EQ(Finder.Nodes.size(), 3u);
+  const std::array<ObjC3TryExpr::Kind, 3> Expected = {
+      ObjC3TryExpr::Kind::Propagate, ObjC3TryExpr::Kind::Optionalize,
+      ObjC3TryExpr::Kind::Force};
+  for (unsigned I = 0; I != Expected.size(); ++I)
+    EXPECT_EQ(Finder.Nodes[I]->getKind(), Expected[I]);
+  EXPECT_TRUE(Finder.Nodes[0]->HasSideEffects(From->getASTContext(), true));
+  EXPECT_FALSE(Finder.Nodes[1]->HasSideEffects(From->getASTContext(), true));
+  EXPECT_TRUE(Finder.Nodes[2]->HasSideEffects(From->getASTContext(), true));
+
+  FindStmtExprs StmtExprFinder;
+  StmtExprFinder.TraverseDecl(From->getASTContext().getTranslationUnitDecl());
+  ASSERT_EQ(StmtExprFinder.Nodes.size(), 1u);
+  EXPECT_TRUE(StmtExprFinder.Nodes.front()->HasSideEffects(
+      From->getASTContext(), /*IncludePossibleEffects=*/false));
+
+  FindTryExprs ToFinder;
+  ToFinder.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  ASSERT_EQ(ToFinder.Nodes.size(), 3u);
+  StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalent;
+  StructuralEquivalenceContext Eq(
+      From->getASTContext().getLangOpts(), From->getASTContext(),
+      To->getASTContext(), NonEquivalent, StructuralEquivalenceKind::Default,
+      /*StrictTypeSpelling=*/false, /*Complain=*/false);
+  EXPECT_TRUE(Eq.IsEquivalent(Finder.Nodes[0], ToFinder.Nodes[0]));
+  StructuralEquivalenceContext::NonEquivalentDeclSet DifferentKindSet;
+  StructuralEquivalenceContext DifferentKindEq(
+      From->getASTContext().getLangOpts(), From->getASTContext(),
+      From->getASTContext(), DifferentKindSet,
+      StructuralEquivalenceKind::Default, /*StrictTypeSpelling=*/false,
+      /*Complain=*/false);
+  EXPECT_FALSE(DifferentKindEq.IsEquivalent(Finder.Nodes[0], Finder.Nodes[1]));
+
+  llvm::FoldingSetNodeID PropagateProfile, OptionalizeProfile;
+  Finder.Nodes[0]->Profile(PropagateProfile, From->getASTContext(),
+                           /*Canonical=*/false);
+  Finder.Nodes[1]->Profile(OptionalizeProfile, From->getASTContext(),
+                           /*Canonical=*/false);
+  EXPECT_NE(PropagateProfile.ComputeHash(), OptionalizeProfile.ComputeHash());
+
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), /*MinimalImport=*/false);
+  for (unsigned I = 0; I != Expected.size(); ++I) {
+    auto Imported = Importer.Import(Finder.Nodes[I]);
+    ASSERT_TRUE(static_cast<bool>(Imported))
+        << llvm::toString(Imported.takeError());
+    auto *Try = dyn_cast<ObjC3TryExpr>(*Imported);
+    ASSERT_NE(Try, nullptr);
+    EXPECT_EQ(Try->getKind(), Expected[I]);
+    if (Expected[I] == ObjC3TryExpr::Kind::Optionalize) {
+      const auto *Optional = Try->getType()->getAs<ObjC3OptionalType>();
+      ASSERT_NE(Optional, nullptr);
+      EXPECT_EQ(Optional->getElementType(), ToContext.IntTy);
+    } else {
+      EXPECT_EQ(Try->getType(), ToContext.IntTy);
+    }
+    auto *Call = dyn_cast<CallExpr>(Try->getOperand()->IgnoreParenImpCasts());
+    ASSERT_NE(Call, nullptr);
+    auto *Callee = dyn_cast<FunctionDecl>(Call->getCalleeDecl());
+    ASSERT_NE(Callee, nullptr);
+    EXPECT_EQ(&Callee->getASTContext(), &ToContext);
+    const auto *FPT = Callee->getType()->getAs<FunctionProtoType>();
+    ASSERT_NE(FPT, nullptr);
+    const auto *ErrorTy = FPT->getObjC3ErrorType()->getAs<RecordType>();
+    ASSERT_NE(ErrorTy, nullptr);
+    const auto *ErrorRecord = ErrorTy->getDecl();
+    EXPECT_EQ(&ErrorRecord->getASTContext(), &ToContext);
+  }
+}
