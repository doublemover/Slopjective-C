+struct RecursiveItem {
+  explicit RecursiveItem(int);
+  RecursiveItem(const RecursiveItem &);
+  RecursiveItem(RecursiveItem &&);
+  ~RecursiveItem();
+};
+using RecursiveInner = __objc3_optional(RecursiveItem);
+using RecursiveOuter = __objc3_optional(RecursiveInner);
+template <class T> void copy_recursive_from_pch(const T &source) {
+  T value = __objc3_copy(source);
+}
+inline void construct_recursive_from_pch() {
+  RecursiveOuter value = __objc3_some(
+      RecursiveInner, __objc3_some(RecursiveItem, RecursiveItem(1)));
+}
