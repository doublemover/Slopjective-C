@@ -0,0 +1,26 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+
+typedef __objc3_optional(int) MaybeInt;
+typedef __objc3_optional(MaybeInt) Nested;
+
+void boolean_operator_results_are_bool(int left, int right, _Bool enabled) {
+  // Native C comparison/logical operators return int. The condition boundary
+  // admits their Boolean meaning, preserving strict rejection of raw scalars.
+  guard left != right, !left, left && right, enabled else { return; }
+  guard left else { return; } // expected-error {{condition must have Bool type}}
+}
+
+void independent_let_and_var(MaybeInt source) {
+  if var value = source {
+    value = 2;
+  }
+  guard let value = source else { return; } // expected-note {{variable 'value' declared const here}}
+  value = 3; // expected-error {{cannot assign to variable 'value' with const-qualified type}}
+}
+
+void nested_optional_binding(Nested source) {
+  guard let inner = source, payload = inner else { return; }
+  _Static_assert(_Generic(payload, int: 1, default: 0), "integer payload");
+  (void)payload;
+}
diff --git a/clang/test/ObjC3/Sema/guard-binding-semantics.mm b/clang/test/ObjC3/Sema/guard-binding-semantics.mm
new file mode 100644
index 000000000..accfd73e4
--- /dev/null
+++ b/clang/test/ObjC3/Sema/guard-binding-semantics.mm
@@ -0,0 +1,84 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+
+typedef __objc3_optional(int) MaybeInt;
+typedef __objc3_optional(void) MaybeVoid;
+typedef __objc3_optional(MaybeInt) Nested;
+
+void binding_types(MaybeInt source, Nested nested) {
+  if let immutable = source {
+    static_assert(__is_same(decltype(immutable), const int));
+  }
+  if var mutable_value = source {
+    static_assert(__is_same(decltype(mutable_value), int));
+    mutable_value = 9;
+  }
+  guard let inner = nested, payload = inner else { return; }
+  static_assert(__is_same(decltype(inner), const MaybeInt));
+  static_assert(__is_same(decltype(payload), const int));
+}
+
+void let_is_immutable(MaybeInt source) {
+  guard let value = source else { return; } // expected-note {{variable 'value' declared const here}}
+  value = 7; // expected-error {{cannot assign to variable 'value' with const-qualified type}}
+}
+
+void invalid_sources(int scalar, int *pointer, MaybeVoid absent) {
+  if let value = scalar {} // expected-error {{binding requires an Optional or Objective-C reference}}
+  if var value = pointer {} // expected-error {{binding requires an Optional or Objective-C reference}}
+  guard let value = absent else { return; } // expected-error {{a void payload cannot be bound in a condition}}
+}
+
+void strict_boolean_conditions(MaybeInt source, int integer) {
+  guard integer else { return; } // expected-error {{condition must have Bool type}}
+  guard let value = source, integer != 0 else { return; }
+  (void)value;
+}
+
+struct CopyOnly {
+  CopyOnly(const CopyOnly &);
+  ~CopyOnly();
+};
+typedef __objc3_optional(CopyOnly) MaybeCopy;
+
+void native_copy_and_destruction(MaybeCopy &source) {
+  guard let value = source else { return; }
+  static_assert(__is_same(decltype(value), const CopyOnly));
+  (void)value;
+}
+
+struct InaccessibleDestruction {
+  InaccessibleDestruction(const InaccessibleDestruction &);
+private:
+  ~InaccessibleDestruction(); // expected-note {{declared private here}}
+};
+typedef __objc3_optional(InaccessibleDestruction) HiddenDestructor;
+
+void hidden_snapshot_requires_destruction(HiddenDestructor &source) {
+  guard let value = source else { return; } // expected-error {{variable of type 'InaccessibleDestruction' has private destructor}}
+}
+
+template <class T> int dependent_binding(T source) {
+  guard let value = source else { return -1; }
+  return value;
+}
+template int dependent_binding<MaybeInt>(MaybeInt);
+
+template <class T> int dependent_ordered_bindings(T source) {
+  guard let inner = source, payload = inner else { return -1; }
+  return payload;
+}
+template int dependent_ordered_bindings<Nested>(Nested);
+
+template <class T> int dependent_invalid_source(T source) {
+  guard let value = source else { return -1; } // expected-error {{binding requires an Optional or Objective-C reference}}
+  return value;
+}
+template int dependent_invalid_source<int>(int); // expected-note {{in instantiation of function template specialization}}
+
+template <class T> int dependent_boolean(T condition) {
+  guard condition else { return -1; } // expected-error {{condition must have Bool type}}
+  return 1;
+}
+template int dependent_boolean<bool>(bool);
+template int dependent_boolean<int>(int); // expected-note {{in instantiation of function template specialization}}
diff --git a/clang/test/ObjC3/Sema/guard-nullable-flow.m b/clang/test/ObjC3/Sema/guard-nullable-flow.m
new file mode 100644
index 000000000..cbb1e8be8
--- /dev/null
+++ b/clang/test/ObjC3/Sema/guard-nullable-flow.m
@@ -0,0 +1,206 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc3-profile=strict-concurrency -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=strict-system -fobjc-runtime=gnustep-2.2 -fblocks -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify=strict %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc3-profile=compatibility -fobjc-runtime=gnustep-2.2 -fobjc-arc -fblocks -fobjc-exceptions -Wno-nullability-completeness -fsyntax-only -verify=compat %s
+
+#ifdef __cplusplus
+typedef bool Bool;
+#else
+typedef _Bool Bool;
+#endif
+
+@interface GuardReceiver
+- (void)ping;
+- (Bool)alive;
+- (void)argument:(id _Nullable)value;
+- (GuardReceiver * _Nullable)child;
+@end
+
+typedef GuardReceiver * _Nullable Nullable;
+typedef GuardReceiver * _Nonnull Nonnull;
+typedef __objc3_optional(Nullable) Tagged;
+
+void unknown_call(void);
+id _Nullable clear_receiver(Nullable * _Nonnull);
+
+void unproven_receiver(Nullable value) {
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void ordered_guard(Nullable value) {
+  guard value != (id)0, [value alive] else { return; }
+  [value ping];
+}
+
+void negative_guard(Nullable value) {
+  guard !((id)0 == value) else { return; }
+  [value ping];
+}
+
+void failure_has_no_success_fact(Nullable value) {
+  guard value != (id)0 else {
+    [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+    return;
+  }
+  [value ping];
+}
+
+void ordinary_branch_refinement(Nullable value) {
+  if (value != (id)0) {
+    [value ping];
+  } else {
+    [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+  }
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void short_circuit_and(Nullable value) {
+  if (value != (id)0 && [value alive])
+    [value ping];
+}
+
+void short_circuit_or(Nullable value, Bool other) {
+  guard value != (id)0 || other else { return; }
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void loop_test_refines_each_iteration(Nullable value) {
+  while (value != (id)0) {
+    [value ping];
+    value = (id)0;
+  }
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void assignment_invalidates(Nullable value) {
+  guard value != (id)0 else { return; }
+  value = (id)0;
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void both_join_paths_preserve(Nullable value, Nonnull replacement, Bool choose) {
+  if (choose)
+    value = replacement;
+  else
+    value = replacement;
+  [value ping];
+}
+
+void calls_preserve_unexposed_local(Nullable value) {
+  guard value != (id)0 else { return; }
+  unknown_call();
+  [value ping];
+}
+
+void calls_invalidate_exposed_storage(Nullable value) {
+  guard value != (id)0 else { return; }
+  clear_receiver(&value);
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void stores_invalidate_exposed_storage(Nullable value) {
+  Nullable __strong *alias = &value;
+  guard value != (id)0 else { return; }
+  *alias = (id)0;
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void receiver_is_loaded_before_arguments(Nullable value) {
+  guard value != (id)0 else { return; }
+  [value argument:clear_receiver(&value)];
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void later_operand_cannot_restore_an_invalidated_fact(Nullable value) {
+  guard value != (id)0 && clear_receiver(&value) != (id)0 else { return; }
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void source_is_not_a_binding(Nullable source) {
+  if let owned = source {
+    [owned ping];
+  }
+  [source ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void owned_snapshot_survives_source_assignment(Nullable source,
+                                               Nonnull replacement) {
+  guard let owned = source else { return; }
+  source = (id)0;
+  [owned ping];
+  void (^captured)(void) = ^{ [owned ping]; };
+  (void)captured;
+  if var mutable_value = replacement {
+    mutable_value = replacement;
+    [mutable_value ping];
+  }
+}
+
+void a_jump_can_bypass_a_boolean_guard(Nullable value, Bool skip) {
+  if (skip)
+    goto after_guard;
+  guard value != (id)0 else { return; }
+after_guard:
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void tagged_some_nil_does_not_refine_payload(Tagged source) {
+  guard let payload = source else { return; }
+  [payload ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+  guard payload != (id)0 else { return; }
+  [payload ping];
+}
+
+void a_second_getter_is_a_new_value(Nonnull owner) {
+  guard [owner child] != (id)0 else { return; }
+  [[owner child] ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void separate_block_callable(Nullable value) {
+  guard value != (id)0 else { return; }
+  void (^body)(void) = ^{
+    [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+  };
+  (void)body;
+}
+
+void unmodeled_native_flow_does_not_admit_nullable_sends(Nullable value) {
+  @try {
+  } @finally {
+    [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+  }
+}
+
+#ifdef __cplusplus
+template <class T> void instantiated_refinement(Nullable value, T condition) {
+  guard condition, value != (id)0 else { return; }
+  [value ping];
+}
+template void instantiated_refinement<bool>(Nullable, bool);
+
+void reference_arguments_expose_storage(Nullable value,
+                                        void (*mutate)(Nullable &)) {
+  guard value != (id)0 else { return; }
+  mutate(value);
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+
+void a_reference_alias_names_the_same_storage(Nullable value) {
+  Nullable &alias = value;
+  guard alias != (id)0 else { return; }
+  [value ping];
+  alias = (id)0;
+  [value ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+}
+#endif
+
+#if __has_feature(objc_arc)
+void weak_load_requires_an_owned_binding(__weak Nullable source) {
+  guard source != (id)0 else { return; }
+  [source ping]; // strict-error {{ordinary message send requires a nonnull receiver}} compat-warning {{ordinary message send on a nullable receiver}}
+  guard let owned = source else { return; }
+  source = (id)0;
+  [owned ping];
+}
+#endif
