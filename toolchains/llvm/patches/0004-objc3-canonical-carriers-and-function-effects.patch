diff --git a/clang/test/ObjC3/Sema/resource-type-contracts.m b/clang/test/ObjC3/Sema/resource-type-contracts.m
new file mode 100644
index 000000000..79ab42fb6
--- /dev/null
+++ b/clang/test/ObjC3/Sema/resource-type-contracts.m
@@ -0,0 +1,140 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fexceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=compatibility -fsyntax-only -verify=common %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fexceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fexceptions -fcxx-exceptions -fobjc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fsyntax-only -verify=common,strict %s
+void close_fd(int) __attribute__((nothrow));
+void close_stream(int) __attribute__((nothrow));
+void close_address(int *) __attribute__((nothrow));
+void close_alternate(int) __attribute__((nothrow));
+void observe_handle(int) __attribute__((nothrow));
+void possibly_throw(void);
+@requires_cleanup(close_fd) @resource_family(Descriptors) @invalid(-1) typedef int FD;
+typedef int Stream __attribute__((objc_requires_cleanup(close_stream), objc_resource_family(Streams), objc_invalid(0)));
+@requires_cleanup(close_alternate) @resource_family(Descriptors) @invalid(-1) typedef int AlternateFD;
+@requires_cleanup(close_address) @invalid(0) typedef int AddressHandle;
+typedef FD FDAlias;
+FD open_fd(void) __attribute__((nothrow));
+Stream open_stream(void) __attribute__((nothrow));
+AddressHandle open_address(void) __attribute__((nothrow));
+void manual_cleanup(void) {
+  FDAlias value = open_fd();
+  close_fd(value);
+}
+void guarded_cleanup(void) {
+  FD value = open_fd();
+  if(value != -1)close_fd(value);
+}
+void address_cleanup(void) {
+  AddressHandle value = open_address();
+  close_address(&value);
+}
+void automatic_cleanup(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+}
+void deferred_cleanup(void) {
+  FD value = open_fd();
+  defer { close_fd(value); }
+}
+void same_family_cleanup(void) {
+  FD value = open_fd();
+  close_alternate(value);
+}
+FD transfer_return(void) {
+  FD value = open_fd();
+  return value;
+}
+FD registered_transfer(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  return take(value);
+}
+FD direct_transfer(void) { return open_fd(); }
+void forgotten(void) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+}
+void conditional_leak(int condition) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+  if(condition)close_fd(value);
+}
+void native_exception_leak(void) {
+  FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+  possibly_throw();
+  close_fd(value);
+}
+void repeated_cleanup(void) {
+  FD value = open_fd();
+  close_fd(value);
+  close_fd(value); // strict-error {{may already be closed, moved, or invalid}}
+}
+void manual_close_does_not_invalidate(void) {
+  FD value = open_fd();
+  close_fd(value);
+  if(value != -1)observe_handle(value); // strict-error {{may have been moved or discarded}}
+}
+void wrong_family(void) {
+  FD value = open_fd();
+  close_stream(value); // strict-error {{not associated with its type contract or family}}
+}
+void wrong_family_temporary(void) {
+  close_stream(open_fd()); // strict-error {{not associated with the acquired resource's family}}
+}
+void wrong_automatic_cleanup(void) {
+  @resource(close_stream, invalid: -1) FD value = open_fd(); // strict-error {{not associated with its type contract or family}}
+}
+void wrong_reset_family(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  reset(value, open_stream()); // strict-error {{reset of resource 'value' mixes incompatible cleanup families}}
+}
+void throwing_close(int);
+@requires_cleanup(throwing_close) @invalid(-1) typedef int ThrowingHandle;
+ThrowingHandle direct_disarmed_transfer(void) {
+  @resource(throwing_close, invalid: -1) ThrowingHandle value = 3;
+  return take(value);
+}
+void wrong_sentinel(void) {
+  @resource(close_fd, invalid: 0) FD value = open_fd(); // strict-error {{sentinel different from its typedef contract}}
+}
+void dropped_acquisition(void) {
+  open_fd(); // strict-error {{discarding a value with requires_cleanup loses ownership}}
+}
+void erased_local(void) {
+  int value = open_fd(); // strict-error {{erases its cleanup contract}}
+  observe_handle(value);
+}
+int erased_return(void) { return open_fd(); } // strict-error {{returning an acquired resource erases or changes its cleanup family}}
+FD unsafe_registered_return(void) {
+  @resource(close_fd, invalid: -1) FD value = open_fd();
+  return value; // strict-error {{returning registered resource}}
+}
+FD throwing_return_cleanup(void) {
+  FD value = open_fd();
+  defer { possibly_throw(); }
+  return value; // strict-error {{owned resource return has no rollback model}}
+}
+FD empty_throwing_return_cleanup(void) {
+  defer { possibly_throw(); }
+  return -1;
+}
+void loop_leak(int skip) {
+  for(int index = 0; index != 2; ++index) {
+    FD value = open_fd(); // strict-error {{may leave its scope without cleanup}}
+    if(skip)continue;
+    close_fd(value);
+  }
+}
+void loop_cleanup(void) {
+  for(int index = 0; index != 2; ++index) {
+    FD value = open_fd();
+    close_fd(value);
+  }
+}
+// Contradictory contracts are ill-formed in every profile.
+@invalid(0) typedef FD BadSentinel; // common-error {{cannot change its inherited invalid sentinel}}
+@resource_family(Streams) typedef FD BadFamily; // common-error {{cannot change its inherited resource family}}
+@requires_cleanup(close_stream) typedef FD BadCleanup; // common-error {{cannot change its inherited cleanup function}}
+@requires_cleanup(close_fd) typedef float BadStorage; // common-error {{require a nondependent ordinary integer, enum, or pointer handle}}
+int runtime_sentinel(void);
+@invalid(runtime_sentinel()) typedef int NonConstant; // common-error {{invalid sentinel must be constant}}
+#ifdef __cplusplus
+using UsingFD = FD;
+UsingFD alias_return(void) { UsingFD value = open_fd(); return value; }
+#endif
