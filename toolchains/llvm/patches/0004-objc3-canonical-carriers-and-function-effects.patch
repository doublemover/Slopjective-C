+
+void EnqueueVisitor::VisitObjC3BindingCondition(
+    const ObjC3BindingCondition *S) {
+  // Libclang exposes written source. The implicit snapshot owns the source
+  // initializer, and the binding initializer is only a semantic extraction
+  // recipe. Expose the user declaration and source expression once each.
+  // Worklist entries are consumed in reverse order.
+  AddStmt(S->getSource());
+  AddDecl(S->getBindingDecl());
+}
