diff --git a/clang/test/ObjC3/Sema/objc3-carrier-compatible-types.c b/clang/test/ObjC3/Sema/objc3-carrier-compatible-types.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/objc3-carrier-compatible-types.c
@@ -0,0 +1,53 @@
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -Werror=incompatible-pointer-types -fsyntax-only -verify=c17 %s
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c23 -Werror=incompatible-pointer-types -fsyntax-only -verify=c23 %s
+
+typedef int IntAlias;
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(IntAlias) OptionalIntAlias;
+typedef __objc3_optional(long) OptionalLong;
+typedef const __objc3_optional(int) ConstOptionalInt;
+
+typedef __objc3_result(int, short) IntShortResult;
+typedef __objc3_result(IntAlias, short) AliasShortResult;
+typedef __objc3_result(int, long) IntLongResult;
+
+// Canonical payload aliases, and top-level carrier qualifiers, preserve C
+// compatibility for declarations and assignments.
+void optional_alias_redecl(OptionalInt *);
+void optional_alias_redecl(OptionalIntAlias *);
+void result_alias_redecl(IntShortResult *);
+void result_alias_redecl(AliasShortResult *);
+
+void accepts_optional(const OptionalInt *);
+void accepts_result(const IntShortResult *);
+
+void compatible_carrier_pointers(OptionalInt *optional,
+                                 OptionalIntAlias *optional_alias,
+                                 IntShortResult *result,
+                                 AliasShortResult *result_alias) {
+  optional_alias = optional;
+  optional = optional_alias;
+  ConstOptionalInt *const_optional = optional;
+  accepts_optional(const_optional);
+
+  result_alias = result;
+  result = result_alias;
+  accepts_result(result);
+  (void)const_optional;
+}
+
+// Distinct carrier payloads remain incompatible C types. The comparison is
+// diagnosed through ordinary declaration and pointer compatibility paths.
+void optional_payload_redecl(OptionalInt *); // c17-note {{previous declaration is here}} c23-note {{previous declaration is here}}
+void optional_payload_redecl(OptionalLong *); // c17-error {{conflicting types for 'optional_payload_redecl'}} c23-error {{conflicting types for 'optional_payload_redecl'}}
+
+void result_payload_redecl(IntShortResult *); // c17-note {{previous declaration is here}} c23-note {{previous declaration is here}}
+void result_payload_redecl(IntLongResult *); // c17-error {{conflicting types for 'result_payload_redecl'}} c23-error {{conflicting types for 'result_payload_redecl'}}
+
+void incompatible_carrier_pointers(OptionalInt *optional,
+                                   OptionalLong *different_optional,
+                                   IntShortResult *result,
+                                   IntLongResult *different_result) {
+  optional = different_optional; // c17-error {{incompatible pointer types}} c23-error {{incompatible pointer types}}
+  result = different_result; // c17-error {{incompatible pointer types}} c23-error {{incompatible pointer types}}
+}
diff --git a/clang/test/ObjC3/Sema/optional-expression-construction.c b/clang/test/ObjC3/Sema/optional-expression-construction.c
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/optional-expression-construction.c
@@ -0,0 +1,42 @@
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -fsyntax-only -verify %s
+
+typedef __objc3_optional(int) OptionalInt;
+typedef __objc3_optional(_Bool) OptionalBool;
+typedef __objc3_optional(id) OptionalId;
+typedef __objc3_optional(void) OptionalVoid;
+
+struct Pair { int value; };
+
+void construction_and_presence(struct Pair pair) {
+  OptionalInt present_zero = __objc3_some(int, 0);
+  OptionalInt absent = __objc3_none(int);
+  OptionalBool present_false = __objc3_some(_Bool, 0);
+  OptionalId present_null = __objc3_some(id, (id)0);
+  __objc3_optional(struct Pair) present_aggregate =
+      __objc3_some(struct Pair, pair);
+  OptionalVoid absent_void = __objc3_none(void);
+  OptionalVoid present_void = __objc3_some(void, (void)0);
+  _Bool has = __objc3_has_value(present_zero);
+  _Bool does_not_have = __objc3_has_value(absent);
+  _Bool aggregate_has = __objc3_has_value(present_aggregate);
+  (void)present_false;
+  (void)present_null;
+  (void)absent_void;
+  (void)present_void;
+  (void)has;
+  (void)does_not_have;
+  (void)aggregate_has;
+}
+
+void rejects_invalid_initialization(void) {
+  __objc3_some(struct Pair, 1); // expected-error {{incompatible type}}
+  __objc3_some(void, 1); // expected-error {{incompatible type}}
+  __objc3_has_value(1); // expected-error {{must have an Optional type}}
+}
+
+struct Incomplete; // expected-note 2 {{forward declaration of 'struct Incomplete'}}
+extern struct Incomplete incomplete_value;
+void incomplete_construction(void) {
+  __objc3_some(struct Incomplete, incomplete_value); // expected-error {{incomplete type}}
+  __objc3_none(struct Incomplete); // expected-error {{incomplete type}}
+}
diff --git a/clang/test/ObjC3/Sema/optional-expression-cxx-initialization.mm b/clang/test/ObjC3/Sema/optional-expression-cxx-initialization.mm
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Sema/optional-expression-cxx-initialization.mm
@@ -0,0 +1,60 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++20 -fsyntax-only -verify %s
+
+struct Source {};
+struct Target {
+  Target(const Source &);
+};
+struct ExplicitOnly { // expected-note {{candidate constructor (the implicit copy constructor) not viable: no known conversion from 'int' to 'const ExplicitOnly &' for 1st argument}} expected-note {{candidate constructor (the implicit move constructor) not viable: no known conversion from 'int' to 'ExplicitOnly &&' for 1st argument}}
+  explicit ExplicitOnly(int); // expected-note {{explicit constructor is not a candidate}}
+};
+struct MoveOnly {
+  MoveOnly();
+  MoveOnly(const MoveOnly &) = delete; // expected-note {{'MoveOnly' has been explicitly marked deleted here}}
+  MoveOnly(MoveOnly &&);
+};
+
+struct Source source;
+struct MoveOnly move_only;
+
+template <class T> using Optional = __objc3_optional(T);
+template <class T> auto make_optional(T value) {
+  return __objc3_some(T, value);
+}
+template <class T> bool is_present(Optional<T> value) {
+  return __objc3_has_value(value);
+}
+
+void conversion_and_move_semantics(void) {
+  auto converted = __objc3_some(Target, source);
+  auto moved = __objc3_some(MoveOnly, static_cast<MoveOnly &&>(move_only));
+  auto absent_move_only = __objc3_none(MoveOnly);
+  auto generic = make_optional(0);
+  bool generic_presence = is_present(generic);
+  bool false_is_present =
+      __objc3_has_value(__objc3_some(bool, false));
+  bool null_is_present =
+      __objc3_has_value(__objc3_some(id, (id)0));
+  (void)converted;
+  (void)moved;
+  (void)absent_move_only;
+  (void)generic_presence;
+  (void)false_is_present;
+  (void)null_is_present;
+}
+
+void rejects_invalid_operations(void) {
+  auto copied = __objc3_some(MoveOnly, move_only); // expected-error {{call to deleted constructor}}
+  auto explicit_conversion = __objc3_some(ExplicitOnly, 1); // expected-error {{no viable conversion from 'int' to 'ExplicitOnly'}}
+  (void)copied;
+  (void)explicit_conversion;
+}
+
+struct Incomplete; // expected-note 2 {{forward declaration of 'Incomplete'}}
+using IncompleteAlias = Incomplete;
+extern Incomplete incomplete_value;
+void incomplete_payload_is_diagnosed_at_construction(void) {
+  __objc3_some(IncompleteAlias, incomplete_value); // expected-error {{incomplete type}}
+  __objc3_none(IncompleteAlias); // expected-error {{incomplete type}}
+}
+
+
