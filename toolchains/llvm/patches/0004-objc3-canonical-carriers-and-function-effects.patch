+template<typename Derived>
+ExprResult TreeTransform<Derived>::TransformObjC3CarrierTransferExpr(
+    ObjC3CarrierTransferExpr *E) {
+  ExprResult Source = getDerived().TransformExpr(E->getSource());
+  if (Source.isInvalid())
+    return ExprError();
+  if (!getDerived().AlwaysRebuild() && Source.get() == E->getSource())
+    return E;
+  return SemaRef.ActOnObjC3CarrierTransferExpr(
+      E->isMove(), E->getKeywordLoc(), E->getLParenLoc(), Source.get(),
+      E->getRParenLoc());
+}
