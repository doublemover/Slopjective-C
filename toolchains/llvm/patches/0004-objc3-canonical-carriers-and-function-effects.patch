+  // A runtime ARC alternative does not make an invalid C++ alternative legal.
+  Outer copied = __objc3_copy(source); // expected-error {{deleted constructor}}
+  Outer constMoved = __objc3_move(constant); // expected-error {{deleted constructor}}
+}
