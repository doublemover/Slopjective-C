+                        Method->size_overridden_methods());
+      for (const auto *Method : Copy->methods())
+        if (Method->isExplicitlyDefaulted()) {
+          EXPECT_TRUE(Method->getExceptionSpecSourceRange().isInvalid());
+          EXPECT_TRUE(Method->isDefaulted());
+        }
+      ++Records;
+    }
+    EXPECT_EQ(4u, Records);
