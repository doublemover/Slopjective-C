+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -ast-dump %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-print %s | FileCheck %s --check-prefix=PRINT
+
+template <class T> struct Optional {};
+template <class T, class E> struct Result {};
+
+typedef int Scalar;
+typedef __objc3_optional(Scalar) OptionalScalar;
+typedef __objc3_result(Scalar, const char *) ResultScalar;
+
+// The child is canonicalized for carrier identity while typedef spelling stays
+// available through TypeSourceInfo.
+__objc3_optional(Scalar) canonical_optional(void);
+__objc3_optional(int) canonical_optional(void);
+__objc3_result(Scalar, const char *) canonical_result(void);
+__objc3_result(int, const char *) canonical_result(void);
+
+// `void` is valid source payload syntax on either Result arm and Optional's
+// tag-only form; payload-shape decisions belong to Sema, not the parser.
+typedef __objc3_optional(void) OptionalVoid;
+typedef __objc3_result(void, int) ResultVoidSuccess;
+typedef __objc3_result(int, void) ResultVoidError;
+typedef __objc3_result(void, void) ResultVoidBoth;
+
+// A pointer is a materialized payload shape in this parser slice. Function and
+// array abstract declarators are covered only by the grammar/recovery fixture;
+// their carrier admission awaits the Sema shape policy.
+typedef __objc3_optional(int *) OptionalPointer;
+typedef __objc3_result(__objc3_optional(int),
+                       __objc3_result(void, OptionalScalar)) NestedCarriers;
+
+template <class T> using OptionalT = __objc3_optional(T);
+template <class E> using VoidSuccessResult = __objc3_result(void, E);
+OptionalT<int> dependent_template_use;
+VoidSuccessResult<int> dependent_result_use;
+
+// The constructor spellings are distinct from ordinary C++ class templates.
+Optional<int> ordinaryOptional;
+Result<int, long> ordinaryResult;
+
+// Ordinary macros remain preprocessing macros. A replacement that expands to
+// the reserved implementation spelling is parsed as the extension type.
+#define OPTIONAL_TYPE __objc3_optional
+#define RESULT_TYPE __objc3_result
+#define OptionalCall(x) (x)
+#define ResultCall(x) (x)
+typedef OPTIONAL_TYPE(int) MacroOptional;
+typedef RESULT_TYPE(void, int) MacroResult;
+int macro_names_remain_macros = OptionalCall(1) + ResultCall(2);
