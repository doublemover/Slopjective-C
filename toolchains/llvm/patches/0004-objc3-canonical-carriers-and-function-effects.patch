+                                 &AST->getASTContext(), Options);
+      ASSERT_TRUE(Graph);
+      std::set<std::string> Paths;
+      std::function<void(const CFGBlock *, std::string, unsigned)> Visit =
+          [&](const CFGBlock *Block, std::string Events, unsigned Depth) {
+            ASSERT_LT(Depth, 100u);
+            for (const auto &Element : *Block) {
+              if (Element.getAs<CFGAutomaticObjDtor>())
+                Events += "destroy,";
+              else if (Element.getAs<CFGTemporaryDtor>())
+                Events += "temporary,";
+              else if (Element.getAs<CFGDeleteDtor>())
+                Events += "delete-dtor,";
+              else if (Element.getAs<CFGCleanupFunction>())
+                Events += "cleanup,";
+              else if (Element.getAs<CFGNewAllocator>())
+                Events += "allocate,";
+              else if (auto Statement = Element.getAs<CFGStmt>()) {
+                const Stmt *Node = Statement->getStmt();
+                if (isa<CXXConstructExpr>(Node))
+                  Events += "construct,";
+                else if (isa<CXXDynamicCastExpr>(Node))
+                  Events += "cast,";
+                else if (isa<CXXTypeidExpr>(Node))
+                  Events += "typeid,";
+                else if (isa<CXXDeleteExpr>(Node))
+                  Events += "delete,";
+                else if (const auto *Call = dyn_cast<CallExpr>(Node))
+                  if (const auto *Callee = Call->getDirectCallee())
+                    Events += Callee->getNameAsString() + ",";
