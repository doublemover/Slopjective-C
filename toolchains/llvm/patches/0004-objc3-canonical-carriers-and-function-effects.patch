@@ -0,0 +1,69 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s
+// expected-no-diagnostics
+
+bool guard(bool value) { return value; }
+bool let(bool value) { return value; }
+bool var(bool value) { return value; }
+struct Names { int guard, let, var; };
+
+int ordinary_identifiers(bool value) {
+  int let = 1;
+  int var = 2;
+  if (guard(value)) {
+    Names object = {let, var, 3};
+    if (object.guard)
+      goto guard;
+    goto let;
+  }
+guard:
+  if (value) goto var;
+let:
+  return let;
+var:
+  return var;
+}
+
+void contextual_boolean_names(bool value) {
+  guard let(value), var(value), guard(value) else { return; }
+}
+
+void contextual_bare_names(bool let, bool var) {
+  guard let, var else { return; }
+}
+
+#define guard(value) (value)
+#define let(value) (value)
+#define var(value) (value)
+bool ordinary_function_macros(bool value) {
+  return guard(let(var(value)));
+}
+#undef guard
+#undef let
+#undef var
+
+#define REQUIRE guard
+#define BIND let
+#define NAMED(name) name
+#define SOURCE(value) Some(int, value)
+int expanded_binding_heads(int input) {
+  REQUIRE BIND NAMED(first) = SOURCE(input), second = SOURCE(first) else {
+    return 0;
+  }
+  if BIND third = SOURCE(second), fourth = SOURCE(third) {
+    return first + second + third + fourth;
+  }
+  return 0;
+}
+
+// CHECK-LABEL: FunctionDecl {{.*}} ordinary_identifiers
+// CHECK-NOT: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} contextual_boolean_names
+// CHECK: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} contextual_bare_names
+// CHECK: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} ordinary_function_macros
+// CHECK-NOT: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} expanded_binding_heads
+// CHECK: ObjC3GuardStmt
+// CHECK: ObjC3IfBindingStmt
