+/// A typed Optional carrier. The payload is canonicalized when this type is
+/// created, so aliases of the same payload share one canonical carrier node.
+/// Source spelling and child TypeSourceInfo remain in ObjC3OptionalTypeLoc.
+class ObjC3OptionalType final : public Type, public llvm::FoldingSetNode {
+  friend class ASTContext;
+
+  QualType ElementType;
+
+  explicit ObjC3OptionalType(QualType Element)
+      : Type(ObjC3Optional, QualType(), Element->getDependence()),
+        ElementType(Element) {}
+
+public:
+  QualType getElementType() const { return ElementType; }
+
+  bool isSugared() const { return false; }
+  QualType desugar() const { return QualType(this, 0); }
+
+  void Profile(llvm::FoldingSetNodeID &ID) { Profile(ID, ElementType); }
+  static void Profile(llvm::FoldingSetNodeID &ID, QualType Element) {
+    ID.AddPointer(Element.getAsOpaquePtr());
+  }
+
+  static bool classof(const Type *T) {
+    return T->getTypeClass() == ObjC3Optional;
+  }
+};
+
+/// A typed Result carrier with independently canonicalized success and error
+/// arms. The representation/lowering contract is queried from ASTContext.
+class ObjC3ResultType final : public Type, public llvm::FoldingSetNode {
+  friend class ASTContext;
+
+  QualType SuccessType;
+  QualType ErrorType;
+
+  ObjC3ResultType(QualType Success, QualType Error)
+      : Type(ObjC3Result, QualType(), Success->getDependence() |
+                                      Error->getDependence()),
+        SuccessType(Success), ErrorType(Error) {}
+
+public:
+  QualType getSuccessType() const { return SuccessType; }
+  QualType getErrorType() const { return ErrorType; }
+
+  bool isSugared() const { return false; }
+  QualType desugar() const { return QualType(this, 0); }
+
+  void Profile(llvm::FoldingSetNodeID &ID) {
+    Profile(ID, SuccessType, ErrorType);
+  }
+  static void Profile(llvm::FoldingSetNodeID &ID, QualType Success,
+                      QualType Error) {
+    ID.AddPointer(Success.getAsOpaquePtr());
+    ID.AddPointer(Error.getAsOpaquePtr());
+  }
+
+  static bool classof(const Type *T) { return T->getTypeClass() == ObjC3Result; }
+};
