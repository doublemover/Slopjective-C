diff --git a/clang/test/ObjC3/Parser/optional-coalescing-lex.m b/clang/test/ObjC3/Parser/optional-coalescing-lex.m
new file mode 100644
index 000000000..51ce64cc5
--- /dev/null
+++ b/clang/test/ObjC3/Parser/optional-coalescing-lex.m
@@ -0,0 +1,17 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -ftrigraphs -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c23 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+// No whitespace is needed between the real punctuator and parentheses. The
+// ObjC3 operator takes priority over the inherited ??( trigraph spelling.
+int lexical_precedence(Optional(int) source) { return source??(4); }
+int escaped_newline(Optional(int) source) { return source ?\
+? (5); }
+
+// Token pasting produces the same punctuator as a source token.
+#define JOIN_IMPL(left, right) left ## right
+#define JOIN(left, right) JOIN_IMPL(left, right)
+int pasted_operator(Optional(int) source) { return source JOIN(?, ?) 7; }
+
+// Ordinary question marks retain their normal conditional meaning.
+int ordinary_ternary(int source) { return source ? 1 : 2; }
