+  switch (selector) {
+    Strong values[2] = {__objc3_some(id, object)}; // expected-note {{jump bypasses initialization of managed carrier storage}}
+    case 1:; // expected-error {{cannot jump}}
+  }
+}
+void permitted_exit(id object) {
+  { Strong values[2] = {__objc3_some(id, object)}; goto done; }
+ done:;
+}
