+TEST(ObjC3LifetimeScopes,
+     ReleasesOwnersAfterSourceActionsWithoutOptionalFlags) {
+  for (bool ARC : {false, true}) {
+    std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                     "-fobjc-version=3",
+                                     "-fobjc-runtime=gnustep-2.2"};
+    if (ARC)
+      Args.push_back("-fobjc-arc");
+    auto AST = tooling::buildASTFromCodeWithArgs(R"(
+      void action(void) __attribute__((nothrow));
+      void body(void) __attribute__((nothrow));
+      void after(void) __attribute__((nothrow));
+      void exercise(id source) {
+        defer { action(); }
+        keepAlive(source);
+        withLifetime(source) { body(); }
+        after();
+      }
+    )",
+                                                 Args, "lifetime-scopes.mm");
+    ASSERT_TRUE(AST);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    FunctionDecl *Function = nullptr;
+    for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *F = dyn_cast<FunctionDecl>(D))
+        if (F->getName() == "exercise")
+          Function = F;
+    ASSERT_TRUE(Function);
+    CFG::BuildOptions Options;
+    Options.AddImplicitDtors = Options.AddLifetime = Options.AddScopes = false;
+    Options.setAllAlwaysAdd();
+    auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                               &AST->getASTContext(), Options);
+    ASSERT_TRUE(Graph);
+    std::string Events;
+    const CFGBlock *Block = &Graph->getEntry();
+    unsigned Steps = 0;
+    std::set<const VarDecl *> Owners;
+    while (Block) {
+      ASSERT_LT(++Steps, 40u);
+      for (auto Element : *Block) {
+        if (auto Release = Element.getAs<CFGObjC3LifetimeRelease>()) {
+          Events += "L";
+          Owners.insert(Release->getVarDecl());
+        } else if (auto Statement = Element.getAs<CFGStmt>()) {
+          if (auto *Call = dyn_cast<CallExpr>(Statement->getStmt()))
+            if (auto *F = Call->getDirectCallee()) {
+              if (F->getName() == "body")
+                Events += "B";
+              if (F->getName() == "after")
+                Events += "Z";
+              if (F->getName() == "action")
+                Events += "A";
+            }
+        }
+      }
+      const CFGBlock *Next = nullptr;
+      for (auto Successor : Block->succs())
+        if (const CFGBlock *Reachable = Successor.getReachableBlock()) {
+          ASSERT_FALSE(Next);
+          Next = Reachable;
+        }
+      Block = Next;
+    }
+    EXPECT_EQ("BLZAL", Events);
+    EXPECT_EQ(2u, Owners.size());
+  }
+}
