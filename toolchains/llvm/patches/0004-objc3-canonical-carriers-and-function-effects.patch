+  }
+  bool overlapsUnion(Storage Location, Storage Other) const {
+    if (Location.first != Other.first)
+      return false;
+    for (unsigned Depth = 0; Depth != 32 && path(Location); ++Depth) {
+      Location = parentStorage(Location);
+      QualType Type = storageType(Location);
+      if (!Type.isNull())
+        if (const auto *Record = Type->getAs<RecordType>())
+          if (Record->getDecl()->isUnion() && within(Other, Location))
+            return true;
+    }
+    return false;
+  }
+  Value contents(Storage Location, QualType Type, const Facts &State,
+                 bool Effects = false) const {
+    Value Result = empty();
+    if (!Location.first)
+      return Result;
+    bool Aggregate = !Type.isNull() && (Type->isRecordType() || Type->isArrayType());
+    bool CopiedScalar = !Type.isNull() &&
+                        (Type->isArithmeticType() || Type->isEnumeralType());
+    unsigned Query = path(Location);
+    for (auto [Other, Index] : Slots) {
+      if (Other.first != Location.first)
+        continue;
+      if (pathsMayAlias(path(Other), Query) ||
+          (!CopiedScalar && within(Location, Other)) ||
+          overlapsUnion(Location, Other) || (Aggregate && within(Other, Location)))
+        Result |= Effects ? State.Effects[Index] : State.Values[Index];
+    }
+    return Result;
+  }
+  Value storageTargets(Storage Location, QualType Type, const Facts &State) const {
+    Value Result(Slots.size());
+    if (!Location.first)
+      return Result;
+    bool Aggregate = !Type.isNull() && (Type->isRecordType() || Type->isArrayType());
+    unsigned Query = path(Location);
+    for (auto [Other, Index] : Slots)
+      if (Other.first == Location.first &&
+          (pathsMayAlias(path(Other), Query) || within(Location, Other) ||
+           overlapsUnion(Location, Other) || (Aggregate && within(Other, Location))))
+        Result |= State.MayTargets[Index];
+    return Result;
+  }
+  Storage location(unsigned Index) const {
+    for (auto [Location, Slot] : Slots)
+      if (Slot == Index)
+        return Location;
+    return {};
+  }
+  Value exposedTargets(const Value &Targets, const Facts &State) const {
+    Value Result = empty(), Pending = Targets;
+    Value Seen(Slots.size());
+    while (true) {
+      Pending.reset(Seen);
+      int Index = Pending.find_first();
+      if (Index < 0)
+        break;
+      Seen.set(Index);
+      Storage Location = location(Index);
+      Result |= contents(Location, storageType(Location), State);
+      Pending |= storageTargets(Location, storageType(Location), State);
+    }
+    return Result;
+  }
+  Value possibleTargets(const Expr *E, const Facts &State) const {
+    Value Targets(Slots.size());
+    if (!E)
+      return Targets;
+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return possibleTargets(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return possibleTargets(Opaque->getSourceExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      Targets = possibleTargets(Conditional->getTrueExpr(), State);
+      Targets |= possibleTargets(Conditional->getFalseExpr(), State);
+      return Targets;
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp())
+        return possibleTargets(Binary->getRHS(), State);
+    Storage Target = referent(E, &State);
+    if (auto Found = Slots.find(Target); Found != Slots.end()) {
+      Targets.set(Found->second);
+      return Targets;
+    }
+    if (auto Found = Slots.find(storage(E, &State)); Found != Slots.end())
+      return State.MayTargets[Found->second];
+    return Targets;
+  }
+  Value capturedTargets(const Expr *Initializer, const Facts &State) const {
+    Value Targets(Slots.size());
+    if (!Initializer) return Targets;
+    const Expr *Written = Initializer->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Written))
+      return capturedTargets(Cleanups->getSubExpr(), State);
