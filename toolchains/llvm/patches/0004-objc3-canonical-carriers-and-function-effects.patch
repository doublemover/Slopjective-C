+
+template <class E> int pch_dependent_try(int (*fn)() __objc3_throws(E))
+    __objc3_throws(E) {
+  return __objc3_try(fn());
+}
+
+inline int pch_all_try_kinds() __objc3_throws(PCHError) {
+  int value = __objc3_try(pch_typed_call());
