+TEST(ObjC3LifetimeTooling, ImportsOwnersAndTraversesWrittenOperandOnce) {
+  constexpr llvm::StringLiteral Source = R"(
+    void observe(id);
+    void exercise(id source) {
+      keepAlive(source);
+      withLifetime(source) { observe(source); }
+    }
+  )";
+  auto From =
+      tooling::buildASTFromCodeWithArgs(Source, conditionArgs(), "life.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      "", conditionArgs(), "life-to.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(),
+      {{"life.mm", Source.str()}});
+  ASSERT_TRUE(From && To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  auto Imported = Importer.Import(findExercise(*From));
+  ASSERT_TRUE(static_cast<bool>(Imported))
+      << llvm::toString(Imported.takeError());
+  auto *Function = cast<FunctionDecl>(*Imported);
+  class Visitor : public RecursiveASTVisitor<Visitor> {
+  public:
+    SmallVector<ObjC3LifetimeStmt *, 4> Lifetimes;
+    unsigned References = 0, Hidden = 0;
+    bool VisitObjC3LifetimeStmt(ObjC3LifetimeStmt *S) {
+      Lifetimes.push_back(S);
+      return true;
+    }
+    bool VisitVarDecl(VarDecl *V) {
+      Hidden += V->isImplicit();
+      return true;
+    }
+    bool VisitDeclRefExpr(DeclRefExpr *E) {
+      References += E->getDecl()->getName() == "source";
+      return true;
+    }
+  } V;
+  ASSERT_TRUE(V.TraverseStmt(Function->getBody()));
+  ASSERT_EQ(2u, V.Lifetimes.size());
+  EXPECT_EQ(3u, V.References);
+  EXPECT_EQ(0u, V.Hidden);
+  EXPECT_TRUE(V.Lifetimes[0]->isKeepAlive());
+  EXPECT_FALSE(V.Lifetimes[1]->isKeepAlive());
+  for (auto *S : V.Lifetimes) {
+    EXPECT_TRUE(S->getBindingDecl()->hasAttr<ObjCPreciseLifetimeAttr>());
+    EXPECT_TRUE(S->getBindingDecl()->hasAttr<ObjC3LifetimeBindingAttr>());
+    EXPECT_EQ(&To->getASTContext(), &S->getBindingDecl()->getASTContext());
+  }
+  Occurrences Index;
+  index::IndexingOptions Options;
+  Options.IndexFunctionLocals = true;
+  const Decl *Decls[] = {Function};
+  index::indexTopLevelDecls(To->getASTContext(), To->getPreprocessor(), Decls,
+                            Index, Options);
+  EXPECT_EQ(3u, Index.count("source", index::SymbolRole::Reference));
+  std::string Printed;
+  llvm::raw_string_ostream OS(Printed);
+  Function->getBody()->printPretty(OS, nullptr,
+                                   To->getASTContext().getPrintingPolicy());
+  EXPECT_NE(std::string::npos, Printed.find("keepAlive(source)"));
+  EXPECT_NE(std::string::npos, Printed.find("withLifetime(source)"));
+}
