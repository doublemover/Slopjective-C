+void addObjC3OwnershipTypeIdentity(llvm::FoldingSetNodeID &ID,
+                                  const ASTContext &Context, QualType Type) {
+  ID.AddBoolean(!Type.isNull());
+  if (Type.isNull())
+    return;
+  if (const auto *Family = getObjC3RetainableFamily(Context, Type)) {
+    ID.AddString("objc3.retainable-family");
+    ID.AddString(Family->getFamily()->getName());
+    ID.AddBoolean(Type->isObjCRetainableType());
+  }
+  ID.AddBoolean(isObjC3BorrowedType(Context, Type));
+  while (true) {
+    QualType Next = Type.getSingleStepDesugaredType(Context);
+    if (Next == Type)
+      break;
+    Type = Next;
+  }
+  if (Type->isPointerType() || Type->isReferenceType() ||
+      Type->isBlockPointerType()) {
+    ID.AddInteger(1);
+    addObjC3OwnershipTypeIdentity(ID, Context, Type->getPointeeType());
+  } else if (const auto *Array = dyn_cast<ArrayType>(Type.getTypePtr())) {
+    ID.AddInteger(2);
+    addObjC3OwnershipTypeIdentity(ID, Context, Array->getElementType());
+  } else if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Type.getTypePtr())) {
+    ID.AddInteger(4);
+    addObjC3OwnershipTypeIdentity(ID, Context, Optional->getElementType());
+  } else if (const auto *Result = dyn_cast<ObjC3ResultType>(Type.getTypePtr())) {
+    ID.AddInteger(5);
+    addObjC3OwnershipTypeIdentity(ID, Context, Result->getSuccessType());
+    addObjC3OwnershipTypeIdentity(ID, Context, Result->getErrorType());
+  } else if (const auto *Function = dyn_cast<FunctionType>(Type.getTypePtr())) {
+    ID.AddInteger(3);
+    addObjC3OwnershipTypeIdentity(ID, Context, Function->getReturnType());
+    if (const auto *Prototype = dyn_cast<FunctionProtoType>(Function)) {
+      ID.AddInteger(Prototype->getNumParams());
+      for (QualType Parameter : Prototype->param_types())
+        addObjC3OwnershipTypeIdentity(ID, Context, Parameter);
+    }
+  } else {
+    ID.AddInteger(0);
+  }
+}
+void addObjC3OwnershipIdentity(llvm::FoldingSetNodeID &ID, const Decl *D) {
+  const ASTContext &Context = D->getASTContext();
+  if (const auto *Value = dyn_cast<ValueDecl>(D))
+    addObjC3OwnershipTypeIdentity(ID, Context, Value->getType());
+  if (const auto *Alias = dyn_cast<TypedefNameDecl>(D))
+    addObjC3OwnershipTypeIdentity(ID, Context,
+        Context.getTypedefType(ElaboratedTypeKeyword::None, std::nullopt, Alias));
+  if (const auto *Method = dyn_cast<ObjCMethodDecl>(D)) {
+    addObjC3OwnershipTypeIdentity(ID, Context, Method->getReturnType());
+    for (const ParmVarDecl *Parameter : Method->parameters())
+      addObjC3OwnershipTypeIdentity(ID, Context, Parameter->getType());
+  }
+  if (const auto *Function = dyn_cast<FunctionDecl>(D))
+    if (const Attr *Operation = getObjC3FamilyOperation(Function)) {
+      ID.AddString(isa<ObjCFamilyRetainAttr>(Operation) ? "objc3.family-retain" :
+          isa<ObjCFamilyReleaseAttr>(Operation) ? "objc3.family-release" : "objc3.family-autorelease");
+      ID.AddString(getObjC3FamilyOperationName(Operation)->getName());
+    }
+  const auto *Contract = getObjC3BorrowedReturnContract(D);
+  ID.AddBoolean(Contract);
+  if (Contract)
+    ID.AddInteger(Contract->getOwnerIndex());
+}
+void addObjC3IsolationIdentity(llvm::FoldingSetNodeID &ID, const Decl *D) {
+  const auto *Executor = getObjC3Executor(D);
+  ID.AddBoolean(Executor);
+  if (Executor) ID.AddString(Executor->getExecutor());
+  ID.AddBoolean(isObjC3ActorIsolated(D));
+  ID.AddBoolean(isObjC3Nonisolated(D));
