@@ -0,0 +1,67 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -Wno-nullability-completeness -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -fobjc-arc -Wno-nullability-completeness -fsyntax-only -verify %s
+
+@interface FlowReceiver
+- (void)ping;
+- (int)number;
+@end
+typedef FlowReceiver * _Nullable Nullable;
+typedef FlowReceiver * _Nonnull Nonnull;
+
+void equality_with_nonnull_peer(Nullable candidate, Nonnull peer) {
+  guard candidate == peer else { return; }
+  [candidate ping];
+}
+
+void negative_inequality_with_nonnull_peer(Nullable candidate, Nonnull peer) {
+  guard !(candidate != peer) else { return; }
+  [candidate ping];
+}
+
+void unequal_to_nonnull_still_allows_nil(Nullable candidate, Nonnull peer) {
+  guard candidate != peer else { return; }
+  [candidate ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+struct UnprovenInitializer {
+  int value;
+  UnprovenInitializer(Nullable source)
+      : value([source number]) {} // expected-error {{ordinary message send requires a nonnull receiver}}
+};
+
+struct ProvenInitializer {
+  int value;
+  ProvenInitializer(Nullable source)
+      : value(source ? [source number] : 0) {}
+};
+
+struct DefaultInitializer {
+  Nullable source;
+  int value = [source number]; // expected-error {{ordinary message send requires a nonnull receiver}}
+  DefaultInitializer() : source((id)0) {}
+};
+
+struct ResetAtFullExpressionEnd {
+  Nullable __strong *slot;
+  explicit ResetAtFullExpressionEnd(Nullable __strong *slot) : slot(slot) {}
+  ~ResetAtFullExpressionEnd() { *slot = (id)0; }
+};
+Nullable source_with_temporary(ResetAtFullExpressionEnd);
+
+void a_condition_cleanup_can_change_tested_storage(Nullable value) {
+  guard (value = source_with_temporary(ResetAtFullExpressionEnd(&value))) != (id)0
+      else { return; }
+  [value ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+Nullable next_source(void);
+void assignment_test_without_cleanup_refines(Nullable value) {
+  guard (value = next_source()) != (id)0 else { return; }
+  [value ping];
+}
+
+template <class T> struct TemplateInitializer {
+  int value;
+  TemplateInitializer(T source) : value(source ? [source number] : 0) {}
+};
+template struct TemplateInitializer<Nullable>;
