+//===--- ObjC3GuardExit.h - Native guard scope-exit proof ---------*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_SEMA_OBJC3GUARDEXIT_H
+#define LLVM_CLANG_SEMA_OBJC3GUARDEXIT_H
+namespace clang {
+class Sema;
+class CompoundStmt;
+namespace objc3 {
+enum class GuardExitResult {
+  Proven,
+  MayFallThrough,
+  InvalidTransfer,
+  UnsupportedControlFlow,
+  NoScopeExit
+};
+// Call after the enclosing callable has finished, including forward labels.
+GuardExitResult proveGuardScopeExit(Sema &, const CompoundStmt *Else,
+                                    const CompoundStmt *ContainingScope);
+} // namespace objc3
+} // namespace clang
+#endif
diff --git a/clang/lib/Sema/SemaObjC3GuardExit.cpp b/clang/lib/Sema/SemaObjC3GuardExit.cpp
new file mode 100644
index 000000000..0f137a062
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3GuardExit.cpp
@@ -0,0 +1,240 @@
+//===--- SemaObjC3GuardExit.cpp - Native guard exit proof ----------------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/Stmt.h"
+#include "clang/AST/StmtObjC.h"
+#include "clang/Analysis/CFG.h"
+#include "clang/Sema/ObjC3GuardExit.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace clang;
+using clang::objc3::GuardExitResult;
+namespace {
+bool mayThrowNative(const FunctionDecl *Function) {
+  if (!Function || Function->hasAttr<NoThrowAttr>())
+    return false;
+  const auto *Prototype = Function->getType()->getAs<FunctionProtoType>();
+  return !Prototype ||
+         isUnresolvedExceptionSpec(Prototype->getExceptionSpecType()) ||
+         !Prototype->isNothrow();
+}
+
+void collectNodes(const Stmt *S, llvm::DenseSet<const Stmt *> &Nodes) {
+  if (!S)
+    return;
+  Nodes.insert(S);
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(S)) {
+    for (const Expr *Init : Lambda->capture_inits())
+      collectNodes(Init, Nodes);
+    return;
+  }
+  if (isa<BlockExpr>(S))
+    return;
+  for (const Stmt *Child : S->children())
+    collectNodes(Child, Nodes);
+}
+void collectNativeHandlers(
+    const Stmt *Node, const Stmt *Handler,
+    llvm::DenseMap<const Stmt *, const Stmt *> &Handlers) {
+  if (!Node)
+    return;
+  Handlers[Node] = Handler;
+  if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+    for (const Expr *Init : Lambda->capture_inits())
+      collectNativeHandlers(Init, Handler, Handlers);
+    return;
+  }
+  if (isa<BlockExpr>(Node))
+    return;
+  if (const auto *Try = dyn_cast<CXXTryStmt>(Node)) {
+    collectNativeHandlers(Try->getTryBlock(), Try, Handlers);
+    for (unsigned I = 0; I != Try->getNumHandlers(); ++I)
+      collectNativeHandlers(Try->getHandler(I), Handler, Handlers);
+    return;
+  }
+  if (const auto *Try = dyn_cast<ObjCAtTryStmt>(Node)) {
+    collectNativeHandlers(Try->getTryBody(), Try, Handlers);
+    for (const ObjCAtCatchStmt *Catch : Try->catch_stmts())
+      collectNativeHandlers(Catch, Handler, Handlers);
+    if (const auto *Finally = Try->getFinallyStmt())
+      collectNativeHandlers(Finally, Handler, Handlers);
+    return;
+  }
+  for (const Stmt *Child : Node->children())
+    collectNativeHandlers(Child, Handler, Handlers);
+}
+
+void collectOuterTransfers(const Stmt *S, unsigned BreakDepth,
+                           unsigned ContinueDepth,
+                           llvm::DenseSet<const Stmt *> &Transfers) {
+  if (!S || isa<LambdaExpr, BlockExpr>(S))
+    return;
+  if ((isa<BreakStmt>(S) && !BreakDepth) ||
+      (isa<ContinueStmt>(S) && !ContinueDepth))
+    Transfers.insert(S);
+  bool Loop =
+      isa<ForStmt, WhileStmt, DoStmt, CXXForRangeStmt, ObjCForCollectionStmt>(
+          S);
+  BreakDepth += Loop || isa<SwitchStmt>(S);
+  ContinueDepth += Loop;
+  for (const Stmt *Child : S->children())
+    collectOuterTransfers(Child, BreakDepth, ContinueDepth, Transfers);
+}
+} // namespace
+
+GuardExitResult
+clang::objc3::proveGuardScopeExit(Sema &SemaRef, const CompoundStmt *Else,
+                                  const CompoundStmt *ContainingScope) {
+  if (!Else || !ContainingScope)
+    return GuardExitResult::UnsupportedControlFlow;
+  ASTContext &C = SemaRef.Context;
+  llvm::DenseSet<const Stmt *> ElseNodes, ScopeNodes, OuterTransfers;
+  collectNodes(Else, ElseNodes);
+  collectNodes(ContainingScope, ScopeNodes);
+  collectOuterTransfers(Else, 0, 0, OuterTransfers);
+  llvm::DenseMap<const Stmt *, const Stmt *> Handlers;
+  collectNativeHandlers(Else, nullptr, Handlers);
+  llvm::DenseMap<const VarDecl *, const Stmt *> VariableHandlers;
+  for (const auto &Entry : Handlers)
+    if (const auto *Declarations = dyn_cast<DeclStmt>(Entry.first))
+      for (const Decl *Declaration : Declarations->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(Declaration))
+          VariableHandlers[Variable] = Entry.second;
+  for (const Stmt *Node : ElseNodes) {
+    if (isa<DeferStmt>(Node))
+      return GuardExitResult::UnsupportedControlFlow;
+    // These runtime entry/cleanup calls are not represented by expressions in
+    // Clang's CFG. A local native handler could resume if such a call throws.
+    if (Handlers.lookup(Node) &&
+        isa<ObjCAutoreleasePoolStmt, ObjCAtSynchronizedStmt>(Node))
+      return GuardExitResult::UnsupportedControlFlow;
+  }
+  SourceLocation Loc = Else->getEndLoc();
+  // A unique return is the forbidden fallthrough sentinel. The synthetic loop
+  // gives external break/continue valid CFG targets; they are recognized below
+  // as real scope exits before traversing those synthetic successors.
+  auto *Marker = ReturnStmt::Create(C, Loc, nullptr, nullptr);
+  Stmt *Sequence[] = {const_cast<CompoundStmt *>(Else), Marker};
+  auto *Body = CompoundStmt::Create(C, Sequence, FPOptionsOverride(), Loc, Loc);
+  auto *True = IntegerLiteral::Create(C, llvm::APInt(32, 1), C.IntTy, Loc);
+  auto *Loop = WhileStmt::Create(C, nullptr, True, Body, Loc, Loc, Loc);
+  CFG::BuildOptions Options;
+  Options.AddEHEdges = true;
+  Options.AddImplicitDtors = true;
+  Options.AddTemporaryDtors = true;
+  Options.setAllAlwaysAdd();
+  std::unique_ptr<CFG> Graph = CFG::buildCFG(nullptr, Loop, &C, Options);
+  if (!Graph)
+    return GuardExitResult::UnsupportedControlFlow;
+  llvm::DenseMap<const Stmt *, const CFGBlock *> Dispatches;
+  for (const CFGBlock *Block : *Graph)
+    if (const Stmt *Terminator = Block->getTerminatorStmt())
+      if (isa<CXXTryStmt, ObjCAtTryStmt>(Terminator))
+        Dispatches[Terminator] = Block;
+  llvm::SmallVector<const CFGBlock *, 16> Pending{&Graph->getEntry()};
+  llvm::DenseSet<const CFGBlock *> Visited;
+  llvm::DenseSet<const CFGBlock *> Terminals;
+  llvm::DenseMap<const CFGBlock *, llvm::SmallVector<const CFGBlock *, 2>>
+      Predecessors;
+  while (!Pending.empty()) {
+    const CFGBlock *Block = Pending.pop_back_val();
+    if (!Visited.insert(Block).second)
+      continue;
+    for (const CFGElement &Element : *Block) {
+      const Stmt *Handler = nullptr;
+      if (auto Statement = Element.getAs<CFGStmt>()) {
+        const Stmt *Node = Statement->getStmt();
+        if (Node == Marker)
+          return GuardExitResult::MayFallThrough;
+        if (const Stmt *Candidate = Handlers.lookup(Node)) {
+          bool CanThrow = SemaRef.canThrow(Node) != CT_Cannot;
+          // An outward goto has no target block in this synthetic CFG, so its
+          // backpatch cannot materialize all variable cleanups. Account for
+          // cleanup attributes at their declaration, as Sema already does for
+          // C++ destructors, without depending on that backpatch.
+          if (const auto *Declarations = dyn_cast<DeclStmt>(Node))
+            for (const Decl *Declaration : Declarations->decls())
+              if (const auto *Variable = dyn_cast<VarDecl>(Declaration))
+                if (const auto *Cleanup = Variable->getAttr<CleanupAttr>())
+                  CanThrow |= mayThrowNative(Cleanup->getFunctionDecl());
+          if (CanThrow)
+            Handler = Candidate;
+        }
+      } else if (auto Dtor = Element.getAs<CFGImplicitDtor>()) {
+        if (mayThrowNative(Dtor->getDestructorDecl(C))) {
+          if (auto Automatic = Element.getAs<CFGAutomaticObjDtor>())
+            Handler = VariableHandlers.lookup(Automatic->getVarDecl());
+          else if (auto Temporary = Element.getAs<CFGTemporaryDtor>())
+            Handler = Handlers.lookup(Temporary->getBindTemporaryExpr());
+          else if (auto Delete = Element.getAs<CFGDeleteDtor>())
+            Handler = Handlers.lookup(Delete->getDeleteExpr());
+        }
+      } else if (auto Cleanup = Element.getAs<CFGCleanupFunction>()) {
+        if (mayThrowNative(Cleanup->getFunctionDecl()))
+          Handler = VariableHandlers.lookup(Cleanup->getVarDecl());
+      }
+      // Ordinary CFGs omit several native EH edges. Restore expression and
+      // cleanup catches here, before accepting an outward break/goto in this
+      // block. Query only reachable nodes; checked dispatch stays independent.
+      if (Handler) {
+        const CFGBlock *Destination = Dispatches.lookup(Handler);
+        if (!Destination)
+          return GuardExitResult::UnsupportedControlFlow;
+        Pending.push_back(Destination);
+        Predecessors[Destination].push_back(Block);
+      }
+    }
+    const Stmt *Terminator = Block->getTerminatorStmt();
+    if (OuterTransfers.contains(Terminator)) {
+      Terminals.insert(Block);
+      continue;
+    }
+    if (const auto *Goto = dyn_cast_or_null<GotoStmt>(Terminator)) {
+      const LabelStmt *Target = Goto->getLabel()->getStmt();
+      if (!Target)
+        return GuardExitResult::InvalidTransfer;
+      if (!ElseNodes.contains(Target)) {
+        if (ScopeNodes.contains(Target))
+          return GuardExitResult::InvalidTransfer;
+        Terminals.insert(Block);
+        continue;
+      }
+    }
+    if (isa_and_nonnull<IndirectGotoStmt>(Terminator))
+      return GuardExitResult::InvalidTransfer;
+    if (Block == &Graph->getExit()) {
+      Terminals.insert(Block);
+      continue;
+    }
+    for (const auto &Edge : Block->succs())
+      if (const CFGBlock *Next = Edge.getReachableBlock()) {
+        Pending.push_back(Next);
+        Predecessors[Next].push_back(Block);
+      }
+  }
+  // Every reachable region needs a scope-exit witness. In particular, a
+  // closed local loop is not made conforming by a return on another branch.
+  // Loops with a continuation are analyzed by that continuation, without
+  // claiming a general proof of loop termination.
+  Pending.assign(Terminals.begin(), Terminals.end());
+  llvm::DenseSet<const CFGBlock *> CanReachExit;
+  while (!Pending.empty()) {
+    const CFGBlock *Block = Pending.pop_back_val();
+    if (!CanReachExit.insert(Block).second)
+      continue;
+    for (const CFGBlock *Previous : Predecessors[Block])
+      Pending.push_back(Previous);
+  }
+  for (const CFGBlock *Block : Visited)
+    if (!CanReachExit.contains(Block))
+      return GuardExitResult::NoScopeExit;
+  return GuardExitResult::Proven;
+}
