diff --git a/clang/test/ObjC3/AST/native-async-block-pch.mm b/clang/test/ObjC3/AST/native-async-block-pch.mm
new file mode 100644
index 000000000..be658a600
--- /dev/null
+++ b/clang/test/ObjC3/AST/native-async-block-pch.mm
@@ -0,0 +1,27 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -emit-pch -o %t %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fexceptions -fcxx-exceptions -include-pch %t -emit-llvm -o /dev/null -verify %s
+// expected-no-diagnostics
+#ifndef BLOCK_PCH
+#define BLOCK_PCH
+#include "../CodeGen/Inputs/native-async-task.h"
+@protocol Error @end
+using CheckedBlock = int (^)(id<Error>) __objc3_async __objc3_throws(id<Error>);
+inline int block_leaf(int n) __objc3_async { return n; }
+inline void body_in_pch(int bias) {
+  auto block = ^int(int delta) __objc3_async {
+    return bias + __objc3_await block_leaf(delta);
+  };
+  (void)block(2);
+  auto checked = ^int(id<Error> error) __objc3_async __objc3_throws(id<Error>) {
+    if (error) __objc3_throw(error);
+    return __objc3_await block_leaf(bias);
+  };
+  CheckedBlock same = checked;
+  (void)same;
+}
+#else
+int invoke(CheckedBlock block, id<Error> error) __objc3_async __objc3_throws(id<Error>) {
+  return __objc3_try(__objc3_await block(error));
+}
+void instantiate() { body_in_pch(40); }
+#endif
