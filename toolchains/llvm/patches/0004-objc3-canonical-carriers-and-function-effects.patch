--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3CarrierARC.h
@@ -0,0 +1,15 @@
+//===--- SemaObjC3CarrierARC.h - ARC carrier type checks --------*- C++ -*-===//
+#ifndef LLVM_CLANG_LIB_SEMA_SEMAOBJC3CARRIERARC_H
+#define LLVM_CLANG_LIB_SEMA_SEMAOBJC3CARRIERARC_H
+
+#include "clang/AST/Type.h"
+namespace clang {
+class Sema;
+
+/// Normalize implicit ARC object ownership for a stored carrier payload, and
+/// reject ownership modes that do not describe stable carrier storage.
+/// Returns true after issuing a diagnostic.
+bool normalizeObjC3CarrierPayloadOwnership(Sema &S, SourceLocation Loc,
+                                           QualType &PayloadType);
+} // namespace clang
