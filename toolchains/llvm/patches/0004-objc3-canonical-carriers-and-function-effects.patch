+++ b/clang/test/ObjC3/Sema/native-async-type-identity.c
@@ -0,0 +1,39 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x c -std=c17 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x c++ -std=c++20 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x c -std=c17 -DNEGATIVE -fsyntax-only -verify %s
+
+#ifdef NEGATIVE
+const char *bad = __builtin_objc3_type_identity(42); // expected-error {{requires a pointer to the result type}}
+const char *missing = __builtin_objc3_type_identity(); // expected-error {{too few arguments}}
+const char *extra = __builtin_objc3_type_identity((int *)0, (int *)0); // expected-error {{too many arguments}}
+#else
+typedef int Alias;
+struct Pair { int left, right; };
+
+const char *integer_identity = __builtin_objc3_type_identity((int *)0);
+const char *alias_identity = __builtin_objc3_type_identity((Alias *)0);
+const char *record_identity = __builtin_objc3_type_identity((struct Pair *)0);
+const char *void_identity = __builtin_objc3_type_identity((void *)0);
+
+// CHECK-DAG: c"objc3.async.v1:_ZTSi\00"
+// CHECK-DAG: c"objc3.async.v1:_ZTS4Pair\00"
+// CHECK-DAG: c"objc3.async.v1:_ZTSv\00"
+
+#ifdef __cplusplus
+template <class T> constexpr const char *identity() {
+  return __builtin_objc3_type_identity((T *)0);
+}
+static_assert(__builtin_strcmp(identity<Alias>(), identity<int>()) == 0);
+static_assert(__builtin_strcmp(identity<unsigned>(), identity<int>()) != 0);
+static_assert(__builtin_strcmp(identity<Pair>(),
+                              __builtin_objc3_type_identity((Pair *)0)) == 0);
+void local_type_keys() {
+  auto closure = [value = 42] { return value; };
+  struct { int value; } record;
+  static_assert(__builtin_strncmp(
+      identity<decltype(closure)>(), "objc3.async.local.v1:", 21) == 0);
+  static_assert(__builtin_strncmp(
+      identity<decltype(record)>(), "objc3.async.local.v1:", 21) == 0);
+}
+#endif
+#endif
