+    for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())
+      if(auto *NS=dyn_cast<NamespaceDecl>(D))
+        for(auto *Member:NS->decls())
+          if(auto *Pattern=dyn_cast<ClassTemplateDecl>(Member)) {
+            llvm::StringRef Owner="objc3_detached_owner";
+            Pattern->getTemplatedDecl()->addAttr(AbiTagAttr::Create(
+                From->getASTContext(),&Owner,1,Pattern->getSourceRange()));
+          } else if(auto *Partial=dyn_cast<ClassTemplatePartialSpecializationDecl>(Member)) {
+            llvm::StringRef Owner="objc3_detached_owner";
