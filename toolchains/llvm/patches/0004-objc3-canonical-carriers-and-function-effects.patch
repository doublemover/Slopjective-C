diff --git a/clang/test/ObjC3/Inputs/keypath-abi.h b/clang/test/ObjC3/Inputs/keypath-abi.h
new file mode 100644
index 000000000..db307630e
--- /dev/null
+++ b/clang/test/ObjC3/Inputs/keypath-abi.h
@@ -0,0 +1,24 @@
+#ifndef KEY_PATH_ABI_FIXTURE_H
+#define KEY_PATH_ABI_FIXTURE_H
+/* This mirrors the public native metadata ABI without a target sysroot. The
+ * maintained native-library fixtures import the installed objc3.keypath. */
+typedef struct objc3_keypath_component_v2 {
+  const char *owner_type;
+  const char *declaration_owner;
+  const char *member;
+  const char *value_type;
+  const char *getter_selector;
+  const char *setter_selector;
+  __UINT32_TYPE__ flags;
+  __UINT32_TYPE__ reserved;
+} objc3_keypath_component_v2;
+typedef struct objc3_keypath_descriptor_v2 {
+  __UINT32_TYPE__ abi_version;
+  __UINT32_TYPE__ flags;
+  __UINT64_TYPE__ component_count;
+  const char *root_type;
+  const char *value_type;
+  const char *path;
+  const objc3_keypath_component_v2 *components;
+} objc3_keypath_descriptor_v2;
+#endif
diff --git a/clang/test/ObjC3/Sema/native-c-async-definitions.m b/clang/test/ObjC3/Sema/native-c-async-definitions.m
new file mode 100644
index 000000000..933ab9414
--- /dev/null
+++ b/clang/test/ObjC3/Sema/native-c-async-definitions.m
@@ -0,0 +1,31 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -fobjc3-strict-concurrency -Wobjc3-unnecessary-await -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-c-async-frame.h"
+int leaf(int value) __objc3_async { return value; }
+int sync(void) { return 0; }
+int identity(void) __objc3_async {
+  return __objc3_await sync(); // expected-warning {{native await operand does not suspend}}
+}
+int parent(int value) __objc3_async { return __objc3_await leaf(value); }
+void outside(void) {
+  __objc3_await leaf(1); // expected-error {{native await requires an async Objective-C or Objective-C++20/23 function context}}
+}
+int vla(int count) __objc3_async {
+  int values[count];
+  return __objc3_await leaf(values[0]);
+}
+int dynamic(int count) __objc3_async {
+  void *p = __builtin_alloca(count);
+  return __objc3_await leaf(p != 0);
+}
+int invalid_defer(void) __objc3_async {
+  __objc3_defer { __objc3_await leaf(1); } // expected-error {{cannot suspend from a defer statement}}
+  return 0;
+}
+
+int nested_unhandled(void) __objc3_async {
+  return __objc3_await (leaf(1), sync()); // expected-error {{native C await requires a direct async call or a provably non-suspending operand}}
+}
+int harmless_defer(void) __objc3_async {
+  __objc3_defer { (void)__objc3_await sync(); } // expected-warning {{native await operand does not suspend}}
+  return 0;
+}
diff --git a/clang/test/ObjC3/Sema/resource-capture-flow.m b/clang/test/ObjC3/Sema/resource-capture-flow.m
new file mode 100644
index 000000000..0f51c2b90
--- /dev/null
+++ b/clang/test/ObjC3/Sema/resource-capture-flow.m
@@ -0,0 +1,34 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fsyntax-only -verify %s
+void close_handle(int) __attribute__((nothrow));
+void observe_handle(int) __attribute__((nothrow));
+typedef int Handle __attribute__((objc_requires_cleanup(close_handle), objc_resource_family(Handles), objc_invalid(-1)));
+typedef void (^Work)(void);
+void source_consumed_at_creation(void) {
+  @resource(close_handle, invalid: -1) Handle handle = 3;
+  Work work = ^[move handle] { observe_handle(handle); };
+  observe_handle(handle); // expected-error {{may have been moved or discarded}}
+  work();
+}
+void source_can_be_reinitialized(void) {
+  @resource(close_handle, invalid: -1) Handle handle = 3;
+  Work work = ^[move handle] { observe_handle(handle); };
+  reset(handle, 4);
+  observe_handle(handle);
+  work();
+}
+void capture_cannot_manually_double_close(void) {
+  @resource(close_handle, invalid: -1) Handle handle = 3;
+  Work work = ^[move handle] {
+    close_handle(handle); // expected-error {{manual close of registered resource}}
+  };
+  work();
+}
+#if __has_feature(objc_arc)
+Work escape_owned_capture(void) {
+  @resource(close_handle, invalid: -1) Handle handle = 3;
+  return ^[move handle] { observe_handle(handle); };
+}
+
+#endif
