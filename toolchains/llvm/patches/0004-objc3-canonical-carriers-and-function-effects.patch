+  void reset(void) { firstCalls = secondCalls = filters = badOrder = 0; expectedFirst = 2; }
+  int main(void) {
+    Maybe some = __objc3_some(int, 2);
+    Maybe another = __objc3_some(int, 3);
+    Maybe zero = __objc3_some(int, 0);
