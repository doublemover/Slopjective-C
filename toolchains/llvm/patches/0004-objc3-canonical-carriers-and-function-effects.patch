+  TypeResult Parsed = getSema().ActOnObjC3ResultType(
+      TL.getKeywordLoc(), TL.getLParenLoc(),
+      getSema().CreateParsedType(Success->getType(), Success), TL.getCommaLoc(),
+      getSema().CreateParsedType(Error->getType(), Error), TL.getRParenLoc());
+  if (!Parsed.isUsable())
+    return QualType();
+  TypeSourceInfo *Info = nullptr;
+  QualType Result = getSema().GetTypeFromParser(Parsed.get(), &Info);
+  TLB.pushFullCopy(Info->getTypeLoc());
+  return Result;
+}
