diff --git a/clang/test/ObjC3/Parser/public-carriers.mm b/clang/test/ObjC3/Parser/public-carriers.mm
new file mode 100644
index 000000000..e9dd218f4
--- /dev/null
+++ b/clang/test/ObjC3/Parser/public-carriers.mm
@@ -0,0 +1,50 @@
+// RUN: %clang_cc1 -fsyntax-only -verify -x objective-c -std=c17 -fobjc-version=3 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// RUN: %clang_cc1 -fsyntax-only -verify -x objective-c++ -std=c++20 -fobjc-version=3 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// RUN: %clang_cc1 -fsyntax-only -verify -x objective-c++ -std=c++23 -fobjc-version=3 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 %s
+// expected-no-diagnostics
+typedef Optional(int) Maybe;
+typedef Result(int, long) Outcome;
+typedef Optional(Outcome) Nested;
+int public_value(int input) {
+  Optional(int) value = input ? Some(int, input) : None(int);
+  Outcome outcome = input ? Ok(int, long, input) : Err(int, long, 2L);
+#ifdef __cplusplus
+  Maybe copied = copyValue(value);
+  Maybe moved = moveValue(copied);
+#else
+  Maybe moved = value;
+#endif
+  match(moved) {
+    case .Some(let payload): { input += payload; }
+    case .None: { input = 0; }
+  }
+  return match(outcome) {
+    case .Ok(let success) => success;
+    case .Err(let error) => (int)error;
+  } + hasValue(value) + isOk(outcome);
+}
+struct Names { int Some; int Optional; int match; };
+int ordinary_names(int input) {
+  int tryValue = input;
+  int tryOptional = input + 1;
+  int tryForce = input + 2;
+  return tryValue + tryOptional + tryForce;
+}
+#ifdef __cplusplus
+namespace Native {
+template<class T> struct Optional { T value; };
+int Some(int value);
+}
+int contextual(int input) {
+  Native::Optional<int> value = {input};
+  return Native::Some(value.value);
+}
+#endif
+
+int conditions(Maybe value, Outcome result) {
+  if (hasValue(value)) {
+    if ((isOk(result))) return 1;
+  }
+  while (hasValue(value)) { value = None(int); }
+  return !(hasValue(value)) && !(isOk(result));
+}
diff --git a/clang/test/ObjC3/Parser/public-errors.mm b/clang/test/ObjC3/Parser/public-errors.mm
