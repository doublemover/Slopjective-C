+typedef __objc3_optional(int) ModuleOptional;
+typedef __objc3_result(int, long long) ModuleResult;
+extern void module_record(int);
+
+static inline int module_present_zero(void) {
+  __objc3_defer { module_record(3); }
+  ModuleOptional source = __objc3_some(int, 0);
+  ModuleOptional copy = __objc3_none(int);
+  copy = source;
+  return __objc3_has_value(copy);
+}
+
+static inline int module_zero_error(void) {
+  ModuleResult error = __objc3_err(int, long long, 0);
+  return !__objc3_is_ok(error);
+}
+
+static inline int module_void_once(void) {
+  return __objc3_is_ok(__objc3_ok(void, int, module_record(4)));
+}
