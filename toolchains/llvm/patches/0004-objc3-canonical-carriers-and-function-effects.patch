+        template<class A,class B> struct Pair{A first;B second;};
+        inline auto aggregate(){struct A{int value;};struct B{int value;};return Pair<A,B>{{40},{2}};}
+        inline auto embedded(){static struct Local{int value;} storage;return &storage;}
+        inline auto pointer(){struct Local{int value;};static Local value{42};return &value;}
+        inline auto *written_pointer(){struct Local{int value;};static Local value{42};return &value;}
+        inline const auto *const_pointer(){struct Local{int value;};static Local value{42};return &value;}
+        inline auto &reference(){struct Local{int value;};static Local value{42};return value;}
+        inline decltype(auto) exact_reference(){struct Local{int value;};static Local value{42};return (value);}
+        inline auto callback(){struct Local{int value;};return Pair{+[](Local value){return value.value;},Local{42}};}
+      }
+    )FACTORY";
+    auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"factory-graphs.mm");
+    ASSERT_TRUE(From);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
