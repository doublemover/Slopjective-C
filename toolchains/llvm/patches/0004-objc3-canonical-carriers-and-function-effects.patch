+  }
+  Value ownerIdentity(const Expr *E, const Facts &State) const {
+    Value Result(OwnerRoots.size());
+    if (!E)
+      return Result;
+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return ownerIdentity(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return ownerIdentity(Opaque->getSourceExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      Result = ownerIdentity(Conditional->getTrueExpr(), State);
+      Result |= ownerIdentity(Conditional->getFalseExpr(), State);
+      return Result;
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp())
+        return ownerIdentity(Binary->getRHS(), State);
