@@ -0,0 +1,112 @@
+//===--- ObjC3CarrierMangleTest.cpp - ObjC3 carrier mangling tests --------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Mangle.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <algorithm>
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+
+constexpr char Source[] = R"cpp(
+  using OptionalIntAlias = __objc3_optional(int);
+  void optional(__objc3_optional(int) *);
+  void optional(__objc3_optional(long) *);
+  void optional(__objc3_optional(const int) *);
+  void result(__objc3_result(int, long) *);
+  void result(__objc3_result(long, int) *);
+  void result(__objc3_result(const int, long) *);
+  void result(__objc3_result(int, const long) *);
+  void alias_same(OptionalIntAlias *);
+  void alias_same(__objc3_optional(int) *);
+)cpp";
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Triple) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source,
+      {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3", "-target",
+       Triple.str()},
+      "objc3-carrier-mangling.cpp");
+}
+
+std::vector<FunctionDecl *> lookupFunctions(ASTContext &Context,
+                                            llvm::StringRef Name) {
+  std::vector<FunctionDecl *> Functions;
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  for (NamedDecl *ND : Decls) {
+    auto *FD = dyn_cast<FunctionDecl>(ND);
+    if (!FD)
+      continue;
+    for (FunctionDecl *Redecl : FD->redecls())
+      if (std::find(Functions.begin(), Functions.end(), Redecl) ==
+          Functions.end())
+        Functions.push_back(Redecl);
+  }
+  return Functions;
+}
+
+std::string mangle(ASTContext &Context, FunctionDecl *FD) {
+  std::unique_ptr<MangleContext> Mangler(Context.createMangleContext());
+  std::string Name;
+  llvm::raw_string_ostream OS(Name);
+  Mangler->mangleName(GlobalDecl(FD), OS);
+  OS.flush();
+  return Name;
+}
+
+void checkCarrierMangling(llvm::StringRef Triple) {
+  auto AST = parse(Triple);
+  ASSERT_TRUE(AST) << Triple;
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred()) << Triple;
+  ASTContext &Context = AST->getASTContext();
+
+  auto OptionalOverloads = lookupFunctions(Context, "optional");
+  ASSERT_EQ(OptionalOverloads.size(), 3u);
+  std::vector<std::string> OptionalNames;
+  for (FunctionDecl *FD : OptionalOverloads)
+    OptionalNames.push_back(mangle(Context, FD));
+  EXPECT_EQ(std::set<std::string>(OptionalNames.begin(), OptionalNames.end())
+                .size(),
+            OptionalNames.size());
+
+  auto ResultOverloads = lookupFunctions(Context, "result");
+  ASSERT_EQ(ResultOverloads.size(), 4u);
+  std::vector<std::string> ResultNames;
+  for (FunctionDecl *FD : ResultOverloads)
+    ResultNames.push_back(mangle(Context, FD));
+  EXPECT_EQ(std::set<std::string>(ResultNames.begin(), ResultNames.end())
+                .size(),
+            ResultNames.size());
+
+  auto AliasRedeclarations = lookupFunctions(Context, "alias_same");
+  ASSERT_EQ(AliasRedeclarations.size(), 2u);
+  EXPECT_EQ(mangle(Context, AliasRedeclarations[0]),
+            mangle(Context, AliasRedeclarations[1]));
+}
+
+TEST(ObjC3CarrierMangle, ItaniumPayloadsAndAliases) {
+  checkCarrierMangling("x86_64-unknown-linux-gnu");
+}
+
+TEST(ObjC3CarrierMangle, MicrosoftPayloadsAndAliases) {
+  checkCarrierMangling("x86_64-pc-windows-msvc");
+}
+
+} // namespace
diff --git a/clang/unittests/AST/ObjC3CarrierTypeTest.cpp b/clang/unittests/AST/ObjC3CarrierTypeTest.cpp
