+def ObjCResourceTypeDocs : Documentation {
+  let Category = DocCatType;
+  let Content = [{
+Objective-C 3.0 typedefs may declare ``objc_requires_cleanup(F)``,
+``objc_resource_family(Name)`` and ``objc_invalid(X)``. The corresponding prefix
+spellings are ``@requires_cleanup(F)``, ``@resource_family(Name)`` and
+``@invalid(X)``. Contracts follow typedef/using alias sugar; they do not change
+the scalar ABI or create distinct nominal C types.
+
+The cleanup must be a synchronous, nondependent, named single-parameter function
+applicable to the scalar handle or its address. Sentinels are converted to the
+handle type and must be constant. Contradictory alias annotations are rejected.
+In strict-system mode, automatic handle values must be closed, transferred by a
+compatible typed return, or protected by resource/cleanup/defer actions on every
+exit. Family associations reject wrong cleanup functions, repeated cleanup and
+unproven reuse after consumption. Resource field annotations remain outside v1.
+  }];
+}
+
+def ObjCCleanupDocs : Documentation {
+  let Category = DocCatVariable;
+  let Content = [{
+In Objective-C 3.0, ``cleanup(F)`` and the prefix ``@cleanup(F)`` register a
+native scope-exit call after an automatic variable's successful initialization.
+The callback receives the final value, a directly bound reference, or the
+variable's address according to ordinary parameter initialization. An exact
+address parameter takes precedence; otherwise value/reference passing wins
+when both are applicable. Cleanup runs unconditionally, including zero values,
+and does not invalidate the variable. It shares LIFO action order with
+``defer`` and resource cleanup, before deferred managed source-scope releases.
+
+The callback must name a nondependent, synchronous function with one parameter
+and an ordinary scalar or void result. Scalar values, direct references, and
+addresses of complete fixed-size objects are supported. Retainable results,
+argument temporaries and ARC writeback are rejected. Record copying, dependent or variable
+size storage, checked-error callbacks, asynchronous callbacks, and competing
+cleanup owners are diagnosed. Native exception unwinding uses ordinary Clang
+cleanup machinery; profile conformance is not implied by this attribute.
+The native AST stores the checked call in ``ObjCCleanupAttr``; emitted headers
+use the canonical ``cleanup(F)`` spelling.
+  }];
+}
+
+def ObjCResourceDocs : Documentation {
+  let Category = DocCatVariable;
+  let Content = [{
+``objc_resource(close=F, invalid=X)`` gives an automatic scalar handle an
+explicit scope-exit action in Objective-C 3.0. After successful initialization,
+normal exits and native exception unwinding call ``F`` if the current handle
+differs from ``X``, then store ``X`` into the handle. An invalid handle is not
+closed. These actions share native LIFO ordering with ``cleanup`` and ``defer``;
+implicit ARC releases in the same source scope follow the actions.
+
+The initial native implementation supports mutable integer, enumeration and
+ordinary pointer handles with an explicit initializer and a constant sentinel.
+``F`` must name a nondependent function with one scalar parameter and a scalar
+or void result. The parameter must accept the handle value or its address;
+an exact parameter match takes precedence, then value passing when both apply.
+Native C++ and Objective-C
+exceptions are supported. Checked-error and asynchronous close functions,
+dependent handle types, resource fields, and resource movement operations are
+diagnosed or remain outside this attribute's support boundary. This attribute
+does not by itself claim strict-system ownership-flow checking.
+  }];
+}
+
 def CleanupDocs : Documentation {
   let Category = DocCatVariable;
   let Content = [{
@@ -10485,3 +10551,76 @@ The attribute is also supported with blocks and in Objective-C.
   }
   }];
 }
+
+
+def ObjCReturnsBorrowedDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``objc_returns_borrowed(owner_index=N)`` associates a ``borrowed T *`` return
+value with the zero-based formal owner parameter N. The contract is preserved
+in PCH and modules and participates in Objective-C 3.0 declaration identity.
+Strict-system semantic analysis checks that the pointer does not escape its
+owner, including through ordinary pointer and integer aliases.
+  }];
+}
+
+def ObjC3ExecutorDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``objc_executor(main)``, ``objc_executor(global)`` and
+``objc_executor(named("identity"))`` describe callable executor affinity.
+Objective-C types provide the default affinity for their members. Executor
+identity is preserved by AST serialization and import. A call from a context
+whose executor cannot be proven equal requires an explicit await and a
+supported executor-hop lowering; the compiler diagnoses unavailable lowering.
+  }];
+}
+def ObjC3NonisolatedDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``objc_nonisolated`` removes the default actor isolation of an actor instance
+method or property. It cannot remove an explicit executor requirement. Its
+parameters, result, and checked error must be Sendable at checked boundaries.
+Access to the actor's isolated state still requires an actor entry.
+  }];
+}
+def ObjC3UnsafeSendableDocs : Documentation {
+  let Category = DocCatType;
+  let Content = [{
+``objc_unsafe_sendable`` explicitly promises that a type may cross concurrency
+boundaries. Every acceptance relying on this promise emits a transfer-site
+note. The promise does not waive borrowed lifetime or cleanup correctness.
+  }];
+}
+def ObjC3ActorNonreentrantDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``objc_actor_nonreentrant`` is reserved. Explicit actor nonreentrancy is deferred
+in Objective-C 3 v1 and use is diagnosed as an error.
+  }];
+}
+def ObjC3TaskBoundaryDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``objc_task_spawn``, ``objc_task_detached`` and ``objc_task_group`` identify
+standard-library concurrency APIs. Child and detached boundaries check async
+work-item captures and explicit values for Sendable transfer. These attributes
+preserve classification in interfaces; they do not implement task creation or
+change a library function's calling convention.
+  }];
+}
+
+def ObjCRetainableFamilyDocs : Documentation {
+  let Category = DocCatDecl;
+  let Content = [{
+Objective-C 3.0 identifies retainable pointer typedefs with
+``objc_retainable_family(Name)`` and their unary operations with
+``objc_family_retain(Name)``, ``objc_family_release(Name)`` and
+``objc_family_autorelease(Name)``. The parameter must name the declared family;
+retain/autorelease return the same family type and release returns void.
+Aliases cannot change their family and redeclarations cannot change operations.
+ObjC-integrated families additionally use ``NSObject``; ARC prohibits direct
+manual family operations on these types. These contracts preserve the native
+pointer ABI and are serialized in PCH and reusable declarations.
+  }];
+}
