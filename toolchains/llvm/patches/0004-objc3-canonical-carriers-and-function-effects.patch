+};
+using InaccessibleNative = __objc3_optional(Inaccessible);
+void rejected_inactive_destructor() {
+  __objc3_result(Managed, InaccessibleNative) value =
+      __objc3_ok(Managed, InaccessibleNative, __objc3_none(id)); // expected-error@-1 {{variable of type 'Inaccessible' has private destructor}}
