+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s
+// expected-no-diagnostics
+
+template <class T> bool accepts(T value) { return value != 0; }
+
+template <class T> int dependent_guard(T source) {
+  guard let first = source, second = source, accepts(first),
+        var third = source, fourth = source else { return 0; }
+  third += first;
+  fourth += second;
+  if let local = source, next = source {
+    return local + next + third + fourth;
+  } else {
+    return first + second;
+  }
+}
+
+template <class T> int dependent_if(T source) {
+  if var first = source, second = source {
+    first += second;
+    auto capture = [first] { return first; };
+    return capture();
+  }
+  return 0;
+}
+
+template <class T> int binding_used_in_later_lambda(T source) {
+  guard let first = source,
+        second = Some(int, [&] { return first; }()) else { return 0; }
+  return second;
+}
+
+template <class T> struct Holder {
+  int run(T source) {
+    guard let first = source else { return 0; }
+    if var second = source, third = source {
+      second += first + third;
+      return second;
+    }
+    return first;
+  }
+};
+
+template int dependent_guard<Optional(int)>(Optional(int));
+template int dependent_if<Optional(int)>(Optional(int));
+template int binding_used_in_later_lambda<Optional(int)>(Optional(int));
+template struct Holder<Optional(int)>;
+
