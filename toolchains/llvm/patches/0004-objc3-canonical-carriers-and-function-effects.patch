+bool Parser::isObjC3OptionalSendIndicatorAhead(Expr *Receiver) {
+  if (!getLangOpts().ObjC3 || !ObjC3ParsingMessageReceiver ||
+      !Tok.is(tok::question) || ParenCount != ObjC3ReceiverParenDepth ||
+      BracketCount != ObjC3ReceiverBracketDepth ||
+      BraceCount != ObjC3ReceiverBraceDepth || !Receiver)
+    return false;
+  // A scalar condition belongs to the inherited conditional receiver syntax.
+  // Parentheses, subscripts, nested sends and lambda bodies likewise keep
+  // their ordinary '?' grammar through the delimiter-depth checks above.
+  if (NextToken().is(tok::r_square))
+    return true; // Diagnose a missing selector in the message-body parser.
+  if (NextToken().isAnnotation() ||
+      (!NextToken().getIdentifierInfo() && NextToken().isNot(tok::colon)))
+    return false;
+  unsigned Start = NextToken().is(tok::colon) ? 2 : 3;
+  if (GetLookAheadToken(2).is(tok::r_square))
+    return true;
+  if (!Receiver->isTypeDependent() &&
+      !Receiver->getType()->isObjCObjectPointerType())
+    return false;
+  if (!NextToken().is(tok::colon) && GetLookAheadToken(2).isNot(tok::colon))
+    return false;
+
+  // Preserve ordinary unparenthesized conditional receivers such as
+  // [object ? first : second description]. An optional keyword send permits
+  // only further keyword pieces after each argument, never a trailing unary
+  // selector. Delimiter balancing hides selector-like tokens in arguments.
+  SmallVector<tok::TokenKind, 8> Delimiters;
+  bool PreviousOperand = false;
+  for (unsigned I = Start;; ++I) {
+    const Token Look = GetLookAheadToken(I);
+    if (Look.isOneOf(tok::eof, tok::annot_repl_input_end) ||
+        (Look.is(tok::semi) && Delimiters.empty()))
+      return false;
+    if (Delimiters.empty()) {
+      if (Look.is(tok::r_square))
+        return true;
+      if (Look.is(tok::identifier) && PreviousOperand &&
+          GetLookAheadToken(I + 1).isNot(tok::colon))
+        return false;
+      PreviousOperand = Look.is(tok::identifier) || Look.isLiteral() ||
+                        Look.isOneOf(tok::kw_true, tok::kw_false, tok::kw_nullptr);
+    }
+    switch (Look.getKind()) {
+    case tok::l_paren: Delimiters.push_back(tok::r_paren); break;
+    case tok::l_square: Delimiters.push_back(tok::r_square); break;
+    case tok::l_brace: Delimiters.push_back(tok::r_brace); break;
+    case tok::r_paren:
+    case tok::r_square:
+    case tok::r_brace:
+      if (Delimiters.empty() || Delimiters.pop_back_val() != Look.getKind())
+        return false;
