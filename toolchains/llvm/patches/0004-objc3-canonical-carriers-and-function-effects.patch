+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+typedef struct Error { int value; } Error;
+typedef Error ErrorAlias;
+
+// The two spellings canonicalize to one typed-effect payload type while each
+// source declarator still forms its own non-canonical function type.
+void typed_error(void) __objc3_throws(Error);
+void typed_error_alias(void) __objc3_throws(ErrorAlias);
+
+typedef void ThrowsError(void) __objc3_throws(Error);
+typedef void ThrowsAlias(void) __objc3_throws(ErrorAlias);
+ThrowsError *typed_pointer;
+ThrowsAlias *typed_alias_pointer;
+
+// Re-declaring through a typedef alias remains compatible by canonical error
+// type identity; constructing either declaration must not collide with the
+// canonical FunctionProtoType's folding-set key.
+void redeclared(void) __objc3_throws(Error);
+void redeclared(void) __objc3_throws(ErrorAlias);
+
+// A qualified pointer payload is a separate canonical typed-error identity.
+void qualified_error(void) __objc3_throws(const Error *);
