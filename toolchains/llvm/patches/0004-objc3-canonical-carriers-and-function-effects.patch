diff --git a/clang/lib/Parse/ParseObjC3Match.cpp b/clang/lib/Parse/ParseObjC3Match.cpp
new file mode 100644
index 000000000..6a84c44ec
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3Match.cpp
@@ -0,0 +1,383 @@
+#include "clang/AST/ObjC3MatchSemantic.h"
+#include "clang/Basic/DiagnosticParse.h"
+#include "clang/Basic/ObjC3Syntax.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
