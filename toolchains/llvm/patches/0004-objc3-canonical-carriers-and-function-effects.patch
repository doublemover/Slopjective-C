diff --git a/clang/test/ObjC3/AST/carrier-property-match.mm b/clang/test/ObjC3/AST/carrier-property-match.mm
new file mode 100644
index 000000000..b6f0d18c7
--- /dev/null
+++ b/clang/test/ObjC3/AST/carrier-property-match.mm
@@ -0,0 +1,21 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -x objective-c++ -std=c++20 -fcxx-exceptions -emit-llvm -o %t.ll -verify %s
+// expected-no-diagnostics
+#include "Inputs/carrier-heap-pch.h"
+template<class T> int property_match(T box) {
+  int result = __objc3_match(box.value) {
+    case __objc3_case_some(let object) => object ? 1 : 0;
+    case __objc3_case_none => 0;
+  };
+  __objc3_match_stmt(box.weak) {
+    case __objc3_case_some(let object): { result += object ? 1 : 0; }
+    case __objc3_case_none: { }
+  }
+  return result;
+}
+int instantiate(HeapBox *box) { return property_match(box); }
+int concrete(HeapBox *box) {
+  return __objc3_match(box.value) {
+    case __objc3_case_some(let object) => 1;
+    case __objc3_case_none => 0;
+  };
+}
