+bool Parser::ParseObjC3MatchPattern(objc3::MatchPatternInfo &Pattern) {
+  Pattern.Location = Tok.getLocation();
+  auto IsWord = [&](StringRef Word) {
+    return Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+           Tok.getIdentifierInfo()->isStr(Word);
+  };
+  auto ParseName = [&](bool Mutable) -> bool {
+    if (!Tok.is(tok::identifier) || !Tok.getIdentifierInfo()) {
+      Diag(Tok, diag::err_expected) << tok::identifier;
+      return false;
+    }
+    Pattern.BindingName = Tok.getIdentifierInfo();
+    Pattern.BindingLocation = Tok.getLocation();
+    Pattern.MutableBinding = Mutable;
+    ConsumeAnyToken();
+    return true;
+  };
+
+  if (Tok.is(tok::kw_true) || Tok.is(tok::kw_false)) {
+    Pattern.Kind = Tok.is(tok::kw_true) ? objc3::MatchPatternKind::BooleanTrue
+                                        : objc3::MatchPatternKind::BooleanFalse;
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("_")) {
+    Pattern.Kind = objc3::MatchPatternKind::Wildcard;
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("let") || IsWord("var")) {
+    bool Mutable = IsWord("var");
+    Pattern.Kind = objc3::MatchPatternKind::Binding;
+    ConsumeAnyToken();
+    return ParseName(Mutable);
+  }
+  // Public Optional arms use the same dot-case convention as Result arms.
+  // Recognize these spellings only while parsing a match pattern.
+  bool PublicOptional = false;
+  if (Tok.is(tok::period) && NextToken().is(tok::identifier) &&
+      (NextToken().getIdentifierInfo()->isStr("Some") ||
+       NextToken().getIdentifierInfo()->isStr("None"))) {
+    ConsumeToken();
+    PublicOptional = true;
+  }
+  if ((IsWord("__objc3_case_none") || (PublicOptional && IsWord("None")))) {
+    Pattern.Kind = objc3::MatchPatternKind::OptionalNone;
+    ConsumeAnyToken();
+    return true;
+  }
+  if ((IsWord("__objc3_case_some") || (PublicOptional && IsWord("Some")))) {
+    Pattern.Kind = objc3::MatchPatternKind::OptionalSome;
+    ConsumeAnyToken();
+    if (Tok.isNot(tok::l_paren)) {
+      Diag(Tok, diag::err_objc3_match_binding_required);
+      return false;
+    }
+    ConsumeAnyToken();
+    if (IsWord("move")) {
+      Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+      ConsumeAnyToken();
+      if (IsWord("let") || IsWord("var"))
+        ConsumeAnyToken();
+      if (!ParseName(/*Mutable=*/false))
+        return false;
+      if (Tok.isNot(tok::r_paren)) {
+        Diag(Tok, diag::err_expected) << tok::r_paren;
+        return false;
+      }
+      ConsumeAnyToken();
+      return true;
+    }
+    if (IsWord("_")) {
+      ConsumeAnyToken();
+      if (Tok.isNot(tok::r_paren)) {
+        Diag(Tok, diag::err_expected) << tok::r_paren;
+        return false;
+      }
+      ConsumeAnyToken();
+      return true;
+    }
+    if (!IsWord("let") && !IsWord("var")) {
+      Diag(Tok, diag::err_objc3_match_binding_required);
+      return false;
+    }
+    bool Mutable = IsWord("var");
+    ConsumeAnyToken();
+    if (!ParseName(Mutable))
+      return false;
+    if (Tok.isNot(tok::r_paren)) {
+      Diag(Tok, diag::err_expected) << tok::r_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("move")) {
+    Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+    ConsumeAnyToken();
+    if (IsWord("let") || IsWord("var"))
+      ConsumeAnyToken();
+    return ParseName(/*Mutable=*/false);
+  }
+  if (IsWord("is")) {
+    Pattern.Kind = objc3::MatchPatternKind::TypeTest;
+    ConsumeAnyToken();
+    TypeResult Refined = ParseTypeName();
+    return !Refined.isInvalid();
+  }
+  if (Tok.is(tok::period)) {
+    ConsumeAnyToken();
+    if (!Tok.is(tok::identifier) || !Tok.getIdentifierInfo()) {
+      Diag(Tok, diag::err_expected) << tok::identifier;
+      return false;
+    }
+    IdentifierInfo *CaseName = Tok.getIdentifierInfo();
+    bool IsOK = CaseName->isStr("Ok");
+    bool IsErr = CaseName->isStr("Err");
+    if (!IsOK && !IsErr) {
+      Diag(Tok, diag::err_objc3_match_invalid_pattern);
+      return false;
+    }
+    Pattern.Kind = IsOK ? objc3::MatchPatternKind::ResultOK
+                        : objc3::MatchPatternKind::ResultErr;
+    ConsumeAnyToken();
+    if (Tok.isNot(tok::l_paren)) {
+      Diag(Tok, diag::err_expected) << tok::l_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    if (IsWord("_")) {
+      ConsumeAnyToken();
+    } else if (IsWord("move")) {
+      Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+      ConsumeAnyToken();
+      ParseName(/*Mutable=*/false);
+    } else {
+      if (!IsWord("let") && !IsWord("var")) {
+        Diag(Tok, diag::err_objc3_match_binding_required);
+        return false;
+      }
+      bool Mutable = IsWord("var");
+      ConsumeAnyToken();
+      if (!ParseName(Mutable))
+        return false;
+    }
+    if (Tok.isNot(tok::r_paren)) {
+      Diag(Tok, diag::err_expected) << tok::r_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    return true;
+  }
+
+  if (Tok.is(tok::numeric_constant) ||
+      ((Tok.is(tok::minus) || Tok.is(tok::plus)) &&
+       NextToken().is(tok::numeric_constant)))
+    Pattern.Kind = objc3::MatchPatternKind::IntegerLiteral;
+  else if (Tok.is(tok::char_constant))
+    Pattern.Kind = objc3::MatchPatternKind::CharacterLiteral;
+  else if (Tok.is(tok::kw_nullptr) || Tok.is(tok::kw___null) ||
+           Tok.is(tok::l_paren))
+    Pattern.Kind = objc3::MatchPatternKind::NilLiteral;
+  else if (Tok.is(tok::at) || Tok.is(tok::string_literal))
+    Pattern.Kind = objc3::MatchPatternKind::StringLiteral;
+  else {
+    Diag(Tok, diag::err_objc3_match_invalid_pattern);
+    return false;
+  }
+  // A match head ends at `=>`; its '=' must not start an assignment.
+  ExprResult Value = ParseConditionalExpression();
+  if (Value.isInvalid())
+    return false;
+  Pattern.PatternValue = Value.get();
+  return true;
+}
