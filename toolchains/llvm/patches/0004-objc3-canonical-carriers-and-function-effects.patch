+TEST(ObjC3ResourceTooling,
+     DistinguishesContractsDuringStructuralMatchingAndImport) {
+  const std::string Prefix =
+      "void close_handle(int) __attribute__((nothrow));\n";
+  const std::string Source =
+      Prefix + "@requires_cleanup(close_handle) @resource_family(Handles) "
+               "@invalid(-1) typedef int Handle;";
+  const std::string Equivalent =
+      Prefix + "@requires_cleanup(close_handle) @resource_family(Handles) "
+               "@invalid(~0) typedef int Handle;";
+  const std::string Different =
+      Prefix + "@requires_cleanup(close_handle) @resource_family(OtherHandles) "
+               "@invalid(-1) typedef int Handle;";
+  auto From = tooling::buildASTFromCodeWithArgs(Source, conditionArgs(),
+                                                "contract-source.mm");
+  auto Same = tooling::buildASTFromCodeWithArgs(Equivalent, conditionArgs(),
+                                                "contract-same.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      Different, conditionArgs(), "contract-different.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(),
+      {{"contract-source.mm", Source}});
+  ASSERT_TRUE(From && Same && To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  ASSERT_FALSE(Same->getDiagnostics().hasErrorOccurred());
+  ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  auto Find = [](ASTUnit &AST) -> TypedefNameDecl * {
+    for (Decl *D : AST.getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *Alias = dyn_cast<TypedefNameDecl>(D))
+        if (Alias->getName() == "Handle")
+          return Alias;
+    return nullptr;
+  };
+  ASSERT_TRUE(Find(*From) && Find(*Same) && Find(*To));
+  StructuralEquivalenceContext::NonEquivalentDeclSet SameSet, DifferentSet;
+  StructuralEquivalenceContext SameContext(
+      From->getASTContext().getLangOpts(), From->getASTContext(),
+      Same->getASTContext(), SameSet, StructuralEquivalenceKind::Default, false,
+      false);
+  EXPECT_TRUE(SameContext.IsEquivalent(Find(*From), Find(*Same)));
+  StructuralEquivalenceContext DifferentContext(
+      From->getASTContext().getLangOpts(), From->getASTContext(),
+      To->getASTContext(), DifferentSet, StructuralEquivalenceKind::Default,
+      false, false);
+  EXPECT_FALSE(DifferentContext.IsEquivalent(Find(*From), Find(*To)));
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  Importer.setODRHandling(ASTImporter::ODRHandlingType::Conservative);
+  auto Imported = Importer.Import(Find(*From));
+  EXPECT_FALSE(static_cast<bool>(Imported));
+  if (!Imported)
+    llvm::consumeError(Imported.takeError());
+}
