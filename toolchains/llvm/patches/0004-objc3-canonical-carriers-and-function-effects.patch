+    ASSERT_NE(Function, nullptr);
+    ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                         From->getASTContext(), From->getFileManager(), false);
+    auto Imported = Importer.Import(Function);
+    ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+    struct Requirements : RecursiveASTVisitor<Requirements> {
+      std::vector<RequiresExpr *> Expressions;
+      bool VisitRequiresExpr(RequiresExpr *Expression) {
+        Expressions.push_back(Expression);
+        return true;
+      }
+    } Visitor;
+    Visitor.TraverseDecl(Function);
+    ASSERT_GE(Visitor.Expressions.size(), 2u);
+    for (auto *Expression : Visitor.Expressions) {
+      auto *Body = Expression->getBody();
+      auto *Mapped = dyn_cast_or_null<RequiresExprBodyDecl>(
+          Importer.GetAlreadyImportedOrNull(Body));
+      ASSERT_NE(Mapped, nullptr);
+      auto *Owner = Importer.GetAlreadyImportedOrNull(
+          Decl::castFromDeclContext(Body->getDeclContext()));
+      ASSERT_NE(Owner, nullptr);
+      EXPECT_EQ(Mapped->getDeclContext(), Decl::castToDeclContext(Owner));
+      EXPECT_EQ(&Mapped->getASTContext(), &To->getASTContext());
+      for (auto *Parameter : Expression->getLocalParameters()) {
+        auto *ImportedParameter = dyn_cast_or_null<ParmVarDecl>(
+            Importer.GetAlreadyImportedOrNull(Parameter));
+        ASSERT_NE(ImportedParameter, nullptr);
+        EXPECT_EQ(ImportedParameter->getDeclContext(), Mapped);
+        EXPECT_EQ(ImportedParameter->getLexicalDeclContext(), Mapped);
+        EXPECT_TRUE(Mapped->containsDecl(ImportedParameter));
+      }
+      if (auto *Function = dyn_cast<FunctionDecl>(Owner)) {
+        auto Proto = Function->getTypeSourceInfo()->getTypeLoc()
+                         .getAsAdjusted<FunctionProtoTypeLoc>();
+        ASSERT_TRUE(Proto);
+        for (unsigned Index = 0; Index < Function->getNumParams(); ++Index)
+          EXPECT_EQ(Proto.getParam(Index), Function->getParamDecl(Index));
+      }
+    }
+  }
