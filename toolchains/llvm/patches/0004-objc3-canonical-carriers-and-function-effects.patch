+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fsyntax-only -verify %s
+
+struct Error {};
+int typed_call() __objc3_throws(Error);
+
+void outer_handler_does_not_handle_separate_callables() {
+  __objc3_do {
+    auto lambda = [] {
+      __objc3_try(typed_call()); // expected-error {{propagating ObjC3 try requires a matching throwing function}}
+      __objc3_throw(Error{}); // expected-error {{ObjC3 throw requires a throwing function}}
+    };
+    auto block = ^{
+      __objc3_try(typed_call()); // expected-error {{propagating ObjC3 try requires a matching throwing function}}
+      __objc3_throw(Error{}); // expected-error {{ObjC3 throw requires a throwing function}}
+    };
+    (void)lambda;
+    (void)block;
+    __objc3_try(typed_call());
+  } __objc3_catch(Error error) { (void)error; }
+}
+
+void outer_effect_does_not_authorize_separate_callables()
+    __objc3_throws(Error) {
+  auto lambda = [] {
+    __objc3_try(typed_call()); // expected-error {{propagating ObjC3 try requires a matching throwing function}}
+    __objc3_throw(Error{}); // expected-error {{ObjC3 throw requires a throwing function}}
+  };
+  auto block = ^{
+    __objc3_try(typed_call()); // expected-error {{propagating ObjC3 try requires a matching throwing function}}
+    __objc3_throw(Error{}); // expected-error {{ObjC3 throw requires a throwing function}}
+  };
+  (void)lambda;
+  (void)block;
+}
+
+void inner_handlers_own_their_facts() {
+  __objc3_do {
+    auto lambda = [] {
+      __objc3_do { __objc3_try(typed_call()); }
+      __objc3_catch(Error error) { (void)error; }
+    };
+    auto block = ^{
+      __objc3_do { __objc3_throw(Error{}); }
+      __objc3_catch(Error error) { (void)error; }
+    };
+    lambda();
+    block();
+  } __objc3_catch { }
+}
