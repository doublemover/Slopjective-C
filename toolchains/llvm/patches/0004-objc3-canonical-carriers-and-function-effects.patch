+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/Type.h"
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Sema/Lookup.h"
+#include "clang/Sema/Template.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+bool Sema::CheckObjC3FunctionEffects(
+    const ObjC3FunctionEffectInfo &Effects, SourceLocation Loc) {
+  // Keep ObjC3 typed throws independent of both C++ exception specifications
+  // and Objective-C exceptions. This method checks representation invariants;
+  // call propagation and lowering are separate implementation contracts.
+  if (Effects.hasValidShape())
+    return true;
+
+  Diag(Loc, diag::err_objc3_invalid_function_effect_shape);
+  return false;
+}
+
+QualType Sema::BuildObjC3AsyncTaskType(const FunctionProtoType *Function,
+                                      SourceLocation Loc, bool Diagnose) {
+  if (!Function->getObjC3FunctionEffects().Async)
+    return Function->getReturnType();
+  auto Unsupported = [&]() -> QualType {
+    if (Diagnose)
+      Diag(Loc, diag::err_objc3_async_task_unsupported);
+    return {};
+  };
+  const auto &Triple = Context.getTargetInfo().getTriple();
+  if (!getLangOpts().ObjC3 || !getLangOpts().ObjC ||
+      !getLangOpts().CPlusPlus20 ||
+      !getLangOpts().Coroutines || getLangOpts().ObjC3Profile != 0 ||
+      getLangOpts().ObjCRuntime.getAsString() != "gnustep-2.2" ||
+      Context.getTargetInfo().getPointerWidth(LangAS::Default) != 64 ||
+      !Triple.isOSLinux() ||
+      Triple.getArch() != llvm::Triple::x86_64 || Function->isVariadic() ||
+      Function->getCallConv() != CC_C ||
+      Function->getReturnType()->isReferenceType() ||
+      Function->getReturnType().isVolatileQualified() ||
+      (Function->getReturnType()->isObjCRetainableType() &&
+       !Function->getReturnType()->isObjCObjectPointerType() &&
+       !Function->getReturnType()->isBlockPointerType()) ||
+      Function->getReturnType()->isUndeducedType())
+    return Unsupported();
+  QualType Result = Function->getReturnType();
+  if (Result->isDependentType())
+    return Context.DependentTy;
+  if (QualType Existing = Context.getObjC3AsyncTaskType(Result);
+      !Existing.isNull())
+    return Existing;
+  // The reserved alias is provided by the installed task runtime header. Keep
+  // logical return types in the canonical function type and its serialized
+  // effects; only evaluated calls and coroutine return objects use this type.
+  LookupResult Lookup(*this, &Context.Idents.get("__objc3_async_task"), Loc,
+                      LookupOrdinaryName);
+  Lookup.suppressDiagnostics();
+  LookupQualifiedName(Lookup, Context.getTranslationUnitDecl());
+  auto *Template = Lookup.getAsSingle<TypeAliasTemplateDecl>();
+  if (!Template) {
+    if (Diagnose)
+      Diag(Loc, diag::err_objc3_async_task_header);
+    return {};
+  }
+  TemplateArgumentListInfo Args(Loc, Loc);
+  Args.addArgument(TemplateArgumentLoc(
+      TemplateArgument(Result), Context.getTrivialTypeSourceInfo(Result, Loc)));
+  QualType Task = CheckTemplateIdType(ElaboratedTypeKeyword::None,
+                                      TemplateName(Template), Loc, Args,
+                                      /*Scope=*/nullptr,
+                                      /*ForNestedNameSpecifier=*/false);
+  if (Task.isNull() || RequireCompleteType(Loc, Task, diag::err_incomplete_type))
+    return {};
+  Context.setObjC3AsyncTaskType(Result, Task);
+  return Task;
+}
diff --git a/clang/lib/Sema/SemaObjC3ErrorContext.h b/clang/lib/Sema/SemaObjC3ErrorContext.h
new file mode 100644
index 000000000..c0f59a7b6
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3ErrorContext.h
@@ -0,0 +1,50 @@
+//===--- SemaObjC3ErrorContext.h - Native typed-error callable ownership ---===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#ifndef LLVM_CLANG_LIB_SEMA_SEMAOBJC3ERRORCONTEXT_H
+#define LLVM_CLANG_LIB_SEMA_SEMAOBJC3ERRORCONTEXT_H
+
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Type.h"
+#include "clang/Sema/Sema.h"
+
+namespace clang {
+
+/// Diagnose evaluated throwing calls which lack an explicit checked form.
+bool diagnoseObjC3UncheckedCalls(Sema &S, Stmt *Root);
+
+inline DeclContext *getCurrentObjC3CallableContext(Sema &S) {
+  DeclContext *DC = S.CurContext;
+  while (DC && isa<EnumDecl, RequiresExprBodyDecl>(DC))
+    DC = DC->getParent();
+  // Lambdas and Blocks own their effects. Do not use getCurFunctionDecl(),
+  // which deliberately skips those callable boundaries for native checks.
+  // A local record's member initializer likewise cannot inherit an outer
+  // function's effect merely because its lexical parent is that function.
+  if (DC && isa<FunctionDecl, BlockDecl, ObjCMethodDecl>(DC))
+    return DC;
+  return nullptr;
+}
+
+inline ObjC3FunctionEffectInfo getCurrentObjC3CallableEffects(Sema &S) {
+  DeclContext *DC = getCurrentObjC3CallableContext(S);
+  QualType Type;
+  if (auto *FD = dyn_cast_or_null<FunctionDecl>(DC))
+    Type = FD->getType();
+  else if (auto *BD = dyn_cast_or_null<BlockDecl>(DC)) {
+    if (TypeSourceInfo *Info = BD->getSignatureAsWritten())
+      Type = Info->getType();
+  }
+  else if (auto *MD = dyn_cast_or_null<ObjCMethodDecl>(DC))
+    Type = MD->getObjC3FunctionType();
+  if (!Type.isNull())
+    if (const auto *FPT = Type->getAs<FunctionProtoType>())
+      return FPT->getObjC3FunctionEffects();
+  return {};
+}
+
+} // namespace clang
+
+#endif
diff --git a/clang/lib/Sema/SemaObjC3Match.cpp b/clang/lib/Sema/SemaObjC3Match.cpp
new file mode 100644
index 000000000..669c0e0e5
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Match.cpp
@@ -0,0 +1,360 @@
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3MatchCoverage.h"
+#include "clang/AST/ObjC3MatchSemantic.h"
+#include "clang/AST/Stmt.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Initialization.h"
+#include "clang/Sema/Overload.h"
+#include "clang/Sema/Scope.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/APInt.h"
+#include "llvm/ADT/SmallVector.h"
+
+using namespace clang;
+
+namespace {
+void diagnosePatternIssue(Sema &S, SourceLocation Loc,
+                          objc3::MatchPatternIssue Issue, QualType Type) {
+  switch (Issue) {
+  case objc3::MatchPatternIssue::None: return;
+  case objc3::MatchPatternIssue::WrongScrutineeType:
+  case objc3::MatchPatternIssue::InvalidLiteralPattern:
+    S.Diag(Loc, diag::err_objc3_match_pattern_type) << Type;
+    return;
+  case objc3::MatchPatternIssue::UnsupportedTypeTest:
+    S.Diag(Loc, diag::err_objc3_match_type_test_disabled);
+    return;
+  case objc3::MatchPatternIssue::UnsupportedMove:
+    S.Diag(Loc, diag::err_objc3_match_move_unsupported);
+    return;
+  }
+}
+
+void diagnoseCoverageIssue(Sema &S, const objc3::MatchCoverageResult &Result,
+                           llvm::ArrayRef<ObjC3MatchArm *> Arms,
+                           bool ExpressionForm, SourceLocation MatchEnd) {
+  SourceLocation Loc = Result.Issue == objc3::MatchCoverageIssue::NonExhaustive
+                           ? MatchEnd
+                       : Result.ArmIndex < Arms.size()
+                           ? Arms[Result.ArmIndex]->getCaseLoc()
+                           : Arms.empty() ? SourceLocation()
+                                          : Arms.back()->getEndLoc();
+  switch (Result.Issue) {
+  case objc3::MatchCoverageIssue::None:
+  case objc3::MatchCoverageIssue::PatternTypeMismatch:
+  case objc3::MatchCoverageIssue::UnsupportedPattern:
+    return;
+  case objc3::MatchCoverageIssue::DuplicateCase:
+    S.Diag(Loc, diag::warn_objc3_match_duplicate);
+    return;
+  case objc3::MatchCoverageIssue::UnreachableCase:
+    S.Diag(Loc, diag::warn_objc3_match_unreachable);
+    return;
+  case objc3::MatchCoverageIssue::NonExhaustive:
+    S.Diag(Loc, diag::err_objc3_match_non_exhaustive)
+        << static_cast<unsigned>(Result.Domain) << ExpressionForm;
+    return;
+  }
+}
+
+// Native C++ payload copies must carry their use-site constructor resolution
+// into CodeGen. The transfer expression keeps that recipe in serialized AST.
+ExprResult prepareMatchSnapshot(Sema &S, Expr *Source) {
+  if (!S.getLangOpts().CPlusPlus || !Source->isGLValue() ||
+      Source->isTypeDependent())
+    return Source;
+  QualType Type = Source->getType().getCanonicalType();
+  if (!isa<ObjC3OptionalType, ObjC3ResultType>(Type.getTypePtr()))
+    return Source;
+  auto Info = S.Context.getObjC3CarrierRepresentationType(Type);
+  bool HasClassPayload = false;
+  for (FieldDecl *Field : {Info.ValueField, Info.SuccessField, Info.ErrorField})
+    if (Field)
+      if (const auto *Record = Field->getType()->getAs<RecordType>())
+        HasClassPayload |= isa<CXXRecordDecl>(Record->getDecl());
+  if (!HasClassPayload)
+    return Source;
+  return S.ActOnObjC3CarrierTransferExpr(false, Source->getExprLoc(),
+                                         Source->getBeginLoc(), Source,
+                                         Source->getEndLoc());
+}
+
+QualType joinMatchArmTypes(Sema &S, llvm::ArrayRef<ObjC3MatchArm *> Arms,
+                           SourceLocation MatchLoc) {
+  if (Arms.empty())
+    return QualType();
+  auto *First = dyn_cast_or_null<Expr>(Arms.front()->getBody());
+  if (!First || First->getType()->isVoidType()) {
+    S.Diag(Arms.front()->getCaseLoc(), diag::err_objc3_match_expression_arm_type);
+    return QualType();
+  }
+
+  QualType Common = First->getType();
+  for (unsigned I = 1; I != Arms.size(); ++I) {
+    auto *Next = dyn_cast_or_null<Expr>(Arms[I]->getBody());
+    if (!Next || Next->getType()->isVoidType()) {
+      S.Diag(Arms[I]->getCaseLoc(), diag::err_objc3_match_expression_arm_type);
+      return QualType();
+    }
+    if (Common->isDependentType() || Next->getType()->isDependentType()) {
+      if (!S.Context.hasSameType(Common, Next->getType())) {
+        S.Diag(Arms[I]->getCaseLoc(),
+               diag::err_objc3_match_expression_arm_type);
+        return QualType();
+      }
+      continue;
+    }
+
+    // Identical value types need no composite-pointer probing. In particular,
+    // builtin id has no separate C-pointer redefinition in a header-free TU.
+    // Drop top-level lvalue qualifiers because match always produces a value.
+    if (!Common->isArrayType() && !Common->isFunctionType() &&
+        S.Context.hasSameUnqualifiedType(Common, Next->getType())) {
+      Common = S.Context.getCommonSugaredType(Common.getUnqualifiedType(),
+                                              Next->getType().getUnqualifiedType());
+      continue;
+    }
+    OpaqueValueExpr Prior(MatchLoc, Common, VK_PRValue);
+    ExprResult LHS(&Prior), RHS(Next);
+    ExprResult Cond(IntegerLiteral::Create(
+        S.Context, llvm::APInt(S.Context.getIntWidth(S.Context.IntTy), 1), S.Context.IntTy,
+        Arms[I]->getCaseLoc()));
+    ExprValueKind VK = VK_PRValue;
+    ExprObjectKind OK = OK_Ordinary;
+    QualType Joined = S.getLangOpts().CPlusPlus
+                          ? S.CXXCheckConditionalOperands(Cond, LHS, RHS, VK,
+                                                          OK, MatchLoc)
+                          : S.CheckConditionalOperands(Cond, LHS, RHS, VK, OK,
+                                                       MatchLoc);
+    if (Joined.isNull()) {
+      // Native conditional-operand checking already explained the incompatible
+      // types. Do not follow it with a redundant match-specific error.
+      return QualType();
+    }
+    Common = Joined;
+  }
+
+  Common = S.Context.getCanonicalType(Common);
+  for (ObjC3MatchArm *Arm : Arms) {
+    auto *Body = cast<Expr>(Arm->getBody());
+    if (S.getLangOpts().CPlusPlus && Common->isRecordType()) {
+      // A match expression produces a value, even when every selected arm is
+      // an lvalue of the same class. Resolve its copy/move and access checks
+      // through ordinary C++ initialization instead of letting CodeGen copy
+      // a nontrivial object's representation.
+      ExprResult Initialized = S.PerformCopyInitialization(
+          InitializedEntity::InitializeTemporary(Common), MatchLoc, Body);
+      if (Initialized.isInvalid())
+        return QualType();
+      Arm->setBody(Initialized.get());
+      continue;
+    }
+    if (S.Context.hasSameType(Body->getType(), Common))
+      continue;
+    ImplicitConversionSequence ICS = S.TryImplicitConversion(
+        Body, Common, /*SuppressUserConversions=*/false,
+        Sema::AllowedExplicit::None, /*InOverloadResolution=*/false,
+        /*CStyle=*/false, /*AllowObjCWritebackConversion=*/false);
+    if (ICS.isBad()) {
+      S.Diag(Arm->getCaseLoc(), diag::err_objc3_match_expression_arm_type);
+      return QualType();
+    }
+    ExprResult Converted = S.PerformImplicitConversion(
+        Body, Common, ICS, AssignmentAction::Initializing);
+    if (Converted.isInvalid())
+      return QualType();
+    Arm->setBody(Converted.get());
+  }
+  return Common;
+}
+} // namespace
+
+objc3::MatchCaseState Sema::ActOnObjC3MatchBeginCase(
+    Scope *CaseScope, Expr *Scrutinee,
+    const objc3::MatchPatternInfo &Pattern, bool ExpressionForm) {
+  objc3::MatchCaseState State;
+  State.Pattern = Pattern;
+  State.ExpressionForm = ExpressionForm;
+  if (!Scrutinee || !CaseScope)
+    return State;
+
+  objc3::MatchPatternCheck Check = objc3::checkMatchPattern(
+      Context, Scrutinee->getType(), Pattern);
+  diagnosePatternIssue(*this, Pattern.Location, Check.Issue,
+                       Scrutinee->getType());
+  if (Check.Issue != objc3::MatchPatternIssue::None)
+    return State;
+
+  State.CanonicalPatternType = Check.CanonicalScrutineeType;
+  if (!Pattern.BindingName) {
+    State.IsValid = true;
+    return State;
+  }
+
+  QualType BoundType;
+  if (Pattern.Kind == objc3::MatchPatternKind::OptionalSome) {
+    BoundType = Check.BorrowedPayloadType;
+    State.BindingKind = objc3::MatchBindingKind::OptionalPayload;
+  } else if (Pattern.Kind == objc3::MatchPatternKind::ResultOK ||
+      Pattern.Kind == objc3::MatchPatternKind::ResultErr) {
+    BoundType = Check.BorrowedPayloadType;
+    State.BindingKind = Pattern.Kind == objc3::MatchPatternKind::ResultOK
+                            ? objc3::MatchBindingKind::SuccessPayload
+                            : objc3::MatchBindingKind::ErrorPayload;
+  } else {
+    BoundType = Scrutinee->getType();
+    State.BindingKind = objc3::MatchBindingKind::Scrutinee;
+  }
+  if (BoundType.isNull() || BoundType->isVoidType()) {
+    Diag(Pattern.BindingLocation, diag::err_objc3_match_void_binding);
+    return State;
+  }
+  QualType SourceType = BoundType;
+  if (Pattern.MutableBinding)
+    BoundType = BoundType.getUnqualifiedType();
+  // The binding names a snapshot, not the source's weak/unsafe storage. An
+  // ARC snapshot keeps the loaded object or copied Block alive for the arm.
+  if (getLangOpts().ObjCAutoRefCount && BoundType->isObjCRetainableType()) {
+    Qualifiers Quals = BoundType.getQualifiers();
+    Quals.setObjCLifetime(Qualifiers::OCL_Strong);
+    BoundType = Context.getQualifiedType(BoundType.getUnqualifiedType(), Quals);
+    // Scalar reference scrutinees already live in an owned strong snapshot.
+    // Carrier payloads retain their real field ownership for the source load.
+    if (State.BindingKind == objc3::MatchBindingKind::Scrutinee)
+      SourceType = BoundType;
+  }
+  State.BindingType = Pattern.MutableBinding
+                          ? BoundType
+                          : Context.getConstType(BoundType);
+  TypeSourceInfo *TInfo = Context.getTrivialTypeSourceInfo(
+      State.BindingType, Pattern.BindingLocation);
+  State.Binding = VarDecl::Create(Context, CurContext,
+      Pattern.BindingLocation, Pattern.BindingLocation, Pattern.BindingName,
+      State.BindingType, TInfo, SC_None);
+  if (Pattern.MutableBinding ||
+      (getLangOpts().ObjCAutoRefCount && BoundType->isObjCRetainableType())) {
+    // Keep native initialization and ownership in the AST. CodeGen binds this
+    // opaque lvalue to the selected snapshot/payload without evaluating the
+    // original scrutinee again. PCH and template replay retain real copy rules.
+    auto *Source = new (Context) OpaqueValueExpr(
+        Pattern.BindingLocation, Context.getConstType(SourceType), VK_LValue);
+    ExprResult Prepared = prepareMatchSnapshot(*this, Source);
+    if (Prepared.isInvalid())
+      return State;
+    ExprResult Initialized = PerformCopyInitialization(
+        InitializedEntity::InitializeVariable(State.Binding),
+        Pattern.BindingLocation, Prepared.get());
+    if (Initialized.isInvalid())
+      return State;
+    State.Binding->setInit(Initialized.get());
+  }
+  PushOnScopeChains(State.Binding, CaseScope);
+  State.BindingStatement = new (Context) DeclStmt(
+      DeclGroupRef(State.Binding), Pattern.BindingLocation,
+      Pattern.BindingLocation);
+  State.IsValid = true;
+  return State;
+}
+
+ObjC3MatchArm *Sema::ActOnObjC3MatchFinishCase(
+    const objc3::MatchCaseState &State, Expr *Guard, Stmt *Body,
+    SourceLocation CaseLoc, SourceLocation PatternLoc,
+    SourceLocation GuardLoc, SourceLocation DelimiterLoc) {
+  if (!State.IsValid || !Body)
+    return nullptr;
+  if (Guard) {
+    const bool GuardIsDependent = Guard->isTypeDependent();
+    if (!GuardIsDependent &&
+        !Context.getCanonicalType(Guard->getType())->isBooleanType()) {
+      Diag(Guard->getExprLoc(), diag::err_objc3_match_guard_type)
+          << Guard->getType();
+      return nullptr;
+    }
+    if (State.ExpressionForm && !GuardIsDependent &&
+        Guard->HasSideEffects(Context, true)) {
+      Diag(Guard->getExprLoc(), diag::err_objc3_match_expression_guard_effect);
+      return nullptr;
+    }
+  }
+  objc3::MatchPatternInfo Pattern = State.Pattern;
+  Pattern.HasGuard = Guard != nullptr;
+  return new (Context) ObjC3MatchArm(
+      Pattern.Kind, Pattern.PatternValue, State.BindingStatement, Guard, Body,
+      State.Binding, State.BindingKind, State.CanonicalPatternType,
+      Pattern.MutableBinding, State.ExpressionForm, CaseLoc, PatternLoc,
+      GuardLoc, DelimiterLoc);
+}
+
+StmtResult Sema::ActOnObjC3MatchStmt(
+    Expr *Scrutinee, llvm::ArrayRef<ObjC3MatchArm *> Arms,
+    SourceLocation KeywordLoc, SourceLocation LParenLoc,
+    SourceLocation RParenLoc, SourceLocation LBraceLoc,
+    SourceLocation RBraceLoc) {
+  if (!Scrutinee || Arms.empty())
+    return StmtError();
+  llvm::SmallVector<objc3::MatchCoverageArm, 8> CoverageArms;
+  for (ObjC3MatchArm *Arm : Arms)
+    CoverageArms.push_back({Arm->getPatternKind(), Arm->getCaseLoc(),
+        Arm->getGuard() != nullptr,
+        Arm->getCanonicalPatternType().getAsOpaquePtr()});
+  auto Coverage = objc3::analyzeMatchCoverage(Context, Scrutinee->getType(),
+                                               CoverageArms);
+  if (Coverage.Issue == objc3::MatchCoverageIssue::DuplicateCase ||
+      Coverage.Issue == objc3::MatchCoverageIssue::UnreachableCase ||
+      (Coverage.Domain != objc3::MatchDomain::Open &&
+       !Coverage.IsExhaustive))
+    diagnoseCoverageIssue(*this, Coverage, Arms, /*ExpressionForm=*/false,
+                          RBraceLoc);
+  ExprResult Snapshot = prepareMatchSnapshot(*this, Scrutinee);
+  if (Snapshot.isInvalid())
+    return StmtError();
+  return ObjC3MatchStmt::Create(Context, Snapshot.get(), Arms, KeywordLoc,
+      LParenLoc, RParenLoc, LBraceLoc, RBraceLoc);
+}
+
+ExprResult Sema::ActOnObjC3MatchExpr(
+    Expr *Scrutinee, llvm::ArrayRef<ObjC3MatchArm *> Arms,
+    SourceLocation KeywordLoc, SourceLocation LParenLoc,
+    SourceLocation RParenLoc, SourceLocation LBraceLoc,
+    SourceLocation RBraceLoc) {
+  if (!Scrutinee || Arms.empty())
+    return ExprError();
+  llvm::SmallVector<objc3::MatchCoverageArm, 8> CoverageArms;
+  for (ObjC3MatchArm *Arm : Arms)
+    CoverageArms.push_back({Arm->getPatternKind(), Arm->getCaseLoc(),
+        Arm->getGuard() != nullptr,
+        Arm->getCanonicalPatternType().getAsOpaquePtr()});
+  auto Coverage = objc3::analyzeMatchCoverage(Context, Scrutinee->getType(),
+                                               CoverageArms);
+  if (Coverage.Issue == objc3::MatchCoverageIssue::DuplicateCase ||
+      Coverage.Issue == objc3::MatchCoverageIssue::UnreachableCase)
+    diagnoseCoverageIssue(*this, Coverage, Arms, /*ExpressionForm=*/true,
+                          RBraceLoc);
+  if (!Context.getCanonicalType(Scrutinee->getType())->isDependentType() &&
+      !Coverage.IsExhaustive) {
+    diagnoseCoverageIssue(*this, Coverage, Arms, /*ExpressionForm=*/true,
+                          RBraceLoc);
+    return ExprError();
+  }
+  bool HasDependentArm = Scrutinee->isTypeDependent();
+  for (ObjC3MatchArm *Arm : Arms)
+    if (auto *Body = dyn_cast<Expr>(Arm->getBody()))
+      HasDependentArm |= Body->isTypeDependent();
+  QualType ResultType = HasDependentArm
+                            ? Context.DependentTy
+                            : joinMatchArmTypes(*this, Arms, KeywordLoc);
+  if (ResultType.isNull())
+    return ExprError();
+  // Object and Block results own a temporary through the enclosing full
+  // expression, even when none of their arms introduces another cleanup.
+  if (getLangOpts().ObjCAutoRefCount && ResultType->isObjCRetainableType())
+    Cleanup.setExprNeedsCleanups(true);
+  ExprResult Snapshot = prepareMatchSnapshot(*this, Scrutinee);
+  if (Snapshot.isInvalid())
+    return ExprError();
+  return ObjC3MatchExpr::Create(Context, ResultType, Snapshot.get(), Arms,
+      KeywordLoc, LParenLoc, RParenLoc, LBraceLoc, RBraceLoc);
+}
diff --git a/clang/lib/Sema/SemaObjC3ModuleLookup.cpp b/clang/lib/Sema/SemaObjC3ModuleLookup.cpp
new file mode 100644
index 000000000..2c37de629
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3ModuleLookup.cpp
@@ -0,0 +1,222 @@
+//===--- SemaObjC3ModuleLookup.cpp - ObjC3 qualified lookup --------------===//
+//
+// Staged Clang extension source; added after Sema.h's narrow action hooks are
+// merged. All declaration identity, overload resolution, access checking and
+// resulting QualTypes remain native Clang AST/Sema objects.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/Basic/Diagnostic.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Sema/ExternalSemaSource.h"
+#include "clang/Sema/Lookup.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/STLExtras.h"
+#include <string>
+#include <utility>
+
+using namespace clang;
+
+namespace {
+std::string getModuleSpelling(ArrayRef<IdentifierInfo *> Path,
+                              unsigned Components) {
+  std::string Result;
+  for (unsigned I = 0; I + 1 < Components; ++I) {
+    if (I)
+      Result.push_back('.');
+    Result += Path[I]->getName().str();
+  }
+  return Result;
+}
+
+std::string getQualifiedSpelling(ArrayRef<IdentifierInfo *> Path,
+                                 unsigned Components) {
+  std::string Result = "@";
+  for (unsigned I = 0; I < Components; ++I) {
+    if (I)
+      Result.push_back('.');
+    Result += Path[I]->getName().str();
+  }
+  return Result;
+}
+} // namespace
+
+bool Sema::IsObjC3QualifiedTypeName(
+    ArrayRef<IdentifierInfo *> Path) const {
+  if (!getLangOpts().ObjC3 || Path.size() < 2)
+    return false;
+  ExternalSemaSource *Source = getExternalSource();
+  if (!Source)
+    return false;
+  SmallVector<NamedDecl *, 8> Declarations;
+  auto Status = Source->LookupObjC3QualifiedName(
+      Path, Decl::IDNS_Ordinary | Decl::IDNS_Tag, Declarations);
+  if (Status == ObjC3QualifiedNameLookupStatus::ModuleNotVisible)
+    return true;
+  return (Status == ObjC3QualifiedNameLookupStatus::Found ||
+          Status == ObjC3QualifiedNameLookupStatus::Ambiguous) &&
+      llvm::any_of(Declarations,
+                   [](NamedDecl *D) { return isa<TypeDecl>(D); });
+}
+
+ExprResult Sema::ActOnObjC3QualifiedNameExpr(
+    SourceLocation AtLoc, ArrayRef<IdentifierInfo *> Path,
+    ArrayRef<SourceLocation> Locations, unsigned &ConsumedComponents) {
+  if (!getLangOpts().ObjC3 || Path.size() < 2 ||
+      Locations.size() != Path.size())
+    return ExprError();
+
+  ConsumedComponents = Path.size();
+  SmallVector<NamedDecl *, 8> Selected;
+  ObjC3QualifiedNameLookupStatus SelectedStatus =
+      ObjC3QualifiedNameLookupStatus::NotHandled;
+  unsigned SelectedLength = 0;
+  if (ExternalSemaSource *Source = getExternalSource()) {
+    // Prefer the longest visible registered module path that names an export.
+    // This leaves any later `.member` tokens to Clang's normal postfix parser.
+    for (unsigned Length = Path.size(); Length >= 2; --Length) {
+      SmallVector<NamedDecl *, 8> Candidate;
+      auto Status = Source->LookupObjC3QualifiedName(
+          Path.take_front(Length), Decl::IDNS_Ordinary, Candidate);
+      if (Status == ObjC3QualifiedNameLookupStatus::NotFound ||
+          Status == ObjC3QualifiedNameLookupStatus::NotHandled)
+        continue;
+      SelectedStatus = Status;
+      SelectedLength = Length;
+      Selected = std::move(Candidate);
+      break;
+    }
+  }
+  if (SelectedLength)
+    ConsumedComponents = SelectedLength;
+
+  const std::string Spelling = getQualifiedSpelling(Path, ConsumedComponents);
+  if (SelectedStatus == ObjC3QualifiedNameLookupStatus::ModuleNotVisible) {
+    const std::string Module = getModuleSpelling(Path, ConsumedComponents);
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified name '%0' refers to a module that is not imported");
+    auto Builder = Diag(AtLoc, ID) << Spelling;
+    if (!AtLoc.isMacroID()) {
+      SourceLocation Insert = SourceMgr.getLocForStartOfFile(SourceMgr.getFileID(AtLoc));
+      Builder << FixItHint::CreateInsertion(Insert,
+                                            "@import " + Module + ";\n");
+    }
+    return ExprError();
+  }
+  if (SelectedStatus == ObjC3QualifiedNameLookupStatus::Ambiguous) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified name '%0' is ambiguous");
+    Diag(AtLoc, ID) << Spelling;
+    return ExprError();
+  }
+  if (SelectedStatus != ObjC3QualifiedNameLookupStatus::Found ||
+      Selected.empty()) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified name '%0' does not name an exported declaration");
+    Diag(AtLoc, ID) << Spelling;
+    return ExprError();
+  }
+
+  DeclarationName Name(Path[SelectedLength - 1]);
+  LookupResult R(*this, Name, Locations[SelectedLength - 1],
+                 LookupOrdinaryName);
+  for (NamedDecl *Declaration : Selected)
+    R.addDecl(Declaration);
+  R.resolveKind();
+  CXXScopeSpec EmptyScope;
+  return BuildDeclarationNameExpr(EmptyScope, R, /*NeedsADL=*/false);
+}
+
+TypeResult Sema::ActOnObjC3QualifiedTypeName(
+    SourceLocation AtLoc, ArrayRef<IdentifierInfo *> Path,
+    ArrayRef<SourceLocation> Locations, unsigned &ConsumedComponents) {
+  if (!getLangOpts().ObjC3 || Path.size() < 2 ||
+      Locations.size() != Path.size())
+    return TypeError();
+
+  ConsumedComponents = Path.size();
+  SmallVector<NamedDecl *, 8> Declarations;
+  ObjC3QualifiedNameLookupStatus Status =
+      ObjC3QualifiedNameLookupStatus::NotHandled;
+  if (ExternalSemaSource *Source = getExternalSource())
+    Status = Source->LookupObjC3QualifiedName(
+        Path, Decl::IDNS_Ordinary | Decl::IDNS_Tag, Declarations);
+
+  const std::string Spelling = getQualifiedSpelling(Path, Path.size());
+  if (Status == ObjC3QualifiedNameLookupStatus::ModuleNotVisible) {
+    const std::string Module = getModuleSpelling(Path, Path.size());
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified type '%0' refers to a module that is not imported");
+    auto Builder = Diag(AtLoc, ID) << Spelling;
+    if (!AtLoc.isMacroID()) {
+      SourceLocation Insert = SourceMgr.getLocForStartOfFile(SourceMgr.getFileID(AtLoc));
+      Builder << FixItHint::CreateInsertion(Insert,
+                                            "@import " + Module + ";\n");
+    }
+    return TypeError();
+  }
+  if (Status != ObjC3QualifiedNameLookupStatus::Found &&
+      Status != ObjC3QualifiedNameLookupStatus::Ambiguous) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified type '%0' does not name an exported type");
+    Diag(AtLoc, ID) << Spelling;
+    return TypeError();
+  }
+
+  SmallVector<TypeDecl *, 4> Types;
+  for (NamedDecl *Declaration : Declarations)
+    if (auto *Type = dyn_cast<TypeDecl>(Declaration)) {
+      auto SameType = llvm::find_if(Types, [&](TypeDecl *Prior) {
+        return Context.hasSameType(Context.getCanonicalType(
+                                       Context.getTypeDeclType(Prior)),
+                                   Context.getCanonicalType(
+                                       Context.getTypeDeclType(Type)));
+      });
+      if (SameType == Types.end())
+        Types.push_back(Type);
+      else if (isa<TypedefNameDecl>(Type) &&
+               !isa<TypedefNameDecl>(*SameType))
+        *SameType = Type;
+    }
+  if (Types.empty() &&
+      Status == ObjC3QualifiedNameLookupStatus::Ambiguous) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified type '%0' is ambiguous");
+    Diag(AtLoc, ID) << Spelling;
+    return TypeError();
+  }
+  if (Types.empty()) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified name '%0' does not denote a type");
+    Diag(AtLoc, ID) << Spelling;
+    return TypeError();
+  }
+  if (Types.size() > 1) {
+    auto ID = getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "module-qualified type '%0' is ambiguous");
+    Diag(AtLoc, ID) << Spelling;
+    return TypeError();
+  }
+  TypeDecl *TypeDeclaration = Types.front();
+  QualType Type = Context.getTypeDeclType(TypeDeclaration);
+  if (Type.isNull())
+    return TypeError();
+
+  // The actual imported typedef/tag QualType is retained (including typedef
+  // sugar). The TypeLoc's name token is the final component; the enclosing
+  // DeclSpec range covers the complete @Module.Path.Name spelling.
+  TypeSourceInfo *Info =
+      Context.getTrivialTypeSourceInfo(Type, Locations.back());
+  return CreateParsedType(Type, Info);
+}
diff --git a/clang/lib/Sema/SemaObjC3Propagation.cpp b/clang/lib/Sema/SemaObjC3Propagation.cpp
new file mode 100644
index 000000000..a9e120f17
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Propagation.cpp
@@ -0,0 +1,250 @@
+//===--- SemaObjC3Propagation.cpp - ObjC3 typed propagation semantics -----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "SemaObjC3CarrierARC.h"
+#include "SemaObjC3ErrorContext.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/EvaluatedExprVisitor.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3Async.h"
+#include "clang/Sema/Lookup.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/Stmt.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/Support/SaveAndRestore.h"
+
+using namespace clang;
+
+namespace {
+const FunctionProtoType *getCalledObjC3FunctionType(Sema &S, Expr *Operand) {
+  Operand = const_cast<Expr *>(getObjC3AsyncSourceCall(Operand));
+  if (auto *Message = dyn_cast<ObjCMessageExpr>(Operand)) {
+    const auto *Method = Message->getMethodDecl();
+    if (Method && !Method->getObjC3FunctionType().isNull())
+      return Method->getObjC3FunctionType()->castAs<FunctionProtoType>();
+    return nullptr;
+  }
+  auto *Call = dyn_cast<CallExpr>(Operand);
+  if (!Call)
+    return nullptr;
+  QualType CalleeType = Call->getCallee()->getType();
+  if (Call->getCallee()->hasPlaceholderType(BuiltinType::BoundMember))
+    CalleeType = Expr::findBoundMemberType(Call->getCallee());
+  if (CalleeType.isNull())
+    return nullptr;
+  CalleeType = S.Context.getCanonicalType(CalleeType);
+  if (const auto *Pointer = CalleeType->getAs<PointerType>())
+    CalleeType = S.Context.getCanonicalType(Pointer->getPointeeType());
+  else if (const auto *Block = CalleeType->getAs<BlockPointerType>())
+    CalleeType = S.Context.getCanonicalType(Block->getPointeeType());
+  return CalleeType->getAs<FunctionProtoType>();
+}
+
+class CheckedCallVisitor : public EvaluatedExprVisitor<CheckedCallVisitor> {
+  using Base = EvaluatedExprVisitor<CheckedCallVisitor>;
+  Sema &S;
+  Expr *Handled = nullptr;
+  llvm::SmallPtrSet<Expr *, 16> Diagnosed;
+
+  void check(Expr *E, bool Awaited = false) {
+    if (E == Handled)
+      return;
+    const auto *Function = getCalledObjC3FunctionType(S, E);
+    if (Function &&
+        Function->getObjC3FunctionEffects().Throws != ObjC3ThrowsKind::None &&
+        (Awaited || !Function->getObjC3FunctionEffects().Async) &&
+        Diagnosed.insert(E).second)
+      S.Diag(E->getExprLoc(), diag::err_objc3_call_requires_check);
+  }
+
+public:
+  explicit CheckedCallVisitor(Sema &S) : Base(S.Context), S(S) {}
+  bool failed() const { return !Diagnosed.empty(); }
+
+  void VisitObjC3TryExpr(ObjC3TryExpr *E) {
+    // The checked form handles its immediate call. A throwing receiver,
+    // callee expression or argument still needs a separate checked form.
+    llvm::SaveAndRestore Guard(Handled,
+        const_cast<Expr *>(getObjC3AsyncSourceCall(E->getOperand())));
+    Visit(E->getOperand());
+  }
+  void VisitCoawaitExpr(CoawaitExpr *E) {
+    check(const_cast<Expr *>(getObjC3AsyncSourceCall(E)), true);
+    Base::VisitStmt(E);
+  }
+  void VisitCallExpr(CallExpr *E) {
+    if (E->isUnevaluatedBuiltinCall(S.Context))
+      return;
+    check(E);
+    Base::VisitCallExpr(E);
+  }
+  void VisitObjCMessageExpr(ObjCMessageExpr *E) {
+    check(E);
+    Base::VisitStmt(E);
+  }
+  void VisitCXXDefaultArgExpr(CXXDefaultArgExpr *E) {
+    if (Expr *Init = E->getExpr())
+      Visit(Init);
+  }
+  void VisitCXXDefaultInitExpr(CXXDefaultInitExpr *E) {
+    if (Expr *Init = E->getExpr())
+      Visit(Init);
+  }
+};
+
+} // namespace
+
+bool clang::diagnoseObjC3UncheckedCalls(Sema &S, Stmt *Root) {
+  if (!S.getLangOpts().ObjC3 || !Root)
+    return false;
+  CheckedCallVisitor Visitor(S);
+  Visitor.Visit(Root);
+  return Visitor.failed();
+}
+
+ExprResult Sema::ActOnObjC3TryExpr(unsigned Kind, SourceLocation KeywordLoc,
+                                   SourceLocation LParenLoc, Expr *Operand,
+                                   SourceLocation RParenLoc) {
+  if (!Operand)
+    return ExprError();
+  auto Operation = static_cast<ObjC3TryExpr::Kind>(Kind);
+  if (Kind > static_cast<unsigned>(ObjC3TryExpr::Kind::Force))
+    return ExprError();
+  if (!Operand->isTypeDependent() && Operand->getValueKind() != VK_PRValue) {
+    Diag(KeywordLoc, diag::err_objc3_try_requires_prvalue);
+    return ExprError();
+  }
+
+  QualType ResultType = Operand->getType();
+  bool CheckedAsync = false;
+  if (!Operand->isTypeDependent()) {
+    const FunctionProtoType *Called =
+        getCalledObjC3FunctionType(*this, Operand);
+    if (!Called ||
+        Called->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::None) {
+      Diag(KeywordLoc, diag::err_objc3_try_requires_throwing_call);
+      return ExprError();
+    }
+
+    ObjC3FunctionEffectInfo CalleeEffects = Called->getObjC3FunctionEffects();
+    CheckedAsync = CalleeEffects.Async;
+    if (CheckedAsync && !isa<CoawaitExpr>(Operand->IgnoreImplicit())) {
+      Diag(KeywordLoc, diag::err_objc3_try_requires_throwing_call);
+      return ExprError();
+    }
+    if (Operation == ObjC3TryExpr::Kind::Propagate && !isUnevaluatedContext() &&
+        !RecordObjC3ThrownEffect(CalleeEffects, KeywordLoc)) {
+      ObjC3FunctionEffectInfo CallerEffects =
+          getCurrentObjC3CallableEffects(*this);
+      // Native C++ and Objective-C exception handlers do not handle this
+      // separate typed-error effect.
+      if (CallerEffects.Throws == ObjC3ThrowsKind::None) {
+        Diag(KeywordLoc, diag::err_objc3_try_requires_throwing_context);
+        return ExprError();
+      }
+      if (CallerEffects.Throws != CalleeEffects.Throws ||
+          (CalleeEffects.Throws == ObjC3ThrowsKind::Typed &&
+           !Context.hasSameType(
+               Context.getCanonicalType(CallerEffects.ErrorType),
+               Context.getCanonicalType(CalleeEffects.ErrorType)))) {
+        Diag(KeywordLoc, diag::err_objc3_try_effect_mismatch);
+        return ExprError();
+      }
+    }
+  }
+  if (Operation == ObjC3TryExpr::Kind::Optionalize) {
+    // A successful call becomes a stored payload. Use the same ownership
+    // normalization as an explicit Optional constructor before type uniquing.
+    if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, ResultType))
+      return ExprError();
+    ResultType = Context.getObjC3OptionalType(ResultType);
+  }
+
+  if (CheckedAsync && !getObjC3CheckedAsyncAdapter(Operand)) {
+    auto *Await = cast<CoawaitExpr>(Operand->IgnoreImplicit());
+    LookupResult Hook(*this, &Context.Idents.get("__objc3_async_checked"),
+                      KeywordLoc, LookupOrdinaryName);
+    Hook.suppressDiagnostics();
+    LookupQualifiedName(Hook, Context.getTranslationUnitDecl());
+    if (Hook.empty()) {
+      Diag(KeywordLoc, diag::err_objc3_async_task_header);
+      return ExprError();
+    }
+    CXXScopeSpec SS;
+    ExprResult Callee = BuildDeclarationNameExpr(SS, Hook, false);
+    if (Callee.isInvalid())
+      return ExprError();
+    auto *ErrorSlot = new (Context) OpaqueValueExpr(
+        KeywordLoc, Context.getPointerType(Context.VoidPtrTy), VK_PRValue);
+    Expr *Args[] = {Await->getOperand(), ErrorSlot};
+    ExprResult Adapter = BuildCallExpr(nullptr, Callee.get(), KeywordLoc, Args,
+                                       RParenLoc);
+    if (Adapter.isInvalid())
+      return ExprError();
+    ExprResult Checked = ActOnCoawaitExpr(getCurScope(), Await->getKeywordLoc(),
+                                         Adapter.get());
+    if (Checked.isInvalid())
+      return ExprError();
+    Operand = Checked.get();
+  }
+  CheckCompletedExpr(Operand, RParenLoc);
+  return ObjC3TryExpr::Create(Context, Operation, Operand, ResultType,
+                              KeywordLoc, LParenLoc, RParenLoc);
+}
+
+StmtResult Sema::ActOnObjC3ThrowStmt(SourceLocation KeywordLoc, Expr *Payload,
+                                     SourceLocation SemiLoc) {
+  if (!Payload)
+    return StmtError();
+  if (getLangOpts().ObjC3 && getLangOpts().CPlusPlus20) {
+    if (const auto *FT =
+            getObjC3CallableFunctionType(Decl::castFromDeclContext(CurContext)))
+      if (FT->getObjC3FunctionEffects().Async &&
+          !ActOnCoroutineBodyStart(getCurScope(), KeywordLoc, "co_return"))
+        return StmtError();
+  }
+  ExprResult Converted = DefaultLvalueConversion(Payload);
+  if (Converted.isInvalid())
+    return StmtError();
+  Payload = Converted.get();
+  if (Payload->getType()->isObjCObjectPointerType() &&
+      !Payload->isValueDependent() && !Payload->isTypeDependent()) {
+    // ObjC pointer casts are not C/C++ null pointer constants. Use Clang's
+    // constant evaluator to recognize a typed nil without rejecting scalar 0.
+    Expr::EvalResult Value;
+    if (Payload->EvaluateAsRValue(Value, Context) && !Value.HasSideEffects &&
+        Value.Val.isLValue() && Value.Val.isNullPointer()) {
+      Diag(KeywordLoc, diag::err_objc3_throw_static_nil);
+      return StmtError();
+    }
+  }
+  ObjC3FunctionEffectInfo PayloadEffect = {false, ObjC3ThrowsKind::Typed,
+                                           Payload->getType()};
+  if (RecordObjC3ThrownEffect(PayloadEffect, KeywordLoc)) {
+    // In a protected body, the explicit expression carries the statically
+    // known typed payload. The enclosing callable effect is checked only if
+    // this fact escapes all matching clauses.
+  } else {
+    ObjC3FunctionEffectInfo Effects = getCurrentObjC3CallableEffects(*this);
+    // Native C++ catch and Objective-C @catch do not authorize ObjC3 throw.
+    if (Effects.Throws == ObjC3ThrowsKind::None) {
+      Diag(KeywordLoc, diag::err_objc3_throw_requires_throwing_context);
+      return StmtError();
+    }
+    if (Effects.Throws == ObjC3ThrowsKind::Typed &&
+        !Payload->isTypeDependent() &&
+        !Context.hasSameType(Context.getCanonicalType(Payload->getType()),
+                             Context.getCanonicalType(Effects.ErrorType))) {
+      Diag(KeywordLoc, diag::err_objc3_throw_payload_mismatch);
+      return StmtError();
+    }
+  }
+
+  CheckCompletedExpr(Payload, KeywordLoc);
+  ExprResult FullExpr = MaybeCreateExprWithCleanups(Payload);
+  return ObjC3ThrowStmt::Create(Context, KeywordLoc, FullExpr.get(), SemiLoc);
+}
