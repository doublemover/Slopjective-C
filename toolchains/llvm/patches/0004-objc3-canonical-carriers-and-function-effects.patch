+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-print %s > %t.mm
+// RUN: FileCheck %s --check-prefix=PRINT < %t.mm
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only %t.mm
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump=json %s | FileCheck %s --check-prefix=JSON
+// expected-no-diagnostics
+
+typedef Optional(int) Maybe;
+int fallback();
+int chain(Maybe source, Maybe other) {
+  return source ?? other ?? fallback();
+}
+
+int precedence(Maybe source) {
+  return source ?? fallback() || fallback() ? 3 : 4;
+}
+
+#define OTHERWISE ??
+int macro_punctuator(Maybe source) { return source OTHERWISE fallback(); }
+
+int standard_conditionals(bool condition, int first, int second) {
+  return condition ? first : second;
+}
+
+template <class T, class U> auto dependent(T source, U other) {
+  return source ?? other;
+}
+int instantiate_dependent(Maybe source) { return dependent(source, 1); }
+
+static_assert(__is_same(decltype(None(int) ?? 3.5), double));
+static_assert(__is_same(decltype(None(int) ?? None(int)), Maybe));
+static_assert(__is_same(decltype(None(Maybe) ?? Some(int, 2)), Maybe));
+
