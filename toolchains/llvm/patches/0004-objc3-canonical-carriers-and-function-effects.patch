+void close_handle(int) __attribute__((nothrow));
+void consume_handle(int) __attribute__((nothrow));
+#define RESOURCE __attribute__((objc_resource(close=close_handle, invalid=0)))
+void legal_transfer(void) {
+  int value RESOURCE = 0;
+  reset(value, 7);
+  int owned = take(value);
+  consume_handle(owned);
+  close_handle(owned);
+  if(value != 0)consume_handle(value);
+  value = 8;
+  discard(value);
+  reset(value, 9);
+}
+void moved_use(void) {
+  int value RESOURCE = 3;
+  int owned = take(value);
+  consume_handle(owned);
+  consume_handle(value); // strict-error {{may have been moved or discarded}}
+}
+void overwrite(void) {
+  int value RESOURCE = 3;
+  value = 4; // strict-error {{may overwrite live resource}}
+}
+void copy_owner(void) {
+  int value RESOURCE = 3;
+  int other RESOURCE = value; // strict-error {{copies ownership}}
+  (void)other;
+}
+void manual_close(void) {
+  int value RESOURCE = 3;
+  close_handle(value); // strict-error {{manual close of registered resource}}
+}
+void lost_take(void) {
+  int value RESOURCE = 3;
+  take(value); // strict-error {{discards its ownership result}} compat-warning {{expression result unused}} strict-warning {{expression result unused}}
+}
+void escaped_storage(void) {
+  int value RESOURCE = 3;
+  int *escaped = &value; // strict-error {{cannot track escaped storage}}
+  (void)escaped;
+}
+
+#ifdef __cplusplus
+void captured_owner(void) {
+  int value RESOURCE = 3;
+  auto closure = [value] { return value; }; // strict-error {{requires ownership-aware capture support}}
+  (void)closure;
+}
+#endif
