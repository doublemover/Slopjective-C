+}
+
+// C++ noexcept is independent: its standard conversion does not erase or
+// synthesize ObjC3 typed-throws identity.
+typedef void CppNoexcept(void) noexcept;
+typedef void CppMayThrow(void);
+typedef void ThrowsErrorNoexcept(void) noexcept __objc3_throws(Error);
+void cpp_exception_spec_is_separate(CppNoexcept *noexcept_fn,
+                                    ThrowsErrorNoexcept *effect_noexcept,
