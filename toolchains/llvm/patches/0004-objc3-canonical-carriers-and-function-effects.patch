+++ b/clang/test/ObjC3/AST/Inputs/generic-lambda-print.h
@@ -0,0 +1,11 @@
+inline int generic_print(int n) {
+  auto sum=[]<class... T>(T... values){return (0+...+values);};
+  auto defaults=[]<class T=int>(T value=42){return value;};
+  auto immediate=[](auto value) consteval {return value+2;};
+  int (*callback)(int)=[](auto value){return value+2;};
+#if __cplusplus>202002L
+  auto stateless=[](auto value) static {return value+2;};
+  n=stateless(n);
+#endif
+  return sum(n,2)+sum()+defaults.template operator()<>()+immediate(40)+callback(n);
+}
