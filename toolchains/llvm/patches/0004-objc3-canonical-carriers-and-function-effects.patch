+      if (Record->hasAttr<AbiTagAttr>()) {
+        ASSERT_TRUE(Copy->hasAttr<AbiTagAttr>());
+        EXPECT_EQ(*Record->getAttr<AbiTagAttr>()->tags_begin(),
+                  *Copy->getAttr<AbiTagAttr>()->tags_begin());
+      }
