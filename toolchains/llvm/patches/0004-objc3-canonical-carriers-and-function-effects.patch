diff --git a/clang/test/ObjC3/Sema/typed-keypath-generic-root.m b/clang/test/ObjC3/Sema/typed-keypath-generic-root.m
new file mode 100644
index 000000000..d172593fa
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-generic-root.m
@@ -0,0 +1,27 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+#include "../Inputs/keypath-abi.h"
+__attribute__((objc_root_class))
+@interface GenericPathRoot
+@property(nonatomic) int count;
+@end
+__attribute__((objc_root_class))
+@interface GenericPathBox<T : id> 
+@property(nonatomic, strong) T _Nonnull item;
+@end
+
+typedef GenericPathBox<GenericPathRoot *> PathBox;
+WritableKeyPath<PathBox *, GenericPathRoot * _Nonnull> item_path(void) {
+  return @keypath(PathBox, item);
+}
+WritableKeyPath<PathBox *, int> chained_path(void) {
+  return @keypath(PathBox, item.count);
+}
+GenericPathRoot * _Nonnull read_item(PathBox * _Nonnull box) {
+  return KeyPathGet(item_path(), box);
+}
+int read_count(PathBox * _Nonnull box) {
+  KeyPathSet(chained_path(), box, 42);
+  return KeyPathGet(chained_path(), box);
+}
diff --git a/clang/test/ObjC3/Sema/typed-keypath-record-fields.m b/clang/test/ObjC3/Sema/typed-keypath-record-fields.m
new file mode 100644
index 000000000..bed041dae
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-keypath-record-fields.m
@@ -0,0 +1,75 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+#include "../Inputs/keypath-abi.h"
+typedef struct InnerPathRecord { long first, second; } InnerPathRecord;
+typedef struct OuterPathRecord { InnerPathRecord inner; int sibling; }
+    OuterPathRecord;
+typedef struct ConstPathRecord { const int value; } ConstPathRecord;
+typedef struct BitPathRecord { unsigned bits : 3; } BitPathRecord;
+typedef union UnionPathRecord { int value; float other; } UnionPathRecord;
+__attribute__((objc_root_class))
+@interface RecordPathRoot
+@property(nonatomic) OuterPathRecord record;
+@property(nonatomic, readonly) OuterPathRecord readonlyRecord;
+@property(nonatomic) ConstPathRecord fixed;
+@property(nonatomic) BitPathRecord bitRecord;
+@property(nonatomic) UnionPathRecord unionRecord;
+@end
+
+WritableKeyPath<RecordPathRoot *, long> record_path(void) {
+  return @keypath(RecordPathRoot, record.inner.first);
+}
+KeyPath<RecordPathRoot *, long> readonly_record_path(void) {
+  return @keypath(RecordPathRoot, readonlyRecord.inner.first);
+}
+KeyPath<RecordPathRoot *, int> const_field_path(void) {
+  return @keypath(RecordPathRoot, fixed.value);
+}
+void mutate_record(RecordPathRoot * _Nonnull root) {
+  KeyPathSet(record_path(), root, 42L);
+  long value = KeyPathGet(record_path(), root);
+  (void)value;
+  KeyPathSet(readonly_record_path(), root, 1L); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  KeyPathSet(const_field_path(), root, 1); // expected-error {{KeyPathSet requires a WritableKeyPath value}}
+  (void)@keypath(RecordPathRoot, record.missing); // expected-error {{key-path component must name an unambiguous visible record field}}
+  WritableKeyPath<RecordPathRoot *, unsigned> bits = @keypath(RecordPathRoot, bitRecord.bits);
+  KeyPathSet(bits, root, 10U);
+  (void)KeyPathGet(bits, root);
+  WritableKeyPath<RecordPathRoot *,int> union_path=@keypath(RecordPathRoot, unionRecord.value);
+  KeyPathSet(union_path,root,42);
+  (void)KeyPathGet(union_path,root);
+}
+
+#ifdef __cplusplus
+struct BaseField { int value; }; // expected-note {{member is declared here}}
+struct OtherField { int value; };
+struct InheritedField : BaseField { int sibling; };
+struct HiddenField : BaseField { long value; };
+struct PrivateField : private BaseField {}; // expected-note {{constrained by private inheritance here}}
+struct AmbiguousField : BaseField, OtherField {};
+struct ProtectedField { protected: int value; };
+struct PublicUsingField : ProtectedField { using ProtectedField::value; };
+@interface RecordPathRoot (Inherited)
+@property(nonatomic) InheritedField inherited;
+@property(nonatomic) HiddenField hidden;
+@property(nonatomic) PrivateField privateBase;
+@property(nonatomic) AmbiguousField ambiguous;
+@property(nonatomic) PublicUsingField published;
+@end
+void inherited_fields(RecordPathRoot * _Nonnull root) {
+  WritableKeyPath<RecordPathRoot *, int> inherited = @keypath(RecordPathRoot, inherited.value);
+  KeyPathSet(inherited, root, 42);
+  WritableKeyPath<RecordPathRoot *, long> hidden = @keypath(RecordPathRoot, hidden.value);
+  KeyPathSet(hidden, root, 42L);
+  WritableKeyPath<RecordPathRoot *, int> published = @keypath(RecordPathRoot, published.value);
+  KeyPathSet(published, root, 42);
+  (void)@keypath(RecordPathRoot, privateBase.value); // expected-error {{'value' is a private member of 'BaseField'}}
+  (void)@keypath(RecordPathRoot, ambiguous.value); // expected-error {{key-path component must name an unambiguous visible record field}}
+}
+#endif
+
