+void EnqueueVisitor::VisitObjC3OptionalExpr(const ObjC3OptionalExpr *E) {
+  AddStmt(E->getPayload());
+  AddTypeLoc(E->getPayloadTypeInfo());
+}
+
+void EnqueueVisitor::VisitObjC3CoalesceExpr(const ObjC3CoalesceExpr *E) {
+  // The semantic conditional reuses operands and generated opaque values.
+  // Cursors describe each written operand exactly once.
+  AddStmt(E->getRHS());
+  AddStmt(E->getLHS());
+}
+
+void EnqueueVisitor::VisitObjC3OptionalAccessExpr(
+    const ObjC3OptionalAccessExpr *E) {
+  AddStmt(E->getAccess());
+  AddStmt(E->getReceiver());
+}
+
+void EnqueueVisitor::VisitObjC3ResultExpr(const ObjC3ResultExpr *E) {
+  AddStmt(E->getPayload());
+  AddTypeLoc(E->getErrorTypeInfo());
+  AddTypeLoc(E->getSuccessTypeInfo());
+}
+
+void EnqueueVisitor::VisitObjC3CarrierTransferExpr(
+    const ObjC3CarrierTransferExpr *E) {
+  // Initialization recipes contain compiler-generated operations sharing the
+  // source location. They must not shadow the written source in token queries.
+  AddStmt(E->getSource());
+}
+
+void EnqueueVisitor::VisitObjC3CatchStmt(const ObjC3CatchStmt *S) {
+  AddStmt(S->getHandlerBody());
+  AddStmt(S->getBindingDeclStmt());
+  AddTypeLoc(S->getCatchTypeInfo());
+}
