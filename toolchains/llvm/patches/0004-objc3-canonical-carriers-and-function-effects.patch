diff --git a/clang/include/clang/AST/ObjC3Borrowed.h b/clang/include/clang/AST/ObjC3Borrowed.h
new file mode 100644
index 000000000..0c1062833
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3Borrowed.h
@@ -0,0 +1,171 @@
+//===--- ObjC3Borrowed.h - Borrowed pointer type contracts --------*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3BORROWED_H
+#define LLVM_CLANG_AST_OBJC3BORROWED_H
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "llvm/ADT/SmallPtrSet.h"
+
+namespace clang {
+/// Borrowing is ABI-neutral type sugar, retained through typedefs and aliases.
+/// Do not canonicalize before asking this question: canonical C pointers have
+/// the same representation but do not carry the source lifetime contract.
+inline bool isObjC3BorrowedType(const ASTContext &Context, QualType Type) {
+  while (!Type.isNull()) {
+    if (const auto *Attributed = dyn_cast<AttributedType>(Type.getTypePtr()))
+      if (Attributed->getAttrKind() == attr::ObjC3Borrowed)
+        return true;
+    QualType Next = Type.getSingleStepDesugaredType(Context);
+    if (Next == Type)
+      break;
+    Type = Next;
+  }
+  return false;
+}
+/// Inspect stored payloads before canonicalization, including native carriers
+/// and aggregate fields. The visited set bounds recursive record graphs.
+inline bool containsObjC3BorrowedTypeImpl(const ASTContext &Context,
+                                          QualType Type,
+                                          llvm::SmallPtrSetImpl<const clang::Type *> &Seen) {
+  if (Type.isNull())
+    return false;
+  if (isObjC3BorrowedType(Context, Type))
+    return true;
+  while (true) {
+    QualType Next = Type.getSingleStepDesugaredType(Context);
+    if (Next == Type)
+      break;
+    Type = Next;
+  }
+  if (!Seen.insert(Type.getTypePtr()).second)
+    return false;
+  auto Contains = [&](QualType Child) {
+    return containsObjC3BorrowedTypeImpl(Context, Child, Seen);
+  };
+  if (Type->isPointerType() || Type->isReferenceType() || Type->isBlockPointerType())
+    return Contains(Type->getPointeeType());
+  if (const auto *Array = dyn_cast<ArrayType>(Type.getTypePtr()))
+    return Contains(Array->getElementType());
+  if (const auto *Optional = dyn_cast<ObjC3OptionalType>(Type.getTypePtr()))
+    return Contains(Optional->getElementType());
+  if (const auto *Result = dyn_cast<ObjC3ResultType>(Type.getTypePtr()))
+    return Contains(Result->getSuccessType()) || Contains(Result->getErrorType());
+  if (const auto *Record = Type->getAs<RecordType>())
+    for (const FieldDecl *Field : Record->getDecl()->fields())
+      if (Contains(Field->getType()))
+        return true;
+  if (const auto *Function = dyn_cast<FunctionType>(Type.getTypePtr())) {
+    if (Contains(Function->getReturnType()))
+      return true;
+    if (const auto *Prototype = dyn_cast<FunctionProtoType>(Function))
+      for (QualType Parameter : Prototype->param_types())
+        if (Contains(Parameter))
+          return true;
+  }
+  return false;
+}
+inline bool containsObjC3BorrowedType(const ASTContext &Context, QualType Type) {
+  llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+  return containsObjC3BorrowedTypeImpl(Context, Type, Seen);
+}
+inline const ObjCReturnsBorrowedAttr *
+getObjC3BorrowedReturnContract(const Decl *Declaration) {
+  if (!Declaration)
+    return nullptr;
+  if (const auto *Function = dyn_cast<FunctionDecl>(Declaration))
+    for (const FunctionDecl *Redeclaration : Function->redecls())
+      if (const auto *Contract =
+              Redeclaration->getAttr<ObjCReturnsBorrowedAttr>())
+        return Contract;
+  return Declaration->getAttr<ObjCReturnsBorrowedAttr>();
+}
+/// Compare borrowing recursively before canonicalization can erase nested
+/// pointer, function-pointer, array-element, and typedef lifetime contracts.
+inline bool sameObjC3BorrowedType(const ASTContext &AContext, QualType A,
+                                  const ASTContext &BContext, QualType B) {
+  if (A.isNull() || B.isNull())
+    return A.isNull() && B.isNull();
+  if (isObjC3BorrowedType(AContext, A) != isObjC3BorrowedType(BContext, B))
+    return false;
+  auto Peel = [](const ASTContext &Context, QualType Type) {
+    while (true) {
+      QualType Next = Type.getSingleStepDesugaredType(Context);
+      if (Next == Type)
+        return Type;
+      Type = Next;
+    }
+  };
+  A = Peel(AContext, A);
+  B = Peel(BContext, B);
+  auto Compare = [&](QualType L, QualType R) {
+    return sameObjC3BorrowedType(AContext, L, BContext, R);
+  };
+  if ((A->isPointerType() && B->isPointerType()) ||
+      (A->isReferenceType() && B->isReferenceType()) ||
+      (A->isBlockPointerType() && B->isBlockPointerType()))
+    return Compare(A->getPointeeType(), B->getPointeeType());
+  if (const auto *AA = dyn_cast<ArrayType>(A.getTypePtr()))
+    if (const auto *AB = dyn_cast<ArrayType>(B.getTypePtr()))
+      return Compare(AA->getElementType(), AB->getElementType());
+  if (const auto *OA = dyn_cast<ObjC3OptionalType>(A.getTypePtr()))
+    if (const auto *OB = dyn_cast<ObjC3OptionalType>(B.getTypePtr()))
+      return Compare(OA->getElementType(), OB->getElementType());
+  if (const auto *RA = dyn_cast<ObjC3ResultType>(A.getTypePtr()))
+    if (const auto *RB = dyn_cast<ObjC3ResultType>(B.getTypePtr()))
+      return Compare(RA->getSuccessType(), RB->getSuccessType()) &&
+             Compare(RA->getErrorType(), RB->getErrorType());
+  if (const auto *FA = dyn_cast<FunctionType>(A.getTypePtr()))
+    if (const auto *FB = dyn_cast<FunctionType>(B.getTypePtr())) {
+      if (!Compare(FA->getReturnType(), FB->getReturnType()))
+        return false;
+      const auto *PA = dyn_cast<FunctionProtoType>(FA);
+      const auto *PB = dyn_cast<FunctionProtoType>(FB);
+      if (PA && PB && PA->getNumParams() == PB->getNumParams()) {
+        for (unsigned I = 0; I != PA->getNumParams(); ++I)
+          if (!Compare(PA->getParamType(I), PB->getParamType(I)))
+            return false;
+      } else {
+        if (PA)
+          for (QualType P : PA->param_types())
+            if (containsObjC3BorrowedType(AContext, P))
+              return false;
+        if (PB)
+          for (QualType P : PB->param_types())
+            if (containsObjC3BorrowedType(BContext, P))
+              return false;
+      }
+    }
+  return true;
+}
+/// Compare the lifetime part of a signature before ordinary canonical type
+/// comparison erases ABI-neutral borrowing. Used by redeclaration and import.
+template <class Callable>
+inline bool sameObjC3BorrowedSignature(const ASTContext &AContext,
+                                       const Callable *A,
+                                       const ASTContext &BContext,
+                                       const Callable *B) {
+  if (!sameObjC3BorrowedType(AContext, A->getReturnType(), BContext,
+                            B->getReturnType()))
+    return false;
+  auto AP = A->parameters(), BP = B->parameters();
+  if (AP.size() == BP.size()) {
+    for (unsigned I = 0; I != AP.size(); ++I)
+      if (!sameObjC3BorrowedType(AContext, AP[I]->getType(), BContext,
+                                BP[I]->getType()))
+        return false;
+  } else {
+    for (const ParmVarDecl *P : AP)
+      if (containsObjC3BorrowedType(AContext, P->getType()))
+        return false;
+    for (const ParmVarDecl *P : BP)
+      if (containsObjC3BorrowedType(BContext, P->getType()))
+        return false;
+  }
+  const auto *CA = A->template getAttr<ObjCReturnsBorrowedAttr>();
+  const auto *CB = B->template getAttr<ObjCReturnsBorrowedAttr>();
+  return bool(CA) == bool(CB) && (!CA || CA->getOwnerIndex() == CB->getOwnerIndex());
+}
+} // namespace clang
+#endif
diff --git a/clang/include/clang/AST/ObjC3Isolation.h b/clang/include/clang/AST/ObjC3Isolation.h
new file mode 100644
index 000000000..1e0226ed1
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3Isolation.h
@@ -0,0 +1,86 @@
+//===--- ObjC3Isolation.h - Objective-C 3 isolation identity ------*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3ISOLATION_H
+#define LLVM_CLANG_AST_OBJC3ISOLATION_H
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclObjC.h"
+namespace clang {
+inline const ObjCInterfaceDecl *getObjC3ContainingInterface(const Decl *D) {
+  if (const auto *I = dyn_cast_or_null<ObjCInterfaceDecl>(D))
+    return I;
+  if (const auto *I = dyn_cast_or_null<ObjCImplDecl>(D))
+    return I->getClassInterface();
+  if (const auto *C = dyn_cast_or_null<ObjCCategoryDecl>(D))
+    return C->getClassInterface();
+  if (!D || !D->getDeclContext())
+    return nullptr;
+  const Decl *Container = Decl::castFromDeclContext(D->getDeclContext());
+  if (isa<ObjCContainerDecl>(Container))
+    return getObjC3ContainingInterface(Container);
+  return nullptr;
+}
+inline bool isObjC3Actor(const ObjCInterfaceDecl *I) {
+  for (; I; I = I->getSuperClass())
+    if (I->hasAttr<ObjC3ActorAttr>() ||
+        (I->getDefinition() && I->getDefinition()->hasAttr<ObjC3ActorAttr>()))
+      return true;
+  return false;
+}
+inline bool isObjC3Nonisolated(const Decl *D) {
+  if (!D)
+    return false;
+  if (D->hasAttr<ObjCNonisolatedAttr>())
+    return true;
+  if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+    if (M->isPropertyAccessor())
+      if (const auto *P = M->findPropertyDecl())
+        return P->hasAttr<ObjCNonisolatedAttr>();
+  return false;
+}
+inline const ObjCExecutorAttr *getObjC3Executor(const Decl *D) {
+  if (!D)
+    return nullptr;
+  // Nonisolated removes actor binding and its default type affinity, while an
+  // explicit callable executor remains an independent entry requirement.
+  if (const auto *A = D->getAttr<ObjCExecutorAttr>())
+    return A;
+  if (isObjC3Nonisolated(D))
+    return nullptr;
+  for (const auto *I = getObjC3ContainingInterface(D); I;
+       I = I->getSuperClass())
+    if (const auto *A = I->getDefinition()
+                            ? I->getDefinition()->getAttr<ObjCExecutorAttr>()
+                            : I->getAttr<ObjCExecutorAttr>())
+      return A;
+  return nullptr;
+}
+inline bool isObjC3ActorIsolated(const Decl *D) {
+  if (!D || isObjC3Nonisolated(D))
+    return false;
+  if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+    return M->isInstanceMethod() && isObjC3Actor(M->getClassInterface());
+  if (const auto *P = dyn_cast<ObjCPropertyDecl>(D))
+    return P->isInstanceProperty() &&
+           isObjC3Actor(getObjC3ContainingInterface(P));
+  return isa<ObjCIvarDecl>(D) && isObjC3Actor(getObjC3ContainingInterface(D));
+}
+inline unsigned getObjC3TaskBoundaryKind(const Decl *D) {
+  if (!D)
+    return 0;
+  return unsigned(D->hasAttr<ObjCTaskSpawnAttr>()) |
+         (unsigned(D->hasAttr<ObjCTaskDetachedAttr>()) << 1) |
+         (unsigned(D->hasAttr<ObjCTaskGroupAttr>()) << 2);
+}
+/// Required declaration identity, including absence of required metadata.
+/// Safe across AST contexts: named executor identity is textual, not pointer
+/// based.
+inline bool haveSameObjC3Isolation(const Decl *A, const Decl *B) {
+  const auto *AE = getObjC3Executor(A), *BE = getObjC3Executor(B);
+  return bool(AE) == bool(BE) &&
+         (!AE || AE->getExecutor() == BE->getExecutor()) &&
+         isObjC3ActorIsolated(A) == isObjC3ActorIsolated(B) &&
+         getObjC3TaskBoundaryKind(A) == getObjC3TaskBoundaryKind(B);
+}
+} // namespace clang
+#endif
diff --git a/clang/include/clang/AST/ObjC3KeyPath.h b/clang/include/clang/AST/ObjC3KeyPath.h
new file mode 100644
index 000000000..82c046abc
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3KeyPath.h
@@ -0,0 +1,217 @@
+//===--- ObjC3KeyPath.h - Native key-path record identity ---------*- C++ -*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3KEYPATH_H
+#define LLVM_CLANG_AST_OBJC3KEYPATH_H
+
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Expr.h"
+#include <iterator>
+
+namespace clang {
+/// Key paths use ordinary native records, function pointers, and immutable
+/// globals. These contracts recognize their compiler-owned record identities
+/// after native AST import without retaining process-local Sema state.
+struct ObjC3KeyPathInfo {
+  FieldDecl *Read = nullptr;
+  FieldDecl *Metadata = nullptr;
+  FieldDecl *Get = nullptr;
+  FieldDecl *Set = nullptr;
+  QualType Root, Value;
+};
+
+inline bool getObjC3KeyPathInfo(QualType Type, ObjC3KeyPathInfo &Info) {
+  const auto *RT = Type->getAs<RecordType>();
+  if (!RT)
+    return false;
+  RecordDecl *Record = RT->getDecl()->getDefinition();
+  if (!Record || !Record->isImplicit())
+    return false;
+  bool ReadOnly = false, Writable = false;
+  for (const auto *Attribute : Record->specific_attrs<AnnotateAttr>()) {
+    ReadOnly |= Attribute->getAnnotation() == "objc3.keypath.v2";
+    Writable |= Attribute->getAnnotation() == "objc3.keypath.v2.writable";
+  }
+  if ((!ReadOnly && !Writable) || ReadOnly == Writable ||
+      std::distance(Record->field_begin(), Record->field_end()) != 2)
+    return false;
+  auto Fields = Record->field_begin();
+  FieldDecl *First = *Fields++;
+  FieldDecl *Second = *Fields;
+  if (Writable) {
+    if (First->getName() != "__objc3_read" ||
+        Second->getName() != "__objc3_set" ||
+        !getObjC3KeyPathInfo(First->getType(), Info) || Info.Read)
+      return false;
+    Info.Read = First;
+    Info.Set = Second;
+  } else {
+    if (First->getName() != "__objc3_metadata" ||
+        Second->getName() != "__objc3_get" ||
+        !Second->getType()->isFunctionPointerType())
+      return false;
+    const auto *Function = Second->getType()->getPointeeType()
+                               ->getAs<FunctionProtoType>();
+    if (!Function || Function->getNumParams() != 1)
+      return false;
+    Info.Metadata = First;
+    Info.Get = Second;
+    Info.Root = Function->getParamType(0);
+    Info.Value = Function->getReturnType();
+  }
+  return true;
+}
+
+/// Effective native ownership includes method families under MRC, where ARC
+/// has not synthesized a returns-retained attribute. Explicit ownership wins.
+inline bool doesObjC3KeyPathGetterReturnRetained(const ObjCMethodDecl *Method) {
+  if (!Method)
+    return false;
+  if (Method->hasAttr<NSReturnsRetainedAttr>())
+    return true;
+  if (Method->hasAttr<NSReturnsNotRetainedAttr>() ||
+      Method->hasAttr<NSReturnsAutoreleasedAttr>())
+    return false;
+  switch (Method->getMethodFamily()) {
+  case OMF_alloc:
+  case OMF_copy:
+  case OMF_mutableCopy:
+  case OMF_new:
+  case OMF_init:
+    return true;
+  default:
+    return false;
+  }
+}
+
+enum class ObjC3KeyPathMemberKind { None, ReadOnly, Metadata, Get, Set };
+
+struct ObjC3KeyPathApplicationInfo {
+  unsigned Operation = 0; // Get, Set, Metadata, AsReadOnly, KVCString, in that order.
+  const CallExpr *Syntax = nullptr;
+};
+
+inline StringRef getObjC3KeyPathOperationName(unsigned Operation) {
+  switch (Operation) {
+  case 0: return "KeyPathGet";
+  case 1: return "KeyPathSet";
+  case 2: return "KeyPathMetadata";
+  case 3: return "KeyPathAsReadOnly";
+  case 4: return "KeyPathToKVCString";
+  default: return {};
+  }
+}
+
+/// The syntactic call retains the public operator token and written operands,
+/// in source order, over the complete invocation range. Semantic private field
+/// selections live separately and are never the editor's source selection.
+inline bool getObjC3KeyPathApplication(const PseudoObjectExpr *Expression,
+                                      ObjC3KeyPathApplicationInfo &Info) {
+  const auto *Syntax =
+      dyn_cast<CallExpr>(Expression->getSyntacticForm()->IgnoreParenImpCasts());
+  const auto *Reference = Syntax
+      ? dyn_cast<DeclRefExpr>(Syntax->getCallee()->IgnoreParenImpCasts())
+      : nullptr;
+  const auto *Function = Reference
+      ? dyn_cast<FunctionDecl>(Reference->getDecl()) : nullptr;
+  if (!Function || !Function->isImplicit())
+    return false;
+  bool Marked = false;
+  for (const auto *Attribute : Function->specific_attrs<AnnotateAttr>())
+    Marked |= Attribute->getAnnotation() == "objc3.keypath.application.v2";
+  if (!Marked)
+    return false;
+  for (unsigned Kind = 0; Kind != 5; ++Kind)
+    if (Function->getName() == getObjC3KeyPathOperationName(Kind)) {
+      const unsigned Count = Kind == 0 ? 2 : Kind == 1 ? 3 : 1;
+      if (Syntax->getNumArgs() != Count)
+        return false;
+      Info.Operation = Kind;
+      Info.Syntax = Syntax;
+      return true;
+    }
+  return false;
+}
+
+/// Recognize the semantic member selections used by application/narrowing.
+/// The printer uses this to retain public language spellings after native
+/// lowering and import, without exposing compiler-private field names.
+inline ObjC3KeyPathMemberKind
+getObjC3KeyPathMember(const MemberExpr *Member, const Expr *&Path) {
+  ObjC3KeyPathInfo Info;
+  if (!getObjC3KeyPathInfo(Member->getBase()->getType(), Info))
+    return ObjC3KeyPathMemberKind::None;
+  const ValueDecl *Declaration = Member->getMemberDecl();
+  ObjC3KeyPathMemberKind Kind = Declaration == Info.Read
+      ? ObjC3KeyPathMemberKind::ReadOnly
+      : Declaration == Info.Metadata ? ObjC3KeyPathMemberKind::Metadata
+      : Declaration == Info.Get ? ObjC3KeyPathMemberKind::Get
+      : Declaration == Info.Set ? ObjC3KeyPathMemberKind::Set
+                                : ObjC3KeyPathMemberKind::None;
+  if (Kind == ObjC3KeyPathMemberKind::None)
+    return Kind;
+  Path = Member->getBase();
+  if (Kind != ObjC3KeyPathMemberKind::ReadOnly)
+    if (const auto *Read =
+            dyn_cast<MemberExpr>(Path->IgnoreParenImpCasts())) {
+      ObjC3KeyPathInfo Source;
+      if (getObjC3KeyPathInfo(Read->getBase()->getType(), Source) &&
+          Source.Read == Read->getMemberDecl())
+        Path = Read->getBase();
+    }
+  return Kind;
+}
+
+/// Recover a literal's immutable descriptor path. This lets the native source
+/// interface printer retain @keypath syntax instead of exposing internal
+/// helper functions that are private to the producer image.
+inline const InitListExpr *
+getObjC3KeyPathLiteralDescriptor(const CompoundLiteralExpr *Literal) {
+  ObjC3KeyPathInfo Info;
+  if (!getObjC3KeyPathInfo(Literal->getType(), Info))
+    return nullptr;
+  const auto *List = dyn_cast<InitListExpr>(Literal->getInitializer());
+  if (!List || List->getNumInits() != 2)
+    return nullptr;
+  if (Info.Read) {
+    List = dyn_cast<InitListExpr>(List->getInit(0)->IgnoreParenImpCasts());
+    if (!List || List->getNumInits() != 2)
+      return nullptr;
+  }
+  const auto *Address = dyn_cast<UnaryOperator>(
+      List->getInit(0)->IgnoreParenImpCasts());
+  if (!Address || Address->getOpcode() != UO_AddrOf)
+    return nullptr;
+  const auto *Reference = dyn_cast<DeclRefExpr>(
+      Address->getSubExpr()->IgnoreParenImpCasts());
+  const auto *Variable = Reference ? dyn_cast<VarDecl>(Reference->getDecl())
+                                 : nullptr;
+  const auto *Descriptor = Variable && Variable->hasInit()
+      ? dyn_cast<InitListExpr>(Variable->getInit()->IgnoreParenImpCasts())
+      : nullptr;
+  if (!Variable || !Variable->isImplicit() || !Descriptor ||
+      Descriptor->getNumInits() != 7)
+    return nullptr;
+  return Descriptor;
+}
+
+inline const StringLiteral *
+getObjC3KeyPathLiteralPath(const CompoundLiteralExpr *Literal) {
+  const auto *Descriptor = getObjC3KeyPathLiteralDescriptor(Literal);
+  return Descriptor ? dyn_cast<StringLiteral>(
+                          Descriptor->getInit(5)->IgnoreParenImpCasts())
+                    : nullptr;
+}
+
+inline bool hasObjC3NullableKeyPathWrite(const CompoundLiteralExpr *Literal) {
+  const auto *Descriptor = getObjC3KeyPathLiteralDescriptor(Literal);
+  const auto *Flags = Descriptor
+                          ? dyn_cast<IntegerLiteral>(
+                                Descriptor->getInit(1)->IgnoreParenImpCasts())
+                          : nullptr;
+  return Flags && (Flags->getValue().getZExtValue() & 8u);
+}
+} // namespace clang
+#endif
