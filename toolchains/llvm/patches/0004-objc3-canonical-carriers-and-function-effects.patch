+
+// Different payloads/effect kinds and async state cannot merge as redeclarations.
+void changed_payload() __objc3_throws(E); // expected-note {{previous declaration is here}}
+void changed_payload() __objc3_throws(Other); // expected-error {{conflicting types for 'changed_payload'}}
+void typed_to_untyped() __objc3_throws(E); // expected-note {{previous declaration is here}}
