+           !Binary->isComparisonOp() && !Binary->isLogicalOp())) {
+        Value Result = value(Binary->getLHS(), State);
+        Result |= value(Binary->getRHS(), State);
+        return Result;
+      }
+      return empty(); // A comparison or copied character is owned scalar data.
+    }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(E)) {
+      if (Unary->getOpcode() == UO_AddrOf) {
+        const Expr *Operand = Unary->getSubExpr()->IgnoreParenImpCasts();
+        if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(Operand))
+          return value(Subscript->getBase(), State);
+        if (const auto *Member = dyn_cast<MemberExpr>(Operand))
+          if (Member->isArrow())
+            return value(Member->getBase(), State);
+        if (const auto *Deref = dyn_cast<UnaryOperator>(Operand))
+          if (Deref->getOpcode() == UO_Deref)
+            return value(Deref->getSubExpr(), State);
+        // Exposing &borrowedLocal also exposes the pointer stored there.
+        auto Found = Slots.find(storage(Operand, &State));
+        if (Found != Slots.end())
+          return State.Values[Found->second];
+        return empty();
+      }
+      if (Unary->isIncrementDecrementOp() ||
+          Unary->getOpcode() == UO_Plus || Unary->getOpcode() == UO_Minus ||
+          Unary->getOpcode() == UO_Not)
+        return value(Unary->getSubExpr(), State);
+    }
+    if (const auto *Optional = dyn_cast<ObjC3OptionalExpr>(E))
+      return Optional->getKind() == ObjC3OptionalExpr::Kind::Some
+                 ? value(Optional->getPayload(), State) : empty();
+    if (const auto *Result = dyn_cast<ObjC3ResultExpr>(E))
+      return Result->getKind() == ObjC3ResultExpr::Kind::IsOk
+                 ? empty() : value(Result->getPayload(), State);
+    if (const auto *Transfer = dyn_cast<ObjC3CarrierTransferExpr>(E))
+      return value(Transfer->getSource(), State);
+    if (const auto *Try = dyn_cast<ObjC3TryExpr>(E))
+      return value(Try->getOperand(), State);
+    if (const auto *Access = dyn_cast<ObjC3OptionalAccessExpr>(E))
+      return value(Access->getSemanticExpr(), State);
+    if (const auto *Coalesce = dyn_cast<ObjC3CoalesceExpr>(E))
+      return value(Coalesce->getSemanticExpr(), State);
+    if (const auto *Pseudo = dyn_cast<PseudoObjectExpr>(E)) {
+      ObjC3KeyPathApplicationInfo Application;
+      if (getObjC3KeyPathApplication(Pseudo, Application)) {
+        // Get copies the selected data. Set and narrowing have no loan result;
+        // their source operands are checked separately at application time.
+        if (Application.Operation != 0)
+          return empty();
+        Value Result = empty();
+        if (carriesBorrowedValue(E->getType()))
+          Result.set(0);
+        return Result;
+      }
+      if (const Expr *Result = Pseudo->getResultExpr())
+        return value(Result, State);
+    }
+    if (const auto *Match = dyn_cast<ObjC3MatchExpr>(E)) {
+      Value Result = empty();
+      for (unsigned I = 0; I != Match->getNumArms(); ++I)
+        Result |= value(dyn_cast<Expr>(Match->getArm(I)->getBody()), State);
+      return Result;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(E)) {
+      auto Snapshot = ClosureSlots.find(Block);
+      if (Snapshot != ClosureSlots.end() && State.CaptureReady.test(Snapshot->second))
+        return State.CapturedValues[Snapshot->second];
+      Value Result = futureOwnerLoans(Block, State);
+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        bool Found = false;
+        for (auto [Location, Index] : Slots)
+          if (Location.first == Capture.getVariable()) {
+            Result |= storedValue(Location, Capture.getVariable()->getType(), State);
+            Found = true;
+          }
+        if (!Found && isObjC3BorrowedType(Context, Capture.getVariable()->getType()))
+          Result.set(0);
+      }
+      return Result;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(E)) {
+      auto Snapshot = ClosureSlots.find(Lambda);
+      if (Snapshot != ClosureSlots.end() && State.CaptureReady.test(Snapshot->second))
+        return State.CapturedValues[Snapshot->second];
+      Value Result = futureOwnerLoans(Lambda, State);
+      for (const Expr *Initializer : Lambda->capture_inits())
+        Result |= value(Initializer, State);
+      return Result;
+    }
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
+      if (modeledRecordCopy(Construction->getConstructor()) &&
+          Construction->getNumArgs() == 1)
+        return value(Construction->getArg(0), State);
+    if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(E))
+      if (modeledRecordCopy(Operator->getDirectCallee()) && Operator->getNumArgs() == 2)
+        return value(Operator->getArg(1), State);
+    if (const auto *Initializer = dyn_cast<InitListExpr>(E)) {
+      Value Result = empty();
+      for (const Expr *Element : Initializer->inits())
+        Result |= value(Element, State);
+      return Result;
+    }
+    if (Acquisitions.count(E))
+      return acquired(E, State);
+    if (const auto *Call = dyn_cast<CallExpr>(E))
+      if (fillingBuiltin(Call->getDirectCallee()) && Call->getNumArgs() && Call->getType()->isPointerType())
+        return directFillDestination(Call->getArg(0)).first ? empty() : value(Call->getArg(0), State);
+    if (const auto *Call = dyn_cast<CallExpr>(E))
+      if (copyingBuiltin(Call->getDirectCallee()) && Call->getNumArgs()) {
+        StringRef Name = Call->getDirectCallee()->getName();
+        Name.consume_front("__builtin_");
+        if (Name == "memcpy" || Name == "memmove")
+          return value(Call->getArg(0), State);
+      }
+    Storage Resolved = storage(E, &State);
+    if (Slots.count(Resolved) ||
+        (Resolved.first && Resolved.Index >= 0 &&
+         Slots.count({Resolved.first, Resolved.second, -2, Resolved.Parent})))
+      return storedValue(Resolved, E->getType(), State);
+    // A declaration-provided borrowed type with no tracked local definition
+    // (e.g. a field, foreign function pointer, or imported declaration) cannot
+    // silently become unborrowed merely because its acquisition is opaque.
+    if (carriesBorrowedValue(E->getType())) {
+      Value Result = empty();
+      Result.set(0);
+      return Result;
+    }
+    return empty();
+  }
+  void diagnose(const Stmt *Operation, StringRef Description) {
+    if (IsOwnerSummary) {Invalid = true;return;}
+    if (!Diagnosed.insert(Operation).second)
+      return;
+    Actions.Diag(Operation->getBeginLoc(),
+                 Actions.getDiagnostics().getCustomDiagID(
+                     DiagnosticsEngine::Error,
+                     "borrowed pointer escapes through %0; extend owner lifetime with withLifetime/keepAlive, copy data to owned storage, or mark the operation explicitly unsafe"))
+        << Description;
+    Invalid = true;
+  }
+  void expire(const VarDecl *Owner, Facts &State) const {
+    auto ExpireValue = [&](Value &V) {
+      for (unsigned I = 0; I != Origins.size(); ++I) {
+        const Origin &O = Origins[I];
+        if (O.HeldByClosure)
+          continue;
+        if ((O.Pin ? O.Pin == Owner : O.Owner == Owner) && V.test(I * 2)) {
+          unsigned Replacement = Origins.size();
+          auto Acquisition = Acquisitions.find(O.Acquisition);
+          if (Acquisition != Acquisitions.end())
+            for (unsigned Candidate : Acquisition->second) {
+              const Origin &Alternative = Origins[Candidate];
+              if (Alternative.Identity != O.Identity || Alternative.Owner != O.Owner)
+                continue;
+              if (!O.Pin && Alternative.Pin && Alternative.Pin != Owner &&
+                  matchesPin(O, Alternative.Pin, State)) {
+                Replacement = Candidate;
+                break;
+              }
+              if (O.Pin && !Alternative.Pin && !Alternative.Unstable &&
+                  Alternative.Owner && Alternative.Owner != Owner) {
+                auto Source = Slots.find({Alternative.Owner, nullptr});
+                if (Source == Slots.end() || State.UnownedOwners.test(Source->second))
+                  continue;
+                const Value &Identities = State.OwnerIdentities[Source->second];
+                if (Identities.test(OwnerRoots.lookup(O.Identity)) &&
+                    ((O.Identity && Identities.count() == 1) ||
+                     (PinSources.lookup(O.Pin) == O.Owner &&
+                      State.SamePins.test(Pins.lookup(O.Pin))))) {
+                  Replacement = Candidate;
+                  break;
+                }
+              }
+            }
+          V.reset(I * 2);
+          if (Replacement != Origins.size())
+            V.set(Replacement * 2);
+          else
+            V.set(I * 2 + 1);
+        }
+      }
+    };
+    for (Value &V : State.Values)
+      ExpireValue(V);
+    for (Value &V : State.CapturedValues)
+      ExpireValue(V);
+    for (Value &V : State.EvaluatedValues)
+      ExpireValue(V);
+    for (Value &V : State.EvaluatedAcquisitions)
+      ExpireValue(V);
+    if (auto Slot = Slots.find({Owner, nullptr}); Slot != Slots.end())
+      State.OwnerIdentities[Slot->second].reset();
+    for (auto [Pin, Source] : PinSources)
+      if (Source == Owner)
+        State.SamePins.reset(Pins.lookup(Pin));
+    if (auto Found = Pins.find(Owner); Found != Pins.end()) {
+      State.ActivePins.reset(Found->second);
+      State.SamePins.reset(Found->second);
+    }
+  }
+  const FunctionProtoType *callPrototype(const Expr *Invocation) const {
+    const auto *Call = dyn_cast<CallExpr>(Invocation);
+    if (!Call) return nullptr;
+    QualType Type = Call->getCallee()->getType();
+    if (Type->isPointerType() || Type->isBlockPointerType())
+      Type = Type->getPointeeType();
+    else if (Type->isSpecificPlaceholderType(BuiltinType::BoundMember)) {
+      const Expr *Bound = Call->getCallee()->IgnoreParens();
+      if (!isa<MemberExpr>(Bound) && !isa<BinaryOperator>(Bound)) return nullptr;
+      Type = Expr::findBoundMemberType(Bound);
+    }
+    return Type.isNull() ? nullptr : Type->getAs<FunctionProtoType>();
+  }
+  bool observeOwnerConsumption(const Expr *Invocation, Facts &State) const {
+    const bool ARC = Actions.getLangOpts().ObjCAutoRefCount;
+    Value Identity(OwnerRoots.size());
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation); Message && !ARC) {
+      const auto *Method = Message->getMethodDecl();
+      if ((!Method || !Method->isClassMethod()) &&
+          (Message->getMethodFamily() == OMF_release ||
+           (Method && Method->hasAttr<NSConsumesSelfAttr>()))) {
+        Identity |= evaluatedOwnerIdentity(Message->getInstanceReceiver(), State);
+        if (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance)
+          for (const Decl *Scope = Callable; Scope;
+               Scope = Scope->getDeclContext()
+                           ? Decl::castFromDeclContext(Scope->getDeclContext()) : nullptr)
+            if (const auto *Current = dyn_cast<ObjCMethodDecl>(Scope)) {
+              if (auto Slot = Slots.find({Current->getSelfDecl(), nullptr}); Slot != Slots.end())
+                Identity |= State.OwnerIdentities[Slot->second];
+              break;
+            }
+      }
+    }
+    if (const auto *Function = dyn_cast_or_null<FunctionDecl>(callee(Invocation)))
+      if (const auto *Operation = getObjC3FamilyOperation(Function);
+          Operation && isa<ObjCFamilyReleaseAttr>(Operation))
+        Identity |= evaluatedOwnerIdentity(argument(Invocation, 0), State);
+    const auto Formals = formalParameters(callee(Invocation));
+    unsigned Count = 0;
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) Count = Call->getNumArgs();
+    else if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation)) Count = Message->getNumArgs();
+    else if (const auto *Construction = dyn_cast<CXXConstructExpr>(Invocation)) Count = Construction->getNumArgs();
+    const FunctionProtoType *Prototype = callPrototype(Invocation);
+    for (unsigned I = 0; I != Count; ++I) {
+      const unsigned Formal = formalIndex(Invocation, I);
+      bool Consumed = false;
+      if (Formal < Formals.size()) {
+        const auto *Parameter = Formals[Formal];
+        Consumed = Parameter->hasAttr<CFConsumedAttr>() ||
+            (!ARC && Parameter->hasAttr<NSConsumedAttr>() &&
+             Parameter->getType()->isObjCRetainableType());
+      }
+      if (Prototype && Formal < Prototype->getNumParams())
+        Consumed |= Prototype->getExtParameterInfo(Formal).isCFConsumed() ||
+            (!ARC && Prototype->isParamConsumed(Formal) &&
+             Prototype->getParamType(Formal)->isObjCRetainableType());
+      if (Consumed) Identity |= evaluatedOwnerIdentity(argument(Invocation, I), State);
+    }
+    auto AddEffects = [&](const Value &Effects) {
+      for (int Bit = Effects.find_first(); Bit >= 0; Bit = Effects.find_next(Bit)) {
+        const Origin &O = Origins[Bit / 2];
+        if (O.SymbolicCallable) {
+          if (O.Identity) InvokedCallableCaptures.insert(O.Identity);
+          if (!llvm::is_contained(InvokedCallableTokens, unsigned(Bit / 2)))
+            InvokedCallableTokens.push_back(Bit / 2);
+        } else if (O.Identity && OwnerRoots.count(O.Identity)) {
+          Identity.set(OwnerRoots.lookup(O.Identity));
+        }
+      }
+    };
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) {
+      AddEffects(effects(Call->getCallee(), State));
+      if (const auto *Member = dyn_cast<CXXMemberCallExpr>(Call))
+        AddEffects(effects(Member->getImplicitObjectArgument(), State));
+    }
+    if (!modeledRecordCopy(callee(Invocation)) &&
+        !copyingBuiltin(dyn_cast_or_null<FunctionDecl>(callee(Invocation))) &&
+        !fillingBuiltin(dyn_cast_or_null<FunctionDecl>(callee(Invocation))))
+      for (unsigned I = 0; I != Count; ++I)
+        if (safeParameter(Invocation, I)) AddEffects(effects(argument(Invocation, I), State));
+    if (IsOwnerSummary)
+      for (const auto &[Root, Index] : OwnerRoots)
+        if (Root && Identity.test(Index)) ConsumedOwnerRoots.insert(Root);
+    if (Identity.none()) return false;
+    SmallVector<std::pair<const VarDecl *, Value>, 8> Aliases;
+    for (const auto &[Owner, Root] : OwnerRoots) {
+      (void)Root;
+      if (!Owner || Pins.count(Owner)) continue;
+      auto Slot = Slots.find({Owner, nullptr});
+      if (Slot != Slots.end() && State.OwnerIdentities[Slot->second].anyCommon(Identity))
+        Aliases.emplace_back(Owner, State.OwnerIdentities[Slot->second]);
+    }
+    const Value SamePins = State.SamePins;
+    for (const auto &[Owner, PreviousIdentity] : Aliases) {
+      expire(Owner, State);
+      const unsigned Slot = Slots.lookup({Owner, nullptr});
+      // release consumes the ownership claim without changing pointer bits.
+      // Retain identity for aliases and preexisting independent lifetime pins.
+      State.OwnerIdentities[Slot] = PreviousIdentity;
+      State.UnownedOwners.set(Slot);
+    }
+    State.SamePins = SamePins;
+    return !Aliases.empty();
+  }
+  void store(const Stmt *Operation, Storage Destination, const Value &V,
+             Facts &State, bool Emit, bool Replace = false,
+             const Value *Effects = nullptr) {
+    if (IsOwnerSummary && SummaryCaptures.count(Destination.first))
+      MutatedCaptures.insert(Destination.first);
+    if (V.any() && Emit) {
+      if (InheritedLambdaStorage.count(Destination.first))
+        diagnose(Operation, "persistent storage in a C++ lambda capture");
+      bool ReferenceCaptured = InheritedReferenceCaptures.count(Destination.first);
+      // A capture on any incoming path can already have escaped. Snapshot
+      // readiness is a must fact; reference hazards deliberately use may facts.
+      for (const Value &Targets : State.CapturedReferenceTargets)
+        for (int Target = Targets.find_first(); Target >= 0;
+             Target = Targets.find_next(Target))
+          ReferenceCaptured |= location(Target).first == Destination.first;
+      if (ReferenceCaptured)
+        diagnose(Operation, "mutation of storage captured by reference by a C++ lambda");
+      if (!Destination.first || !Destination.first->hasLocalStorage())
+        diagnose(Operation, Destination.first ? "global/static/thread-local storage"
+                                               : "heap, ivar, property, or indirect storage");
+      else if (hasExpired(V))
+        diagnose(Operation, "storage of a value whose owner lifetime has ended");
+    }
+    auto Found = Slots.find(Destination);
+    if (Found == Slots.end() && Destination.first && Destination.Index >= 0) {
+      Destination.Index = -2;
+      Found = Slots.find(Destination);
+    }
+    if (Found != Slots.end()) {
+      if (!Replace && hasUnknownIndex(Destination))
+        State.Values[Found->second] |= V;
+      else
+        State.Values[Found->second] = V;
+      if (Effects) {
+        if (!Replace && hasUnknownIndex(Destination)) State.Effects[Found->second] |= *Effects;
+        else State.Effects[Found->second] = *Effects;
+      }
+    }
+  }
+  Storage rebase(Storage Location, Storage From, Storage To) const {
+    if (Location.first != From.first)
+      return {};
+    unsigned Prefix = path(From), Current = path(Location);
+    SmallVector<unsigned, 8> Suffix;
+    while (Current && Current != Prefix) {
+      Suffix.push_back(Current);
+      Current = Paths[Current].Parent;
+    }
+    if (Current != Prefix)
+      return {};
+    for (unsigned I : llvm::reverse(Suffix)) {
+      // Interner insertion can reallocate Paths, so copy the selector first.
+      PathNode Node = Paths[I];
+      To = Node.Field ? fieldStorage(To, Node.Field)
+                      : indexedStorage(To, Node.Index);
+    }
+    return To;
+  }
+  void copyStorageShape(const Stmt *Operation, Storage Destination,
+                         Storage Source, Facts &State, bool Emit) {
+    struct Copy { Storage Destination; Value Contents; Storage Target; Value Targets; Value Effects; };
+    SmallVector<Copy, 16> Copies;
+    for (auto [Location, Index] : Slots) {
+      Storage Target = rebase(Location, Source, Destination);
+      if (Target.first && Slots.count(Target))
+        Copies.push_back({Target, State.Values[Index], State.LocalTargets[Index], State.MayTargets[Index], State.Effects[Index]});
+    }
+    for (Copy &Entry : Copies) {
+      store(Operation, Entry.Destination, Entry.Contents, State, Emit,
+            !hasUnknownIndex(Destination), &Entry.Effects);
+      State.LocalTargets[Slots.lookup(Entry.Destination)] = Entry.Target;
+      State.MayTargets[Slots.lookup(Entry.Destination)] = std::move(Entry.Targets);
+    }
+  }
+  void initializeAggregate(const Stmt *Operation, Storage Destination,
+                            QualType Type, const Expr *Initializer,
+                            Facts &State, bool Emit, unsigned Depth = 0) {
+    if (Depth > 32 || !Destination.first)
+      return;
+    if (!Type->isRecordType() && !Type->isArrayType()) {
+      Value V = value(Initializer, State);
+      Storage Target = referent(Initializer, &State);
+      Value Targets = possibleTargets(Initializer, State);
+      if (Targets.any() && !hasUnknownIndex(Destination) &&
+          !isObjC3BorrowedType(Context, Type))
+        V = empty();
+      Value Effects = effects(Initializer, State);
+      if (Targets.any() && !isObjC3BorrowedType(Context, Type)) Effects = empty();
+      store(Operation, Destination, V, State, Emit, false, &Effects);
+      if (auto Found = Slots.find(Destination); Found != Slots.end()) {
+        State.LocalTargets[Found->second] = Target;
+        if (hasUnknownIndex(Destination))
+          State.MayTargets[Found->second] |= Targets;
+        else
+          State.MayTargets[Found->second] = std::move(Targets);
+      }
+      return;
+    }
+    const Expr *Written = Initializer ? Initializer->IgnoreParenCasts() : nullptr;
+    if (const auto *Construction = dyn_cast_or_null<CXXConstructExpr>(Written))
+      if (modeledRecordCopy(Construction->getConstructor()) &&
+          Construction->getNumArgs() == 1) {
+        initializeAggregate(Operation, Destination, Type, Construction->getArg(0),
+                            State, Emit, Depth + 1);
+        return;
+      }
+    if (const auto *Cleanups = dyn_cast_or_null<ExprWithCleanups>(Written))
+      Written = Cleanups->getSubExpr()->IgnoreParenCasts();
+    const auto *List = dyn_cast_or_null<InitListExpr>(Written);
+    if (List && List->getSemanticForm())
+      List = List->getSemanticForm();
+    Storage Source = storage(Written, &State);
+    if (!List && Source.first) {
+      copyStorageShape(Operation, Destination, Source, State, Emit);
+      return;
+    }
+    if (const auto *Record = Type->getAs<RecordType>()) {
+      unsigned I = 0;
+      for (const FieldDecl *Field : Record->getDecl()->fields()) {
+        const Expr *FieldInit = List && I < List->getNumInits()
+                                    ? List->getInit(I) : nullptr;
+        initializeAggregate(Operation, fieldStorage(Destination, Field),
+                            Field->getType(), FieldInit, State, Emit, Depth + 1);
+        ++I;
+      }
+    } else if (const auto *Array = Context.getAsArrayType(Type)) {
+      unsigned Prefix = path(Destination);
+      SmallVector<Storage, 16> Elements;
+      for (auto [Location, Index] : Slots) {
+        (void)Index;
+        if (Location.first == Destination.first && Location.Parent == Prefix &&
+            !Location.second && Location.Index != -1)
+          Elements.push_back(Location);
+      }
+      if (List && !hasUnknownIndex(Destination))
+        for (Storage Element : Elements)
+          if (Element.Index == -2)
+            for (const auto &[Location, Index] : Slots) {
+              if (Location.first != Element.first) continue;
+              unsigned Current = path(Location), Prefix = path(Element);
+              while (Current && Current != Prefix) Current = Paths[Current].Parent;
+              if (Current != Prefix) continue;
+              Value Cleared = empty();
+              store(Operation, Location, Cleared, State, Emit, true, &Cleared);
+              State.LocalTargets[Index] = {};State.MayTargets[Index].reset();
+            }
+      for (Storage Element : Elements) {
+        if (List && Element.Index == -2) {
+          // Preserve initializer effects outside the eager/observed element
+          // paths. A wildcard may alias any later index; dropping these leaves
+          // loses callbacks captured by a larger array.
+          for (unsigned I = 0; I != List->getNumInits(); ++I) {
+            bool Tracked = llvm::any_of(Elements, [I](Storage Other) {
+              return Other.Index >= 0 && uint64_t(Other.Index) == I;
+            });
+            if (!Tracked)
+              initializeAggregate(Operation, Element, Array->getElementType(),
+                                  List->getInit(I), State, Emit, Depth + 1);
+          }
+          // The summary is a set of possible addresses, never the final
+          // initializer's single referent.
+          for (const auto &[Location, Index] : Slots) {
+            if (Location.first != Element.first) continue;
+            unsigned Current = path(Location), Prefix = path(Element);
+            while (Current && Current != Prefix) Current = Paths[Current].Parent;
+            if (Current == Prefix) State.LocalTargets[Index] = {};
+          }
+          continue;
+        }
+        const Expr *ElementInit = List && Element.Index >= 0 &&
+                                         static_cast<uint64_t>(Element.Index) < List->getNumInits()
+                                      ? List->getInit(Element.Index) : nullptr;
+        initializeAggregate(Operation, Element, Array->getElementType(),
+                            ElementInit, State, Emit, Depth + 1);
+      }
+    }
+    // Exact aggregate initialization derives contents from individual paths.
+    // Opaque payload copies retain a conservative aggregate summary instead.
+    Value Summary = !List && Written ? value(Written, State) : empty();
+    if (const auto *Record = Type->getAs<RecordType>())
+      if (Record->getDecl()->isUnion())
+        Summary |= contents(Destination, Type, State);
+    Value EffectSummary = !List && Written ? effects(Written, State) : empty();
+    if (const auto *Record = Type->getAs<RecordType>())
+      if (Record->getDecl()->isUnion()) EffectSummary |= contents(Destination, Type, State, true);
+    store(Operation, Destination, Summary, State, Emit, false, &EffectSummary);
+  }
+  void initializeRecord(const Stmt *Operation, const VarDecl *Destination,
+                        const Expr *Initializer, Facts &State, bool Emit) {
+    if (Destination->getType()->isRecordType() && Initializer)
+      initializeAggregate(Operation, {Destination, nullptr}, Destination->getType(),
+                          Initializer, State, Emit);
+  }
+  void initializeArray(const Stmt *Operation, const VarDecl *Destination,
+                       const Expr *Initializer, Facts &State, bool Emit) {
+    if (Destination->getType()->isArrayType() && Initializer)
+      initializeAggregate(Operation, {Destination, nullptr}, Destination->getType(),
+                          Initializer, State, Emit);
+  }
+  Storage directLocalStorage(const Expr *E) const {
+    if (!E) return {};
+    E = E->IgnoreParenCasts();
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(E))
+      if (const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl());
+          Variable && Variable->hasLocalStorage() && !Variable->getType()->isReferenceType())
+        return {Variable, nullptr};
+    if (const auto *Member = dyn_cast<MemberExpr>(E))
+      if (!Member->isArrow() && isa<FieldDecl>(Member->getMemberDecl()))
+        return fieldStorage(directLocalStorage(Member->getBase()), Member->getMemberDecl());
+    if (const auto *Element = dyn_cast<ArraySubscriptExpr>(E)) {
+      const Expr *Base = Element->getBase()->IgnoreParenCasts();
+      auto Index = Element->getIdx()->getIntegerConstantExpr(Context);
+      if (Base->getType()->isArrayType() && Index && !Index->isNegative() && Index->getActiveBits() <= 63)
+        return indexedStorage(directLocalStorage(Base), Index->getZExtValue());
+    }
+    return {};
+  }
+  Storage directFillDestination(const Expr *Pointer) const {
+    if (!Pointer) return {};
+    Pointer = Pointer->IgnoreParenCasts();
+    if (const auto *Address = dyn_cast<UnaryOperator>(Pointer))
+      if (Address->getOpcode() == UO_AddrOf) return directLocalStorage(Address->getSubExpr());
+    if (Pointer->getType()->isArrayType()) return indexedStorage(directLocalStorage(Pointer), 0);
+    return {};
+  }
+  bool fillingBuiltin(const FunctionDecl *Function) const {
+    if (!Function || !Function->getBuiltinID()) return false;
+    StringRef Name = Function->getName();Name.consume_front("__builtin_");
+    return Name == "memset" || Name == "memset_inline" ||
+           Name == "__memset_chk" || Name == "bzero";
+  }
+  void fillRepresentation(const CallExpr *Call, Facts &State, bool Emit) {
+    StringRef Name = Call->getDirectCallee()->getName();Name.consume_front("__builtin_");
+    unsigned AmountIndex = Name == "bzero" ? 1 : 2;
+    if (Call->getNumArgs() <= AmountIndex) return;
+    auto Amount = Call->getArg(AmountIndex)->getIntegerConstantExpr(Context);
+    if (!Amount || Amount->isNegative() || Amount->getActiveBits() > 64 || Amount->isZero()) return;
+    Storage Destination = directFillDestination(Call->getArg(0));
+    if (!Destination.first || hasUnknownIndex(Destination)) return;
+    auto HasExactSize = [&](Storage Location) {
+      QualType Type = storageType(Location);
+      return !Type.isNull() && !Type->isIncompleteType() && !Type->isVariablyModifiedType() &&
+          Amount->getZExtValue() == uint64_t(Context.getTypeSizeInChars(Type).getQuantity());
+    };
+    // Array decay and &array[0] can denote the complete array, including a
+    // nested array field. Other element addresses clear only that element.
+    if (Destination.Index == 0) {
+      Storage Array = Destination;Array.Index = -1;
+      QualType Type = storageType(Array);
+      if (!Type.isNull() && Type->isArrayType() && HasExactSize(Array)) Destination = Array;
+    }
+    if (!HasExactSize(Destination)) return;
+    Value Cleared = empty();
+    for (const auto &[Location, Index] : Slots) {
+      if (Location.first != Destination.first) continue;
+      unsigned Current = path(Location), Prefix = path(Destination);
+      while (Current && Current != Prefix) Current = Paths[Current].Parent;
+      // A wildcard array summary also describes untouched siblings. Only an
+      // exact path prefix can justify discarding its provenance.
+      if (Current != Prefix) continue;
+      store(Call, Location, Cleared, State, Emit, true, &Cleared);
+      State.LocalTargets[Index] = {};State.MayTargets[Index].reset();
+    }
+    if (!path(Destination) && OwnerRoots.count(Destination.first)) {
+      if (IsOwnerSummary && SummaryCaptures.count(Destination.first))
+        ConsumedOwnerRoots.insert(Destination.first);
+      expire(Destination.first, State);
+      State.UnownedOwners.set(Slots.lookup({Destination.first, nullptr}));
+    }
+  }
+  Storage pointedStorage(const Expr *Pointer, const Facts &State) const {
+    return referent(Pointer, &State);
+  }
+  void copyRepresentation(const CallExpr *Call, Facts &State, bool Emit) {
+    Storage Source = pointedStorage(Call->getArg(1), State);
+    Storage Destination = pointedStorage(Call->getArg(0), State);
+    auto Amount = Call->getArg(2)->getIntegerConstantExpr(Context);
+    if (Amount && Amount->isZero())
+      return; // No pointer representation is exposed by a zero-byte copy.
+    Value Payload = exposedValue(Source, State);
+    Value EffectPayload = contents(Source, storageType(Source), State, true);
+    if (!Source.first) {
+      // Copying characters from the borrowed region is owned data. The
+      // pointer itself is checked independently as an ordinary noescape arg.
+      return;
+    }
+    bool Whole = Destination.first && !Source.second && !Destination.second &&
+                 !Source.Parent && !Destination.Parent &&
+                 (Source.Index == -1 || Source.Index == 0) &&
+                 (Destination.Index == -1 || Destination.Index == 0) &&
+                 Context.hasSameType(Source.first->getType(),
+                                     Destination.first->getType()) &&
+                 Amount && !Amount->isNegative() && Amount->getActiveBits() <= 64 &&
+                 !Source.first->getType()->isIncompleteType() &&
+                 !Source.first->getType()->isVariableArrayType() &&
+                 Amount->getZExtValue() == static_cast<uint64_t>(
+                     Context.getTypeSizeInChars(Source.first->getType()).getQuantity());
+    if (Whole) {
+      // Diagnose exposed address payloads even if their direct slot is empty.
+      if (Emit && Payload.any() && !Destination.first->hasLocalStorage())
+        diagnose(Call, "global/static/thread-local storage through a representation copy");
+      copyStorageShape(Call, {Destination.first, nullptr}, {Source.first, nullptr},
+                       State, Emit);
+      return;
+    }
+    // Unknown/partial copies weakly update local contents. Retaining previous
+    // facts avoids claiming that untouched pointer fields were overwritten.
+    if (auto Existing = Slots.find(Destination); Existing != Slots.end()) {
+      Payload |= State.Values[Existing->second];
+      EffectPayload |= State.Effects[Existing->second];
+    }
+    if (Payload.any() || EffectPayload.any()) {
+      store(Call, Destination, Payload, State, Emit, false, &EffectPayload);
+      QualType DestinationType = storageType(Destination);
+      if (!DestinationType.isNull() &&
+          (DestinationType->isRecordType() || DestinationType->isArrayType()))
+        for (auto [Location, Index] : Slots)
+          if (within(Location, Destination)) {
+            QualType Leaf = storageType(Location);
+            if (!Leaf.isNull() && !Leaf->isRecordType() && !Leaf->isArrayType()) {
+              Value Contents = State.Values[Index];
+              Contents |= Payload;
+              Value Effects = State.Effects[Index]; Effects |= EffectPayload;
+              store(Call, Location, Contents, State, Emit, false, &Effects);
+            }
+          }
+    }
+  }
+  bool copyingBuiltin(const FunctionDecl *Function) const {
+    if (!Function || !Function->getBuiltinID())
+      return false;
+    StringRef Name = Function->getName();
+    Name.consume_front("__builtin_");
+    return Name == "memcpy" || Name == "memmove" || Name == "memcmp" ||
+           Name == "bcmp" || Name == "strlen" || Name == "strnlen";
+  }
+  ArrayRef<ParmVarDecl *> formalParameters(const Decl *Callee) const {
+    if (const auto *Function = dyn_cast_or_null<FunctionDecl>(Callee))
+      return Function->parameters();
+    if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Callee))
+      return Method->parameters();
+    return {};
+  }
+  unsigned formalIndex(const Expr *Call, unsigned Index) const {
+    if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(Call))
+      if (const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Operator->getDirectCallee()))
+        if (!Method->isStatic())
+          return Index ? Index - 1 : ~0U;
+    return Index;
+  }
+  Value addressValue(const Expr *E, const Facts &State) const {
+    if (!E)
+      return empty();
+    E = E->IgnoreParenImpCasts();
+    if (const auto *Deref = dyn_cast<UnaryOperator>(E))
+      if (Deref->getOpcode() == UO_Deref)
+        return value(Deref->getSubExpr(), State);
+    if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(E))
+      return value(Subscript->getBase(), State);
+    if (const auto *Member = dyn_cast<MemberExpr>(E))
+      return Member->isArrow() ? value(Member->getBase(), State)
+                               : addressValue(Member->getBase(), State);
+    return value(E, State);
+  }
+  bool modeledRecordCopy(const Decl *Declaration) const {
+    const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Declaration);
+    if (!Method || !Method->isCopyOrMoveConstructorOrAssignment()) return false;
+    if (Method->isTrivial()) return true;
+    // ARC makes otherwise structural record copies nontrivial. Only compiler
+    // generated operations over scalar/array/structural fields qualify: an
+    // arbitrary user copy body must still supply a lifetime contract.
+    if (!Actions.getLangOpts().ObjCAutoRefCount || !Method->isImplicit()) return false;
+    SmallVector<const CXXRecordDecl *, 8> Pending{Method->getParent()};
+    llvm::SmallPtrSet<const CXXRecordDecl *, 8> Seen;
+    while (!Pending.empty()) {
+      const auto *Record = Pending.pop_back_val();
+      if (!Seen.insert(Record).second) continue;
+      if (Record->getNumBases() || Record->isPolymorphic() ||
+          (Record->isUnion() && !Record->isTriviallyCopyable())) return false;
+      for (const auto *Member : Record->methods())
+        if (Member->isCopyOrMoveConstructorOrAssignment() &&
+            !Member->isTrivial() && !Member->isImplicit()) return false;
+      for (const FieldDecl *Field : Record->fields()) {
+        QualType Type = Context.getBaseElementType(Field->getType());
+        if (const auto *Nested = Type->getAsCXXRecordDecl()) Pending.push_back(Nested);
+      }
+    }
+    return true;
+  }
+  bool lambdaInvocation(const Decl *Callee) const {
+    const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Callee);
+    return Method && Method->getParent()->isLambda() &&
+           Method->getOverloadedOperator() == OO_Call;
+  }
+  bool safeParameter(const Expr *Call, unsigned Index) const {
+    const Decl *Callee = callee(Call);
+    if ((getObjC3TaskBoundaryKind(Callee) & 3) ||
+        isObjC3ActorIsolated(Callee) || getObjC3Executor(Callee))
+      return false;
+    if (modeledRecordCopy(Callee))
+      return true;
+    Index = formalIndex(Call, Index);
+    if (Index == ~0U && lambdaInvocation(Callee))
+      return true; // The captured body is checked with its creation facts.
+    auto Formals = formalParameters(Callee);
+    if (Index < Formals.size()) {
+      const ParmVarDecl *Formal = Formals[Index];
+      if (Formal->hasAttr<NoEscapeAttr>() ||
+          isObjC3BorrowedType(Context, Formal->getType().getNonReferenceType()))
+        return true;
+    }
+    if (const auto *Function = dyn_cast_or_null<FunctionDecl>(Callee)) {
+      if (copyingBuiltin(Function)) return true;
+      if (fillingBuiltin(Function)) return Index == 0;
+    }
+    if (const auto *Prototype = callPrototype(Call))
+      if (Index < Prototype->getNumParams())
+        return Prototype->getExtParameterInfo(Index).isNoEscape() ||
+               isObjC3BorrowedType(Context, Prototype->getParamType(Index).getNonReferenceType());
+    return false;
+  }
+  bool validReturn(const Value &V) const {
+    if (!ReturnContract || !isObjC3BorrowedType(Context, ReturnType) ||
+        ReturnContract->getOwnerIndex() >= Parameters.size() || hasExpired(V))
+      return false;
+    const ParmVarDecl *Owner = Parameters[ReturnContract->getOwnerIndex()];
+    for (int Bit = V.find_first(); Bit >= 0; Bit = V.find_next(Bit))
+      if (Origins[Bit / 2].Identity != Owner)
+        return false;
+    return true;
+  }
+  void checkCall(const Expr *Invocation, Facts &State, bool Emit) {
+    unsigned Count = 0;
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation))
+      Count = Call->getNumArgs();
+    else if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation))
+      Count = Message->getNumArgs();
+    else if (const auto *Construction = dyn_cast<CXXConstructExpr>(Invocation))
+      Count = Construction->getNumArgs();
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) {
+      const FunctionDecl *Function = Call->getDirectCallee();
+      if (fillingBuiltin(Function)) fillRepresentation(Call, State, Emit);
+      if (copyingBuiltin(Function) && Count >= 3) {
+        StringRef Name = Function->getName();
+        Name.consume_front("__builtin_");
+        if (Name == "memcpy" || Name == "memmove") {
+          copyRepresentation(Call, State, Emit);
+        }
+      }
+    }
+    if (IsOwnerSummary) {
+      const auto Formals = formalParameters(callee(Invocation));
+      const FunctionProtoType *Prototype = callPrototype(Invocation);
+      for (unsigned I = 0; I != Count; ++I) {
+        unsigned Formal = formalIndex(Invocation, I);
+        QualType Type;
+        if (Formal < Formals.size()) Type = Formals[Formal]->getType();
+        else if (Prototype && Formal < Prototype->getNumParams()) Type = Prototype->getParamType(Formal);
+        const auto *Function = dyn_cast_or_null<FunctionDecl>(callee(Invocation));
+        bool AddressBuiltin = Function && Function->getBuiltinID() && Function->getName() == "__builtin_addressof";
+        if ((!Type.isNull() && Type->isReferenceType() && !Type->getPointeeType().isConstQualified()) || AddressBuiltin) {
+          Storage Target = storage(argument(Invocation, I), &State);
+          if (SummaryCaptures.count(Target.first)) MutatedCaptures.insert(Target.first);
+        }
+      }
+    }
+    if (Emit) {
+      if (!Actions.getLangOpts().ObjCAutoRefCount)
+        if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation);
+            Message && Message->getReceiverKind() == ObjCMessageExpr::SuperInstance &&
+            Message->getMethodDecl() && Message->getMethodDecl()->hasAttr<NSConsumesSelfAttr>())
+          for (const Expr *Argument : Message->arguments())
+            if (Argument->HasSideEffects(Context)) {
+              diagnose(Message, "super receiver consumption with side-effecting arguments; bind arguments first");
+              break;
+            }
+      const Expr *Receiver = nullptr;
+      if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation))
+        Receiver = Message->getInstanceReceiver();
+      if (const auto *MemberCall = dyn_cast<CXXMemberCallExpr>(Invocation))
+        Receiver = MemberCall->getImplicitObjectArgument();
+      const bool LambdaCall = lambdaInvocation(callee(Invocation));
+      if (Receiver && LambdaCall && hasExpired(addressValue(Receiver, State)))
+        diagnose(Receiver, "invocation of a C++ lambda after its captured owner lifetime ended");
+      else if (Receiver && !LambdaCall && !modeledRecordCopy(callee(Invocation)) &&
+               addressValue(Receiver, State).any())
+        diagnose(Receiver, "a receiver without a non-escaping lifetime contract");
+    }
+    if (Emit)
+      if (const auto *Call = dyn_cast<CallExpr>(Invocation))
+        if (!lambdaInvocation(callee(Invocation)) && hasExpired(value(Call->getCallee(), State)))
+          diagnose(Invocation, "invocation of a block after its captured owner lifetime ended");
+    if (Emit)
+      for (unsigned I = 0; I != Count; ++I) {
+        const Expr *Argument = argument(Invocation, I);
+        Value V = value(Argument, State);
+        if (I == 0 && fillingBuiltin(dyn_cast_or_null<FunctionDecl>(callee(Invocation))) &&
+            directFillDestination(Argument).first) V = empty();
+        unsigned FormalIndex = formalIndex(Invocation, I);
+        auto Formals = formalParameters(callee(Invocation));
+        if ((FormalIndex < Formals.size() &&
+             Formals[FormalIndex]->getType()->isReferenceType()) ||
+            FormalIndex == ~0U)
+          V |= addressValue(Argument, State);
+        if (!V.any())
+          continue;
+        if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(callee(Invocation));
+            Method && Method->isPropertyAccessor() && Count == 1) {
+          diagnose(Argument, "Objective-C property storage");
+          continue;
+        }
+        if (hasExpired(V))
+          diagnose(Argument, "call using a value after its owner lifetime ended");
+        else if (!safeParameter(Invocation, I))
+          diagnose(Argument, Argument->getType()->isBlockPointerType()
+                                 ? "an escaping block argument"
+                                 : "an argument without a non-escaping lifetime contract");
+      }
+    if (Emit)
+      if (const auto *Function = dyn_cast_or_null<FunctionDecl>(callee(Invocation)))
+        if (const auto *Operation = getObjC3FamilyOperation(Function);
+            Operation && !isa<ObjCFamilyReleaseAttr>(Operation) &&
+            ownerIsUnowned(argument(Invocation, 0), State))
+          diagnose(Invocation, "a retainable family operation after owner release");
+    if (Emit) {
+      auto Found = Acquisitions.find(Invocation);
+      if (Found != Acquisitions.end()) {
+        Value V = acquired(Invocation, State);
+        for (int Bit = V.find_first(); Bit >= 0; Bit = V.find_next(Bit))
+          if (Origins[Bit / 2].Unstable &&
+              UnstableDiagnosed.insert(Invocation).second) {
+            Actions.Diag(Invocation->getBeginLoc(),
+                         Actions.getDiagnostics().getCustomDiagID(
+                             DiagnosticsEngine::Error,
+                             "borrowed pointer is derived from a non-stable owner; bind the owner with withLifetime/keepAlive or copy data to owned storage"));
+            Invalid = true;
+          }
+      }
+    }
+    if (observeOwnerConsumption(Invocation, State) && Emit)
+      for (unsigned I = 0; I != Count; ++I) {
+        const Expr *Argument = argument(Invocation, I);
+        if (formalIndex(Invocation, I) == ~0U && lambdaInvocation(callee(Invocation)))
+          continue; // A concrete receiver body has its own ordered CFG check.
+        if (hasExpired(value(Argument, State)))
+          diagnose(Argument, "a borrowed argument overlapping a consumed owner claim");
+      }
+  }
+  void observeCallbackWriteback(const Expr *Invocation, Facts &State) {
+    unsigned Count = 0;
+    if (const auto *Call = dyn_cast<CallExpr>(Invocation)) Count = Call->getNumArgs();
+    else if (const auto *Message = dyn_cast<ObjCMessageExpr>(Invocation)) Count = Message->getNumArgs();
+    else if (const auto *Construction = dyn_cast<CXXConstructExpr>(Invocation)) Count = Construction->getNumArgs();
+    for (unsigned I = 0; I != Count; ++I) {
+      const Expr *Argument = argument(Invocation, I);
+      const auto *Writeback = dyn_cast<ObjCIndirectCopyRestoreExpr>(Argument->IgnoreParenImpCasts());
+      if (!Writeback) continue;
+      const Expr *Operand = Writeback->getSubExpr();
+      Value Targets = possibleTargets(Operand, State);
+      if (auto Slot = ExpressionSlots.find(Operand); Slot != ExpressionSlots.end())
+        if (State.EvaluatedReady.test(Slot->second)) Targets = State.EvaluatedMayTargets[Slot->second];
+      Value Snapshot = value(Writeback, State), Effects = effects(Writeback, State);
+      for (int Slot = Targets.find_first(); Slot >= 0; Slot = Targets.find_next(Slot)) {
+        State.Values[Slot] |= Snapshot;
+        State.Effects[Slot] |= Effects;
+      }
+    }
+  }
+  void transfer(const CFGBlock &Block, Facts &State, bool Emit) {
