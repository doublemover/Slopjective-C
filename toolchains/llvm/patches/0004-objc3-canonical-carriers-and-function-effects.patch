diff --git a/clang/lib/Sema/TreeTransformObjC3Conditions.inc b/clang/lib/Sema/TreeTransformObjC3Conditions.inc
new file mode 100644
index 000000000..c78ec0ab0
--- /dev/null
+++ b/clang/lib/Sema/TreeTransformObjC3Conditions.inc
@@ -0,0 +1,101 @@
+// Native condition reconstruction must rerun use-site initialization. Include
+// after TreeTransform declarations and before explicit instantiation sites.
+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3BindingCondition(
+    ObjC3BindingCondition *Old) {
+  // Rebuild the full expression only after constructing the new snapshot.
+  // Nesting an already completed source expression would end its temporaries
+  // before successful binding initialization.
+  VarDecl *Variable = Old->getBindingDecl();
+  auto RegisterInvalidBinding = [&] {
+    auto *Invalid = VarDecl::Create(
+        SemaRef.Context, SemaRef.CurContext, Variable->getBeginLoc(),
+        Variable->getLocation(), Variable->getIdentifier(),
+        SemaRef.Context.IntTy, nullptr, SC_None);
+    Invalid->setInvalidDecl();
+    getDerived().transformedLocalDecl(Variable, {Invalid});
+  };
+  Expr *Initializer = Old->getSource();
+  while (auto *Cleanups = dyn_cast<ExprWithCleanups>(Initializer))
+    Initializer = Cleanups->getSubExpr();
+  ExprResult Source = getDerived().TransformExpr(Initializer);
+  if (Source.isInvalid()) {
+    RegisterInvalidBinding();
+    return StmtError();
+  }
+  StmtResult Result = SemaRef.ActOnObjC3BindingCondition(
+      nullptr, Variable->getIdentifier(), Variable->getLocation(),
+      Old->isMutableBinding(), Old->getKeywordLoc(), Old->getEqualLoc(),
+      Source.get());
+  if (Result.isInvalid()) {
+    RegisterInvalidBinding();
+    return StmtError();
+  }
+  auto *New = cast<ObjC3BindingCondition>(Result.get());
+  getDerived().transformedLocalDecl(Old->getSnapshotDecl(), {New->getSnapshotDecl()});
+  getDerived().transformedLocalDecl(Variable, {New->getBindingDecl()});
+  return New;
+}
+
+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3GuardStmt(ObjC3GuardStmt *Old) {
+  SmallVector<Stmt *, 4> Conditions;
+  for (unsigned I = 0; I != Old->getNumConditions(); ++I) {
+    Stmt *Condition = Old->getCondition(I);
+    if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition)) {
+      StmtResult New = getDerived().TransformObjC3BindingCondition(Binding);
+      if (New.isInvalid()) return StmtError();
+      Conditions.push_back(New.get());
+    } else {
+      auto *Initializer = cast<Expr>(Condition);
+      while (auto *Cleanups = dyn_cast<ExprWithCleanups>(Initializer))
+        Initializer = Cleanups->getSubExpr();
+      ExprResult Value = getDerived().TransformExpr(Initializer);
+      if (Value.isInvalid()) return StmtError();
+      Value = SemaRef.ActOnObjC3BooleanCondition(
+          nullptr, Value.get(), Initializer->getExprLoc());
+      if (Value.isInvalid()) return StmtError();
+      Conditions.push_back(Value.get());
+    }
+  }
+  StmtResult Else = getDerived().TransformStmt(Old->getElse());
+  if (Else.isInvalid()) return StmtError();
+  return SemaRef.ActOnObjC3GuardStmt(nullptr, Conditions, Else.get(),
+                                   Old->getKeywordLoc(), Old->getElseLoc());
+}
+
+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3IfBindingStmt(
+    ObjC3IfBindingStmt *Old) {
+  SmallVector<Stmt *, 4> Conditions;
+  for (unsigned I = 0; I != Old->getNumConditions(); ++I) {
+    StmtResult Condition = getDerived().TransformStmt(Old->getCondition(I));
+    if (Condition.isInvalid()) return StmtError();
+    Conditions.push_back(Condition.get());
+  }
+  StmtResult Then = getDerived().TransformStmt(Old->getThen());
+  StmtResult Else = getDerived().TransformStmt(Old->getElse());
+  if (Then.isInvalid() || Else.isInvalid()) return StmtError();
+  return SemaRef.ActOnObjC3IfBindingStmt(Conditions, Then.get(), Else.get(),
+                                       Old->getIfLoc(), Old->getElseLoc());
+}
+
+template <typename Derived>
+StmtResult
+TreeTransform<Derived>::TransformObjC3LifetimeStmt(ObjC3LifetimeStmt *Old) {
+  ExprResult Value = getDerived().TransformExpr(Old->getOperand());
+  if (Value.isInvalid())
+    return StmtError();
+  DeclStmt *Binding =
+      SemaRef.BuildObjC3LifetimeBinding(Value.get(), Old->getKeywordLoc());
+  if (!Binding)
+    return StmtError();
+  getDerived().transformedLocalDecl(Old->getBindingDecl(),
+                                    {cast<VarDecl>(Binding->getSingleDecl())});
+  StmtResult Body = getDerived().TransformStmt(Old->getBody());
+  if (Body.isInvalid())
+    return StmtError();
+  return SemaRef.BuildObjC3LifetimeStmt(
+      Binding, Body.get(), Old->getKeywordLoc(), Old->getLParenLoc(),
+      Old->getRParenLoc(), Old->getSemiLoc());
+}
