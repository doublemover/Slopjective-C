+namespace {
+bool strictConcurrency(const Sema &S) {
+  return S.getLangOpts().ObjC3StrictConcurrency;
+}
+bool protocolIsSendable(const ObjCProtocolDecl *P,
+                        llvm::SmallPtrSetImpl<const ObjCProtocolDecl *> &Seen) {
+  if (!P || !Seen.insert(P->getCanonicalDecl()).second)
+    return false;
+  if (P->getIdentifier() && P->getName() == "Sendable")
+    return true;
+  for (const auto *Inherited : P->protocols())
+    if (protocolIsSendable(Inherited, Seen))
+      return true;
+  return false;
+}
+const ObjCUnsafeSendableAttr *unsafeAdmission(ASTContext &C, QualType T) {
+  while (!T.isNull()) {
+    if (const auto *Alias = dyn_cast<TypedefType>(T.getTypePtr()))
+      if (const auto *A = Alias->getDecl()->getAttr<ObjCUnsafeSendableAttr>())
+        return A;
+    if (const auto *Object = T->getAs<ObjCObjectPointerType>())
+      for (auto *I = Object->getInterfaceDecl(); I; I = I->getSuperClass()) {
+        const auto *Contract = I->getDefinition() ? I->getDefinition() : I;
+        if (const auto *A = Contract->getAttr<ObjCUnsafeSendableAttr>())
+          return A;
+        if (const auto *Implementation = I->getImplementation())
+          if (const auto *A = Implementation->getAttr<ObjCUnsafeSendableAttr>())
+            return A;
+      }
+    if (const auto *R = T->getAsRecordDecl()) {
+      const auto *Contract = R->getDefinition() ? R->getDefinition() : R;
+      if (const auto *A = Contract->getAttr<ObjCUnsafeSendableAttr>())
+        return A;
+    }
+    QualType Next = T.getSingleStepDesugaredType(C);
+    if (Next == T)
+      break;
+    T = Next;
+  }
+  return nullptr;
+}
+struct SendableResult {
+  bool Safe = false;
+  bool Unchecked = false;
+  bool Borrowed = false;
+};
+class SendableClassifier {
+  ASTContext &C;
+  llvm::SmallPtrSet<const Type *, 16> Active;
+
+public:
+  explicit SendableClassifier(ASTContext &C) : C(C) {}
+  SendableResult classify(QualType T) {
+    if (T.isNull())
+      return {};
+    // Lifetime restrictions dominate unsafe admission, including borrowed
+    // subobjects of a wrapper that has promised Sendable conformance.
+    if (containsObjC3BorrowedType(C, T))
+      return {false, false, true};
+    bool Unchecked = unsafeAdmission(C, T);
+    bool Resource = getObjC3ResourceTypeContract(C, T).Cleanup;
+    if (Resource && !Unchecked)
+      return {};
+    if (T->isReferenceType())
+      return {};
+    if (T->isDependentType())
+      return {true, false};
+    if (T->isVoidType())
+      return {true, false};
+    if (const auto *Optional = T->getAs<ObjC3OptionalType>())
+      return classify(Optional->getElementType());
+    if (const auto *Result = T->getAs<ObjC3ResultType>()) {
+      auto A = classify(Result->getSuccessType());
+      auto B = classify(Result->getErrorType());
+      return {A.Safe && B.Safe, A.Unchecked || B.Unchecked,
+              A.Borrowed || B.Borrowed};
+    }
+    if (const auto *Array = C.getAsArrayType(T))
+      return classify(Array->getElementType());
+    // Class metadata is immutable; transferring a Class value does not transfer
+    // an instance or attest the instance type's Sendable conformance.
+    if (T->isObjCClassType())return {true, false};
+    if (const auto *Object = T->getAs<ObjCObjectPointerType>()) {
+      if (isObjC3Actor(Object->getInterfaceDecl()))
+        return {true, false};
+      llvm::SmallPtrSet<const ObjCProtocolDecl *, 16> Protocols;
+      for (const auto *P : Object->quals())
+        if (protocolIsSendable(P, Protocols))
+          return {true, false};
+      for (const auto *I = Object->getInterfaceDecl(); I;
+           I = I->getSuperClass())
+        for (const auto *P : I->all_referenced_protocols())
+          if (protocolIsSendable(P, Protocols))
+            return {true, false};
+      return {Unchecked, Unchecked};
+    }
+    // A block's type cannot attest its capture set. Literal checking below
+    // reasons about capture provenance rather than accepting all block types.
+    if (T->isBlockPointerType())
+      return {Unchecked, Unchecked};
+    if (const auto *Record = T->getAs<RecordType>()) {
+      const auto *Definition = Record->getDecl()->getDefinition();
+      if (!Definition)
+        return {Unchecked, Unchecked};
+      if (!Active.insert(Record).second)
+        return {};
+      bool Safe = true, ReliesOnPromise = Resource;
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+        // An implicit ARC destructor only releases the fields checked below.
+        // User-provided destruction still needs explicit unsafe admission.
+        Safe = (Class->isAggregate() || Class->isLambda()) &&
+               (!Class->hasNonTrivialDestructor() ||
+                !Class->hasUserDeclaredDestructor());
+      for (const auto *Field : Definition->fields()) {
+        if (isObjC3BorrowedType(C, Field->getType())) {
+          Active.erase(Record);
+          return {false, false, true};
+        }
+        auto Part = classify(Field->getType());
+        if (Part.Borrowed) {
+          Active.erase(Record);
+          return Part;
+        }
+        Safe &= Part.Safe;
+        ReliesOnPromise |= Part.Unchecked;
+      }
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+        for (const auto &Base : Class->bases()) {
+          auto Part = classify(Base.getType());
+          if (Part.Borrowed) {
+            Active.erase(Record);
+            return Part;
+          }
+          Safe &= Part.Safe;
+          ReliesOnPromise |= Part.Unchecked;
+        }
+      Active.erase(Record);
+      return {Safe || Unchecked, ReliesOnPromise || (!Safe && Unchecked)};
+    }
+    // C scalars (including raw non-borrowed pointers) and enums are value-like.
+    if (T->isScalarType() || T->isVectorType())
+      return {true, Resource};
+    return {Unchecked, Unchecked};
+  }
+};
+
+bool checkTransfer(Sema &S, QualType T, SourceLocation Loc, StringRef Reason,
+                   const Decl *Boundary, bool ForceUnsafe = false) {
+  auto Classification = SendableClassifier(S.Context).classify(T);
+  if (ForceUnsafe && !unsafeAdmission(S.Context, T))
+    Classification.Safe = false;
+  if (!Classification.Safe) {
+    S.Diag(Loc, strictConcurrency(S) ? diag::err_objc3_sendable_transfer
+                                     : diag::warn_objc3_sendable_transfer)
+        << T << Reason;
+    if (Boundary)
+      S.Diag(Boundary->getLocation(), diag::note_objc3_sendable_boundary);
+    return strictConcurrency(S);
+  }
+  if (strictConcurrency(S) && (Classification.Unchecked || ForceUnsafe) &&
+      !S.getDiagnostics().getSuppressAllDiagnostics() &&
+      !S.getDiagnostics().hasFatalErrorOccurred()) {
+    // This is a required standalone transfer note, not a child of a preceding
+    // warning. Emit it even when the previous diagnostic was suppressed.
+    S.getDiagnostics().Report(Loc, diag::note_objc3_unchecked_sendable)
+        .setForceEmit() << T;
+  }
+  return false;
+}
+
+const Expr *transferSource(const Expr *E) {
+  for (;;) {
+    E = E->IgnoreParenImpCasts();
+    if (const auto *Default = dyn_cast<CXXDefaultArgExpr>(E)) {
+      E = Default->getExpr();
+      continue;
+    }
+    if (const auto *Default = dyn_cast<CXXDefaultInitExpr>(E)) {
+      E = Default->getExpr();
+      continue;
+    }
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      if (Opaque->getSourceExpr()) {
+        E = Opaque->getSourceExpr();
+        continue;
+      }
+    return E;
+  }
+}
+const BlockExpr *knownBlockLiteral(const Expr *E) {
+  if (!E)
+    return nullptr;
+  E = transferSource(E);
+  if (const auto *B = dyn_cast<BlockExpr>(E))
+    return B;
+  if (const auto *Reference = dyn_cast<DeclRefExpr>(E))
+    if (const auto *V = dyn_cast<VarDecl>(Reference->getDecl()))
+      if (V->isLocalVarDecl() && V->getType().isConstQualified() &&
+          V->hasInit())
+        return dyn_cast<BlockExpr>(V->getInit()->IgnoreParenImpCasts());
+  return nullptr;
+}
+
+bool isAsyncBlockType(QualType T) {
+  if (const auto *B = T->getAs<BlockPointerType>())
+    if (const auto *FT = B->getPointeeType()->getAs<FunctionProtoType>())
+      return FT->getObjC3FunctionEffects().Async;
+  return false;
+}
+bool asyncWorkType(Sema &S,QualType Type) {
+  Type=Type.getNonReferenceType();
+  if(Type->isDependentType())return S.getLangOpts().CPlusPlus;
+  if(Type->isBlockPointerType() || Type->isFunctionPointerType())
+    if(const auto *Prototype=Type->getPointeeType()->getAs<FunctionProtoType>())
+      return Prototype->getObjC3FunctionEffects().Async;
+  const auto *Root=Type->getAsCXXRecordDecl();
+  if(!Root)return false;
+  llvm::SmallPtrSet<const CXXRecordDecl *,8> Seen;
+  SmallVector<const CXXRecordDecl *,8> Pending{Root};
+  while(!Pending.empty()) {
+    const auto *Record=Pending.pop_back_val();
+    if(!Seen.insert(Record).second || !Record->hasDefinition())continue;
+    Record=Record->getDefinition();
+    for(const auto *Declaration:Record->lookup(S.Context.DeclarationNames.getCXXOperatorName(OO_Call))) {
+      const auto *Function=dyn_cast<FunctionDecl>(Declaration);
+      if(const auto *Template=dyn_cast<FunctionTemplateDecl>(Declaration))Function=Template->getTemplatedDecl();
+      if(!Function)continue;
+      const auto *Prototype=Function->getType()->getAs<FunctionProtoType>();
+      if(!Prototype)continue;
+      if(Prototype->getObjC3FunctionEffects().Async ||
+          (Function->hasBody() && isa<CoroutineBodyStmt>(Function->getBody())))return true;
+      if(const auto *Result=Prototype->getReturnType()->getAsCXXRecordDecl())
+        if(Result->hasDefinition() && !Result->getDefinition()->lookup(&S.Context.Idents.get("promise_type")).empty())return true;
+    }
+    for(const auto &Base:Record->bases())
+      if(const auto *Parent=Base.getType()->getAsCXXRecordDecl())Pending.push_back(Parent);
+  }
+  return false;
+}
+bool hasAsyncWork(Sema &S,const Decl *Declaration) {
+  if(const auto *Function=dyn_cast<FunctionDecl>(Declaration))
+    for(const auto *Parameter:Function->parameters())
+      if(asyncWorkType(S,Parameter->getType()))return true;
+  if(const auto *Method=dyn_cast<ObjCMethodDecl>(Declaration))
+    for(const auto *Parameter:Method->parameters())
+      if(asyncWorkType(S,Parameter->getType()))return true;
+  return false;
+}
+
+bool isAsyncWorkParameter(const Decl *D, unsigned Index) {
+  if (const auto *F = dyn_cast<FunctionDecl>(D))
+    return Index < F->getNumParams() &&
+           isAsyncBlockType(F->getParamDecl(Index)->getType());
+  if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+    return Index < M->param_size() &&
+           isAsyncBlockType((M->param_begin()[Index])->getType());
+  return false;
+}
+bool checkKnownConcurrentBlock(Sema &, const BlockExpr *, SourceLocation,
+                               bool RequireAsync,
+                               llvm::SmallPtrSetImpl<const BlockDecl *> &);
+
+bool checkBoundarySignature(Sema &S, const ObjCMethodDecl *Method) {
+  bool Invalid =
+      checkTransfer(S, Method->getReturnType(), Method->getLocation(),
+                    "nonisolated result", Method);
+  for (const auto *P : Method->parameters())
+    Invalid |= checkTransfer(S, P->getType(), P->getLocation(),
+                             "nonisolated parameter", Method);
+  auto Effects = Method->getObjC3FunctionEffects();
+  if (Effects.Throws == ObjC3ThrowsKind::Typed)
+    Invalid |= checkTransfer(S, Effects.ErrorType, Method->getLocation(),
+                             "nonisolated checked error", Method);
+  return Invalid;
+}
+
+// Returning the original expression for an unnecessary await is safe only if
+// no unhandled async operation is buried in its evaluated subexpressions.
+class NonSuspendingAwaitProof
+    : public ConstEvaluatedExprVisitor<NonSuspendingAwaitProof> {
+  using Base = ConstEvaluatedExprVisitor<NonSuspendingAwaitProof>;
+
+public:
+  bool Proven = true;
+  explicit NonSuspendingAwaitProof(ASTContext &C) : Base(C) {}
+  void VisitCoawaitExpr(const CoawaitExpr *) {} // Already lowered suspension.
+  void VisitCallExpr(const CallExpr *E) {
+    if (E->isUnevaluatedBuiltinCall(Context))
+      return;
+    const auto *FT = getObjC3CallableFunctionType(E->getDirectCallee());
+    if (!FT) {
+      QualType T = E->getCallee()->getType();
+      if (T->isPlaceholderType()) {
+        Proven = false;
+        return;
+      }
+      if (const auto *P = T->getAs<PointerType>())
+        T = P->getPointeeType();
+      else if (const auto *B = T->getAs<BlockPointerType>())
+        T = B->getPointeeType();
+      FT = T->getAs<FunctionProtoType>();
+    }
+    if (FT && FT->getObjC3FunctionEffects().Async)
+      Proven = false;
+    Base::VisitCallExpr(E);
+  }
+  void VisitCXXDefaultArgExpr(const CXXDefaultArgExpr *E) {
+    Visit(E->getExpr());
+  }
+  void VisitCXXDefaultInitExpr(const CXXDefaultInitExpr *E) {
+    Visit(E->getExpr());
+  }
+  void VisitObjCMessageExpr(const ObjCMessageExpr *E) {
+    const auto *M = E->getMethodDecl();
+    if (!M || M->getObjC3FunctionEffects().Async)
+      Proven = false;
+    Base::VisitStmt(E);
+  }
+};
+
+class IsolationBodyChecker : public EvaluatedExprVisitor<IsolationBodyChecker> {
+  using Base = EvaluatedExprVisitor<IsolationBodyChecker>;
+  Sema &S;
+  Decl *Callable;
+  unsigned AwaitDepth = 0;
+  bool CheckTaskBoundaries = true;
+  bool Invalid = false;
+  llvm::SmallPtrSet<const Stmt *, 32> Checked;
+
+  bool sameActor(const Expr *Receiver, bool Super = false) const {
+    const auto *M = dyn_cast<ObjCMethodDecl>(Callable);
+    if (!M || !isObjC3ActorIsolated(M))
+      return false;
+    if (Super)
+      return true;
+    Receiver = Receiver ? Receiver->IgnoreParenImpCasts() : nullptr;
+    if (const auto *Opaque = dyn_cast_or_null<OpaqueValueExpr>(Receiver))
+      Receiver = Opaque->getSourceExpr()
+                     ? Opaque->getSourceExpr()->IgnoreParenImpCasts()
+                     : nullptr;
+    const auto *Reference = dyn_cast_or_null<DeclRefExpr>(Receiver);
+    return Reference && Reference->getDecl() == M->getSelfDecl();
+  }
+  bool executorProven(const Decl *Callee) const {
+    const auto *Target = getObjC3Executor(Callee);
+    const auto *Current = getObjC3Executor(Callable);
+    return !Target ||
+           (Current && Current->getExecutor() == Target->getExecutor());
+  }
+  void checkCall(Expr *Site, const Decl *Target, ArrayRef<Expr *> Arguments,
+                 const Expr *Receiver = nullptr, bool Super = false) {
+    if (!Target || !Checked.insert(Site).second)
+      return;
+    // A private frame encapsulates the entry requirement. Its original source
+    // argument/result transfers were checked before replacing the await
+    // operand.
+    if (Target->hasAttr<ObjC3IsolationThunkAttr>())
+      return;
+    bool ActorCrossing =
+        isObjC3ActorIsolated(Target) && !sameActor(Receiver, Super);
+    bool ExecutorCrossing = !executorProven(Target);
+    if (ActorCrossing || ExecutorCrossing) {
+      unsigned Kind = ActorCrossing ? 0 : 1;
+      S.Diag(Site->getExprLoc(), AwaitDepth
+                                     ? diag::err_objc3_isolation_hop_unavailable
+                                     : diag::err_objc3_isolation_requires_await)
+          << Kind;
+      S.Diag(Target->getLocation(), diag::note_objc3_sendable_boundary);
+      Invalid = true;
+      for (const Expr *Argument : Arguments)
+        Invalid |=
+            checkTransfer(S, transferSource(Argument)->getType(),
+                          Argument->getExprLoc(), "isolated argument", Target);
+      QualType Result;
+      ObjC3FunctionEffectInfo Effects;
+      if (const auto *Method = dyn_cast<ObjCMethodDecl>(Target)) {
+        Result = Method->getReturnType();
+        Effects = Method->getObjC3FunctionEffects();
+      } else if (const auto *FT = getObjC3CallableFunctionType(Target)) {
+        Result = FT->getReturnType();
+        Effects = FT->getObjC3FunctionEffects();
+      }
+      if (!Result.isNull())
+        Invalid |= checkTransfer(S, Result, Site->getExprLoc(),
+                                 "isolated result", Target);
+      if (Effects.Throws == ObjC3ThrowsKind::Typed)
+        Invalid |= checkTransfer(S, Effects.ErrorType, Site->getExprLoc(),
+                                 "isolated checked error", Target);
+    }
+    if (!CheckTaskBoundaries)
+      return;
+    unsigned TaskKind = getObjC3TaskBoundaryKind(Target);
+    if (!(TaskKind & 3))
+      return;
+    // A dependent declaration is checked again after substitution; a generic
+    // attribute cannot turn an arbitrary scalar argument into asynchronous work.
+    if(!hasAsyncWork(S,Target)) {
+      S.Diag(Site->getExprLoc(),diag::err_objc3_task_async_work);Invalid=true;return;
+    }
+    unsigned Index = 0;
+    for (const Expr *Argument : Arguments) {
+      QualType TransferType = transferSource(Argument)->getType();
+      if (TransferType->isBlockPointerType()) {
+        // A null work item never transfers a capture environment. Its runtime
+        // startup rejection remains available under strict checking.
+        if (Argument->IgnoreParenCasts()->isNullPointerConstant(
+                S.Context, Expr::NPC_ValueDependentIsNotNull)) {
+          ++Index;
+          continue;
+        }
+        if (const auto *Block = knownBlockLiteral(Argument)) {
+          llvm::SmallPtrSet<const BlockDecl *, 8> Active;
+          Invalid |= checkKnownConcurrentBlock(
+              S, Block, Site->getExprLoc(), isAsyncWorkParameter(Target, Index),
+              Active);
+        } else if (unsafeAdmission(S.Context, TransferType)) {
+          Invalid |= checkTransfer(S, TransferType, Argument->getExprLoc(),
+                                   "unchecked concurrent block value", Target);
+        } else if (strictConcurrency(S)) {
+          S.Diag(Argument->getExprLoc(), diag::err_objc3_task_unknown_capture);
+          Invalid = true;
+        } else {
+          checkTransfer(S, TransferType, Argument->getExprLoc(),
+                        "unverified concurrent block capture", Target);
+        }
+      } else {
+        Invalid |= checkTransfer(S, TransferType, Argument->getExprLoc(),
+                                 "spawned work-item argument", Target);
+      }
+      ++Index;
+    }
+  }
+
+public:
+  IsolationBodyChecker(Sema &S, Decl *Callable, bool AwaitOperand = false)
+      : Base(S.Context), S(S), Callable(Callable),
+        AwaitDepth(AwaitOperand ? 1 : 0), CheckTaskBoundaries(!AwaitOperand) {}
+  bool failed() const { return Invalid; }
+  void VisitCompoundStmt(CompoundStmt *Body) {
+    for (Stmt *Child : Body->body()) {
+      if (CheckTaskBoundaries)
+        if (auto *Expression = dyn_cast<Expr>(Child)) {
+          const Expr *Value = Expression->IgnoreImplicit()->IgnoreParens();
+          if (const auto *Try = dyn_cast<ObjC3TryExpr>(Value))
+            Value = Try->getOperand()->IgnoreImplicit()->IgnoreParens();
+          const Decl *Target = nullptr;
+          if (const auto *Call = dyn_cast<CallExpr>(Value))
+            Target = Call->getDirectCallee();
+          if (const auto *Message = dyn_cast<ObjCMessageExpr>(Value))
+            Target = Message->getMethodDecl();
+          if (getObjC3TaskBoundaryKind(Target) & 1)
+            S.Diag(Expression->getExprLoc(),
+                   diag::warn_objc3_unused_task_handle);
+        }
+      Visit(Child);
+    }
+  }
+  void VisitBlockExpr(BlockExpr *) {} // Each callable checks its own body.
+  void VisitLambdaExpr(LambdaExpr *E) { Base::VisitLambdaExpr(E); }
+  void VisitCoawaitExpr(CoawaitExpr *E) {
+    llvm::SaveAndRestore<unsigned> AwaitGuard(AwaitDepth, AwaitDepth + 1);
+    Visit(E->getOperand());
+  }
+  void VisitCallExpr(CallExpr *E) {
+    if (E->isUnevaluatedBuiltinCall(S.Context))
+      return;
+    checkCall(E, E->getDirectCallee(), {E->getArgs(), E->getNumArgs()});
+    Base::VisitCallExpr(E);
+  }
+  void VisitCXXDefaultArgExpr(CXXDefaultArgExpr *E) { Visit(E->getExpr()); }
+  void VisitCXXDefaultInitExpr(CXXDefaultInitExpr *E) { Visit(E->getExpr()); }
+  void VisitObjCMessageExpr(ObjCMessageExpr *E) {
+    checkCall(E, E->getMethodDecl(), {E->getArgs(), E->getNumArgs()},
+              E->getInstanceReceiver(),
+              E->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+    Base::VisitStmt(E);
+  }
+  void VisitObjCIvarRefExpr(ObjCIvarRefExpr *E) {
+    const auto *Ivar = E->getDecl();
+    if (isObjC3ActorIsolated(Ivar) && !sameActor(E->getBase()) &&
+        Checked.insert(E).second) {
+      S.Diag(E->getExprLoc(), diag::err_objc3_isolated_state) << Ivar;
+      Invalid = true;
+    }
+    Base::VisitStmt(E);
+  }
+};
+} // namespace
+
+bool clang::isObjC3SendableType(ASTContext &C, QualType T) {
+  return SendableClassifier(C).classify(T).Safe;
+}
+namespace {
+bool checkKnownConcurrentBlock(
+    Sema &S, const BlockExpr *B, SourceLocation Site, bool RequireAsync,
+    llvm::SmallPtrSetImpl<const BlockDecl *> &Active) {
+  bool Invalid = false;
+  const BlockDecl *D = B->getBlockDecl();
+  if (!Active.insert(D).second)
+    return checkTransfer(S, B->getType(), Site, "recursive block capture proof",
+                         nullptr);
+  const auto *Signature = getObjC3CallableFunctionType(D);
+  if (RequireAsync &&
+      (!Signature || !Signature->getObjC3FunctionEffects().Async)) {
+    S.Diag(Site, diag::err_objc3_task_async_work);
+    Invalid = true;
+  }
+  for (const auto &Capture : D->captures()) {
+    const VarDecl *V = Capture.getVariable();
+    SourceLocation Loc = Capture.getObjC3CaptureRange().isValid()
+                             ? Capture.getObjC3CaptureRange().getBegin()
+                             : Site;
+    bool Unsafe =
+        Capture.getObjC3CaptureKind() == BlockDecl::ObjC3CaptureKind::Unowned ||
+        Capture.getCaptureType().getObjCLifetime() ==
+            Qualifiers::OCL_ExplicitNone;
+    bool Managed = V->hasAttr<CleanupAttr>() || V->hasAttr<ObjCCleanupAttr>() ||
+                   V->hasAttr<ObjCResourceAttr>();
+    bool Failed = false;
+    if (Capture.isByRef() ||
+        (Managed && !unsafeAdmission(S.Context, V->getType()))) {
+      S.Diag(Loc, strictConcurrency(S) ? diag::err_objc3_sendable_transfer
+                                       : diag::warn_objc3_sendable_transfer)
+          << V->getType()
+          << (Capture.isByRef() ? "shared __block capture"
+                                : "cleanup-managed capture");
+      Failed = strictConcurrency(S);
+    } else if (!Unsafe && !Managed && V->getType()->isBlockPointerType() &&
+               V->getType().isConstQualified() && V->hasInit() &&
+               knownBlockLiteral(V->getInit())) {
+      Failed = checkKnownConcurrentBlock(S, knownBlockLiteral(V->getInit()),
+                                         Loc, false, Active);
+    } else {
+      Failed = checkTransfer(S, V->getType(), Loc, "concurrent capture",
+                             nullptr, Unsafe || Managed);
+    }
+    if (Failed)
+      S.Diag(V->getLocation(), diag::note_objc3_sendable_capture) << V;
+    Invalid |= Failed;
+  }
+  if (D->capturesCXXThis()) {
+    S.Diag(Site, strictConcurrency(S) ? diag::err_objc3_sendable_transfer
+                                      : diag::warn_objc3_sendable_transfer)
+        << S.Context.VoidPtrTy << "implicit C++ this capture";
+    Invalid |= strictConcurrency(S);
+  }
+  Active.erase(D);
+  return Invalid;
+}
+} // namespace
+
+bool clang::checkObjC3ConcurrentBlockCaptures(Sema &S, const BlockExpr *B,
+                                              SourceLocation Site) {
+  llvm::SmallPtrSet<const BlockDecl *, 8> Active;
+  return checkKnownConcurrentBlock(S, B, Site, true, Active);
+}
+
+void clang::handleObjC3IsolationAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  if (!S.getLangOpts().ObjC3) {
+    S.Diag(AL.getLoc(), diag::err_objc3_isolation_mode);
+    D->setInvalidDecl();
+    return;
+  }
+  switch (AL.getKind()) {
+  case ParsedAttr::AT_ObjCActorNonreentrant:
+    S.Diag(AL.getLoc(), diag::err_objc3_actor_nonreentrant_deferred);
+    D->setInvalidDecl();
+    return;
+  case ParsedAttr::AT_ObjCExecutor: {
+    if (!AL.checkExactlyNumArgs(S, 1) || !AL.isArgExpr(0)) {
+      D->setInvalidDecl();
+      return;
+    }
+    const auto *Literal =
+        dyn_cast<StringLiteral>(AL.getArgAsExpr(0)->IgnoreParenImpCasts());
+    if (!Literal)
+      return;
+    if (D->hasAttr<ObjCExecutorAttr>() &&
+        D->getAttr<ObjCExecutorAttr>()->getExecutor() != Literal->getString()) {
+      S.Diag(AL.getLoc(), diag::err_objc3_isolation_conflict)
+          << cast<NamedDecl>(D);
+      D->setInvalidDecl();
+      return;
+    }
+    if (!D->hasAttr<ObjCExecutorAttr>())
+      D->addAttr(ObjCExecutorAttr::Create(S.Context, Literal->getString(), AL));
+    return;
+  }
+  case ParsedAttr::AT_ObjCNonisolated: {
+    const auto *M = dyn_cast<ObjCMethodDecl>(D);
+    const auto *P = dyn_cast<ObjCPropertyDecl>(D);
+    if ((!M && !P) || (M && !M->isInstanceMethod()) ||
+        (P && !P->isInstanceProperty()) ||
+        !isObjC3Actor(getObjC3ContainingInterface(D))) {
+      S.Diag(AL.getLoc(), diag::err_objc3_nonisolated_context);
+      D->setInvalidDecl();
+      return;
+    }
+    if (!D->hasAttr<ObjCNonisolatedAttr>())
+      D->addAttr(ObjCNonisolatedAttr::Create(S.Context, AL));
+    bool Invalid = M ? checkBoundarySignature(S, M)
+                     : checkTransfer(S, P->getType(), P->getLocation(),
+                                     "nonisolated property", P);
+    if (Invalid)
+      D->setInvalidDecl();
+    return;
+  }
+  case ParsedAttr::AT_ObjCUnsafeSendable:
+    if (!D->hasAttr<ObjCUnsafeSendableAttr>())
+      D->addAttr(ObjCUnsafeSendableAttr::Create(S.Context, AL));
+    // Interfaces are the exported type contract. Implementation spelling must
+    // not leave a source-free importer unable to observe the admission.
+    if (auto *Implementation = dyn_cast<ObjCImplementationDecl>(D))
+      if (auto *Interface = Implementation->getClassInterface())
+        if (!Interface->hasAttr<ObjCUnsafeSendableAttr>())
+          Interface->addAttr(ObjCUnsafeSendableAttr::Create(S.Context, AL));
+    return;
+  default:
+    break;
+  }
+  unsigned Kind = AL.getKind() == ParsedAttr::AT_ObjCTaskSpawn      ? 1
+                  : AL.getKind() == ParsedAttr::AT_ObjCTaskDetached ? 2
+                                                                    : 4;
+  unsigned Existing = getObjC3TaskBoundaryKind(D);
+  if ((Existing & 3) && (Kind & 3) && !(Existing & Kind)) {
+    S.Diag(AL.getLoc(), diag::err_objc3_isolation_conflict)
+        << cast<NamedDecl>(D);
+    D->setInvalidDecl();
+    return;
+  }
+  if (Kind & 3) {
+    QualType Result;
+    if (const auto *F = dyn_cast<FunctionDecl>(D))
+      Result = F->getReturnType();
+    if (const auto *M = dyn_cast<ObjCMethodDecl>(D))
+      Result = M->getReturnType();
+    if (Result.isNull() || Result->isVoidType()) {
+      S.Diag(AL.getLoc(), diag::err_objc3_task_handle_result);
+      D->setInvalidDecl();
+      return;
+    }
+    const bool HasAsyncWork=hasAsyncWork(S,D);
+    if (!HasAsyncWork) {
+      S.Diag(AL.getLoc(), diag::err_objc3_task_async_work);
+      D->setInvalidDecl();
+      return;
+    }
+  }
+  if (Kind == 1 && !(Existing & 1))
+    D->addAttr(ObjCTaskSpawnAttr::Create(S.Context, AL));
+  if (Kind == 2 && !(Existing & 2))
+    D->addAttr(ObjCTaskDetachedAttr::Create(S.Context, AL));
+  if (Kind == 4 && !(Existing & 4))
+    D->addAttr(ObjCTaskGroupAttr::Create(S.Context, AL));
+}
+
+bool clang::checkObjC3IsolationRedeclaration(Sema &S, Decl *New,
+                                             const Decl *Old) {
+  if (!S.getLangOpts().ObjC3 || !New || !Old)
+    return false;
+  // A visible prior declaration is a valid proof source. Omitted attributes on
+  // source redeclarations inherit, while conflicting explicit identity is
+  // rejected.
+  if (!New->hasAttr<ObjCExecutorAttr>())
+    if (const auto *A = Old->getAttr<ObjCExecutorAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCNonisolatedAttr>()) {
+    if (const auto *A = Old->getAttr<ObjCNonisolatedAttr>())
+      New->addAttr(A->clone(S.Context));
+    else if (isObjC3Nonisolated(Old))
+      // Property accessors inherit the property's effective contract even
+      // before the new implementation is linked to its property declaration.
+      New->addAttr(ObjCNonisolatedAttr::CreateImplicit(S.Context));
+  }
+  if (!New->hasAttr<ObjCTaskSpawnAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskSpawnAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCTaskDetachedAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskDetachedAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (!New->hasAttr<ObjCTaskGroupAttr>())
+    if (const auto *A = Old->getAttr<ObjCTaskGroupAttr>())
+      New->addAttr(A->clone(S.Context));
+  if (haveSameObjC3Isolation(New, Old))
+    return false;
+  S.Diag(New->getLocation(), diag::err_objc3_isolation_redeclaration)
+      << cast<NamedDecl>(New);
+  S.Diag(Old->getLocation(), diag::note_previous_declaration);
+  New->setInvalidDecl();
+  return true;
+}
+
+bool clang::checkObjC3IsolationBody(Sema &S, Decl *Callable, Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || !Callable || !Body)
+    return false;
+  IsolationBodyChecker Checker(S, Callable);
+  Checker.Visit(Body);
+  return Checker.failed();
+}
+
+// Diagnose unsupported crossings before native awaitable conversion, which
+// otherwise hides the entry requirement behind the synchronous result type.
+bool Sema::DiagnoseObjC3AwaitIsolation(Expr *Operand) {
+  if (!getLangOpts().ObjC3 || !Operand)
+    return false;
+  IsolationBodyChecker Checker(*this, Decl::castFromDeclContext(CurContext),
+                               true);
+  Checker.Visit(Operand);
+  return Checker.failed();
+}
+
+namespace {
+bool isolationFrameScalar(QualType T, bool Result) {
+  if (Result && T->isVoidType())
+    return true;
+  return T->isArithmeticType() || T->isEnumeralType() || T->isPointerType() ||
+         T->isNullPtrType() || T->isObjCRetainableType();
+}
+
+// Aggregate entries use the same typed capture/result operations as ordinary
+// native frames. Keep resource transfer and MRC managed aggregate storage out
+// of this value-copy boundary until their independent ownership is modeled.
+bool isolationFrameValue(Sema &S, QualType T, bool Result) {
+  if (isolationFrameScalar(T, Result)) return true;
+  if (!T->isRecordType()) return false;
+  unsigned Budget = 256;
+  auto Check = [&](auto &&Self, QualType Value, unsigned Depth, bool UnionArm = false) -> bool {
+    if (Value.isNull() || Depth > 64 || Budget == 0 ||
+        Value->isDependentType() || Value.isVolatileQualified() ||
+        Value->isAtomicType() || Value->isReferenceType() ||
+        getObjC3ResourceTypeContract(S.Context, Value).Cleanup)
+      return false;
+    --Budget;
+    if (Value->isObjCRetainableType()) return !UnionArm && S.getLangOpts().ObjCAutoRefCount;
+    if (const auto *Array = S.Context.getAsArrayType(Value))
+      return isa<ConstantArrayType>(Array) &&
+             Self(Self, Array->getElementType(), Depth + 1, UnionArm);
+    if (const auto *Record = Value->getAs<RecordType>()) {
+      const auto *Definition = Record->getDecl()->getDefinition();
+      if (!Definition) return false;
+      // Plain unions have native object-representation copy semantics. Managed
+      // union arms need an active-arm ownership contract and remain rejected.
+      if (Definition->isUnion() && !Value.isTriviallyCopyableType(S.Context))return false;
+      UnionArm |= Definition->isUnion();
+      for (const auto *Field : Definition->fields())
+        if (!Self(Self, Field->getType(), Depth + 1, UnionArm)) return false;
+      if (const auto *Class = dyn_cast<CXXRecordDecl>(Definition))
+        for (const auto &Base : Class->bases())
+          if (!Self(Self, Base.getType(), Depth + 1, UnionArm)) return false;
+      return true;
+    }
+    return isolationFrameScalar(Value, false);
+  };
+  return Check(Check, T, 0);
+}
+
+bool isolationResultIsOwned(const Decl *Target) {
+  if (Target->hasAttr<NSReturnsRetainedAttr>())
+    return true;
+  if (Target->hasAttr<NSReturnsNotRetainedAttr>() ||
+      Target->hasAttr<NSReturnsAutoreleasedAttr>())
+    return false;
+  if (const auto *Method = dyn_cast<ObjCMethodDecl>(Target))
+    switch (Method->getMethodFamily()) {
+    case OMF_alloc:
+    case OMF_new:
+    case OMF_copy:
+    case OMF_mutableCopy:
+    case OMF_init:
+      return true;
+    default:
+      break;
+    }
+  return false;
+}
+
+FunctionDecl *buildIsolationThunk(Sema &S, Expr *Source, Expr *SourceReceiver,
+                                  const Decl *Target,
+                                  const FunctionProtoType *Original,
+                                  const ObjCExecutorAttr *Executor,
+                                  bool ActorEntry, ObjCMethodDecl *SuperContext,
+                                  SourceLocation Loc) {
+  auto *Message = dyn_cast<ObjCMessageExpr>(Source);
+  const bool HasReceiver = SourceReceiver != nullptr;
+  auto *TU = S.Context.getTranslationUnitDecl();
+  std::string Prefix =
+      "__objc3_isolation_entry_" + std::to_string(Loc.getRawEncoding());
+  std::string Name = Prefix;
+  unsigned Suffix = 0;
+  while (!TU->lookup(&S.Context.Idents.get(Name)).empty())
+    Name = Prefix + "_" + std::to_string(++Suffix);
+  FunctionProtoType::ExtProtoInfo Info;
+  Info.ObjC3Effects = Original->getObjC3FunctionEffects();
+  Info.ObjC3Effects.Async = true;
+  Info.ObjC3Effects.AsyncFrame = true;
+  SmallVector<QualType, 4> Types;
+  if (HasReceiver)
+    Types.push_back(SourceReceiver->getType());
+  llvm::append_range(Types, Original->param_types());
+  SmallVector<const ParmVarDecl *, 4> SourceParameters;
+  if (Message)
+    llvm::append_range(SourceParameters, cast<ObjCMethodDecl>(Target)->parameters());
+  else
+    llvm::append_range(SourceParameters, cast<FunctionDecl>(Target)->parameters());
+  SmallVector<FunctionProtoType::ExtParameterInfo, 4> ParameterInfos(Types.size());
+  bool HasConsumed = false;
+  for (unsigned I = 0; I != Types.size(); ++I) {
+    const bool Consumed = S.getLangOpts().ObjCAutoRefCount &&
+        (HasReceiver && I == 0 ? Target->hasAttr<NSConsumesSelfAttr>()
+                              : SourceParameters[I - (HasReceiver ? 1 : 0)]
+                                ->hasAttr<NSConsumedAttr>());
+    if (!Consumed) continue;
+    HasConsumed = true;
+    ParameterInfos[I] = ParameterInfos[I].withIsConsumed(true);
+    // The ramp adopts the caller's +1 and owns it independently of the frame
+    // copy. Its ordinary ARC parameter cleanup also runs if frame creation
+    // fails. A weak/unowned source expression does not change this ownership.
+    auto Quals = Types[I].getQualifiers();
+    Quals.removeObjCLifetime();
+    Quals.addObjCLifetime(Qualifiers::OCL_Strong);
+    Types[I] = S.Context.getQualifiedType(Types[I].getUnqualifiedType(), Quals);
+  }
+  if (HasConsumed) Info.ExtParameterInfos = ParameterInfos.data();
+  QualType Type =
+      S.Context.getFunctionType(Original->getReturnType(), Types, Info);
+  // Register the native frame representation before publishing the body to
+  // CodeGen. A C++ task caller may be the first user of this logical result,
+  // so its task representation does not establish the thunk's frame ABI.
+  if (S.BuildObjC3AsyncTaskType(Type->castAs<FunctionProtoType>(), Loc).isNull())
+    return nullptr;
+  auto *Thunk = FunctionDecl::Create(
+      S.Context, TU, Loc, Loc, &S.Context.Idents.get(Name), Type,
+      S.Context.getTrivialTypeSourceInfo(Type, Loc), SC_Static);
+  Thunk->setImplicit();
+  // A super send uses the source method's lexical lookup context, while its
+  // receiver is the independently owned first frame parameter. Native lexical
+  // declaration contexts preserve this relationship through PCH/AST import.
+  if (SuperContext)
+    Thunk->setLexicalDeclContext(SuperContext);
+  Thunk->addAttr(ObjC3IsolationThunkAttr::CreateImplicit(
+      S.Context, ActorEntry,
+      !Original->getObjC3FunctionEffects().Async &&
+          isolationResultIsOwned(Target)));
+  if (Executor)
+    Thunk->addAttr(Executor->clone(S.Context));
+  SmallVector<ParmVarDecl *, 4> Params;
+  for (unsigned I = 0; I != Types.size(); ++I) {
+    auto *Param = ParmVarDecl::Create(
+        S.Context, Thunk, Loc, Loc,
+        &S.Context.Idents.get("argument" + std::to_string(I)), Types[I],
+        S.Context.getTrivialTypeSourceInfo(Types[I], Loc), SC_None, nullptr);
+    Param->setImplicit();
+    if (ParameterInfos[I].isConsumed())
+      Param->addAttr(NSConsumedAttr::CreateImplicit(S.Context));
+    Thunk->addDecl(Param);
+    Params.push_back(Param);
+  }
+  Thunk->setParams(Params);
+  Thunk->getLexicalDeclContext()->addDecl(Thunk);
+  {
+    Sema::SynthesizedFunctionScope Scope(S, Thunk);
+    SmallVector<Expr *, 4> Arguments;
+    for (auto *Param : Params) {
+      Expr *Argument = S.BuildDeclRefExpr(Param, Param->getType(), VK_LValue, Loc);
+      // The frame already owns an independent value parameter. Move that
+      // value into the target call rather than requiring another C++ copy.
+      if (S.getLangOpts().CPlusPlus && Param->getType()->isRecordType())
+        Argument = ImplicitCastExpr::Create(
+            S.Context, Param->getType(), CK_NoOp, Argument, nullptr,
+            VK_XValue, FPOptionsOverride());
+      Arguments.push_back(Argument);
+    }
+    ExprResult Value;
+    if (Message && !HasReceiver) {
+      Value = S.ObjC().BuildClassMessageImplicit(
+          Message->getClassReceiver(), false, Loc, Message->getSelector(),
+          const_cast<ObjCMethodDecl *>(cast<ObjCMethodDecl>(Target)), Arguments);
+    } else if (Message) {
+      ExprResult Receiver = S.DefaultLvalueConversion(Arguments.front());
+      if (Receiver.isInvalid())
+        return nullptr;
+      Value = S.ObjC().BuildInstanceMessageImplicit(
+          Receiver.get(), Receiver.get()->getType(), Loc,
+          Message->getSelector(),
+          const_cast<ObjCMethodDecl *>(cast<ObjCMethodDecl>(Target)),
+          MutableArrayRef<Expr *>(Arguments).drop_front());
+      if (!Value.isInvalid() && SuperContext) {
+        auto *Built = cast<ObjCMessageExpr>(
+            Value.get()->IgnoreImplicit()->IgnoreParenImpCasts());
+        Built->setSuper(Message->getSuperLoc(), Message->getSuperType(),
+                        Message->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+      }
+    } else {
+      auto *Function = const_cast<FunctionDecl *>(cast<FunctionDecl>(Target));
+      ExprResult Callee = S.BuildDeclRefExpr(Function, Function->getType(),
+                                             VK_LValue, Source->getExprLoc());
+      Value = S.BuildCallExpr(nullptr, Callee.get(), Loc, Arguments, Loc);
+    }
+    if (Value.isInvalid())
+      return nullptr;
+    if (Original->getObjC3FunctionEffects().Async) {
+      Value = S.ActOnObjC3CAwaitExpr(Loc, Value.get());
+      if (Value.isInvalid())
+        return nullptr;
+    }
+    if (Info.ObjC3Effects.Throws != ObjC3ThrowsKind::None) {
+      Value = S.ActOnObjC3TryExpr(
+          static_cast<unsigned>(ObjC3TryExpr::Kind::Propagate), Loc, Loc,
+          Value.get(), Loc);
+      if (Value.isInvalid())
+        return nullptr;
+    }
+    Value = S.ActOnFinishFullExpr(Value.get(), Loc, false);
+    if (Value.isInvalid())
+      return nullptr;
+    // This is a native frame body even in C++; its return must remain an
+    // ordinary ReturnStmt rather than constructing a language coroutine.
+    Stmt *Return = ReturnStmt::Create(S.Context, Loc, Value.get(), nullptr);
+    Thunk->setBody(CompoundStmt::Create(S.Context, {Return},
+                                        FPOptionsOverride(), Loc, Loc));
+    if (checkObjC3CAsyncBody(S, Thunk, Thunk->getBody())) {
+      Thunk->setInvalidDecl();
+      return nullptr;
+    }
+  }
+  S.Consumer.HandleTopLevelDecl(DeclGroupRef(Thunk));
+  return Thunk;
+}
+
+bool sameCurrentActor(const Decl *Callable, const ObjCMessageExpr *Message) {
+  const auto *Method = dyn_cast<ObjCMethodDecl>(Callable);
+  if (!Method || !isObjC3ActorIsolated(Method))
+    return false;
+  if (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance)
+    return true;
+  const auto *Receiver = Message->getInstanceReceiver();
+  if (!Receiver)
+    return false;
+  const auto *Reference =
+      dyn_cast<DeclRefExpr>(Receiver->IgnoreParenImpCasts());
+  return Reference && Reference->getDecl() == Method->getSelfDecl();
+}
+
+bool unsupportedIsolatedConsumption(const Sema &S, const ParmVarDecl *Parameter) {
+  const bool ARCConsumed = S.getLangOpts().ObjCAutoRefCount &&
+      Parameter->getType()->isObjCRetainableType();
+  return (Parameter->hasAttr<NSConsumedAttr>() && !ARCConsumed) ||
+         Parameter->hasAttr<CFConsumedAttr>() ||
+         Parameter->hasAttr<ObjCResourceAttr>() ||
+         Parameter->getType()->isReferenceType();
+}
+
+Expr *uninitializeConsumedArgument(Expr *Argument) {
+  // Source calls have already undergone consumed-parameter initialization.
+  // The adopting thunk redoes that initialization for its own consumed ABI;
+  // retaining the first ARCProduceObject would manufacture a second +1.
+  if (auto *Cast = dyn_cast<ImplicitCastExpr>(Argument);
+      Cast && Cast->getCastKind() == CK_ARCProduceObject)
+    return Cast->getSubExpr();
+  return Argument;
+}
+
+const FunctionProtoType *isolationCalleeFunctionType(Sema &S,
+                                                     const Decl *Target) {
+  if (const auto *Type = getObjC3CallableFunctionType(Target))
+    return Type;
+  // Ordinary synchronous methods intentionally need no stored effect type.
+  // Form their logical signature without mutating declaration identity.
+  if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Target)) {
+    SmallVector<QualType, 4> Types;
+    for (const auto *Parameter : Method->parameters())
+      Types.push_back(Parameter->getType());
+    FunctionProtoType::ExtProtoInfo Info;
+    Info.Variadic = Method->isVariadic();
+    Info.ObjC3Effects = Method->getObjC3FunctionEffects();
+    return S.Context.getFunctionType(Method->getReturnType(), Types, Info)
+        ->castAs<FunctionProtoType>();
+  }
+  return nullptr;
+}
+} // namespace
+
+ExprResult Sema::BuildObjC3IsolationAwaitOperand(SourceLocation Loc,
+                                                 Expr *Operand) {
+  auto *Source = Operand->IgnoreImplicit()->IgnoreParenImpCasts();
+  auto *Call = dyn_cast<CallExpr>(Source);
+  auto *Message = dyn_cast<ObjCMessageExpr>(Source);
+  const Decl *Target = Call      ? static_cast<const Decl *>(Call->getDirectCallee())
+                       : Message ? Message->getMethodDecl()
+                                 : nullptr;
+  auto *Callable = Decl::castFromDeclContext(CurContext);
+  const auto *Executor = getObjC3Executor(Target);
+  const auto *Current = getObjC3Executor(Callable);
+  bool ActorEntry = Message && isObjC3ActorIsolated(Target);
+  bool Crossing = (ActorEntry && !sameCurrentActor(Callable, Message)) ||
+                  (Executor && (!Current || Current->getExecutor() !=
+                                                Executor->getExecutor()));
+  const auto *FT = isolationCalleeFunctionType(*this, Target);
+  if (!Crossing || !FT ||
+      (!getLangOpts().CPlusPlus && FT->getObjC3FunctionEffects().Async &&
+       !FT->getObjC3FunctionEffects().AsyncFrame)) {
+    if (DiagnoseObjC3AwaitIsolation(Operand))
+      return ExprError();
+    return Operand;
+  }
+  ObjCMethodDecl *SuperContext = nullptr;
+  Expr *SourceReceiver = Message ? Message->getInstanceReceiver() : nullptr;
+  if (Message && (Message->getReceiverKind() == ObjCMessageExpr::SuperInstance ||
+                  Message->getReceiverKind() == ObjCMessageExpr::SuperClass)) {
+    SuperContext = getCurMethodDecl();
+    if (SuperContext)
+      SourceReceiver = BuildDeclRefExpr(SuperContext->getSelfDecl(),
+          SuperContext->getSelfDecl()->getType(), VK_LValue, Message->getSuperLoc());
+  }
+  SmallVector<Expr *, 4> SourceArguments;
+  if (Call)
+    llvm::append_range(SourceArguments, Call->arguments());
+  else
+    llvm::append_range(SourceArguments, Message->arguments());
+  // Preserve pre-call argument evaluation on the caller. A nested crossing is
+  // never authorized merely because the outer call has an explicit await.
+  IsolationBodyChecker Arguments(*this, Callable, true);
+  if (SourceReceiver)
+    Arguments.Visit(SourceReceiver);
+  for (auto *Argument : SourceArguments)
+    Arguments.Visit(Argument);
+  if (Arguments.failed())
+    return ExprError();
+  bool Shape = !FT->isVariadic() &&
+               FT->getNumParams() == SourceArguments.size() &&
+               isolationFrameValue(*this, FT->getReturnType(), true) &&
+               (!getLangOpts().CPlusPlus || FT->isNothrow() ||
+                Target->hasAttr<NoThrowAttr>());
+  for (QualType T : FT->param_types())
+    Shape &= isolationFrameValue(*this, T, false);
+  if (Call) {
+    Shape &= !isa<CXXMethodDecl>(Target) &&
+             isa<DeclRefExpr>(Call->getCallee()->IgnoreParenImpCasts());
+    for (const auto *Parameter : cast<FunctionDecl>(Target)->parameters())
+      Shape &= !unsupportedIsolatedConsumption(*this, Parameter);
+  } else {
+    const bool Instance =
+        Message->getReceiverKind() == ObjCMessageExpr::Instance ||
+        (SuperContext && Message->getReceiverKind() == ObjCMessageExpr::SuperInstance);
+    const bool NamedClass =
+        Message->getReceiverKind() == ObjCMessageExpr::Class ||
+        (SuperContext && Message->getReceiverKind() == ObjCMessageExpr::SuperClass);
+    Shape &=
+        ((Instance &&
+          SourceReceiver->getType()->isObjCObjectPointerType()) ||
+         (NamedClass && !Target->hasAttr<NSConsumesSelfAttr>())) &&
+        (!Target->hasAttr<NSConsumesSelfAttr>() || getLangOpts().ObjCAutoRefCount) &&
+        cast<ObjCMethodDecl>(Target)->getMethodFamily() != OMF_init;
+    for (const auto *Parameter : cast<ObjCMethodDecl>(Target)->parameters())
+      Shape &= !unsupportedIsolatedConsumption(*this, Parameter);
+  }
+  if (!Shape) {
+    Diag(Loc, diag::err_objc3_isolation_hop_shape);
+    Diag(Target->getLocation(), diag::note_objc3_sendable_boundary);
+    return ExprError();
+  }
+  bool Failed = false;
+  if (SourceReceiver && Message->getReceiverKind() != ObjCMessageExpr::SuperClass)
+    Failed |= checkTransfer(*this, transferSource(SourceReceiver)->getType(),
+                            SourceReceiver->getExprLoc(), "isolated receiver", Target);
+  for (const Expr *Argument : SourceArguments)
+    Failed |=
+        checkTransfer(*this, transferSource(Argument)->getType(),
+                      Argument->getExprLoc(), "isolated argument", Target);
+  Failed |=
+      checkTransfer(*this, FT->getReturnType(), Loc, "isolated result", Target);
+  if (FT->getObjC3FunctionEffects().Throws == ObjC3ThrowsKind::Typed)
+    Failed |= checkTransfer(*this, FT->getObjC3FunctionEffects().ErrorType, Loc,
+                            "isolated checked error", Target);
+  if (Failed)
+    return ExprError();
+  if (getLangOpts().ObjCAutoRefCount) {
+    ArrayRef<ParmVarDecl *> Parameters = Message
+        ? cast<ObjCMethodDecl>(Target)->parameters()
+        : cast<FunctionDecl>(Target)->parameters();
+    for (unsigned I = 0; I != Parameters.size(); ++I)
+      if (Parameters[I]->hasAttr<NSConsumedAttr>())
+        SourceArguments[I] = uninitializeConsumedArgument(SourceArguments[I]);
+  }
+  auto *Thunk =
+      buildIsolationThunk(*this, Source, SourceReceiver, Target, FT, Executor,
+                          ActorEntry, SuperContext, Loc);
+  if (!Thunk)
+    return ExprError();
+  ExprResult Callee = BuildDeclRefExpr(Thunk, Thunk->getType(), VK_LValue, Loc);
+  // Bind source-order arguments (and a message receiver) before lazy frame
+  // creation. CodeGen acquires each retainable operand independently in both
+  // ownership modes; later arguments cannot invalidate an evaluated value.
+  SmallVector<Expr *, 4> Semantics;
+  SmallVector<Expr *, 4> Captures;
+  auto Capture = [&](Expr *Value) {
+    ExprResult Loaded = DefaultFunctionArrayLvalueConversion(Value);
+    if (Loaded.isInvalid()) return false;
+    Value = Loaded.get();
+    if (Value->getType()->isObjCRetainableType())
+      Cleanup.setExprNeedsCleanups(true);
+    auto *Opaque = new (Context)
+        OpaqueValueExpr(Value->getExprLoc(), Value->getType(),
+                        Value->getValueKind(), Value->getObjectKind(), Value);
+    Semantics.push_back(Opaque);
+    Captures.push_back(Opaque);
+    return true;
+  };
+  if (SourceReceiver &&
+      !Capture(Target->hasAttr<NSConsumesSelfAttr>()
+                   ? uninitializeConsumedArgument(SourceReceiver)
+                   : SourceReceiver))
+    return ExprError();
+  for (auto *Argument : SourceArguments)
+    if (!Capture(Argument))
+      return ExprError();
+  ExprResult Frame = BuildCallExpr(nullptr, Callee.get(), Loc, Captures, Loc);
+  if (Frame.isInvalid())
+    return ExprError();
+  unsigned ResultIndex = Semantics.size();
+  Semantics.push_back(Frame.get());
+  return PseudoObjectExpr::Create(Context, Source, Semantics, ResultIndex);
+}
+
+bool Sema::isObjC3NonSuspendingAwait(Expr *Operand) {
+  if (!Operand || Operand->isTypeDependent())
+    return false;
+  if (getLangOpts().CPlusPlus) {
+    QualType T = Operand->getType();
+    if (!T->isVoidType() && !T->isArithmeticType() && !T->isPointerType() &&
+        !T->isNullPtrType() && !T->isObjCObjectPointerType() &&
+        !T->isBlockPointerType())
+      return false;
+    if (T->isEnumeralType())
+      return false; // May have ADL operator co_await.
+  }
+  NonSuspendingAwaitProof Proof(Context);
+  Proof.Visit(Operand);
+  return Proof.Proven;
+}
+
+ExprResult Sema::ActOnObjC3NonSuspendingAwait(SourceLocation Loc,
+                                              Expr *Operand) {
+  if (getLangOpts().ObjC3StrictConcurrency)
+    Diag(Loc, diag::warn_objc3_unnecessary_c_await);
+  return Operand;
+}
