+TEST(ObjC3ConditionCFG, MatchAndCoalesceSelectArmsBeforeCleanup) {
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    typedef Optional(int) Maybe;
+    void first() noexcept;
+    void armCleanup() noexcept;
+    int one() noexcept;
+    int two() noexcept;
+    int none() noexcept;
+    bool predicate(int) noexcept;
+    Maybe *source() noexcept;
+    int fallback() noexcept;
+    Maybe fallbackCarrier() noexcept;
+    id fallbackReference() noexcept;
+    void work();
+    struct Local { Local() noexcept; ~Local() noexcept; };
+    struct Temporary { Temporary() noexcept; ~Temporary() noexcept; };
+    int number(const Temporary &);
+    bool predicateTemporary(const Temporary &);
+    void boolean_expression(bool value) {
+      defer { first(); }
+      (void)__objc3_match(value) {
+        case true => one();
+        case false => two();
+      };
+    }
+    void optional_expression() {
+      defer { first(); }
+      (void)__objc3_match(*source()) {
+        case .Some(let payload) => one();
+        case .None => none();
+      };
+    }
+    void guarded_optional() {
+      defer { first(); }
+      __objc3_match_stmt(*source()) {
+        case .Some(let payload) where predicate(payload): {
+          defer { armCleanup(); }
+          one();
+        }
+        case .Some(var payload): { two(); }
+        case .None: { none(); }
+      }
+    }
+    void selected_local_cleanup(bool value) {
+      defer { first(); }
+      __objc3_match_stmt(value) {
+        case true: {
+          defer { armCleanup(); }
+          Local local;
+          one();
+        }
+        case false: { two(); }
+      }
+    }
+    void throwing_selected_arm(bool value) {
+      try {
+        defer { first(); }
+        __objc3_match_stmt(value) {
+          case true: { Local local; work(); }
+          case false: { two(); }
+        }
+      } catch (...) { none(); }
+    }
+    void arm_temporary(bool value) {
+      try {
+        defer { first(); }
+        (void)__objc3_match(value) {
+          case true => number(Temporary());
+          case false => two();
+        };
+      } catch (...) { none(); }
+    }
+    void guard_temporary() {
+      try {
+        defer { first(); }
+        __objc3_match_stmt(*source()) {
+          case .Some(_) where predicateTemporary(Temporary()): { one(); }
+          case .Some(_): { two(); }
+          case .None: { none(); }
+        }
+      } catch (...) { armCleanup(); }
+    }
+    void scalar_coalesce() {
+      defer { first(); }
+      (void)(*source() ?? fallback());
+    }
+    void carrier_coalesce() {
+      defer { first(); }
+      Maybe value = *source() ?? fallbackCarrier();
+    }
+    void reference_coalesce(id value) {
+      defer { first(); }
+      (void)(value ?? fallbackReference());
+    }
+    template<class T> int template_coalesce(Optional(T) *value) {
+      defer { first(); }
+      return *value ?? fallback();
+    }
+    template int template_coalesce<int>(Optional(int) *);
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+         "-fobjc-runtime=gnustep-2.2", "-fexceptions", "-fcxx-exceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  const std::map<std::string, std::set<std::string>> Expected = {
+      {"boolean_expression", {"one,first,", "two,first,"}},
+      {"optional_expression", {"source,one,first,", "source,none,first,"}},
+      {"guarded_optional",
+       {"source,predicate,one,armCleanup,first,",
+        "source,predicate,two,first,", "source,none,first,"}},
+      {"selected_local_cleanup",
+       {"+Local,one,-Local,armCleanup,first,", "two,first,"}},
+      {"throwing_selected_arm",
+       {"+Local,work,-Local,first,", "+Local,work,-Local,first,none,",
+        "two,first,"}},
+      {"arm_temporary",
+       {"+Temporary,number,-Temporary,first,",
+        "+Temporary,number,-Temporary,first,none,", "two,first,"}},
+      {"guard_temporary",
+       {"source,+Temporary,predicateTemporary,-Temporary,one,first,",
+        "source,+Temporary,predicateTemporary,-Temporary,two,first,",
+        "source,+Temporary,predicateTemporary,-Temporary,first,armCleanup,",
+        "source,none,first,"}},
+      {"scalar_coalesce", {"source,first,", "source,fallback,first,"}},
+      {"carrier_coalesce", {"source,first,", "source,fallbackCarrier,first,"}},
+      {"reference_coalesce", {"first,", "fallbackReference,first,"}},
+      {"template_coalesce", {"first,", "fallback,first,"}}};
+  std::set<const FunctionDecl *> Functions;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    if (auto *Function = dyn_cast<FunctionDecl>(D)) {
+      if (Function->hasBody())
+        Functions.insert(Function);
+    } else if (auto *Template = dyn_cast<FunctionTemplateDecl>(D)) {
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      EXPECT_FALSE(CFG::buildCFG(Template->getTemplatedDecl(),
+                                Template->getTemplatedDecl()->getBody(),
+                                &AST->getASTContext(), Options));
+      for (FunctionDecl *Specialization : Template->specializations())
+        Functions.insert(Specialization);
+    }
+  }
+  for (const FunctionDecl *Function : Functions) {
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool Markers : {false, true}) {
+      SCOPED_TRACE(Markers);
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      Options.AddRichCXXConstructors = Options.AddLifetime = Options.AddScopes =
+          Markers;
+      Options.setAllAlwaysAdd();
+      auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                                 &AST->getASTContext(), Options);
+      ASSERT_TRUE(Graph);
+      std::set<std::string> Paths;
+      std::function<void(const CFGBlock *, std::string, unsigned)> Visit =
+          [&](const CFGBlock *Block, std::string Events, unsigned Depth) {
+            ASSERT_LT(Depth, 160u);
+            for (const auto &Element : *Block) {
+              if (auto Destructor = Element.getAs<CFGImplicitDtor>()) {
+                const auto *Function =
+                    Destructor->getDestructorDecl(AST->getASTContext());
+                ASSERT_TRUE(Function);
+                Events += "-" + Function->getParent()->getNameAsString() + ",";
+              } else if (auto Statement = Element.getAs<CFGStmt>()) {
+                if (const auto *Constructor =
+                        dyn_cast<CXXConstructExpr>(Statement->getStmt()))
+                  Events += "+" + Constructor->getConstructor()
+                                      ->getParent()->getNameAsString() + ",";
+                else if (const auto *Call =
+                             dyn_cast<CallExpr>(Statement->getStmt()))
+                  if (const auto *Callee = Call->getDirectCallee())
+                    Events += Callee->getNameAsString() + ",";
+              }
+            }
+            if (Block->isNativeExceptionExit())
+              Events += "unwind,";
+            if (Block->hasNoReturnElement())
+              Events += "terminate,";
+            if (Block == &Graph->getExit())
+              Paths.insert(Events);
+            else
+              for (const auto &Edge : Block->succs())
+                if (const auto *Next = Edge.getReachableBlock())
+                  Visit(Next, Events, Depth + 1);
+          };
+      Visit(&Graph->getEntry(), "", 0);
+      EXPECT_EQ(Expected.at(Function->getNameAsString()), Paths);
+    }
+  }
+  EXPECT_EQ(Expected.size(), Functions.size());
