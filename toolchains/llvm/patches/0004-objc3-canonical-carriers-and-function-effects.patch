diff --git a/clang/lib/Sema/SemaObjC3CarrierTransfer.cpp b/clang/lib/Sema/SemaObjC3CarrierTransfer.cpp
new file mode 100644
index 000000000..1e13acaad
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3CarrierTransfer.cpp
@@ -0,0 +1,214 @@
+//===--- SemaObjC3CarrierTransfer.cpp - carrier transfer semantics -------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/TypeBase.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Initialization.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/SmallPtrSet.h"
+
+using namespace clang;
+
+namespace {
+
+bool containsNestedCarrierOrManagedField(ASTContext &Context, QualType Type,
+                                         llvm::SmallPtrSetImpl<const RecordDecl *> &Seen) {
+  if (Type.isNull())
+    return true;
+  Type = Context.getCanonicalType(Type);
+  const clang::Type *Ty = Type.getTypePtr();
+  if (Ty->isObjCObjectPointerType() || Ty->isBlockPointerType() ||
+      Ty->isObjCObjectType() || Type.getObjCLifetime() != Qualifiers::OCL_None)
+    return true;
+  if (isa<ObjC3OptionalType>(Ty) || isa<ObjC3ResultType>(Ty))
+    return true;
+  if (const auto *Array = Context.getAsArrayType(Type))
+    return containsNestedCarrierOrManagedField(Context, Array->getElementType(),
+                                               Seen);
+  if (const auto *RT = Type->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl()->getDefinition();
+    if (!RD || !RD->isCompleteDefinition())
+      return true;
+    if (!Seen.insert(cast<RecordDecl>(RD->getCanonicalDecl())).second)
+      return false;
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(RD))
+      for (const CXXBaseSpecifier &Base : CXX->bases())
+        if (containsNestedCarrierOrManagedField(Context, Base.getType(), Seen))
+          return true;
+    for (const FieldDecl *Field : RD->fields())
+      if (containsNestedCarrierOrManagedField(Context, Field->getType(), Seen))
+        return true;
+  }
+  return false;
+}
+
+OpaqueValueExpr *makeCarrierPayloadSource(Sema &S, FieldDecl *Field,
+                                          QualType SourceCarrierType,
+                                          bool IsMove,
+                                          SourceLocation Loc) {
+  if (!Field || Field->getType()->isVoidType())
+    return nullptr;
+  QualType PayloadType = S.Context.getQualifiedType(
+      Field->getType(), SourceCarrierType.getQualifiers());
+  return new (S.Context) OpaqueValueExpr(
+      Loc, PayloadType, IsMove ? VK_XValue : VK_LValue, OK_Ordinary);
+}
+
+ExprResult buildArmInitialization(Sema &S, SourceLocation Loc,
+                                  FieldDecl *DestinationField,
+                                  OpaqueValueExpr *SourceLeaf) {
+  if (!DestinationField || DestinationField->getType()->isVoidType())
+    return ExprResult();
+  if (!SourceLeaf)
+    return ExprError();
+  if (S.getLangOpts().ObjCAutoRefCount &&
+      isa<ObjC3OptionalType, ObjC3ResultType>(
+          DestinationField->getType().getCanonicalType().getTypePtr()))
+    return S.ActOnObjC3CarrierTransferExpr(SourceLeaf->isXValue(), Loc, Loc,
+                                          SourceLeaf, Loc);
+  InitializedEntity Entity =
+      InitializedEntity::InitializeMember(DestinationField);
+  InitializationKind InitKind = InitializationKind::CreateCopy(Loc, Loc);
+  Expr *Args[] = {SourceLeaf};
+  InitializationSequence Sequence(S, Entity, InitKind, Args);
+  return Sequence.Perform(S, Entity, InitKind, Args);
+}
+
+} // namespace
+
+ExprResult Sema::ActOnObjC3CarrierTransferExpr(bool IsMove,
+                                              SourceLocation KeywordLoc,
+                                              SourceLocation LParenLoc,
+                                              Expr *Source,
+                                              SourceLocation RParenLoc) {
+  const char *Name = IsMove ? "moveValue" : "copyValue";
+  if (!Source)
+    return ExprError();
+  if (!getLangOpts().CPlusPlus) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_transfer_requires_cpp) << Name;
+    return ExprError();
+  }
+
+  ExprResult Checked = CheckPlaceholderExpr(Source);
+  if (Checked.isInvalid())
+    return ExprError();
+  Source = Checked.get();
+
+  if (Source->isTypeDependent() || Source->getType()->isDependentType()) {
+    QualType DependentCarrier = Source->getType();
+    return ObjC3CarrierTransferExpr::Create(
+        Context, IsMove ? ObjC3CarrierTransferExpr::Kind::Move
+                        : ObjC3CarrierTransferExpr::Kind::Copy,
+        DependentCarrier, Source, nullptr, nullptr, nullptr, nullptr, nullptr,
+        nullptr, KeywordLoc, LParenLoc, RParenLoc);
+  }
+
+  QualType SourceCarrierType = Context.getCanonicalType(Source->getType());
+  QualType CarrierType = SourceCarrierType.getUnqualifiedType();
+  const Type *Canonical = CarrierType.getTypePtr();
+  const bool IsOptional = isa<ObjC3OptionalType>(Canonical);
+  const bool IsResult = isa<ObjC3ResultType>(Canonical);
+  if (!IsOptional && !IsResult) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_transfer_requires_carrier)
+        << Name << Source->getType();
+    return ExprError();
+  }
+  if (!Source->isGLValue()) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_transfer_requires_glvalue) << Name;
+    return ExprError();
+  }
+  if (!IsMove && !Source->isLValue()) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_copy_requires_lvalue);
+    return ExprError();
+  }
+  if (Source->getType().isVolatileQualified()) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_transfer_volatile);
+    return ExprError();
+  }
+
+  ObjC3CarrierRepresentationInfo Representation =
+      Context.getObjC3CarrierRepresentationType(CarrierType);
+  if (Representation.State !=
+      ObjC3CarrierRepresentationInfo::Status::Materialized) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_payload_unsupported)
+        << Source->getType();
+    return ExprError();
+  }
+
+  llvm::SmallPtrSet<const RecordDecl *, 8> Seen;
+  for (FieldDecl *Field : {Representation.ValueField,
+                           Representation.SuccessField,
+                           Representation.ErrorField}) {
+    if (!Field || Field->getType()->isVoidType())
+      continue;
+    QualType Payload = Field->getType();
+    if (getLangOpts().ObjCAutoRefCount &&
+        isa<ObjC3OptionalType, ObjC3ResultType>(Payload.getCanonicalType().getTypePtr()))
+      continue;
+    // A direct ARC leaf uses the same native member-initialization recipe as
+    // an ordinary strong, weak or unsafe Objective-C/Block field. Do not admit
+    // managed subobjects hidden inside a C/C++ aggregate or nested carrier.
+    const bool IsARCPointer = getLangOpts().ObjCAutoRefCount &&
+        (Payload->isObjCObjectPointerType() || Payload->isBlockPointerType()) &&
+        (Payload.getObjCLifetime() == Qualifiers::OCL_Strong ||
+         Payload.getObjCLifetime() == Qualifiers::OCL_Weak ||
+         Payload.getObjCLifetime() == Qualifiers::OCL_ExplicitNone);
+    if (IsARCPointer)
+      continue;
+    Seen.clear();
+    if (containsNestedCarrierOrManagedField(Context, Field->getType(), Seen)) {
+      Diag(KeywordLoc, diag::err_objc3_carrier_payload_unsupported)
+          << Field->getType();
+      return ExprError();
+    }
+  }
+
+  OpaqueValueExpr *ValueSource = makeCarrierPayloadSource(
+      *this, Representation.ValueField, Source->getType(), IsMove, KeywordLoc);
+  OpaqueValueExpr *SuccessSource = makeCarrierPayloadSource(
+      *this, Representation.SuccessField, Source->getType(), IsMove, KeywordLoc);
+  OpaqueValueExpr *ErrorSource = makeCarrierPayloadSource(
+      *this, Representation.ErrorField, Source->getType(), IsMove, KeywordLoc);
+
+  Expr *ValueInit = nullptr;
+  Expr *SuccessInit = nullptr;
+  Expr *ErrorInit = nullptr;
+  if (Representation.ValueField && ValueSource) {
+    ExprResult Init = buildArmInitialization(*this, KeywordLoc,
+                                             Representation.ValueField,
+                                             ValueSource);
+    if (Init.isInvalid())
+      return ExprError();
+    ValueInit = Init.get();
+  }
+  if (Representation.SuccessField && SuccessSource) {
+    ExprResult Init = buildArmInitialization(*this, KeywordLoc,
+                                             Representation.SuccessField,
+                                             SuccessSource);
+    if (Init.isInvalid())
+      return ExprError();
+    SuccessInit = Init.get();
+  }
+  if (Representation.ErrorField && ErrorSource) {
+    ExprResult Init = buildArmInitialization(*this, KeywordLoc,
+                                             Representation.ErrorField,
+                                             ErrorSource);
+    if (Init.isInvalid())
+      return ExprError();
+    ErrorInit = Init.get();
+  }
+
+  ExprResult Result = ObjC3CarrierTransferExpr::Create(
+      Context, IsMove ? ObjC3CarrierTransferExpr::Kind::Move
+                      : ObjC3CarrierTransferExpr::Kind::Copy,
+      CarrierType, Source, ValueSource, ValueInit, SuccessSource, SuccessInit,
+      ErrorSource, ErrorInit, KeywordLoc, LParenLoc, RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  CheckCompletedExpr(Result.get(), RParenLoc);
+  return Result;
+}
diff --git a/clang/lib/Sema/SemaObjC3Carriers.cpp b/clang/lib/Sema/SemaObjC3Carriers.cpp
new file mode 100644
index 000000000..6cf24a68c
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3Carriers.cpp
@@ -0,0 +1,118 @@
+//===--- SemaObjC3Carriers.cpp - ObjC3 carrier type admission -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/TypeLoc.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "SemaObjC3CarrierARC.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+
+/// Type signatures may retain dependent and incomplete payloads; their native
+/// representation is deferred until a complete definition is available.
+/// `void` is a supported no-payload arm. All other non-object, array, and
+/// variably-modified shapes remain unsupported by the current layout contract.
+bool isAdmittedCarrierPayload(ASTContext &Context, QualType Payload) {
+  if (Payload.isNull())
+    return false;
+  if (Payload->isVoidType())
+    return true;
+  // These shapes are unsupported independently of their element/return type.
+  // Reject them even when that nested type is dependent; waiting for template
+  // substitution would otherwise admit a carrier whose payload shape can never
+  // have a supported native representation.
+  if (Payload->isArrayType() || Payload->isVariablyModifiedType() ||
+      Payload->isFunctionType() || Payload->isReferenceType())
+    return false;
+  if (Payload->isDependentType() || Payload->isIncompleteType())
+    return true;
+
+  const QualType Probe = Context.getObjC3OptionalType(Payload);
+  return Context.getObjC3CarrierRepresentationType(Probe).State !=
+         ObjC3CarrierRepresentationInfo::Status::Unsupported;
+}
+
+TypeSourceInfo *getChildTypeInfo(Sema &S, ParsedType Parsed, QualType &Type) {
+  TypeSourceInfo *Info = nullptr;
+  Type = S.GetTypeFromParser(Parsed, &Info);
+  if (Type.isNull())
+    return nullptr;
+  if (!Info)
+    Info = S.Context.getTrivialTypeSourceInfo(Type);
+  return Info;
+}
+
+} // namespace
+
+TypeResult Sema::ActOnObjC3OptionalType(SourceLocation KeywordLoc,
+                                        SourceLocation LParenLoc,
+                                        ParsedType ElementType,
+                                        SourceLocation RParenLoc) {
+  QualType Element;
+  TypeSourceInfo *ElementInfo = getChildTypeInfo(*this, ElementType, Element);
+  if (!ElementInfo)
+    return TypeError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, Element))
+    return TypeError();
+
+  QualType Carrier = Context.getObjC3OptionalType(Element);
+  if (!isAdmittedCarrierPayload(Context, Element)) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_payload_unsupported) << Element;
+    return TypeError();
+  }
+
+  TypeSourceInfo *CarrierInfo = Context.CreateTypeSourceInfo(Carrier);
+  auto Loc = CarrierInfo->getTypeLoc().getAs<ObjC3OptionalTypeLoc>();
+  Loc.setKeywordLoc(KeywordLoc);
+  Loc.setLParenLoc(LParenLoc);
+  Loc.setElementLoc(ElementInfo);
+  Loc.setRParenLoc(RParenLoc);
+  return CreateParsedType(Carrier, CarrierInfo);
+}
+
+TypeResult
+Sema::ActOnObjC3ResultType(SourceLocation KeywordLoc, SourceLocation LParenLoc,
+                           ParsedType SuccessType, SourceLocation CommaLoc,
+                           ParsedType ErrorType, SourceLocation RParenLoc) {
+  QualType Success;
+  TypeSourceInfo *SuccessInfo = getChildTypeInfo(*this, SuccessType, Success);
+  if (!SuccessInfo)
+    return TypeError();
+
+  QualType Error;
+  TypeSourceInfo *ErrorInfo = getChildTypeInfo(*this, ErrorType, Error);
+  if (!ErrorInfo)
+    return TypeError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, Success) ||
+      normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, Error))
+    return TypeError();
+
+  QualType Carrier = Context.getObjC3ResultType(Success, Error);
+  if (!isAdmittedCarrierPayload(Context, Success)) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_payload_unsupported) << Success;
+    return TypeError();
+  }
+  if (!isAdmittedCarrierPayload(Context, Error)) {
+    Diag(KeywordLoc, diag::err_objc3_carrier_payload_unsupported) << Error;
+    return TypeError();
+  }
+
+  TypeSourceInfo *CarrierInfo = Context.CreateTypeSourceInfo(Carrier);
+  auto Loc = CarrierInfo->getTypeLoc().getAs<ObjC3ResultTypeLoc>();
+  Loc.setKeywordLoc(KeywordLoc);
+  Loc.setLParenLoc(LParenLoc);
+  Loc.setSuccessLoc(SuccessInfo);
+  Loc.setCommaLoc(CommaLoc);
+  Loc.setErrorLoc(ErrorInfo);
+  Loc.setRParenLoc(RParenLoc);
+  return CreateParsedType(Carrier, CarrierInfo);
+}
diff --git a/clang/lib/Sema/SemaObjC3DoCatch.cpp b/clang/lib/Sema/SemaObjC3DoCatch.cpp
new file mode 100644
index 000000000..132028f71
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3DoCatch.cpp
@@ -0,0 +1,276 @@
+#include "SemaObjC3ErrorContext.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/Stmt.h"
+#include "clang/AST/Type.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Sema/SemaObjC.h"
+#include "llvm/ADT/STLExtras.h"
+
+namespace clang {
+
+struct ObjC3DoCatchContext {
+  struct ThrownFact {
+    ObjC3FunctionEffectInfo Effect;
+    SourceLocation Loc;
+  };
+  SourceLocation DoLoc;
+  DeclContext *Owner;
+  bool IsCatchBody = false;
+  size_t DeferDepth;
+  SmallVector<ThrownFact, 4> Facts;
+  explicit ObjC3DoCatchContext(SourceLocation Loc, DeclContext *Owner,
+                              bool CatchBody = false)
+      : DoLoc(Loc), Owner(Owner), IsCatchBody(CatchBody),
+        DeferDepth(0) {}
+};
+
+namespace {
+bool sameTypedEffect(Sema &S, const ObjC3FunctionEffectInfo &A,
+                     const ObjC3FunctionEffectInfo &B) {
+  return A.Throws == ObjC3ThrowsKind::Typed &&
+         B.Throws == ObjC3ThrowsKind::Typed &&
+         S.Context.hasSameType(S.Context.getCanonicalType(A.ErrorType),
+                               S.Context.getCanonicalType(B.ErrorType));
+}
+
+bool isErrorBridgeType(QualType T) {
+  const auto *Pointer = T->getAs<ObjCObjectPointerType>();
+  if (!Pointer)
+    return false;
+  const ObjCObjectType *Object = Pointer->getObjectType();
+  if (!Object->isObjCId())
+    return false;
+  // Extra protocol constraints narrow the pattern and do not form the
+  // universal Error bridge. They must match the observed static effect.
+  return Object->getNumProtocols() == 1 &&
+         (*Object->qual_begin())->getName() == "Error";
+}
+
+bool clauseMatches(Sema &S, const ObjC3CatchStmt &Clause,
+                   const ObjC3FunctionEffectInfo &Effect) {
+  if (Clause.isCatchAll())
+    return true;
+  TypeSourceInfo *Info = Clause.getCatchTypeInfo();
+  if (!Info || Effect.Throws == ObjC3ThrowsKind::None)
+    return false;
+  QualType CatchType = S.Context.getCanonicalType(Info->getType());
+  // An instantiated handler will re-record its protected-body effects and
+  // check the concrete pattern. Do not reject a potentially matching pattern
+  // while either its type or the thrown type is still dependent.
+  if (CatchType->isDependentType() ||
+      (!Effect.ErrorType.isNull() && Effect.ErrorType->isDependentType()))
+    return true;
+  if (isErrorBridgeType(CatchType))
+    return Effect.Throws == ObjC3ThrowsKind::Untyped ||
+           Effect.Throws == ObjC3ThrowsKind::Typed;
+  if (Effect.Throws == ObjC3ThrowsKind::Untyped || Effect.ErrorType.isNull())
+    return false;
+  QualType ThrownType = S.Context.getCanonicalType(Effect.ErrorType);
+  // Catch binding lifetime is storage policy, not part of the error pattern.
+  if (CatchType->isObjCObjectPointerType() &&
+      ThrownType->isObjCObjectPointerType()) {
+    CatchType = S.Context.getUnqualifiedObjCPointerType(CatchType);
+    ThrownType = S.Context.getUnqualifiedObjCPointerType(ThrownType);
+  }
+  return S.Context.hasSameType(CatchType, ThrownType);
+}
+
+bool compatibleOuterEffect(Sema &S, const ObjC3FunctionEffectInfo &Effect) {
+  ObjC3FunctionEffectInfo Outer = getCurrentObjC3CallableEffects(S);
+  if (Effect.Throws == ObjC3ThrowsKind::Untyped)
+    return Outer.Throws == ObjC3ThrowsKind::Untyped;
+  return sameTypedEffect(S, Effect, Outer);
+}
+
+bool reportUncaughtEffect(Sema &S,
+                          const ObjC3DoCatchContext::ThrownFact &Fact) {
+  if (compatibleOuterEffect(S, Fact.Effect))
+    return false;
+  S.Diag(Fact.Loc, diag::err_objc3_unhandled_error_effect);
+  return true;
+}
+} // namespace
+
+void Sema::PushObjC3DeferContext() {
+  ObjC3DeferOwnerStack.push_back(getCurrentObjC3CallableContext(*this));
+}
+
+void Sema::PopObjC3DeferContext() { ObjC3DeferOwnerStack.pop_back(); }
+
+ObjC3DoCatchContext *Sema::ActOnObjC3BeginDoCatch(SourceLocation DoLoc) {
+  auto *Context = new ObjC3DoCatchContext(
+      DoLoc, getCurrentObjC3CallableContext(*this));
+  Context->DeferDepth = ObjC3DeferOwnerStack.size();
+  ObjC3ErrorHandlerStack.push_back(Context);
+  return Context;
+}
+
+void Sema::ActOnObjC3EndDoCatchBody(ObjC3DoCatchContext *Context) {
+  assert(!ObjC3ErrorHandlerStack.empty() &&
+         ObjC3ErrorHandlerStack.back() == Context &&
+         "ObjC3 handler contexts must be properly nested");
+  ObjC3ErrorHandlerStack.pop_back();
+}
+
+void Sema::ActOnObjC3AbortDoCatch(ObjC3DoCatchContext *Context) {
+  if (!Context)
+    return;
+  if (!ObjC3ErrorHandlerStack.empty() &&
+      ObjC3ErrorHandlerStack.back() == Context)
+    ObjC3ErrorHandlerStack.pop_back();
+  delete Context;
+}
+
+ObjC3DoCatchContext *Sema::ActOnObjC3BeginCatchBody() {
+  auto *Context = new ObjC3DoCatchContext(
+      SourceLocation(), getCurrentObjC3CallableContext(*this), true);
+  Context->DeferDepth = ObjC3DeferOwnerStack.size();
+  ObjC3ErrorHandlerStack.push_back(Context);
+  return Context;
+}
+
+bool Sema::RecordObjC3ThrownEffect(const ObjC3FunctionEffectInfo &Effect,
+                                  SourceLocation Loc) {
+  bool HasHandler = !ObjC3ErrorHandlerStack.empty() &&
+      ObjC3ErrorHandlerStack.back()->Owner ==
+          getCurrentObjC3CallableContext(*this);
+  if (llvm::is_contained(ObjC3DeferOwnerStack,
+                         getCurrentObjC3CallableContext(*this)) &&
+      (!HasHandler ||
+       ObjC3ErrorHandlerStack.back()->DeferDepth < ObjC3DeferOwnerStack.size())) {
+    Diag(Loc, diag::err_objc3_error_exits_defer);
+    return true;
+  }
+  if (!HasHandler)
+    return false;
+  if (Effect.Throws != ObjC3ThrowsKind::None)
+    ObjC3ErrorHandlerStack.back()->Facts.push_back({Effect, Loc});
+  return true;
+}
+
+void Sema::ActOnObjC3EndCatchBody(ObjC3DoCatchContext *Context) {
+  assert(Context && Context->IsCatchBody &&
+         !ObjC3ErrorHandlerStack.empty() &&
+         ObjC3ErrorHandlerStack.back() == Context &&
+         "catch body contexts must be properly nested");
+  ObjC3ErrorHandlerStack.pop_back();
+  for (const auto &Fact : Context->Facts) {
+    if (RecordObjC3ThrownEffect(Fact.Effect, Fact.Loc))
+      continue;
+    reportUncaughtEffect(*this, Fact);
+  }
+  delete Context;
+}
+
+void Sema::ActOnObjC3AbortCatchBody(ObjC3DoCatchContext *Context) {
+  if (!Context)
+    return;
+  if (!ObjC3ErrorHandlerStack.empty() &&
+      ObjC3ErrorHandlerStack.back() == Context)
+    ObjC3ErrorHandlerStack.pop_back();
+  delete Context;
+}
+
+DeclStmt *Sema::ActOnObjC3CatchBinding(Scope *CatchScope, ParsedType CatchType,
+    SourceLocation CatchLoc, IdentifierInfo *Name, SourceLocation NameLoc) {
+  if (!Name)
+    return nullptr;
+  TypeSourceInfo *TypeInfo = nullptr;
+  QualType Type = GetTypeFromParser(CatchType, &TypeInfo);
+  if (Type.isNull() || !TypeInfo) {
+    Diag(NameLoc, diag::err_objc3_catch_binding_requires_type);
+    return nullptr;
+  }
+  if (!Type->isDependentType() && Type->isVoidType()) {
+    Diag(NameLoc, diag::err_objc3_catch_binding_requires_type);
+    return nullptr;
+  }
+  // Use native ARC inference for the lexical binding. CodeGen initializes
+  // it from the selected payload without adding a synthetic AST initializer.
+  VarDecl *Binding = VarDecl::Create(Context, CurContext, CatchLoc, NameLoc,
+      Name, Type, TypeInfo, SC_None);
+  if (getLangOpts().ObjCAutoRefCount &&
+      ObjC().inferObjCARCLifetime(Binding))
+    Binding->setInvalidDecl();
+  PushOnScopeChains(Binding, CatchScope);
+  auto *BindingStmt = new (Context) DeclStmt(DeclGroupRef(Binding), CatchLoc,
+                                              NameLoc);
+  return BindingStmt;
+}
+
+ObjC3CatchStmt *Sema::ActOnObjC3CatchClause(SourceLocation CatchLoc,
+    SourceLocation LParenLoc, ParsedType CatchType,
+    SourceLocation RParenLoc, DeclStmt *Binding, CompoundStmt *Body,
+    bool CatchAll) {
+  TypeSourceInfo *TypeInfo = nullptr;
+  if (!CatchAll) {
+    QualType Type = GetTypeFromParser(CatchType, &TypeInfo);
+    if (Type.isNull() || !TypeInfo)
+      return nullptr;
+  }
+  return ObjC3CatchStmt::Create(Context, CatchLoc, LParenLoc, RParenLoc,
+      TypeInfo, Binding, Body, CatchAll);
+}
+
+StmtResult Sema::ActOnObjC3FinishDoCatch(ObjC3DoCatchContext *Context,
+    CompoundStmt *Body, ArrayRef<ObjC3CatchStmt *> Clauses) {
+  if (!Context || !Body || Clauses.empty()) {
+    Diag(Context ? Context->DoLoc : SourceLocation(),
+         diag::err_objc3_do_catch_requires_clause);
+    ActOnObjC3AbortDoCatch(Context);
+    return StmtError();
+  }
+  SourceLocation DoLoc = Context->DoLoc;
+  setFunctionHasBranchProtectedScope();
+
+  bool Invalid = false;
+  for (const auto &Fact : Context->Facts) {
+    bool Matched = false;
+    for (ObjC3CatchStmt *Clause : Clauses) {
+      if (clauseMatches(*this, *Clause, Fact.Effect)) {
+        Matched = true;
+        break; // source order gives the specified first-match behavior
+      }
+    }
+    if (!Matched) {
+      // Once this handler's protected body has been popped, an enclosing
+      // ObjC3 do/catch receives the fact before callable compatibility is
+      // considered. Native C++ catch and ObjC @catch are not on this stack.
+      if (!RecordObjC3ThrownEffect(Fact.Effect, Fact.Loc)) {
+        Invalid |= reportUncaughtEffect(*this, Fact);
+      }
+    }
+  }
+
+  // A typed pattern must correspond to a statically observed typed effect, or
+  // be the explicit Error bridge. Do not invent general conversion matching.
+  for (ObjC3CatchStmt *Clause : Clauses) {
+    if (Clause->isCatchAll() || !Clause->getCatchTypeInfo())
+      continue;
+    QualType Type = Clause->getCatchTypeInfo()->getType();
+    if (isErrorBridgeType(Type))
+      continue;
+    bool Compatible = false;
+    for (const auto &Fact : Context->Facts)
+      Compatible |= clauseMatches(*this, *Clause, Fact.Effect);
+    if (!Compatible && !Context->Facts.empty()) {
+      QualType ThrownType = Context->Facts.front().Effect.ErrorType;
+      if (ThrownType.isNull())
+        Diag(Clause->getCatchLoc(), diag::err_objc3_catch_untyped_mismatch)
+            << Type;
+      else
+        Diag(Clause->getCatchLoc(), diag::err_objc3_catch_type_mismatch)
+            << Type << ThrownType;
+      Invalid = true;
+    }
+  }
+
+  delete Context;
+  if (Invalid)
+    return StmtError();
+  return ObjC3DoCatchStmt::Create(this->Context, DoLoc, Body, Clauses);
+}
+
+} // namespace clang
