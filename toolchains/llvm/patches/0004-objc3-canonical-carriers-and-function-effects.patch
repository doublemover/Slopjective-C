+      int64_t Index = Component.Index;
+      if (Component.Field) {
+        const auto *Record = E->getType()->getAs<RecordType>();
+        if (!Record) return false;
+        if (const auto *CXX = dyn_cast<CXXRecordDecl>(Record->getDecl()); CXX && CXX->getNumBases()) return false;
+        Index = 0;bool Found = false;
