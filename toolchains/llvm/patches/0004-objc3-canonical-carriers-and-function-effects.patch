+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// expected-no-diagnostics
+__attribute__((objc_root_class))
+@interface ConversionRoot
+@end
+__attribute__((objc_root_class))
+@interface OtherConversionRoot
+@end
+using Read = KeyPath<ConversionRoot *, int>;
+using Write = WritableKeyPath<ConversionRoot *, int>;
+static_assert(__is_convertible(Write, Read));
+static_assert(__is_convertible(const Write &, Read));
+static_assert(!__is_convertible(Read, Write));
+static_assert(!__is_convertible(Write, KeyPath<OtherConversionRoot *, int>));
+static_assert(!__is_convertible(Write, KeyPath<ConversionRoot *, long>));
+static_assert(!__is_convertible(
+    WritableKeyPath<ConversionRoot *, ConversionRoot * _Nullable>,
+    KeyPath<ConversionRoot *, ConversionRoot * _Nonnull>));
+static_assert(__is_trivially_copyable(Write));
+static_assert(__is_aggregate(Write));
+constexpr int choose(Read) { return 1; }
+constexpr int choose(Write) { return 2; }
+int only_read(Read);
+Write make_path();
+int use_native_overload_resolution() {
+  return choose(make_path()) + only_read(make_path());
+}
