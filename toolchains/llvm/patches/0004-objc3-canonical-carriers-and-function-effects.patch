diff --git a/clang/test/ObjC3/Sema/retainable-family-analyzer.m b/clang/test/ObjC3/Sema/retainable-family-analyzer.m
new file mode 100644
index 000000000..6d3e4516b
--- /dev/null
+++ b/clang/test/ObjC3/Sema/retainable-family-analyzer.m
@@ -0,0 +1,25 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -analyze -analyzer-checker=core,osx.cocoa.RetainCount -analyzer-output=text -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -analyze -analyzer-checker=core,osx.cocoa.RetainCount -analyzer-output=text -verify %s
+typedef struct FamilyObject *FamilyRef __attribute__((objc_retainable_family(Example)));
+FamilyRef create(void) __attribute__((cf_returns_retained));
+FamilyRef hold(FamilyRef value) __attribute__((objc_family_retain(Example)));
+void drop(FamilyRef value) __attribute__((objc_family_release(Example)));
+FamilyRef schedule(FamilyRef value) __attribute__((objc_family_autorelease(Example)));
+void use(FamilyRef value);
+void balanced(void) {
+  FamilyRef owner=create();
+  FamilyRef alias=hold(owner);
+  drop(owner);
+  use(alias);
+  drop(alias);
+}
+void over_release(void) {
+  FamilyRef owner=create(); // expected-note {{Call to function 'create' returns a Core Foundation object of type 'FamilyRef' with a +1 retain count}}
+  drop(owner); // expected-note {{Object released}}
+  drop(owner); // expected-warning {{Reference-counted object is used after it is released}} expected-note {{Reference-counted object is used after it is released}}
+}
+void autorelease_balance(void) {
+  FamilyRef owner=create();
+  FamilyRef alias=schedule(owner);
+  use(alias);
+}
