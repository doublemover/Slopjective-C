+  __objc3_do { __objc3_try([r value:1]); }
+  __objc3_catch(E error) { (void)error; }
+}
diff --git a/clang/test/ObjC3/Sema/typed-error-native-exception-boundaries.mm b/clang/test/ObjC3/Sema/typed-error-native-exception-boundaries.mm
new file mode 100644
index 000000000..93741b244
--- /dev/null
+++ b/clang/test/ObjC3/Sema/typed-error-native-exception-boundaries.mm
@@ -0,0 +1,41 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fexceptions -fcxx-exceptions -fobjc-exceptions -fsyntax-only -verify %s
+
+struct Error {};
+constexpr int typed_nothrow() noexcept __objc3_throws(Error) { return 7; }
+int typed_may_throw_cpp() noexcept(false) __objc3_throws(Error);
+int ordinary_may_throw_cpp() noexcept(false);
+
+// Slop typed throws is independent of the C++ exception specification.
+static_assert(noexcept(__objc3_try(typed_nothrow())));
+static_assert(!noexcept(__objc3_try(typed_may_throw_cpp())));
+
+int propagate_typed_error() __objc3_throws(Error) {
+  return __objc3_try(typed_nothrow());
+}
+
+void typed_catch_does_not_claim_native_cpp_catch() {
+  __objc3_do {
+    ordinary_may_throw_cpp();
+  } __objc3_catch(Error error) {
+    (void)error;
+  }
+}
+
+// Native C++ and Objective-C exception constructs remain distinct controls.
+void native_cpp_and_objc_controls() {
+  try {
+    ordinary_may_throw_cpp();
+  } catch (...) {
+  }
+  @try {
+    ordinary_may_throw_cpp();
+  } @catch (id error) {
+    (void)error;
+  }
+}
+
+
+constexpr int force_in_constant_evaluation() { // expected-error {{constexpr function never produces a constant expression}}
+  return __objc3_try_force(typed_nothrow()); // expected-note 2 {{subexpression not valid in a constant expression}}
+}
+static_assert(force_in_constant_evaluation() == 7); // expected-error {{not an integral constant expression}} expected-note {{in call to 'force_in_constant_evaluation()'}}
