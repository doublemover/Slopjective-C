diff --git a/clang/include/clang/AST/ObjC3SourceScopes.h b/clang/include/clang/AST/ObjC3SourceScopes.h
new file mode 100644
index 000000000..e71eca2f5
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3SourceScopes.h
@@ -0,0 +1,181 @@
+//===--- ObjC3SourceScopes.h - Scope owners for source actions -----*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3SOURCESCOPES_H
+#define LLVM_CLANG_AST_OBJC3SOURCESCOPES_H
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/AST/StmtObjC.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+
+namespace clang {
+/// Source owners are independent of incidental CodeGen cleanup scopes. In
+/// particular, a guard prefix is not a new source region and its snapshot is
+/// not a committed user local. Nested callable bodies have their own owners.
+struct ObjC3SourceScopes {
+  llvm::DenseMap<const VarDecl *, const Stmt *> Variables;
+  /// Literal capture storage belongs to the creation site, independently of
+  /// the captured declaration's owner and the nested Block body's scopes.
+  llvm::DenseMap<const BlockExpr *, const Stmt *> Blocks;
+  llvm::DenseMap<const DeferStmt *, const Stmt *> Defers;
+  llvm::SmallPtrSet<const Stmt *, 8> DeferredScopes;
+  /// Cleanup attributes register source actions even without a lexical defer.
+  /// Keep their owners separate from DeferredScopes: consumers that reason
+  /// about deferred bodies still need the narrower set.
+  llvm::SmallPtrSet<const Stmt *, 8> CleanupScopes;
+
+  explicit ObjC3SourceScopes(const Stmt *Body) { collect(Body, Body); }
+
+private:
+  void collectCondition(const Stmt *Condition, const Stmt *Owner,
+                        const Stmt *BindingOwner) {
+    if (const auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition)) {
+      Variables[Binding->getBindingDecl()] = BindingOwner;
+      collect(Binding->getSnapshotDecl()->getInit(), Owner);
+      collect(Binding->getBindingDecl()->getInit(), Owner);
+    } else {
+      collect(Condition, Owner);
+    }
+  }
+  void collect(const Stmt *S, const Stmt *Owner) {
+    if (!S)
+      return;
+    if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(S)) {
+      collect(Argument->getExpr(), Owner);
+      return;
+    }
+    if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(S)) {
+      collect(Initializer->getExpr(), Owner);
+      return;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(S)) {
+      for (const Expr *Capture : Lambda->capture_inits())
+        collect(Capture, Owner);
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(S)) {
+      Blocks[Block] = Owner;
+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        // Only the creation recipe executes here. CopyExpr is the heap-copy
+        // recipe when a separate move initializer is present.
+        collect(Capture.getObjC3InitExpr() ? Capture.getObjC3InitExpr()
+                                         : Capture.getCopyExpr(), Owner);
+      }
+      return;
+    }
+    if (isa<CompoundStmt>(S))
+      Owner = S;
+    if (const auto *Defer = dyn_cast<DeferStmt>(S)) {
+      Defers[Defer] = Owner;
+      DeferredScopes.insert(Owner);
+      CleanupScopes.insert(Owner);
+      collect(Defer->getBody(), Defer->getBody());
+      return;
+    }
+    if (const auto *Lifetime = dyn_cast<ObjC3LifetimeStmt>(S)) {
+      if (!Lifetime->isKeepAlive()) {
+        collect(Lifetime->getStorage(), Lifetime->getStorage());
+      } else {
+        Variables[Lifetime->getBindingDecl()] = Owner;
+        CleanupScopes.insert(Owner);
+        collect(Lifetime->getOperand(), Owner);
+      }
+      return;
+    }
+    if (const auto *Declaration = dyn_cast<DeclStmt>(S))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(D))
+          if (Variable->hasLocalStorage() &&
+              (!Variable->isImplicit() || Variable->hasAttr<ObjC3LifetimeBindingAttr>())) {
+            Variables[Variable] = Owner;
+            if (Variable->hasAttr<CleanupAttr>() ||
+                Variable->hasAttr<ObjCCleanupAttr>() ||
+                Variable->hasAttr<ObjCResourceAttr>() ||
+                Variable->hasAttr<ObjC3LifetimeBindingAttr>())
+              CleanupScopes.insert(Owner);
+          }
+    if (const auto *Catch = dyn_cast<ObjC3CatchStmt>(S)) {
+      collect(Catch->getBindingDeclStmt(), Catch->getHandlerBody());
+      collect(Catch->getHandlerBody(), Catch->getHandlerBody());
+      return;
+    }
+    if (const auto *Catch = dyn_cast<CXXCatchStmt>(S)) {
+      if (const auto *Variable = Catch->getExceptionDecl())
+        Variables[Variable] = Catch->getHandlerBlock();
+      collect(Catch->getHandlerBlock(), Catch->getHandlerBlock());
+      return;
+    }
+    if (const auto *Catch = dyn_cast<ObjCAtCatchStmt>(S)) {
+      if (const auto *Variable = Catch->getCatchParamDecl())
+        Variables[Variable] = Catch->getCatchBody();
+      collect(Catch->getCatchBody(), Catch->getCatchBody());
+      return;
+    }
+    if (const auto *Arm = dyn_cast<ObjC3MatchArm>(S)) {
+      collect(Arm->getPatternValue(), Owner);
+      collect(Arm->getBindingStatement(), Arm->getBody());
+      collect(Arm->getGuard(), Arm->getBody());
+      collect(Arm->getBody(), Arm->getBody());
+      return;
+    }
+    if (const auto *Guard = dyn_cast<ObjC3GuardStmt>(S)) {
+      for (const Stmt *Condition : Guard->getConditions())
+        collectCondition(Condition, Owner, Owner);
+      collect(Guard->getElse(), Guard->getElse());
+      return;
+    }
+    if (const auto *If = dyn_cast<ObjC3IfBindingStmt>(S)) {
+      for (const Stmt *Condition : If->getConditions())
+        collectCondition(Condition, Owner, If->getThen());
+      collect(If->getThen(), If->getThen());
+      collect(If->getElse(), If->getElse());
+      return;
+    }
+    if (const auto *If = dyn_cast<IfStmt>(S)) {
+      for (const Stmt *Child : If->children())
+        collect(Child,
+                Child == If->getThen() || Child == If->getElse() ? Child : If);
+      return;
+    }
+    if (const auto *Loop = dyn_cast<ForStmt>(S)) {
+      // The initializer survives every iteration. The condition declaration
+      // is destroyed on each backedge and must not share its release queue.
+      const Stmt *ConditionOwner = Loop->getConditionVariableDeclStmt();
+      collect(Loop->getInit(), Loop);
+      collect(ConditionOwner, ConditionOwner);
+      collect(Loop->getCond(), ConditionOwner ? ConditionOwner : Loop);
+      collect(Loop->getInc(), Loop);
+      collect(Loop->getBody(), Loop->getBody());
+      return;
+    }
+    if (const auto *Loop = dyn_cast<CXXForRangeStmt>(S)) {
+      for (const Stmt *Child : Loop->children())
+        collect(Child, Child == Loop->getBody() ||
+                               Child == Loop->getLoopVarStmt()
+                           ? Child
+                           : Loop);
+      return;
+    }
+    if (const auto *Loop = dyn_cast<ObjCForCollectionStmt>(S)) {
+      collect(Loop->getElement(), Loop->getElement());
+      collect(Loop->getCollection(), Loop);
+      collect(Loop->getBody(), Loop->getBody());
+      return;
+    }
+    const Stmt *Body = nullptr;
+    if (const auto *Loop = dyn_cast<WhileStmt>(S))
+      Body = Loop->getBody();
+    else if (const auto *Loop = dyn_cast<DoStmt>(S))
+      Body = Loop->getBody();
+    else if (const auto *Switch = dyn_cast<SwitchStmt>(S))
+      Body = Switch->getBody();
+    for (const Stmt *Child : S->children())
+      collect(Child, Body ? (Child == Body ? Body : S) : Owner);
+  }
+};
+} // namespace clang
+#endif
diff --git a/clang/test/ObjC3/Sema/defer-native-diagnostics.m b/clang/test/ObjC3/Sema/defer-native-diagnostics.m
new file mode 100644
index 000000000..53c21685a
--- /dev/null
