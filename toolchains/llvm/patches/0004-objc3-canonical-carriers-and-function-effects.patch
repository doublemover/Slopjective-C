@@ -2043,3 +2043,59 @@ CXXExpansionSelectExpr::CXXExpansionSelectExpr(const ASTContext &C,
   SubExprs[RANGE] = Range;
   SubExprs[INDEX] = Idx;
 }
+
+Expr *CoyieldExpr::getWrittenOperand() const {
+  Expr *Current = getOperand();
+  for (unsigned Depth = 0; Current && Depth != 128; ++Depth) {
+    Current = Current->IgnoreParenImpCasts();
+    if (auto *Cleanups = dyn_cast<ExprWithCleanups>(Current)) {
+      Current = Cleanups->getSubExpr(); continue;
+    }
+    if (auto *Materialized = dyn_cast<MaterializeTemporaryExpr>(Current)) {
+      Current = Materialized->getSubExpr(); continue;
+    }
+    if (auto *Bound = dyn_cast<CXXBindTemporaryExpr>(Current)) {
+      Current = Bound->getSubExpr(); continue;
+    }
+    if (auto *Await = dyn_cast<CoawaitExpr>(Current)) {
+      Current = Await->getOperand(); continue;
+    }
+    if (auto *Await = dyn_cast<DependentCoawaitExpr>(Current)) {
+      Current = Await->getOperand(); continue;
+    }
+    if (auto *Await = dyn_cast<UnaryOperator>(Current);
+        Await && Await->getOpcode() == UO_Coawait) {
+      Current = Await->getSubExpr(); continue;
+    }
+    auto *Call = dyn_cast<CallExpr>(Current);
+    if (!Call) return nullptr;
+    Expr *Base = nullptr;
+    DeclarationName Name;
+    Expr *Callee = Call->getCallee()->IgnoreParenImpCasts();
+    if (auto *Member = dyn_cast<MemberExpr>(Callee)) {
+      Base = Member->getBase(); Name = Member->getMemberNameInfo().getName();
+    } else if (auto *Member = dyn_cast<CXXDependentScopeMemberExpr>(Callee)) {
+      if (!Member->isImplicitAccess()) Base = Member->getBase();
+      Name = Member->getMember();
+    }
+    if (Name.isIdentifier() && Name.getAsIdentifierInfo() &&
+        Name.getAsIdentifierInfo()->isStr("yield_value") && Base &&
+        Call->getNumArgs() == 1) {
+      auto *Reference = dyn_cast<DeclRefExpr>(Base->IgnoreParenImpCasts());
+      if (Reference && Reference->getDecl()->isImplicit())
+        return Call->getArg(0);
+      return nullptr;
+    }
+    if (Name.getNameKind() == DeclarationName::CXXOperatorName &&
+        Name.getCXXOverloadedOperator() == OO_Coawait && Base) {
+      Current = Base; continue;
+    }
+    if (auto *Operator = dyn_cast<CXXOperatorCallExpr>(Call);
+        Operator && Operator->getOperator() == OO_Coawait &&
+        Operator->getNumArgs() == 1) {
+      Current = Operator->getArg(0); continue;
+    }
+    return nullptr;
+  }
+  return nullptr;
+}
