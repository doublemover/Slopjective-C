+  ASSERT_TRUE(Left && Right);
+  ASSERT_FALSE(Left->getDiagnostics().hasErrorOccurred());
+  ASSERT_FALSE(Right->getDiagnostics().hasErrorOccurred());
+  auto Find = [](ASTUnit &AST) -> TypedefNameDecl * {
+    for (Decl *D : AST.getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *Alias = dyn_cast<TypedefNameDecl>(D))
+        if (Alias->getName() == "Handle")
+          return Alias;
+    return nullptr;
+  };
+  ASSERT_TRUE(Find(*Left) && Find(*Right));
+  StructuralEquivalenceContext::NonEquivalentDeclSet Different;
+  StructuralEquivalenceContext Context(
+      Left->getASTContext().getLangOpts(), Left->getASTContext(),
+      Right->getASTContext(), Different, StructuralEquivalenceKind::Default,
+      false, false);
+  EXPECT_TRUE(Context.IsEquivalent(Find(*Left), Find(*Right)));
+}
