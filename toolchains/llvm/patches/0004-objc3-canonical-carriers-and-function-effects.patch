+      }
+    }
+  }
+  Value futureOwnerLoans(const Expr *Closure, const Facts &State) const {
+    Value Result = acquired(Closure, State);
+    // An already invalid owner is diagnosed by the nested body. These facts
+    // specifically preserve a live capture's later consumption/expiry.
+    for (unsigned I = 1; I < Result.size(); I += 2) Result.reset(I);
+    return Result;
+  }
+  void holdClosureOwners(const Expr *Closure, Value &V, const Facts &State) const {
+    const auto Captures = owningClosureCaptures(Closure);
+    if (IsOwnerSummary)
+      for (const auto &Capture : Captures) {
+        Value Identity = Capture.Initializer ? ownerIdentity(Capture.Initializer, State)
+            : State.OwnerIdentities[Slots.lookup({Capture.Variable, nullptr})];
+        for (const auto &[Root, Index] : OwnerRoots)
+          if (Root && Identity.test(Index)) AcquiredOwnerRoots.insert(Root);
+      }
