+// RUN: %clang_cc1 -x objective-c-header -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-pch -o %t.c.pch %S/Inputs/resource-ownership.h
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -include-pch %t.c.pch -emit-llvm -o - %s | FileCheck %s --check-prefix=IR
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -include-pch %t.c.pch -ast-print %s | FileCheck %s --check-prefix=PRINT
+// RUN: %clang_cc1 -x objective-c++-header -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-pch -o %t.cxx.pch %S/Inputs/resource-ownership.h
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -include-pch %t.cxx.pch -emit-llvm -o - %s | FileCheck %s --check-prefix=IR
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -include-pch %t.cxx.pch -ast-print %s | FileCheck %s --check-prefix=PRINT
+int resource_consumer(int input) {
+  cleanup_pch_value(input);
+  cleanup_pch_address(input);
+  resource_pch_address(input);
+  (void)resource_pch_transfer(input);
+#ifdef __cplusplus
+  (void)resource_template_transfer<7>();
+#endif
+  return resource_pch_value(input);
+}
+// IR: call void @close_resource_address(ptr
+// IR: store i32 0
+// IR: call void @close_resource(i32
+// IR: store i32 -1
+// PRINT: __attribute__((objc_resource(close=close_resource, invalid=-1)))
+// PRINT: __attribute__((objc_resource(close=close_resource_address, invalid=0)))
+
+// PRINT: reset(value, input + 1)
+// PRINT: take(value)
+// PRINT: discard(value)
+
+// PRINT: __attribute__((cleanup(close_resource)))
+// PRINT: __attribute__((cleanup(close_resource_address)))
