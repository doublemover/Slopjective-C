+StmtResult Parser::ParseObjC3MatchStatement() {
+  SourceLocation KeywordLoc = ConsumeAnyToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, "match",
+                              tok::r_paren))
+    return StmtError();
+  ExprResult Scrutinee = ParseExpression();
+  if (Scrutinee.isUsable())
+    Scrutinee = Actions.CheckPlaceholderExpr(Scrutinee.get());
+  if (Scrutinee.isInvalid() || Parens.consumeClose())
+    return StmtError();
+  if (Tok.isNot(tok::l_brace)) {
+    Diag(Tok, diag::err_expected) << tok::l_brace;
+    return StmtError();
+  }
+  SourceLocation LBraceLoc = ConsumeAnyToken();
+  llvm::SmallVector<ObjC3MatchArm *, 8> Arms;
+  while (Tok.isNot(tok::r_brace) && Tok.isNot(tok::eof)) {
+    bool IsDefault = Tok.is(tok::kw_default);
+    if (!IsDefault && Tok.isNot(tok::kw_case)) {
+      Diag(Tok, diag::err_expected) << tok::kw_case;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation CaseLoc = Tok.getLocation();
+    ConsumeAnyToken();
+    ParseScope CaseScope(this, Scope::DeclScope | Scope::CompoundStmtScope);
+    objc3::MatchPatternInfo Pattern;
+    Pattern.Kind = IsDefault ? objc3::MatchPatternKind::Default
+                             : objc3::MatchPatternKind::Wildcard;
+    Pattern.Location = Tok.getLocation();
+    if (!IsDefault && !ParseObjC3MatchPattern(Pattern)) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    objc3::MatchCaseState State = Actions.ActOnObjC3MatchBeginCase(
+        getCurScope(), Scrutinee.get(), Pattern, /*ExpressionForm=*/false);
+    if (!State.IsValid) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    ExprResult Guard;
+    SourceLocation GuardLoc;
+    if (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+        Tok.getIdentifierInfo()->isStr("where")) {
+      GuardLoc = ConsumeAnyToken();
+      if (Tok.is(tok::colon) || Tok.is(tok::r_brace)) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+      Guard = ParseAssignmentExpression();
+      if (Guard.isInvalid()) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+    }
+    if (Tok.isNot(tok::colon)) {
+      Diag(Tok, diag::err_objc3_match_form_delimiter) << "statement";
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation ColonLoc = ConsumeAnyToken();
+    if (Tok.isNot(tok::l_brace)) {
+      Diag(Tok, diag::err_expected) << tok::l_brace;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    StmtResult Body = ParseCompoundStatement();
+    if (Body.isInvalid())
+      continue;
+    if (ObjC3MatchArm *Arm = Actions.ActOnObjC3MatchFinishCase(
+            State, Guard.get(), Body.get(), CaseLoc, Pattern.Location, GuardLoc,
+            ColonLoc))
+      Arms.push_back(Arm);
+  }
+  if (Tok.isNot(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::r_brace;
+    return StmtError();
+  }
+  SourceLocation RBraceLoc = ConsumeAnyToken();
+  return Actions.ActOnObjC3MatchStmt(
+      Scrutinee.get(), Arms, KeywordLoc, Parens.getOpenLocation(),
+      Parens.getCloseLocation(), LBraceLoc, RBraceLoc);
+}
