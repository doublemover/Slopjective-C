@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ODRHash.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace clang;
+namespace {
+class ResultCollector : public RecursiveASTVisitor<ResultCollector> {
+public:
+  std::vector<ObjC3ResultExpr *> Results;
+  bool VisitObjC3ResultExpr(ObjC3ResultExpr *E) {
+    Results.push_back(E);
+    return true;
+  }
+};
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Expression) {
+  const std::string Source = "typedef int Alias; void f(void) { (void)" +
+                            Expression.str() + "; }";
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c", "-std=c17", "-fobjc-version=3"},
+      "carrier-expression-identity.m");
+}
+
+bool equivalent(ASTUnit &From, ASTUnit &To, Stmt *Left, Stmt *Right) {
+  StructuralEquivalenceContext::NonEquivalentDeclSet Known;
+  StructuralEquivalenceContext Context(
+      From.getLangOpts(), From.getASTContext(), To.getASTContext(), Known,
+      StructuralEquivalenceKind::Default, false, false);
+  return Context.IsEquivalent(Left, Right);
+}
+
+TEST(ObjC3CarrierExprIdentity, OppositeZeroArmsAreNotEquivalent) {
+  auto OkAST = parse("__objc3_ok(int, int, 0)");
+  auto ErrAST = parse("__objc3_err(int, int, 0)");
+  auto AliasAST = parse("__objc3_ok(Alias, int, 0)");
+  ASSERT_TRUE(OkAST && ErrAST && AliasAST);
+  ASSERT_FALSE(OkAST->getDiagnostics().hasErrorOccurred());
+  ASSERT_FALSE(ErrAST->getDiagnostics().hasErrorOccurred());
+  ASSERT_FALSE(AliasAST->getDiagnostics().hasErrorOccurred());
+  ResultCollector Ok, Err, Alias;
+  Ok.TraverseDecl(OkAST->getASTContext().getTranslationUnitDecl());
+  Err.TraverseDecl(ErrAST->getASTContext().getTranslationUnitDecl());
+  Alias.TraverseDecl(AliasAST->getASTContext().getTranslationUnitDecl());
+  ASSERT_EQ(Ok.Results.size(), 1u);
+  ASSERT_EQ(Err.Results.size(), 1u);
+  ASSERT_EQ(Alias.Results.size(), 1u);
+  EXPECT_FALSE(equivalent(*OkAST, *ErrAST, Ok.Results[0], Err.Results[0]));
+  EXPECT_TRUE(equivalent(*OkAST, *AliasAST, Ok.Results[0], Alias.Results[0]));
+  ODRHash OkHash, ErrHash;
+  OkHash.AddStmt(Ok.Results[0]);
+  ErrHash.AddStmt(Err.Results[0]);
+  EXPECT_NE(OkHash.CalculateHash(), ErrHash.CalculateHash());
+}
+} // namespace
diff --git a/clang/unittests/AST/ObjC3CarrierExprMangleTest.cpp b/clang/unittests/AST/ObjC3CarrierExprMangleTest.cpp
