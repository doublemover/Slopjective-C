diff --git a/clang/include/clang/Basic/ObjC3Syntax.h b/clang/include/clang/Basic/ObjC3Syntax.h
new file mode 100644
index 000000000..4cc12b347
--- /dev/null
+++ b/clang/include/clang/Basic/ObjC3Syntax.h
@@ -0,0 +1,62 @@
+//===--- ObjC3Syntax.h - Contextual native carrier syntax ---------*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_BASIC_OBJC3SYNTAX_H
+#define LLVM_CLANG_BASIC_OBJC3SYNTAX_H
+#include "llvm/ADT/StringRef.h"
+#include "llvm/ADT/StringSwitch.h"
+namespace clang {
+enum class ObjC3Syntax {
+  Unknown,
+  OptionalType,
+  ResultType,
+  Some,
+  None,
+  HasValue,
+  Ok,
+  Err,
+  IsOk,
+  Copy,
+  Move,
+  MatchExpression,
+  MatchStatement,
+  TryValue,
+  TryOptional,
+  TryForce
+};
+/// Public spellings are contextual before '('. Reserved compiler spellings
+/// remain internal entry points for native AST and adversarial owner tests.
+inline ObjC3Syntax classifyObjC3Syntax(llvm::StringRef Name,
+                                       bool FollowedByParen = true) {
+  if (!FollowedByParen && !Name.starts_with("__objc3_"))
+    return ObjC3Syntax::Unknown;
+  return llvm::StringSwitch<ObjC3Syntax>(Name)
+      .Cases({"Optional", "__objc3_optional"}, ObjC3Syntax::OptionalType)
+      .Cases({"Result", "__objc3_result"}, ObjC3Syntax::ResultType)
+      .Cases({"Some", "__objc3_some"}, ObjC3Syntax::Some)
+      .Cases({"None", "__objc3_none"}, ObjC3Syntax::None)
+      .Cases({"hasValue", "__objc3_has_value"}, ObjC3Syntax::HasValue)
+      .Cases({"Ok", "__objc3_ok"}, ObjC3Syntax::Ok)
+      .Cases({"Err", "__objc3_err"}, ObjC3Syntax::Err)
+      .Cases({"isOk", "__objc3_is_ok"}, ObjC3Syntax::IsOk)
+      .Cases({"copyValue", "__objc3_copy"}, ObjC3Syntax::Copy)
+      .Cases({"moveValue", "__objc3_move"}, ObjC3Syntax::Move)
+      .Cases({"match", "__objc3_match"}, ObjC3Syntax::MatchExpression)
+      .Case("__objc3_match_stmt", ObjC3Syntax::MatchStatement)
+      .Cases({"tryValue", "__objc3_try"}, ObjC3Syntax::TryValue)
+      .Cases({"tryOptional", "__objc3_try_optional"}, ObjC3Syntax::TryOptional)
+      .Cases({"tryForce", "__objc3_try_force"}, ObjC3Syntax::TryForce)
+      .Default(ObjC3Syntax::Unknown);
+}
+inline bool isObjC3TypeSyntax(llvm::StringRef Name, bool FollowedByParen) {
+  auto Kind = classifyObjC3Syntax(Name, FollowedByParen);
+  return Kind == ObjC3Syntax::OptionalType || Kind == ObjC3Syntax::ResultType;
+}
+inline bool isObjC3ExpressionSyntax(llvm::StringRef Name) {
+  auto Kind = classifyObjC3Syntax(Name);
+  return Kind != ObjC3Syntax::Unknown && Kind != ObjC3Syntax::OptionalType &&
+         Kind != ObjC3Syntax::ResultType && Kind != ObjC3Syntax::MatchStatement;
+}
+} // namespace clang
+#endif
