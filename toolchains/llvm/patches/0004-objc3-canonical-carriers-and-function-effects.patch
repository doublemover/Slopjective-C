+    ObjC3DoCatchContext *CatchContext =
+        SemaRef.ActOnObjC3BeginCatchBody();
+    llvm::scope_exit AbortCatch(
+        [&] { SemaRef.ActOnObjC3AbortCatchBody(CatchContext); });
+    StmtResult HandlerBody =
+        getDerived().TransformStmt(S->getHandlerBody());
+    if (HandlerBody.isInvalid())
+      return StmtError();
+    auto *CompoundHandler = dyn_cast<CompoundStmt>(HandlerBody.get());
+    if (!CompoundHandler)
+      return StmtError();
+    SemaRef.ActOnObjC3EndCatchBody(CatchContext);
+    AbortCatch.release();
+
+    return ObjC3CatchStmt::Create(
+        SemaRef.Context, S->getCatchLoc(), S->getLParenLoc(),
+        S->getRParenLoc(), CatchType,
+        cast_or_null<DeclStmt>(Binding.get()), CompoundHandler,
+        S->isCatchAll());
