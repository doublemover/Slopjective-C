+TEST(ObjC3FunctionEffectImport, GenericRequiresBodyRetainsOwningContext) {
+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    std::vector<std::string> Args = {"-xc++", Standard};
+    auto From = tooling::buildASTFromCodeWithArgs(R"cpp(
+      constexpr int constrained() {
+        auto checked=[]<class T>(T value) noexcept(noexcept(value+2))
+            requires requires(T item) {item+2;} {return value+2;};
+        auto head=[]<class T> requires requires(T item) {item+2;}
+            (T value) {return value+2;};
+        return checked(40)+head(40);
