+TEST(ObjC3FunctionEffectImport, PreservesNestedLocalRecordDeclarationOrder) {
+  for(const char *Standard:{"-std=c++20","-std=c++23"}) {
+    const std::vector<std::string> Args={"-x","objective-c++",Standard,"-fobjc-version=3","-fobjc-runtime=gnustep-2.2"};
+    const std::string Source=R"(
+      inline auto factory(int n) {
+        struct Root {
+          struct Left {struct Value{int value;};};
+          struct Right {struct Value{int value;};};
+          enum class Code:int {good=42};
+          union Choice {int number;double real;};
+          Left::Value value;
+        };
+        return Root{{n}};
+      }
+    )";
+    auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"nested-order-from.mm");
+    auto To=tooling::buildASTFromCodeWithArgs("",Args,"nested-order-to.mm");
+    ASSERT_TRUE(From && To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    FunctionDecl *Function=nullptr;
+    for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())
+      if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getName()=="factory")Function=F;
+    ASSERT_TRUE(Function);
+    auto members=[](const CXXRecordDecl *Record) {
+      std::vector<std::string> Names;
+      for(auto *D:Record->decls())
+        if(const auto *Named=dyn_cast<NamedDecl>(D);Named && !D->isImplicit())
+          Names.push_back(Named->getNameAsString());
+      return Names;
+    };
+    const auto Expected=members(Function->getReturnType()->getAsCXXRecordDecl());
+    EXPECT_EQ(Expected,(std::vector<std::string>{"Left","Right","Code","Choice","value"}));
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+    auto Imported=Importer.Import(Function);ASSERT_TRUE(bool(Imported))<<llvm::toString(Imported.takeError());
+    EXPECT_EQ(members(cast<FunctionDecl>(*Imported)->getReturnType()->getAsCXXRecordDecl()),Expected);
+  }
+}
