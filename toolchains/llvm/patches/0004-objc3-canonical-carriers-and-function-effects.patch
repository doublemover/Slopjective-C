+      if (auto End = Element.getAs<CFGLifetimeEnds>()) {
+        expire(End->getVarDecl(), State);
+        continue;
+      }
+      if (auto Release = Element.getAs<CFGObjC3LifetimeRelease>()) {
+        expire(Release->getVarDecl(), State);
+        continue;
+      }
+      if (auto Initializer = Element.getAs<CFGInitializer>()) {
+        const Expr *Value = Initializer->getInitializer()->getInit();
+        if (Emit && value(Value, State).any())
+          diagnose(Value, "a constructor member/base initializer without a borrowed lifetime contract");
+        continue;
+      }
+      auto Statement = Element.getAs<CFGStmt>();
+      if (!Statement)
+        continue;
+      const Stmt *Node = Statement->getStmt();
+      if (IsOwnerSummary)
+        if (const auto *Unary = dyn_cast<UnaryOperator>(Node);
+            Unary && (Unary->getOpcode() == UO_AddrOf || Unary->isIncrementDecrementOp())) {
+          Storage Target = storage(Unary->getSubExpr(), &State);
+          if (SummaryCaptures.count(Target.first)) MutatedCaptures.insert(Target.first);
+        }
+      if (const auto *Expression = dyn_cast<Expr>(Node))
+        if (auto Found = ExpressionSlots.find(Expression); Found != ExpressionSlots.end()) {
