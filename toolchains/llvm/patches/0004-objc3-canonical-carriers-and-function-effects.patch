+//===--- ObjC3ModuleNames.h - Native module category bindings ----*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3MODULENAMES_H
+#define LLVM_CLANG_AST_OBJC3MODULENAMES_H
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclObjC.h"
+namespace clang {
+inline llvm::StringRef getObjC3ModuleCategoryName(const ObjCCategoryDecl *D) {
+  for (const auto *A : D->specific_attrs<AnnotateAttr>())
+    if (A->getAnnotation().starts_with("objc3.module-name:") &&
+        A->args_size() == 0)
+      return A->getAnnotation().drop_front(18);
+  return {};
+}
+inline llvm::StringRef getObjC3RuntimeCategoryName(const ObjCCategoryDecl *D) {
+  const auto Name = getObjC3ModuleCategoryName(D);
+  return Name.empty() ? D->getName() : Name;
+}
+} // namespace clang
+#endif // LLVM_CLANG_AST_OBJC3MODULENAMES_H
