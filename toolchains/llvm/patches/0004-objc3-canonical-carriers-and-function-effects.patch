+    EXPECT_NE(std::string::npos,Printed.find("state += delta"));
+    EXPECT_EQ(Printed,Print(cast<FunctionDecl>(*Imported)));
+    class PrototypeVisitor : public RecursiveASTVisitor<PrototypeVisitor> {
+    public:
+      unsigned Blocks=0;
+      bool VisitBlockExpr(BlockExpr *Expression) {
+        auto *Block=Expression->getBlockDecl();
+        auto *Signature=Block->getSignatureAsWritten();
+        EXPECT_TRUE(Signature);
+        if (!Signature) return true;
+        auto Prototype=Signature->getTypeLoc().IgnoreParens().getAs<FunctionProtoTypeLoc>();
+        EXPECT_TRUE(static_cast<bool>(Prototype));
+        if (Prototype)
+          for (unsigned I=0; I<Block->getNumParams(); ++I)
+            EXPECT_EQ(Block->getParamDecl(I),Prototype.getParam(I));
+        ++Blocks;
+        return true;
+      }
+    } Visitor;
+    Visitor.TraverseStmt(cast<FunctionDecl>(*Imported)->getBody());
+    EXPECT_EQ(2u,Visitor.Blocks);
+    auto Round=tooling::buildASTFromCodeWithArgs(Printed,{"-xc++",Standard,"-fblocks"});
+    ASSERT_TRUE(Round);
+    EXPECT_FALSE(Round->getDiagnostics().hasErrorOccurred());
+  }
+}
+
+TEST(ObjC3ClassImporter, PreservesLocalInitializationAndNRVO) {
+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    auto From=tooling::buildASTFromCodeWithArgs(
+        "struct V { V(); V(int); V(const V &); ~V(); }; "
+        "inline V statement() {return ({V value; value;});} "
+        "inline V named() {V value(42); return value;} "
+        "inline V list() {V value{42}; return value;}", {"-xc++",Standard});
+    auto To=tooling::buildASTFromCodeWithArgs("",{"-xc++",Standard});
+    ASSERT_TRUE(From && To);
+    ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                         From->getASTContext(),From->getFileManager(),false);
+    unsigned Functions=0;
+    for (auto *D:From->getASTContext().getTranslationUnitDecl()->decls()) {
+      auto *Function=dyn_cast<FunctionDecl>(D);
+      if (!Function || !Function->hasBody()) continue;
+      auto Imported=Importer.Import(Function);
+      ASSERT_TRUE(static_cast<bool>(Imported)) << llvm::toString(Imported.takeError());
+      class LocalVisitor:public RecursiveASTVisitor<LocalVisitor> {
+      public:
+        std::vector<VarDecl *> Locals;
+        bool VisitVarDecl(VarDecl *Variable) {
+          if (Variable->isLocalVarDecl()) Locals.push_back(Variable);
+          return true;
+        }
+      } Original,Copy;
+      Original.TraverseStmt(Function->getBody());
+      Copy.TraverseStmt(cast<FunctionDecl>(*Imported)->getBody());
+      ASSERT_EQ(Original.Locals.size(),Copy.Locals.size());
+      ASSERT_EQ(1u,Copy.Locals.size());
+      EXPECT_EQ(Original.Locals[0]->getInitStyle(),Copy.Locals[0]->getInitStyle());
+      EXPECT_EQ(Original.Locals[0]->isNRVOVariable(),Copy.Locals[0]->isNRVOVariable());
+      auto Print=[](FunctionDecl *F) {
+        std::string Text;
+        llvm::raw_string_ostream OS(Text);
+        F->getBody()->printPretty(OS,nullptr,F->getASTContext().getPrintingPolicy());
+        return Text;
+      };
+      EXPECT_EQ(Print(Function),Print(cast<FunctionDecl>(*Imported)));
+      ++Functions;
+    }
+    EXPECT_EQ(3u,Functions);
+  }
+}
diff --git a/clang/test/ObjC3/Sema/guard-binding-c.m b/clang/test/ObjC3/Sema/guard-binding-c.m
