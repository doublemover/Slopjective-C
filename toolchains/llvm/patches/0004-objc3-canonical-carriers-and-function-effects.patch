@@ -0,0 +1,20 @@
+// RUN: clang-query -c 'set bind-root false' \
+// RUN:   -c 'match objc3GuardStmt(objc3ConditionCountIs(2), hasObjC3Condition(0, objc3BindingCondition(hasObjC3Binding(varDecl(hasName("first")))))).bind("guard")' \
+// RUN:   -c 'match objc3IfBindingStmt(hasObjC3Condition(0, objc3BindingCondition(isObjC3MutableBinding())), hasThen(compoundStmt())).bind("branch")' \
+// RUN:   -c 'set traversal IgnoreUnlessSpelledInSource' \
+// RUN:   -c 'match declRefExpr(to(parmVarDecl(hasName("source"))), hasParent(objc3BindingCondition())).bind("source")' \
+// RUN:   %s -- -x objective-c++ -std=c++20 -fobjc-version=3 | FileCheck %s
+
+int query_conditions(Optional(int) source, bool enabled) {
+  guard let first = source, enabled else { return -1; }
+  if var second = source { return first + second; }
+  return first;
+}
+
+// CHECK: note: "guard" binds here
+// CHECK: 1 match.
+// CHECK: note: "branch" binds here
+// CHECK: 1 match.
+// CHECK: note: "source" binds here
+// CHECK: note: "source" binds here
+// CHECK: 2 matches.
