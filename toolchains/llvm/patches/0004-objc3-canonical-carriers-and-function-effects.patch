+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/Mangle.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+#include "llvm/Support/raw_ostream.h"
+#include <memory>
+#include <string>
+
+using namespace clang;
+
+namespace {
+TEST(ObjC3CarrierExprMangle, DependentConstructionRetainsOperationAndArmOrder) {
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    template<class T> using Some = decltype(__objc3_some(T, T()));
+    template<class T> using None = decltype(__objc3_none(T));
+    template<class T> using Ok = decltype(__objc3_ok(T, int, T()));
+    template<class T> using Err = decltype(__objc3_err(T, int, 0));
+    template<class T> using Reversed = decltype(__objc3_ok(int, T, 0));
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+       "-target", "x86_64-unknown-linux-gnu"}, "carrier-expression-mangle.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  std::unique_ptr<MangleContext> Mangler(Context.createMangleContext());
+  auto MangleAlias = [&](llvm::StringRef Name) {
+    auto Decls = Context.getTranslationUnitDecl()->lookup(&Context.Idents.get(Name));
+    std::string Result;
+    for (NamedDecl *Decl : Decls) {
+      auto *Alias = dyn_cast<TypeAliasTemplateDecl>(Decl);
+      if (!Alias) continue;
+      llvm::raw_string_ostream Out(Result);
+      Mangler->mangleCanonicalTypeName(Alias->getTemplatedDecl()->getUnderlyingType(), Out);
+    }
+    return Result;
+  };
+  const auto Some = MangleAlias("Some"), None = MangleAlias("None");
+  const auto Ok = MangleAlias("Ok"), Err = MangleAlias("Err");
+  const auto Reversed = MangleAlias("Reversed");
+  EXPECT_NE(Some.find("__objc3_some"), std::string::npos);
+  EXPECT_NE(None.find("__objc3_none"), std::string::npos);
+  EXPECT_NE(Ok.find("__objc3_ok"), std::string::npos);
+  EXPECT_NE(Err.find("__objc3_err"), std::string::npos);
+  EXPECT_NE(Some, None);
+  EXPECT_NE(Ok, Err);
+  EXPECT_NE(Ok, Reversed);
+  EXPECT_EQ(Ok, MangleAlias("Ok"));
+}
+} // namespace
