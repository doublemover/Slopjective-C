+struct Record { int member; };
+@interface Receiver
+@property(readonly) Receiver * _Nonnull next;
+@property(readonly) int number;
+@property(readonly) struct Record record;
+- (int)scalar;
+- (struct Record)aggregate;
+- (void)effect:(int)value;
+- (void)noEffect;
++ (id)factory;
+@end
