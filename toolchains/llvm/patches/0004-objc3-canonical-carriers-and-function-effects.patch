+using DeferredRecord = __objc3_optional(Forward);
+static_assert(sizeof(DeferredRecord) > 0); // expected-error {{invalid application of 'sizeof' to an incomplete type}}
+struct Forward {
+  int value;
+};
+static_assert(sizeof(DeferredRecord) >= sizeof(Forward));
+
+using OptionalVoid = __objc3_optional(void);
+using VoidSuccess = __objc3_result(void, int);
+using VoidBoth = __objc3_result(void, void);
+
+using FunctionPointer = __objc3_optional(int (*)(double));
+using NoncopyableType = __objc3_optional(struct MoveOnly);
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete;
+  MoveOnly(MoveOnly &&) = default;
+  ~MoveOnly();
+};
+
+Maybe<int> dependent_is_deferred;
+Outcome<void, int> dependent_result;
+using InstantiatedOptional = Maybe<long>;
+
+using ArrayPayload =
+    __objc3_optional(int[4]); // expected-error {{payload type 'int[4]' is not supported in an Objective-C 3 value carrier}}
+using FunctionPayload = __objc3_optional( // expected-error {{payload type 'int (double)' is not supported in an Objective-C 3 value carrier}}
