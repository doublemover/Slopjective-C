@@ -0,0 +1,46 @@
+//===--- ObjC3Resources.inc - Native resource operation AST -------*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+/// Explicit ownership operations on an annotated automatic resource variable.
+/// Reset evaluates its replacement after closing and invalidating the current
+/// value. This sequencing is part of the node's semantics, including EH.
+class ObjC3ResourceExpr final : public Expr {
+public:
+  enum class Kind : unsigned char { Take, Reset, Discard };
+
+private:
+  friend class ASTStmtReader;
+  Kind Operation = Kind::Take;
+  Stmt *Operands[2] = {};
+  SourceLocation BuiltinLoc, RParenLoc;
+
+  ObjC3ResourceExpr(Kind Operation, QualType ResultType, Expr *Operand,
+                     Expr *Replacement, SourceLocation BuiltinLoc,
+                     SourceLocation RParenLoc);
+
+public:
+  explicit ObjC3ResourceExpr(EmptyShell Empty)
+      : Expr(ObjC3ResourceExprClass, Empty) {}
+  static ObjC3ResourceExpr *Create(ASTContext &Context, Kind Operation,
+                                  QualType ResultType, Expr *Operand,
+                                  Expr *Replacement, SourceLocation BuiltinLoc,
+                                  SourceLocation RParenLoc);
+  Kind getKind() const { return Operation; }
+  Expr *getOperand() const { return cast<Expr>(Operands[0]); }
+  Expr *getReplacement() const { return cast_or_null<Expr>(Operands[1]); }
+  const VarDecl *getResourceVariable() const;
+  SourceLocation getBuiltinLoc() const { return BuiltinLoc; }
+  SourceLocation getRParenLoc() const { return RParenLoc; }
+  SourceLocation getExprLoc() const { return BuiltinLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return BuiltinLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY { return RParenLoc; }
+  child_range children() {
+    return child_range(Operands, Operands + (Operands[1] ? 2 : 1));
+  }
+  const_child_range children() const {
+    return const_child_range(Operands, Operands + (Operands[1] ? 2 : 1));
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3ResourceExprClass;
+  }
+};
