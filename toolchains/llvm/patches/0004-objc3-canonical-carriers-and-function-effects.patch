+QualifiedNameTokens collectQualifiedName(Parser &P, const Token &Start) {
+  QualifiedNameTokens Result;
+  if (!Start.is(tok::identifier) || !Start.getIdentifierInfo())
+    return Result;
+
+  Result.Components.push_back(Start.getIdentifierInfo());
+  Result.Locations.push_back(Start.getLocation());
+  unsigned Offset = 1;
+  while (P.GetLookAheadToken(Offset).is(tok::period) &&
+         P.GetLookAheadToken(Offset + 1).is(tok::identifier) &&
+         P.GetLookAheadToken(Offset + 1).getIdentifierInfo()) {
+    Result.Dots.push_back(P.GetLookAheadToken(Offset).getLocation());
+    Result.Components.push_back(
+        P.GetLookAheadToken(Offset + 1).getIdentifierInfo());
+    Result.Locations.push_back(P.GetLookAheadToken(Offset + 1).getLocation());
+    Offset += 2;
+  }
+  return Result;
+}
+
+} // namespace
+
+bool Parser::isObjC3QualifiedNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::identifier) ||
+      !Tok.getIdentifierInfo())
+    return false;
+  return NextToken().is(tok::period) &&
+         GetLookAheadToken(2).is(tok::identifier);
+}
+
+bool Parser::isObjC3QualifiedTypeNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::at) ||
+      !GetLookAheadToken(1).is(tok::identifier) ||
+      !GetLookAheadToken(2).is(tok::period) ||
+      !GetLookAheadToken(3).is(tok::identifier))
+    return false;
+
+  SmallVector<IdentifierInfo *, 8> Components;
+  unsigned Offset = 1;
+  Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+  Offset += 2;
+  while (GetLookAheadToken(Offset - 1).is(tok::period) &&
+         GetLookAheadToken(Offset).is(tok::identifier)) {
+    Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+    Offset += 2;
+  }
+  return Actions.IsObjC3QualifiedTypeName(Components);
+}
+
+ExprResult Parser::ParseObjC3QualifiedNameExpression(SourceLocation AtLoc) {
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2)
+    return ExprError(Diag(AtLoc, diag::err_unexpected_at));
+
+  unsigned ConsumedComponents = Name.Components.size();
+  ExprResult Result = Actions.ActOnObjC3QualifiedNameExpr(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return ParsePostfixExpressionSuffix(Result);
+}
+
+TypeResult Parser::ParseObjC3QualifiedTypeName(SourceLocation &EndLoc) {
+  assert(getLangOpts().ObjC3 && Tok.is(tok::at));
+  SourceLocation AtLoc = ConsumeToken();
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2) {
+    EndLoc = AtLoc;
+    return TypeError();
+  }
+
+  unsigned ConsumedComponents = Name.Components.size();
+  TypeResult Result = Actions.ActOnObjC3QualifiedTypeName(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  EndLoc = Name.Locations[ConsumedComponents - 1];
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return Result;
+}
