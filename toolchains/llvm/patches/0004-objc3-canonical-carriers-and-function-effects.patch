new file mode 100644
index 000000000..b9bf3494d
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3OptionalOperators.inc
@@ -0,0 +1,46 @@
+//===--- ObjC3OptionalOperators - Native optional operator AST -----------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+/// A native nil-coalescing expression. Written operands are retained for
+/// source tooling and template replay. Only the semantic expression is an
+/// evaluated child: it owns the single source evaluation and lazy fallback.
+/// A dependent expression has no semantic recipe until instantiation.
+class ObjC3CoalesceExpr final : public Expr {
+  friend class ASTStmtReader;
+  Stmt *Written[2] = {};
+  Stmt *Semantic = nullptr;
+  SourceLocation OperatorLoc;
+
+  ObjC3CoalesceExpr(QualType ResultType, Expr *LHS, Expr *RHS, Expr *Semantic,
+                    SourceLocation OperatorLoc);
+
+public:
+  explicit ObjC3CoalesceExpr(EmptyShell Empty)
+      : Expr(ObjC3CoalesceExprClass, Empty) {}
+  static ObjC3CoalesceExpr *Create(ASTContext &Context, QualType ResultType,
+                                  Expr *LHS, Expr *RHS, Expr *Semantic,
+                                  SourceLocation OperatorLoc);
+  Expr *getLHS() const { return cast<Expr>(Written[0]); }
+  Expr *getRHS() const { return cast<Expr>(Written[1]); }
+  Expr *getSemanticExpr() const { return cast_or_null<Expr>(Semantic); }
+  SourceLocation getOperatorLoc() const { return OperatorLoc; }
+  SourceLocation getExprLoc() const { return OperatorLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY {
+    return getLHS()->getBeginLoc();
+  }
+  SourceLocation getEndLoc() const LLVM_READONLY {
+    return getRHS()->getEndLoc();
+  }
+  child_range children() {
+    return Semantic ? child_range(&Semantic, &Semantic + 1)
+                    : child_range(Written, Written + 2);
+  }
+  const_child_range children() const {
+    return Semantic ? const_child_range(&Semantic, &Semantic + 1)
+                    : const_child_range(Written, Written + 2);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3CoalesceExprClass;
+  }
+};
