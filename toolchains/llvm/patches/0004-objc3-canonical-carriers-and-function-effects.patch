+int reads_and_writes(IndexNode *_Nonnull root,WritableKeyPath<IndexNode*,int> path,
+    KeyPath<IndexNode*,int> read) {
+  int first=root[read];int assigned=(root[path]=40);
+  int compound=(root[path]+=2);int prior=root[path]++;
+  int current=++root[path];--root[path];root[path]--;
+  root[path]*=2;root[path]/=2;root[path]%=43;root[path]&=31;
+  root[path]|=2;root[path]^=1;root[path]<<=1;root[path]>>=1;
+  return first+assigned+compound+prior+current+root[path];
+}
+IndexPair record_value(IndexNode *_Nonnull root,WritableKeyPath<IndexNode*,IndexPair> path) {
+  IndexPair pair={1,2};IndexPair assigned=(root[path]=pair);return assigned;
+}
+int literal_value(IndexNode *_Nonnull root) {return root[@keypath(IndexNode,count)];}
+void readonly_rejection(IndexNode *_Nonnull root,KeyPath<IndexNode*,int> read) {
+  root[read]=0; // expected-error {{subscript assignment requires a WritableKeyPath}}
+  root[read]+=1; // expected-error {{subscript assignment requires a WritableKeyPath}}
+  ++root[read]; // expected-error {{subscript assignment requires a WritableKeyPath}}
+}
+void root_rejection(IndexNode *_Nullable nullable,IndexOther *_Nonnull other,
+    KeyPath<IndexNode*,int> read) {
+  (void)nullable[read]; // expected-error {{requires a nonnull root}}
+  (void)other[read]; // expected-error {{root has an incompatible class type}}
+  (void)((IndexNode*)0)[read]; // expected-error {{requires a nonnull root}}
+}
+void null_value_rejection(IndexNode *_Nonnull root,IndexNode *_Nullable value,
+    WritableKeyPath<IndexNode*,IndexNode*_Nonnull> path) {
+  root[path]=value; // expected-error {{setter requires a nonnull property value}}
+  root[path]=(id)0; // expected-error {{setter requires a nonnull property value}}
+}
+IndexNode *_Nullable nullable_result(IndexNode *_Nonnull root) {
+  return root[@keypath(IndexNode,optionalChild.optionalChild)];
+}
