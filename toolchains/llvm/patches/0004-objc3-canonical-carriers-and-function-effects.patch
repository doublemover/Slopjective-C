+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-async-task.h"
+int regular() {
+  __objc3_await 1; // expected-error {{native await requires an async Objective-C++20/23 function context}}
+  return 0;
