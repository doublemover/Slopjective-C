+//===--- ObjC3OptionalAccess.cpp - Optional member and message AST -------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprObjC.h"
+
+using namespace clang;
+
+ObjC3OptionalAccessExpr::ObjC3OptionalAccessExpr(
+    QualType Type, Expr *Receiver, Expr *Access, Expr *Recipe,
+    IdentifierInfo *Member, SourceLocation OperatorLoc, SourceLocation MemberLoc,
+    SourceLocation LBracketLoc, SourceLocation RBracketLoc)
+    : Expr(ObjC3OptionalAccessExprClass, Type, VK_PRValue, OK_Ordinary),
+      Written{Receiver, Access}, Semantic(Recipe), Member(Member),
+      OperatorLoc(OperatorLoc), MemberLoc(MemberLoc), LBracketLoc(LBracketLoc),
+      RBracketLoc(RBracketLoc) {
+  setDependence(toExprDependenceForImpliedType(Type->getDependence()) |
+                Receiver->getDependence() | Access->getDependence());
+}
+
+ObjC3OptionalAccessExpr *ObjC3OptionalAccessExpr::Create(
+    ASTContext &Context, QualType Type, Expr *Receiver, Expr *Access,
+    Expr *Semantic, IdentifierInfo *Member, SourceLocation OperatorLoc,
+    SourceLocation MemberLoc, SourceLocation LBracketLoc,
+    SourceLocation RBracketLoc) {
+  return new (Context) ObjC3OptionalAccessExpr(
+      Type, Receiver, Access, Semantic, Member, OperatorLoc, MemberLoc,
+      LBracketLoc, RBracketLoc);
+}
+
+ObjCMessageExpr *ObjC3OptionalAccessExpr::getMessageExpr() const {
+  return isMessage()
+             ? cast<ObjCMessageExpr>(getAccess()->IgnoreImplicit())
+             : nullptr;
+}
