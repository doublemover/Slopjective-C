+                ObjCPreciseLifetimeAttr::CreateImplicit(Context));
+        }
+      }
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      MightBorrow |= statementMayBorrow(Block->getBlockDecl()->getBody());
+      if (!ClosureSlots.count(Block))
+        ClosureSlots[Block] = ClosureSlots.size();
+      return;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      MightBorrow |= statementMayBorrow(Lambda->getBody());
+      if (!ClosureSlots.count(Lambda))
+        ClosureSlots[Lambda] = ClosureSlots.size();
+      for (const auto &Capture : Lambda->captures())
+        if (Capture.capturesVariable())
+          if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar())) {
+            addVariable(Variable);
+          }
+      for (const Expr *Initializer : Lambda->capture_inits())
+        collect(Initializer, Scope);
+      return;
+    }
+    if (isa<CompoundStmt>(Node))
+      Scope = Node;
+    for (const Stmt *Child : Node->children())
+      collect(Child, Scope);
+  }
+  void prepareClosureLoans() {
+    const unsigned Count = Origins.size();
+    for (auto [Block, Slot] : ClosureSlots) {
+      (void)Slot;
+      const bool OwnsObject = !owningClosureCaptures(Block).empty();
+      if (!OwnsObject)
+        continue;
+      for (unsigned I = 0; I != Count; ++I) {
+        if (Origins[I].HeldByClosure)
+          continue;
+        Origin Held = Origins[I];
+        Held.HeldByClosure = Block;
+        ClosureLoans[{Block, I}] = Origins.size();
+        Origins.push_back(Held);
+      }
+    }
+  }
+  bool owningCapture(const BlockDecl::Capture &Capture) const {
+    if (Capture.isByRef() || !Capture.getCaptureType()->isObjCRetainableType())
+      return false;
+    auto Kind = Capture.getObjC3CaptureKind();
+    return Kind == BlockDecl::ObjC3CaptureKind::Strong ||
+           Kind == BlockDecl::ObjC3CaptureKind::Move ||
+           (Kind == BlockDecl::ObjC3CaptureKind::Implicit &&
+            Actions.getLangOpts().ObjCAutoRefCount &&
+            Capture.getCaptureType().getObjCLifetime() != Qualifiers::OCL_Weak &&
+            Capture.getCaptureType().getObjCLifetime() != Qualifiers::OCL_ExplicitNone);
+  }
+  struct ClosureOwner {
+    const VarDecl *Variable;
+    const Expr *Initializer;
+  };
+  SmallVector<ClosureOwner, 4> owningClosureCaptures(const Expr *Closure) const {
+    SmallVector<ClosureOwner, 4> Owners;
+    if (const auto *Block = dyn_cast<BlockExpr>(Closure)) {
+      for (const auto &Capture : Block->getBlockDecl()->captures())
+        if (owningCapture(Capture))
+          Owners.push_back({Capture.getVariable(), nullptr});
+    } else if (const auto *Lambda = dyn_cast<LambdaExpr>(Closure)) {
+      auto Initializer = Lambda->capture_init_begin();
+      for (const auto &Capture : Lambda->captures()) {
+        const Expr *Init = *Initializer++;
+        if (!Capture.capturesVariable() || Capture.getCaptureKind() != LCK_ByCopy ||
+            !Actions.getLangOpts().ObjCAutoRefCount)
+          continue;
+        const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar());
+        if (!Variable) continue;
+        QualType Type = Variable->getType();
+        if (Type->isObjCRetainableType() &&
+            Type.getObjCLifetime() != Qualifiers::OCL_Weak &&
+            Type.getObjCLifetime() != Qualifiers::OCL_ExplicitNone)
+          Owners.push_back({Variable, Lambda->isInitCapture(&Capture) ? Init : nullptr});
+      }
+    }
+    return Owners;
+  }
+  SmallVector<ClosureOwner, 4> closureCaptures(const Expr *Closure) const {
+    SmallVector<ClosureOwner, 4> Captures;
+    if (const auto *Block = dyn_cast<BlockExpr>(Closure)) {
+      for (const auto &Capture : Block->getBlockDecl()->captures())
+        Captures.push_back({Capture.getVariable(), Capture.getObjC3InitExpr()});
+    } else if (const auto *Lambda = dyn_cast<LambdaExpr>(Closure)) {
+      auto Init = Lambda->capture_init_begin();
+      for (const auto &Capture : Lambda->captures()) {
+        const Expr *Value = *Init++;
+        if (Capture.capturesVariable())
+          if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+            Captures.push_back({Variable, Lambda->isInitCapture(&Capture) ? Value : nullptr});
+      }
+    }
+    return Captures;
+  }
+  void prepareSymbolicCallableInputs() {
+    if (!IsOwnerSummary) return;
+    SmallVector<std::pair<unsigned, Storage>, 16> Candidates;
+    for (const auto &[Location, Index] : Slots) {
+      if (!SummaryCaptures.count(Location.first)) continue;
+      QualType Type = storageType(Location);
+      if (Type.isNull()) continue;
+      Type = Type.getNonReferenceType();
+      const auto *Record = Type->getAsCXXRecordDecl();
+      if (Type->isBlockPointerType() || Type->isFunctionPointerType() || (Record && Record->isLambda()))
+        Candidates.push_back({Index, Location});
+    }
+    llvm::sort(Candidates, [](const auto &L, const auto &R) {return L.first < R.first;});
+    SmallVector<Storage, 8> OpaqueCallables;
+    SmallVector<CallableCapturePath, 16> PathsToSeed;
+    SmallVector<Storage, 16> Locations;
+    for (const auto &[Index, Location] : Candidates) {
+      (void)Index;
+      bool Descendant = false;
+      for (Storage Opaque : OpaqueCallables) {
+        if (Opaque.first != Location.first) continue;
+        unsigned Prefix = path(Opaque), Current = path(Location);
+        while (Current && Current != Prefix) Current = Paths[Current].Parent;
+        Descendant |= Current == Prefix;
+      }
+      if (Descendant) continue;
+      OpaqueCallables.push_back(Location);
+      CallableCapturePath Descriptor; Descriptor.Variable = Location.first;
+      for (unsigned P = path(Location); P; P = Paths[P].Parent) Descriptor.Components.push_back(Paths[P]);
+      std::reverse(Descriptor.Components.begin(), Descriptor.Components.end());
+      Locations.push_back(Location);PathsToSeed.push_back(std::move(Descriptor));
+    }
+    for (unsigned I = 0; I != Locations.size(); ++I) {
+      auto &Descriptor = PathsToSeed[I];
+      bool HasUnknown = llvm::any_of(Descriptor.Components, [](const PathNode &P) {return !P.Field && P.Index == -2;});
+      bool FullyTracked = true;
+      QualType CurrentType = Descriptor.Variable->getType().getNonReferenceType();
+      for (const auto &Component : Descriptor.Components) {
+        if (Component.Field) {CurrentType = Component.Field->getType();continue;}
+        const auto *Array = Context.getAsArrayType(CurrentType);
+        const auto *Bound = dyn_cast_or_null<ConstantArrayType>(Array);
+        if (Component.Index == -2)
+          FullyTracked &= Bound && Bound->getSize().getActiveBits() <= 6;
+        if (!Array) {FullyTracked = false;break;}
+        CurrentType = Array->getElementType();
+      }
+      bool Covered = false;
+      if (HasUnknown && FullyTracked)
+        for (const auto &Other : PathsToSeed) {
+          if (Other.Variable != Descriptor.Variable || Other.Components.size() != Descriptor.Components.size()) continue;
+          bool Match = true;
+          for (unsigned J = 0; J != Other.Components.size(); ++J) {
+            const auto &A = Descriptor.Components[J];const auto &B = Other.Components[J];
+            Match &= A.Field == B.Field && (A.Field || (B.Index >= 0 && (A.Index == -2 || A.Index == B.Index)));
+          }
+          Covered |= Match;
+        }
+      if (Covered) continue;
+      const VarDecl *Variable = Descriptor.Variable;
+      if (!OwnerRoots.count(Variable)) OwnerRoots[Variable] = OwnerRoots.size();
+      Value Identity(OwnerRoots.size());Identity.set(OwnerRoots.lookup(Variable));
+      InheritedOwners[Variable] = std::move(Identity);
+      addOrigin(nullptr, Variable, false, nullptr, Variable, true);
+      Origins.back().SymbolicCallable = true;
+      unsigned Token = Origins.size() - 1;
+      SymbolicCallablePaths[Token] = Descriptor;
+      Value Effect(Origins.size() * 2);Effect.set(Token * 2);
+      InheritedEffects[Locations[I]] = std::move(Effect);
+    }
+  }
+  SmallVector<std::pair<Decl *,Stmt *>,4> closureBodies(const Expr *Closure) const {
+    if(const auto *Block=dyn_cast<BlockExpr>(Closure)) {
+      auto *Declaration=const_cast<BlockDecl *>(Block->getBlockDecl());
+      return {{Declaration,Declaration->getBody()}};
+    }
+    const auto *Lambda=cast<LambdaExpr>(Closure);
+    SmallVector<std::pair<Decl *,Stmt *>,4> Bodies;
+    if(Lambda->isGenericLambda())
+      if(const auto *Pattern=Lambda->getCallOperator()->getDescribedFunctionTemplate())
+        for(auto *Function:Pattern->specializations()) {
+          const auto *Prototype=Function->getType()->getAs<FunctionProtoType>();
+          if(Function->isInvalidDecl() || Function->getType()->isDependentType() ||
+              !Function->hasBody() || !Prototype || Prototype->getObjC3FunctionEffects().Async ||
+              isa<CoroutineBodyStmt>(Function->getBody()))
+            return {{Lambda->getCallOperator(),Lambda->getBody()}};
+          Bodies.push_back({Function,Function->getBody()});
+        }
+    if(Bodies.empty())Bodies.push_back({Lambda->getCallOperator(),Lambda->getBody()});
+    return Bodies;
+  }
+  bool qualifiedGenericCapture(const LambdaExpr *Lambda) const {
+    if(!Lambda->isGenericLambda())return true;
+    for(const auto &[Declaration,Body]:closureBodies(Lambda)) {
+      (void)Body;
+      const auto *Function=cast<FunctionDecl>(Declaration);
+      if(!Function->getTemplateSpecializationArgs() || Function->getType()->isDependentType())return false;
+    }
+    return true;
+  }
+
+  OwnerSummary futureOwnerRequirements(const Expr *Closure) {
+    if (auto Found = OwnerSummaries->find(Closure); Found != OwnerSummaries->end())
+      return Found->second;
+    // Cache summaries by syntax, independently of the enclosing flow state.
+    // Each capture has a symbolic owner root, so local aliases/assignments and
+    // nested closures use the ordinary CFG solver without recursive inlining.
+    (*OwnerSummaries)[Closure] = {};
+    OwnerSummary Result;
+    auto Append=[](auto &Values,const VarDecl *Variable) {
+      if(!llvm::is_contained(Values,Variable))Values.push_back(Variable);
+    };
+    // Each closed synchronous specialization has its own CFG and parameter
+    // types. Union the required owners/effects across all materialized bodies.
+    for(const auto &[Declaration,NestedBody]:closureBodies(Closure)) {
+    BorrowedFlow Summary(Actions, Declaration, NestedBody);
+    Summary.IsOwnerSummary = true;
+    Summary.OwnerSummaries = OwnerSummaries;
+    const auto Captures = closureCaptures(Closure);
+    Summary.addOrigin(nullptr, nullptr);
+    for (const auto &Capture : Captures) {
+      Summary.addVariable(Capture.Variable);
+      Summary.SummaryCaptures.insert(Capture.Variable);
+    }
+    for (const auto &Capture : Captures)
+      if (auto Root = Summary.OwnerRoots.find(Capture.Variable);
+          Root != Summary.OwnerRoots.end()) {
+        Value Identity(Summary.OwnerRoots.size()); Identity.set(Root->second);
+        Summary.InheritedOwners[Capture.Variable] = std::move(Identity);
+      }
+    Summary.check();
+    for (const auto &Capture : Captures) {
+      if (Summary.AcquiredOwnerRoots.count(Capture.Variable)) Append(Result.Borrowed,Capture.Variable);
+      if (Summary.ConsumedOwnerRoots.count(Capture.Variable)) Append(Result.Consumed,Capture.Variable);
+      if (Summary.InvokedCallableCaptures.count(Capture.Variable)) Append(Result.Invoked,Capture.Variable);
+      if (Summary.MutatedCaptures.count(Capture.Variable)) Append(Result.Mutated,Capture.Variable);
+    }
+    for (unsigned Token : Summary.InvokedCallableTokens)
+      if (auto Path = Summary.SymbolicCallablePaths.find(Token); Path != Summary.SymbolicCallablePaths.end())
+        Result.InvokedPaths.push_back(Path->second);
+    }
+    (*OwnerSummaries)[Closure] = Result;
+    return Result;
+  }
+  void prepareFutureOwnerLoans() {
+    for (const auto &[Closure, Slot] : ClosureSlots) {
+      (void)Slot;
+      auto Summary = futureOwnerRequirements(Closure);
+      auto Dependencies = Summary.Borrowed;
+      for (const VarDecl *Consumed : Summary.Consumed)
+        if (!llvm::is_contained(Dependencies, Consumed)) Dependencies.push_back(Consumed);
+      FutureBorrowCaptures[Closure] = Dependencies;
+      const auto Owned = owningClosureCaptures(Closure);
+      for (const auto &Capture : closureCaptures(Closure)) {
+        if (!llvm::is_contained(Dependencies, Capture.Variable) ||
+            llvm::any_of(Owned, [&](const ClosureOwner &Owner) {
+              return Owner.Variable == Capture.Variable;
+            })) continue;
