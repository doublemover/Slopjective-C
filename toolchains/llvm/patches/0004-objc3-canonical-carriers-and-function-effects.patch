diff --git a/clang/test/ObjC3/Sema/match-type-directed-positive.mm b/clang/test/ObjC3/Sema/match-type-directed-positive.mm
new file mode 100644
index 000000000..3d4432b5c
--- /dev/null
+++ b/clang/test/ObjC3/Sema/match-type-directed-positive.mm
@@ -0,0 +1,64 @@
+// MATCH-PACKET: integration fixture; private migration spellings only.
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+void consume_int(int);
+void bool_domain(bool b) {
+  __objc3_match_stmt (b) {
+  case true: { consume_int(1); }
+  case false: { consume_int(0); }
+  }
+}
+
+using R = __objc3_result(int, long long);
+void consume_long(long long);
+void result_domain(R r) {
+  __objc3_match_stmt (r) {
+  case .Ok(let value): { consume_int(value); }
+  case .Err(let error): { consume_long(error); }
+  }
+}
+
+// A false guard falls through while the borrowed Result remains engaged.
+void guarded_fallback(R r) {
+  __objc3_match_stmt (r) {
+  case .Ok(let value) where false: { consume_int(value); }
+  default: { }
+  }
+}
+
+using O = __objc3_optional(long long);
+void consume_long_long(long long);
+void optional_domain(O o) {
+  __objc3_match_stmt (o) {
+  case __objc3_case_some(let value): { consume_long_long(value); }
+  case __objc3_case_none: { }
+  }
+}
+int optional_expression(O o) {
+  return __objc3_match (o) {
+  case __objc3_case_some(let value) => (int)value;
+  case __objc3_case_none => 0;
+  };
+}
+
+int bool_expression(bool b) {
+  return __objc3_match (b) {
+  case true => 1;
+  case false => 0;
+  };
+}
+
+// Open-domain statement matches may intentionally be partial; expression
+// matches need an unguarded fallback to prove exhaustion.
+void partial_integer_statement(int n) {
+  __objc3_match_stmt (n) {
+  case 0: { consume_int(0); }
+  }
+}
+int integer_expression_with_fallback(int n) {
+  return __objc3_match (n) {
+  case 0 => 1;
+  default => 2;
+  };
+}
