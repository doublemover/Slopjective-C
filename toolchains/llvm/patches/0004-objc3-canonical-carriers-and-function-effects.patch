+TEST(ObjC3Conditions, KeepsUseSiteCppCopyRecipesForSnapshotAndBinding) {
+  for (const char *Standard : {"c++20", "c++23"}) {
+    auto AST = tooling::buildASTFromCodeWithArgs(R"(
+      struct Payload { Payload(const Payload &); ~Payload(); };
+      typedef __objc3_optional(Payload) MaybePayload;
+      void test(MaybePayload source) {}
+    )", {"-x", "objective-c++", std::string("-std=") + Standard,
+         "-fobjc-version=3"}, "binding-copy.mm");
+    ASSERT_TRUE(AST);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    FunctionDecl *Function = nullptr;
+    for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *FD = dyn_cast<FunctionDecl>(D)) Function = FD;
+    ASSERT_TRUE(Function);
+    Sema &S = AST->getSema();
+    Sema::SynthesizedFunctionScope Scope(S, Function);
+    auto *Parameter = Function->getParamDecl(0);
+    SourceLocation Loc = Parameter->getLocation();
+    Expr *Source = S.BuildDeclRefExpr(Parameter, Parameter->getType(), VK_LValue, Loc);
+    StmtResult Result = S.ActOnObjC3BindingCondition(
+        nullptr, &AST->getASTContext().Idents.get("value"), Loc, false,
+        Loc, Loc, Source);
+    ASSERT_FALSE(Result.isInvalid());
+    auto *Binding = cast<ObjC3BindingCondition>(Result.get());
+    EXPECT_TRUE(isa<ObjC3CarrierTransferExpr>(
+        Binding->getSource()->IgnoreUnlessSpelledInSource()));
+    Expr *BindingInit = Binding->getBindingDecl()->getInit();
+    while (auto *Cleanups = dyn_cast<ExprWithCleanups>(BindingInit))
+      BindingInit = Cleanups->getSubExpr();
+    auto *Construction = dyn_cast<CXXConstructExpr>(BindingInit->IgnoreParenImpCasts());
+    ASSERT_TRUE(Construction);
+    EXPECT_TRUE(Construction->getConstructor()->isCopyConstructor());
+    EXPECT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  }
+}
