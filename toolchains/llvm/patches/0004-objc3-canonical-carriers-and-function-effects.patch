diff --git a/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp b/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp
new file mode 100644
index 000000000..4c5f0dba4
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3NonlocalJumps.cpp
@@ -0,0 +1,195 @@
+//===--- SemaObjC3NonlocalJumps.cpp - Scope-exit nonlocal transfers --------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "SemaObjC3Resources.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ObjC3SourceScopes.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/Basic/Builtins.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/STLExtras.h"
+
+using namespace clang;
+
+namespace {
+enum class JumpKind { None, Save, Restore };
+JumpKind jumpKind(const CallExpr *Call) {
+  const FunctionDecl *Function = Call->getDirectCallee();
+  if (!Function)
+    return JumpKind::None;
+  switch (Function->getBuiltinID()) {
+  case Builtin::BI__builtin_setjmp:
+  case Builtin::BI__sigsetjmp:
+  case Builtin::BI_setjmp:
+  case Builtin::BIsetjmp:
+  case Builtin::BIsigsetjmp:
+    return JumpKind::Save;
+  case Builtin::BI__builtin_longjmp:
+  case Builtin::BI_longjmp:
+  case Builtin::BIlongjmp:
+  case Builtin::BIsiglongjmp:
+    return JumpKind::Restore;
+  default:
+    break;
+  }
+  // -fno-builtin does not change the C library's nonlocal-transfer contract.
+  // A C++ member or namespace function with the same name has no such contract.
+  if (Function->getIdentifier() &&
+      (Function->isExternC() ||
+       (!Function->getASTContext().getLangOpts().CPlusPlus &&
+        Function->getDeclContext()->getRedeclContext()->isTranslationUnit()))) {
+    StringRef Name = Function->getName();
+    if (Name == "setjmp" || Name == "_setjmp" || Name == "sigsetjmp" ||
+        Name == "__sigsetjmp")
+      return JumpKind::Save;
+    if (Name == "longjmp" || Name == "_longjmp" || Name == "siglongjmp")
+      return JumpKind::Restore;
+  }
+  return JumpKind::None;
+}
+
+class NonlocalJumpCheck {
+  struct Action {
+    const Stmt *Owner;
+    const Stmt *Initializer;
+    SourceLocation Registration;
+  };
+  Sema &Actions;
+  ObjC3SourceScopes Scopes;
+  llvm::DenseMap<const Stmt *, const Stmt *> Parents;
+  llvm::DenseMap<const VarDecl *, unsigned> References, JumpReferences;
+  llvm::SmallPtrSet<const VarDecl *, 16> Captured;
+  SmallVector<const CallExpr *, 8> Saves, Restores;
+  SmallVector<Action, 16> Registrations;
+
+  void collect(const Stmt *Node, const Stmt *Parent = nullptr) {
+    if (!Node)
+      return;
+    Parents[Node] = Parent;
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Node))
+      if (const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl()))
+        ++References[Variable];
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const LambdaCapture &Capture : Lambda->captures())
+        if (Capture.capturesVariable())
+          if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+            Captured.insert(Variable);
+      for (const Expr *Initializer : Lambda->capture_inits())
+        collect(Initializer, Node);
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Node)) {
+      for (const BlockDecl::Capture &Capture : Block->getBlockDecl()->captures())
+        Captured.insert(Capture.getVariable());
+      return; // The nested callable has its own completed-body check.
+    }
+    if (const auto *Call = dyn_cast<CallExpr>(Node)) {
+      JumpKind Kind = jumpKind(Call);
+      if (Kind != JumpKind::None) {
+        (Kind == JumpKind::Save ? Saves : Restores).push_back(Call);
+        if (const VarDecl *Variable = buffer(Call))
+          ++JumpReferences[Variable];
+      }
+    }
+    for (const Stmt *Child : Node->children())
+      collect(Child, Node);
+  }
+
+  const VarDecl *buffer(const CallExpr *Call) const {
+    if (Call->getNumArgs() == 0)
+      return nullptr;
+    const auto *Reference =
+        dyn_cast<DeclRefExpr>(Call->getArg(0)->IgnoreParenImpCasts());
+    return Reference ? dyn_cast<VarDecl>(Reference->getDecl()) : nullptr;
+  }
+  bool within(const Stmt *Node, const Stmt *Owner) const {
+    for (; Node; Node = Parents.lookup(Node))
+      if (Node == Owner)
+        return true;
+    return false;
+  }
+  const Stmt *owner(const Stmt *SourceOwner) const {
+    // A for-condition declaration owns the per-iteration release queue, but
+    // its cleanup remains registered while the condition and body execute.
+    if (isa<DeclStmt>(SourceOwner))
+      if (const auto *Loop = dyn_cast_or_null<ForStmt>(Parents.lookup(SourceOwner)))
+        if (Loop->getConditionVariableDeclStmt() == SourceOwner)
+          return Loop;
+    return SourceOwner;
+  }
+  bool pending(const Action &Action, const CallExpr *Call) const {
+    return within(Call, Action.Owner) &&
+           (!Action.Initializer || !within(Call, Action.Initializer)) &&
+           Actions.getSourceManager().isBeforeInTranslationUnit(
+               Action.Registration, Call->getExprLoc());
+  }
+  const CallExpr *localTarget(const CallExpr *Restore) const {
+    const VarDecl *Buffer = buffer(Restore);
+    if (!Buffer || !Buffer->hasLocalStorage() || Buffer->hasAttr<BlocksAttr>() ||
+        !Buffer->getType()->isArrayType() || Captured.contains(Buffer) ||
+        References.lookup(Buffer) != JumpReferences.lookup(Buffer))
+      return nullptr;
+    const CallExpr *Target = nullptr;
+    for (const CallExpr *Save : Saves)
+      if (buffer(Save) == Buffer) {
+        if (Target)
+          return nullptr; // Multiple saves require dynamic target analysis.
+        Target = Save;
+      }
+    return Target;
+  }
+
+public:
+  NonlocalJumpCheck(Sema &Actions, const Stmt *Body)
+      : Actions(Actions), Scopes(Body) {
+    collect(Body);
+    for (auto [Deferred, Owner] : Scopes.Defers)
+      Registrations.push_back({owner(Owner), nullptr, Deferred->getBeginLoc()});
+    for (auto [Variable, Owner] : Scopes.Variables)
+      if (!Variable->isInvalidDecl() &&
+          (Variable->hasAttr<CleanupAttr>() || Variable->hasAttr<ObjCCleanupAttr>() ||
+           Variable->hasAttr<ObjCResourceAttr>() ||
+           Variable->hasAttr<ObjC3LifetimeBindingAttr>()))
+        Registrations.push_back({owner(Owner), Variable->getInit(),
+                                 Variable->getLocation()});
+    llvm::stable_sort(Registrations, [&](const Action &Left, const Action &Right) {
+      return Actions.getSourceManager().isBeforeInTranslationUnit(
+          Right.Registration, Left.Registration);
+    });
+  }
+  bool check() {
+    bool Invalid = false;
+    for (const CallExpr *Restore : Restores) {
+      const CallExpr *Target = localTarget(Restore);
+      for (const Action &Registration : Registrations) {
+        if (!pending(Registration, Restore) ||
+            (Target && pending(Registration, Target)))
+          continue;
+        Actions.Diag(Restore->getExprLoc(),
+                     Actions.getDiagnostics().getCustomDiagID(
+                         DiagnosticsEngine::Error,
+                         "non-local jump may bypass a registered cleanup action "
+                         "in a strict profile"));
+        Actions.Diag(Registration.Registration,
+                     Actions.getDiagnostics().getCustomDiagID(
+                         DiagnosticsEngine::Note,
+                         "scope-exit action registered here"));
+        Invalid = true;
+        break; // One action explains this transfer; do not duplicate errors.
+      }
+    }
+    return Invalid;
+  }
+};
+} // namespace
+
+bool clang::checkObjC3NonlocalJumps(Sema &S, const Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile == 0 || !Body)
+    return false;
+  return NonlocalJumpCheck(S, Body).check();
+}
