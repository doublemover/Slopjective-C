+#include "gtest/gtest.h"
+
+#include <memory>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-carrier-common-sugar.mm");
+}
+
+TypedefNameDecl *lookupTypedef(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  for (NamedDecl *Decl : Decls)
+    if (auto *Typedef = dyn_cast<TypedefNameDecl>(Decl))
+      return Typedef;
+  return nullptr;
+}
+
+class LocalVariableCollector
+    : public RecursiveASTVisitor<LocalVariableCollector> {
+public:
+  std::vector<VarDecl *> Variables;
+
+  bool VisitVarDecl(VarDecl *D) {
+    if (D->getName() == "values")
+      Variables.push_back(D);
+    return true;
+  }
+};
+
+TEST(ObjC3CarrierCommonSugar, PayloadAliasesRetainCanonicalCarrierIdentity) {
+  auto AST = parse(R"(
+    typedef int IntAlias;
+    typedef __objc3_optional(int) OptionalInt;
+    typedef __objc3_optional(IntAlias) OptionalAlias;
+    typedef __objc3_result(int, short) IntShortResult;
+    typedef __objc3_result(IntAlias, short) AliasShortResult;
+    typedef __objc3_result(short, int) ShortIntResult;
+  )");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  auto *OptionalDecl = lookupTypedef(Context, "OptionalInt");
+  auto *OptionalAliasDecl = lookupTypedef(Context, "OptionalAlias");
+  ASSERT_TRUE(OptionalDecl);
+  ASSERT_TRUE(OptionalAliasDecl);
+  QualType Optional = Context.getTypeDeclType(OptionalDecl);
+  QualType OptionalAlias = Context.getTypeDeclType(OptionalAliasDecl);
+  EXPECT_EQ(Optional->getTypeClass(), Type::Typedef);
+  EXPECT_EQ(Optional.getCanonicalType()->getTypeClass(), Type::ObjC3Optional);
+  ASSERT_TRUE(Context.hasSameType(Optional, OptionalAlias));
+  QualType CommonOptional =
+      Context.getCommonSugaredType(Optional, OptionalAlias);
+  EXPECT_TRUE(Context.hasSameType(CommonOptional, Optional));
+  EXPECT_EQ(CommonOptional.getCanonicalType(), Optional.getCanonicalType());
+
+  auto *ResultDecl = lookupTypedef(Context, "IntShortResult");
+  auto *ResultAliasDecl = lookupTypedef(Context, "AliasShortResult");
+  auto *ReversedResultDecl = lookupTypedef(Context, "ShortIntResult");
+  ASSERT_TRUE(ResultDecl);
+  ASSERT_TRUE(ResultAliasDecl);
+  ASSERT_TRUE(ReversedResultDecl);
+  QualType Result = Context.getTypeDeclType(ResultDecl);
+  QualType ResultAlias = Context.getTypeDeclType(ResultAliasDecl);
+  QualType ReversedResult = Context.getTypeDeclType(ReversedResultDecl);
+  EXPECT_EQ(Result->getTypeClass(), Type::Typedef);
+  EXPECT_EQ(Result.getCanonicalType()->getTypeClass(), Type::ObjC3Result);
+  EXPECT_TRUE(Context.hasSameType(Result, ResultAlias));
+  EXPECT_FALSE(Context.hasSameType(Result, ReversedResult));
+  QualType CommonResult = Context.getCommonSugaredType(Result, ResultAlias);
+  EXPECT_TRUE(Context.hasSameType(CommonResult, Result));
+  EXPECT_EQ(CommonResult.getCanonicalType(), Result.getCanonicalType());
+}
+
+TEST(ObjC3CarrierCommonSugar, RejectedVariablyModifiedPayloadIsNotRewritten) {
+  auto AST = parse(R"(
+    void f(int n) {
+      int values[n];
+    }
+  )");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  LocalVariableCollector Collector;
+  Collector.TraverseDecl(Context.getTranslationUnitDecl());
+  ASSERT_EQ(Collector.Variables.size(), 1u);
+
+  QualType VLA = Collector.Variables.front()->getType();
+  ASSERT_TRUE(VLA->isVariablyModifiedType());
+  QualType Optional = Context.getObjC3OptionalType(VLA);
+  QualType Result = Context.getObjC3ResultType(Context.IntTy, VLA);
+  EXPECT_EQ(Context.getVariableArrayDecayedType(Optional), Optional);
+  EXPECT_EQ(Context.getVariableArrayDecayedType(Result), Result);
+}
+
+} // namespace
