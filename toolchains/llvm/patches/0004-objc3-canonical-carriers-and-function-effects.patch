+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fexceptions -fcxx-exceptions -fobjc-exceptions -fsyntax-only -verify %s
+
+@protocol Error
+@end
+
+struct ParseError {};
+struct OtherError {};
+void typed() __objc3_throws(ParseError);
+void untyped() __objc3_throws;
+
+void catches_exact_typed_effect() {
+  __objc3_do {
+    __objc3_try(typed());
+  } __objc3_catch(ParseError error) {
+    (void)error;
+  }
+}
+
+void catches_unknown_with_bare_clause() {
+  __objc3_do {
+    __objc3_try(untyped());
+  } __objc3_catch {
+  }
+}
+
+void catches_unknown_with_explicit_bridge(id<Error> error) {
+  __objc3_do {
+    __objc3_try(untyped());
+  } __objc3_catch(id<Error> error) {
+    (void)error;
+  }
+}
+
+void rejects_inexact_typed_catch() {
+  __objc3_do {
+    __objc3_try(typed()); // expected-error {{ObjC3 error is neither caught here nor compatible with the enclosing throws effect}}
+  } __objc3_catch(OtherError error) { // expected-error {{ObjC3 catch type 'OtherError' is incompatible with thrown error type 'ParseError'}}
+    (void)error;
+  }
+}
+
+void native_cpp_exception_domain_is_separate() {
+  try {
+    throw 1;
+  } catch (int value) {
+    (void)value;
+  }
+}
+
+void native_objc_exception_domain_is_separate(id value) {
+  @try {
+    (void)value;
+  } @catch (id exception) {
+    (void)exception;
+  }
+}
+
+void typed_second() __objc3_throws(OtherError);
+void forwards_unmatched_facts_to_outer_handler() {
+  __objc3_do {
+    __objc3_do {
+      __objc3_try(typed());
+      __objc3_try(typed_second());
+    } __objc3_catch(ParseError) {
+    }
+  } __objc3_catch(OtherError) {
+  }
+}
+
+void explicit_typed_rethrow_reaches_outer_catch() {
+  __objc3_do {
+    __objc3_do {
+      __objc3_try(typed());
+    } __objc3_catch(ParseError error) {
+      __objc3_throw(error);
+    }
+  } __objc3_catch(ParseError outer) {
+    (void)outer;
+  }
+}
+
+void untyped_error_rejects_concrete_pattern() {
+  __objc3_do {
+    __objc3_try(untyped()); // expected-error {{ObjC3 error is neither caught here nor compatible with the enclosing throws effect}}
+  } __objc3_catch(ParseError) { // expected-error {{ObjC3 catch type 'ParseError' cannot handle an untyped error}}
+  }
+}
+
+// This call is nondependent. Transforming the handler must still re-record
+// its effect before checking the substituted catch type.
+template<class E> void instantiate_pattern() {
+  __objc3_do {
+    __objc3_try(typed()); // expected-error {{ObjC3 error is neither caught here nor compatible with the enclosing throws effect}}
+  } __objc3_catch(E) { // expected-error {{ObjC3 catch type 'OtherError' is incompatible with thrown error type 'ParseError'}}
+  }
+}
+void instantiate_matching_and_mismatching_patterns() {
+  instantiate_pattern<ParseError>();
+  instantiate_pattern<OtherError>(); // expected-note {{in instantiation of function template specialization}}
+}
+
+template<class E> void instantiate_explicit_raise() {
+  __objc3_do {
+    __objc3_throw(ParseError{}); // expected-error {{ObjC3 error is neither caught here nor compatible with the enclosing throws effect}}
+  } __objc3_catch(E) { // expected-error {{ObjC3 catch type 'OtherError' is incompatible with thrown error type 'ParseError'}}
+  }
+}
+void instantiate_matching_and_mismatching_raise_patterns() {
+  instantiate_explicit_raise<ParseError>();
+  instantiate_explicit_raise<OtherError>(); // expected-note {{in instantiation of function template specialization}}
+}
