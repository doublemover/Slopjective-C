+      const Origin &O = Origins[I];
+      if (O.Pin || (SnapshotSource && O.Owner != variable(SnapshotSource)))
+        continue;
+      if (O.Owner) {
+        auto Slot = Slots.find({O.Owner, nullptr});
+        if (Slot != Slots.end() &&
+            !State.OwnerIdentities[Slot->second].test(OwnerRoots.lookup(O.Identity)))
+          continue;
+      } else if (O.Identity) {
+        continue;
+      }
+      if (O.Identity) AcquiredOwnerRoots.insert(O.Identity);
+      bool Pinned = false;
+      for (unsigned PinnedIndex : Found->second) {
+        const Origin &PinnedOrigin = Origins[PinnedIndex];
+        if (!PinnedOrigin.Pin || PinnedOrigin.Identity != O.Identity ||
+            PinnedOrigin.Owner != O.Owner)
+          continue;
+        if (matchesPin(O, PinnedOrigin.Pin, State)) {
+          Result.set(PinnedIndex * 2);
+          Pinned = true;
+        }
+      }
+      if (!Pinned) {
+        const auto Slot = Slots.find({O.Owner, nullptr});
+        const bool Released = O.Owner && Slot != Slots.end() &&
+                              State.UnownedOwners.test(Slot->second);
+        Result.set(I * 2 + Released);
+      }
+    }
+    return Result;
+  }
+  Value exposedEffects(const Value &Targets, const Facts &State) const {
+    Value Result = empty(), Pending = Targets, Seen(Slots.size());
+    while (Pending.any()) {
+      int Index = Pending.find_first();
+      Pending.reset(Index);
+      if (Seen.test(Index)) continue;
+      Seen.set(Index);
+      Storage Location = location(Index);
+      Result |= contents(Location, storageType(Location), State, true);
+      Pending |= storageTargets(Location, storageType(Location), State);
+      Pending.reset(Seen);
+    }
+    return Result;
+  }
+  bool readCallablePath(Storage Source, ArrayRef<PathNode> Components,
+                        const Facts &State, Value &Result) const {
+    QualType Type = storageType(Source);
+    if (Type.isNull() || Components.size() > 32) return false;
+    if (Type->isReferenceType())
+      if (auto Slot = Slots.find(Source); Slot != Slots.end() && State.MayTargets[Slot->second].any()) {
+        for (int Target = State.MayTargets[Slot->second].find_first(); Target >= 0;
+             Target = State.MayTargets[Slot->second].find_next(Target))
+          if (!readCallablePath(location(Target), Components, State, Result)) return false;
+        return true;
+      }
+    for (const PathNode &Component : Components) {
+      Type = Type.getNonReferenceType();
+      if (Component.Field) {
+        const auto *Field = dyn_cast<FieldDecl>(Component.Field);
+        const auto *Record = Type->getAs<RecordType>();
+        if (!Field || !Record || Field->getParent()->getCanonicalDecl() != Record->getDecl()->getCanonicalDecl()) return false;
+        if (const auto *CXX = dyn_cast<CXXRecordDecl>(Record->getDecl()); CXX && CXX->getNumBases()) return false;
+        Source = fieldStorage(Source, Component.Field);Type = Component.Field->getType();
+      } else {
+        const auto *Array = Context.getAsArrayType(Type);
+        if (!Array) return false;
+        Source = indexedStorage(Source, Component.Index);Type = Array->getElementType();
+      }
+    }
+    Result |= contents(Source, Type, State, true);
+    Result |= exposedEffects(storageTargets(Source, Type, State), State);
+    return true;
+  }
+  bool readCallableInitializer(const Expr *E, ArrayRef<PathNode> Components,
+                               const Facts &State, Value &Result) const {
+    if (!E) return false;
