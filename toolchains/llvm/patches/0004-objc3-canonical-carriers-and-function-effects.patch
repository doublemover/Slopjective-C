+template<typename Derived>
+ExprResult TreeTransform<Derived>::TransformObjC3TryExpr(ObjC3TryExpr *E) {
+  ExprResult Operand;
+  if (const auto *Adapter = getObjC3CheckedAsyncAdapter(E->getOperand())) {
+    // Regenerate the frame-local error slot and await protocol in this context.
+    ExprResult Source = getDerived().TransformExpr(
+        const_cast<Expr *>(Adapter->getArg(0)));
+    if (Source.isInvalid())
+      return ExprError();
+    auto *Await = cast<CoawaitExpr>(E->getOperand()->IgnoreImplicit());
+    Operand = SemaRef.ActOnCoawaitExpr(SemaRef.getCurScope(),
+                                      Await->getKeywordLoc(), Source.get());
+  } else {
+    Operand = getDerived().TransformExpr(E->getOperand());
+  }
+  if (Operand.isInvalid())
+    return ExprError();
+  // Revalidate against the instantiated callable and record the effect in a
+  // newly transformed handler even for a nondependent, unchanged operand.
+  return SemaRef.ActOnObjC3TryExpr(static_cast<unsigned>(E->getKind()),
+      E->getKeywordLoc(), E->getLParenLoc(), Operand.get(), E->getRParenLoc());
+}
