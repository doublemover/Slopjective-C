+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+
+namespace clang::clangd {
+namespace {
+using ::testing::HasSubstr;
+using ::testing::UnorderedElementsAreArray;
+
+TestTU objc3TU(StringRef Code) {
+  auto TU = TestTU::withCode(Code);
+  TU.Filename = "ObjC3Source.mm";
+  TU.ExtraArgs = {"-xobjective-c++", "-std=c++20", "-fobjc-version=3",
+                  "-fobjc-runtime=gnustep-2.2"};
+  return TU;
+}
+
+void expectLocalEdits(ParsedAST &AST, const TestTU &TU, const Annotations &A,
+                      StringRef Group = "") {
+  auto Renamed = rename({A.point(), "renamed", AST, testPath(TU.Filename)});
+  if (!Renamed) {
+    ADD_FAILURE() << llvm::toString(Renamed.takeError());
+    return;
+  }
+  EXPECT_THAT(Renamed->LocalChanges,
+              UnorderedElementsAreArray(A.ranges(Group)));
+  std::vector<Range> References, Highlights;
+  for (const auto &Reference : findReferences(AST, A.point(), 0).References)
+    References.push_back(Reference.Loc.range);
+  for (const auto &Highlight : findDocumentHighlights(AST, A.point()))
+    Highlights.push_back(Highlight.range);
+  EXPECT_THAT(References, UnorderedElementsAreArray(A.ranges(Group)));
+  EXPECT_THAT(Highlights, UnorderedElementsAreArray(A.ranges(Group)));
+}
+
+TEST(ObjC3SourceTools, GuardBindingSelectionHoverAndRename) {
+  Annotations A(R"objc(
+    using Maybe = __objc3_optional(int);
+    int consume(Maybe source) {
+      guard let [[val^ue]] = source else { return -1; }
+      if var other = source, other > [[value]] {
+        other += [[value]];
+      }
+      return [[value]];
+    }
+  )objc");
+  auto TU = objc3TU(A.code());
+  auto AST = TU.build();
+  auto Offset = llvm::cantFail(positionToOffset(A.code(), A.point()));
+  auto Selection = SelectionTree::createRight(AST.getASTContext(),
+                                              AST.getTokens(), Offset, Offset);
+  ASSERT_TRUE(Selection.commonAncestor());
+  ASSERT_TRUE(Selection.commonAncestor()->ASTNode.get<VarDecl>());
+  auto Hover = getHover(AST, A.point(), format::getLLVMStyle(), nullptr);
+  ASSERT_TRUE(Hover);
+  EXPECT_EQ(Hover->Name, "value");
+  EXPECT_EQ(Hover->Definition, "let value = source");
+  ASSERT_TRUE(Hover->Type);
+  EXPECT_EQ(Hover->Type->Type, "const int");
+  expectLocalEdits(AST, TU, A);
+}
+
+TEST(ObjC3SourceTools, IfBindingRenameRespectsElseAndContinuationScopes) {
+  Annotations A(R"objc(
+    using Maybe = __objc3_optional(int);
+    int consume(Maybe source) {
+      int value = 1;
+      if var [[val^ue]] = source {
+        [[value]] += 2;
+        return [[value]];
+      } else {
+        value += 3;
+      }
+      return value;
+    }
+  )objc");
+  auto TU = objc3TU(A.code());
+  auto AST = TU.build();
+  auto Hover = getHover(AST, A.point(), format::getLLVMStyle(), nullptr);
+  ASSERT_TRUE(Hover);
+  EXPECT_EQ(Hover->Definition, "var value = source");
+  ASSERT_TRUE(Hover->Type);
+  EXPECT_EQ(Hover->Type->Type, "int");
+  expectLocalEdits(AST, TU, A);
+}
+
+TEST(ObjC3SourceTools, OptionalAccessHasOneWrittenReceiverAndArgument) {
+  Annotations A(R"objc(
+    __attribute__((objc_root_class))
+    @interface Box
+    @property Box *child;
+    - (Box *)choose:(Box *)value;
+    @end
+    Box *select(Box *[[b^ox]], Box *fallback) {
+      return [[box]]?.child ?? [ [[box]]? choose:fallback];
+    }
+  )objc");
+  auto TU = objc3TU(A.code());
+  auto AST = TU.build();
+  expectLocalEdits(AST, TU, A);
+  unsigned ReceiverReferences = 0, FallbackReferences = 0;
+  findExplicitReferences(
+      AST.getASTContext(),
+      [&](ReferenceLoc Ref) {
+        if (Ref.IsDecl)
+          return;
+        for (const auto *Target : Ref.Targets) {
+          ReceiverReferences +=
+              Target->getIdentifier() && Target->getName() == "box";
+          FallbackReferences +=
+              Target->getIdentifier() && Target->getName() == "fallback";
+        }
+      },
+      AST.getHeuristicResolver());
+  EXPECT_EQ(ReceiverReferences, 2u);
+  EXPECT_EQ(FallbackReferences, 1u);
+}
+
+TEST(ObjC3SourceTools, ResourceCallbackIsOneWrittenReference) {
+  Annotations A(R"objc(
+    void [[cl^ose_handle]](int);
+    int work() {
+      int handle __attribute__((objc_resource(close = [[close_handle]],
+                                              invalid = -1))) = 7;
+      __builtin_objc3_resource_reset(handle, 8);
+      return __builtin_objc3_resource_take(handle);
+    }
+  )objc");
+  auto TU = objc3TU(A.code());
+  auto AST = TU.build();
+  expectLocalEdits(AST, TU, A);
+  unsigned References = 0;
+  findExplicitReferences(
+      AST.getASTContext(),
+      [&](ReferenceLoc Ref) {
+        if (!Ref.IsDecl)
+          for (const auto *Target : Ref.Targets)
+            References +=
+                Target->getIdentifier() && Target->getName() == "close_handle";
+      },
+      AST.getHeuristicResolver());
+  EXPECT_EQ(References, 1u);
+}
+
+TEST(ObjC3SourceTools, ResourceHoverShowsContractAndTransferOperation) {
+  Annotations A(R"objc(
+    void close_handle(int);
+    int work() {
+      int $slot^handle __attribute__((objc_resource(close = close_handle,
+                                                  invalid = -1))) = 7;
+      return $take^__builtin_objc3_resource_take(handle);
+    }
+  )objc");
+  auto AST = objc3TU(A.code()).build();
+  auto Slot = getHover(AST, A.point("slot"), format::getLLVMStyle(), nullptr);
+  ASSERT_TRUE(Slot);
+  EXPECT_THAT(Slot->Documentation, HasSubstr("closes with `close_handle`"));
+  EXPECT_THAT(Slot->Documentation, HasSubstr("invalid value is `-1`"));
+  auto Take = getHover(AST, A.point("take"), format::getLLVMStyle(), nullptr);
+  ASSERT_TRUE(Take);
+  EXPECT_EQ(Take->Name, "__builtin_objc3_resource_take");
+  EXPECT_EQ(Take->Definition, "__builtin_objc3_resource_take(handle)");
+  EXPECT_THAT(Take->Documentation, HasSubstr("Transfers the resource value"));
+}
+
+TEST(ObjC3SourceTools, NativeOperatorsAndBindingsHaveSemanticTokens) {
+  Annotations A(R"objc(
+    using Maybe = __objc3_optional(int);
+    void close_handle(int);
+    int work(Maybe source) {
+      guard $binding[[let]] value = source else { return -1; }
+      int handle __attribute__(($attr[[objc_resource]](close = close_handle,
+                                                      invalid = -1))) = 7;
+      int taken = $operation[[__builtin_objc3_resource_take]](handle);
+      return (source $coalesce[[??]] taken) + value;
+    }
+  )objc");
+  auto AST = objc3TU(A.code()).build();
+  auto Tokens = getSemanticHighlightings(AST, false);
+  for (auto [Name, Kind] :
+       {std::pair("binding", HighlightingKind::Modifier),
+        std::pair("attr", HighlightingKind::Modifier),
+        std::pair("operation", HighlightingKind::Operator),
+        std::pair("coalesce", HighlightingKind::Operator)}) {
+    const auto ExpectedRange = A.range(Name);
+    auto Found = llvm::find_if(Tokens, [&](const HighlightingToken &Token) {
+      return Token.R == ExpectedRange;
+    });
+    ASSERT_NE(Found, Tokens.end()) << Name;
+    EXPECT_EQ(Found->Kind, Kind) << Name;
+  }
+}
+
+TEST(ObjC3SourceTools, CompletionFollowsGuardAndIfBindingScopes) {
+  for (const auto &[Code, Expected] : {std::pair(R"objc(
+          using Maybe = __objc3_optional(int);
+          int work(Maybe source) {
+            guard let guarded = source else { return -1; }
+            guard^;
+          })objc",
+                                                 true),
+                                       std::pair(R"objc(
+          using Maybe = __objc3_optional(int);
+          int work(Maybe source) {
+            if let guarded = source { return guarded; }
+            guard^;
+          })objc",
+                                                 false)}) {
+    Annotations A(Code);
+    auto TU = objc3TU(A.code());
+    MockFS FS;
+    auto Inputs = TU.inputs(FS);
+    IgnoreDiagnostics Diagnostics;
+    auto Invocation = buildCompilerInvocation(Inputs, Diagnostics);
+    ASSERT_TRUE(Invocation);
+    auto Preamble = buildPreamble(testPath(TU.Filename), *Invocation, Inputs,
+                                  true, nullptr);
+    auto Result = codeComplete(testPath(TU.Filename), A.point(), Preamble.get(),
+                               Inputs, {});
+    EXPECT_EQ(llvm::any_of(Result.Completions,
+                           [](const CodeCompletion &Completion) {
+                             return Completion.Name == "guarded";
+                           }),
+              Expected);
+  }
+}
+TEST(ObjC3SourceTools, ExplicitCaptureReferencesAndRenameStartAtCapture) {
