+    auto Replay=tooling::buildASTFromCodeWithArgs(Printed,Args,"factory-graphs-replay.mm");
+    ASSERT_TRUE(Replay);EXPECT_FALSE(Replay->getDiagnostics().hasErrorOccurred())<<Printed;
+    EXPECT_NE(Printed.find("auto *written_pointer"),std::string::npos);
+    EXPECT_NE(Printed.find("const auto *const_pointer"),std::string::npos);
