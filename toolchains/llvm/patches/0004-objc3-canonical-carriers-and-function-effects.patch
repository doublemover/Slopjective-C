+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -fsyntax-only -verify %s
+
+typedef __objc3_result(int, int) IntResult;
+typedef __objc3_result(_Bool, int) BoolResult;
+typedef __objc3_result(id, int) ObjectResult;
+typedef __objc3_result(void, void) VoidResult;
+
+struct Pair { int value; };
+
+void valid_construction_and_query(struct Pair pair) {
+  IntResult zero_success = __objc3_ok(int, int, 0);
+  IntResult zero_error = __objc3_err(int, int, 0);
+  BoolResult false_success = __objc3_ok(_Bool, int, 0);
+  ObjectResult null_success = __objc3_ok(id, int, (id)0);
+  __objc3_result(struct Pair, int) aggregate_success =
+      __objc3_ok(struct Pair, int, pair);
+  VoidResult void_success = __objc3_ok(void, void, (void)0);
+  VoidResult void_error = __objc3_err(void, void, (void)0);
+  _Bool success_tag = __objc3_is_ok(zero_success);
+  _Bool error_tag = __objc3_is_ok(zero_error);
+  _Bool aggregate_tag = __objc3_is_ok(aggregate_success);
+  (void)false_success;
+  (void)null_success;
+  (void)void_success;
+  (void)void_error;
+  (void)success_tag;
+  (void)error_tag;
+  (void)aggregate_tag;
+}
+
+void rejects_invalid_initialization(void) {
+  __objc3_ok(struct Pair, int, 1); // expected-error {{incompatible type}}
+  __objc3_err(int, struct Pair, 1); // expected-error {{incompatible type}}
+  __objc3_ok(void, int, 1); // expected-error {{incompatible type}}
+  __objc3_err(int, void, 1); // expected-error {{incompatible type}}
+  __objc3_is_ok(1); // expected-error {{must have a Result type}}
+  __objc3_ok(void, int[4], (void)0); // expected-error {{not supported}}
+}
+
+struct IncompleteSuccess; // expected-note {{forward declaration of 'struct IncompleteSuccess'}}
+struct IncompleteError; // expected-note {{forward declaration of 'struct IncompleteError'}}
+extern struct IncompleteSuccess incomplete_success;
+extern struct IncompleteError incomplete_error;
+void incomplete_unselected_arm_is_rejected(void) {
+  __objc3_ok(int, struct IncompleteError, 0);
+  // expected-error@-1 {{incomplete type}}
+  __objc3_err(struct IncompleteSuccess, int, 0);
+  // expected-error@-1 {{incomplete type}}
+}
diff --git a/clang/test/ObjC3/Sema/result-expression-cxx-initialization.mm b/clang/test/ObjC3/Sema/result-expression-cxx-initialization.mm
