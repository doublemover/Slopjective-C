diff --git a/clang/test/ObjC3/Parser/native-lambda-effects.mm b/clang/test/ObjC3/Parser/native-lambda-effects.mm
new file mode 100644
index 000000000..040059ae3
--- /dev/null
+++ b/clang/test/ObjC3/Parser/native-lambda-effects.mm
@@ -0,0 +1,16 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++20 -fsyntax-only -verify=common,cxx20 %s
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++23 -fsyntax-only -verify=common %s
+struct Error {};
+int use(Error error) __objc3_throws(Error) {
+  auto generic=[]<class E>(E value)->int __objc3_throws(E) {
+    __objc3_throw(value);
+  };
+  auto constant=[] __objc3_throws(Error) {return 42;}; // cxx20-warning {{lambda without a parameter clause is a C++23 extension}}
+  return __objc3_try(generic(error))+__objc3_try(constant());
+}
+int rejected(Error error) {
+  auto plain=[](Error value)->int {
+    __objc3_throw(value); // common-error {{an ObjC3 throw requires a throwing function}}
+  };
+  return plain(error);
+}
