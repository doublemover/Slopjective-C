+void Parser::ParseObjC3FunctionEffects(
+    bool &Async, unsigned &ThrowsKind, ParsedType &ErrorType,
+    TypeSourceInfo *&ErrorTypeInfo,
+    SourceLocation &EffectsLoc, SourceLocation &AsyncLoc,
+    SourceLocation &ThrowsLoc, SourceRange &PayloadRange) {
+  if (!getLangOpts().ObjC3)
+    return;
+  bool SawAsync = false;
+  bool SawThrows = false;
+  while (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+         (Tok.getIdentifierInfo()->isStr("__objc3_async") ||
+          (Tok.getIdentifierInfo()->isStr("__objc3_throws") ||
+           Tok.getIdentifierInfo()->isStr("throws")))) {
+    const bool IsAsync = Tok.getIdentifierInfo()->isStr("__objc3_async");
+    SourceLocation EffectLoc = Tok.getLocation();
+    ConsumeToken();
+    if (EffectsLoc.isInvalid())
+      EffectsLoc = EffectLoc;
+
+    if (IsAsync) {
+      if (SawAsync) {
+        Diag(EffectLoc, diag::err_objc3_duplicate_function_effect)
+            << "__objc3_async";
+        continue;
+      }
+      SawAsync = true;
+      Async = true;
+      AsyncLoc = EffectLoc;
+      continue;
+    }
+
+    if (SawThrows) {
+      Diag(EffectLoc, diag::err_objc3_duplicate_function_effect)
+          << "throws";
+      // Consume the duplicate's optional balanced payload for recovery.
+      if (Tok.is(tok::l_paren)) {
+        ConsumeParen();
+        SkipUntil(tok::r_paren, StopAtSemi | StopBeforeMatch);
+        if (Tok.is(tok::r_paren))
+          ConsumeParen();
+      }
+      continue;
+    }
+    SawThrows = true;
+    ThrowsLoc = EffectLoc;
+
+    if (!Tok.is(tok::l_paren)) {
+      // Bare throws uses the native object error contract in suffix position.
+      ThrowsKind = 1; // ObjC3ThrowsKind::Untyped
+      continue;
+    }
+
+    BalancedDelimiterTracker Payload(*this, tok::l_paren);
+    Payload.consumeOpen();
+    if (Tok.is(tok::r_paren)) {
+      Diag(EffectLoc, diag::err_objc3_throws_requires_payload);
+      Payload.consumeClose();
+      continue;
+    }
+
+    TypeResult ParsedErrorType = ParseTypeName(&PayloadRange);
+    if (ParsedErrorType.isInvalid()) {
+      Diag(EffectLoc, diag::err_objc3_invalid_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    if (Tok.is(tok::comma)) {
+      Diag(Tok, diag::err_objc3_invalid_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    if (!Tok.is(tok::r_paren)) {
+      Diag(Tok, diag::err_objc3_unterminated_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    Payload.consumeClose();
+    ThrowsKind = 2; // ObjC3ThrowsKind::Typed
+    ErrorType = ParsedErrorType.get();
+    Actions.GetTypeFromParser(ErrorType, &ErrorTypeInfo);
+  }
+}
