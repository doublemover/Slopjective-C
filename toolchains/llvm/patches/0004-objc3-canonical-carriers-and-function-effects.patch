+// RUN: %clang_cc1 -std=c++20 -fblocks -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fblocks -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// expected-no-diagnostics
+@class Object;
+@protocol Protocol
+@end
+using Block = int (^)(int);
+using VariadicBlock = int (^)(int, ...);
+struct Incomplete;
+struct Convertible { operator id(); };
+template<class T> constexpr bool object = __objc3_is_object_pointer(T);
+template<class T> constexpr bool block = __objc3_is_block_pointer(T);
+static_assert(object<id> && object<Class> && object<Object *>);
+static_assert(object<id<Protocol>> && object<Object *const>);
+static_assert(!object<Block> && !object<void *> && !object<Convertible>);
+static_assert(!object<Incomplete> && !object<decltype(nullptr)>);
+static_assert(block<Block> && block<VariadicBlock> && block<Block const>);
+static_assert(!block<id> && !block<void *> && !block<int (*)(int)>);
+static_assert(!block<Incomplete> && !block<Convertible> && !block<int>);
