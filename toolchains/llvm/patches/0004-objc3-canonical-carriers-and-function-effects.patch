+using MaybeInt = __objc3_optional(int);
+using IntOrWide = __objc3_result(int, long long);
+
+int pch_match(MaybeInt optional, IntOrWide result) {
+  int payload = __objc3_match (optional) {
+    case __objc3_case_some(let value) => value;
+    case __objc3_case_none => 0;
+  };
+  __objc3_match_stmt (result) {
+  case .Ok(let value): { payload += value; }
+  case .Err(let error): { payload += (int)error; }
+  }
+  return payload;
+}
