+          NonEquivalent, StructuralEquivalenceKind::Default,
+          /*StrictTypeSpelling=*/false, /*Complain=*/false);
+      return Context.IsEquivalent(Find(*From), Find(To));
+    };
+    EXPECT_FALSE(Equivalent(*Different));
