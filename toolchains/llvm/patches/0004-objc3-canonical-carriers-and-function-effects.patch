+int variadic(int, ...) __objc3_async __asm__("variadic_frame"); // expected-error {{require a non-variadic Linux x86-64}}
+id owned(void) __objc3_async __asm__("owned_frame") __attribute__((ns_returns_retained)); // expected-error {{cannot use object return ownership attributes}}
+_Noreturn void never(void) __objc3_async __asm__("never_frame"); // expected-error {{cannot be noreturn}}
+#elif CASE == 4
+// expected-no-diagnostics
+int definition(void) __objc3_async __asm__("definition_frame");
