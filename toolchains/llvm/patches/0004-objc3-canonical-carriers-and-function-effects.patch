new file mode 100644
index 000000000..55c98571f
--- /dev/null
+++ b/clang-tools-extra/clangd/ObjC3SourceInfo.h
@@ -0,0 +1,49 @@
+//===--- ObjC3SourceInfo.h - Native Objective-C source relationships -------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_OBJC3SOURCEINFO_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_OBJC3SOURCEINFO_H
+
+#include "clang/AST/Expr.h"
+#include "clang/AST/ParentMapContext.h"
+#include "clang/Basic/LangOptions.h"
+
+namespace clang::clangd {
+
+// An optional access has a written receiver and an opaque nonnull receiver in
+// the selected access. Visitors which unwrap OpaqueValueExpr must not report
+// the same source again while walking that selected access.
+inline bool isObjC3OptionalReceiver(const OpaqueValueExpr &Opaque,
+                                  const Expr *WrittenReceiver) {
+  return WrittenReceiver && Opaque.getSourceExpr() &&
+         Opaque.getSourceExpr()->IgnoreParenImpCasts() ==
+             WrittenReceiver->IgnoreParenImpCasts();
+}
+
+// Bindings infer their type and have a semantic payload-extraction initializer.
+// Recover the source condition rather than presenting that recipe as source.
+inline const ObjC3BindingCondition *getObjC3Binding(const VarDecl &Variable) {
+  ASTContext &Ctx = Variable.getASTContext();
+  if (!Ctx.getLangOpts().ObjC3 || !Variable.isLocalVarDecl())
+    return nullptr;
+  TraversalKindScope Scope(Ctx, TK_AsIs);
+  for (const auto &Parent : Ctx.getParents(Variable)) {
+    const auto *Statement = Parent.get<DeclStmt>();
+    if (!Statement)
+      continue;
+    for (const auto &Owner : Ctx.getParents(*Statement))
+      if (const auto *Binding = Owner.get<ObjC3BindingCondition>())
+        if (Binding->getBindingDecl() == &Variable)
+          return Binding;
+  }
+  return nullptr;
+}
+
+} // namespace clang::clangd
+
+#endif
