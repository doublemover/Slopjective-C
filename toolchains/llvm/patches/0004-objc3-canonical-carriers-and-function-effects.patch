+  bool ownerIsUnowned(const Expr *E, const Facts &State) const {
+    if (!E) return false;
+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return ownerIsUnowned(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return ownerIsUnowned(Opaque->getSourceExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E))
+      return ownerIsUnowned(Conditional->getTrueExpr(), State) ||
+             ownerIsUnowned(Conditional->getFalseExpr(), State);
+    if (const auto *Binary = dyn_cast<BinaryOperator>(E))
+      if (Binary->getOpcode() == BO_Comma || Binary->isAssignmentOp())
+        return ownerIsUnowned(Binary->getRHS(), State);
+    if (const VarDecl *Variable = variable(E))
+      if (auto Slot = Slots.find({Variable, nullptr}); Slot != Slots.end())
+        return State.UnownedOwners.test(Slot->second);
+    return false;
+  }
+  bool matchesPin(const Origin &O, const VarDecl *Binding,
+                   const Facts &State) const {
+    unsigned P = Pins.lookup(Binding);
+    if (!State.ActivePins.test(P))
+      return false;
+    auto Slot = Slots.find({Binding, nullptr});
+    if (Slot == Slots.end())
+      return false;
+    const Value &Identities = State.OwnerIdentities[Slot->second];
+    if (!Identities.test(OwnerRoots.lookup(O.Identity)))
+      return false;
+    // A direct unchanged snapshot proves equality even when a branch joined
+    // multiple possible identities. Different variables need one known root.
+    return (PinSources.lookup(Binding) == O.Owner && State.SamePins.test(P)) ||
