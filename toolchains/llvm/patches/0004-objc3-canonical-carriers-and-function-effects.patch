+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3DoCatchStmt(
+    ObjC3DoCatchStmt *S) {
+  ObjC3DoCatchContext *Handler =
+      SemaRef.ActOnObjC3BeginDoCatch(S->getDoLoc());
+  llvm::scope_exit AbortHandler(
+      [&] { SemaRef.ActOnObjC3AbortDoCatch(Handler); });
+
+  StmtResult Body = getDerived().TransformStmt(S->getBody());
+  if (Body.isInvalid())
+    return StmtError();
+  auto *CompoundBody = dyn_cast<CompoundStmt>(Body.get());
+  if (!CompoundBody)
+    return StmtError();
+  SemaRef.ActOnObjC3EndDoCatchBody(Handler);
+
+  SmallVector<ObjC3CatchStmt *, 2> Clauses;
+  for (unsigned I = 0; I != S->getNumCatchClauses(); ++I) {
+    StmtResult Clause = getDerived().TransformStmt(S->getCatchClause(I));
+    if (Clause.isInvalid())
+      return StmtError();
+    Clauses.push_back(cast<ObjC3CatchStmt>(Clause.get()));
+  }
+
+  StmtResult Result =
+      SemaRef.ActOnObjC3FinishDoCatch(Handler, CompoundBody, Clauses);
+  AbortHandler.release();
+  return Result;
 }
 
