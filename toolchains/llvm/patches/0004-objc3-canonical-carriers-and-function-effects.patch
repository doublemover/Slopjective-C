+  QualType FirstPayload;
+  QualType SecondPayload;
+  const bool IsOptional = isa<ObjC3OptionalType>(T);
+  if (const auto *Optional = dyn_cast<ObjC3OptionalType>(T)) {
+    FirstPayload = Optional->getElementType();
+  } else if (const auto *Result = dyn_cast<ObjC3ResultType>(T)) {
+    FirstPayload = Result->getSuccessType();
+    SecondPayload = Result->getErrorType();
+  } else {
+    return Info;
+  }
+
+  auto PayloadStatus = [](QualType Payload) {
+    if (Payload->isDependentType())
+      return ObjC3CarrierRepresentationInfo::Status::Deferred;
+    if (Payload->isVoidType())
+      return ObjC3CarrierRepresentationInfo::Status::Materialized;
+    // Arrays remain outside the carrier materialization policy even when an
+    // incomplete array might later acquire a bound through redeclaration.
+    if (Payload->isArrayType() || Payload->isVariablyModifiedType())
+      return ObjC3CarrierRepresentationInfo::Status::Unsupported;
+    // An incomplete record can become materializable later in this TU. Keep
+    // that distinct from a type whose shape is permanently unsupported.
+    if (Payload->isIncompleteType())
+      return ObjC3CarrierRepresentationInfo::Status::Deferred;
+    // Accepting a parsed function/reference type does not establish storage.
+    if (!Payload->isObjectType())
+      return ObjC3CarrierRepresentationInfo::Status::Unsupported;
+    return ObjC3CarrierRepresentationInfo::Status::Materialized;
+  };
+  const auto FirstStatus = PayloadStatus(FirstPayload);
+  const auto SecondStatus = IsOptional
+                                ? ObjC3CarrierRepresentationInfo::Status::Materialized
+                                : PayloadStatus(SecondPayload);
+  if (FirstStatus == ObjC3CarrierRepresentationInfo::Status::Unsupported ||
+      SecondStatus == ObjC3CarrierRepresentationInfo::Status::Unsupported)
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Unsupported;
+  else if (FirstStatus == ObjC3CarrierRepresentationInfo::Status::Deferred ||
+           SecondStatus == ObjC3CarrierRepresentationInfo::Status::Deferred)
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Deferred;
+  else
+    Info.State = ObjC3CarrierRepresentationInfo::Status::Materialized;
+  if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+    return Info;
