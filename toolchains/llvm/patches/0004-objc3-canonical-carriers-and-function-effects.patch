+
+objc3::MatchCoverageResult objc3::analyzeMatchCoverage(
+    ASTContext &Context, QualType ScrutineeType,
+    llvm::ArrayRef<MatchCoverageArm> Arms) {
+  MatchCoverageResult Out;
+  QualType Canonical = Context.getCanonicalType(ScrutineeType);
+  // Template-dependent domains are replayed by TreeTransform after
+  // substitution; do not classify a dependent type as an open runtime set.
+  if (Canonical->isDependentType())
+    return Out;
+  if (Canonical->isBooleanType())
+    Out.Domain = MatchDomain::Boolean;
+  else if (Canonical->getAs<ObjC3OptionalType>())
+    Out.Domain = MatchDomain::Optional;
+  else if (Canonical->getAs<ObjC3ResultType>())
+    Out.Domain = MatchDomain::Result;
+
+  bool SeenTrue = false, SeenFalse = false;
+  bool SeenSome = false, SeenNone = false;
+  bool SeenOK = false, SeenErr = false, SeenCatchAll = false;
+  for (unsigned I = 0; I != Arms.size(); ++I) {
+    const MatchCoverageArm &Arm = Arms[I];
+    if (SeenCatchAll) {
+      if (Out.Issue == MatchCoverageIssue::None) {
+        Out.Issue = MatchCoverageIssue::UnreachableCase;
+        Out.ArmIndex = I;
+      }
+      continue;
+    }
+
+    if (Arm.Kind == MatchPatternKind::TypeTest ||
+        Arm.Kind == MatchPatternKind::MoveBinding) {
+      // These require dynamic type queries or consuming ownership semantics;
+      // coverage must not accidentally make either feature appear admitted.
+      Out.Issue = MatchCoverageIssue::UnsupportedPattern;
+      Out.ArmIndex = I;
+      return Out;
+    }
+    if (Arm.Kind == MatchPatternKind::ResultOK ||
+        Arm.Kind == MatchPatternKind::ResultErr) {
+      if (Out.Domain != MatchDomain::Result ||
+          Arm.CanonicalPatternType != Canonical.getAsOpaquePtr()) {
+        Out.Issue = MatchCoverageIssue::PatternTypeMismatch;
+        Out.ArmIndex = I;
+        return Out;
+      }
+    } else if (Arm.Kind == MatchPatternKind::OptionalSome ||
+               Arm.Kind == MatchPatternKind::OptionalNone) {
+      if (Out.Domain != MatchDomain::Optional ||
+          Arm.CanonicalPatternType != Canonical.getAsOpaquePtr()) {
+        Out.Issue = MatchCoverageIssue::PatternTypeMismatch;
+        Out.ArmIndex = I;
+        return Out;
+      }
+    } else if ((Arm.Kind == MatchPatternKind::BooleanTrue ||
+                Arm.Kind == MatchPatternKind::BooleanFalse) &&
+               Out.Domain != MatchDomain::Boolean) {
+      Out.Issue = MatchCoverageIssue::PatternTypeMismatch;
+      Out.ArmIndex = I;
+      return Out;
+    }
+
+    bool *Seen = nullptr;
+    switch (Arm.Kind) {
+    case MatchPatternKind::BooleanTrue: Seen = &SeenTrue; break;
+    case MatchPatternKind::BooleanFalse: Seen = &SeenFalse; break;
+    case MatchPatternKind::OptionalSome: Seen = &SeenSome; break;
+    case MatchPatternKind::OptionalNone: Seen = &SeenNone; break;
+    case MatchPatternKind::ResultOK: Seen = &SeenOK; break;
+    case MatchPatternKind::ResultErr: Seen = &SeenErr; break;
+    default: break;
+    }
+    if (Seen && *Seen && !Arm.HasGuard) {
+      if (Out.Issue == MatchCoverageIssue::None) {
+        Out.Issue = MatchCoverageIssue::DuplicateCase;
+        Out.ArmIndex = I;
+      }
+      continue;
+    }
+    // Guarded cases can match at runtime but cannot prove coverage.
+    if (!Arm.HasGuard) {
+      if (Seen) *Seen = true;
+      if (Arm.Kind == MatchPatternKind::Wildcard ||
+          Arm.Kind == MatchPatternKind::Binding ||
+          Arm.Kind == MatchPatternKind::Default)
+        SeenCatchAll = true;
+    }
+  }
+
+  Out.CoversTrue = SeenTrue;
+  Out.CoversFalse = SeenFalse;
+  Out.CoversSome = SeenSome;
+  Out.CoversNone = SeenNone;
+  Out.CoversOK = SeenOK;
+  Out.CoversErr = SeenErr;
+  Out.HasCatchAll = SeenCatchAll;
+  Out.IsExhaustive = SeenCatchAll ||
+      (Out.Domain == MatchDomain::Boolean && SeenTrue && SeenFalse) ||
+      (Out.Domain == MatchDomain::Optional && SeenSome && SeenNone) ||
+      (Out.Domain == MatchDomain::Result && SeenOK && SeenErr);
+  if (!Out.IsExhaustive)
+    Out.Issue = MatchCoverageIssue::NonExhaustive;
+  return Out;
+}
