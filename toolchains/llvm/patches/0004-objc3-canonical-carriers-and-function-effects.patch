+TEST(ObjC3ConditionTooling, TraversesWrittenInitializersInBothOrders) {
+  auto AST = tooling::buildASTFromCodeWithArgs(ConditionSource, conditionArgs(),
+                                               "condition-tooling.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto *FD = findExercise(*AST);
+  ASSERT_TRUE(FD);
+  for (bool PostOrder : {false, true}) {
+    for (bool Implicit : {false, true}) {
+      SCOPED_TRACE(PostOrder);
+      SCOPED_TRACE(Implicit);
+      SourceVisitor Visitor;
+      Visitor.PostOrder = PostOrder;
+      Visitor.Implicit = Implicit;
+      ASSERT_TRUE(Visitor.TraverseStmt(FD->getBody()));
+      EXPECT_EQ(2u, Visitor.Bindings.size());
+      EXPECT_EQ(2u, Visitor.SourceReferences);
+      EXPECT_EQ(Implicit ? 4u : 2u, Visitor.DeclStatements);
+      EXPECT_EQ(Implicit ? 2u : 0u, Visitor.Snapshots);
+      auto FirstSource =
+          std::find(Visitor.Events.begin(), Visitor.Events.end(), "source");
+      auto FirstDecl =
+          std::find(Visitor.Events.begin(), Visitor.Events.end(), "decl:first");
+      EXPECT_LT(FirstSource, FirstDecl);
+      auto Binding = std::find(Visitor.Events.begin(), Visitor.Events.end(),
+                               "binding:first");
+      if (PostOrder)
+        EXPECT_LT(FirstDecl, Binding);
+      else
+        EXPECT_LT(Binding, FirstSource);
+    }
+  }
+  SourceVisitor Cancelled;
+  Cancelled.StopAtSource = true;
+  EXPECT_FALSE(Cancelled.TraverseStmt(FD->getBody()));
+  EXPECT_EQ(1u, Cancelled.SourceReferences);
+  EXPECT_EQ(1u, Cancelled.Bindings.size());
+  EXPECT_EQ(Cancelled.Events.end(),
+            std::find(Cancelled.Events.begin(), Cancelled.Events.end(),
+                      "decl:first"));
+}
