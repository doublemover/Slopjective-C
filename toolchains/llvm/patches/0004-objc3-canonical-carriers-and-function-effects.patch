+#ifndef OBJC3_RESOURCE_TYPES_PCH_H
+#define OBJC3_RESOURCE_TYPES_PCH_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+void close_type_handle(int) __attribute__((nothrow));
+void wrong_type_close(int) __attribute__((nothrow));
+#ifdef __cplusplus
+}
+#endif
+@requires_cleanup(close_type_handle) @resource_family(PCHHandles) @invalid(-1)
+typedef int PCHHandle;
+@requires_cleanup(wrong_type_close) @resource_family(PCHOther) @invalid(-1)
+typedef int OtherPCHHandle;
+typedef PCHHandle PCHAlias;
+static inline void pch_resource_owner(int input) {
+  @resource(close_type_handle, invalid: -1) PCHAlias value = input;
+}
+#endif
