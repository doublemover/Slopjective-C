diff --git a/clang/unittests/AST/ObjC3CarrierAdversarialTest.cpp b/clang/unittests/AST/ObjC3CarrierAdversarialTest.cpp
new file mode 100644
index 000000000..37f1e2094
--- /dev/null
+++ b/clang/unittests/AST/ObjC3CarrierAdversarialTest.cpp
@@ -0,0 +1,232 @@
+//===--- ObjC3CarrierAdversarialTest.cpp - carrier lifetime tests ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+
+#include <iterator>
+#include <memory>
+#include <vector>
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-carrier-adversarial.mm");
+}
+
+NamedDecl *lookup(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  return Decls.empty() ? nullptr : Decls.front();
+}
+
+Expr *stripFullExprAndImplicit(Expr *E) {
+  while (E) {
+    if (auto *FullExpr = dyn_cast<ExprWithCleanups>(E)) {
+      E = FullExpr->getSubExpr();
+      continue;
+    }
+    Expr *Unwrapped = E->IgnoreParenImpCasts();
+    if (Unwrapped == E)
+      return E;
+    E = Unwrapped;
+  }
+  return nullptr;
+}
+
+class CallCollector : public RecursiveASTVisitor<CallCollector> {
+public:
+  llvm::StringRef Name;
+  unsigned Count = 0;
+  explicit CallCollector(llvm::StringRef Name) : Name(Name) {}
+  bool VisitCallExpr(CallExpr *E) {
+    if (const auto *Callee = dyn_cast_or_null<DeclRefExpr>(
+            E->getCallee()->IgnoreParenImpCasts()))
+      Count += Callee->getDecl()->getName() == Name;
+    return true;
+  }
+};
+
+class TemporaryCollector : public RecursiveASTVisitor<TemporaryCollector> {
+public:
+  unsigned Count = 0;
+  bool VisitCXXBindTemporaryExpr(CXXBindTemporaryExpr *) {
+    ++Count;
+    return true;
+  }
+};
+
+TEST(ObjC3CarrierAdversarial, NestedCarrierAliasesAndQueryOperands) {
+  auto AST = parse(R"cpp(
+    typedef int Count;
+    using CountOptional = __objc3_optional(Count);
+    using NestedOptional = __objc3_optional(CountOptional);
+    using CountResult = __objc3_result(Count, long);
+    using NestedResult = __objc3_result(CountResult, NestedOptional);
+    auto Nested = __objc3_some(CountOptional, __objc3_some(Count, 0));
+    auto NestedOk = __objc3_ok(CountResult, NestedOptional,
+                               __objc3_ok(Count, long, 0));
+    auto NestedErr = __objc3_err(CountResult, NestedOptional,
+                                 __objc3_some(CountOptional,
+                                              __objc3_some(Count, 0)));
+    NestedOptional next_optional();
+    NestedResult next_result();
+    bool OptionalQuery = __objc3_has_value(next_optional());
+    bool ResultQuery = __objc3_is_ok(next_result());
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+
+  auto *Nested = dyn_cast_or_null<VarDecl>(lookup(Context, "Nested"));
+  auto *NestedOk = dyn_cast_or_null<VarDecl>(lookup(Context, "NestedOk"));
+  auto *NestedErr = dyn_cast_or_null<VarDecl>(lookup(Context, "NestedErr"));
+  auto *OptionalQuery =
+      dyn_cast_or_null<VarDecl>(lookup(Context, "OptionalQuery"));
+  auto *ResultQuery =
+      dyn_cast_or_null<VarDecl>(lookup(Context, "ResultQuery"));
+  ASSERT_NE(Nested, nullptr);
+  ASSERT_NE(NestedOk, nullptr);
+  ASSERT_NE(NestedErr, nullptr);
+  ASSERT_NE(OptionalQuery, nullptr);
+  ASSERT_NE(ResultQuery, nullptr);
+
+  auto *OuterSome = dyn_cast<ObjC3OptionalExpr>(
+      stripFullExprAndImplicit(Nested->getInit()));
+  ASSERT_NE(OuterSome, nullptr);
+  ASSERT_EQ(OuterSome->getKind(), ObjC3OptionalExpr::Kind::Some);
+  ASSERT_TRUE(OuterSome->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  auto *InnerSome = dyn_cast<ObjC3OptionalExpr>(
+      stripFullExprAndImplicit(OuterSome->getPayload()));
+  ASSERT_NE(InnerSome, nullptr);
+  EXPECT_TRUE(InnerSome->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(Context.hasSameType(OuterSome->getCarrierType(),
+                                  Nested->getType()));
+
+  auto *Ok = dyn_cast<ObjC3ResultExpr>(
+      stripFullExprAndImplicit(NestedOk->getInit()));
+  auto *Err = dyn_cast<ObjC3ResultExpr>(
+      stripFullExprAndImplicit(NestedErr->getInit()));
+  ASSERT_NE(Ok, nullptr);
+  ASSERT_NE(Err, nullptr);
+  EXPECT_EQ(Ok->getKind(), ObjC3ResultExpr::Kind::Ok);
+  EXPECT_EQ(Err->getKind(), ObjC3ResultExpr::Kind::Err);
+  EXPECT_TRUE(Ok->getSuccessTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(Ok->getErrorTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(Context.hasSameType(Ok->getCarrierType(), NestedOk->getType()));
+  EXPECT_TRUE(Context.hasSameType(Err->getCarrierType(), NestedErr->getType()));
+
+  auto *OptionalTest = dyn_cast<ObjC3OptionalExpr>(
+      stripFullExprAndImplicit(OptionalQuery->getInit()));
+  auto *ResultTest = dyn_cast<ObjC3ResultExpr>(
+      stripFullExprAndImplicit(ResultQuery->getInit()));
+  ASSERT_NE(OptionalTest, nullptr);
+  ASSERT_NE(ResultTest, nullptr);
+  CallCollector OptionalCalls("next_optional");
+  OptionalCalls.TraverseStmt(OptionalTest->getPayload());
+  EXPECT_EQ(OptionalCalls.Count, 1u);
+  CallCollector ResultCalls("next_result");
+  ResultCalls.TraverseStmt(ResultTest->getPayload());
+  EXPECT_EQ(ResultCalls.Count, 1u);
+  EXPECT_EQ(std::distance(OptionalTest->child_begin(),
+                          OptionalTest->child_end()), 1);
+  EXPECT_EQ(std::distance(ResultTest->child_begin(), ResultTest->child_end()),
+            1);
+}
+
+TEST(ObjC3CarrierAdversarial, CleanupWrappersEncloseEachFullExpression) {
+  auto AST = parse(R"cpp(
+    struct Source {
+      Source();
+      ~Source();
+    };
+    struct Tracked {
+      Tracked(const Source &);
+      ~Tracked();
+    };
+    Source make_source();
+    int finish();
+    void cleanup_boundaries() {
+      __objc3_some(Tracked, make_source());
+      bool present = __objc3_has_value(__objc3_some(Tracked, make_source()));
+      int sequenced =
+          (__objc3_is_ok(__objc3_ok(Tracked, int, make_source())), finish());
+      (void)present;
+      (void)sequenced;
+    }
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  auto *Function = dyn_cast_or_null<FunctionDecl>(
+      lookup(Context, "cleanup_boundaries"));
+  ASSERT_NE(Function, nullptr);
+  auto *Body = dyn_cast<CompoundStmt>(Function->getBody());
+  ASSERT_NE(Body, nullptr);
+  ASSERT_GE(Body->size(), 3u);
+
+  auto *ConstructionFullExpr = dyn_cast<ExprWithCleanups>(*Body->body_begin());
+  ASSERT_NE(ConstructionFullExpr, nullptr);
+  auto *Construction = dyn_cast<ObjC3OptionalExpr>(
+      stripFullExprAndImplicit(ConstructionFullExpr->getSubExpr()));
+  ASSERT_NE(Construction, nullptr);
+  EXPECT_EQ(Construction->getKind(), ObjC3OptionalExpr::Kind::Some);
+
+  auto It = Body->body_begin();
+  ++It;
+  auto *QueryDecl = dyn_cast<DeclStmt>(*It);
+  ASSERT_NE(QueryDecl, nullptr);
+  ASSERT_EQ(std::distance(QueryDecl->decl_begin(), QueryDecl->decl_end()), 1);
+  auto *Present = dyn_cast<VarDecl>(*QueryDecl->decl_begin());
+  ASSERT_NE(Present, nullptr);
+  auto *QueryFullExpr = dyn_cast<ExprWithCleanups>(Present->getInit());
+  ASSERT_NE(QueryFullExpr, nullptr);
+  auto *Query = dyn_cast<ObjC3OptionalExpr>(
+      stripFullExprAndImplicit(QueryFullExpr->getSubExpr()));
+  ASSERT_NE(Query, nullptr);
+  EXPECT_EQ(Query->getKind(), ObjC3OptionalExpr::Kind::HasValue);
+  // A carrier returned by value with nontrivial payload has no qualified
+  // lifetime adapter yet. This witness instead checks a real native Source
+  // temporary used to initialize the selected field, across a nested query.
+  EXPECT_FALSE(isa<ExprWithCleanups>(Query->getPayload()));
+
+  TemporaryCollector ConstructionTemps;
+  ConstructionTemps.TraverseStmt(ConstructionFullExpr->getSubExpr());
+  TemporaryCollector QueryTemps;
+  QueryTemps.TraverseStmt(QueryFullExpr->getSubExpr());
+  EXPECT_GT(ConstructionTemps.Count, 0u);
+  EXPECT_GT(QueryTemps.Count, 0u);
+
+  ++It;
+  auto *SequencedDecl = dyn_cast<DeclStmt>(*It);
+  ASSERT_NE(SequencedDecl, nullptr);
+  auto *Sequenced = dyn_cast<VarDecl>(*SequencedDecl->decl_begin());
+  ASSERT_NE(Sequenced, nullptr);
+  auto *SequencedFullExpr = dyn_cast<ExprWithCleanups>(Sequenced->getInit());
+  ASSERT_NE(SequencedFullExpr, nullptr);
+  auto *Comma = dyn_cast<BinaryOperator>(
+      SequencedFullExpr->getSubExpr()->IgnoreParenImpCasts());
+  ASSERT_NE(Comma, nullptr);
+  EXPECT_EQ(Comma->getOpcode(), BO_Comma);
+  TemporaryCollector SequencedTemps;
+  SequencedTemps.TraverseStmt(Comma);
+  EXPECT_GT(SequencedTemps.Count, 0u);
+  // Cleanup belongs to the complete comma expression, after finish().
+  EXPECT_FALSE(isa<ExprWithCleanups>(Comma->getLHS()->IgnoreParens()));
+}
+
+} // namespace
