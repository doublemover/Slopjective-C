+
+#define O3_OPTIONAL __objc3_optional
+#define O3_RESULT __objc3_result
+
+// A macro may deliberately expand to the reserved constructor spelling; the
+// preprocessor runs normally before the parser makes the type decision.
+typedef O3_RESULT(O3_OPTIONAL(HeaderScalar), int) MacroNestedCarrier;
+
+struct CxxMemberContext {
+  __objc3_optional(int) field;
+  __objc3_result(int, void) resultField;
+};
+
+void cxxLocalAndTypeIdContexts() {
+  __objc3_optional(int) local;
+  __objc3_result(int, void) resultLocal;
+  (void)sizeof(__objc3_optional(int));
+  (void)sizeof(__objc3_result(int, void));
+  auto *castTarget = static_cast<__objc3_optional(int) *>(nullptr);
+  (void)castTarget;
+  (void)typeid(__objc3_result(int, void));
+  (void)local;
+  (void)resultLocal;
+}
+
+// Parse the same declarations through Objective-C's dedicated method type
+// grammar, including macro aliases and nested constructors in selector types.
+@interface ObjCMethodTypeContexts
+- (__objc3_optional(int))optionalValue;
+- (void)consumeResult:(__objc3_result(int, void))value;
+- (MacroNestedCarrier)consumeNested:(O3_RESULT(O3_OPTIONAL(int), void))value;
+@end
