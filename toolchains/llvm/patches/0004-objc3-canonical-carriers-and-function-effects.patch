diff --git a/clang/test/ObjC3/Sema/function-effect-c-prototype-mixing.c b/clang/test/ObjC3/Sema/function-effect-c-prototype-mixing.c
new file mode 100644
index 000000000..7f06c11f4
--- /dev/null
+++ b/clang/test/ObjC3/Sema/function-effect-c-prototype-mixing.c
@@ -0,0 +1,92 @@
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -Werror=pointer-type-mismatch -fsyntax-only -verify %s
+
+typedef struct Error { int value; } Error;
+typedef struct OtherError { int value; } OtherError;
+typedef void NoPrototype();
+typedef void PlainPrototype(void);
+typedef void ThrowingPrototype(void) __objc3_throws(Error);
+typedef void OtherThrowingPrototype(void) __objc3_throws(OtherError);
+typedef void UntypedPrototype(void) __objc3_throws;
+typedef void AsyncPrototype(void) __objc3_async;
+
+// A plain C no-prototype declaration can still merge with an ordinary
+// no-effect prototype in either order.
+void plain_first();
+void plain_first(void);
+void prototype_first(void);
+void prototype_first();
+
+// A declaration with an effect cannot inherit or lose it across the
+// no-prototype boundary.
+void throws_mismatch(); // expected-note {{previous declaration is here}}
+void throws_mismatch(void) __objc3_throws(Error); // expected-error {{conflicting types for 'throws_mismatch'}}
+void async_mismatch(void) __objc3_async; // expected-note {{previous declaration is here}}
+void async_mismatch(); // expected-error {{conflicting types for 'async_mismatch'}}
+
+// The reserved effect suffix promotes empty parentheses to a prototype in C18.
+void effect_suffix_throws() __objc3_throws(Error);
+void effect_suffix_async() __objc3_async;
+
+// Composite C function-pointer types may widen a no-effect no-prototype
+// operand to a typed-throws prototype, in either operand order. The resulting
+// type must retain the exact throwing payload.
+NoPrototype *unprototyped;
+ThrowingPrototype *throwing;
+_Static_assert(_Generic((1 ? unprototyped : throwing),
+                        ThrowingPrototype *: 1, default: 0),
+               "composite function type retains typed throws");
+_Static_assert(_Generic((1 ? throwing : unprototyped),
+                        ThrowingPrototype *: 1, default: 0),
+               "reverse composite retains typed throws");
+
+// No-prototype callables cannot be composed into async types: async is a
+// distinct suspension contract, not a widening of the no-effect type.
+AsyncPrototype *async_fn;
+void reject_async_composites(void) {
+  AsyncPrototype *bad_async_forward = 1 ? unprototyped : async_fn; // expected-error {{pointer type mismatch}}
+  AsyncPrototype *bad_async_reverse = 1 ? async_fn : unprototyped; // expected-error {{pointer type mismatch}}
+  (void)bad_async_forward;
+  (void)bad_async_reverse;
+}
+
+// Function parameter adjustment/decay preserves the nested function type's effect contract.
+void direct_function_pointer_effect_conversions(
+    PlainPrototype *plain, NoPrototype *no_prototype,
+    ThrowingPrototype *typed, OtherThrowingPrototype *other,
+    UntypedPrototype *untyped, AsyncPrototype *async_fn) {
+  ThrowingPrototype *prototype_widen = plain;
+  ThrowingPrototype *no_prototype_widen = no_prototype;
+  PlainPrototype *reject_typed_narrow = typed; // expected-error {{incompatible function pointer types}}
+  NoPrototype *reject_no_prototype_narrow = typed; // expected-error {{incompatible function pointer types}}
+  ThrowingPrototype *reject_payload_change = other; // expected-error {{incompatible function pointer types}}
+  ThrowingPrototype *reject_untyped_to_typed = untyped; // expected-error {{incompatible function pointer types}}
+  PlainPrototype *reject_async_to_plain = async_fn; // expected-error {{incompatible function pointer types}}
+  AsyncPrototype *reject_plain_to_async = plain; // expected-error {{incompatible function pointer types}}
+  (void)prototype_widen;
+  (void)no_prototype_widen;
+  (void)reject_typed_narrow;
+  (void)reject_no_prototype_narrow;
+  (void)reject_payload_change;
+  (void)reject_untyped_to_typed;
+  (void)reject_async_to_plain;
+  (void)reject_plain_to_async;
+}
+// canonical effect identity.
+void expects_plain_parameter(NoPrototype callback); // expected-note {{passing argument to parameter 'callback' here}}
+void expects_throwing_parameter(ThrowingPrototype callback);
+void adjusted_parameter_effects(NoPrototype *plain,
+                                ThrowingPrototype *throwing) {
+  expects_throwing_parameter(plain); // nonthrowing-to-throwing widening
+  expects_plain_parameter(throwing); // expected-error {{incompatible function pointer types}}
+}
+
+// At an extra pointer level this is not a callable conversion: symmetric
+// prototype compatibility must not erase the typed effect in either direction.
+typedef NoPrototype *NoPrototypePointer;
+typedef ThrowingPrototype *ThrowingPointer;
+NoPrototypePointer *nested_no_prototype;
+ThrowingPointer *nested_throwing;
+void nested_effect_pointer_assignment(void) {
+  nested_no_prototype = nested_throwing; // expected-error {{incompatible pointer types}}
+  nested_throwing = nested_no_prototype; // expected-error {{incompatible pointer types}}
+}
