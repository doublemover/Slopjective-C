+namespace {
+void findBindingRedeclaration(Sema &S, VarDecl *Binding, Scope *Where,
+                              LookupResult &Previous) {
+  S.LookupName(Previous, Where);
+  S.FilterLookupForScope(Previous, S.CurContext, Where,
+                         /*ConsiderLinkage=*/false,
+                         /*AllowInlineNamespace=*/false);
+  // Variables may hide tag names, as in ordinary C/C++ local declarations.
+  auto Filter = Previous.makeFilter();
+  while (Filter.hasNext())
+    if (isa<TagDecl>(Filter.next()))
+      Filter.erase();
+  Filter.done();
+  S.CheckVariableDeclaration(Binding, Previous);
+}
+} // namespace
