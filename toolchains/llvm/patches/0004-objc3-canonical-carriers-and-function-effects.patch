+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -verify -fsyntax-only %s
+typedef __objc3_optional(id) Strong;
+void bypass(id object) {
+  goto done; // expected-error {{cannot jump}}
+  Strong value = __objc3_some(id, object); // expected-note {{jump bypasses initialization of managed carrier storage}}
+ done:;
+}
+void bypass_array(id object) {
+  goto done; // expected-error {{cannot jump}}
+  Strong values[2] = {__objc3_some(id, object)}; // expected-note {{jump bypasses initialization of managed carrier storage}}
+ done:;
+}
+void switch_bypass(int selector, id object) {
+  switch (selector) {
+    Strong values[2] = {__objc3_some(id, object)}; // expected-note {{jump bypasses initialization of managed carrier storage}}
+    case 1:; // expected-error {{cannot jump}}
+  }
+}
+void permitted_exit(id object) {
+  { Strong values[2] = {__objc3_some(id, object)}; goto done; }
+ done:;
+}
