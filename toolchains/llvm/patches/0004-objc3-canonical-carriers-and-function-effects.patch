+
+typedef void TypedE(void) __objc3_throws(E);
+typedef void TypedOther(void) __objc3_throws(Other);
+typedef void Untyped(void) __objc3_throws;
+typedef void Plain(void);
+typedef void Async(void) __objc3_async;
+void reject_effect_erasure(TypedE *typed, Untyped *untyped, Async *async_fn,
+                           Plain *plain) {
+  Plain *nonthrowing = typed; // expected-error {{cannot initialize a variable}}
+  TypedOther *other = typed; // expected-error {{cannot initialize a variable}}
