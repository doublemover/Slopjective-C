+      return Writeback->shouldCopy() ? effects(Writeback->getSubExpr(), State) : empty();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E)) return effects(Cleanups->getSubExpr(), State);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E)) return effects(Opaque->getSourceExpr(), State);
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(E)) return effects(Temporary->getSubExpr(), State);
+    if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(E)) return effects(Binding->getSubExpr(), State);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) &&
+          Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context))
+        return effects(Truth ? Conditional->getTrueExpr() : Conditional->getFalseExpr(), State);
