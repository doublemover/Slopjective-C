+typedef borrowed const char *ClosureBytes;
+ClosureBytes closure_bytes(void *owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void closure_use(const char *pointer __attribute__((noescape)));
+void closure_consume(void *owner __attribute__((cf_consumed)));
+void closure_invoke(void (^work)(void) __attribute__((noescape)));
+#ifdef __cplusplus
+template<class Work> void closure_sync(Work &work __attribute__((noescape)));
+#endif
+typedef void (^ClosureWork)(void);
+#if __has_feature(objc_arc)
+void closure_invoke_ref(ClosureWork __strong *work __attribute__((noescape)),int unused);
+void closure_writeback(ClosureWork *work __attribute__((noescape)),int unused);
+#else
+void closure_invoke_ref(ClosureWork *work __attribute__((noescape)),int unused);
+#endif
+typedef struct ClosureFamilyObject *ClosureFamilyRef __attribute__((objc_retainable_family(ClosureFamily)));
+void closure_family_drop(ClosureFamilyRef owner) __attribute__((objc_family_release(ClosureFamily)));
+__attribute__((objc_root_class)) @interface ClosureSink
+- (void)writeback:(ClosureWork * __attribute__((noescape)))work after:(int)unused;
+- (void)output:(out ClosureWork * __attribute__((noescape)))work;
+@end
+
+typedef void (*ClosureConsumer)(void *owner __attribute__((cf_consumed)));
+ClosureBytes closure_object_bytes(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+@interface ClosureSink (ManualRelease)
+- (void)release;
+@end
