+TEST(ObjC3FunctionEffectImport, PreservesClassAndVariableTemplateRedeclarations) {
+  for(const char *Standard:{"-std=c++20","-std=c++23"}) {
+    auto From=tooling::buildASTFromCodeWithArgs(R"(
+      template<class T=int,int Bias=2> class __attribute__((abi_tag("owner"))) Base;
+      template<class U,int Delta> class __attribute__((abi_tag("owner"))) Base {
+        U value;
+      public:
+        explicit Base(U n=U{40}):value(n){}
+        virtual ~Base()=default;
+        virtual int number()const{return int(value)+Delta;}
+      };
+      template<class T=int> struct __attribute__((abi_tag("derived"))) Derived:virtual Base<T> {
+        Derived():Base<T>(T{40}){}
+        int number()const override{return Base<T>::number();}
+      };
+      template<class T=int,int N=sizeof(T)> __attribute__((abi_tag("variable"))) extern T count;
+      template<class U,int M> __attribute__((abi_tag("variable"))) U count=M;
+    )",{"-xc++",Standard});
+    auto To=tooling::buildASTFromCodeWithArgs("",{"-xc++",Standard});
+    ASSERT_TRUE(From && To);
+    ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+    std::string Printed;
+    llvm::raw_string_ostream PrintedStream(Printed);
+    PrintingPolicy Policy(From->getLangOpts());
+    From->getASTContext().getTranslationUnitDecl()->print(PrintedStream,Policy);
+    auto Replayed=tooling::buildASTFromCodeWithArgs(Printed,{"-xc++",Standard});
+    ASSERT_TRUE(Replayed);
+    ASSERT_FALSE(Replayed->getDiagnostics().hasErrorOccurred());
+    auto Shared=std::make_shared<ASTImporterSharedState>(*To->getASTContext().getTranslationUnitDecl());
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                         From->getASTContext(),From->getFileManager(),false,Shared);
+    for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls()) {
+      auto *Pattern=dyn_cast<RedeclarableTemplateDecl>(D);
+      if(!Pattern)continue;
+      if(auto *Class=dyn_cast<ClassTemplateDecl>(Pattern)) {
+        if(!Class->getTemplatedDecl()->isCompleteDefinition())continue;
+      } else if(auto *Variable=dyn_cast<VarTemplateDecl>(Pattern)) {
+        if(Variable->getTemplatedDecl()->isThisDeclarationADefinition()==VarDecl::DeclarationOnly)continue;
+      } else continue;
+      SCOPED_TRACE(Pattern->getNameAsString());
+      auto Imported=Importer.Import(Pattern);
+      ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+      auto *Result=cast<RedeclarableTemplateDecl>(*Imported);
+      if(Result->getName()!="Derived") {
+        // Class import can fold a forward declaration into its definition.
+        // Default arguments and one canonical lookup owner must still survive.
+        if(isa<VarTemplateDecl>(Result)) EXPECT_NE(Result->getPreviousDecl(),nullptr);
+        EXPECT_TRUE(cast<TemplateTypeParmDecl>(Result->getTemplateParameters()->getParam(0))->hasDefaultArgument());
+        EXPECT_TRUE(cast<NonTypeTemplateParmDecl>(Result->getTemplateParameters()->getParam(1))->hasDefaultArgument());
+      }
+      auto Lookup=To->getASTContext().getTranslationUnitDecl()->lookup(Result->getDeclName());
+      EXPECT_EQ(std::distance(Lookup.begin(),Lookup.end()),1);
+      if(auto *Class=dyn_cast<ClassTemplateDecl>(Result)) {
+        auto *Record=Class->getTemplatedDecl();
+        EXPECT_TRUE(Record->isCompleteDefinition());
+        if(Result->getName()=="Derived") {
+          EXPECT_EQ(Record->getNumBases(),1u);
+          EXPECT_TRUE(Record->bases_begin()->isVirtual());
+        } else EXPECT_TRUE(Record->isPolymorphic());
+      } else {
+        auto *Variable=cast<VarTemplateDecl>(Result)->getTemplatedDecl();
+        EXPECT_NE(Variable->getPreviousDecl(),nullptr);
+        EXPECT_TRUE(Variable->hasInit());
+      }
+    }
+  }
+}
