new file mode 100644
index 000000000..6097e37d2
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-transfer.cpp
@@ -0,0 +1,55 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -std=c++20 -fsyntax-only -verify %s
+
+struct CopyMove {
+  CopyMove();
+  CopyMove(const CopyMove &);
+  CopyMove(CopyMove &&);
+  ~CopyMove();
+};
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete; // expected-note {{explicitly marked deleted here}}
+  MoveOnly(MoveOnly &&);
+  ~MoveOnly();
+};
+using Maybe = __objc3_optional(CopyMove);
+using MoveMaybe = __objc3_optional(MoveOnly);
+using Outcome = __objc3_result(CopyMove, CopyMove);
+
+void accepted_transfers(Maybe &source, const Maybe &constSource,
+                        Maybe &&xvalue, Outcome &result,
+                        MoveMaybe &moveOnly) {
+  Maybe copied = __objc3_copy(source);
+  Maybe copiedConst = __objc3_copy(constSource);
+  Maybe moved = __objc3_move(source);
+  Maybe movedConst = __objc3_move(constSource);
+  Maybe movedXvalue = __objc3_move(static_cast<Maybe &&>(xvalue));
+  Outcome copiedResult = __objc3_copy(result);
+  MoveMaybe movedOnly = __objc3_move(moveOnly);
+  (void)copied;
+  (void)copiedConst;
+  (void)moved;
+  (void)movedConst;
+  (void)movedXvalue;
+  (void)copiedResult;
+  (void)movedOnly;
+}
+
+template <class Carrier> void dependent_copy(Carrier &source) {
+  Carrier local = __objc3_copy(source);
+  (void)local;
+}
+template void dependent_copy<Maybe>(Maybe &);
+
+void rejected_transfers(Maybe &source, MoveMaybe &moveOnly) {
+  Maybe badCopy = __objc3_copy(static_cast<Maybe &&>(source)); // expected-error {{argument to 'copyValue' must be an existing carrier lvalue}}
+  Maybe temporary = __objc3_copy(__objc3_some(CopyMove, CopyMove())); // expected-error {{argument to 'copyValue' must be an existing carrier glvalue}}
+  Maybe movedTemporary = __objc3_move(__objc3_some(CopyMove, CopyMove())); // expected-error {{argument to 'moveValue' must be an existing carrier glvalue}}
+  MoveMaybe deletedCopy = __objc3_copy(moveOnly); // expected-error {{deleted constructor}}
+  volatile Maybe volatileSource;
+  Maybe badVolatile = __objc3_move(volatileSource); // expected-error {{volatile carrier copy and move construction is not supported}}
+  (void)badCopy;
+  (void)temporary;
+  (void)movedTemporary;
+  (void)deletedCopy;
+  (void)badVolatile;
+}
