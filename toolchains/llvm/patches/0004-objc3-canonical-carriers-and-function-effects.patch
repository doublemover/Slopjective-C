+ASTContext::getObjC3CarrierRepresentationType(QualType CarrierType) const {
+  ObjC3CarrierRepresentationInfo Info;
+  if (CarrierType.isNull())
+    return Info;
+
+  const Type *T = getCanonicalType(CarrierType).getTypePtr();
+  auto Existing = ObjC3CarrierRepresentations.find(T);
+  if (Existing != ObjC3CarrierRepresentations.end())
+    return Existing->second;
