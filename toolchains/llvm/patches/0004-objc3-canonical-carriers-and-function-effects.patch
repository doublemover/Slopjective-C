+void clang::handleObjC3ReturnsBorrowedAttr(Sema &S, Decl *D,
+                                          const ParsedAttr &Attribute) {
+  auto Reject = [&](StringRef Message) {
+    S.Diag(Attribute.getLoc(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                  DiagnosticIDs::Level::Error, Message));
+    D->setInvalidDecl();
+  };
+  if (!S.getLangOpts().ObjC3) {
+    Reject("objc_returns_borrowed requires Objective-C 3.0");
+    return;
+  }
+  ArrayRef<ParmVarDecl *> Parameters;
+  QualType Return;
+  if (const auto *Function = dyn_cast<FunctionDecl>(D)) {
+    Parameters = Function->parameters();
+    Return = Function->getReturnType();
+  } else if (const auto *Method = dyn_cast<ObjCMethodDecl>(D)) {
+    Parameters = Method->parameters();
+    Return = Method->getReturnType();
+  } else {
+    Reject("objc_returns_borrowed requires a function or method declaration");
+    return;
+  }
+  if (!isObjC3BorrowedType(S.Context, Return)) {
+    Reject("objc_returns_borrowed requires a borrowed pointer return type");
+    return;
+  }
+  Expr *Argument = Attribute.getArgAsExpr(0);
+  auto Index = Argument->getIntegerConstantExpr(S.Context);
+  if (!Index || Index->isNegative() || Index->getActiveBits() > 32 ||
+      Index->getZExtValue() >= Parameters.size()) {
+    Reject("objc_returns_borrowed owner_index must be a valid zero-based formal parameter index");
+    return;
+  }
+  unsigned N = Index->getZExtValue();
+  QualType OwnerType = Parameters[N]->getType();
+  if (!(OwnerType->isPointerType() || OwnerType->isObjCObjectPointerType() ||
+        OwnerType->isReferenceType() || OwnerType->isBlockPointerType()) ||
+      isObjC3BorrowedType(S.Context, OwnerType.getNonReferenceType())) {
+    Reject("objc_returns_borrowed owner parameter must be an owning object, reference, or non-borrowed pointer");
+    return;
+  }
+  if (const auto *Existing = D->getAttr<ObjCReturnsBorrowedAttr>()) {
+    if (Existing->getOwnerIndex() != N)
+      Reject("conflicting objc_returns_borrowed owner parameter indices");
+    return;
+  }
+  D->addAttr(ObjCReturnsBorrowedAttr::Create(S.Context, N, Attribute));
+}
+
+bool clang::checkObjC3BorrowedRedeclaration(Sema &S, FunctionDecl *New,
+                                           FunctionDecl *Old) {
+  if (!S.getLangOpts().ObjC3 ||
+      sameObjC3BorrowedSignature(S.Context, New, S.Context, Old))
+    return false;
+  S.Diag(New->getLocation(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                DiagnosticIDs::Level::Error,
+                                "conflicting borrowed pointer declaration contract for '%0'"))
+      << New;
+  S.Diag(Old->getLocation(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                DiagnosticIDs::Level::Note,
+                                "previous borrowed pointer contract is declared here"));
+  return true;
+}
+
+QualType clang::preserveObjC3BorrowedType(Sema &S, QualType Composite,
+                                         QualType Source) {
+  ASTContext &Context = S.Context;
+  if (!S.getLangOpts().ObjC3 || Composite.isNull() || Source.isNull() ||
+      sameObjC3BorrowedType(Context, Composite, Context, Source))
+    return Composite;
+  // Keep other merged type attributes (nullability, calling convention, etc.)
+  // while inserting the ABI-neutral lifetime marker at its source positions.
+  if (const auto *Attribute = dyn_cast<AttributedType>(Composite.getTypePtr())) {
+    QualType Modified = preserveObjC3BorrowedType(S, Attribute->getModifiedType(), Source);
+    QualType Equivalent = preserveObjC3BorrowedType(S, Attribute->getEquivalentType(), Source);
+    return Context.getAttributedType(Attribute->getAttrKind(), Modified,
+                                      Equivalent, Attribute->getAttr());
+  }
+  QualType Result = Composite;
+  if (const auto *CF = Composite->getAs<FunctionProtoType>()) {
+    if (const auto *SF = Source->getAs<FunctionProtoType>()) {
+      if (CF->getNumParams() == SF->getNumParams()) {
+        SmallVector<QualType, 8> Parameters;
+        for (unsigned I = 0; I != CF->getNumParams(); ++I)
+          Parameters.push_back(preserveObjC3BorrowedType(
+              S, CF->getParamType(I), SF->getParamType(I)));
+        Result = Context.getFunctionType(preserveObjC3BorrowedType(
+            S, CF->getReturnType(), SF->getReturnType()), Parameters,
+            CF->getExtProtoInfo());
+      }
+    }
+  } else if (const auto *CF = Composite->getAs<FunctionNoProtoType>()) {
+    if (const auto *SF = Source->getAs<FunctionType>())
+      Result = Context.getFunctionNoProtoType(preserveObjC3BorrowedType(
+          S, CF->getReturnType(), SF->getReturnType()), CF->getExtInfo());
+  } else if (Composite->isPointerType() && Source->isPointerType()) {
+    Result = Context.getPointerType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isBlockPointerType() && Source->isBlockPointerType()) {
+    Result = Context.getBlockPointerType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isLValueReferenceType() && Source->isReferenceType()) {
+    Result = Context.getLValueReferenceType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (Composite->isRValueReferenceType() && Source->isReferenceType()) {
+    Result = Context.getRValueReferenceType(preserveObjC3BorrowedType(
+        S, Composite->getPointeeType(), Source->getPointeeType()));
+  } else if (const auto *CO = Composite->getAs<ObjC3OptionalType>()) {
+    if (const auto *SO = Source->getAs<ObjC3OptionalType>())
+      Result = Context.getObjC3OptionalType(preserveObjC3BorrowedType(
+          S, CO->getElementType(), SO->getElementType()));
+  } else if (const auto *CR = Composite->getAs<ObjC3ResultType>()) {
+    if (const auto *SR = Source->getAs<ObjC3ResultType>())
+      Result = Context.getObjC3ResultType(preserveObjC3BorrowedType(
+          S, CR->getSuccessType(), SR->getSuccessType()),
+          preserveObjC3BorrowedType(S, CR->getErrorType(), SR->getErrorType()));
+  } else if (const auto *CA = Context.getAsArrayType(Composite)) {
+    if (const auto *SA = Context.getAsArrayType(Source)) {
+      QualType Element = preserveObjC3BorrowedType(
+          S, CA->getElementType(), SA->getElementType());
+      if (const auto *Constant = dyn_cast<ConstantArrayType>(CA))
+        Result = Context.getConstantArrayType(Element, Constant->getSize(),
+            Constant->getSizeExpr(), CA->getSizeModifier(),
+            CA->getIndexTypeCVRQualifiers());
+      else if (isa<IncompleteArrayType>(CA))
+        Result = Context.getIncompleteArrayType(Element, CA->getSizeModifier(),
+                                                CA->getIndexTypeCVRQualifiers());
+      else if (const auto *Variable = dyn_cast<VariableArrayType>(CA))
+        Result = Context.getVariableArrayType(Element, Variable->getSizeExpr(),
+            CA->getSizeModifier(), CA->getIndexTypeCVRQualifiers());
+    }
+  }
+  Result = Context.getQualifiedType(Result, Composite.getQualifiers());
+  if (isObjC3BorrowedType(Context, Source) &&
+      !isObjC3BorrowedType(Context, Result)) {
+    auto *Marker = ObjC3BorrowedAttr::CreateImplicit(Context);
+    Result = Context.getAttributedType(Marker, Result, Result);
+  }
+  return Result;
+}
