+static_assert(!DeducedEffects<FrameFirst>::match);
+static_assert(sizeof(deduceKind((PlainTask)0)) == sizeof(char));
+static_assert(sizeof(deduceKind((BareTask)0)) == sizeof(short));
+static_assert(sizeof(deduceKind((TaskFirst)0)) == sizeof(long));
+static_assert(sizeof(deduceRepresentation((TaskFirst)0)) == sizeof(char));
+static_assert(sizeof(deduceRepresentation((FrameFirst)0)) == sizeof(long));
+
+template <class E>
+void sameError(int (^)(void) __objc3_async __objc3_throws(E), // expected-note {{candidate template ignored: deduced conflicting types}}
+               int (^)(void) __objc3_async __objc3_throws(E));
+template <class R, class E>
+void frameOnly(R (^)(void) __objc3_async_frame __objc3_throws(E)); // expected-note {{candidate template ignored}}
+template <class R>
+void nonthrowingOnly(R (^)(void) __objc3_async); // expected-note {{candidate template ignored}}
+void mismatches(TaskFirst first, TaskSecond second) {
+  sameError(first, second); // expected-error {{no matching function for call to 'sameError'}}
+  frameOnly(first); // expected-error {{no matching function for call to 'frameOnly'}}
+  nonthrowingOnly(first); // expected-error {{no matching function for call to 'nonthrowingOnly'}}
+}
