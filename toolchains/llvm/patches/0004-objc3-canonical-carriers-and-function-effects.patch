+  friend bool operator==(const ObjC3FunctionEffectInfo &LHS,
+                         const ObjC3FunctionEffectInfo &RHS) {
+    return LHS.Async == RHS.Async && LHS.Throws == RHS.Throws &&
+           LHS.ErrorType == RHS.ErrorType;
+  }
+  friend bool operator!=(const ObjC3FunctionEffectInfo &LHS,
+                         const ObjC3FunctionEffectInfo &RHS) {
+    return !(LHS == RHS);
+  }
+};
