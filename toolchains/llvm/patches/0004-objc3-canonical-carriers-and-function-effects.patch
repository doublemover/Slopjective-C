+++ b/clang/test/ObjC3/Sema/function-effect-compatibility.c
@@ -0,0 +1,45 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++20 -fblocks -fobjc-exceptions -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+struct E {};
+struct EAliasTag {};
+using EAlias = E;
+
+// A typedef spelling for the same canonical payload is the same signature.
+void same_typed_effect() __objc3_throws(E);
+void same_typed_effect() __objc3_throws(EAlias);
+
+typedef void PlainFn(void);
+typedef void TypedFn(void) __objc3_throws(E);
+typedef void UntypedFn(void) __objc3_throws;
+void accepted_widening(PlainFn *plain) {
+  TypedFn *typed = plain;
+  UntypedFn *untyped = plain;
+  (void)typed;
+  (void)untyped;
+}
+
+// C++ noexcept remains a distinct exception specification and keeps its
+// standard function-pointer conversion direction.
+typedef void CppNoexceptFn(void) noexcept;
+typedef void CppMayThrowFn(void);
+void cpp_eh_passthrough(CppNoexceptFn *noexcept_fn) {
+  CppMayThrowFn *may_throw = noexcept_fn;
+  (void)may_throw;
+}
+
+// Block callables use the same effect relation.
+typedef void (^PlainBlock)(void);
+typedef void (^TypedBlock)(void) __objc3_throws(E);
+void accepted_block_widening(PlainBlock plain) {
+  TypedBlock typed = plain;
+  (void)typed;
+}
+
+int throws;
+int ordinary_throws_identifier = throws;
+
+void objc_exception_passthrough(void) {
+  @try { (void)0; } @catch (id error) { (void)error; }
+}
