+          if (!Source) {UnstableFutureOwners.insert(Closure);continue;}
+          addVariable(Source);
+          for (const auto &[Root, Index] : OwnerRoots) {
+            (void)Index;
+            const Expr *ClosureExpr = Closure;
+            const VarDecl *CapturedRoot = Root;
+            auto Add = [&](const VarDecl *Pin) {
+              addOrigin(ClosureExpr, Source, false, Pin, CapturedRoot, true);
+              Origins.back().ConsumedByClosure = llvm::is_contained(Summary.Consumed, Capture.Variable);
