+                State.SamePins.set(Found->second);
+              }
+            }
+          }
+      } else if (const auto *Assignment = dyn_cast<BinaryOperator>(Node)) {
+        if (Assignment->isAssignmentOp()) {
+          Storage Target = storage(Assignment->getLHS(), &State);
+          Value V = value(Assignment->getRHS(), State);
+          if (isObjC3BorrowedType(Context, Assignment->getLHS()->getType()) &&
+              V.none() && !Assignment->getRHS()->isNullPointerConstant(
+                  Context, Expr::NPC_ValueDependentIsNotNull))
+            V.set(0);
+          if (Assignment->isCompoundAssignmentOp())
+            V |= value(Assignment->getLHS(), State);
+          const bool Unowned = ownerIsUnowned(Assignment->getRHS(), State);
+          Value Owner = ownerIdentity(Assignment->getRHS(), State);
+          Storage Address = referent(Assignment->getRHS(), &State);
+          Value Targets = possibleTargets(Assignment->getRHS(), State);
+          if (Targets.any() && Target.first && Target.first->hasLocalStorage() &&
+              !hasUnknownIndex(Target) &&
+              !isObjC3BorrowedType(Context, Assignment->getLHS()->getType()))
+            V = empty();
+          if (auto Found = Slots.find(Target);
+              Target.first && !Target.second && Target.Index == -1 &&
+              Found != Slots.end()) {
+            unsigned Slot = Found->second;
+            if (Owner.none() || Owner != State.OwnerIdentities[Slot])
+              expire(Target.first, State);
+            if (Owner.none() && OwnerRoots.count(Target.first))
+              Owner.set(OwnerRoots.lookup(nullptr));
+            State.OwnerIdentities[Slot] = Owner;
+            if (Unowned) State.UnownedOwners.set(Slot);
+            else State.UnownedOwners.reset(Slot);
+          }
+          if (auto Found = Slots.find(Target); Found != Slots.end()) {
+            State.LocalTargets[Found->second] = Address;
+            if (hasUnknownIndex(Target))
+              State.MayTargets[Found->second] |= Targets;
+            else
+              State.MayTargets[Found->second] = std::move(Targets);
+          }
+          Value Effects = effects(Assignment->getRHS(), State);
+          if (Targets.any() && !isObjC3BorrowedType(Context, Assignment->getLHS()->getType())) Effects = empty();
+          store(Node, Target, V, State, Emit, false, &Effects);
+          if (Target.first && Slots.count(Target) &&
+              (Assignment->getLHS()->getType()->isRecordType() ||
+               Assignment->getLHS()->getType()->isArrayType()))
+            initializeAggregate(Node, Target, Assignment->getLHS()->getType(),
+                                Assignment->getRHS(), State, Emit);
+        }
+      } else if (const auto *Return = dyn_cast<ReturnStmt>(Node)) {
+        Value V = value(Return->getRetValue(), State);
+        if (Return->getRetValue() &&
+            isObjC3BorrowedType(Context, ReturnType) && V.none() &&
+            !Return->getRetValue()->isNullPointerConstant(
+                Context, Expr::NPC_ValueDependentIsNotNull))
+          V.set(0);
+        if (Emit && V.any() && !validReturn(V))
+          diagnose(Node, "return without a matching borrowed return and owner parameter contract");
+      } else if (const auto *Throw = dyn_cast<ObjC3ThrowStmt>(Node)) {
+        if (Emit && value(Throw->getPayload(), State).any())
+          diagnose(Node, "an exception payload that may outlive its owner");
+      } else if (const auto *Throw = dyn_cast<ObjCAtThrowStmt>(Node)) {
+        if (Emit && value(Throw->getThrowExpr(), State).any())
+          diagnose(Node, "an Objective-C exception payload that may outlive its owner");
+      } else if (const auto *Invocation = dyn_cast<Expr>(Node)) {
+        if (const auto *Throw = dyn_cast<CXXThrowExpr>(Invocation))
+          if (Emit && value(Throw->getSubExpr(), State).any())
+            diagnose(Node, "a C++ exception payload that may outlive its owner");
+        if (isa<BlockExpr, LambdaExpr>(Invocation)) {
+          unsigned Slot = ClosureSlots.lookup(Invocation);
+          State.CaptureReady.reset(Slot);
+          State.CapturedValues[Slot] = value(Invocation, State);
+          State.CapturedEffects[Slot] = effects(Invocation, State);
+          holdClosureOwners(Invocation, State.CapturedValues[Slot], State);
+          State.CaptureReady.set(Slot);
+          State.CapturedReferenceTargets[Slot].reset();
+          if (const auto *Lambda = dyn_cast<LambdaExpr>(Invocation)) {
+            auto Initializer = Lambda->capture_init_begin();
+            for (const auto &Capture : Lambda->captures()) {
+              const Expr *Init = *Initializer++;
+              State.CapturedReferenceTargets[Slot] |= capturedTargets(Init, State);
+              if (Capture.capturesVariable() && Capture.getCaptureKind() == LCK_ByRef)
+                if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+                  if (auto Found = Slots.find({Variable, nullptr}); Found != Slots.end())
+                    State.CapturedReferenceTargets[Slot].set(Found->second);
+            }
+          }
+          if (Emit) {
+            Decl *NestedCallable = nullptr;
+            Stmt *NestedBody = nullptr;
+            const auto *Lambda = dyn_cast<LambdaExpr>(Invocation);
+            if (const auto *Block = dyn_cast<BlockExpr>(Invocation)) {
+              auto *Declaration = const_cast<BlockDecl *>(Block->getBlockDecl());
+              NestedCallable = Declaration;
+              NestedBody = Declaration->getBody();
+              if (auto Summary = OwnerSummaries->find(Block); Summary != OwnerSummaries->end())
+                for (const auto &Capture : Declaration->captures()) {
+                  QualType Type = Capture.getVariable()->getType();
+                  const auto *Record = Type->getAsCXXRecordDecl();
+                  if (Capture.isByRef() && (Type->isBlockPointerType() || (Record && Record->isLambda())) &&
+                      llvm::is_contained(Summary->second.Invoked, Capture.getVariable()))
+                    diagnose(Block, "a byref Block callable capture requiring an explicit invocation lifetime contract");
+                }
+            } else {
+              NestedCallable = Lambda->getCallOperator();
+              NestedBody = Lambda->getBody();
+              auto Initializer = Lambda->capture_init_begin();
+              for (const auto &Capture : Lambda->captures()) {
+                const Expr *Init = *Initializer++;
+                const auto Summary = OwnerSummaries->lookup(Lambda);
+                const auto *Variable = Capture.capturesVariable()
+                    ? dyn_cast<VarDecl>(Capture.getCapturedVar()) : nullptr;
+                QualType Type = Variable ? Variable->getType().getNonReferenceType() : QualType();
+                bool MutableOwnerReference = Variable && Capture.getCaptureKind() == LCK_ByRef &&
+                    llvm::is_contained(Summary.Mutated, Variable) &&
+                    (Type->isPointerType() || Type->isObjCObjectPointerType() ||
+                     Type->isBlockPointerType() ||
+                     (Type->getAsCXXRecordDecl() && Type->getAsCXXRecordDecl()->isLambda()));
+                if ((Capture.getCaptureKind() == LCK_ByRef || capturedTargets(Init, State).any()) &&
+                    (MutableOwnerReference || value(Init, State).any() ||
+                     (Capture.capturesVariable() &&
+                      llvm::is_contained(FutureBorrowCaptures.lookup(Lambda), Capture.getCapturedVar()))))
+                  diagnose(Lambda, "a C++ lambda reference capture requiring an explicit lifetime contract");
+              }
+            }
+            if (UnqualifiedCallablePaths.count(Invocation))
+              diagnose(Invocation, "a captured callable path requiring an explicit invocation lifetime contract");
+            if (UnstableFutureOwners.count(Invocation))
+              diagnose(Invocation, "an owner init-capture requiring an explicit stable lifetime binding");
+            if (NestedCallable && !NestedCallable->isInvalidDecl()) {
+              bool NestedInvalid=false;
+              for(const auto &[Declaration,SpecializedBody]:closureBodies(Invocation)) {
+              BorrowedFlow Nested(Actions, Declaration, SpecializedBody);
+              Nested.OwnerSummaries = OwnerSummaries;
+              Nested.Origins = Origins;
+              Nested.OwnerRoots = OwnerRoots;
+              Nested.Paths = Paths;
+              Nested.FieldPaths = FieldPaths;
+              Nested.ArrayPaths = ArrayPaths;
+              Nested.InheritedReferenceCaptures = InheritedReferenceCaptures;
+              Nested.InheritedLambdaStorage = InheritedLambdaStorage;
+              if (Lambda)
+                for (const auto &Capture : Lambda->captures())
+                  if (Capture.capturesVariable())
+                    if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+                      Nested.InheritedLambdaStorage.insert(Variable);
+              for (const Value &Targets : State.CapturedReferenceTargets)
+                for (int Target = Targets.find_first(); Target >= 0;
+                     Target = Targets.find_next(Target))
+                  if (const VarDecl *Variable = location(Target).first)
+                    Nested.InheritedReferenceCaptures.insert(Variable);
+              // Seed the enclosing storage graph for ordinary aliases and
+              // transitive address captures, before initializing init-captures.
+              for (auto [Location, Index] : Slots) {
+                Nested.InheritedValues[Location] = State.Values[Index];
+                Nested.InheritedEffects[Location] = State.Effects[Index];
+                for (int Target = State.MayTargets[Index].find_first(); Target >= 0;
+                     Target = State.MayTargets[Index].find_next(Target))
+                  Nested.InheritedMayTargets[Location].push_back(location(Target));
+                Nested.InheritedTargets[Location] = State.LocalTargets[Index];
+                if (!Location.second && Location.Index == -1) {
+                  Nested.InheritedOwners[Location.first] = State.OwnerIdentities[Index];
+                  if (State.UnownedOwners.test(Index))
+                    Nested.InheritedUnownedOwners.insert(Location.first);
+                }
+              }
+              if (Lambda) {
+                auto Initializer = Lambda->capture_init_begin();
+                for (const auto &Capture : Lambda->captures()) {
+                  const Expr *Init = *Initializer++;
+                  if (Lambda->isInitCapture(&Capture)) {
+                    const auto *Variable = cast<VarDecl>(Capture.getCapturedVar());
+                    Nested.InheritedValues[{Variable, nullptr}] = value(Init, State);
+                    Nested.InheritedEffects[{Variable, nullptr}] = effects(Init, State);
+                    Nested.InheritedOwners[Variable] = ownerIdentity(Init, State);
+                    if (ownerIsUnowned(Init, State)) Nested.InheritedUnownedOwners.insert(Variable);
+                    Nested.InheritedTargets[{Variable, nullptr}] = referent(Init, &State);
+                    auto Targets = possibleTargets(Init, State);
+                    for (int Target = Targets.find_first(); Target >= 0;
+                         Target = Targets.find_next(Target))
+                      Nested.InheritedMayTargets[{Variable, nullptr}].push_back(location(Target));
+                  }
+                }
+              }
+              NestedInvalid |= Nested.check();
+              }
+              Invalid |= NestedInvalid;
+              if (!NestedInvalid && Lambda &&
+                  (State.CapturedValues[Slot].any() || !FutureBorrowCaptures.lookup(Lambda).empty())) {
+                bool RequiresContract = !qualifiedGenericCapture(Lambda);
+                if (Lambda->isMutable()) {
+                  const auto *Prototype = Lambda->getCallOperator()->getType()->getAs<FunctionProtoType>();
+                  RequiresContract |= isa<CoroutineBodyStmt>(Lambda->getBody()) ||
+                      (Prototype && Prototype->getObjC3FunctionEffects().Async);
+                  const auto Summary = OwnerSummaries->lookup(Lambda);
+                  for (const auto &Capture : closureCaptures(Lambda)) {
+                    Value Payload = Capture.Initializer ? value(Capture.Initializer, State)
+                        : contents({Capture.Variable, nullptr}, Capture.Variable->getType(), State);
+                    QualType CaptureType = Capture.Variable->getType().getNonReferenceType();
+                    const auto *Record = CaptureType->getAsCXXRecordDecl();
+                    RequiresContract |= CaptureType->isRecordType() && (!Record || !Record->isLambda());
+                    bool HoldsPayload = false;
+                    for (const auto &Owned : owningClosureCaptures(Lambda))
+                      if (Owned.Variable == Capture.Variable) {
+                        RequiresContract |= llvm::is_contained(Summary.Consumed, Capture.Variable);
+                        Value Identity = Owned.Initializer ? ownerIdentity(Owned.Initializer, State)
+                            : State.OwnerIdentities[Slots.lookup({Owned.Variable, nullptr})];
+                        const Value &Loans = State.CapturedValues[Slot];
+                        for (int Bit = Loans.find_first(); Bit >= 0; Bit = Loans.find_next(Bit)) {
+                          const Origin &O = Origins[Bit / 2];
+                          HoldsPayload |= O.HeldByClosure == Lambda && O.Identity &&
+                              Identity.test(OwnerRoots.lookup(O.Identity));
+                        }
+                      }
+                    bool Sensitive = HoldsPayload || Payload.any() ||
+                        llvm::is_contained(Summary.Borrowed, Capture.Variable) ||
+                        llvm::is_contained(Summary.Consumed, Capture.Variable) ||
+                        llvm::is_contained(Summary.Invoked, Capture.Variable);
+                    RequiresContract |= Sensitive && llvm::is_contained(Summary.Mutated, Capture.Variable);
+                  }
+                }
+                if (RequiresContract)
+                  diagnose(Lambda, "a mutable or generic C++ lambda capture requiring additional lifetime contracts");
+              }
+            }
+          }
+        }
+        if (const auto *BlockExpression = dyn_cast<BlockExpr>(Invocation))
+          for (const auto &Capture : BlockExpression->getBlockDecl()->captures())
+            if (Capture.getObjC3CaptureKind() == BlockDecl::ObjC3CaptureKind::Move) {
+              const VarDecl *Source = Capture.getVariable();
+              expire(Source, State);
+              for (auto [Location, Index] : Slots)
+                if (Location.first == Source) {
+                  State.Values[Index] = empty();
+                  State.Effects[Index] = empty();
+                  State.LocalTargets[Index] = {};
+                  State.MayTargets[Index].reset();
+                }
+            }
+        if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(Invocation))
+          if (modeledRecordCopy(Operator->getDirectCallee()) && Operator->getNumArgs() == 2)
+            initializeAggregate(Invocation, storage(Operator->getArg(0), &State),
+                                Operator->getArg(0)->getType(), Operator->getArg(1),
+                                State, Emit);
+        if (Emit)
+          if (const auto *Allocation = dyn_cast<CXXNewExpr>(Invocation))
+            if (value(Allocation->getInitializer(), State).any())
+              diagnose(Invocation, "dynamically allocated aggregate storage");
+        if (isa<CallExpr, ObjCMessageExpr, CXXConstructExpr>(Invocation)) {
+          checkCall(Invocation, State, Emit);
+          observeCallbackWriteback(Invocation, State);
+        }
+        if (Emit)
+          if (const auto *Pseudo = dyn_cast<PseudoObjectExpr>(Invocation)) {
+            ObjC3KeyPathApplicationInfo Application;
+            if (getObjC3KeyPathApplication(Pseudo, Application))
+              for (unsigned I = 1; I != Application.Syntax->getNumArgs(); ++I)
+                if (value(Application.Syntax->getArg(I), State).any())
+                  diagnose(Application.Syntax->getArg(I),
+                           I == 2 ? "key-path value storage without a borrowed lifetime contract"
+                                  : "a retained key-path root without a borrowed lifetime contract");
+          }
+        // Dereferencing reads data without making that data borrowed. Its
+        // pointer operand must nevertheless still have a live owner.
+        if (Emit) {
+          const Expr *Pointer = nullptr;
+          if (const auto *Unary = dyn_cast<UnaryOperator>(Invocation))
+            if (Unary->getOpcode() == UO_Deref)
+              Pointer = Unary->getSubExpr();
+          if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(Invocation))
+            Pointer = Subscript->getBase();
+          if (const auto *Member = dyn_cast<MemberExpr>(Invocation))
+            if (Member->isArrow())
+              Pointer = Member->getBase();
+          if (Pointer && hasExpired(value(Pointer, State)))
+            diagnose(Node, "access after its owner lifetime ended");
+        }
+      }
+    }
+  }
+  void refineNull(const Expr *Condition, bool Truth, Facts &State) const {
+    if (!Condition)
+      return;
+    Condition = Condition->IgnoreParenImpCasts();
+    if (const auto *Not = dyn_cast<UnaryOperator>(Condition)) {
+      if (Not->getOpcode() == UO_LNot) {
+        refineNull(Not->getSubExpr(), !Truth, State);
+        return;
+      }
+    }
+    const Expr *Candidate = Condition;
+    bool IsNull = !Truth;
+    if (const auto *Comparison = dyn_cast<BinaryOperator>(Condition)) {
+      if (Comparison->getOpcode() != BO_EQ && Comparison->getOpcode() != BO_NE)
+        return;
+      if (Comparison->getRHS()->isNullPointerConstant(
+              Context, Expr::NPC_ValueDependentIsNotNull))
+        Candidate = Comparison->getLHS();
+      else if (Comparison->getLHS()->isNullPointerConstant(
+                   Context, Expr::NPC_ValueDependentIsNotNull))
+        Candidate = Comparison->getRHS();
+      else
+        return;
+      IsNull = (Comparison->getOpcode() == BO_EQ) == Truth;
+    }
+    if (!IsNull)
+      return;
+    auto Found = Slots.find(storage(Candidate, &State));
+    if (Found != Slots.end()) {
+      State.Values[Found->second] = empty();
+      State.Effects[Found->second] = empty();
+      State.LocalTargets[Found->second] = {};
+      State.MayTargets[Found->second].reset();
+    }
+  }
+  bool join(Facts &Destination, const Facts &Source) const {
+    if (!Destination.Reachable) {
+      Destination = Source;
+      return true;
+    }
+    bool Changed = false;
+    Value Unowned = Destination.UnownedOwners;
+    Unowned |= Source.UnownedOwners;
+    Changed |= Unowned != Destination.UnownedOwners;
+    Destination.UnownedOwners = std::move(Unowned);
+    for (unsigned I = 0; I != Destination.Values.size(); ++I) {
+      Value Effects = Destination.Effects[I]; Effects |= Source.Effects[I];
+      Changed |= Effects != Destination.Effects[I]; Destination.Effects[I] = std::move(Effects);
+      Value V = Destination.Values[I];
+      V |= Source.Values[I];
+      Changed |= V != Destination.Values[I];
+      Destination.Values[I] = std::move(V);
+      Value Owners = Destination.OwnerIdentities[I];
+      Owners |= Source.OwnerIdentities[I];
+      Changed |= Owners != Destination.OwnerIdentities[I];
+      Destination.OwnerIdentities[I] = std::move(Owners);
+      Value Targets = Destination.MayTargets[I];
+      Targets |= Source.MayTargets[I];
+      Changed |= Targets != Destination.MayTargets[I];
+      Destination.MayTargets[I] = std::move(Targets);
+      if (!(Destination.LocalTargets[I] == Source.LocalTargets[I]) &&
+          Destination.LocalTargets[I].first) {
+        Destination.LocalTargets[I] = {};
+        Changed = true;
+      }
+    }
+    for (unsigned I = 0; I != Destination.CapturedValues.size(); ++I) {
+      Value Effects = Destination.CapturedEffects[I]; Effects |= Source.CapturedEffects[I];
+      Changed |= Effects != Destination.CapturedEffects[I]; Destination.CapturedEffects[I] = std::move(Effects);
+      Value Capture = Destination.CapturedValues[I];
+      Capture |= Source.CapturedValues[I];
+      Changed |= Capture != Destination.CapturedValues[I];
+      Destination.CapturedValues[I] = std::move(Capture);
+      Value Targets = Destination.CapturedReferenceTargets[I];
+      Targets |= Source.CapturedReferenceTargets[I];
+      Changed |= Targets != Destination.CapturedReferenceTargets[I];
+      Destination.CapturedReferenceTargets[I] = std::move(Targets);
+    }
+    for (unsigned I = 0; I != Destination.EvaluatedValues.size(); ++I) {
+      Value Effects = Destination.EvaluatedEffects[I]; Effects |= Source.EvaluatedEffects[I];
+      Changed |= Effects != Destination.EvaluatedEffects[I]; Destination.EvaluatedEffects[I] = std::move(Effects);
+      Value Evaluated = Destination.EvaluatedValues[I];
+      Evaluated |= Source.EvaluatedValues[I];
+      Changed |= Evaluated != Destination.EvaluatedValues[I];
+      Destination.EvaluatedValues[I] = std::move(Evaluated);
+      Value Acquisition = Destination.EvaluatedAcquisitions[I];
+      Acquisition |= Source.EvaluatedAcquisitions[I];
+      Changed |= Acquisition != Destination.EvaluatedAcquisitions[I];
+      Destination.EvaluatedAcquisitions[I] = std::move(Acquisition);
+      Value Owners = Destination.EvaluatedOwners[I];
+      Owners |= Source.EvaluatedOwners[I];
+      Changed |= Owners != Destination.EvaluatedOwners[I];
+      Destination.EvaluatedOwners[I] = std::move(Owners);
+      Value Targets = Destination.EvaluatedMayTargets[I];
+      Targets |= Source.EvaluatedMayTargets[I];
+      Changed |= Targets != Destination.EvaluatedMayTargets[I];
+      Destination.EvaluatedMayTargets[I] = std::move(Targets);
+      if (!(Destination.EvaluatedTargets[I] == Source.EvaluatedTargets[I]) &&
+          Destination.EvaluatedTargets[I].first) {
+        Destination.EvaluatedTargets[I] = {};
+        Changed = true;
+      }
+    }
+    Value AcquisitionReady = Destination.AcquisitionReady;
+    AcquisitionReady &= Source.AcquisitionReady;
+    Changed |= AcquisitionReady != Destination.AcquisitionReady;
+    Destination.AcquisitionReady = std::move(AcquisitionReady);
+    Value EvaluatedReady = Destination.EvaluatedReady;
+    EvaluatedReady &= Source.EvaluatedReady;
+    Changed |= EvaluatedReady != Destination.EvaluatedReady;
+    Destination.EvaluatedReady = std::move(EvaluatedReady);
+    Value Ready = Destination.CaptureReady;
+    Ready &= Source.CaptureReady;
+    Changed |= Ready != Destination.CaptureReady;
+    Destination.CaptureReady = std::move(Ready);
+    // A snapshot can be used as proof only when active and unchanged on every
+    // incoming path. A branch that bypasses keepAlive cannot lend its owner.
+    Value Active = Destination.ActivePins;
+    Active &= Source.ActivePins;
+    Value Same = Destination.SamePins;
+    Same &= Source.SamePins;
+    Changed |= Active != Destination.ActivePins || Same != Destination.SamePins;
+    Destination.ActivePins = std::move(Active);
+    Destination.SamePins = std::move(Same);
+    return Changed;
+  }
+public:
+  BorrowedFlow(Sema &S, Decl *Callable, Stmt *Body)
+      : Actions(S), Context(S.Context), Callable(Callable), Body(Body) {
+    if (auto *Function = dyn_cast_or_null<FunctionDecl>(Callable)) {
+      Parameters.append(Function->param_begin(), Function->param_end());
+      ReturnType = Function->getReturnType();
+    } else if (auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Callable)) {
+      Parameters.append(Method->param_begin(), Method->param_end());
+      ReturnType = Method->getReturnType();
+    } else if (auto *Block = dyn_cast_or_null<BlockDecl>(Callable)) {
+      Parameters.append(Block->param_begin(), Block->param_end());
+      if (const TypeSourceInfo *Signature = Block->getSignatureAsWritten())
+        if (const auto *Prototype = Signature->getType()->getAs<FunctionProtoType>())
+          ReturnType = Prototype->getReturnType();
+    }
+    ReturnContract = getObjC3BorrowedReturnContract(Callable);
+  }
+  bool check() {
+    // Unknown provenance still carries the nonescape obligation. It may be
+    // kept locally and consumed synchronously but cannot justify a return.
+    if (Origins.empty())
+      addOrigin(nullptr, nullptr);
+    if (OwnerRoots.empty())
+      OwnerRoots[nullptr] = 0;
+    for (const auto &[Location, V] : InheritedValues) {
+      (void)V;
+      addVariable(Location.first);
+      addStorage(Location);
+    }
+    for (ParmVarDecl *Parameter : Parameters) {
+      addVariable(Parameter);
+    }
+    collectBindings(Body);
+    if (const auto *Constructor = dyn_cast_or_null<CXXConstructorDecl>(Callable))
+      for (const CXXCtorInitializer *Initializer : Constructor->inits())
+        collectBindings(Initializer->getInit());
+    collect(Body, Body);
+    if (const auto *Constructor = dyn_cast_or_null<CXXConstructorDecl>(Callable))
+      for (const CXXCtorInitializer *Initializer : Constructor->inits())
+        collect(Initializer->getInit(), Body);
+    for (const auto &[Location, V] : InheritedValues) {
+      (void)Location;
+      MightBorrow |= V.any();
+    }
+    if (!MightBorrow && !IsOwnerSummary && Origins.size() == 1)
+      return false;
+    prepareSymbolicCallableInputs();
+    prepareFutureOwnerLoans();
+    prepareClosureLoans();
+    CFG::BuildOptions Options;
+    Options.setAllAlwaysAdd();
+    Options.AddLifetime = true;
+    Options.AddEHEdges = true;
+    Options.AddInitializers = true;
+    Options.AddImplicitDtors = true;
+    std::unique_ptr<CFG> Graph = CFG::buildCFG(Callable, Body, &Context, Options);
+    if (!Graph) {
+      // A translation unit without borrowing does not need a borrowed CFG.
+      bool PromisedParameter = llvm::any_of(Parameters, [&](const ParmVarDecl *P) {
+        return P->hasAttr<NoEscapeAttr>() ||
+               carriesBorrowedValue(P->getType());
+      });
+      if (Origins.size() > 1 || PromisedParameter ||
+          llvm::any_of(InheritedValues, [](const auto &Entry) { return Entry.second.any(); }))
+        diagnose(Body, "control flow whose borrowed owner lifetime cannot be proved");
+      return Invalid;
+    }
+    Facts Initial;
+    Initial.Reachable = true;
+    Initial.Values.assign(Slots.size(), empty());
+    Initial.Effects.assign(Slots.size(), empty());
+    Initial.OwnerIdentities.assign(Slots.size(), Value(OwnerRoots.size()));
+    Initial.UnownedOwners.resize(Slots.size());
+    for (const VarDecl *Owner : InheritedUnownedOwners)
+      if (auto Slot = Slots.find({Owner, nullptr}); Slot != Slots.end())
+        Initial.UnownedOwners.set(Slot->second);
+    Initial.LocalTargets.resize(Slots.size());
+    Initial.MayTargets.assign(Slots.size(), Value(Slots.size()));
+    Initial.CapturedValues.assign(ClosureSlots.size(), empty());
+    Initial.CapturedEffects.assign(ClosureSlots.size(), empty());
+    Initial.CapturedReferenceTargets.assign(ClosureSlots.size(), Value(Slots.size()));
+    Initial.CaptureReady.resize(ClosureSlots.size());
+    Initial.EvaluatedValues.assign(ExpressionSlots.size(), empty());
+    Initial.EvaluatedEffects.assign(ExpressionSlots.size(), empty());
+    Initial.EvaluatedOwners.assign(ExpressionSlots.size(), Value(OwnerRoots.size()));
+    Initial.EvaluatedAcquisitions.assign(ExpressionSlots.size(), empty());
+    Initial.AcquisitionReady.resize(ExpressionSlots.size());
+    Initial.EvaluatedTargets.resize(ExpressionSlots.size());
+    Initial.EvaluatedMayTargets.assign(ExpressionSlots.size(), Value(Slots.size()));
+    Initial.EvaluatedReady.resize(ExpressionSlots.size());
+    for (auto [Owner, Index] : OwnerRoots)
+      if (auto Found = Slots.find({Owner, nullptr});
+          Owner && Found != Slots.end() &&
+          (isa<ParmVarDecl, ImplicitParamDecl>(Owner) || !Owner->hasLocalStorage()))
+        Initial.OwnerIdentities[Found->second].set(Index);
+    for (const auto &[Location, V] : InheritedValues) {
+      Value Capture = V;
+      Capture.resize(Origins.size() * 2);
+      Initial.Values[Slots.lookup(Location)] = std::move(Capture);
+    }
+    for (const auto &[Location, V] : InheritedEffects) {
+      Value Effect = V; Effect.resize(Origins.size() * 2);
+      Initial.Effects[Slots.lookup(Location)] = std::move(Effect);
+    }
+    for (const auto &[Location, Target] : InheritedTargets) {
+      Initial.LocalTargets[Slots.lookup(Location)] = Target;
+      if (auto Found = Slots.find(Target); Found != Slots.end())
+        Initial.MayTargets[Slots.lookup(Location)].set(Found->second);
+    }
+    for (const auto &[Location, Targets] : InheritedMayTargets)
+      for (Storage Target : Targets)
+        if (auto Found = Slots.find(Target); Found != Slots.end())
+          Initial.MayTargets[Slots.lookup(Location)].set(Found->second);
+    for (const auto &[Variable, V] : InheritedOwners) {
+      Value Identity = V;
+      Identity.resize(OwnerRoots.size());
+      Initial.OwnerIdentities[Slots.lookup({Variable, nullptr})] = std::move(Identity);
+    }
+    Initial.ActivePins.resize(Pins.size());
+    Initial.SamePins.resize(Pins.size());
+    for (auto [Location, Index] : Slots) {
+      if (!Location.first)
+        continue;
+      if (!Location.first->hasLocalStorage() && !Location.second &&
+          Location.Index == -1 &&
+          carriesBorrowedValue(Location.first->getType()))
+        Initial.Values[Index].set(0);
+      if (isa<ParmVarDecl>(Location.first) && Location.second &&
+          carriesBorrowedValue(Location.second->getType()))
+        Initial.Values[Index].set(0);
+    }
+    for (ParmVarDecl *Parameter : Parameters)
+      if ((carriesBorrowedValue(Parameter->getType()) &&
+           !Parameter->getType()->isRecordType()) ||
+          Parameter->hasAttr<NoEscapeAttr>()) {
+        Value V = empty();
+        // Borrowed parameters have no owner-return identity unless an explicit
+        // call relationship establishes it within this callable.
+        V.set(0);
+        Initial.Values[Slots.lookup({Parameter, nullptr})] = std::move(V);
+      }
+    std::vector<Facts> Inputs(Graph->getNumBlockIDs());
+    const CFGBlock *Entry = &Graph->getEntry();
+    Inputs[Entry->getBlockID()] = std::move(Initial);
+    SmallVector<const CFGBlock *, 16> Work{Entry};
+    while (!Work.empty()) {
+      const CFGBlock *Block = Work.pop_back_val();
+      Facts Output = Inputs[Block->getBlockID()];
+      transfer(*Block, Output, false);
+      unsigned EdgeIndex = 0;
+      for (auto Successor : Block->succs()) {
+        unsigned Index = EdgeIndex++;
+        if (const CFGBlock *Next = Successor.getReachableBlock()) {
+          Facts Edge = Output;
+          if (Block->succ_size() == 2) {
+            const Expr *Condition = Block->getLastCondition();
+            if (!Condition)
+              Condition = dyn_cast_or_null<Expr>(Block->getTerminatorCondition());
+            refineNull(Condition, Index == 0, Edge);
+          }
+          if (join(Inputs[Next->getBlockID()], Edge))
+            Work.push_back(Next);
+        }
+      }
+    }
+    // Diagnose from converged entry facts, never from a transient worklist
+    // iteration. A later assignment can kill an old borrow on every path.
+    for (const CFGBlock *Block : *Graph)
+      if (Inputs[Block->getBlockID()].Reachable) {
+        Facts State = Inputs[Block->getBlockID()];
+        transfer(*Block, State, !IsOwnerSummary);
+      }
+    return Invalid;
+  }
+};
+} // namespace
+
+bool clang::checkObjC3CallableOwnershipCast(Sema &S, const Expr *Source,
+                                           QualType Destination,
+                                           SourceLocation Location) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile != 3 || !Source ||
+      Source->isTypeDependent() || Destination->isDependentType() ||
+      Destination->isVoidType() || Destination->isBooleanType() ||
+      Source->isNullPointerConstant(S.Context, Expr::NPC_ValueDependentIsNotNull))
+    return false;
+  auto Function = [&](QualType Type) -> const FunctionType * {
+    for (;;) {
+      if (const auto *F = Type->getAs<FunctionType>()) return F;
+      if (const auto *P = Type->getAs<PointerType>()) Type = P->getPointeeType();
+      else if (const auto *P = Type->getAs<MemberPointerType>()) Type = P->getPointeeType();
+      else if (const auto *R = Type->getAs<ReferenceType>()) Type = R->getPointeeType();
+      else if (const auto *A = S.Context.getAsArrayType(Type)) Type = A->getElementType();
+      else return nullptr;
+    }
+    return nullptr;
+  };
+  const auto *From = Function(Source->getType());
+  const auto *To = Function(Destination);
+  // A callback can itself accept or return callbacks. Preserve those nested
+  // contracts invariantly: a permission safe to drop on the cast's callable
+  // may be an obligation when that callable receives another callback.
+  auto HasContract = [&](auto &&Self, const FunctionType *F,
+                         bool Permissions) -> bool {
+    if (!F) return false;
+    if (F->getExtInfo().getProducesResult() ||
+        containsObjC3BorrowedType(S.Context, F->getReturnType()) ||
+        Self(Self, Function(F->getReturnType()), true)) return true;
+    if (const auto *P = dyn_cast<FunctionProtoType>(F))
+      for (unsigned I = 0; I != P->getNumParams(); ++I)
+        if (P->isParamConsumed(I) || P->getExtParameterInfo(I).isCFConsumed() ||
+            Self(Self, Function(P->getParamType(I)), true) ||
+            (Permissions && (P->getExtParameterInfo(I).isNoEscape() ||
+              isObjC3BorrowedType(S.Context, P->getParamType(I).getNonReferenceType()))))
+          return true;
+    return false;
+  };
+  auto ChangesContract = [&](auto &&Self, const FunctionType *A,
+                             const FunctionType *B, bool Nested) -> bool {
+    if (!A || !B)
+      return HasContract(HasContract, A ? A : B, Nested || !A);
+    const bool BorrowedA = containsObjC3BorrowedType(S.Context, A->getReturnType());
+    const bool BorrowedB = containsObjC3BorrowedType(S.Context, B->getReturnType());
+    if (A->getExtInfo().getProducesResult() != B->getExtInfo().getProducesResult() ||
+        (Nested ? BorrowedA != BorrowedB : BorrowedA && !BorrowedB) ||
+        Self(Self, Function(A->getReturnType()), Function(B->getReturnType()), true))
+      return true;
+    const auto *PA = dyn_cast<FunctionProtoType>(A);
+    const auto *PB = dyn_cast<FunctionProtoType>(B);
+    const unsigned Count = std::max(PA ? PA->getNumParams() : 0,
+                                    PB ? PB->getNumParams() : 0);
+    for (unsigned I = 0; I != Count; ++I) {
+      const bool HasA = PA && I < PA->getNumParams();
+      const bool HasB = PB && I < PB->getNumParams();
+      const bool ConsumedA = HasA && PA->isParamConsumed(I);
+      const bool ConsumedB = HasB && PB->isParamConsumed(I);
+      const bool NoEscapeA = HasA && (PA->getExtParameterInfo(I).isNoEscape() ||
+          isObjC3BorrowedType(S.Context, PA->getParamType(I).getNonReferenceType()));
+      const bool NoEscapeB = HasB && (PB->getExtParameterInfo(I).isNoEscape() ||
+          isObjC3BorrowedType(S.Context, PB->getParamType(I).getNonReferenceType()));
+      const bool ForeignA = HasA && PA->getExtParameterInfo(I).isCFConsumed();
+      const bool ForeignB = HasB && PB->getExtParameterInfo(I).isCFConsumed();
+      if (ConsumedA != ConsumedB || ForeignA != ForeignB ||
+          (Nested ? NoEscapeA != NoEscapeB : NoEscapeB && !NoEscapeA) ||
+          Self(Self, HasA ? Function(PA->getParamType(I)) : nullptr,
+                     HasB ? Function(PB->getParamType(I)) : nullptr, true))
+        return true;
+    }
+    return false;
+  };
+  const bool Invalid = ChangesContract(ChangesContract, From, To, false);
+  if (Invalid)
+    S.Diag(Location, S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+        "callable cast changes an ownership or borrowed lifetime contract; preserve the declared callable type"));
+  return Invalid;
+}
+
+bool clang::checkObjC3BorrowedFlow(Sema &S, Decl *Callable, Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile != 3 || !Body ||
+      (Callable && Callable->isInvalidDecl()))
+    return false;
+  return BorrowedFlow(S, Callable, Body).check();
+}
+
+bool clang::checkObjC3BorrowedGlobalInitializer(Sema &S, VarDecl *Variable) {
+  if (!S.getLangOpts().ObjC3 || S.getLangOpts().ObjC3Profile != 3 ||
+      !Variable || Variable->isInvalidDecl() || !Variable->hasInit() ||
+      !(Variable->isFileVarDecl() || Variable->isStaticDataMember()) ||
+      Variable->getType()->isDependentType() ||
+      Variable->getInit()->isTypeDependent() ||
+      Variable->getInit()->isValueDependent() ||
+      Variable->getDeclContext()->isDependentContext())
+    return false;
+  // Dynamic namespace/static-member initializers are ordinary semantic work
+  // in Objective-C++. They must obey the same required escape rule as a store
+  // in a callable body. This declaration wrapper is analysis-only.
+  auto *Declaration = new (S.Context) DeclStmt(
+      DeclGroupRef(Variable), Variable->getBeginLoc(), Variable->getEndLoc());
+  return BorrowedFlow(S, nullptr, Declaration).check();
+}
