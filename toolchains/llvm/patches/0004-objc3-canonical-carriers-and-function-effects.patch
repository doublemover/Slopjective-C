diff --git a/clang/test/ObjC3/AST/function-effect-type-adjustment.c b/clang/test/ObjC3/AST/function-effect-type-adjustment.c
new file mode 100644
index 000000000..affa17a3c
--- /dev/null
+++ b/clang/test/ObjC3/AST/function-effect-type-adjustment.c
@@ -0,0 +1,32 @@
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -std=c17 -fsyntax-only -ast-dump %s | FileCheck %s
+
+typedef struct Error { int value; } Error;
+typedef void NoPrototype();
+typedef void ThrowingPrototype(void) __objc3_throws(Error);
+typedef ThrowingPrototype *ThrowingPointer;
+typedef NoPrototype *NoPrototypePointer;
+
+// Parameter adjustment must retain function effects through function decay and
+// nested pointer declarations.
+void parameter_decay(ThrowingPrototype callback);
+void nested_parameter(ThrowingPointer *callback);
+
+NoPrototype *no_prototype;
+NoPrototypePointer *nested_no_prototype;
+ThrowingPrototype *throwing_prototype;
+ThrowingPointer *nested_throwing;
+
+void composite_types(int choose) {
+  ThrowingPrototype *forward = choose ? no_prototype : throwing_prototype;
+  ThrowingPrototype *reverse = choose ? throwing_prototype : no_prototype;
+  ThrowingPointer *nested = choose ? nested_no_prototype : nested_throwing;
+  (void)forward;
+  (void)reverse;
+  (void)nested;
+}
+
+// CHECK: ParmVarDecl {{.*}} callback 'ThrowingPrototype *'
+// CHECK: ParmVarDecl {{.*}} callback 'ThrowingPointer *'
+// CHECK: ConditionalOperator {{.*}} 'ThrowingPrototype *'
+// CHECK: ConditionalOperator {{.*}} 'ThrowingPrototype *'
+// CHECK: ConditionalOperator {{.*}} 'ThrowingPointer *'
