+}
+struct Record { int number; };
+Record record() __objc3_async __objc3_throws(id<First>) {
+  return {};
+}
+
+int plain() __objc3_async;
+int native_handler() __objc3_async {
+  (void)__objc3_await plain();
+  try { throw 1; }
+  catch (int) {
