+    return StmtError();
+  ExprResult Scrutinee = ParseExpression();
+  if (Scrutinee.isUsable())
+    Scrutinee = Actions.CheckPlaceholderExpr(Scrutinee.get());
+  if (Scrutinee.isInvalid() || Parens.consumeClose())
+    return StmtError();
+  if (Tok.isNot(tok::l_brace)) {
+    Diag(Tok, diag::err_expected) << tok::l_brace;
+    return StmtError();
+  }
+  SourceLocation LBraceLoc = ConsumeAnyToken();
+  llvm::SmallVector<ObjC3MatchArm *, 8> Arms;
+  while (Tok.isNot(tok::r_brace) && Tok.isNot(tok::eof)) {
+    bool IsDefault = Tok.is(tok::kw_default);
+    if (!IsDefault && Tok.isNot(tok::kw_case)) {
+      Diag(Tok, diag::err_expected) << tok::kw_case;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation CaseLoc = Tok.getLocation();
+    ConsumeAnyToken();
+    ParseScope CaseScope(this, Scope::DeclScope | Scope::CompoundStmtScope);
+    objc3::MatchPatternInfo Pattern;
+    Pattern.Kind = IsDefault ? objc3::MatchPatternKind::Default
+                             : objc3::MatchPatternKind::Wildcard;
+    Pattern.Location = Tok.getLocation();
+    if (!IsDefault && !ParseObjC3MatchPattern(Pattern)) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    objc3::MatchCaseState State = Actions.ActOnObjC3MatchBeginCase(
+        getCurScope(), Scrutinee.get(), Pattern, /*ExpressionForm=*/false);
+    if (!State.IsValid) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    ExprResult Guard;
+    SourceLocation GuardLoc;
+    if (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+        Tok.getIdentifierInfo()->isStr("where")) {
+      GuardLoc = ConsumeAnyToken();
+      if (Tok.is(tok::colon) || Tok.is(tok::r_brace)) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+      Guard = ParseAssignmentExpression();
+      if (Guard.isInvalid()) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+    }
+    if (Tok.isNot(tok::colon)) {
+      Diag(Tok, diag::err_objc3_match_form_delimiter) << "statement";
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation ColonLoc = ConsumeAnyToken();
+    if (Tok.isNot(tok::l_brace)) {
+      Diag(Tok, diag::err_expected) << tok::l_brace;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    StmtResult Body = ParseCompoundStatement();
+    if (Body.isInvalid())
+      continue;
+    if (ObjC3MatchArm *Arm = Actions.ActOnObjC3MatchFinishCase(
+            State, Guard.get(), Body.get(), CaseLoc, Pattern.Location, GuardLoc,
+            ColonLoc))
+      Arms.push_back(Arm);
+  }
+  if (Tok.isNot(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::r_brace;
+    return StmtError();
+  }
+  SourceLocation RBraceLoc = ConsumeAnyToken();
+  return Actions.ActOnObjC3MatchStmt(
+      Scrutinee.get(), Arms, KeywordLoc, Parens.getOpenLocation(),
+      Parens.getCloseLocation(), LBraceLoc, RBraceLoc);
+}
diff --git a/clang/lib/Parse/ParseObjC3QualifiedName.cpp b/clang/lib/Parse/ParseObjC3QualifiedName.cpp
new file mode 100644
index 000000000..84cca4e57
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3QualifiedName.cpp
@@ -0,0 +1,121 @@
+//===--- ParseObjC3QualifiedName.cpp - ObjC3 qualified names -------------===//
+//
+// Staged Clang extension source. This file is added to clangParse's CMake
+// source list after Parser.h and the shared insertion hooks are merged.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/Basic/DiagnosticParse.h"
+
+#include "clang/Basic/TokenKinds.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/SmallVector.h"
+
+using namespace clang;
+
+namespace {
+struct QualifiedNameTokens {
+  SmallVector<IdentifierInfo *, 8> Components;
+  SmallVector<SourceLocation, 8> Locations;
+  SmallVector<SourceLocation, 8> Dots;
+};
+
+QualifiedNameTokens collectQualifiedName(Parser &P, const Token &Start) {
+  QualifiedNameTokens Result;
+  if (!Start.is(tok::identifier) || !Start.getIdentifierInfo())
+    return Result;
+
+  Result.Components.push_back(Start.getIdentifierInfo());
+  Result.Locations.push_back(Start.getLocation());
+  unsigned Offset = 1;
+  while (P.GetLookAheadToken(Offset).is(tok::period) &&
+         P.GetLookAheadToken(Offset + 1).is(tok::identifier) &&
+         P.GetLookAheadToken(Offset + 1).getIdentifierInfo()) {
+    Result.Dots.push_back(P.GetLookAheadToken(Offset).getLocation());
+    Result.Components.push_back(
+        P.GetLookAheadToken(Offset + 1).getIdentifierInfo());
+    Result.Locations.push_back(P.GetLookAheadToken(Offset + 1).getLocation());
+    Offset += 2;
+  }
+  return Result;
+}
+
+} // namespace
+
+bool Parser::isObjC3QualifiedNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::identifier) ||
+      !Tok.getIdentifierInfo())
+    return false;
+  return NextToken().is(tok::period) &&
+         GetLookAheadToken(2).is(tok::identifier);
+}
+
+bool Parser::isObjC3QualifiedTypeNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::at) ||
+      !GetLookAheadToken(1).is(tok::identifier) ||
+      !GetLookAheadToken(2).is(tok::period) ||
+      !GetLookAheadToken(3).is(tok::identifier))
+    return false;
+
+  SmallVector<IdentifierInfo *, 8> Components;
+  unsigned Offset = 1;
+  Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+  Offset += 2;
+  while (GetLookAheadToken(Offset - 1).is(tok::period) &&
+         GetLookAheadToken(Offset).is(tok::identifier)) {
+    Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+    Offset += 2;
+  }
+  return Actions.IsObjC3QualifiedTypeName(Components);
+}
+
+ExprResult Parser::ParseObjC3QualifiedNameExpression(SourceLocation AtLoc) {
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2)
+    return ExprError(Diag(AtLoc, diag::err_unexpected_at));
+
+  unsigned ConsumedComponents = Name.Components.size();
+  ExprResult Result = Actions.ActOnObjC3QualifiedNameExpr(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return ParsePostfixExpressionSuffix(Result);
+}
+
+TypeResult Parser::ParseObjC3QualifiedTypeName(SourceLocation &EndLoc) {
+  assert(getLangOpts().ObjC3 && Tok.is(tok::at));
+  SourceLocation AtLoc = ConsumeToken();
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2) {
+    EndLoc = AtLoc;
+    return TypeError();
+  }
+
+  unsigned ConsumedComponents = Name.Components.size();
+  TypeResult Result = Actions.ActOnObjC3QualifiedTypeName(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  EndLoc = Name.Locations[ConsumedComponents - 1];
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return Result;
+}
diff --git a/clang/lib/Parse/ParseObjC3Type.cpp b/clang/lib/Parse/ParseObjC3Type.cpp
new file mode 100644
index 000000000..cba165426
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3Type.cpp
@@ -0,0 +1,78 @@
+//===--- ParseObjC3Type.cpp - ObjC3 carrier type parser ------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Basic/ObjC3Syntax.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+/// Parse one of the reserved ObjC3 value-carrier type constructors.
+///
+/// The individual payloads are complete Clang type-names. In particular, do
+/// not replace ParseTypeName with a specifier-only parse: pointer, function,
+/// array, and nested carrier declarators belong to the payload's native type.
+/// The Sema action constructs the canonical QualType and the custom TypeLoc
+/// nodes while retaining the ParsedType's child TypeSourceInfo.
+TypeResult Parser::ParseObjC3TypeConstructor(SourceLocation &EndLoc) {
+  if (Tok.getIdentifierInfo()->isStr("KeyPath") ||
+      Tok.getIdentifierInfo()->isStr("WritableKeyPath"))
+    return ParseObjC3KeyPathType(EndLoc);
+  EndLoc = SourceLocation();
+  assert(getLangOpts().ObjC3 && Tok.is(tok::identifier) &&
+         Tok.getIdentifierInfo() &&
+         isObjC3TypeSyntax(Tok.getIdentifierInfo()->getName(),
+                           NextToken().is(tok::l_paren)) &&
+         "Not an ObjC3 carrier type constructor!");
+
+  const bool IsOptional =
+      classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+      ObjC3Syntax::OptionalType;
+  const char *Name = Tok.getIdentifierInfo()->getNameStart();
+  SourceLocation KeywordLoc = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name,
+                              tok::r_paren))
+    return TypeError();
+
+  TypeResult FirstType = ParseTypeName();
+  if (FirstType.isInvalid()) {
+    Parens.skipToEnd();
+    return TypeError();
+  }
+
+  if (IsOptional) {
+    if (Parens.consumeClose())
+      return TypeError();
+    EndLoc = Parens.getCloseLocation();
+    return Actions.ActOnObjC3OptionalType(KeywordLoc, Parens.getOpenLocation(),
+                                          FirstType.get(),
+                                          Parens.getCloseLocation());
+  }
+
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd();
+    return TypeError();
+  }
+
+  SourceLocation CommaLoc = ConsumeToken();
+  TypeResult SecondType = ParseTypeName();
+  if (SecondType.isInvalid()) {
+    Parens.skipToEnd();
+    return TypeError();
+  }
+
+  if (Parens.consumeClose())
+    return TypeError();
+  EndLoc = Parens.getCloseLocation();
+  return Actions.ActOnObjC3ResultType(
+      KeywordLoc, Parens.getOpenLocation(), FirstType.get(), CommaLoc,
+      SecondType.get(), Parens.getCloseLocation());
+}
