+
+typedef void Plain(void);
+typedef void ThrowsError(void) __objc3_throws(Error);
+typedef void ThrowsAlias(void) __objc3_throws(ErrorAlias);
+typedef void ThrowsOther(void) __objc3_throws(Other);
+typedef void Untyped(void) __objc3_throws;
+typedef void Async(void) __objc3_async;
+
+void allowed_conversions(Plain *plain, ThrowsError *typed) {
+  ThrowsError *to_typed = plain;
+  Untyped *to_untyped = plain;
+  ThrowsAlias *same_canonical_payload = typed;
+  (void)to_typed;
+  (void)to_untyped;
+  (void)same_canonical_payload;
+}
+
+void rejected_conversions(ThrowsError *typed, ThrowsOther *other,
+                          Untyped *untyped, Async *async_fn, Plain *plain) {
+  Plain *drop_typed = typed; // expected-error {{cannot initialize a variable of type}}
+  ThrowsOther *change_payload = typed; // expected-error {{cannot initialize a variable of type}}
+  Untyped *erase_payload = typed; // expected-error {{cannot initialize a variable of type}}
+  ThrowsError *invent_payload = untyped; // expected-error {{cannot initialize a variable of type}}
+  Plain *drop_async = async_fn; // expected-error {{cannot initialize a variable of type}}
+  Async *invent_async = plain; // expected-error {{cannot initialize a variable of type}}
+  (void)drop_typed;
+  (void)change_payload;
+  (void)erase_payload;
+  (void)invent_payload;
+  (void)drop_async;
+  (void)invent_async;
+}
+
