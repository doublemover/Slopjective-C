new file mode 100644
index 000000000..f4be4eda0
--- /dev/null
+++ b/clang/lib/Sema/ObjC3MatchSemantic.cpp
@@ -0,0 +1,122 @@
+#include "clang/AST/ObjC3MatchSemantic.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+
+#include "clang/AST/Type.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace clang;
+
+objc3::MatchPatternCheck objc3::checkMatchPattern(
+    ASTContext &Context, QualType Scrutinee,
+    const MatchPatternInfo &Pattern) {
+  MatchPatternCheck Out;
+  Out.CanonicalScrutineeType = Context.getCanonicalType(Scrutinee);
+  QualType T = Out.CanonicalScrutineeType;
+  if (T->isDependentType()) {
+    // Preserve a dependent binding until TreeTransform can select the actual
+    // payload type. An unknown payload is not a void payload.
+    Out.BorrowedPayloadType = Context.DependentTy;
+    return Out;
+  }
+  switch (Pattern.Kind) {
+  case MatchPatternKind::BooleanTrue:
+  case MatchPatternKind::BooleanFalse:
+    if (!T->isBooleanType())
+      Out.Issue = MatchPatternIssue::WrongScrutineeType;
+    return Out;
+
+  case MatchPatternKind::ResultOK:
+  case MatchPatternKind::ResultErr: {
+    const auto *Result = T->getAs<ObjC3ResultType>();
+    if (!Result) {
+      Out.Issue = MatchPatternIssue::WrongScrutineeType;
+      return Out;
+    }
+    if (!Pattern.WrittenCarrierType.isNull() &&
+        Context.getCanonicalType(Pattern.WrittenCarrierType) != T) {
+      Out.Issue = MatchPatternIssue::WrongScrutineeType;
+      return Out;
+    }
+    Out.BorrowedPayloadType = Pattern.Kind == MatchPatternKind::ResultOK
+                                  ? Result->getSuccessType()
+                                  : Result->getErrorType();
+    return Out;
+  }
+
+  case MatchPatternKind::OptionalSome:
+  case MatchPatternKind::OptionalNone: {
+    const auto *Optional = T->getAs<ObjC3OptionalType>();
+    if (!Optional) {
+      Out.Issue = MatchPatternIssue::WrongScrutineeType;
+      return Out;
+    }
+    if (!Pattern.WrittenCarrierType.isNull() &&
+        Context.getCanonicalType(Pattern.WrittenCarrierType) != T) {
+      Out.Issue = MatchPatternIssue::WrongScrutineeType;
+      return Out;
+    }
+    if (Pattern.Kind == MatchPatternKind::OptionalSome)
+      Out.BorrowedPayloadType = Optional->getElementType();
+    return Out;
+  }
+
+  case MatchPatternKind::IntegerLiteral:
+  case MatchPatternKind::CharacterLiteral: {
+    if (!T->isIntegralOrEnumerationType() || !Pattern.PatternValue) {
+      Out.Issue = MatchPatternIssue::InvalidLiteralPattern;
+      return Out;
+    }
+    auto Value = Pattern.PatternValue->getIntegerConstantExpr(Context);
+    if (!Value) {
+      Out.Issue = MatchPatternIssue::InvalidLiteralPattern;
+      return Out;
+    }
+    unsigned Width = Context.getIntWidth(T);
+    bool Signed = T->isSignedIntegerOrEnumerationType();
+    bool Negative = Value->isSigned() && Value->isNegative();
+    if (Negative ? (!Signed || !Value->isSignedIntN(Width))
+                 : Value->getActiveBits() > Width - unsigned(Signed))
+      Out.Issue = MatchPatternIssue::InvalidLiteralPattern;
+    return Out;
+  }
+
+  case MatchPatternKind::NilLiteral: {
+    // Explicit null pointer casts are nil patterns too, even in C++ where
+    // `(void *)0` is not an implicit null pointer constant for another type.
+    Expr::EvalResult Value;
+    const bool IsNullPointer = Pattern.PatternValue &&
+        (Pattern.PatternValue->getType()->isAnyPointerType() ||
+         Pattern.PatternValue->getType()->isBlockPointerType()) &&
+        Pattern.PatternValue->EvaluateAsRValue(Value, Context) &&
+        !Value.HasSideEffects && Value.Val.isLValue() &&
+        Value.Val.getLValueBase().isNull() &&
+        Value.Val.getLValueOffset().isZero();
+    if ((!T->isNullPtrType() && !T->isPointerType() &&
+         !T->isObjCObjectPointerType() && !T->isBlockPointerType()) ||
+        !Pattern.PatternValue ||
+        (!IsNullPointer && !Pattern.PatternValue->isNullPointerConstant(
+            Context, Expr::NPC_ValueDependentIsNotNull)))
+      Out.Issue = MatchPatternIssue::InvalidLiteralPattern;
+    return Out;
+  }
+
+  case MatchPatternKind::StringLiteral:
+    if (!T->isObjCObjectPointerType() && !T->isPointerType())
+      Out.Issue = MatchPatternIssue::InvalidLiteralPattern;
+    return Out;
+
+  case MatchPatternKind::TypeTest:
+    Out.Issue = MatchPatternIssue::UnsupportedTypeTest;
+    return Out;
+  case MatchPatternKind::MoveBinding:
+    Out.Issue = MatchPatternIssue::UnsupportedMove;
+    return Out;
+
+  case MatchPatternKind::Wildcard:
+  case MatchPatternKind::Binding:
+  case MatchPatternKind::Default:
+    return Out;
+  }
+  llvm_unreachable("all ObjC3 match patterns handled");
+}
