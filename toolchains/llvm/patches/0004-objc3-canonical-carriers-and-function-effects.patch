@@ -0,0 +1,41 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fexceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fexceptions -fcxx-exceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fexceptions -fcxx-exceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fcxx-exceptions -fobjc-exceptions -Werror=return-type -Werror=uninitialized -fsyntax-only -verify %s
+#ifndef __cplusplus
+#define bool _Bool
+#endif
+@protocol Error @end
+void cleanup(void) __attribute__((nothrow));
+int native_exception(bool fail, id token) {
+  defer { cleanup(); }
+  if(fail)@throw token;
+  return 42;
+}
+int native_exception_only(id token) {
+  defer { cleanup(); }
+  @throw token;
+}
+int handler_binding(id<Error> token) {
+  handle { throwError(token); }
+  catch(id<Error> error) { return error ? 1 : 0; }
+}
+int ordinary_uninitialized(id<Error> token) {
+  int value; // expected-note {{initialize the variable 'value' to silence this warning}}
+  handle { throwError(token); }
+  catch(id<Error> error) {
+    return error ? value : 0; // expected-error {{variable 'value' is uninitialized when used here}}
+  }
+}
+int ordinary_fallthrough(void) {
+  defer { cleanup(); }
+} // expected-error {{non-void function does not return a value}}
+#ifdef __cplusplus
+int cxx_exception(bool fail) {
+  defer { cleanup(); }
+  if(fail)throw 73;
+  return 42;
+}
+#endif
diff --git a/clang/lib/Parse/ParseObjC3Conditions.cpp b/clang/lib/Parse/ParseObjC3Conditions.cpp
new file mode 100644
index 000000000..f82d72d23
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3Conditions.cpp
@@ -0,0 +1,288 @@
+//===--- ParseObjC3Conditions.cpp - Native optional-binding statements ------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Basic/DiagnosticParse.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
+#include "clang/Sema/Scope.h"
+#include "clang/Sema/SemaCodeCompletion.h"
+#include "llvm/ADT/SmallVector.h"
+
+using namespace clang;
+
+namespace {
+bool isWord(const Token &Token, StringRef Word) {
+  return Token.is(tok::identifier) && Token.getIdentifierInfo() &&
+         Token.getIdentifierInfo()->isStr(Word);
+}
+
+bool isBindingHead(const Token &Token) {
+  return isWord(Token, "let") || isWord(Token, "var");
+}
+
+bool isConditionBoundary(const Token &Token) {
+  return Token.isOneOf(tok::kw_else, tok::l_brace, tok::r_brace, tok::semi,
+                       tok::eof);
+}
+} // namespace
+
+bool Parser::isObjC3GuardStatementAhead() {
+  if (!getLangOpts().ObjC3 || !isWord(Tok, "guard") ||
+      NextToken().is(tok::colon))
+    return false;
+
+  // No ordinary expression or declaration begins "guard let name". Recognize
+  // this head even without '=' or 'else', so malformed bindings get their own
+  // diagnostics. A variable named let/var, a call, and a label remain ordinary.
+  if (isBindingHead(NextToken()) &&
+      GetLookAheadToken(2).is(tok::identifier))
+    return true;
+  // These starts cannot continue an ordinary use of the identifier guard.
+  // Keeping them contextual also diagnoses a missing mandatory else without
+  // reinterpreting a call or a declaration whose type is named guard.
+  if (NextToken().isOneOf(tok::kw_true, tok::kw_false, tok::exclaim))
+    return true;
+
+  // Boolean guards have no dedicated leading punctuation. Commit only when
+  // there is an else at condition-list depth. Nested lambdas, statement
+  // expressions, Objective-C messages, and braced initializers can all contain
+  // semicolons or else tokens; match delimiters in order, rather than counting
+  // each delimiter kind independently. This lookahead never consumes tokens.
+  SmallVector<tok::TokenKind, 8> Delimiters;
+  for (unsigned I = 1;; ++I) {
+    const Token &Look = GetLookAheadToken(I);
+    if (Look.isOneOf(tok::eof, tok::annot_repl_input_end))
+      return false;
+    if (Delimiters.empty()) {
+      if (Look.is(tok::kw_else))
+        return true;
+      if (Look.isOneOf(tok::semi, tok::r_brace))
+        return false;
+    }
+    switch (Look.getKind()) {
+    case tok::l_paren:
+      Delimiters.push_back(tok::r_paren);
+      break;
+    case tok::l_square:
+      Delimiters.push_back(tok::r_square);
+      break;
+    case tok::l_brace:
+      Delimiters.push_back(tok::r_brace);
+      break;
+    case tok::r_paren:
+    case tok::r_square:
+    case tok::r_brace:
+      if (Delimiters.empty() || Delimiters.pop_back_val() != Look.getKind())
+        return false;
+      break;
+    default:
+      break;
+    }
+  }
+}
+
+bool Parser::isObjC3IfBindingStatementAhead() {
+  return getLangOpts().ObjC3 && Tok.is(tok::kw_if) &&
+         isBindingHead(NextToken());
+}
+
+void Parser::RecoverObjC3Condition() {
+  // Leave structural tokens for the statement parser. SkipUntil balances
+  // nested expressions and preserves the containing compound's closing brace.
+  const tok::TokenKind Stops[] = {tok::comma, tok::kw_else, tok::l_brace,
+                                  tok::r_brace};
+  SkipUntil(Stops, StopAtSemi | StopBeforeMatch);
+}
+
+bool Parser::ParseObjC3ConditionList(SmallVectorImpl<Stmt *> &Conditions,
+                                      bool GuardMode) {
+  bool Invalid = false;
+  bool InBindingList = false;
+  bool Mutable = false;
+  bool SeenBindingHead = false;
+  for (;;) {
+    const SourceLocation Begin = Tok.getLocation();
+    if (Tok.is(tok::code_completion)) {
+      cutOffParsing();
+      Actions.CodeCompletion().CodeCompleteOrdinaryName(
+          getCurScope(), SemaCodeCompletion::PCC_Expression);
+      return false;
+    }
+    if (isConditionBoundary(Tok) || Tok.is(tok::comma)) {
+      Diag(Tok, GuardMode ? diag::err_objc3_guard_expected_condition
+                          : diag::err_objc3_expected_binding);
+      Invalid = true;
+      if (Tok.isNot(tok::comma))
+        return false;
+      ConsumeToken();
+      InBindingList = false;
+      continue;
+    }
+
+    // In a guard, let/var is contextual only before a binding name. In an
+    // if-binding statement the first head has already selected this grammar.
+    // A Boolean condition ends the preceding binding list, so a later bare
+    // assignment is an expression until another explicit let/var head appears.
+    bool ExplicitHead = isBindingHead(Tok) &&
+                        ((!GuardMode && !SeenBindingHead) ||
+                         NextToken().is(tok::identifier));
+    bool ContinuedBinding = InBindingList && Tok.is(tok::identifier) &&
+                            NextToken().is(tok::equal);
+    if (ExplicitHead || ContinuedBinding) {
+      if (ExplicitHead) {
+        if (!GuardMode && SeenBindingHead) {
+          Diag(Tok, diag::err_objc3_if_binding_repeated_head);
+          Invalid = true;
+        }
+        Mutable = isWord(Tok, "var");
+        SeenBindingHead = true;
+        ConsumeToken();
+      }
+      InBindingList = true;
+      if (Tok.isNot(tok::identifier)) {
+        Diag(Tok, diag::err_objc3_expected_binding);
+        Invalid = true;
+        RecoverObjC3Condition();
+      } else {
+        IdentifierInfo *Name = Tok.getIdentifierInfo();
+        SourceLocation NameLoc = ConsumeToken();
+        if (Tok.isNot(tok::equal)) {
+          Diag(Tok, diag::err_expected) << tok::equal;
+          Invalid = true;
+          RecoverObjC3Condition();
+        } else {
+          SourceLocation EqualLoc = ConsumeToken();
+          ExprResult Source;
+          if (isConditionBoundary(Tok) || Tok.is(tok::comma)) {
+            Diag(Tok, diag::err_expected_expression);
+            Source = ExprError();
+          } else {
+            Source = ParseAssignmentExpression();
+          }
+          if (Source.isInvalid()) {
+            Invalid = true;
+            RecoverObjC3Condition();
+          } else {
+            StmtResult Binding = Actions.ActOnObjC3BindingCondition(
+                getCurScope(), Name, NameLoc, Mutable, Begin, EqualLoc,
+                Source.get());
+            if (Binding.isInvalid())
+              Invalid = true;
+            else
+              Conditions.push_back(Binding.get());
+          }
+        }
+      }
+    } else if (GuardMode || SeenBindingHead) {
+      InBindingList = false;
+      ExprResult Value = ParseAssignmentExpression();
+      if (Value.isInvalid()) {
+        Invalid = true;
+        RecoverObjC3Condition();
+      } else {
+        ExprResult Condition = Actions.ActOnObjC3BooleanCondition(
+            getCurScope(), Value.get(), Begin);
+        if (Condition.isInvalid())
+          Invalid = true;
+        else
+          Conditions.push_back(Condition.get());
+      }
+    } else {
+      Diag(Tok, diag::err_objc3_expected_binding);
+      Invalid = true;
+      RecoverObjC3Condition();
+    }
+
+    if (Tok.isNot(tok::comma) && !isConditionBoundary(Tok)) {
+      Diag(Tok, diag::err_objc3_condition_expected_separator) << GuardMode;
+      Invalid = true;
+      RecoverObjC3Condition();
+    }
+    if (Tok.isNot(tok::comma))
+      return !Invalid && !Conditions.empty();
+    ConsumeToken();
+  }
+}
+
+StmtResult Parser::ParseObjC3GuardStatement() {
+  assert(isWord(Tok, "guard") && "not a guard statement");
+  SourceLocation KeywordLoc = ConsumeToken();
+  SmallVector<Stmt *, 4> Conditions;
+
+  // Each successful binding enters lookup before the next initializer. Exit
+  // this temporary scope before parsing failure, then Sema installs the same
+  // declarations in the source parent after the entire guard is accepted.
+  ParseScope Bindings(this, Scope::DeclScope | Scope::CompoundStmtScope);
+  bool Invalid = !ParseObjC3ConditionList(Conditions, /*GuardMode=*/true);
+  Bindings.Exit();
+
+  SourceLocation ElseLoc;
+  if (Tok.is(tok::kw_else)) {
+    ElseLoc = ConsumeToken();
+  } else {
+    Diag(Tok, diag::err_objc3_guard_expected_else);
+    Invalid = true;
+    // A missing else immediately before a compound is recoverable without
+    // losing the following source siblings or leaking any success binding.
+    if (Tok.isNot(tok::l_brace))
+      return StmtError();
+  }
+
+  if (Tok.isNot(tok::l_brace)) {
+    Diag(Tok, diag::err_objc3_condition_expected_compound) << 0;
+    if (!Tok.isOneOf(tok::r_brace, tok::eof, tok::kw_else)) {
+      ParseScope Recovery(this, Scope::DeclScope);
+      (void)ParseStatement();
+    }
+    return StmtError();
+  }
+  StmtResult ElseBody = ParseCompoundStatement();
+  if (Invalid || ElseBody.isInvalid())
+    return StmtError();
+  return Actions.ActOnObjC3GuardStmt(getCurScope(), Conditions, ElseBody.get(),
+                                     KeywordLoc, ElseLoc);
+}
+
+StmtResult Parser::ParseObjC3IfBindingStatement() {
+  assert(Tok.is(tok::kw_if) && "not an if binding statement");
+  SourceLocation IfLoc = ConsumeToken();
+  SmallVector<Stmt *, 4> Conditions;
+  ParseScope Bindings(this, Scope::DeclScope | Scope::ControlScope);
+  bool Invalid = !ParseObjC3ConditionList(Conditions, /*GuardMode=*/false);
+  StmtResult Then;
+  if (Tok.is(tok::l_brace)) {
+    Then = ParseCompoundStatement();
+  } else {
+    Diag(Tok, diag::err_objc3_condition_expected_compound) << 1;
+    Invalid = true;
+    if (!Tok.isOneOf(tok::kw_else, tok::r_brace, tok::eof)) {
+      ParseScope Recovery(this, Scope::DeclScope);
+      (void)ParseStatement();
+    }
+  }
+  Bindings.Exit();
+
+  SourceLocation ElseLoc;
+  StmtResult ElseBody;
+  if (Tok.is(tok::kw_else)) {
+    ElseLoc = ConsumeToken();
+    if (Tok.is(tok::l_brace)) {
+      ElseBody = ParseCompoundStatement();
+    } else {
+      Diag(Tok, diag::err_objc3_condition_expected_compound) << 2;
+      Invalid = true;
+      if (!Tok.isOneOf(tok::kw_else, tok::r_brace, tok::eof)) {
+        ParseScope Recovery(this, Scope::DeclScope);
+        (void)ParseStatement();
+      }
+    }
+  }
+  if (Invalid || Then.isInvalid() || ElseBody.isInvalid())
+    return StmtError();
+  return Actions.ActOnObjC3IfBindingStmt(Conditions, Then.get(), ElseBody.get(),
+                                         IfLoc, ElseLoc);
+}
diff --git a/clang/test/ObjC3/Parser/Inputs/guard-pch-consumer.mm b/clang/test/ObjC3/Parser/Inputs/guard-pch-consumer.mm
new file mode 100644
index 000000000..80604db66
--- /dev/null
+++ b/clang/test/ObjC3/Parser/Inputs/guard-pch-consumer.mm
@@ -0,0 +1,7 @@
+// expected-no-diagnostics
+int pch_condition_consumer(GuardMaybe source) {
+  OBJC3_PCH_REQUIRE OBJC3_PCH_BIND first = source,
+      second = Some(int, first) else { return 0; }
+  return pch_guard(source, true) + pch_if_binding(source) +
+         pch_dependent_conditions(source) + first + second;
+}
diff --git a/clang/test/ObjC3/Parser/Inputs/guard-pch.h b/clang/test/ObjC3/Parser/Inputs/guard-pch.h
new file mode 100644
index 000000000..d2fad4ad8
--- /dev/null
+++ b/clang/test/ObjC3/Parser/Inputs/guard-pch.h
@@ -0,0 +1,33 @@
+#ifndef OBJC3_NATIVE_GUARD_PCH_H
+#define OBJC3_NATIVE_GUARD_PCH_H
+
+typedef Optional(int) GuardMaybe;
+
+inline int pch_guard(GuardMaybe source, bool flag) {
+  guard let first = source, second = Some(int, first),
+        flag, var third = Some(int, second) else { return 0; }
+  third += first;
+  return first + second + third;
+}
+
+inline int pch_if_binding(GuardMaybe source) {
+  if var first = source, second = Some(int, first) {
+    first += second;
+    return first;
+  } else {
+    return 0;
+  }
+}
+
+template <class T> int pch_dependent_conditions(T source) {
+  guard let first = source, second = source else { return 0; }
+  if let third = source, fourth = source {
+    return first + second + third + fourth;
+  }
+  return first + second;
+}
+
+#define OBJC3_PCH_REQUIRE guard
+#define OBJC3_PCH_BIND let
+
+#endif
diff --git a/clang/test/ObjC3/Parser/guard-c-mode.m b/clang/test/ObjC3/Parser/guard-c-mode.m
new file mode 100644
index 000000000..ab4d2dba4
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-c-mode.m
@@ -0,0 +1,26 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c23 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+typedef Optional(int) Maybe;
+typedef __typeof__(hasValue(None(int))) Bool;
+Maybe make(int);
+void use(int);
+
+void native_c_conditions(Maybe source, Bool flag) {
+  guard let first = source, second = make(first),
+        flag, var third = make(second), fourth = make(third) else {
+    return;
+  }
+  third += fourth;
+  use(first + second + third + fourth);
+  if let local = make(first), dependent = make(local) {
+    use(local + dependent);
+  } else {
+    use(first);
+  }
+  if var local = make(second), dependent = make(local) {
+    local += dependent;
+    use(local);
+  }
+}
