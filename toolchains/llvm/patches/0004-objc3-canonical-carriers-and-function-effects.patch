+TEST(ObjC3Conditions, PayloadAnnotationsSurviveAliasesImportAndPersistence) {
+  const std::vector<std::string> Args = {
+      "-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+      "-fobjc-runtime=gnustep-2.2", "-fobjc-arc", "-Wno-nullability-completeness"};
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    typedef id _Nullable Nullable;
+    typedef id _Nonnull Nonnull;
+    typedef __objc3_optional(Nullable) MaybeNullable;
+    typedef __objc3_optional(Nonnull) MaybeNonnull;
+    typedef __objc3_result(Nullable, Nonnull) Outcome;
+    void test(MaybeNullable a, MaybeNonnull b, Outcome c) {}
+  )", Args, "carrier-annotations.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto Check = [](ASTContext &C, FunctionDecl *Function) {
+    ASSERT_TRUE(Function);
+    QualType A = Function->getParamDecl(0)->getType();
+    QualType B = Function->getParamDecl(1)->getType();
+    auto *OptionalA = A->getAs<ObjC3OptionalType>();
+    auto *OptionalB = B->getAs<ObjC3OptionalType>();
+    ASSERT_TRUE(OptionalA);
+    ASSERT_TRUE(OptionalB);
+    EXPECT_EQ(NullabilityKind::Nullable, OptionalA->getElementType()->getNullability());
+    EXPECT_EQ(NullabilityKind::NonNull, OptionalB->getElementType()->getNullability());
+    // Native nullability annotations do not create a different physical type.
+    EXPECT_TRUE(C.hasSameType(A, B));
+    EXPECT_EQ(C.getObjC3CarrierRepresentationType(A).Type,
+              C.getObjC3CarrierRepresentationType(B).Type);
+    auto *Result = Function->getParamDecl(2)->getType()->getAs<ObjC3ResultType>();
+    ASSERT_TRUE(Result);
+    EXPECT_EQ(NullabilityKind::Nullable, Result->getSuccessType()->getNullability());
+    EXPECT_EQ(NullabilityKind::NonNull, Result->getErrorType()->getNullability());
+  };
+  auto Find = [](ASTContext &C) -> FunctionDecl * {
+    for (Decl *D : C.getTranslationUnitDecl()->decls())
+      if (auto *FD = dyn_cast<FunctionDecl>(D))
+        if (FD->getName() == "test") return FD;
+    return nullptr;
+  };
+  Check(AST->getASTContext(), Find(AST->getASTContext()));
+  auto Target = tooling::buildASTFromCodeWithArgs("", Args, "annotation-target.mm");
+  ASSERT_TRUE(Target);
+  ASTImporter Importer(Target->getASTContext(), Target->getFileManager(),
+                       AST->getASTContext(), AST->getFileManager(), false);
+  auto Imported = Importer.Import(Find(AST->getASTContext()));
+  ASSERT_TRUE(static_cast<bool>(Imported)) << llvm::toString(Imported.takeError());
+  Check(Target->getASTContext(), cast<FunctionDecl>(*Imported));
+
+  llvm::SmallString<256> Path;
+  int Descriptor;
+  ASSERT_FALSE(llvm::sys::fs::createTemporaryFile("carrier-annotations", "ast",
+                                                  Descriptor, Path));
+  llvm::ToolOutputFile File(Path, Descriptor);
+  ASSERT_FALSE(AST->Save(Path));
+  auto VFS = AST->getFileManager().getVirtualFileSystemPtr();
+  auto DiagnosticOpts = std::make_shared<DiagnosticOptions>();
+  auto Diagnostics = CompilerInstance::createDiagnostics(*VFS, *DiagnosticOpts);
+  auto Containers = std::make_shared<PCHContainerOperations>();
+  HeaderSearchOptions Headers;
+  auto Reloaded = ASTUnit::LoadFromASTFile(
+      Path, Containers->getRawReader(), ASTUnit::LoadEverything, VFS,
+      DiagnosticOpts, Diagnostics, AST->getFileSystemOpts(), Headers);
+  ASSERT_TRUE(Reloaded);
+  Check(Reloaded->getASTContext(), Find(Reloaded->getASTContext()));
+}
