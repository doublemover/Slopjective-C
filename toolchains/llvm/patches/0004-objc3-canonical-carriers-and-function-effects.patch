diff --git a/clang/test/ObjC3/AST/Inputs/typed-keypaths.h b/clang/test/ObjC3/AST/Inputs/typed-keypaths.h
new file mode 100644
index 000000000..aecc4599f
--- /dev/null
+++ b/clang/test/ObjC3/AST/Inputs/typed-keypaths.h
@@ -0,0 +1,38 @@
+#include "../../Inputs/keypath-abi.h"
+__attribute__((objc_root_class))
+@interface ImportedPathNode
+@property(nonatomic) int count;
+@property(nonatomic, readonly) int identity;
+@end
+typedef struct ImportedPathPair { long first, second; } ImportedPathPair;
+@interface ImportedPathNode (Record)
+@property(nonatomic) ImportedPathPair pair;
+@end
+static inline WritableKeyPath<ImportedPathNode *, long> importedFieldPath(void) {
+  return @keypath(ImportedPathNode, pair.first);
+}
+static inline WritableKeyPath<ImportedPathNode *, int> importedPath(void) {
+  return @keypath(ImportedPathNode, count);
+}
+static inline int importedGet(ImportedPathNode * _Nonnull root) {
+  return KeyPathGet(importedPath(), root);
+}
+
+typedef struct ImportedPathBits { unsigned value:3; signed small:5; } ImportedPathBits;
+@interface ImportedPathNode (Bits)
+@property(nonatomic) ImportedPathBits bits;
+@end
+static inline WritableKeyPath<ImportedPathNode *, unsigned> importedBitsPath(void) {
+  return @keypath(ImportedPathNode, bits.value);
+}
+#ifdef __cplusplus
+struct ImportedLeft { int left; };
+struct ImportedRight { long right; };
+struct ImportedDerived : ImportedLeft, ImportedRight { int tail; };
+@interface ImportedPathNode (Inherited)
+@property(nonatomic) ImportedDerived inherited;
+@end
+static inline WritableKeyPath<ImportedPathNode *, long> importedInheritedPath(void) {
+  return @keypath(ImportedPathNode, inherited.right);
+}
+#endif
diff --git a/clang/test/ObjC3/AST/typed-keypaths-pch.m b/clang/test/ObjC3/AST/typed-keypaths-pch.m
