+      --live;
+    }
+  };
+  typedef __objc3_optional(Payload) Maybe;
+  Maybe *counted(Maybe *value) { ++firstCalls; return value; }
+  Maybe *countedSecond(Maybe *value, int first) {
+    ++secondCalls;
+    if (first != expectedFirst || tempDestructions != 2 || live != expectedLive + 1) ++badOrder;
+    return value;
