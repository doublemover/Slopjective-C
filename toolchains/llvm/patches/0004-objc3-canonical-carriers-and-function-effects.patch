+      {"destructor_normal",
+       {"construct,destroy,first,", "construct,destroy,first,caught,"}},
+      {"destructor_unwind",
+       {"construct,destroy,first,caught,", "construct,destroy,terminate,"}},
+      {"destructor_outward_goto",
+       {"construct,destroy,first,", "construct,destroy,first,caught,"}},
+      {"attributed_cleanup", {"cleanup,first,", "cleanup,first,caught,"}},
+      {"result_temporary",
+       {"construct,temporary,first,", "construct,temporary,first,caught,"}},
+      {"temporary_construction_failure",
+       {"construct,first,caught,", "construct,temporary,first,"}},
+      {"reference_cast", {"cast,first,", "cast,first,caught,"}},
+      {"type_query", {"typeid,first,", "typeid,first,caught,"}},
+      {"scalar_allocation", {"allocate,first,", "allocate,first,caught,"}},
+      {"initialized_allocation",
+       {"allocate,construct,first,", "allocate,first,caught,"}},
+      {"scalar_deallocation",
+       {"delete-dtor,delete,first,", "delete-dtor,delete,first,caught,"}},
+      {"unmatched_inner_handler",
+       {"work,second,first,", "work,second,caught,first,",
+        "work,second,first,unwind,"}}};
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool Rich : {false, true}) {
+      SCOPED_TRACE(Rich);
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      Options.AddRichCXXConstructors = Rich;
