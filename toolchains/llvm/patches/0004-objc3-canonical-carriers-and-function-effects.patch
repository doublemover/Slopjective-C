+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  auto Imported = Importer.Import(FD);
+  ASSERT_TRUE(static_cast<bool>(Imported))
+      << llvm::toString(Imported.takeError());
+  auto *ImportedFunction = cast<FunctionDecl>(*Imported);
+  SourceVisitor Visitor;
+  ASSERT_TRUE(Visitor.TraverseStmt(ImportedFunction->getBody()));
+  ASSERT_EQ(2u, Visitor.Bindings.size());
+  auto *First = Visitor.Bindings[0]->getBindingDecl();
+  auto *Second = Visitor.Bindings[1]->getBindingDecl();
+  EXPECT_TRUE(First->getType().isConstQualified());
+  EXPECT_FALSE(Second->getType().isConstQualified());
+  EXPECT_EQ(&To->getASTContext(), &First->getASTContext());
+  BindingReferences References;
+  ASSERT_TRUE(References.TraverseStmt(ImportedFunction->getBody()));
+  ASSERT_EQ(3u, References.First.size());
+  ASSERT_EQ(3u, References.Second.size());
+  for (const ValueDecl *D : References.First)
+    EXPECT_EQ(First, D);
+  for (const ValueDecl *D : References.Second)
+    EXPECT_EQ(Second, D);
+  Occurrences Index;
+  index::IndexingOptions Options;
+  Options.IndexFunctionLocals = true;
+  const Decl *ImportedDecls[] = {ImportedFunction};
+  index::indexTopLevelDecls(To->getASTContext(), To->getPreprocessor(),
+                            ImportedDecls, Index, Options);
+  EXPECT_EQ(3u, Index.count("first", index::SymbolRole::Reference));
+  EXPECT_EQ(3u, Index.count("second", index::SymbolRole::Reference));
+  for (const auto &Item : Index.Items) {
+    if (Item.Declaration->getName() == "first")
+      EXPECT_EQ(First, Item.Declaration);
+    if (Item.Declaration->getName() == "second")
+      EXPECT_EQ(Second, Item.Declaration);
+  }
+  // A repeated import must reuse declarations already attached to references.
+  auto Reimported = Importer.Import(FD);
+  ASSERT_TRUE(static_cast<bool>(Reimported))
+      << llvm::toString(Reimported.takeError());
+  EXPECT_EQ(*Imported, *Reimported);
+}
