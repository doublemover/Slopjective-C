+  ManualOwner *_Nonnull alias=owner;
+  manual_use(manual_bytes(alias)); // expected-error {{after its owner lifetime ended}}
+}
+void late_pin(ManualOwner *_Nonnull owner) {
+  [owner release];
+  keepAlive(owner); // expected-error {{lifetime pin created after manual owner release}}
+  manual_use(manual_bytes(owner)); // expected-error {{after its owner lifetime ended}}
+}
+void ended_pin(ManualOwner *_Nonnull owner) {
