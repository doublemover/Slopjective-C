diff --git a/clang/include/clang/AST/ObjC3MatchCoverage.h b/clang/include/clang/AST/ObjC3MatchCoverage.h
new file mode 100644
index 000000000..e2d3b8ecd
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3MatchCoverage.h
@@ -0,0 +1,57 @@
+#ifndef LLVM_CLANG_AST_OBJC3MATCHCOVERAGE_H
+#define LLVM_CLANG_AST_OBJC3MATCHCOVERAGE_H
+
+#include "clang/Basic/SourceLocation.h"
+#include "llvm/ADT/ArrayRef.h"
+#include <cstdint>
+
+namespace clang {
+class ASTContext;
+class QualType;
+
+namespace objc3 {
+
+enum class MatchPatternKind : uint8_t {
+  BooleanTrue, BooleanFalse, OptionalSome, OptionalNone, ResultOK, ResultErr,
+  IntegerLiteral, CharacterLiteral, NilLiteral, StringLiteral,
+  Wildcard, Binding, Default, TypeTest, MoveBinding
+};
+
+enum class MatchBindingKind : uint8_t {
+  None, Scrutinee, OptionalPayload, SuccessPayload, ErrorPayload
+};
+
+struct MatchCoverageArm {
+  MatchPatternKind Kind;
+  SourceLocation Location;
+  bool HasGuard;
+  /// For Optional/Result arms, canonical carrier identity at the pattern site.
+  const void *CanonicalPatternType;
+};
+
+enum class MatchDomain : uint8_t { Open, Boolean, Optional, Result };
+enum class MatchCoverageIssue : uint8_t {
+  None, PatternTypeMismatch, UnsupportedPattern, DuplicateCase,
+  UnreachableCase, NonExhaustive
+};
+
+struct MatchCoverageResult {
+  MatchDomain Domain = MatchDomain::Open;
+  MatchCoverageIssue Issue = MatchCoverageIssue::None;
+  unsigned ArmIndex = 0;
+  bool CoversTrue = false, CoversFalse = false;
+  bool CoversSome = false, CoversNone = false;
+  bool CoversOK = false, CoversErr = false;
+  bool HasCatchAll = false;
+  bool IsExhaustive = false;
+};
+
+/// Compute the v1 covered domain. Only unguarded arms cover a whole pattern;
+/// arms remain ordered regardless, so a failed guard falls through.
+MatchCoverageResult analyzeMatchCoverage(
+    ASTContext &Context, QualType ScrutineeType,
+    llvm::ArrayRef<MatchCoverageArm> Arms);
+
+} // namespace objc3
+} // namespace clang
+#endif
diff --git a/clang/include/clang/AST/ObjC3MatchNodes.inc b/clang/include/clang/AST/ObjC3MatchNodes.inc
new file mode 100644
index 000000000..5fd8aa6f9
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3MatchNodes.inc
@@ -0,0 +1,152 @@
+/// An ordered ObjC3 match arm. PatternValue is non-null only for literal
+/// patterns; Guard is nullable; Body is an Expr for expression-form matches.
+class ObjC3MatchArm final : public Stmt {
+public:
+  using PatternKind = objc3::MatchPatternKind;
+
+private:
+  Stmt *Children[4] = {nullptr, nullptr, nullptr, nullptr};
+  VarDecl *BindingDecl = nullptr;
+  QualType PatternCarrierType;
+  PatternKind Pattern = PatternKind::Wildcard;
+  objc3::MatchBindingKind BindingKind = objc3::MatchBindingKind::None;
+  bool MutableBinding = false;
+  bool ExpressionBody = false;
+  SourceLocation CaseLoc, PatternLoc, GuardLoc, DelimiterLoc;
+
+public:
+  friend class ASTStmtReader;
+  ObjC3MatchArm(EmptyShell Empty) : Stmt(ObjC3MatchArmClass, Empty) {}
+  static ObjC3MatchArm *CreateEmpty(const ASTContext &C);
+  ObjC3MatchArm(PatternKind K, Expr *PatternValue, Stmt *BindingStatement,
+                Expr *Guard, Stmt *Body, VarDecl *Binding,
+                objc3::MatchBindingKind BindKind,
+                QualType CanonicalPatternType,
+                bool Mutable, bool ExprBody, SourceLocation Case,
+                SourceLocation PatternAt, SourceLocation GuardAt,
+                SourceLocation Delimiter)
+      : Stmt(ObjC3MatchArmClass),
+        Children{PatternValue, BindingStatement, Guard, Body},
+        BindingDecl(Binding), PatternCarrierType(CanonicalPatternType),
+        Pattern(K), BindingKind(BindKind), MutableBinding(Mutable),
+        ExpressionBody(ExprBody),
+        CaseLoc(Case), PatternLoc(PatternAt), GuardLoc(GuardAt),
+        DelimiterLoc(Delimiter) {}
+
+  Expr *getPatternValue() const { return cast_or_null<Expr>(Children[0]); }
+  Stmt *getBindingStatement() const { return Children[1]; }
+  Expr *getGuard() const { return cast_or_null<Expr>(Children[2]); }
+  Stmt *getBody() const { return Children[3]; }
+  void setBody(Stmt *Value) { Children[3] = Value; }
+  VarDecl *getBindingDecl() const { return BindingDecl; }
+  objc3::MatchBindingKind getBindingKind() const { return BindingKind; }
+  QualType getCanonicalPatternType() const { return PatternCarrierType; }
+  PatternKind getPatternKind() const { return Pattern; }
+  bool isMutableBinding() const { return MutableBinding; }
+  bool hasExpressionBody() const { return ExpressionBody; }
+  SourceLocation getCaseLoc() const { return CaseLoc; }
+  SourceLocation getPatternLoc() const { return PatternLoc; }
+  SourceLocation getGuardLoc() const { return GuardLoc; }
+  SourceLocation getDelimiterLoc() const { return DelimiterLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return CaseLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY {
+    return Children[3] ? Children[3]->getEndLoc() : DelimiterLoc;
+  }
+  child_range children() { return child_range(&Children[0], &Children[4]); }
+  const_child_range children() const {
+    return const_child_range(&Children[0], &Children[4]);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3MatchArmClass;
+  }
+};
+
+class ObjC3MatchStmt final : public Stmt,
+    private llvm::TrailingObjects<ObjC3MatchStmt, Stmt *> {
+  friend TrailingObjects;
+  unsigned NumArms;
+  SourceLocation KeywordLoc, LParenLoc, RParenLoc, LBraceLoc, RBraceLoc;
+  ObjC3MatchStmt(unsigned N, SourceLocation K, SourceLocation LP,
+      SourceLocation RP, SourceLocation LB, SourceLocation RB)
+      : Stmt(ObjC3MatchStmtClass), NumArms(N), KeywordLoc(K), LParenLoc(LP),
+        RParenLoc(RP), LBraceLoc(LB), RBraceLoc(RB) {}
+public:
+  friend class ASTStmtReader;
+  static ObjC3MatchStmt *Create(const ASTContext &, Expr *Scrutinee,
+      llvm::ArrayRef<ObjC3MatchArm *> Arms, SourceLocation Keyword,
+      SourceLocation LParen, SourceLocation RParen, SourceLocation LBrace,
+      SourceLocation RBrace);
+  static ObjC3MatchStmt *CreateEmpty(const ASTContext &, unsigned NumArms);
+  Expr *getScrutinee() const {
+    return cast<Expr>(getTrailingObjects()[0]);
+  }
+  unsigned getNumArms() const { return NumArms; }
+  ObjC3MatchArm *getArm(unsigned I) const {
+    assert(I < NumArms);
+    return cast<ObjC3MatchArm>(getTrailingObjects()[I + 1]);
+  }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getLParenLoc() const { return LParenLoc; }
+  SourceLocation getRParenLoc() const { return RParenLoc; }
+  SourceLocation getLBraceLoc() const { return LBraceLoc; }
+  SourceLocation getRBraceLoc() const { return RBraceLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return KeywordLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY { return RBraceLoc; }
+  child_range children() {
+    Stmt **Begin = const_cast<Stmt **>(getTrailingObjects());
+    return child_range(Begin, Begin + NumArms + 1);
+  }
+  const_child_range children() const {
+    Stmt *const *Begin = getTrailingObjects();
+    return const_child_range(Begin, Begin + NumArms + 1);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3MatchStmtClass;
+  }
+};
+
+class ObjC3MatchExpr final : public Expr,
+    private llvm::TrailingObjects<ObjC3MatchExpr, Stmt *> {
+  friend TrailingObjects;
+  unsigned NumArms;
+  SourceLocation KeywordLoc, LParenLoc, RParenLoc, LBraceLoc, RBraceLoc;
+  ObjC3MatchExpr(QualType ResultType, unsigned N, SourceLocation K,
+      SourceLocation LP, SourceLocation RP, SourceLocation LB,
+      SourceLocation RB)
+      : Expr(ObjC3MatchExprClass, ResultType, VK_PRValue, OK_Ordinary),
+        NumArms(N), KeywordLoc(K), LParenLoc(LP), RParenLoc(RP),
+        LBraceLoc(LB), RBraceLoc(RB) {}
+public:
+  friend class ASTStmtReader;
+  static ObjC3MatchExpr *Create(const ASTContext &, QualType CanonicalResult,
+      Expr *Scrutinee, llvm::ArrayRef<ObjC3MatchArm *> Arms,
+      SourceLocation Keyword, SourceLocation LParen, SourceLocation RParen,
+      SourceLocation LBrace, SourceLocation RBrace);
+  static ObjC3MatchExpr *CreateEmpty(const ASTContext &, unsigned NumArms);
+  Expr *getScrutinee() const {
+    return cast<Expr>(getTrailingObjects()[0]);
+  }
+  unsigned getNumArms() const { return NumArms; }
+  ObjC3MatchArm *getArm(unsigned I) const {
+    assert(I < NumArms);
+    return cast<ObjC3MatchArm>(getTrailingObjects()[I + 1]);
+  }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getLParenLoc() const { return LParenLoc; }
+  SourceLocation getRParenLoc() const { return RParenLoc; }
+  SourceLocation getLBraceLoc() const { return LBraceLoc; }
+  SourceLocation getRBraceLoc() const { return RBraceLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return KeywordLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY { return RBraceLoc; }
+  child_range children() {
+    Stmt **Begin = const_cast<Stmt **>(getTrailingObjects());
+    return child_range(Begin, Begin + NumArms + 1);
+  }
+  const_child_range children() const {
+    Stmt *const *Begin = getTrailingObjects();
+    return const_child_range(Begin, Begin + NumArms + 1);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3MatchExprClass;
+  }
+};
diff --git a/clang/include/clang/AST/ObjC3MatchSemantic.h b/clang/include/clang/AST/ObjC3MatchSemantic.h
new file mode 100644
index 000000000..bf7542e64
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3MatchSemantic.h
@@ -0,0 +1,57 @@
+#ifndef LLVM_CLANG_AST_OBJC3MATCHSEMANTIC_H
+#define LLVM_CLANG_AST_OBJC3MATCHSEMANTIC_H
+
+#include "clang/AST/ObjC3MatchCoverage.h"
+#include "clang/AST/Type.h"
+
+namespace clang {
+class Expr;
+class IdentifierInfo;
+class VarDecl;
+class DeclStmt;
+
+namespace objc3 {
+
+enum class MatchPatternIssue : uint8_t {
+  None, WrongScrutineeType, UnsupportedTypeTest, UnsupportedMove,
+  InvalidLiteralPattern
+};
+
+struct MatchPatternInfo {
+  MatchPatternKind Kind = MatchPatternKind::Wildcard;
+  SourceLocation Location = SourceLocation();
+  QualType WrittenCarrierType = QualType();
+  Expr *PatternValue = nullptr;
+  IdentifierInfo *BindingName = nullptr;
+  SourceLocation BindingLocation;
+  bool HasGuard = false;
+  bool HasBinding = false;
+  bool MutableBinding = false;
+};
+
+
+struct MatchCaseState {
+  MatchPatternInfo Pattern;
+  QualType CanonicalPatternType;
+  QualType BindingType;
+  VarDecl *Binding = nullptr;
+  DeclStmt *BindingStatement = nullptr;
+  MatchBindingKind BindingKind = MatchBindingKind::None;
+  bool IsValid = false;
+  bool ExpressionForm = false;
+};
+
+struct MatchPatternCheck {
+  MatchPatternIssue Issue = MatchPatternIssue::None;
+  QualType BorrowedPayloadType;
+  QualType CanonicalScrutineeType;
+};
+
+/// Validate the type-directed v1 pattern form and report the payload type a
+/// Result binding borrows. This does not form an owned copy or consume source.
+MatchPatternCheck checkMatchPattern(ASTContext &Context, QualType Scrutinee,
+                                    const MatchPatternInfo &Pattern);
+
+} // namespace clang::objc3
+} // namespace clang
+#endif
