+template <typename Derived>
+ExprResult TreeTransform<Derived>::TransformObjC3MatchExpr(ObjC3MatchExpr *Old) {
+  ExprResult Scrutinee = getDerived().TransformExpr(Old->getScrutinee());
+  if (Scrutinee.isUsable())
+    Scrutinee = SemaRef.CheckPlaceholderExpr(Scrutinee.get());
+  if (Scrutinee.isInvalid())
+    return ExprError();
+
+  SmallVector<ObjC3MatchArm *, 8> Arms;
+  for (unsigned I = 0; I != Old->getNumArms(); ++I) {
+    ObjC3MatchArm *OldArm = Old->getArm(I);
+    objc3::MatchPatternInfo Pattern;
+    Pattern.Kind = OldArm->getPatternKind();
+    Pattern.Location = OldArm->getPatternLoc();
+    Pattern.WrittenCarrierType = OldArm->getCanonicalPatternType();
+    // An unresolved member has no written carrier type to substitute.
+    // Reclassify its match after the property type becomes known.
+    if (Pattern.WrittenCarrierType == SemaRef.Context.DependentTy)
+      Pattern.WrittenCarrierType = QualType();
+    if (!Pattern.WrittenCarrierType.isNull()) {
+      Pattern.WrittenCarrierType =
+          getDerived().TransformType(Pattern.WrittenCarrierType);
+      if (Pattern.WrittenCarrierType.isNull())
+        return ExprError();
+    }
+    if (Expr *OldValue = OldArm->getPatternValue()) {
+      ExprResult Value = getDerived().TransformExpr(OldValue);
+      if (Value.isInvalid())
+        return ExprError();
+      Pattern.PatternValue = Value.get();
+    }
+    if (VarDecl *OldBinding = OldArm->getBindingDecl()) {
+      Pattern.BindingName = OldBinding->getIdentifier();
+      Pattern.BindingLocation = OldBinding->getLocation();
+      Pattern.HasBinding = true;
+      Pattern.MutableBinding = OldArm->isMutableBinding();
+    }
+
+    Scope CaseScope(SemaRef.getCurScope(),
+                    Scope::DeclScope | Scope::CompoundStmtScope,
+                    SemaRef.getDiagnostics());
+    objc3::MatchCaseState State = SemaRef.ActOnObjC3MatchBeginCase(
+        &CaseScope, Scrutinee.get(), Pattern, /*ExpressionForm=*/true);
+    if (!State.IsValid)
+      return ExprError();
+    if (VarDecl *OldBinding = OldArm->getBindingDecl()) {
+      if (!State.Binding)
+        return ExprError();
+      getDerived().transformedLocalDecl(OldBinding, {State.Binding});
+    }
+
+    ExprResult Guard;
+    if (Expr *OldGuard = OldArm->getGuard()) {
+      Guard = getDerived().TransformExpr(OldGuard);
+      if (Guard.isInvalid())
+        return ExprError();
+    }
+    auto *OldBody = dyn_cast<Expr>(OldArm->getBody());
+    if (!OldBody)
+      return ExprError();
+    ExprResult Body = getDerived().TransformExpr(OldBody);
+    if (Body.isInvalid())
+      return ExprError();
+    ObjC3MatchArm *Arm = SemaRef.ActOnObjC3MatchFinishCase(
+        State, Guard.get(), Body.get(), OldArm->getCaseLoc(),
+        OldArm->getPatternLoc(), OldArm->getGuardLoc(),
+        OldArm->getDelimiterLoc());
+    if (!Arm)
+      return ExprError();
+    Arms.push_back(Arm);
+  }
+  return SemaRef.ActOnObjC3MatchExpr(
+      Scrutinee.get(), Arms, Old->getKeywordLoc(), Old->getLParenLoc(),
+      Old->getRParenLoc(), Old->getLBraceLoc(), Old->getRBraceLoc());
+}
+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3MatchArm(ObjC3MatchArm *Old) {
+  // This structural visitor exists because generated Stmt dispatch requires a
+  // transform for every node kind. Owning MatchStmt/MatchExpr transforms do
+  // not call it: they must rebuild arm bindings through Sema with the newly
+  // transformed scrutinee before transforming guards and bodies.
+  QualType PatternType = Old->getCanonicalPatternType();
+  if (!PatternType.isNull()) {
+    PatternType = getDerived().TransformType(PatternType);
+    if (PatternType.isNull())
+      return StmtError();
+  }
+  ExprResult PatternValue;
+  if (Expr *Value = Old->getPatternValue()) {
+    PatternValue = getDerived().TransformExpr(Value);
+    if (PatternValue.isInvalid())
+      return StmtError();
+  }
+  StmtResult BindingStmt;
+  VarDecl *Binding = nullptr;
+  if (Stmt *OldDeclStmt = Old->getBindingStatement()) {
+    BindingStmt = getDerived().TransformStmt(OldDeclStmt);
+    if (BindingStmt.isInvalid())
+      return StmtError();
+    auto *NewDeclStmt = dyn_cast<DeclStmt>(BindingStmt.get());
+    if (!NewDeclStmt || !NewDeclStmt->isSingleDecl())
+      return StmtError();
+    Binding = dyn_cast<VarDecl>(NewDeclStmt->getSingleDecl());
+    if (!Binding)
+      return StmtError();
+    if (Old->getBindingDecl())
+      TransformedLocalDecls[Old->getBindingDecl()] = Binding;
+  }
+  ExprResult Guard;
+  if (Expr *OldGuard = Old->getGuard()) {
+    Guard = getDerived().TransformExpr(OldGuard);
+    if (Guard.isInvalid())
+      return StmtError();
+  }
+  StmtResult Body = getDerived().TransformStmt(Old->getBody());
+  if (Body.isInvalid())
+    return StmtError();
+  return new (SemaRef.Context) ObjC3MatchArm(
+      Old->getPatternKind(), PatternValue.get(), BindingStmt.get(),
+      Guard.get(), Body.get(), Binding, Old->getBindingKind(), PatternType,
+      Old->isMutableBinding(), Old->hasExpressionBody(), Old->getCaseLoc(),
+      Old->getPatternLoc(), Old->getGuardLoc(), Old->getDelimiterLoc());
+}
