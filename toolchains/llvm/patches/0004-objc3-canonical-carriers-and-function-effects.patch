+      template<class T>template<class U>T N::Box<T>::add(U n)const{return get()+n;}
+      template<class U>U N::Concrete::twice(U n){return n+n;}
+      template<N::Value T>N::Partial<T*>::Partial(T* n):value(n){}
+      template<N::Value T>N::Partial<T*>::Partial(const Partial& other):value(other.value){}
