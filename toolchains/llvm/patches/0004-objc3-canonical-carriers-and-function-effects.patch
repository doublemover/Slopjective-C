+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3CatchStmt(
+    ObjC3CatchStmt *S) {
+    TypeSourceInfo *CatchType = S->getCatchTypeInfo();
+    if (CatchType) {
+      CatchType = getDerived().TransformType(CatchType);
+      if (!CatchType)
+        return StmtError();
+    }
+
+    StmtResult Binding;
+    if (S->getBindingDeclStmt()) {
+      Binding = getDerived().TransformStmt(S->getBindingDeclStmt());
+      if (Binding.isInvalid())
+        return StmtError();
+    }
