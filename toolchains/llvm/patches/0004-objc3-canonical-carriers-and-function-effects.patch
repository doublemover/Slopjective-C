+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+
+using namespace clang;
+
+ObjC3CoalesceExpr::ObjC3CoalesceExpr(QualType ResultType, Expr *LHS, Expr *RHS,
+                                     Expr *Recipe, SourceLocation Operator)
+    : Expr(ObjC3CoalesceExprClass, ResultType, VK_PRValue, OK_Ordinary),
+      Written{LHS, RHS}, Semantic(Recipe), OperatorLoc(Operator) {
+  setDependence(toExprDependenceForImpliedType(ResultType->getDependence()) |
+                LHS->getDependence() | RHS->getDependence());
+}
+
+ObjC3CoalesceExpr *ObjC3CoalesceExpr::Create(
+    ASTContext &Context, QualType ResultType, Expr *LHS, Expr *RHS,
+    Expr *Semantic, SourceLocation OperatorLoc) {
+  return new (Context)
+      ObjC3CoalesceExpr(ResultType, LHS, RHS, Semantic, OperatorLoc);
+}
