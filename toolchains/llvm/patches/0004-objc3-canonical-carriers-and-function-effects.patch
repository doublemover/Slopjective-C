@@ -0,0 +1,25 @@
+//===--- SemaObjC3Effects.cpp - ObjC3 callable effects -------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/Type.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+bool Sema::CheckObjC3FunctionEffects(
+    const ObjC3FunctionEffectInfo &Effects, SourceLocation Loc) {
+  // Keep ObjC3 typed throws independent of both C++ exception specifications
+  // and Objective-C exceptions. This method checks representation invariants;
+  // call propagation and lowering are separate implementation contracts.
+  if (Effects.hasValidShape())
+    return true;
+
+  Diag(Loc, diag::err_objc3_invalid_function_effect_shape);
+  return false;
+}
diff --git a/clang/test/ObjC3/AST/Inputs/carrier-expression-adversarial-pch.h b/clang/test/ObjC3/AST/Inputs/carrier-expression-adversarial-pch.h
