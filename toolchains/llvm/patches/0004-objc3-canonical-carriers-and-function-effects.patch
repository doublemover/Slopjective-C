diff --git a/clang/lib/Sema/SemaObjC3CarrierARC.cpp b/clang/lib/Sema/SemaObjC3CarrierARC.cpp
new file mode 100644
index 000000000..93e547b81
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3CarrierARC.cpp
@@ -0,0 +1,89 @@
+//===--- SemaObjC3CarrierARC.cpp - ARC payload admission --------*- C++ -*-===//
+#include "SemaObjC3CarrierARC.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+
+bool containsNestedRetainableField(QualType Type, unsigned Depth = 0) {
+  if (Type.isNull() || Depth > 64)
+    return true;
+  if (Type->isObjCObjectPointerType() || Type->isBlockPointerType())
+    return true;
+  if (const auto *Array = dyn_cast<ArrayType>(Type.getTypePtr()))
+    return containsNestedRetainableField(Array->getElementType(), Depth + 1);
+  if (const auto *Optional = Type->getAs<ObjC3OptionalType>())
+    return containsNestedRetainableField(Optional->getElementType(), Depth + 1);
+  if (const auto *Result = Type->getAs<ObjC3ResultType>())
+    return containsNestedRetainableField(Result->getSuccessType(), Depth + 1) ||
+           containsNestedRetainableField(Result->getErrorType(), Depth + 1);
+  if (const auto *Record = Type->getAs<RecordType>()) {
+    if (!Record->getDecl()->isCompleteDefinition())
+      return false;
+    if (const auto *CXX = dyn_cast<CXXRecordDecl>(Record->getDecl()))
+      for (const CXXBaseSpecifier &Base : CXX->bases())
+        if (containsNestedRetainableField(Base.getType(), Depth + 1))
+          return true;
+    for (const FieldDecl *Field : Record->getDecl()->fields())
+      if (containsNestedRetainableField(Field->getType(), Depth + 1))
+        return true;
+  }
+  return false;
+}
+
+} // namespace
+
+bool clang::normalizeObjC3CarrierPayloadOwnership(Sema &S, SourceLocation Loc,
+                                                  QualType &PayloadType) {
+  if (PayloadType.isNull() || PayloadType->isDependentType())
+    return false;
+
+  // ARC Block payloads preserve native strong, zeroing weak, and explicit
+  // unsafe storage conventions. Autoreleasing remains a call-only convention.
+  if (PayloadType->isBlockPointerType() &&
+      !S.getLangOpts().ObjCAutoRefCount) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  if ((PayloadType->getAs<RecordType>() ||
+       PayloadType->getAs<ObjC3OptionalType>() ||
+       PayloadType->getAs<ObjC3ResultType>()) &&
+      containsNestedRetainableField(PayloadType) &&
+      !(S.getLangOpts().ObjCAutoRefCount &&
+        isa<ObjC3OptionalType, ObjC3ResultType>(
+            PayloadType.getCanonicalType().getTypePtr()))) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  if (!PayloadType->isObjCObjectPointerType() &&
+      !PayloadType->isBlockPointerType())
+    return false;
+
+  switch (PayloadType.getObjCLifetime()) {
+  case Qualifiers::OCL_None:
+    if (!S.getLangOpts().ObjCAutoRefCount)
+      return false;
+    // A retainable object stored in a value carrier owns its payload strongly
+    // by default. Encode this as a real type qualifier before carrier uniquing;
+    // CodeGen must never infer strong ownership from OCL_None.
+    PayloadType = S.Context.getLifetimeQualifiedType(
+        PayloadType, Qualifiers::OCL_Strong);
+    return false;
+  case Qualifiers::OCL_Strong:
+  case Qualifiers::OCL_Weak:
+  case Qualifiers::OCL_ExplicitNone:
+    // Preserve native strong, zeroing weak, and explicit unsafe-unretained
+    // storage semantics respectively.
+    return false;
+  case Qualifiers::OCL_Autoreleasing:
+    // Autoreleasing is a call/out-parameter convention, not persistent carrier
+    // storage. Keep the rejection in Sema, before a synthetic field is formed.
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  llvm_unreachable("unknown ObjC lifetime qualifier");
+}
