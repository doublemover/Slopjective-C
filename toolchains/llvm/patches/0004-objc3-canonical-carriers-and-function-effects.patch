new file mode 100644
index 000000000..5df69ff8f
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3OptionalAccess.inc
@@ -0,0 +1,61 @@
+//===--- ObjC3OptionalAccess - Reference-only optional access AST --------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+class ObjCMessageExpr;
+
+/// Reference-only optional member/message access. The selected native access
+/// refers to an opaque nonnull receiver. Its binary-conditional semantic form
+/// owns the source evaluation and skips the entire access, including message
+/// arguments, on nil. Written access remains available for template replay and
+/// source tooling; it is not another evaluated child.
+class ObjC3OptionalAccessExpr final : public Expr {
+  friend class ASTStmtReader;
+  Stmt *Written[2] = {};
+  Stmt *Semantic = nullptr;
+  IdentifierInfo *Member = nullptr;
+  SourceLocation OperatorLoc, MemberLoc, LBracketLoc, RBracketLoc;
+
+  ObjC3OptionalAccessExpr(QualType ResultType, Expr *Receiver, Expr *Access,
+                          Expr *Semantic, IdentifierInfo *Member,
+                          SourceLocation OperatorLoc, SourceLocation MemberLoc,
+                          SourceLocation LBracketLoc,
+                          SourceLocation RBracketLoc);
+
+public:
+  explicit ObjC3OptionalAccessExpr(EmptyShell Empty)
+      : Expr(ObjC3OptionalAccessExprClass, Empty) {}
+  static ObjC3OptionalAccessExpr *Create(
+      ASTContext &, QualType, Expr *Receiver, Expr *Access, Expr *Semantic,
+      IdentifierInfo *Member, SourceLocation OperatorLoc,
+      SourceLocation MemberLoc, SourceLocation LBracketLoc = SourceLocation(),
+      SourceLocation RBracketLoc = SourceLocation());
+  bool isMessage() const { return Member == nullptr; }
+  Expr *getReceiver() const { return cast<Expr>(Written[0]); }
+  Expr *getAccess() const { return cast<Expr>(Written[1]); }
+  Expr *getSemanticExpr() const { return cast_or_null<Expr>(Semantic); }
+  IdentifierInfo *getMember() const { return Member; }
+  ObjCMessageExpr *getMessageExpr() const;
+  SourceLocation getOperatorLoc() const { return OperatorLoc; }
+  SourceLocation getMemberLoc() const { return MemberLoc; }
+  SourceLocation getLBracketLoc() const { return LBracketLoc; }
+  SourceLocation getRBracketLoc() const { return RBracketLoc; }
+  SourceLocation getExprLoc() const { return OperatorLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY {
+    return isMessage() ? LBracketLoc : getReceiver()->getBeginLoc();
+  }
+  SourceLocation getEndLoc() const LLVM_READONLY {
+    return isMessage() ? RBracketLoc : MemberLoc;
+  }
+  child_range children() {
+    return Semantic ? child_range(&Semantic, &Semantic + 1)
+                    : child_range(Written, Written + 2);
+  }
+  const_child_range children() const {
+    return Semantic ? const_child_range(&Semantic, &Semantic + 1)
+                    : const_child_range(Written, Written + 2);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3OptionalAccessExprClass;
+  }
+};
diff --git a/clang/include/clang/AST/ObjC3Resources.inc b/clang/include/clang/AST/ObjC3Resources.inc
new file mode 100644
index 000000000..6a186feb5
