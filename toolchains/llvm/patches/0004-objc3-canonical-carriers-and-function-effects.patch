@@ -0,0 +1,76 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fsyntax-only -verify %s
+
+@protocol Error @end
+typedef id<Error> E;
+void raises() __objc3_throws(E);
+
+void reject_entry(E error) {
+  goto body; // expected-error {{cannot jump from this goto statement to its label}}
+  __objc3_do { // expected-note {{jump bypasses initialization of ObjC3 do block}}
+  body:
+    __objc3_throw(error);
+  } __objc3_catch { }
+}
+void reject_catch_entry(E error) {
+  goto handler; // expected-error {{cannot jump from this goto statement to its label}}
+  __objc3_do { __objc3_throw(error); }
+  __objc3_catch { // expected-note {{jump bypasses initialization of ObjC3 catch block}}
+  handler:;
+  }
+}
+void reject_sibling_entry(E error) {
+  __objc3_do { __objc3_throw(error); }
+  __objc3_catch { goto sibling; } // expected-error {{cannot jump from this goto statement to its label}}
+  __objc3_catch { // expected-note {{jump bypasses initialization of ObjC3 catch block}}
+  sibling:;
+  }
+}
+void reject_switch_entry(E error, int which) {
+  switch (which) {
+  __objc3_do { // expected-note {{jump bypasses initialization of ObjC3 do block}}
+  case 1: // expected-error {{cannot jump from switch statement to this case label}}
+    __objc3_throw(error);
+  } __objc3_catch { }
+  }
+}
+
+void escaping_defer(E error) __objc3_throws(E) {
+  __objc3_defer { __objc3_throw(error); } // expected-error {{an ObjC3 error may not escape a defer body}}
+}
+void escaping_defer_try() __objc3_throws(E) {
+  __objc3_defer { __objc3_try(raises()); } // expected-error {{an ObjC3 error may not escape a defer body}}
+}
+void defer_cannot_reach_outer_catch(E error) {
+  __objc3_do {
+    __objc3_defer { __objc3_throw(error); } // expected-error {{an ObjC3 error may not escape a defer body}}
+  } __objc3_catch { }
+}
+void local_defer_handler(E error) {
+  __objc3_defer {
+    __objc3_do { __objc3_throw(error); }
+    __objc3_catch(E bound) { (void)bound; }
+  }
+}
+void independent_callable_in_defer(E error) {
+  __objc3_defer {
+    struct Local {
+      static void f(E e) __objc3_throws(E) { __objc3_throw(e); }
+    };
+  }
+}
+
+template<class F> void dependent_escape(F f) __objc3_throws(E) {
+  __objc3_defer { __objc3_try(f()); } // expected-error {{an ObjC3 error may not escape a defer body}}
+}
+void instantiate_escape() {
+  __objc3_try_optional(dependent_escape(raises)); // expected-note {{in instantiation of function template specialization}}
+}
+
+@protocol Extra @end
+void extra_protocol_is_not_a_universal_bridge(E error) {
+  __objc3_do {
+    __objc3_throw(error); // expected-error {{ObjC3 error is neither caught here nor compatible}}
+  } __objc3_catch(id<Error, Extra>) { // expected-error {{is incompatible with thrown error type}}
+  }
+}
diff --git a/clang/test/ObjC3/Sema/typed-error-member-overrides.mm b/clang/test/ObjC3/Sema/typed-error-member-overrides.mm
new file mode 100644
