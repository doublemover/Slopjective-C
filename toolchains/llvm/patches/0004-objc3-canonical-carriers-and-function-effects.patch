+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -Wno-nullability-completeness -Wno-arc-bridge-casts-disallowed-in-nonarc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc3-profile=strict -fobjc-runtime=gnustep-2.2 -fobjc-arc -Wno-nullability-completeness -Wno-arc-bridge-casts-disallowed-in-nonarc -fsyntax-only -verify %s
+
+@interface AliasReceiver
+- (void)ping;
+@end
+typedef AliasReceiver * _Nullable Nullable;
+
+void mutate_reference(Nullable __strong &);
+
+void conditional_reference_store(Nullable first, Nullable second, bool choose) {
+  Nullable __strong &alias = choose ? first : second;
+  guard first != (id)0, second != (id)0 else { return; }
+  alias = (id)0;
+  [first ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+  [second ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void conditional_reference_argument(Nullable first, Nullable second, bool choose) {
+  guard first != (id)0, second != (id)0 else { return; }
+  mutate_reference(choose ? first : second);
+  [first ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+  [second ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void comma_reference_alias(Nullable value) {
+  Nullable __strong &alias = ((void)0, value);
+  guard value != (id)0 else { return; }
+  alias = (id)0;
+  [value ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void statement_expression_reference_alias(Nullable value) {
+  Nullable __strong &alias = *({ &value; });
+  guard value != (id)0 else { return; }
+  alias = (id)0;
+  [value ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void explicit_reference_cast_alias(Nullable value) {
+  Nullable __strong &alias = static_cast<Nullable __strong &>(value);
+  guard value != (id)0 else { return; }
+  alias = (id)0;
+  [value ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void conditional_reference_init_capture(Nullable first, Nullable second,
+                                       bool choose) {
+  auto invalidate = [&slot = (choose ? first : second)] { slot = (id)0; };
+  guard first != (id)0, second != (id)0 else { return; }
+  invalidate();
+  [first ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+  [second ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void direct_alias_preserves_exact_source_identity(Nullable value) {
+  Nullable __strong &alias = value;
+  guard alias != (id)0 else { return; }
+  [value ping];
+  [alias ping];
+}
+
+void a_materialized_copy_has_independent_storage(Nullable value) {
+  Nullable __strong &&copy = Nullable(value);
+  value = (id)0;
+  guard copy != (id)0 else { return; }
+  [copy ping];
+  [value ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void all_native_null_spellings_refine(Nullable first, Nullable second,
+                                     Nullable third) {
+  guard first != 0, second != nullptr, third != (id)0 else { return; }
+  [first ping];
+  [second ping];
+  [third ping];
+}
+
+struct PolymorphicBase { virtual ~PolymorphicBase(); };
+struct PolymorphicDerived : PolymorphicBase {};
+
+void a_failing_dynamic_cast_can_be_nil(PolymorphicBase * _Nonnull source) {
+  [(__bridge Nullable)dynamic_cast<PolymorphicDerived *>(source) ping]; // expected-error {{ordinary message send requires a nonnull receiver}}
+}
+
+void a_static_upcast_preserves_nonnull(PolymorphicDerived * _Nonnull source) {
+  [(__bridge Nullable)static_cast<PolymorphicBase *>(source) ping];
+}
