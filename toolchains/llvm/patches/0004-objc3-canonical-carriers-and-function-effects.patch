+template <typename Derived>
+StmtResult TreeTransform<Derived>::TransformObjC3GuardStmt(ObjC3GuardStmt *S) {
+  SmallVector<Stmt *, 4> Conditions;
+  for (unsigned I = 0; I != S->getNumConditions(); ++I) {
+    StmtResult Condition = getDerived().TransformStmt(S->getCondition(I));
+    if (Condition.isInvalid()) return StmtError();
+    Conditions.push_back(Condition.get());
+  }
+  
+  StmtResult Else = getDerived().TransformStmt(S->getElse());
+  if (Else.isInvalid()) return StmtError();
