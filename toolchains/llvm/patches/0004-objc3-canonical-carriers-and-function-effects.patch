+void incompatible_carrier_pointers(OptionalInt *optional,
+                                   OptionalLong *different_optional,
+                                   IntShortResult *result,
+                                   IntLongResult *different_result) {
+  optional = different_optional; // c17-error {{incompatible pointer types}} c23-error {{incompatible pointer types}}
+  result = different_result; // c17-error {{incompatible pointer types}} c23-error {{incompatible pointer types}}
+}
