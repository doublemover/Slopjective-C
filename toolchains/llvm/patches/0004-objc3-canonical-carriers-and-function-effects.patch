+    [owner release];
+    manual_use(pointer);
+  }
+  manual_use(pointer); // expected-error {{after its owner lifetime ended}}
+}
+void nested_block(ManualOwner *_Nonnull owner) {
+  [owner release];
+  void (^work)(void)=^{manual_use(manual_bytes(owner));}; // expected-error {{after its owner lifetime ended}}
