+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+#include "../CodeGen/Inputs/native-async-task.h"
+int regular() {
+  __objc3_await 1; // expected-error {{native await requires an async Objective-C or Objective-C++20/23 function context}}
+  return 0;
+}
+
+struct Worker {
+  int value(int) const __objc3_async;
+  int operator()(int) const __objc3_async;
+};
+int conditions(Worker &worker) __objc3_async {
+  using Member = int (Worker::*)(int) const __objc3_async;
+  Member member = &Worker::value;
+  // Tentative condition parsing must leave the reserved unary spelling intact.
+  if (__objc3_await (worker.*member)(2) != 42 || __objc3_await worker(3) != 43)
+    return 0;
+  while (__objc3_await worker.value(0)) break;
+  for (; __objc3_await (worker.*member)(0);) break;
+  switch (__objc3_await worker.value(2)) { case 2: break; }
+  __objc3_await (worker.*member)(2);
+  return 42;
+}
