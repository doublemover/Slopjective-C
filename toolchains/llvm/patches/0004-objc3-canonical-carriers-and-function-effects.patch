+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E)) return readCallableInitializer(Cleanups->getSubExpr(), Components, State, Result);
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(E)) return readCallableInitializer(Temporary->getSubExpr(), Components, State, Result);
+    if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(E)) return readCallableInitializer(Binding->getSubExpr(), Components, State, Result);
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
