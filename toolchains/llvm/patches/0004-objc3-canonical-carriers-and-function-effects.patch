diff --git a/clang/test/ObjC3/Sema/carrier-recursive-cxx.cpp b/clang/test/ObjC3/Sema/carrier-recursive-cxx.cpp
new file mode 100644
index 000000000..5d9e25fb2
--- /dev/null
+++ b/clang/test/ObjC3/Sema/carrier-recursive-cxx.cpp
@@ -0,0 +1,73 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+
+struct CopyMove {
+  CopyMove();
+  CopyMove(const CopyMove &);
+  CopyMove(CopyMove &&);
+  ~CopyMove();
+};
+using Inner = __objc3_optional(CopyMove);
+using Outer = __objc3_optional(Inner);
+using Tree = __objc3_result(Outer, Inner);
+
+void recursive_transfers(Tree &source, const Tree &constant) {
+  Tree copied = __objc3_copy(source);
+  Tree moved = __objc3_move(source);
+  Tree copiedConst = __objc3_copy(constant);
+  Tree movedConst = __objc3_move(constant);
+  Outer constructed = __objc3_some(Inner, __objc3_none(CopyMove));
+  (void)copied;
+  (void)moved;
+  (void)copiedConst;
+  (void)movedConst;
+  (void)constructed;
+}
+
+template <class T> void instantiate_transfer(T &source) {
+  T copied = __objc3_copy(source);
+  T moved = __objc3_move(source);
+}
+template void instantiate_transfer<Tree>(Tree &);
+
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete; // expected-note {{explicitly marked deleted here}}
+  MoveOnly(MoveOnly &&);
+  ~MoveOnly();
+};
+using MoveInner = __objc3_optional(MoveOnly);
+using MoveOuter = __objc3_result(int, MoveInner);
+void nested_deleted_copy(MoveOuter &source) {
+  MoveOuter moved = __objc3_move(source);
+  // Both possible selected-arm operations must be legal, even if a caller
+  // happens to know that source currently contains an integer success.
+  MoveOuter copied = __objc3_copy(source); // expected-error {{deleted constructor}}
+}
+
+class PrivateDestructor {
+  ~PrivateDestructor(); // expected-note {{declared private here}}
+};
+using PrivateInner = __objc3_optional(PrivateDestructor);
+using PrivateOuter = __objc3_optional(PrivateInner);
+void inaccessible_nested_destructor() {
+  PrivateOuter value = __objc3_none(PrivateInner); // expected-error {{variable of type 'PrivateDestructor' has private destructor}}
+}
+
+struct DeletedDestructor {
+  ~DeletedDestructor() = delete; // expected-note {{explicitly marked deleted here}}
+};
+using DeletedInner = __objc3_optional(DeletedDestructor);
+void deleted_inactive_destructor() {
+  __objc3_result(int, DeletedInner) value = __objc3_ok(int, DeletedInner, 1); // expected-error {{attempt to use a deleted function}}
+}
+
+using VolatileInner = volatile Inner;
+void nested_volatile_transfer(__objc3_optional(VolatileInner) &source) {
+  auto copied = __objc3_copy(source); // expected-error {{volatile carrier copy and move construction is not supported}}
+}
+
+struct OrdinaryRecord {
+  Inner hidden;
+};
+void record_boundary(__objc3_optional(OrdinaryRecord) &source) {
+  auto copied = __objc3_copy(source); // expected-error {{is not supported in an Objective-C 3 value carrier}}
+}
