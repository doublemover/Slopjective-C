+namespace {
+/// A forward may analysis. Every bit names an acquisition and its owner;
+/// adjacent bits distinguish live and expired values. Assignment kills old
+/// local facts, joins preserve alternatives, and owner destruction/replacement
+/// expires existing aliases without poisoning later acquisitions at that site.
+class BorrowedFlow {
+  struct Origin {
+    const Stmt *Acquisition = nullptr;
+    const VarDecl *Owner = nullptr;
+    const VarDecl *Identity = nullptr;
+    const VarDecl *Pin = nullptr;
+    bool Unstable = false;
+    const Expr *HeldByClosure = nullptr;
+    bool ConsumedByClosure = false;
+    bool SymbolicCallable = false;
+  };
+  using Value = llvm::BitVector;
+  struct Storage {
+    const VarDecl *first = nullptr;
+    const ValueDecl *second = nullptr;
+    // -1 is the variable/field itself; -2 is an unknown array index.
+    int64_t Index = -1;
+    unsigned Parent = 0;
+    bool operator==(const Storage &Other) const {
+      return first == Other.first && second == Other.second &&
+             Index == Other.Index && Parent == Other.Parent;
+    }
+  };
+  struct StorageInfo {
+    static unsigned getHashValue(const Storage &S) {
+      return llvm::hash_combine(S.first, S.second, S.Index, S.Parent);
+    }
+    static bool isEqual(const Storage &A, const Storage &B) { return A == B; }
+  };
+  struct Facts {
+    SmallVector<Value, 16> Values;
+    SmallVector<Value, 16> Effects;
+    SmallVector<Value, 16> OwnerIdentities;
+    SmallVector<Storage, 16> LocalTargets;
+    SmallVector<Value, 16> MayTargets;
+    SmallVector<Value, 4> CapturedValues;
+    SmallVector<Value, 4> CapturedEffects;
+    SmallVector<Value, 4> CapturedReferenceTargets;
+    Value CaptureReady;
+    Value UnownedOwners;
+    SmallVector<Value, 16> EvaluatedValues;
+    SmallVector<Value, 16> EvaluatedEffects;
+    SmallVector<Value, 16> EvaluatedOwners;
+    SmallVector<Value, 16> EvaluatedAcquisitions;
+    Value AcquisitionReady;
+    SmallVector<Storage, 16> EvaluatedTargets;
+    SmallVector<Value, 16> EvaluatedMayTargets;
+    Value EvaluatedReady;
+    // An active pin is an owning snapshot. Same additionally proves that the
+    // source variable has not been reassigned since that snapshot was taken.
+    Value ActivePins, SamePins;
+    bool Reachable = false;
+  };
+  Sema &Actions;
+  ASTContext &Context;
+  Decl *Callable;
+  Stmt *Body;
+  llvm::DenseMap<Storage, unsigned, StorageInfo> Slots;
+  struct PathNode { unsigned Parent = 0; const ValueDecl *Field = nullptr; int64_t Index = -1; };
+  mutable std::vector<PathNode> Paths{{}};
+  mutable llvm::DenseMap<std::pair<unsigned, const ValueDecl *>, unsigned> FieldPaths;
+  mutable llvm::DenseMap<std::pair<unsigned, int64_t>, unsigned> ArrayPaths;
+  struct CallableCapturePath {
+    const VarDecl *Variable = nullptr;
+    SmallVector<PathNode, 4> Components;
+  };
+  struct OwnerSummary {
+    SmallVector<const VarDecl *, 4> Borrowed, Consumed, Invoked, Mutated;
+    SmallVector<CallableCapturePath, 4> InvokedPaths;
+  };
+  llvm::DenseMap<unsigned, CallableCapturePath> SymbolicCallablePaths;
+  mutable SmallVector<unsigned, 4> InvokedCallableTokens;
+  mutable llvm::SmallPtrSet<const Expr *, 8> UnqualifiedCallablePaths;
+  using OwnerSummaryCache = llvm::DenseMap<const Expr *, OwnerSummary>;
+  std::shared_ptr<OwnerSummaryCache> OwnerSummaries = std::make_shared<OwnerSummaryCache>();
+  llvm::DenseMap<const Expr *, SmallVector<const VarDecl *, 4>> FutureBorrowCaptures;
+  llvm::SmallPtrSet<const Expr *, 8> UnstableFutureOwners;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> AcquiredOwnerRoots;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> ConsumedOwnerRoots;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> InvokedCallableCaptures;
+  llvm::SmallPtrSet<const VarDecl *, 16> SummaryCaptures;
+  mutable llvm::SmallPtrSet<const VarDecl *, 16> MutatedCaptures;
+  bool IsOwnerSummary = false;
+  llvm::DenseMap<const Expr *, unsigned> ClosureSlots;
+  llvm::DenseMap<const Expr *, unsigned> ExpressionSlots;
+  llvm::DenseMap<const Expr *, SmallVector<const Expr *, 2>> OwnerEvaluations;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedReferenceCaptures;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedLambdaStorage;
+  llvm::SmallPtrSet<const VarDecl *, 16> InheritedUnownedOwners;
+  llvm::DenseMap<std::pair<const Expr *, unsigned>, unsigned> ClosureLoans;
+  llvm::DenseMap<const VarDecl *, unsigned> OwnerRoots;
+  llvm::DenseMap<Storage, Value, StorageInfo> InheritedValues;
+  llvm::DenseMap<Storage, Value, StorageInfo> InheritedEffects;
+  llvm::DenseMap<const VarDecl *, Value> InheritedOwners;
+  llvm::DenseMap<Storage, Storage, StorageInfo> InheritedTargets;
+  llvm::DenseMap<Storage, SmallVector<Storage, 2>, StorageInfo> InheritedMayTargets;
+  SmallVector<Origin, 16> Origins;
+  llvm::DenseMap<const Stmt *, SmallVector<unsigned, 2>> Acquisitions;
+  llvm::DenseMap<const VarDecl *, unsigned> Pins;
+  llvm::DenseMap<const VarDecl *, const VarDecl *> PinSources;
+  // Opaque runtime payload initializers deliberately have no SourceExpr.
+  // Their native condition/match owners retain the snapshot association.
+  llvm::DenseMap<const VarDecl *, const VarDecl *> BindingSnapshots;
+  llvm::DenseMap<const VarDecl *, const Expr *> MatchSources;
+  llvm::SmallPtrSet<const Stmt *, 32> Diagnosed;
+  llvm::SmallPtrSet<const Stmt *, 16> UnstableDiagnosed;
+  SmallVector<ParmVarDecl *, 8> Parameters;
+  QualType ReturnType;
+  const ObjCReturnsBorrowedAttr *ReturnContract = nullptr;
+  bool Invalid = false;
+  bool MightBorrow = false;
+
+  bool carriesBorrowedValueImpl(QualType Type,
+      llvm::SmallPtrSetImpl<const clang::Type *> &Seen) const {
+    if (Type.isNull())
+      return false;
+    if (isObjC3BorrowedType(Context, Type))
+      return true;
+    while (true) {
+      QualType Next = Type.getSingleStepDesugaredType(Context);
+      if (Next == Type)
+        break;
+      Type = Next;
+    }
+    if (!Seen.insert(Type.getTypePtr()).second || Type->isFunctionType() ||
+        Type->isBlockPointerType())
+      return false; // Callable signature contracts are metadata, not loans.
+    auto Carries = [&](QualType Payload) {
+      return carriesBorrowedValueImpl(Payload, Seen);
+    };
+    if (Type->isPointerType() || Type->isReferenceType())
+      return Carries(Type->getPointeeType());
+    if (const auto *Array = Context.getAsArrayType(Type))
+      return Carries(Array->getElementType());
+    if (const auto *Optional = Type->getAs<ObjC3OptionalType>())
+      return Carries(Optional->getElementType());
+    if (const auto *Result = Type->getAs<ObjC3ResultType>())
+      return Carries(Result->getSuccessType()) || Carries(Result->getErrorType());
+    if (const auto *Record = Type->getAs<RecordType>())
+      for (const FieldDecl *Field : Record->getDecl()->fields())
+        if (Carries(Field->getType()))
+          return true;
+    return false;
+  }
+  bool carriesBorrowedValue(QualType Type) const {
+    llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+    return carriesBorrowedValueImpl(Type, Seen);
+  }
+  const VarDecl *variable(const Expr *E) const {
+    if (!E)
+      return nullptr;
+    E = E->IgnoreParenCasts();
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(E))
+      return dyn_cast<VarDecl>(Reference->getDecl());
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return variable(Opaque->getSourceExpr());
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return variable(Cleanups->getSubExpr());
+    if (const auto *Temporary = dyn_cast<MaterializeTemporaryExpr>(E))
+      return variable(Temporary->getSubExpr());
+    if (const auto *Binding = dyn_cast<CXXBindTemporaryExpr>(E))
+      return variable(Binding->getSubExpr());
+    if (const auto *Comma = dyn_cast<BinaryOperator>(E))
+      if (Comma->getOpcode() == BO_Comma)
+        return variable(Comma->getRHS());
+    return nullptr;
+  }
+  const VarDecl *identity(const VarDecl *Variable) const {
+    llvm::SmallPtrSet<const VarDecl *, 8> Seen;
+    while (Variable && Seen.insert(Variable).second) {
+      if (isa<ParmVarDecl>(Variable) || !Variable->hasLocalStorage())
+        return Variable;
+      // A const owning alias cannot be retargeted. Mutable aliases deliberately
+      // keep their own identity; their initializers are not a flow proof.
+      if (!Variable->getType().isConstQualified() || !Variable->hasInit())
+        return Variable;
+      const VarDecl *Next = variable(Variable->getInit());
+      if (!Next)
+        return Variable;
+      Variable = Next;
+    }
+    return Variable;
+  }
+  unsigned path(Storage Location) const {
+    unsigned Parent = Location.Parent;
+    if (Location.second) {
+      auto Key = std::make_pair(Parent, Location.second);
+      auto [It, Inserted] = FieldPaths.try_emplace(Key, Paths.size());
+      if (Inserted)
+        Paths.push_back({Parent, Location.second, -1});
+      Parent = It->second;
+    }
+    if (Location.Index != -1) {
+      auto Key = std::make_pair(Parent, Location.Index);
+      auto [It, Inserted] = ArrayPaths.try_emplace(Key, Paths.size());
+      if (Inserted)
+        Paths.push_back({Parent, nullptr, Location.Index});
+      Parent = It->second;
+    }
+    return Parent;
+  }
+  Storage fieldStorage(Storage Base, const ValueDecl *Field) const {
+    return {Base.first, Base.first ? Field : nullptr, -1, path(Base)};
+  }
+  Storage indexedStorage(Storage Base, int64_t Index) const {
+    return {Base.first, nullptr, Index, path(Base)};
+  }
+  Storage parentStorage(Storage Location) const {
+    if (!Location.Parent)
+      return {Location.first, nullptr};
+    const PathNode &Node = Paths[Location.Parent];
+    return {Location.first, Node.Field, Node.Index, Node.Parent};
+  }
+  bool pathsMayAlias(unsigned A, unsigned B) const {
+    if (!A || !B)
+      return A == B;
+    const PathNode &L = Paths[A], &R = Paths[B];
+    if (L.Field != R.Field ||
+        (L.Index != R.Index && L.Index != -2 && R.Index != -2))
+      return false;
+    return pathsMayAlias(L.Parent, R.Parent);
+  }
+  bool within(Storage Location, Storage Container) const {
+    if (Location.first != Container.first)
+      return false;
+    unsigned Prefix = path(Container), Current = path(Location);
+    while (Current && !pathsMayAlias(Current, Prefix))
+      Current = Paths[Current].Parent;
+    return pathsMayAlias(Current, Prefix);
+  }
+  QualType pathType(const VarDecl *Root, unsigned Path) const {
+    if (!Root)
+      return {};
+    if (!Path)
+      return Root->getType();
+    const PathNode &Node = Paths[Path];
+    if (Node.Field)
+      return Node.Field->getType();
+    QualType Parent = pathType(Root, Node.Parent);
+    if (const auto *Array = Context.getAsArrayType(Parent))
+      return Array->getElementType();
+    return {};
+  }
+  QualType storageType(Storage Location) const {
+    if (!Location.first)
+      return {};
+    QualType Type = Location.second ? Location.second->getType()
+                                    : pathType(Location.first, Location.Parent);
+    if (Location.Index != -1)
+      if (const auto *Array = Context.getAsArrayType(Type))
+        return Array->getElementType();
+    return Type;
+  }
+  Storage storage(const Expr *E, const Facts *State = nullptr) const {
+    if (!E)
+      return {};
+    E = E->IgnoreParenCasts();
+    if (const VarDecl *Variable = variable(E))
+      return {Variable, nullptr};
+    if (const auto *Member = dyn_cast<MemberExpr>(E)) {
+      Storage Base = Member->isArrow()
+                         ? referent(Member->getBase(), State)
+                         : storage(Member->getBase(), State);
+      return fieldStorage(Base, Member->getMemberDecl());
+    }
+    if (const auto *Subscript = dyn_cast<ArraySubscriptExpr>(E)) {
+      Storage Base = referent(Subscript->getBase(), State);
+      int64_t Index = -2;
+      if (auto Constant = Subscript->getIdx()->getIntegerConstantExpr(Context))
+        if (!Constant->isNegative() && Constant->getActiveBits() <= 63)
+          Index = Constant->getZExtValue();
+      if (Index >= 0 && Base.Index > 0) {
+        if (Index <= INT64_MAX - Base.Index)
+          Index += Base.Index;
+        else
+          Index = -2;
+      }
+      return {Base.first, Base.second, Index, Base.Parent};
+    }
+    if (const auto *Dereference = dyn_cast<UnaryOperator>(E))
+      if (Dereference->getOpcode() == UO_Deref)
+        return referent(Dereference->getSubExpr(), State);
+    return {};
+  }
+  Storage referent(const Expr *E, const Facts *State,
+                   unsigned Depth = 0) const {
+    if (!E || Depth > 32)
+      return {};
+    E = E->IgnoreParenCasts();
+    if (const auto *Address = dyn_cast<UnaryOperator>(E))
+      if (Address->getOpcode() == UO_AddrOf)
+        return storage(Address->getSubExpr(), State);
+    if (const auto *Offset = dyn_cast<BinaryOperator>(E)) {
+      if (Offset->getOpcode() == BO_Add || Offset->getOpcode() == BO_Sub) {
+        Storage Base = referent(Offset->getLHS(), State, Depth + 1);
+        auto Amount = Offset->getRHS()->getIntegerConstantExpr(Context);
+        if (Base.first && Amount && Amount->getSignificantBits() <= 63) {
+          int64_t Delta = Amount->getSExtValue();
+          if (Offset->getOpcode() == BO_Sub)
+            Delta = -Delta;
+          if (Base.Index >= 0 && Delta >= 0 &&
+              Base.Index <= INT64_MAX - Delta)
+            Base.Index += Delta;
+          else
+            Base.Index = -2;
+          return Base;
+        }
+      }
+      if (Offset->getOpcode() == BO_Comma || Offset->isAssignmentOp())
+        return referent(Offset->getRHS(), State, Depth + 1);
+    }
+    if (const auto *Call = dyn_cast<CallExpr>(E))
+      if (Call->getType()->isPointerType() && fillingBuiltin(Call->getDirectCallee()) && Call->getNumArgs())
+        return directFillDestination(Call->getArg(0));
+    Storage Source = storage(E, State);
+    if (E->getType()->isArrayType() && Source.first)
+      return indexedStorage(Source, 0);
+    if (Source.first && State) {
+      auto Found = Slots.find(Source);
+      if (Found != Slots.end()) {
+        Storage Target = State->LocalTargets[Found->second];
+        if (!Target.first && State->MayTargets[Found->second].count() == 1)
+          Target = location(State->MayTargets[Found->second].find_first());
+        return Target;
+      }
+    }
+    if (const VarDecl *V = variable(E))
+      if (V->getType().isConstQualified() && V->hasInit())
+        return referent(V->getInit(), State, Depth + 1);
+    return {};
+  }
+  void addStorage(Storage Location, QualType Type = {}, unsigned Depth = 0) {
+    if (!Location.first || Slots.count(Location))
+      return;
+    Slots[Location] = Slots.size();
+    if (Type.isNull())
+      Type = storageType(Location);
+    if (Type.isNull() || Depth > 32)
+      return;
+    if (const auto *Record = Type->getAs<RecordType>())
+      for (const FieldDecl *Field : Record->getDecl()->fields())
+        addStorage(fieldStorage(Location, Field), Field->getType(), Depth + 1);
+    if (const auto *Array = Context.getAsArrayType(Type)) {
+      addStorage(indexedStorage(Location, -2), Array->getElementType(), Depth + 1);
+      addStorage(indexedStorage(Location, 0), Array->getElementType(), Depth + 1);
+      if (const auto *Constant = dyn_cast<ConstantArrayType>(Array))
+        if (Constant->getSize().getActiveBits() <= 6)
+          for (uint64_t I = 1; I < Constant->getSize().getZExtValue(); ++I)
+            addStorage(indexedStorage(Location, I), Array->getElementType(), Depth + 1);
+    }
+  }
+  void addVariable(const VarDecl *Variable) {
+    addStorage({Variable, nullptr});
+    QualType Type = Variable->getType();
+    MightBorrow |= carriesBorrowedValue(Type) ||
+                   Variable->hasAttr<NoEscapeAttr>();
+    if ((Type->isPointerType() || Type->isObjCObjectPointerType() ||
+         Type->isReferenceType() || Type->isArrayType() || Type->isBlockPointerType()) && !isObjC3BorrowedType(Context, Type) &&
+        !OwnerRoots.count(Variable))
+      OwnerRoots[Variable] = OwnerRoots.size();
+    if (const auto *Record = Variable->getType()->getAs<RecordType>())
+      for (const FieldDecl *Field : Record->getDecl()->fields())
+        addStorage({Variable, Field});
+    if (Type->isArrayType()) {
+      addStorage({Variable, nullptr, -2});
+      addStorage({Variable, nullptr, 0});
+      if (const auto *List = dyn_cast_or_null<InitListExpr>(Variable->getInit()))
+        for (unsigned I = 0; I != List->getNumInits(); ++I)
+          addStorage({Variable, nullptr, I});
+    }
+  }
+  void addOrigin(const Stmt *Acquisition, const VarDecl *Owner,
+                 bool Unstable = false, const VarDecl *Pin = nullptr,
+                 const VarDecl *Identity = nullptr, bool ExplicitIdentity = false) {
+    unsigned Index = Origins.size();
+    Origins.push_back({Acquisition, Owner,
+                       ExplicitIdentity ? Identity : identity(Owner),
+                       Pin, Unstable});
+    Acquisitions[Acquisition].push_back(Index);
+  }
+  const Decl *callee(const Expr *E) const {
+    if (const auto *Call = dyn_cast<CallExpr>(E))
+      return Call->getDirectCallee();
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(E))
+      return Message->getMethodDecl();
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
+      return Construction->getConstructor();
+    return nullptr;
+  }
+  const Expr *argument(const Expr *E, unsigned Index) const {
+    if (const auto *Call = dyn_cast<CallExpr>(E))
+      return Index < Call->getNumArgs() ? Call->getArg(Index) : nullptr;
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(E))
+      return Index < Message->getNumArgs() ? Message->getArg(Index) : nullptr;
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(E))
+      return Index < Construction->getNumArgs() ? Construction->getArg(Index) : nullptr;
+    return nullptr;
+  }
+  const Expr *ownerArgument(const Expr *E, unsigned Index) const {
+    if (const auto *Operator = dyn_cast<CXXOperatorCallExpr>(E))
+      if (const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Operator->getDirectCallee()))
+        if (!Method->isStatic())
+          ++Index;
+    return argument(E, Index);
+  }
+  void ownerVariables(const Expr *E, SmallVectorImpl<const VarDecl *> &Owners) const {
+    if (!E)
+      return;
+    E = E->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(E))
+      return ownerVariables(Cleanups->getSubExpr(), Owners);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(E))
+      return ownerVariables(Opaque->getSourceExpr(), Owners);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(E)) {
+      bool Truth;
+      if (!Conditional->getCond()->HasSideEffects(Context) &&
+          Conditional->getCond()->EvaluateAsBooleanCondition(Truth, Context)) {
+        ownerVariables(Truth ? Conditional->getTrueExpr()
+                             : Conditional->getFalseExpr(), Owners);
+      } else {
+        ownerVariables(Conditional->getTrueExpr(), Owners);
+        ownerVariables(Conditional->getFalseExpr(), Owners);
+      }
+      return;
+    }
+    const VarDecl *Owner = variable(E);
+    if (!llvm::is_contained(Owners, Owner))
+      Owners.push_back(Owner);
+  }
+  void collectOwnerEvaluations(const Expr *Owner, const Expr *Invocation) {
+    if (!Owner) return;
+    Owner = Owner->IgnoreParenCasts();
+    if (const auto *Cleanups = dyn_cast<ExprWithCleanups>(Owner))
+      return collectOwnerEvaluations(Cleanups->getSubExpr(), Invocation);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Owner))
+      return collectOwnerEvaluations(Opaque->getSourceExpr(), Invocation);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Owner)) {
+      collectOwnerEvaluations(Conditional->getTrueExpr(), Invocation);
+      collectOwnerEvaluations(Conditional->getFalseExpr(), Invocation);
+      return;
+    }
+    if (const auto *Binary = dyn_cast<BinaryOperator>(Owner))
+      if (Binary->getOpcode() == BO_Comma)
+        return collectOwnerEvaluations(Binary->getRHS(), Invocation);
+    if (isa<DeclRefExpr>(Owner))
+      OwnerEvaluations[Owner].push_back(Invocation);
+  }
+  void collectBindings(const Stmt *Node) {
+    if (!Node || isa<BlockExpr>(Node))
+      return;
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Node)) {
+      for (const Expr *Initializer : Lambda->capture_inits())
+        collectBindings(Initializer);
+      return;
+    }
+    if (const auto *Binding = dyn_cast<ObjC3BindingCondition>(Node))
+      BindingSnapshots[Binding->getBindingDecl()] = Binding->getSnapshotDecl();
+    if (const auto *Match = dyn_cast<ObjC3MatchStmt>(Node))
+      for (unsigned I = 0; I != Match->getNumArms(); ++I)
+        if (const VarDecl *Binding = Match->getArm(I)->getBindingDecl())
+          MatchSources[Binding] = Match->getScrutinee();
+    if (const auto *Match = dyn_cast<ObjC3MatchExpr>(Node))
+      for (unsigned I = 0; I != Match->getNumArms(); ++I)
+        if (const VarDecl *Binding = Match->getArm(I)->getBindingDecl())
+          MatchSources[Binding] = Match->getScrutinee();
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Node))
+      if (const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl()))
+        addVariable(Variable);
+    if (const auto *Lifetime = dyn_cast<ObjC3LifetimeStmt>(Node)) {
+      const VarDecl *Binding = Lifetime->getBindingDecl();
+      if (!Pins.count(Binding))
+        Pins[Binding] = Pins.size();
+      PinSources[Binding] = variable(Lifetime->getOperand());
+    }
+    if (const auto *Declaration = dyn_cast<DeclStmt>(Node))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *V = dyn_cast<VarDecl>(D))
+          addVariable(V);
+    for (const Stmt *Child : Node->children())
+      collectBindings(Child);
+  }
+  bool statementMayBorrow(const Stmt *Node) const {
+    if (!Node) return false;
+    if (const auto *Expression = dyn_cast<Expr>(Node))
+      if (carriesBorrowedValue(Expression->getType())) return true;
+    for (const Stmt *Child : Node->children())
+      if (statementMayBorrow(Child)) return true;
+    return false;
+  }
+  void collect(const Stmt *Node, const Stmt *Scope) {
+    if (!Node)
+      return;
+    if (const auto *Lifetime = dyn_cast<ObjC3LifetimeStmt>(Node)) {
+      const VarDecl *Binding = Lifetime->getBindingDecl();
+      if (!Pins.count(Binding))
+        Pins[Binding] = Pins.size();
+      PinSources[Binding] = variable(Lifetime->getOperand());
+    }
+    if (const auto *Declaration = dyn_cast<DeclStmt>(Node))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *V = dyn_cast<VarDecl>(D))
+          addVariable(V);
+    if (const auto *E = dyn_cast<Expr>(Node)) {
+      MightBorrow |= carriesBorrowedValue(E->getType());
+      if (!isa<BlockExpr, LambdaExpr>(E) && !ExpressionSlots.count(E))
+        ExpressionSlots[E] = ExpressionSlots.size();
+      if (isa<MemberExpr, ArraySubscriptExpr>(E))
+        addStorage(storage(E), E->getType());
+      if (const auto *Contract = getObjC3BorrowedReturnContract(callee(E))) {
+        const Expr *OwnerExpr = ownerArgument(E, Contract->getOwnerIndex());
+        // Snapshot a stable slot load at its evaluation, before subsequent
+        // arguments can replace or consume the binding. The loan is not yet
+        // exposed to user code, but ordinary expiry must already affect it.
+        collectOwnerEvaluations(OwnerExpr, E);
+        SmallVector<const VarDecl *, 2> Owners;
+        ownerVariables(OwnerExpr, Owners);
+        if (Owners.empty())
+          Owners.push_back(nullptr);
+        for (const VarDecl *Owner : Owners) {
+          bool Unstable = !Owner ||
+                          Owner->getType().getObjCLifetime() == Qualifiers::OCL_Weak ||
+                          Owner->getType().getObjCLifetime() == Qualifiers::OCL_ExplicitNone;
+          if (Owner)
+            addVariable(Owner);
+          // Identities are flow facts, independent of the source type's ABI.
+          for (auto [Root, Index] : OwnerRoots) {
+            (void)Index;
+            addOrigin(E, Owner, Unstable, nullptr, Root, true);
+            for (auto [Binding, Source] : PinSources)
+              if (Source)
+                addOrigin(E, Owner, false, Binding, Root, true);
+          }
+          if (Owner && Owner->hasLocalStorage() &&
+              Owner->getType().getObjCLifetime() == Qualifiers::OCL_Strong &&
+              !Owner->hasAttr<ObjCPreciseLifetimeAttr>())
