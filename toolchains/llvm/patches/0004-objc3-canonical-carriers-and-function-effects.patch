+void clang::handleObjC3RetainableFamilyAttr(Sema &S, Decl *D,
+                                          const ParsedAttr &Attribute) {
+  auto Reject = [&](StringRef Message) {
+    S.Diag(Attribute.getLoc(), S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                                  DiagnosticIDs::Error, Message));
+    D->setInvalidDecl();
+  };
+  if (!S.getLangOpts().ObjC3) {
+    Reject("retainable family contracts require Objective-C 3.0");
+    return;
+  }
+  IdentifierInfo *Family = Attribute.getArgAsIdent(0)->getIdentifierInfo();
+  if (Attribute.getKind() == ParsedAttr::AT_ObjCRetainableFamily) {
+    auto *Alias = cast<TypedefNameDecl>(D);
+    QualType Type = Alias->getUnderlyingType();
+    if (Type->isDependentType() || Type->isAtomicType() ||
+        !(Type->isPointerType() || Type->isObjCObjectPointerType()) ||
+        Type->isFunctionPointerType() ||
+        Type.getAddressSpace() != LangAS::Default ||
+        isObjC3BorrowedType(S.Context, Type)) {
+      Reject("retainable family requires a nondependent non-borrowed pointer typedef");
+      return;
+    }
+    const auto *Inherited = getObjC3RetainableFamily(S.Context,
+        S.Context.getTypedefType(ElaboratedTypeKeyword::None, std::nullopt, Alias));
+    if (Inherited && Inherited->getFamily() != Family) {
+      Reject("retainable alias cannot change its inherited family");
+      return;
+    }
+    if (!Alias->hasAttr<ObjCRetainableFamilyAttr>())
+      Alias->addAttr(ObjCRetainableFamilyAttr::Create(S.Context, Family, Attribute));
+    return;
+  }
+  auto *Function = cast<FunctionDecl>(D);
+  const auto *Prototype = Function->getType()->getAs<FunctionProtoType>();
+  if (!Prototype || Function->isDependentContext() ||
+      Function->getDescribedFunctionTemplate() || Function->getNumParams() != 1 ||
+      Prototype->isVariadic() ||
+      (isa<CXXMethodDecl>(Function) && !cast<CXXMethodDecl>(Function)->isStatic()) ||
+      Prototype->getObjC3FunctionEffects().Async ||
+      Prototype->getObjC3FunctionEffects().Throws != ObjC3ThrowsKind::None) {
+    Reject("retainable family operation requires a synchronous nonthrowing nondependent unary function");
+    return;
+  }
+  QualType Parameter = Function->getParamDecl(0)->getType();
+  const auto *ParameterFamily = getObjC3RetainableFamily(S.Context, Parameter);
+  if (!ParameterFamily || ParameterFamily->getFamily() != Family) {
+    Reject("retainable family operation parameter must name the declared family");
+    return;
+  }
+  bool Release = Attribute.getKind() == ParsedAttr::AT_ObjCFamilyRelease;
+  QualType Return = Function->getReturnType();
+  const auto *ReturnFamily = getObjC3RetainableFamily(S.Context, Return);
+  if ((Release && !Return->isVoidType()) ||
+      (!Release && (!ReturnFamily || ReturnFamily->getFamily() != Family ||
+                    !S.Context.hasSameUnqualifiedType(Return, Parameter)))) {
+    Reject("retainable family release must return void; retain/autorelease must return the parameter family type");
+    return;
+  }
+  for (const Attr *Existing : Function->attrs())
+    if (const IdentifierInfo *Name = getObjC3FamilyOperationName(Existing))
+      if (Name != Family || unsigned(Existing->getKind()) !=
+          (Release ? unsigned(attr::ObjCFamilyRelease) :
+           Attribute.getKind() == ParsedAttr::AT_ObjCFamilyRetain ?
+           unsigned(attr::ObjCFamilyRetain) : unsigned(attr::ObjCFamilyAutorelease))) {
+        Reject("retainable family operation cannot change its family or operation");
+        return;
+      }
+  switch (Attribute.getKind()) {
+  case ParsedAttr::AT_ObjCFamilyRetain:
+    if (!Function->hasAttr<ObjCFamilyRetainAttr>())
+      Function->addAttr(ObjCFamilyRetainAttr::Create(S.Context, Family, Attribute));
+    break;
+  case ParsedAttr::AT_ObjCFamilyRelease:
+    if (!Function->hasAttr<ObjCFamilyReleaseAttr>())
+      Function->addAttr(ObjCFamilyReleaseAttr::Create(S.Context, Family, Attribute));
+    break;
+  case ParsedAttr::AT_ObjCFamilyAutorelease:
+    if (!Function->hasAttr<ObjCFamilyAutoreleaseAttr>())
+      Function->addAttr(ObjCFamilyAutoreleaseAttr::Create(S.Context, Family, Attribute));
+    break;
+  default: llvm_unreachable("unexpected retainable family attribute");
+  }
+}
+
+void clang::handleObjC3ResourceTypeAttr(Sema &S, Decl *D,
+                                        const ParsedAttr &Attribute) {
+  auto Reject = [&](SourceLocation Location, StringRef Message) {
+    S.Diag(Location, S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                         DiagnosticIDs::Error, Message));
+    D->setInvalidDecl();
+  };
+  auto *Alias = dyn_cast<TypedefNameDecl>(D);
+  if (!S.getLangOpts().ObjC3 || !Alias) {
+    Reject(Attribute.getLoc(), "resource type contracts require an Objective-C "
+                               "3.0 typedef or using alias");
+    return;
+  }
+  QualType Type = Alias->getUnderlyingType();
+  if (Type->isDependentType() || Type->isAtomicType() ||
+      !(Type->isIntegerType() || Type->isEnumeralType() ||
+        Type->isPointerType()) ||
+      Type->isObjCRetainableType() ||
+      Type.getAddressSpace() != LangAS::Default) {
+    Reject(Attribute.getLoc(), "resource type contracts require a nondependent "
+                               "ordinary integer, enum, or pointer handle");
+    return;
+  }
+  auto Contract = getObjC3ResourceTypeContract(
+      S.Context,
+      S.Context.getTypedefType(ElaboratedTypeKeyword::None, std::nullopt, Alias));
+  if (Attribute.getKind() == ParsedAttr::AT_ObjCResourceFamily) {
+    IdentifierInfo *Family = Attribute.getArgAsIdent(0)->getIdentifierInfo();
+    if (Contract.Family && Contract.Family->getFamily() != Family) {
+      Reject(Attribute.getLoc(),
+             "resource alias cannot change its inherited resource family");
+      return;
+    }
+    if (!Alias->hasAttr<ObjCResourceFamilyAttr>())
+      Alias->addAttr(
+          ObjCResourceFamilyAttr::Create(S.Context, Family, Attribute));
+    return;
+  }
+  Expr *Value = Attribute.getArgAsExpr(0);
+  if (Attribute.getKind() == ParsedAttr::AT_ObjCInvalid) {
+    if (Value->isTypeDependent() || Value->isValueDependent()) {
+      Reject(Value->getExprLoc(),
+             "resource type invalid sentinel must be a nondependent constant");
+      return;
+    }
+    if (!S.getLangOpts().CPlusPlus) {
+      ExprResult Checked = Value;
+      if (S.CheckSingleAssignmentConstraints(Type.getUnqualifiedType(), Checked,
+                                             false, false, false) !=
+          AssignConvertType::Compatible) {
+        Reject(Value->getExprLoc(), "resource type invalid sentinel is "
+                                    "incompatible with the handle type");
+        return;
+      }
+    }
+    ExprResult Converted = S.PerformCopyInitialization(
+        InitializedEntity::InitializeTemporary(Type.getUnqualifiedType()),
+        Value->getExprLoc(), Value);
+    if (Converted.isInvalid()) {
+      D->setInvalidDecl();
+      return;
+    }
+    if (!Converted.get()->isConstantInitializer(S.Context)) {
+      Reject(Value->getExprLoc(),
+             "resource type invalid sentinel must be constant");
+      return;
+    }
+    if (Contract.Invalid &&
+        !sameObjC3ResourceConstant(S.Context, Contract.Invalid->getInvalid(),
+                                   Converted.get())) {
+      Reject(Attribute.getLoc(),
+             "resource alias cannot change its inherited invalid sentinel");
+      return;
+    }
+    if (!Alias->hasAttr<ObjCInvalidAttr>())
+      Alias->addAttr(
+          ObjCInvalidAttr::Create(S.Context, Converted.get(), Attribute));
+    return;
+  }
+  auto *Reference = dyn_cast<DeclRefExpr>(Value->IgnoreParenImpCasts());
+  auto *Function =
+      Reference ? dyn_cast<FunctionDecl>(Reference->getDecl()) : nullptr;
+  const auto *Prototype =
+      Function ? Function->getType()->getAs<FunctionProtoType>() : nullptr;
+  if (!Function || !Prototype || Function->isDependentContext() ||
+      Function->getNumParams() != 1 || Prototype->isVariadic() ||
+      (isa<CXXMethodDecl>(Function) &&
+       !cast<CXXMethodDecl>(Function)->isStatic()) ||
+      (!Prototype->getReturnType()->isVoidType() &&
+       !Prototype->getReturnType()->isScalarType()) ||
+      Prototype->getReturnType()->isObjCRetainableType()) {
+    Reject(Value->getExprLoc(),
+           "requires_cleanup must name a nondependent single-parameter "
+           "function with an ordinary scalar or void result");
+    return;
+  }
+  const auto &Effects = Prototype->getObjC3FunctionEffects();
+  if (Effects.Async || Effects.Throws != ObjC3ThrowsKind::None) {
+    Reject(Value->getExprLoc(),
+           "requires_cleanup callback cannot be async or use checked throws");
+    return;
+  }
+  auto Parameter = InitializedEntity::InitializeParameter(
+      S.Context, Function->getParamDecl(0));
+  auto *Handle =
+      new (S.Context) OpaqueValueExpr(Attribute.getLoc(), Type, VK_LValue);
+  auto *Address = new (S.Context) OpaqueValueExpr(
+      Attribute.getLoc(), S.Context.getPointerType(Type), VK_PRValue);
+  auto CanPass = [&](Expr *Argument) {
+    if (!S.CanPerformCopyInitialization(Parameter, Argument))
+      return false;
+    if (S.getLangOpts().CPlusPlus)
+      return true;
+    ExprResult Converted = Argument;
+    return S.CheckSingleAssignmentConstraints(
+               Function->getParamDecl(0)->getType(), Converted, false, false,
+               false) == AssignConvertType::Compatible;
+  };
+  QualType ParameterType = Function->getParamDecl(0)->getType();
+  bool ByAddress =
+      S.Context.hasSameUnqualifiedType(ParameterType, Address->getType()) &&
+      !S.Context.hasSameUnqualifiedType(ParameterType, Type);
+  Expr *Operand = ByAddress ? Address : Handle;
+  if (!CanPass(Operand)) {
+    if (ByAddress || !CanPass(Address)) {
+      Reject(
+          Value->getExprLoc(),
+          "requires_cleanup callback cannot accept the handle or its address");
+      return;
+    }
+    Operand = Address;
+  }
+  Expr *Arguments[] = {Operand};
+  ExprResult CheckedCall = S.BuildCallExpr(nullptr, Value, Value->getExprLoc(),
+                                           Arguments, Value->getEndLoc());
+  if (CheckedCall.isInvalid()) {
+    D->setInvalidDecl();
+    return;
+  }
+  const auto *Call = dyn_cast<CallExpr>(CheckedCall.get());
+  if (!Call || Call->getArg(0)->IgnoreParenImpCasts() != Operand) {
+    Reject(Value->getExprLoc(), "requires_cleanup callback requires an "
+                                "unsupported temporary or ARC writeback");
+    return;
+  }
+  if (Contract.Cleanup &&
+      Contract.getCleanupFunction() != Function->getCanonicalDecl()) {
+    Reject(Attribute.getLoc(),
+           "resource alias cannot change its inherited cleanup function");
+    return;
+  }
+  if (!Alias->hasAttr<ObjCRequiresCleanupAttr>()) {
+    Alias->addAttr(
+        ObjCRequiresCleanupAttr::Create(S.Context, Value, Attribute));
+    Function->getCanonicalDecl()->addAttr(
+        ObjCResourceCloseForAttr::CreateImplicit(S.Context, Alias,
+                                                 Attribute.getRange()));
+  }
+}
+
+void clang::handleObjC3CleanupAttr(Sema &S, Decl *D,
+                                   const ParsedAttr &Attribute) {
+  auto Reject = [&](SourceLocation Loc, StringRef Message) {
+    S.Diag(Loc, S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                    DiagnosticIDs::Error, Message));
+    D->setInvalidDecl();
+  };
+  auto *Variable = dyn_cast<VarDecl>(D);
+  if (!S.getLangOpts().ObjC3 || !Variable || !Variable->isLocalVarDecl() ||
+      !Variable->hasLocalStorage() || Variable->hasGlobalStorage()) {
+    Reject(Attribute.getLoc(),
+           "objc_cleanup requires an automatic local in Objective-C 3.0");
+    return;
+  }
+  if (Variable->hasAttr<ObjCCleanupAttr>() ||
+      Variable->hasAttr<CleanupAttr>() ||
+      Variable->hasAttr<ObjCResourceAttr>()) {
+    Reject(Attribute.getLoc(), "a variable may have only one cleanup owner");
+    return;
+  }
+  QualType Type = Variable->getType();
+  if (Type->isDependentType() || Type->isVariablyModifiedType() ||
+      Type->isReferenceType() || Type->isAtomicType() ||
+      Type.getAddressSpace() != LangAS::Default) {
+    Reject(Attribute.getLoc(),
+           "objc_cleanup requires complete nondependent fixed-size storage");
+    return;
+  }
+  if (S.RequireCompleteType(Attribute.getLoc(), Type,
+                            diag::err_typecheck_decl_incomplete_type)) {
+    D->setInvalidDecl();
+    return;
+  }
+  if (Attribute.getNumArgs() != 1 || !Attribute.isArgExpr(0)) {
+    Reject(Attribute.getLoc(), "objc_cleanup requires one cleanup function");
+    return;
+  }
+  Expr *Close = Attribute.getArgAsExpr(0);
+  auto *Reference = dyn_cast<DeclRefExpr>(Close->IgnoreParenImpCasts());
+  auto *Function =
+      Reference ? dyn_cast<FunctionDecl>(Reference->getDecl()) : nullptr;
+  const auto *Prototype =
+      Function ? Function->getType()->getAs<FunctionProtoType>() : nullptr;
+  if (!Function || !Prototype || Function->getNumParams() != 1 ||
+      Prototype->isVariadic() || Function->isDependentContext() ||
+      (isa<CXXMethodDecl>(Function) &&
+       !cast<CXXMethodDecl>(Function)->isStatic()) ||
+      (!Prototype->getReturnType()->isVoidType() &&
+       !Prototype->getReturnType()->isScalarType()) ||
+      Prototype->getReturnType()->isObjCRetainableType()) {
+    Reject(Close->getExprLoc(),
+           "objc_cleanup must name a nondependent function with one parameter "
+           "and an ordinary scalar or void result");
+    return;
+  }
+  const auto &Effects = Prototype->getObjC3FunctionEffects();
+  if (Effects.Async || Effects.Throws != ObjC3ThrowsKind::None) {
+    Reject(Close->getExprLoc(),
+           "objc_cleanup callback cannot be async or use checked throws");
+    return;
+  }
+  auto *Value = DeclRefExpr::Create(
+      S.Context, NestedNameSpecifierLoc{}, SourceLocation(), Variable, false,
+      DeclarationNameInfo(Variable->getDeclName(), Variable->getLocation()),
+      Type, VK_LValue);
+  auto *Address = UnaryOperator::Create(
+      S.Context, Value, UO_AddrOf, S.Context.getPointerType(Type), VK_PRValue,
+      OK_Ordinary, Attribute.getLoc(), false, FPOptionsOverride{});
+  QualType ParameterType = Function->getParamDecl(0)->getType();
+  auto Parameter = InitializedEntity::InitializeParameter(
+      S.Context, Function->getParamDecl(0));
+  auto CanPass = [&](Expr *Argument) {
+    if (Argument == Value && !Type->isScalarType() &&
+        !(ParameterType->isReferenceType() &&
+          S.Context.hasSameUnqualifiedType(ParameterType.getNonReferenceType(),
+                                           Type)))
+      return false; // Do not synthesize record copies or converting
+                    // temporaries.
+    if (!S.CanPerformCopyInitialization(Parameter, Argument))
+      return false;
+    if (S.getLangOpts().CPlusPlus)
+      return true;
+    ExprResult Converted = Argument;
+    return S.CheckSingleAssignmentConstraints(ParameterType, Converted, false,
+                                              false, false) ==
+           AssignConvertType::Compatible;
+  };
+  bool ByAddress =
+      S.Context.hasSameUnqualifiedType(ParameterType, Address->getType()) &&
+      !S.Context.hasSameUnqualifiedType(ParameterType, Type);
+  if (ByAddress ? !CanPass(Address) : !CanPass(Value)) {
+    if (ByAddress || !CanPass(Address)) {
+      Reject(Close->getExprLoc(),
+             "objc_cleanup callback cannot accept the value, a direct "
+             "reference, or its address without record copying");
+      return;
+    }
+    ByAddress = true;
+  }
+  auto *Operand = new (S.Context)
+      OpaqueValueExpr(Attribute.getLoc(), ByAddress ? Address->getType() : Type,
+                      ByAddress ? VK_PRValue : VK_LValue);
+  Expr *Arguments[] = {Operand};
+  ExprResult Call = S.BuildCallExpr(nullptr, Close, Close->getExprLoc(),
+                                    Arguments, Close->getEndLoc());
+  if (Call.isInvalid()) {
+    D->setInvalidDecl();
+    return;
+  }
+  const auto *NativeCall = dyn_cast<CallExpr>(Call.get());
+  if (!NativeCall ||
+      !isa<OpaqueValueExpr>(NativeCall->getArg(0)->IgnoreParenImpCasts())) {
+    Reject(Close->getExprLoc(),
+           "objc_cleanup callback argument requires an unsupported temporary "
+           "or ARC writeback; use a direct value, reference, or address");
+    return;
+  }
+  Variable->addAttr(ObjCCleanupAttr::Create(S.Context, Close, ByAddress,
+                                            Call.get(), Attribute.getRange()));
+  Variable->markUsed(S.Context);
+}
+
+void clang::handleObjC3ResourceAttr(Sema &S, Decl *D,
+                                    const ParsedAttr &Attribute) {
+  auto Reject = [&](SourceLocation Loc, StringRef Message) {
+    S.Diag(Loc, S.getDiagnostics().getDiagnosticIDs()->getCustomDiagID(
+                    DiagnosticIDs::Error, Message));
+    D->setInvalidDecl();
+  };
+  if (!S.getLangOpts().ObjC3) {
+    Reject(Attribute.getLoc(), "objc_resource requires Objective-C 3.0");
+    return;
+  }
+  auto *Variable = dyn_cast<VarDecl>(D);
+  if (!Variable || !Variable->isLocalVarDecl() ||
+      !Variable->hasLocalStorage() || Variable->hasGlobalStorage()) {
+    Reject(Attribute.getLoc(),
+           "objc_resource requires an automatic local variable; resource "
+           "fields and static storage are not supported");
+    return;
+  }
+  if (Variable->hasAttr<ObjCResourceAttr>()) {
+    Reject(Attribute.getLoc(),
+           "a resource variable may have only one objc_resource attribute");
+    return;
+  }
+  if (Variable->hasAttr<CleanupAttr>() ||
+      Variable->hasAttr<ObjCCleanupAttr>()) {
+    Reject(Attribute.getLoc(),
+           "objc_resource and cleanup cannot own the same variable");
+    return;
+  }
+  QualType HandleType = Variable->getType();
+  if (!isResourceHandleType(HandleType)) {
+    Reject(Attribute.getLoc(),
+           "objc_resource requires a mutable nondependent integer, enum, or "
+           "ordinary pointer handle; spell its type explicitly");
+    return;
+  }
+  if (Attribute.getNumArgs() != 2 || !Attribute.isArgExpr(0) ||
+      !Attribute.isArgExpr(1)) {
+    Reject(Attribute.getLoc(),
+           "objc_resource requires both 'close=F' and 'invalid=X'");
+    return;
+  }
+  Expr *Close = Attribute.getArgAsExpr(0);
+  Expr *Invalid = Attribute.getArgAsExpr(1);
+  auto *Reference = dyn_cast<DeclRefExpr>(Close->IgnoreParenImpCasts());
+  auto *Function =
+      Reference ? dyn_cast<FunctionDecl>(Reference->getDecl()) : nullptr;
+  const auto *Prototype =
+      Function ? Function->getType()->getAs<FunctionProtoType>() : nullptr;
+  if (!Function || !Prototype || Function->getNumParams() != 1 ||
+      Prototype->isVariadic() || Function->isDependentContext() ||
+      (isa<CXXMethodDecl>(Function) &&
+       !cast<CXXMethodDecl>(Function)->isStatic()) ||
+      (!Prototype->getReturnType()->isVoidType() &&
+       !Prototype->getReturnType()->isScalarType()) ||
+      Prototype->getReturnType()->isObjCRetainableType() ||
+      !Function->getParamDecl(0)->getType()->isScalarType()) {
+    Reject(Close->getExprLoc(),
+           "objc_resource close must name a nondependent function with one "
+           "scalar parameter and an ordinary scalar or void result; select an "
+           "unambiguous close function");
+    return;
+  }
+  const auto &Effects = Prototype->getObjC3FunctionEffects();
+  if (Effects.Async || Effects.Throws != ObjC3ThrowsKind::None) {
+    Reject(Close->getExprLoc(),
+           "objc_resource close cannot be async or use checked throws; use "
+           "a synchronous native cleanup function");
+    return;
+  }
+
+  // Test ordinary parameter initialization without emitting speculative
+  // diagnostics. Reject C's diagnosed pointer/integer conversion extensions;
+  // they cannot establish a safe close signature for a resource handle.
+  auto *Value = DeclRefExpr::Create(
+      S.Context, NestedNameSpecifierLoc{}, SourceLocation(), Variable, false,
+      DeclarationNameInfo(Variable->getDeclName(), Variable->getLocation()),
+      HandleType, VK_LValue);
+  auto *Address = UnaryOperator::Create(
+      S.Context, Value, UO_AddrOf, S.Context.getPointerType(HandleType),
+      VK_PRValue, OK_Ordinary, Attribute.getLoc(), false, FPOptionsOverride{});
+  auto Parameter = InitializedEntity::InitializeParameter(
+      S.Context, Function->getParamDecl(0));
+  auto CanPass = [&](Expr *Argument) {
+    if (!S.CanPerformCopyInitialization(Parameter, Argument))
+      return false;
+    if (S.getLangOpts().CPlusPlus)
+      return true;
+    ExprResult Converted = Argument;
+    return S.CheckSingleAssignmentConstraints(
+               Function->getParamDecl(0)->getType(), Converted,
+               /*Diagnose=*/false, /*DiagnoseCFAudited=*/false,
+               /*ConvertRHS=*/false) == AssignConvertType::Compatible;
+  };
+  bool ByAddress =
+      S.Context.hasSameUnqualifiedType(Function->getParamDecl(0)->getType(),
+                                       Address->getType()) &&
+      !S.Context.hasSameUnqualifiedType(Function->getParamDecl(0)->getType(),
+                                        HandleType);
+  if (ByAddress ? !CanPass(Address) : !CanPass(Value)) {
+    if (ByAddress || !CanPass(Address)) {
+      Reject(Close->getExprLoc(),
+             "objc_resource close cannot accept the handle value or its "
+             "address; change the close function parameter");
+      return;
+    }
+    ByAddress = true;
+  }
+  // Preserve a checked native call expression, including builtin lowering,
+  // calling convention, parameter conversions and declaration-use diagnostics.
+  // At cleanup time CodeGen binds its opaque operand to the current handle
+  // snapshot (or address), rather than reading a volatile handle twice.
+  QualType OperandType =
+      ByAddress ? Address->getType() : HandleType.getUnqualifiedType();
+  auto *Operand = new (S.Context)
+      OpaqueValueExpr(Attribute.getLoc(), OperandType, VK_PRValue);
+  Expr *Arguments[] = {Operand};
+  ExprResult Call = S.BuildCallExpr(nullptr, Close, Close->getExprLoc(),
+                                    Arguments, Close->getEndLoc());
+  if (Call.isInvalid()) {
+    D->setInvalidDecl();
+    return;
+  }
+  // Normalize the sentinel through native assignment conversion. Its stored
+  // type matches the handle, including integer width and pointer semantics.
+  if (Invalid->isTypeDependent() || Invalid->isValueDependent()) {
+    Reject(Invalid->getExprLoc(),
+           "objc_resource invalid sentinel must be a nondependent constant");
+    return;
+  }
+  if (!S.getLangOpts().CPlusPlus) {
+    ExprResult Checked = Invalid;
+    if (S.CheckSingleAssignmentConstraints(
+            HandleType.getUnqualifiedType(), Checked, /*Diagnose=*/false,
+            /*DiagnoseCFAudited=*/false,
+            /*ConvertRHS=*/false) != AssignConvertType::Compatible) {
+      Reject(Invalid->getExprLoc(),
+             "objc_resource invalid sentinel is not compatible with the "
+             "handle type; cast the constant explicitly");
+      return;
+    }
+  }
+  ExprResult Converted = S.PerformCopyInitialization(
+      InitializedEntity::InitializeTemporary(HandleType.getUnqualifiedType()),
+      Invalid->getExprLoc(), Invalid);
+  if (Converted.isInvalid()) {
+    D->setInvalidDecl();
+    return;
+  }
+  if (!Converted.get()->isConstantInitializer(S.Context)) {
+    Reject(Invalid->getExprLoc(),
+           "objc_resource invalid sentinel must be constant; move runtime "
+           "work into the resource initializer");
+    return;
+  }
+  Variable->addAttr(ObjCResourceAttr::Create(S.Context, Close, Converted.get(),
+                                             ByAddress, Call.get(), Attribute));
+  // The implicit scope-exit action reads this local even without a source use.
+  Variable->markUsed(S.Context);
+}
+
+bool clang::checkObjC3ResourceDeclarations(Sema &S, const Stmt *Body) {
+  if (!S.getLangOpts().ObjC3 || !Body)
+    return false;
+  bool Invalid = false;
+  ObjC3SourceScopes Scopes(Body);
+  for (auto [Variable, Owner] : Scopes.Variables) {
+    (void)Owner;
+    if (const auto *Cleanup = Variable->getAttr<ObjCCleanupAttr>())
+      if (Variable->hasAttr<CleanupAttr>() ||
+          Variable->hasAttr<ObjCResourceAttr>()) {
+        S.Diag(Cleanup->getLocation(),
+               S.getDiagnostics().getCustomDiagID(
+                   DiagnosticsEngine::Error,
+                   "a variable may have only one cleanup owner"));
+        const_cast<VarDecl *>(Variable)->setInvalidDecl();
+        Invalid = true;
+      }
+    const auto *Resource = Variable->getAttr<ObjCResourceAttr>();
+    if (S.getLangOpts().ObjC3Profile == 3 && !Variable->isInvalidDecl()) {
+      auto Contract =
+          getObjC3ResourceTypeContract(S.Context, Variable->getType());
+      const auto *Cleanup = Variable->getAttr<ObjCCleanupAttr>();
+      const auto *Call = Resource  ? cast<CallExpr>(Resource->getCall())
+                         : Cleanup ? cast<CallExpr>(Cleanup->getCall())
+                                   : nullptr;
+      if (Contract.Cleanup && Call &&
+          !acceptsObjC3ResourceCleanup(S.Context, Contract,
+                                       Call->getDirectCallee())) {
+        S.Diag(Variable->getLocation(),
+               S.getDiagnostics().getCustomDiagID(
+                   DiagnosticsEngine::Error,
+                   "cleanup function for resource '%0' is not associated with "
+                   "its type contract or family; use its declared cleanup"))
+            << Variable;
+        const_cast<VarDecl *>(Variable)->setInvalidDecl();
+        Invalid = true;
+      }
+      if (Resource && Contract.Invalid &&
+          !sameObjC3ResourceConstant(S.Context, Resource->getInvalid(),
+                                     Contract.Invalid->getInvalid())) {
+        S.Diag(Variable->getLocation(),
+               S.getDiagnostics().getCustomDiagID(
+                   DiagnosticsEngine::Error,
+                   "resource '%0' uses an invalid sentinel different from its "
+                   "typedef contract"))
+            << Variable;
+        const_cast<VarDecl *>(Variable)->setInvalidDecl();
+        Invalid = true;
+      }
+    }
+    if (!Resource || Variable->isInvalidDecl())
+      continue;
+    if (!Variable->hasInit()) {
+      S.Diag(Variable->getLocation(),
+             S.getDiagnostics().getCustomDiagID(
+                 DiagnosticsEngine::Error,
+                 "resource variable '%0' requires an initializer; initialize "
+                 "it to its invalid sentinel when no resource is owned"))
+          << Variable;
+      const_cast<VarDecl *>(Variable)->setInvalidDecl();
+      Invalid = true;
+    }
+    if (Variable->hasAttr<CleanupAttr>() ||
+        Variable->hasAttr<ObjCCleanupAttr>()) {
+      S.Diag(Resource->getLocation(),
+             S.getDiagnostics().getCustomDiagID(
+                 DiagnosticsEngine::Error,
+                 "objc_resource and cleanup cannot own the same variable"));
+      const_cast<VarDecl *>(Variable)->setInvalidDecl();
+      Invalid = true;
+    }
+  }
+  return Invalid;
+}
