+namespace {
+bool isResourceHandleType(QualType Type) {
+  return !Type.isNull() && !Type->isDependentType() &&
+         (Type->isIntegerType() || Type->isEnumeralType() ||
+          Type->isPointerType()) &&
+         !Type->isObjCRetainableType() && !Type.isConstQualified() &&
+         (Type.getObjCLifetime() == Qualifiers::OCL_None ||
+          Type.getObjCLifetime() == Qualifiers::OCL_ExplicitNone) &&
+         !Type->isAtomicType() && Type.getAddressSpace() == LangAS::Default;
+}
+} // namespace
