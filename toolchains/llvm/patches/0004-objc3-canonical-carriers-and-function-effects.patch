+TEST(ObjC3FunctionEffectImport, PreservesVariableTemplateIdentity) {
+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    const std::string Original =
+        "template<class T=int, int N=40> requires(sizeof(T)>0) "
+        "__attribute__((abi_tag(\"owner\"))) inline constexpr T value=T{N+2};";
+    auto Find = [](ASTContext &Context) {
+      for (auto *D : Context.getTranslationUnitDecl()->decls())
+        if (auto *Pattern = dyn_cast<VarTemplateDecl>(D)) return Pattern;
+      return static_cast<VarTemplateDecl *>(nullptr);
+    };
+    for (const std::string &Changed : {Original,
+         std::string("template<class T=int,int N=40> requires(sizeof(T)>0) "
+                     "__attribute__((abi_tag(\"foreign\"))) inline constexpr T value=T{N+2};"),
+         std::string("template<class T=int,int N=40> requires(sizeof(T)>0) "
+                     "__attribute__((abi_tag(\"owner\"))) inline constexpr T value=T{N+3};"),
+         std::string("template<class T=int,int N=40> requires(sizeof(T)>1) "
+                     "__attribute__((abi_tag(\"owner\"))) inline constexpr T value=T{N+2};")}) {
+      auto From=tooling::buildASTFromCodeWithArgs(Original,{"-xc++",Standard});
+      auto To=tooling::buildASTFromCodeWithArgs(Changed,{"-xc++",Standard});
+      ASSERT_TRUE(From && To);
+      ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+      ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+      auto *Pattern=Find(From->getASTContext());auto *Existing=Find(To->getASTContext());
+      ASSERT_TRUE(Pattern && Existing);
+      StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalent;
+      StructuralEquivalenceContext Equivalence(From->getLangOpts(),From->getASTContext(),
+          To->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+      EXPECT_EQ(Equivalence.IsEquivalent(Pattern,Existing),Changed==Original);
+      ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                           From->getASTContext(),From->getFileManager(),false);
+      auto Result=Importer.Import(Pattern);
+      if (Changed==Original) {
+        ASSERT_TRUE(bool(Result)) << llvm::toString(Result.takeError());
+        EXPECT_EQ(*Result,Existing);
+      } else {
+        EXPECT_FALSE(bool(Result));
+        if (!Result) llvm::consumeError(Result.takeError());
+      }
+    }
+    auto From=tooling::buildASTFromCodeWithArgs(Original,{"-xc++",Standard});
+    auto To=tooling::buildASTFromCodeWithArgs("",{"-xc++",Standard});
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                         From->getASTContext(),From->getFileManager(),false);
+    auto Result=Importer.Import(Find(From->getASTContext()));
+    ASSERT_TRUE(bool(Result)) << llvm::toString(Result.takeError());
+    auto *Imported=cast<VarTemplateDecl>(*Result)->getTemplatedDecl();
+    auto Attributes=Imported->specific_attrs<AbiTagAttr>();
+    EXPECT_EQ(std::distance(Attributes.begin(),Attributes.end()),1);
+    EXPECT_TRUE(Imported->isInline() && Imported->isConstexpr());
+
+    auto ConcreteFrom=tooling::buildASTFromCodeWithArgs(
+        "template<int N> inline int value=N;",{"-xc++",Standard});
+    auto ConcreteTo=tooling::buildASTFromCodeWithArgs(
+        "inline int value=42;",{"-xc++",Standard});
+    ASTImporter Collision(ConcreteTo->getASTContext(),ConcreteTo->getFileManager(),
+                          ConcreteFrom->getASTContext(),ConcreteFrom->getFileManager(),false);
+    auto Conflict=Collision.Import(Find(ConcreteFrom->getASTContext()));
+    EXPECT_FALSE(bool(Conflict));
+    if (!Conflict) llvm::consumeError(Conflict.takeError());
+
+    auto PatternFirstTo=tooling::buildASTFromCodeWithArgs("",{"-xc++",Standard});
+    ASTImporter PatternFirst(PatternFirstTo->getASTContext(),PatternFirstTo->getFileManager(),
+                             ConcreteFrom->getASTContext(),ConcreteFrom->getFileManager(),false);
+    auto Variable=PatternFirst.Import(Find(ConcreteFrom->getASTContext())->getTemplatedDecl());
+    ASSERT_TRUE(bool(Variable)) << llvm::toString(Variable.takeError());
+    auto Template=PatternFirst.Import(Find(ConcreteFrom->getASTContext()));
+    ASSERT_TRUE(bool(Template)) << llvm::toString(Template.takeError());
+    EXPECT_EQ(cast<VarTemplateDecl>(*Template)->getTemplatedDecl(),*Variable);
+  }
+}
