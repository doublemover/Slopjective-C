+QualType ASTContext::getObjC3ResultType(QualType SuccessType,
+                                       QualType ErrorType) const {
+  assert(!SuccessType.isNull() && !ErrorType.isNull() &&
+         "result arm types must be non-null");
+  SuccessType = getCanonicalType(SuccessType);
+  ErrorType = getCanonicalType(ErrorType);
+
+  llvm::FoldingSetNodeID ID;
+  ObjC3ResultType::Profile(ID, SuccessType, ErrorType);
+  void *InsertPos = nullptr;
+  if (ObjC3ResultType *T = ObjC3ResultTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(T, 0);
+
+  auto *T = new (*this, alignof(ObjC3ResultType))
+      ObjC3ResultType(SuccessType, ErrorType);
+  Types.push_back(T);
+  ObjC3ResultTypes.InsertNode(T, InsertPos);
+  return QualType(T, 0);
+}
