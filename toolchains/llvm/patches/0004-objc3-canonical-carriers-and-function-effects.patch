+ExprResult Sema::PrepareObjC3Snapshot(Expr *Source) {
+  if (!getLangOpts().CPlusPlus || !Source->isGLValue() ||
+      Source->isTypeDependent())
+    return Source;
+  QualType Type = Source->getType().getCanonicalType();
+  if (!isa<ObjC3OptionalType, ObjC3ResultType>(Type.getTypePtr()))
+    return Source;
+  // A nested carrier still owns its ultimate C++ leaf. Snapshot each active
+  // level with semantic copy recipes rather than a generic aggregate copy.
+  if (!hasObjC3CarrierCppPayload(Type))
+    return Source;
+  return ActOnObjC3CarrierTransferExpr(false, Source->getExprLoc(),
+                                       Source->getBeginLoc(), Source,
+                                       Source->getEndLoc());
+}
+
+ExprResult Sema::ActOnObjC3BooleanCondition(Scope *ConditionScope, Expr *Value,
+                                            SourceLocation Loc) {
+  if (!Value)
+    return ExprError();
+  ExprResult Checked = CheckPlaceholderExpr(Value);
+  if (Checked.isInvalid())
+    return ExprError();
+  Value = Checked.get();
+  // C comparisons and logical operators have type int even though their
+  // language-defined result is Boolean. Normalize those expressions at this
+  // boundary without admitting arbitrary scalar truth conversions.
+  if (!getLangOpts().CPlusPlus && !Value->isTypeDependent() &&
+      !Value->getType()->isBooleanType() &&
+      Value->isKnownToHaveBooleanValue())
+    Value = ImpCastExprToType(Value, Context.BoolTy, CK_IntegralToBoolean).get();
+  if (!Value->isTypeDependent() &&
+      !Context.getCanonicalType(Value->getType())->isBooleanType()) {
+    Diag(Loc, diag::err_objc3_condition_type) << Value->getType();
+    return ExprError();
+  }
+  ExprResult Boolean = CheckBooleanCondition(Loc, Value);
+  if (Boolean.isInvalid())
+    return ExprError();
+  return ActOnFinishFullExpr(Boolean.get(), Loc, /*DiscardedValue=*/false);
+}
+
+StmtResult
+Sema::ActOnObjC3BindingCondition(Scope *BindingScope, IdentifierInfo *Name,
+                                 SourceLocation NameLoc, bool Mutable,
+                                 SourceLocation KeywordLoc,
+                                 SourceLocation EqualLoc, Expr *Source) {
+  if (!Source || !Name)
+    return StmtError();
+  ExprResult Checked = CheckPlaceholderExpr(Source);
+  if (Checked.isInvalid())
+    return StmtError();
+  Source = Checked.get();
+  QualType OriginalType = Source->getType();
+  bool ReferenceOptional = false;
+  QualType Payload, SourceType;
+  if (Source->isTypeDependent()) {
+    Payload = SourceType = Context.DependentTy;
+  } else if (const auto *Optional = OriginalType->getAs<ObjC3OptionalType>()) {
+    Payload = Optional->getElementType();
+    if (Payload->isVoidType()) {
+      Diag(NameLoc, diag::err_objc3_binding_void_payload);
+      return StmtError();
+    }
+    if (RequireCompleteType(NameLoc, Payload,
+                            diag::err_typecheck_decl_incomplete_type))
+      return StmtError();
+    auto Representation =
+        Context.getObjC3CarrierRepresentationType(OriginalType);
+    if (Representation.State !=
+            ObjC3CarrierRepresentationInfo::Status::Materialized ||
+        !Representation.ValueField) {
+      Diag(NameLoc, diag::err_objc3_carrier_payload_unsupported)
+          << OriginalType;
+      return StmtError();
+    }
+    SourceType = Representation.ValueField->getType();
+  } else if (OriginalType->isObjCRetainableType()) {
+    Payload = SourceType = OriginalType;
+    ReferenceOptional = true;
+  } else {
+    Diag(Source->getExprLoc(), diag::err_objc3_binding_requires_optional)
+        << OriginalType;
+    return StmtError();
+  }
+
+  QualType SnapshotType =
+      OriginalType.getNonReferenceType().getUnqualifiedType();
+  if (getLangOpts().ObjCAutoRefCount && SnapshotType->isObjCRetainableType())
+    SnapshotType =
+        Context.getLifetimeQualifiedType(SnapshotType, Qualifiers::OCL_Strong);
+  SnapshotType = Context.getConstType(SnapshotType);
+  auto *Snapshot = VarDecl::Create(
+      Context, CurContext, NameLoc, NameLoc, nullptr, SnapshotType,
+      Context.getTrivialTypeSourceInfo(SnapshotType, EqualLoc), SC_None);
+  Snapshot->setImplicit();
+  if (getLangOpts().ObjCAutoRefCount && SnapshotType->isObjCRetainableType())
+    Snapshot->addAttr(ObjCPreciseLifetimeAttr::CreateImplicit(Context));
+  ExprResult PreparedSource = PrepareObjC3Snapshot(Source);
+  if (PreparedSource.isInvalid())
+    return StmtError();
+  ExprResult SnapshotInit =
+      PerformCopyInitialization(InitializedEntity::InitializeVariable(Snapshot),
+                                EqualLoc, PreparedSource.get());
+  if (SnapshotInit.isInvalid())
+    return StmtError();
+  ExprResult FullSource = ActOnFinishFullExpr(SnapshotInit.get(), EqualLoc,
+                                              /*DiscardedValue=*/false);
+  if (FullSource.isInvalid())
+    return StmtError();
+  Snapshot->setInit(FullSource.get());
+  // These are real automatic objects, including when the carrier is empty at
+  // runtime. Require accessible destruction in the original use-site context.
+  CheckCompleteVariableDeclaration(Snapshot);
+  if (Snapshot->isInvalidDecl())
+    return StmtError();
+  CurContext->addDecl(Snapshot);
+  auto *SnapshotStatement = new (Context) DeclStmt(
+      DeclGroupRef(Snapshot), Source->getBeginLoc(), Source->getEndLoc());
+
+  Payload = Payload.getUnqualifiedType();
+  if (Payload->isObjCRetainableType()) {
+    if (ReferenceOptional) {
+      (void)AttributedType::stripOuterNullability(Payload);
+      Payload = Context.getAttributedType(attr::TypeNonNull, Payload, Payload);
+    }
+    if (getLangOpts().ObjCAutoRefCount)
+      Payload =
+          Context.getLifetimeQualifiedType(Payload, Qualifiers::OCL_Strong);
+    // Direct references have already been loaded into owned strong snapshot
+    // storage. Their successful path is nonnull; tagged Some(nil) is different.
+    if (ReferenceOptional)
+      SourceType = Payload;
+  }
+  QualType BindingType = Mutable ? Payload : Context.getConstType(Payload);
+  auto *Binding = VarDecl::Create(
+      Context, CurContext, NameLoc, NameLoc, Name, BindingType,
+      Context.getTrivialTypeSourceInfo(BindingType, NameLoc), SC_None);
+  if (getLangOpts().ObjCAutoRefCount && BindingType->isObjCRetainableType())
+    Binding->addAttr(ObjCPreciseLifetimeAttr::CreateImplicit(Context));
+  if (BindingScope) {
+    LookupResult Previous(*this, Name, NameLoc, LookupOrdinaryName);
+    findBindingRedeclaration(*this, Binding, BindingScope, Previous);
+    if (Binding->isInvalidDecl())
+      return StmtError();
+  }
+  auto *Value = new (Context)
+      OpaqueValueExpr(NameLoc, Context.getConstType(SourceType), VK_LValue);
+  ExprResult Prepared = PrepareObjC3Snapshot(Value);
+  if (Prepared.isInvalid())
+    return StmtError();
+  ExprResult Init = PerformCopyInitialization(
+      InitializedEntity::InitializeVariable(Binding), EqualLoc, Prepared.get());
+  if (Init.isInvalid())
+    return StmtError();
+  ExprResult FullInit = ActOnFinishFullExpr(Init.get(), EqualLoc,
+                                            /*DiscardedValue=*/false);
+  if (FullInit.isInvalid())
+    return StmtError();
+  Binding->setInit(FullInit.get());
+  CheckCompleteVariableDeclaration(Binding);
+  if (Binding->isInvalidDecl())
+    return StmtError();
+  if (BindingScope)
+    PushOnScopeChains(Binding, BindingScope);
+  else
+    CurContext->addDecl(Binding);
+  auto *Declaration = new (Context)
+      DeclStmt(DeclGroupRef(Binding), KeywordLoc, Source->getEndLoc());
+  setFunctionHasBranchProtectedScope();
+  return new (Context) ObjC3BindingCondition(SnapshotStatement, Declaration,
+                                             Mutable, KeywordLoc, EqualLoc);
+}
+
+StmtResult Sema::ActOnObjC3GuardStmt(Scope *ParentScope,
+                                     llvm::ArrayRef<Stmt *> Conditions,
+                                     Stmt *ElseBody, SourceLocation KeywordLoc,
+                                     SourceLocation ElseLoc) {
+  if (Conditions.empty() || !isa_and_nonnull<CompoundStmt>(ElseBody))
+    return StmtError();
+  // Check every conflict before restoring any successful binding. Templates
+  // rebuild already-resolved declarations without a live parser lookup scope.
+  if (ParentScope) {
+    bool Invalid = false;
+    for (Stmt *Condition : Conditions)
+      if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition)) {
+        VarDecl *Variable = Binding->getBindingDecl();
+        LookupResult Previous(*this, Variable->getDeclName(),
+                              Variable->getLocation(), LookupOrdinaryName);
+        findBindingRedeclaration(*this, Variable, ParentScope, Previous);
+        Invalid |= Variable->isInvalidDecl();
+      }
+    if (Invalid)
+      return StmtError();
+    for (Stmt *Condition : Conditions)
+      if (auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition))
+        PushOnScopeChains(Binding->getBindingDecl(), ParentScope, false);
+  }
+  setFunctionHasBranchProtectedScope();
+  return ObjC3GuardStmt::Create(Context, Conditions, ElseBody, KeywordLoc,
+                                ElseLoc);
+}
+
+StmtResult Sema::ActOnObjC3IfBindingStmt(llvm::ArrayRef<Stmt *> Conditions,
+                                         Stmt *Then, Stmt *Else,
+                                         SourceLocation IfLoc,
+                                         SourceLocation ElseLoc) {
+  if (Conditions.empty() || !isa_and_nonnull<CompoundStmt>(Then) ||
+      (Else && !isa<CompoundStmt>(Else)))
+    return StmtError();
+  setFunctionHasBranchProtectedScope();
+  return ObjC3IfBindingStmt::Create(Context, Conditions, Then, Else, IfLoc,
+                                    ElseLoc);
+}
+
+// Completed callables provide resolved labels and native source scope owners.
+namespace {
+/// Nullability is a property of a value at its evaluation point, rather than a
+/// permanent change to the declaration's type. In particular, refining a weak
+/// load, a property getter, or a prior call result cannot refine a later load.
+class NullableReceiverFlow {
+  Sema &Actions;
+  ASTContext &Context;
+  llvm::DenseMap<const VarDecl *, unsigned> Variables;
+  llvm::DenseMap<const VarDecl *, const VarDecl *> Aliases;
+  llvm::DenseMap<const Expr *, unsigned> Receivers;
+  llvm::SmallPtrSet<const VarDecl *, 16> Escaped;
+  llvm::SmallPtrSet<const ObjCMessageExpr *, 16> Messages;
+  SmallVector<const ObjCMessageExpr *, 16> OrderedMessages;
+  llvm::SmallPtrSet<const ObjCMessageExpr *, 16> Diagnosed;
+  bool Invalid = false;
+
+  static bool isNullable(QualType Type) {
+    auto Nullability = Type->getNullability();
+    return Nullability && (*Nullability == NullabilityKind::Nullable ||
+                           *Nullability == NullabilityKind::NullableResult);
+  }
+
+  static bool preservesNullness(const CastExpr *Cast) {
+    switch (Cast->getCastKind()) {
+    case CK_NoOp:
+    case CK_LValueToRValue:
+    case CK_BitCast:
+    case CK_CPointerToObjCPointerCast:
+    case CK_BlockPointerToObjCPointerCast:
+    case CK_AnyPointerToBlockPointerCast:
+    case CK_ObjCObjectLValueCast:
+    case CK_BaseToDerived:
+    case CK_DerivedToBase:
+    case CK_UncheckedDerivedToBase:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool nullValue(const Expr *Value) const {
+    if (!Value || Value->isValueDependent())
+      return false;
+    Value = Value->IgnoreParens();
+    if (const auto *Cast = dyn_cast<CastExpr>(Value)) {
+      // Objective-C nil is commonly spelled '(id)0'. The result is a null
+      // pointer value, but is not a C/C++ null pointer *constant* expression.
+      if (Cast->getCastKind() == CK_NullToPointer)
+        return true;
+      if (preservesNullness(Cast))
+        return nullValue(Cast->getSubExpr());
+    }
+    return Value->isNullPointerConstant(Context,
+                                        Expr::NPC_ValueDependentIsNotNull);
+  }
+
+  const VarDecl *variable(const Expr *Value) const {
+    if (!Value)
+      return nullptr;
+    Value = Value->IgnoreParenCasts();
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Value))
+      return variable(Full->getSubExpr());
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Value))
+      return variable(Opaque->getSourceExpr());
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Value)) {
+      const auto *Variable = dyn_cast<VarDecl>(Reference->getDecl());
+      auto Alias = Aliases.find(Variable);
+      return Alias == Aliases.end() ? Variable : Alias->second;
+    }
+    if (const auto *Operation = dyn_cast<BinaryOperator>(Value)) {
+      if (Operation->getOpcode() == BO_Assign)
+        return variable(Operation->getLHS());
+      if (Operation->getOpcode() == BO_Comma)
+        return variable(Operation->getRHS());
+    }
+    if (const auto *Compound = dyn_cast<StmtExpr>(Value))
+      if (!Compound->getSubStmt()->body_empty())
+        return variable(dyn_cast<Expr>(Compound->getSubStmt()->body_back()));
+    return nullptr;
+  }
+
+  void registerVariable(const VarDecl *Variable) {
+    if (!Variable)
+      return;
+    QualType Type = Variable->getType().getNonReferenceType();
+    if (!Type->isObjCRetainableType())
+      return;
+    // A second weak/volatile read need not produce the tested value.
+    if (Type.isVolatileQualified() ||
+        Type.getObjCLifetime() == Qualifiers::OCL_Weak)
+      return;
+    Variables.try_emplace(Variable, Variables.size());
+    if (!Variable->hasLocalStorage() || Variable->hasAttr<BlocksAttr>() ||
+        Variable->getType()->isReferenceType())
+      Escaped.insert(Variable);
+  }
+
+  void escape(const Expr *Value) {
+    if (const VarDecl *Variable = variable(Value)) {
+      registerVariable(Variable);
+      Escaped.insert(Variable);
+      return;
+    }
+    if (!Value)
+      return;
+    Value = Value->IgnoreParenCasts();
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Value)) {
+      escape(Full->getSubExpr());
+      return;
+    }
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Value)) {
+      escape(Opaque->getSourceExpr());
+      return;
+    }
+    // A glvalue conditional can alias either slot. Keep both possible owners
+    // exposed even though the reference itself has only one runtime address.
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Value)) {
+      escape(Conditional->getTrueExpr());
+      escape(Conditional->getFalseExpr());
+    } else if (const auto *Selection = dyn_cast<GenericSelectionExpr>(Value)) {
+      if (!Selection->isResultDependent())
+        escape(Selection->getResultExpr());
+    } else if (const auto *Choice = dyn_cast<ChooseExpr>(Value)) {
+      if (!Choice->isConditionDependent())
+        escape(Choice->getChosenSubExpr());
+    } else if (const auto *Compound = dyn_cast<StmtExpr>(Value)) {
+      if (!Compound->getSubStmt()->body_empty())
+        escape(dyn_cast<Expr>(Compound->getSubStmt()->body_back()));
+    }
+  }
+
+  void collect(const Stmt *Statement) {
+    if (!Statement)
+      return;
+    if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement)) {
+      collect(Argument->getExpr());
+      return;
+    }
+    if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement)) {
+      collect(Initializer->getExpr());
+      return;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+      auto Initializer = Lambda->capture_init_begin();
+      for (const LambdaCapture &Capture : Lambda->captures()) {
+        const Expr *Source = *Initializer++;
+        if (Capture.capturesVariable() &&
+            Capture.getCaptureKind() == LCK_ByRef) {
+          if (const auto *Variable = dyn_cast<VarDecl>(Capture.getCapturedVar()))
+            Escaped.insert(Variable);
+          else if (const auto *Binding =
+                       dyn_cast<BindingDecl>(Capture.getCapturedVar()))
+            escape(Binding->getBinding());
+          escape(Source);
+        }
+        collect(Source);
+      }
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(Statement)) {
+      for (const BlockDecl::Capture &Capture : Block->getBlockDecl()->captures())
+        if (Capture.isByRef())
+          Escaped.insert(Capture.getVariable());
+      return;
+    }
+    if (const auto *Reference = dyn_cast<DeclRefExpr>(Statement))
+      registerVariable(dyn_cast<VarDecl>(Reference->getDecl()));
+    if (const auto *Declaration = dyn_cast<DeclStmt>(Statement))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(D)) {
+          registerVariable(Variable);
+          if (Variable->getType()->isReferenceType()) {
+            const Expr *Initializer = Variable->getInit();
+            while (const auto *Full = dyn_cast_or_null<ExprWithCleanups>(Initializer))
+              Initializer = Full->getSubExpr();
+            // A reference extending a temporary owns an independent slot.
+            if (!isa_and_nonnull<MaterializeTemporaryExpr>(Initializer)) {
+              if (const VarDecl *Source = variable(Initializer))
+                Aliases.try_emplace(Variable, Source);
+              else
+                escape(Initializer);
+            }
+          }
+          collect(Variable->getInit());
+        }
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Statement))
+      if (Unary->getOpcode() == UO_AddrOf)
+        escape(Unary->getSubExpr());
+    if (const auto *Call = dyn_cast<CallExpr>(Statement)) {
+      // C++ reference arguments can expose storage without an '&' expression.
+      // Inspect value kinds so indirect calls and overloaded operators retain
+      // the same rules as calls to a directly named function.
+      for (const Expr *Argument : Call->arguments())
+        if (Argument->isGLValue())
+          escape(Argument);
+    }
+    if (const auto *Construction = dyn_cast<CXXConstructExpr>(Statement))
+      for (const Expr *Argument : Construction->arguments())
+        if (Argument->isGLValue())
+          escape(Argument);
+    if (const auto *Assembly = dyn_cast<AsmStmt>(Statement))
+      for (unsigned I = 0; I != Assembly->getNumOutputs(); ++I)
+        escape(Assembly->getOutputExpr(I));
+    if (const auto *Message = dyn_cast<ObjCMessageExpr>(Statement))
+      if (const Expr *Receiver = Message->getInstanceReceiver())
+        if (isNullable(Receiver->getType()) ||
+            (Actions.getLangOpts().ObjC3Profile != 0 &&
+             Receiver->getType()->getNullability() != NullabilityKind::NonNull)) {
+          if (Messages.insert(Message).second)
+            OrderedMessages.push_back(Message);
+          Receivers.try_emplace(Receiver, 0);
+        }
+    for (const Stmt *Child : Statement->children())
+      collect(Child);
+  }
+
+  bool nonnull(const Expr *Value, const llvm::BitVector &Facts) const {
+    if (!Value)
+      return false;
+    if (Value->getType()->getNullability() == NullabilityKind::NonNull)
+      return true;
+    Value = Value->IgnoreParens();
+    if (isa<ObjCStringLiteral, ObjCArrayLiteral, ObjCDictionaryLiteral,
+            ObjCBoxedExpr, ObjCProtocolExpr>(Value))
+      return true;
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Value))
+      return nonnull(Full->getSubExpr(), Facts);
+    if (const auto *Cast = dyn_cast<CastExpr>(Value))
+      return preservesNullness(Cast) && nonnull(Cast->getSubExpr(), Facts);
+    if (const auto *Conditional = dyn_cast<AbstractConditionalOperator>(Value))
+      return nonnull(Conditional->getTrueExpr(), Facts) &&
+             nonnull(Conditional->getFalseExpr(), Facts);
+    if (const auto *Operation = dyn_cast<BinaryOperator>(Value))
+      if (Operation->getOpcode() == BO_Assign ||
+          Operation->getOpcode() == BO_Comma)
+        return nonnull(Operation->getRHS(), Facts);
+    if (const auto *Opaque = dyn_cast<OpaqueValueExpr>(Value))
+      return nonnull(Opaque->getSourceExpr(), Facts);
+    if (const auto *Compound = dyn_cast<StmtExpr>(Value))
+      if (!Compound->getSubStmt()->body_empty())
+        return nonnull(dyn_cast<Expr>(Compound->getSubStmt()->body_back()), Facts);
+    if (const VarDecl *Variable = variable(Value)) {
+      auto Found = Variables.find(Variable);
+      return Found != Variables.end() && Facts.test(Found->second);
+    }
+    return false;
+  }
+
+  void assign(const VarDecl *Variable, bool Nonnull,
+              llvm::BitVector &Facts) const {
+    auto Found = Variables.find(Variable);
+    if (Found != Variables.end())
+      Facts[Found->second] = Nonnull;
+  }
+
+  void invalidateEscaped(llvm::BitVector &Facts) const {
+    for (const VarDecl *Variable : Escaped)
+      assign(Variable, false, Facts);
+  }
+
+  void refine(const Expr *Condition, bool Truth,
+              llvm::BitVector &Facts) const {
+    if (!Condition)
+      return;
+    if (const auto *Full = dyn_cast<ExprWithCleanups>(Condition)) {
+      llvm::BitVector Before = Facts;
+      refine(Full->getSubExpr(), Truth, Facts);
+      // The branch tests the previously computed Boolean result. A temporary
+      // destructor can change exposed source storage before the branch runs.
+      if (Full->cleanupsHaveSideEffects())
+        for (const VarDecl *Variable : Escaped) {
+          auto Found = Variables.find(Variable);
+          if (Found != Variables.end() && !Before.test(Found->second))
+            Facts.reset(Found->second);
+        }
+      return;
+    }
+    Condition = Condition->IgnoreParenImpCasts();
+    if (const auto *Unary = dyn_cast<UnaryOperator>(Condition)) {
+      if (Unary->getOpcode() == UO_LNot)
+        refine(Unary->getSubExpr(), !Truth, Facts);
+      return;
+    }
+    if (const auto *Operation = dyn_cast<BinaryOperator>(Condition)) {
+      if ((Operation->getOpcode() == BO_LAnd && Truth) ||
+          (Operation->getOpcode() == BO_LOr && !Truth)) {
+        // A later operand can invalidate a test in an earlier operand. The
+        // CFG's individual short-circuit branches already preserve the safe
+        // facts; do not resurrect an earlier fact at the confluence.
+        if (Operation->HasSideEffects(Context))
+          return;
+        refine(Operation->getLHS(), Truth, Facts);
+        refine(Operation->getRHS(), Truth, Facts);
+        return;
+      }
+      if (Operation->isEqualityOp()) {
+        const Expr *Value = nullptr;
+        if (nullValue(Operation->getRHS()))
+          Value = Operation->getLHS();
+        else if (nullValue(Operation->getLHS()))
+          Value = Operation->getRHS();
+        if (Value) {
+          assign(variable(Value), Truth == (Operation->getOpcode() == BO_NE),
+                 Facts);
+          return;
+        }
+        // Equality to another proved nonnull value is also a null proof. A
+        // side effect between the two loads can change the source storage.
+        if (Truth == (Operation->getOpcode() == BO_EQ) &&
+            !Operation->HasSideEffects(Context)) {
+          bool LeftNonnull = nonnull(Operation->getLHS(), Facts);
+          bool RightNonnull = nonnull(Operation->getRHS(), Facts);
+          if (LeftNonnull)
+            assign(variable(Operation->getRHS()), true, Facts);
+          if (RightNonnull)
+            assign(variable(Operation->getLHS()), true, Facts);
+        }
+      }
+    }
+    if (Condition->getType()->isObjCRetainableType())
+      assign(variable(Condition), Truth, Facts);
+  }
+
+  void diagnose(const ObjCMessageExpr *Message, bool Nonnull) {
+    if (Nonnull || !Messages.contains(Message) ||
+        !Diagnosed.insert(Message).second)
+      return;
+    Invalid |= Actions.getLangOpts().ObjC3Profile != 0;
+  }
+
+  void emitDiagnostics() {
+    bool Strict = Actions.getLangOpts().ObjC3Profile != 0;
+    // CFG blocks and copied cleanup bodies need not be in source order.
+    for (const ObjCMessageExpr *Message : OrderedMessages)
+      if (Diagnosed.contains(Message))
+        Actions.Diag(Message->getInstanceReceiver()->getExprLoc(),
+                     Strict ? diag::err_objc3_nullable_receiver
+                            : diag::warn_objc3_nullable_receiver)
+            << Message->getReceiverRange();
+  }
+
+  void transfer(const CFGBlock &Block, llvm::BitVector &Facts, bool Diagnose) {
+    for (const CFGElement &Element : Block) {
+      auto Statement = Element.getAs<CFGStmt>();
+      if (!Statement) {
+        // Destructors and cleanup functions can write exposed storage too.
+        invalidateEscaped(Facts);
+        continue;
+      }
+      const Stmt *Node = Statement->getStmt();
+      if (const auto *Expression = dyn_cast<Expr>(Node)) {
+        auto Receiver = Receivers.find(Expression);
+        if (Receiver != Receivers.end())
+          Facts[Receiver->second] = nonnull(Expression, Facts);
+      }
+      if (const auto *Message = dyn_cast<ObjCMessageExpr>(Node)) {
+        if (Diagnose && Messages.contains(Message)) {
+          const Expr *Receiver = Message->getInstanceReceiver();
+          auto Saved = Receivers.find(Receiver);
+          diagnose(Message, Saved != Receivers.end()
+                                ? Facts.test(Saved->second)
+                                : nonnull(Receiver, Facts));
+        }
+      }
+      if (const auto *Declaration = dyn_cast<DeclStmt>(Node))
+        for (const Decl *D : Declaration->decls())
+          if (const auto *Variable = dyn_cast<VarDecl>(D))
+            assign(Variable, nonnull(Variable->getInit(), Facts), Facts);
+      if (const auto *Operation = dyn_cast<BinaryOperator>(Node))
+        if (Operation->isAssignmentOp()) {
+          const VarDecl *Target = variable(Operation->getLHS());
+          if (!Variables.count(Target) ||
+              (Target && Target->getType()->isReferenceType()))
+            invalidateEscaped(Facts);
+          assign(Target,
+                 Operation->getOpcode() == BO_Assign &&
+                     nonnull(Operation->getRHS(), Facts), Facts);
+        }
+      if (const auto *Unary = dyn_cast<UnaryOperator>(Node))
+        if (Unary->isIncrementDecrementOp())
+          assign(variable(Unary->getSubExpr()), false, Facts);
+      if (isa<CallExpr, ObjCMessageExpr, CXXConstructExpr, CXXNewExpr,
+              CXXDeleteExpr, ObjCAtThrowStmt, CXXThrowExpr, AsmStmt>(Node))
+        invalidateEscaped(Facts);
+    }
+  }
+
+public:
+  NullableReceiverFlow(Sema &Actions)
+      : Actions(Actions), Context(Actions.Context) {}
+
+  bool check(Decl *Callable, Stmt *Body) {
+    if (const auto *Constructor = dyn_cast_or_null<CXXConstructorDecl>(Callable))
+      for (const CXXCtorInitializer *Initializer : Constructor->inits())
+        collect(Initializer->getInit());
+    collect(Body);
+    if (Messages.empty())
+      return false;
+    CFG::BuildOptions Options;
+    Options.setAllAlwaysAdd();
+    Options.AddEHEdges = true;
+    Options.AddInitializers = true;
+    Options.AddCXXDefaultInitExprInCtors = true;
+    Options.AddImplicitDtors = true;
+    Options.AddTemporaryDtors = true;
+    std::unique_ptr<CFG> Graph = CFG::buildCFG(Callable, Body, &Context, Options);
+    if (!Graph) {
+      // An unmodeled control-flow form cannot establish a proof of nonnull.
+      for (const ObjCMessageExpr *Message : OrderedMessages)
+        diagnose(Message, false);
+      emitDiagnostics();
+      return Invalid;
+    }
+
+    // Save a receiver's loaded value before arguments execute. An argument may
+    // mutate its source variable without changing the already loaded receiver.
+    llvm::SmallPtrSet<const Expr *, 16> Emitted;
+    for (const CFGBlock *Block : *Graph)
+      for (const CFGElement &Element : *Block)
+        if (auto Statement = Element.getAs<CFGStmt>())
+          if (const auto *Expression = dyn_cast<Expr>(Statement->getStmt()))
+            if (Receivers.count(Expression))
+              Emitted.insert(Expression);
+    unsigned NumFacts = Variables.size();
+    SmallVector<const Expr *, 8> Unemitted;
+    for (const auto &Entry : Receivers)
+      if (!Emitted.contains(Entry.first))
+        Unemitted.push_back(Entry.first);
+    for (const Expr *Expression : Unemitted)
+      Receivers.erase(Expression);
+    for (auto &Entry : Receivers)
+      Entry.second = NumFacts++;
+
+    struct State {
+      llvm::BitVector Facts;
+      bool Reachable = false;
+    };
+    std::vector<State> Inputs(Graph->getNumBlockIDs());
+    SmallVector<const CFGBlock *, 16> Work;
+    const CFGBlock *Entry = &Graph->getEntry();
+    llvm::BitVector Initial(NumFacts);
+    // A live method starts with a nonnull receiver. Keep self in the ordinary
+    // mutable-slot lattice so assigning nil invalidates that initial proof.
+    if (const auto *Method = dyn_cast_or_null<ObjCMethodDecl>(Callable))
+      assign(Method->getSelfDecl(), true, Initial);
+    Inputs[Entry->getBlockID()] = {std::move(Initial), true};
+    Work.push_back(Entry);
+    while (!Work.empty()) {
+      const CFGBlock *Block = Work.pop_back_val();
+      llvm::BitVector Output = Inputs[Block->getBlockID()].Facts;
+      transfer(*Block, Output, false);
+      unsigned Index = 0;
+      for (auto Successor : Block->succs()) {
+        const CFGBlock *Next = Successor.getReachableBlock();
+        if (!Next) {
+          ++Index;
+          continue;
+        }
+        llvm::BitVector Edge = Output;
+        const Stmt *Terminator = Block->getTerminatorStmt();
+        bool BooleanBranch =
+            Block->getTerminator().getKind() ==
+                CFGTerminator::ObjC3ConditionBranch ||
+            isa_and_nonnull<IfStmt, ForStmt, WhileStmt, DoStmt,
+                            AbstractConditionalOperator, BinaryOperator,
+                            ChooseExpr>(Terminator);
+        if (Block->succ_size() == 2 && BooleanBranch) {
+          if (const auto *Binding = dyn_cast_or_null<ObjC3BindingCondition>(Terminator)) {
+            // A stable source slot still contains the tested reference after
+            // its snapshot. Weak/volatile storage is excluded by registration;
+            // aliases that can mutate it cannot acquire this source proof.
+            const Expr *Source = Binding->getSource();
+            if (Source->getType()->isObjCRetainableType())
+              if (const VarDecl *Variable = variable(Source))
+                if (!Escaped.contains(Variable))
+                  assign(Variable, Index == 0, Edge);
+          }
+          const Expr *Condition = Block->getLastCondition();
+          if (!Condition)
+            Condition = dyn_cast_or_null<Expr>(Block->getTerminatorCondition());
+          refine(Condition, Index == 0, Edge);
+        }
+        ++Index;
+        State &Input = Inputs[Next->getBlockID()];
+        if (!Input.Reachable) {
+          Input = {std::move(Edge), true};
+          Work.push_back(Next);
+        } else {
+          Edge &= Input.Facts;
+          if (Edge != Input.Facts) {
+            Input.Facts = std::move(Edge);
+            Work.push_back(Next);
+          }
+        }
+      }
+    }
+    for (const CFGBlock *Block : *Graph) {
+      State &Input = Inputs[Block->getBlockID()];
+      if (Input.Reachable)
+        transfer(*Block, Input.Facts, true);
+    }
+    emitDiagnostics();
+    return Invalid;
+  }
+};
+
+struct GuardSourceScope {
+  ObjC3GuardStmt *Guard;
+  const Stmt *Owner;
+};
+void collectGuards(Stmt *Statement, const Stmt *Owner,
+                   SmallVectorImpl<GuardSourceScope> &Guards) {
+  if (!Statement)
+    return;
+  if (auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+    for (Expr *Capture : Lambda->capture_inits())
+      collectGuards(Capture, Owner, Guards);
+    return;
+  }
+  if (isa<BlockExpr>(Statement))
+    return;
+  if (isa<CompoundStmt>(Statement))
+    Owner = Statement;
+  if (auto *Guard = dyn_cast<ObjC3GuardStmt>(Statement))
+    Guards.push_back({Guard, Owner});
+  if (auto *If = dyn_cast<IfStmt>(Statement)) {
+    // An unbraced control body still creates a source lexical region. Its
+    // containing compound cannot serve as the goto-exit boundary.
+    for (Stmt *Child : If->children())
+      collectGuards(Child,
+                    Child == If->getThen() || Child == If->getElse() ? Child
+                                                                     : Owner,
+                    Guards);
+    return;
+  }
+  Stmt *Body = nullptr;
+  if (auto *Loop = dyn_cast<ForStmt>(Statement))
+    Body = Loop->getBody();
+  else if (auto *Loop = dyn_cast<WhileStmt>(Statement))
+    Body = Loop->getBody();
+  else if (auto *Loop = dyn_cast<DoStmt>(Statement))
+    Body = Loop->getBody();
+  else if (auto *Loop = dyn_cast<CXXForRangeStmt>(Statement))
+    Body = Loop->getBody();
+  else if (auto *Loop = dyn_cast<ObjCForCollectionStmt>(Statement))
+    Body = Loop->getBody();
+  else if (auto *Switch = dyn_cast<SwitchStmt>(Statement))
+    Body = Switch->getBody();
+  for (Stmt *Child : Statement->children())
+    collectGuards(Child, Child && Child == Body ? Body : Owner, Guards);
+}
+// Direct local labels can be copied with the body. An address-taken label
+// has one externally observable target and needs a distinct qualified model.
+bool checkDeferredLabelAddresses(Sema &Actions, Stmt *Body) {
+  llvm::SmallPtrSet<const LabelDecl *, 8> DeferredLabels;
+  SmallVector<const AddrLabelExpr *, 8> Addresses;
+  auto Collect = [&](auto &&Self, const Stmt *Statement, bool InDefer) -> void {
+    if (!Statement)
+      return;
+    if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(Statement)) {
+      Self(Self, Argument->getExpr(), InDefer);
+      return;
+    }
+    if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(Statement)) {
+      Self(Self, Initializer->getExpr(), InDefer);
+      return;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(Statement)) {
+      for (const Expr *Capture : Lambda->capture_inits())
+        Self(Self, Capture, InDefer);
+      return;
+    }
+    if (isa<BlockExpr>(Statement))
+      return;
+    InDefer |= isa<DeferStmt>(Statement);
+    if (InDefer)
+      if (const auto *Label = dyn_cast<LabelStmt>(Statement))
+        DeferredLabels.insert(Label->getDecl());
+    if (const auto *Address = dyn_cast<AddrLabelExpr>(Statement))
+      Addresses.push_back(Address);
+    for (const Stmt *Child : Statement->children())
+      Self(Self, Child, InDefer);
+  };
+  Collect(Collect, Body, false);
+  bool Invalid = false;
+  for (const auto *Address : Addresses)
+    if (DeferredLabels.contains(Address->getLabel())) {
+      Invalid = true;
+      Actions.Diag(
+          Address->getExprLoc(),
+          Actions.getDiagnostics().getCustomDiagID(
+              DiagnosticsEngine::Error,
+              "address-taken labels in a deferred body are not supported"));
+    }
+  return Invalid;
+}
+} // namespace
+bool Sema::CheckObjC3Guards(Decl *Callable, Stmt *Body) {
+  if (!getLangOpts().ObjC3 || !Body)
+    return false;
+  if (auto *FunctionTemplate = dyn_cast_or_null<FunctionTemplateDecl>(Callable))
+    Callable = FunctionTemplate->getTemplatedDecl();
+  if (Callable)
+    if (auto *Context = dyn_cast<DeclContext>(Callable))
+      if (Context->isDependentContext())
+        return false;
+  if (getLangOpts().ObjCAutoRefCount) {
+    ObjC3SourceScopes Sources(Body);
+    for (auto [Variable, Owner] : Sources.Variables)
+      if (Sources.CleanupScopes.contains(Owner) &&
+          Context.getBaseElementType(Variable->getType()).getObjCLifetime() ==
+              Qualifiers::OCL_Strong &&
+          !Variable->hasAttr<ObjCPreciseLifetimeAttr>())
+        const_cast<VarDecl *>(Variable)->addAttr(
+            ObjCPreciseLifetimeAttr::CreateImplicit(Context));
+  }
+  SmallVector<GuardSourceScope, 8> Guards;
+  collectGuards(Body, Body, Guards);
+  bool Invalid = checkObjC3ResourceDeclarations(*this, Body);
+  Invalid |= checkObjC3NonlocalJumps(*this, Body);
+  if (!Invalid) Invalid |= checkObjC3ResourceFlow(*this, Callable, Body);
+  Invalid |= checkObjC3BorrowedFlow(*this, Callable, Body);
+  Invalid |= checkDeferredLabelAddresses(*this, Body);
+  Invalid |= NullableReceiverFlow(*this).check(Callable, Body);
+  // Nested guards get their own mandatory-exit diagnostic before an outer
+  // proof needs to consume their CFG. Labels are complete at this point.
+  for (auto Entry : llvm::reverse(Guards)) {
+    auto Result = objc3::proveGuardScopeExit(
+        *this, cast<CompoundStmt>(Entry.Guard->getElse()), Entry.Owner);
+    if (Result == objc3::GuardExitResult::Proven)
+      continue;
+    Invalid = true;
+    Diag(Entry.Guard->getElseLoc(),
+         Result == objc3::GuardExitResult::UnsupportedControlFlow
+             ? diag::err_objc3_guard_exit_unsupported
+             : diag::err_objc3_guard_must_exit);
+  }
+  return Invalid;
+}
+
+DeclStmt *Sema::BuildObjC3LifetimeBinding(Expr *Value, SourceLocation Keyword) {
+  ExprResult Checked = CheckPlaceholderExpr(Value);
+  if (Checked.isInvalid())
+    return nullptr;
+  Value = Checked.get();
+  QualType Type = Value->getType().getNonReferenceType().getUnqualifiedType();
+  if (!Value->isTypeDependent() && !Type->isObjCRetainableType()) {
+    Diag(Value->getExprLoc(),
+         getDiagnostics().getCustomDiagID(
+             DiagnosticsEngine::Error, "explicit lifetime control requires an "
+                                       "Objective-C object or block; got %0"))
+        << Value->getType();
+    return nullptr;
+  }
+  if (getLangOpts().ObjCAutoRefCount && !Value->isTypeDependent())
+    Type = Context.getLifetimeQualifiedType(Type, Qualifiers::OCL_Strong);
+  Type = Context.getConstType(Type);
+  auto *Binding =
+      VarDecl::Create(Context, CurContext, Keyword, Keyword, nullptr, Type,
+                      Context.getTrivialTypeSourceInfo(Type, Keyword), SC_None);
+  Binding->setImplicit();
+  Binding->addAttr(ObjCPreciseLifetimeAttr::CreateImplicit(Context));
+  Binding->addAttr(ObjC3LifetimeBindingAttr::CreateImplicit(Context));
+  ExprResult Init = PerformCopyInitialization(
+      InitializedEntity::InitializeVariable(Binding), Keyword, Value);
+  if (Init.isInvalid())
+    return nullptr;
+  Init = ActOnFinishFullExpr(Init.get(), Keyword, false);
+  if (Init.isInvalid())
+    return nullptr;
+  Binding->setInit(Init.get());
+  CheckCompleteVariableDeclaration(Binding);
+  if (Binding->isInvalidDecl())
+    return nullptr;
+  CurContext->addDecl(Binding);
+  setFunctionHasBranchProtectedScope();
+  return new (Context)
+      DeclStmt(DeclGroupRef(Binding), Keyword, Value->getEndLoc());
+}
+
+StmtResult Sema::BuildObjC3LifetimeStmt(DeclStmt *Binding, Stmt *Body,
+                                        SourceLocation Keyword,
+                                        SourceLocation LParen,
+                                        SourceLocation RParen,
+                                        SourceLocation Semi) {
+  Stmt *Storage = Binding;
+  if (Body) {
+    Stmt *Children[] = {Binding, Body};
+    Storage = CompoundStmt::Create(Context, Children, FPOptionsOverride(),
+                                   Keyword, Body->getEndLoc());
+  }
+  return new (Context)
+      ObjC3LifetimeStmt(Storage, Keyword, LParen, RParen, Semi);
+}
