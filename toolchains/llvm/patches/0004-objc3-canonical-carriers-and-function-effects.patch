diff --git a/clang/test/ObjC3/Sema/lifetime-control.m b/clang/test/ObjC3/Sema/lifetime-control.m
new file mode 100644
index 000000000..53d505ba1
--- /dev/null
+++ b/clang/test/ObjC3/Sema/lifetime-control.m
@@ -0,0 +1,42 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fblocks -fobjc-runtime=gnustep-2.2 -fobjc-arc -fsyntax-only -verify %s
+id produce(void);
+void use(id);
+void valid(id owner, void (^block)(void), int enabled) {
+  keepAlive(owner);
+  withLifetime(produce()) { use(owner); }
+  withLifetime(block) block();
+  if (enabled) keepAlive(owner); else use(owner);
+  for (int n = 0; n != 2; ++n) withLifetime(produce()) {
+    if (enabled) continue;
+    break;
+  }
+  withLifetime((produce(), owner)) { keepAlive(produce()); }
+}
+void invalid(int number, void *pointer) {
+  keepAlive(number); // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+  withLifetime(pointer) {} // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+  keepAlive(use((id)0)); // expected-error {{explicit lifetime control requires an Objective-C object or block}}
+}
+void bypass(id owner) {
+  goto after; // expected-error {{cannot jump from this goto statement to its label}}
+  keepAlive(owner); // expected-note {{jump bypasses initialization of a precise lifetime binding}}
+ after:;
+}
+void enter_body(id owner) {
+  goto inside; // expected-error {{cannot jump from this goto statement to its label}}
+  withLifetime(owner) { // expected-note {{jump bypasses initialization of a precise lifetime binding}}
+   inside: use(owner);
+  }
+}
+void unbraced_siblings(id owner, int enabled) {
+  if (enabled) keepAlive(owner); else { goto done; done:; }
+}
+#ifdef __cplusplus
+template <class T> void dependent(T value) {
+  withLifetime(value) { keepAlive(value); }
+}
+template void dependent<id>(id);
+#endif
