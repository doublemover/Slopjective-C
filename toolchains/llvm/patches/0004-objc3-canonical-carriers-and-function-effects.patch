+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      defer { last(); }
+    }
+    void take_resource() {
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      (void)__builtin_objc3_resource_take(r);
+    }
+    void discard_resource() {
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      __builtin_objc3_resource_discard(r);
+    }
+    void reset_resource() {
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      __builtin_objc3_resource_reset(r, 2);
+    }
+    void reset_invalid() {
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      __builtin_objc3_resource_reset(r, -1);
+    }
+    void implicit_close_throws() {
+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeThrow, invalid=-1))) = 1;
+    }
+    void immediate_close_throws() {
+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeThrow, invalid=-1))) = 1;
+      try { __builtin_objc3_resource_discard(r); }
+      catch (...) { caught(); }
+    }
+    void reset_close_or_replacement_throws() {
+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeThrow, invalid=-1))) = 1;
+      __builtin_objc3_resource_reset(r, replacement());
+    }
+    void failed_initialization() {
+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = acquire();
+    }
+    void close_during_unwind() {
+      defer { first(); }
+      int r __attribute__((objc_resource(close=closeThrow, invalid=-1))) = 1;
+      work();
+    }
+    void by_address() {
+      int r __attribute__((objc_resource(close=closeAddress, invalid=-1))) = 1;
+      __builtin_objc3_resource_discard(r);
+    }
+    void goto_cleanup() {
+      {
+        int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+        goto out;
+      }
+    out: after();
+    }
+    void break_cleanup() {
+      for (;;) {
+        int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+        break;
+      }
+      after();
+    }
+    void continue_cleanup() {
+      do {
+        int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+        continue;
+      } while (false);
+      after();
+    }
+    void independent_callable() {
+      auto operation = [] {
+        int r __attribute__((objc_resource(close=closeResource, invalid=-1))) = 1;
+      };
+    }
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+         "-fexceptions", "-fcxx-exceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  const std::map<std::string, std::set<std::string>> Expected = {
+      {"ordinary_resource", {"init,close,invalidate,"}},
+      {"invalid_resource", {"init,"}},
+      {"interleaved_resource", {"init,last,close,invalidate,first,"}},
+      {"take_resource", {"init,take,invalidate,"}},
+      {"discard_resource", {"init,close,invalidate,discard,"}},
+      {"reset_resource", {"init,close,invalidate,reset,close,invalidate,"}},
+      {"reset_invalid", {"init,close,invalidate,reset,"}},
+      {"implicit_close_throws",
+       {"init,close,invalidate,first,", "init,close,first,unwind,"}},
+      {"immediate_close_throws",
+       {"init,close,invalidate,discard,first,",
+        "init,close,invalidate,caught,first,"}},
+      {"reset_close_or_replacement_throws",
+       {"init,close,invalidate,first,unwind,",
+        "init,close,invalidate,replacement,first,unwind,",
+        "init,close,invalidate,replacement,reset,close,invalidate,first,",
+        "init,close,invalidate,replacement,reset,close,first,unwind,"}},
+      {"failed_initialization",
+       {"acquire,init,close,invalidate,first,", "acquire,first,unwind,"}},
+      {"close_during_unwind",
+       {"init,work,close,invalidate,first,", "init,work,close,first,unwind,",
+        "init,work,close,invalidate,first,unwind,", "init,work,close,terminate,"}},
+      {"by_address", {"init,close,invalidate,discard,"}},
+      {"goto_cleanup", {"init,close,invalidate,after,"}},
+      {"break_cleanup", {"init,close,invalidate,after,"}},
+      {"continue_cleanup", {"init,close,invalidate,after,"}},
+      {"independent_callable", {""}},
+  };
+  ASTContext &Context = AST->getASTContext();
+  auto IsValid = [&](const VarDecl *Variable, const Expr *Value) {
+    Expr::EvalResult Evaluated, Invalid;
+    if (!Value->EvaluateAsInt(Evaluated, Context))
+      return true; // The fixture's acquire/replacement returns an owned value.
+    EXPECT_TRUE(Variable->getAttr<ObjCResourceAttr>()->getInvalid()->EvaluateAsInt(
+        Invalid, Context));
+    return Evaluated.Val.getInt() != Invalid.Val.getInt();
+  };
+  unsigned Cases = 0;
+  for (Decl *D : Context.getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool Markers : {false, true}) {
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = true;
+      Options.AddScopes = Options.AddLifetime = Markers;
+      // Resource actions are mandatory even with ordinary C++ dtor options off.
+      Options.setAllAlwaysAdd();
+      auto Graph = CFG::buildCFG(Function, Function->getBody(), &Context, Options);
+      ASSERT_TRUE(Graph);
+      std::set<std::string> Paths;
+      using Ownership = std::map<const VarDecl *, bool>;
+      std::function<void(const CFGBlock *, std::string, Ownership, unsigned)> Visit =
+          [&](const CFGBlock *Block, std::string Events, Ownership Owned,
+              unsigned Depth) {
+            ASSERT_LT(Depth, 100u);
+            const VarDecl *BranchVariable = nullptr;
+            bool Snapshot = false;
+            for (const CFGElement &Element : *Block) {
+              if (auto Resource = Element.getAs<CFGObjC3ResourceAction>()) {
+                const VarDecl *Variable = Resource->getVarDecl();
+                EXPECT_TRUE(Resource->getCloseFunction());
+                EXPECT_EQ(Function->getName() == "by_address",
+                          Resource->getResourceAttr()->getByAddress());
+                if (Element.getKind() == CFGElement::ObjC3ResourceRead) {
+                  BranchVariable = Variable;
+                  Snapshot = Owned[Variable];
+                } else if (Element.getKind() == CFGElement::ObjC3ResourceClose) {
+                  EXPECT_TRUE(Owned[Variable]);
+                  Events += "close,";
+                } else {
+                  Owned[Variable] = false;
+                  Events += "invalidate,";
+                }
+                continue;
+              }
+              auto Statement = Element.getAs<CFGStmt>();
+              if (!Statement)
+                continue;
+              const Stmt *Node = Statement->getStmt();
+              if (const auto *Declarations = dyn_cast<DeclStmt>(Node)) {
+                for (const Decl *Declaration : Declarations->decls())
+                  if (const auto *Variable = dyn_cast<VarDecl>(Declaration))
+                    if (Variable->hasAttr<ObjCResourceAttr>()) {
+                      Owned[Variable] = IsValid(Variable, Variable->getInit());
+                      Events += "init,";
+                    }
+              } else if (const auto *Resource = dyn_cast<ObjC3ResourceExpr>(Node)) {
+                switch (Resource->getKind()) {
+                case ObjC3ResourceExpr::Kind::Take:
+                  Events += "take,";
+                  break;
+                case ObjC3ResourceExpr::Kind::Discard:
+                  Events += "discard,";
+                  break;
+                case ObjC3ResourceExpr::Kind::Reset:
+                  Owned[Resource->getResourceVariable()] =
+                      IsValid(Resource->getResourceVariable(),
+                              Resource->getReplacement());
+                  Events += "reset,";
+                  break;
+                }
+              } else if (const auto *Call = dyn_cast<CallExpr>(Node)) {
+                if (const FunctionDecl *Callee = Call->getDirectCallee())
+                  Events += Callee->getNameAsString() + ",";
+              }
+            }
+            if (Block->isNativeExceptionExit())
+              Events += "unwind,";
+            if (Block->hasNoReturnElement()) {
+              Paths.insert(Events + "terminate,");
+              return;
+            }
+            if (Block == &Graph->getExit()) {
+              Paths.insert(Events);
+              return;
+            }
+            bool ResourceBranch = Block->getTerminator().getKind() ==
+                                  CFGTerminator::ObjC3ResourceBranch;
+            if (ResourceBranch) {
+              EXPECT_TRUE(BranchVariable);
+              EXPECT_EQ(2u, Block->succ_size());
+              EXPECT_EQ(nullptr, Block->getTerminatorCondition());
+            }
+            unsigned Index = 0;
+            for (const auto &Edge : Block->succs()) {
+              if (!ResourceBranch || Index == (Snapshot ? 0u : 1u))
+                if (const auto *Next = Edge.getReachableBlock())
+                  Visit(Next, Events, Owned, Depth + 1);
+              ++Index;
+            }
+          };
+      Visit(&Graph->getEntry(), "", {}, 0);
+      EXPECT_EQ(Expected.at(Function->getNameAsString()), Paths);
+    }
+    ++Cases;
+  }
+  EXPECT_EQ(Expected.size(), Cases);
+}
