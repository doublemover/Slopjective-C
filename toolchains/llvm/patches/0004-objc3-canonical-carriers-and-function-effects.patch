+      if (!O.Owner)
+        continue;
+      for (const auto &Capture : Captures) {
+        auto Slot = Slots.find({Capture.Variable, nullptr});
+        Value Identity = Capture.Initializer ? ownerIdentity(Capture.Initializer, State)
+            : Slot == Slots.end() ? Value(OwnerRoots.size())
+                                 : State.OwnerIdentities[Slot->second];
