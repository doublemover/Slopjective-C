+  // payload destructors in the user's access context, including empty/inactive
+  // arms and nested carrier trees, without binding a stored member as a
+  // full-expression temporary. Shared payload types need only one check.
+  SmallVector<QualType, 8> Pending{Carrier};
+  llvm::SmallPtrSet<const Type *, 16> Seen;
+  while (!Pending.empty()) {
+    QualType Payload = Pending.pop_back_val();
+    const Type *PayloadTy = Payload.getCanonicalType().getTypePtr();
+    if (!Seen.insert(PayloadTy).second)
+      continue;
+    if (isa<ObjC3OptionalType, ObjC3ResultType>(PayloadTy)) {
+      auto Info = S.Context.getObjC3CarrierRepresentationType(Payload);
+      if (Info.State != ObjC3CarrierRepresentationInfo::Status::Materialized)
+        continue;
+      for (FieldDecl *Field : {Info.ValueField, Info.SuccessField,
+                               Info.ErrorField})
+        if (Field)
+          Pending.push_back(Field->getType());
+      continue;
+    }
+    CXXRecordDecl *RD = Payload->getAsCXXRecordDecl();
+    if (!RD || RD->isDependentContext())
+      continue;
+    CXXDestructorDecl *Dtor = S.LookupDestructor(RD);
+    if (!Dtor) {
+      VD->setInvalidDecl();
+      continue;
+    }
+    if (S.CheckDestructorAccess(VD->getLocation(), Dtor,
+                                S.PDiag(diag::err_access_dtor_var)
+                                    << VD->getDeclName() << Payload) ==
+        Sema::AR_inaccessible)
+      VD->setInvalidDecl();
+    S.MarkFunctionReferenced(VD->getLocation(), Dtor);
+    if (S.DiagnoseUseOfDecl(Dtor, VD->getLocation()))
+      VD->setInvalidDecl();
+  }
