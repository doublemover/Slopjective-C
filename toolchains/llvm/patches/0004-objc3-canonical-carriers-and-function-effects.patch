+          Storage Target = referent(Expression, &State);
+          Value Targets = possibleTargets(Expression, State);
+          if (Targets.any() && !isObjC3BorrowedType(Context, Expression->getType()))
+            V = empty();
+          Value Effects = effects(Expression, State);
+          if (Targets.any() && !isObjC3BorrowedType(Context, Expression->getType())) Effects = empty();
+          State.EvaluatedEffects[Slot] = std::move(Effects);
+          State.EvaluatedValues[Slot] = std::move(V);
+          State.EvaluatedOwners[Slot] = std::move(Owner);
+          State.EvaluatedTargets[Slot] = Target;
+          State.EvaluatedMayTargets[Slot] = std::move(Targets);
