+    if (HasSecondStorage)
+      Info.ErrorField = AddField(PayloadUnion, "__objc3_error", SecondPayload);
+    CompleteRecord(PayloadUnion);
+    Info.PayloadField =
+        AddField(Outer, "__objc3_payload", getCanonicalTagType(PayloadUnion));
+  }
+  CompleteRecord(Outer);
+  Info.Type = getCanonicalTagType(Outer);
+
+  const ASTRecordLayout &OuterLayout = getASTRecordLayout(Outer);
+  Info.TagOffsetBits =
+      OuterLayout.getFieldOffset(Info.TagField->getFieldIndex());
+  if (Info.PayloadField) {
+    const uint64_t PayloadBase =
+        OuterLayout.getFieldOffset(Info.PayloadField->getFieldIndex());
+    const ASTRecordLayout &UnionLayout = getASTRecordLayout(Info.PayloadUnion);
+    if (Info.ValueField)
