@@ -0,0 +1,77 @@
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -std=c++20 -fsyntax-only -verify %s
+
+struct SuccessSource {};
+struct SuccessTarget {
+  SuccessTarget(const SuccessSource &);
+};
+struct ErrorSource {};
+struct ErrorTarget {
+  ErrorTarget(const ErrorSource &);
+};
+struct ExplicitOnly { // expected-note {{candidate constructor (the implicit copy constructor) not viable: no known conversion from 'int' to 'const ExplicitOnly &' for 1st argument}} expected-note {{candidate constructor (the implicit move constructor) not viable: no known conversion from 'int' to 'ExplicitOnly &&' for 1st argument}}
+  explicit ExplicitOnly(int); // expected-note {{explicit constructor is not a candidate}}
+};
+struct MoveOnly {
+  MoveOnly();
+  MoveOnly(const MoveOnly &) = delete; // expected-note 2 {{'MoveOnly' has been explicitly marked deleted here}}
+  MoveOnly(MoveOnly &&);
+};
+
+SuccessSource success_source;
+ErrorSource error_source;
+MoveOnly move_only;
+
+template <class T, class E> using Result = __objc3_result(T, E);
+using SuccessAlias = int;
+using ErrorAlias = int;
+using AliasResult = __objc3_result(SuccessAlias, ErrorAlias);
+using CanonicalResult = Result<int, int>;
+static_assert(__is_same(AliasResult, CanonicalResult),
+              "payload aliases must canonicalize to one Result type");
+
+template <class T, class E> auto make_ok(T value) {
+  return __objc3_ok(T, E, value);
+}
+template <class T, class E> bool is_ok(Result<T, E> value) {
+  return __objc3_is_ok(value);
+}
+
+void native_conversions_and_moves(void) {
+  auto converted_success =
+      __objc3_ok(SuccessTarget, ErrorTarget, success_source);
+  auto converted_error = __objc3_err(SuccessTarget, ErrorTarget, error_source);
+  auto moved_success =
+      __objc3_ok(MoveOnly, int, static_cast<MoveOnly &&>(move_only));
+  auto moved_error =
+      __objc3_err(int, MoveOnly, static_cast<MoveOnly &&>(move_only));
+  AliasResult alias_result =
+      __objc3_ok(SuccessAlias, ErrorAlias, 0);
+  auto instantiated = make_ok<int, int>(1);
+  bool instantiated_tag = is_ok(instantiated);
+  bool zero_success_tag =
+      __objc3_is_ok(__objc3_ok(int, int, 0));
+  (void)converted_success;
+  (void)converted_error;
+  (void)moved_success;
+  (void)moved_error;
+  (void)alias_result;
+  (void)instantiated_tag;
+  (void)zero_success_tag;
+}
+
+void rejects_invalid_initialization(void) {
+  auto copied_success = __objc3_ok(MoveOnly, int, move_only); // expected-error {{call to deleted constructor}}
+  auto copied_error = __objc3_err(int, MoveOnly, move_only); // expected-error {{call to deleted constructor}}
+  auto explicit_success = __objc3_ok(ExplicitOnly, int, 1); // expected-error {{no viable conversion from 'int' to 'ExplicitOnly'}}
+  (void)copied_success;
+  (void)copied_error;
+  (void)explicit_success;
+}
+
+struct Incomplete; // expected-note {{forward declaration of 'Incomplete'}}
+using IncompleteAlias = Incomplete;
+extern Incomplete incomplete_value;
+void incomplete_error_arm_is_checked_even_for_ok(void) {
+  __objc3_ok(int, IncompleteAlias, 0); // expected-error {{incomplete type}}
+}
