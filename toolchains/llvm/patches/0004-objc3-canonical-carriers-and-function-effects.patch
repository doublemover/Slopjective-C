+QualType ASTContext::getObjC3OptionalType(QualType ElementType) const {
+  assert(!ElementType.isNull() && "optional element type must be non-null");
+  ElementType = getCanonicalType(ElementType);
+
+  llvm::FoldingSetNodeID ID;
+  ObjC3OptionalType::Profile(ID, ElementType);
+  void *InsertPos = nullptr;
+  if (ObjC3OptionalType *T =
+          ObjC3OptionalTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(T, 0);
+
+  auto *T = new (*this, alignof(ObjC3OptionalType)) ObjC3OptionalType(ElementType);
+  Types.push_back(T);
+  ObjC3OptionalTypes.InsertNode(T, InsertPos);
+  return QualType(T, 0);
+}
