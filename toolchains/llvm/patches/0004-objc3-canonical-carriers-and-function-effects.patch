+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+
+template <class T> using Maybe = __objc3_optional(T); // expected-error {{payload type 'int[4]' is not supported in an Objective-C 3 value carrier}} expected-error {{payload type 'int &' is not supported in an Objective-C 3 value carrier}}
+template <class T, class E> using Outcome = __objc3_result(T, E); // expected-error {{payload type 'int[2]' is not supported in an Objective-C 3 value carrier}}
+
+struct Forward; // expected-note {{forward declaration of 'Forward'}}
+using DeferredRecord = __objc3_optional(Forward);
+static_assert(sizeof(DeferredRecord) > 0); // expected-error {{invalid application of 'sizeof' to an incomplete type}}
+struct Forward {
+  int value;
+};
+static_assert(sizeof(DeferredRecord) >= sizeof(Forward));
+
+using OptionalVoid = __objc3_optional(void);
+using VoidSuccess = __objc3_result(void, int);
+using VoidBoth = __objc3_result(void, void);
+
+using FunctionPointer = __objc3_optional(int (*)(double));
+using NoncopyableType = __objc3_optional(struct MoveOnly);
+struct MoveOnly {
+  MoveOnly(const MoveOnly &) = delete;
+  MoveOnly(MoveOnly &&) = default;
+  ~MoveOnly();
+};
+
+Maybe<int> dependent_is_deferred;
+Outcome<void, int> dependent_result;
+using InstantiatedOptional = Maybe<long>;
+
+using ArrayPayload =
+    __objc3_optional(int[4]); // expected-error {{payload type 'int[4]' is not supported in an Objective-C 3 value carrier}}
+using FunctionPayload = __objc3_optional( // expected-error {{payload type 'int (double)' is not supported in an Objective-C 3 value carrier}}
+    int(double));
+using ReferencePayload =
+    __objc3_optional(int &); // expected-error {{payload type 'int &' is not supported in an Objective-C 3 value carrier}}
+
+// Type formation does not imply a copy/move/destructor operation or call ABI.
+using NoncopyableResult = __objc3_result(MoveOnly, void);
+
+// Non-type-dependent shapes can be rejected before substitution, while a
+// payload whose shape is unknown remains deferred and is checked on use.
+template <class T> using MaybeArray = __objc3_optional(T[]); // expected-error {{payload type 'T[]' is not supported in an Objective-C 3 value carrier}}
