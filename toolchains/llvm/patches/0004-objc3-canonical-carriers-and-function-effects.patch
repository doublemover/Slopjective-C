+  ThrowsError *effect = effect_noexcept;
+  ThrowsErrorNoexcept *invalid = effect_may_throw; // expected-error {{cannot initialize a variable of type}}
+  (void)ordinary;
+  (void)effect;
+  (void)invalid;
+}
