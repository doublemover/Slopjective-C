--- /dev/null
+++ b/clang/test/ObjC3/Sema/Inputs/borrowed-lambda-captures.h
@@ -0,0 +1,8 @@
+typedef borrowed const char *BorrowedBytes;
+BorrowedBytes bytes(id owner) __attribute__((objc_returns_borrowed(owner_index=0)));
+void use_noescape(const char *pointer __attribute__((noescape)));
+void escape(const char *pointer);
+template<class Work> void sink(Work) {}
+template<class Work> void sync(const Work &work __attribute__((noescape))) { work(); }
+struct BorrowedHolder { const char *pointer; };
+struct BorrowedAddress { const char **pointer; };
diff --git a/clang/test/ObjC3/Sema/borrowed-lambda-captures.mm b/clang/test/ObjC3/Sema/borrowed-lambda-captures.mm
new file mode 100644
index 000000000..151f30bd3
--- /dev/null
+++ b/clang/test/ObjC3/Sema/borrowed-lambda-captures.mm
@@ -0,0 +1,163 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-lambda-captures.h -o %t-arc.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -fobjc3-profile=strict-system -include-pch %t-arc.pch -DFROM_PCH -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++-header -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -emit-pch %S/Inputs/borrowed-lambda-captures.h -o %t-mrc.pch
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fblocks -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-profile=strict-system -include-pch %t-mrc.pch -DFROM_PCH -fsyntax-only -verify %s
+#ifndef FROM_PCH
+#include "Inputs/borrowed-lambda-captures.h"
+#endif
+
+void local_values(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer] {use_noescape(pointer);};
+  pointer=nullptr;
+  auto copy=work;
+  work();
+  copy.operator()();
+  sync(copy);
+}
+void init_values(id owner) {
+  auto work=[pointer=bytes(owner)] {use_noescape(pointer);};
+  work();
+}
+void nested_values(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer] {
+    auto nested=[pointer] {use_noescape(pointer);};
+    nested();
+  };
+  work();
+}
+void record_values(id owner) {
+  BorrowedHolder holder{bytes(owner)};
+  auto work=[holder] {use_noescape(holder.pointer);};
+  holder.pointer=nullptr;
+  work();
+}
+void hidden_alias(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer] {escape(pointer);}; // expected-error {{borrowed pointer escapes}}
+  work();
+}
+void hidden_init_alias(id owner) {
+  auto work=[pointer=bytes(owner)] {escape(pointer);}; // expected-error {{borrowed pointer escapes}}
+  work();
+}
+void escaping_argument(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer] {};
+  sink(work); // expected-error {{borrowed pointer escapes}}
+}
+auto escaping_result(id owner) {
+  const char *pointer=bytes(owner);
+  return [pointer] {}; // expected-error {{borrowed pointer escapes}}
+}
+void reference_capture(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[&pointer] {use_noescape(pointer);}; // expected-error {{C++ lambda reference capture}}
+  work();
+}
+void future_reference(id owner) {
+  const char *pointer=nullptr;
+  auto work=[&pointer] {escape(pointer);};
+  pointer=bytes(owner); // expected-error {{mutation of storage captured by reference}}
+  work();
+}
+void future_address(id owner) {
+  const char *pointer=nullptr;
+  const char **address=&pointer;
+  auto work=[address] {escape(*address);};
+  pointer=bytes(owner); // expected-error {{mutation of storage captured by reference}}
+  work();
+}
+void future_record_address(id owner) {
+  const char *pointer=nullptr;
+  BorrowedAddress holder{&pointer};
+  auto work=[holder] {escape(*holder.pointer);};
+  pointer=bytes(owner); // expected-error {{mutation of storage captured by reference}}
+  work();
+}
+void conditional_reference(id owner,int choose) {
+  const char *pointer=nullptr;
+  if (choose) {auto work=[&pointer] {escape(pointer);};sink(work);}
+  pointer=bytes(owner); // expected-error {{mutation of storage captured by reference}}
+}
+void mutable_capture(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer]() mutable {use_noescape(pointer);};
+  work();
+}
+void generic_capture(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer](auto) {use_noescape(pointer);};
+  work(0);
+}
+void persistent_capture(id owner) {
+  auto work=[owner,pointer=(const char *)nullptr]() mutable {
+    pointer=bytes(owner); // expected-error {{persistent storage in a C++ lambda capture}}
+  };
+  work();
+}
+void persistent_mutable_field(id owner) {
+  struct Value {mutable const char *pointer;};
+  auto work=[owner,value=Value{nullptr}] {
+    value.pointer=bytes(owner); // expected-error {{persistent storage in a C++ lambda capture}}
+  };
+  work();
+}
+#if __has_feature(objc_arc)
+void owning_snapshot(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[owner,pointer] {(void)owner;use_noescape(pointer);};
+  owner=nullptr;
+  work();
+}
+void owning_init_snapshot(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[copy=owner,pointer] {(void)copy;use_noescape(pointer);};
+  owner=nullptr;
+  work();
+}
+void expired_snapshot(id owner) {
+  const char *pointer=bytes(owner);
+  auto work=[pointer] {use_noescape(pointer);};
+  owner=nullptr;
+  work(); // expected-error {{after its owner lifetime ended}}
+}
