+template<typename Derived>
+ExprResult TreeTransform<Derived>::TransformObjC3ResultExpr(ObjC3ResultExpr *E) {
+  TypeSourceInfo *Success = E->getSuccessTypeInfo();
+  TypeSourceInfo *Error = E->getErrorTypeInfo();
+  if (Success) {
+    Success = getDerived().TransformType(Success);
+    if (!Success) return ExprError();
+  }
+  if (Error) {
+    Error = getDerived().TransformType(Error);
+    if (!Error) return ExprError();
+  }
+  ExprResult Payload = getDerived().TransformExpr(E->getPayload());
+  if (Payload.isInvalid()) return ExprError();
+  if (!getDerived().AlwaysRebuild() && Success == E->getSuccessTypeInfo() &&
+      Error == E->getErrorTypeInfo() && Payload.get() == E->getPayload())
+    return E;
+  ParsedType SuccessType = Success ? SemaRef.CreateParsedType(Success->getType(), Success) : ParsedType();
+  ParsedType ErrorType = Error ? SemaRef.CreateParsedType(Error->getType(), Error) : ParsedType();
+  switch (E->getKind()) {
+  case ObjC3ResultExpr::Kind::Ok:
+    return SemaRef.ActOnObjC3ResultOkExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        SuccessType, E->getFirstCommaLoc(), ErrorType, E->getSecondCommaLoc(),
+        Payload.get(), E->getRParenLoc());
+  case ObjC3ResultExpr::Kind::Err:
+    return SemaRef.ActOnObjC3ResultErrExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        SuccessType, E->getFirstCommaLoc(), ErrorType, E->getSecondCommaLoc(),
+        Payload.get(), E->getRParenLoc());
+  case ObjC3ResultExpr::Kind::IsOk:
+    return SemaRef.ActOnObjC3ResultIsOkExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        Payload.get(), E->getRParenLoc());
+  }
+  llvm_unreachable("Invalid ObjC3 Result expression kind");
+}
+
+template<typename Derived>
+ExprResult TreeTransform<Derived>::TransformObjC3OptionalExpr(ObjC3OptionalExpr *E) {
+  TypeSourceInfo *Info = E->getPayloadTypeInfo();
+  if (Info) {
+    Info = getDerived().TransformType(Info);
+    if (!Info) return ExprError();
+  }
+  ExprResult Payload;
+  if (E->getPayload()) {
+    Payload = getDerived().TransformExpr(E->getPayload());
+    if (Payload.isInvalid()) return ExprError();
+  }
+  if (!getDerived().AlwaysRebuild() && Info == E->getPayloadTypeInfo() &&
+      Payload.get() == E->getPayload())
+    return E;
+  ParsedType Type = Info ? SemaRef.CreateParsedType(Info->getType(), Info) : ParsedType();
+  switch (E->getKind()) {
+  case ObjC3OptionalExpr::Kind::Some:
+    return SemaRef.ActOnObjC3OptionalSomeExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        Type, Payload.get(), E->getCommaLoc(), E->getRParenLoc());
+  case ObjC3OptionalExpr::Kind::None:
+    return SemaRef.ActOnObjC3OptionalNoneExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        Type, E->getRParenLoc());
+  case ObjC3OptionalExpr::Kind::HasValue:
+    return SemaRef.ActOnObjC3OptionalHasValueExpr(E->getKeywordLoc(), E->getLParenLoc(),
+        Payload.get(), E->getRParenLoc());
+  }
+  llvm_unreachable("Invalid ObjC3 Optional expression kind");
+}
