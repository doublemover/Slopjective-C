+//===--- ObjC3GuardExitTest.cpp - Native guard exit-proof tests -----------===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/Sema/ObjC3GuardExit.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+using namespace clang;
+namespace {
+const IfStmt *findGuard(const Stmt *S, const CompoundStmt *Current,
+                        const CompoundStmt *&Parent) {
+  if (!S || isa<LambdaExpr, BlockExpr>(S))
+    return nullptr;
+  if (const auto *Compound = dyn_cast<CompoundStmt>(S))
+    Current = Compound;
+  if (const auto *If = dyn_cast<IfStmt>(S))
+    if (If->getElse()) {
+      Parent = Current;
+      return If;
+    }
+  for (const Stmt *Child : S->children())
+    if (auto *Found = findGuard(Child, Current, Parent))
+      return Found;
+  return nullptr;
+}
+} // namespace
+TEST(ObjC3GuardExit, ProvesScopeTransfersAndRejectsLocalFallthrough) {
+  const char *Code = R"cpp(
+extern bool condition;
+@protocol Error @end
+extern id<Error> error;
+[[noreturn]] void stop();
+void pass_return() { if (condition) {} else { return; } }
+void pass_branches() { if (condition) {} else { if (condition) return; else return; } }
+void pass_throw() { if (condition) {} else { throw 1; } }
+void pass_noreturn() { if (condition) {} else { stop(); } }
+void pass_break() { while(condition) { if(condition) {} else { break; } } }
+void pass_continue() { while(condition) { if(condition) {} else { continue; } } }
+void pass_outward_goto() { { if(condition) {} else { goto out; } } out:; }
+void pass_internal_goto() { if(condition) {} else { goto out; out: return; } }
+void pass_loop_then_return() { if(condition) {} else { for(int i=0;i<3;++i) {} return; } }
+void pass_objc_throw() { if(condition) {} else { @throw error; } }
+void pass_objc_pool() { if(condition) {} else { @autoreleasepool { return; } } }
+void pass_checked_throw() throws(id<Error>) { if(condition) {} else { throwError(error); } }
+void fail_objc_caught_throw() { if(condition) {} else { @try { @throw error; } @catch(id ignored) {} } }
+void fail_checked_caught_throw() { if(condition) {} else { handle { throwError(error); } catch(id<Error> ignored) {} } }
+int throwing_value(void) throws(id<Error>);
+[[noreturn]] int throwing_stop(void) throws(id<Error>);
+void pass_checked_handler_returns() { if(condition) {} else { handle { throwError(error); } catch(id<Error> ignored) { return; } } }
+void pass_checked_ignores_native_catch() throws(id<Error>) { if(condition) {} else { try { throwError(error); } catch(...) {} } }
+void pass_native_ignores_checked_catch() { if(condition) {} else { handle { @throw error; } catch(id<Error> ignored) {} } }
+void pass_try_then_return() throws(id<Error>) { if(condition) {} else { (void)tryValue(throwing_value()); return; } }
+void pass_force_then_return() { if(condition) {} else { (void)tryForce(throwing_value()); return; } }
+void fail_try_success_path() throws(id<Error>) { if(condition) {} else { (void)tryValue(throwing_value()); } }
+void fail_optional_swallow() { if(condition) {} else { (void)tryOptional(throwing_value()); } }
+void fail_noreturn_checked_caught() { if(condition) {} else { handle { (void)tryValue(throwing_stop()); } catch(id<Error> ignored) {} } }
+void fail_nested_checked_rethrow() { if(condition) {} else { handle { handle { throwError(error); } catch(id<Error> ignored) { throwError(error); } } catch(id<Error> ignored) {} } }
+void fail_optional_still_native_throws() { if(condition) {} else { try { (void)tryOptional(throwing_value()); return; } catch(...) {} } }
+struct ThrowingCleanup { ~ThrowingCleanup() noexcept(false); };
+struct ThrowingNoReturnCleanup { [[noreturn]] ~ThrowingNoReturnCleanup() noexcept(false); };
+void fail_return_cleanup_caught() { if(condition) {} else { try { ThrowingCleanup value; return; } catch(...) {} } }
+void fail_noreturn_cleanup_caught() { if(condition) {} else { try { ThrowingNoReturnCleanup value; } catch(...) {} } }
+void fail_temporary_cleanup_caught() { if(condition) {} else { try { (void)ThrowingCleanup{}; return; } catch(...) {} } }
+void fail_noreturn_temporary_caught() { if(condition) {} else { try { (void)ThrowingNoReturnCleanup{}; } catch(...) {} } }
+void fail_closed_loop_other_return() { if(condition) {} else { if(condition) return; else while(true) {} } }
+void fail_closed_goto_other_return() { if(condition) {} else { if(condition) return; out: goto out; } }
+void native_cleanup(int *);
+void fail_attribute_cleanup_caught() { if(condition) {} else { try { int value __attribute__((cleanup(native_cleanup))) = 0; return; } catch(...) {} } }
+void fail_unmodeled_defer() { if(condition) {} else { defer { (void)condition; } return; } }
+struct Constructor { Constructor(); ~Constructor() noexcept; };
+struct Polymorphic { virtual ~Polymorphic(); };
+struct Derived : Polymorphic {};
+__attribute__((objc_root_class)) @interface Receiver
+- (void)message;
+@end
+void fail_constructor_caught() { if(condition) {} else { try { Constructor value; return; } catch(...) {} } }
+void fail_allocator_caught() { if(condition) {} else { try { (void)new int; return; } catch(...) {} } }
+void fail_reference_cast_caught(Polymorphic &base) { if(condition) {} else { try { (void)dynamic_cast<Derived &>(base); return; } catch(...) {} } }
+void fail_message_caught(Receiver *receiver) { if(condition) {} else { @try { [receiver message]; return; } @catch(...) {} } }
+void fail_pool_cleanup_caught() { if(condition) {} else { @try { @autoreleasepool { return; } } @catch(...) {} } }
+void fail_break_constructor_caught() { while(condition) { if(condition) {} else { try { Constructor value; break; } catch(...) {} } } }
+void fail_goto_constructor_caught() { { if(condition) {} else { try { Constructor value; goto out; } catch(...) {} } } out:; }
+void fail_caught_noreturn() { if(condition) {} else { try { stop(); } catch(...) {} } }
+void pass_constructor_handler_returns() { if(condition) {} else { try { Constructor value; return; } catch(...) { return; } } }
+void pass_destructor_handler_returns() { if(condition) {} else { try { ThrowingCleanup value; return; } catch(...) { return; } } }
+void fail_goto_cleanup_caught() { { if(condition) {} else { try { int value __attribute__((cleanup(native_cleanup))) = 0; goto out; } catch(...) {} } } out:; }
+void fail_empty() { if(condition) {} else {} }
+void fail_one_branch() { if(condition) {} else { if(condition) return; } }
+void fail_same_scope_goto() { if(condition) {} else { goto out; } out:; }
+void fail_internal_goto() { if(condition) {} else { goto out; out:; } }
+void fail_nested_break() { if(condition) {} else { while(condition) { break; } } }
+void fail_switch_break() { if(condition) {} else { switch(0) { default: break; } } }
+void fail_caught_throw() { if(condition) {} else { try { throw 1; } catch(int) {} } }
+void fail_lambda_return() { if(condition) {} else { auto f=[] { return; }; f(); } }
+void fail_conditional_stop() { if(condition) {} else { if(condition) stop(); } }
+void fail_local_infinite_loop() { if(condition) {} else { while(true) {} } }
+)cpp";
+
+  auto AST = tooling::buildASTFromCodeWithArgs(
+      Code,
+      {"-std=c++20", "-x", "objective-c++", "-fobjc-version=3",
+       "-fobjc-runtime=gnustep-2.2", "-fobjc-exceptions", "-fexceptions",
+       "-fblocks"},
+      "guard-proof.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    const CompoundStmt *Parent = nullptr;
+    auto *Guard = findGuard(Function->getBody(), nullptr, Parent);
+    ASSERT_TRUE(Guard);
+    ASSERT_TRUE(Parent);
+    bool Actual = objc3::proveGuardScopeExit(
+                      AST->getSema(), cast<CompoundStmt>(Guard->getElse()),
+                      Parent) == objc3::GuardExitResult::Proven;
+    EXPECT_EQ(Function->getName().starts_with("pass_"), Actual);
+    ++Cases;
+  }
+  EXPECT_EQ(53u, Cases);
+}
diff --git a/clang/include/clang/AST/ObjC3ConditionNodes.inc b/clang/include/clang/AST/ObjC3ConditionNodes.inc
new file mode 100644
index 000000000..3cdf3c3b6
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3ConditionNodes.inc
@@ -0,0 +1,119 @@
+//===--- ObjC3ConditionNodes - Native condition AST ---------------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+/// One optional-binding condition. The initializer's opaque lvalue is bound to
+/// the single evaluated reference or carrier payload on the successful path.
+class ObjC3BindingCondition final : public Stmt {
+  Stmt *Children[2] = {nullptr, nullptr};
+  SourceLocation KeywordLoc, EqualLoc;
+  bool Mutable = false;
+
+public:
+  friend class ASTStmtReader;
+  ObjC3BindingCondition(EmptyShell E) : Stmt(ObjC3BindingConditionClass, E) {}
+  ObjC3BindingCondition(Expr *Source, DeclStmt *Binding, bool Mutable,
+                        SourceLocation Keyword, SourceLocation Equal);
+  Expr *getSource() const;
+  DeclStmt *getBindingStatement() const;
+  VarDecl *getBindingDecl() const;
+  bool isMutableBinding() const { return Mutable; }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getEqualLoc() const { return EqualLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return KeywordLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY;
+  child_range children() { return child_range(Children, Children + 2); }
+  const_child_range children() const {
+    return const_child_range(Children, Children + 2);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3BindingConditionClass;
+  }
+};
+
+/// A guard owns an ordered list of Expr/ObjC3BindingCondition children and one
+/// mandatory else body. Successful declarations belong to the containing scope.
+class ObjC3GuardStmt final
+    : public Stmt,
+      private llvm::TrailingObjects<ObjC3GuardStmt, Stmt *> {
+  friend TrailingObjects;
+  unsigned NumConditions;
+  SourceLocation KeywordLoc, ElseLoc;
+  ObjC3GuardStmt(unsigned N, SourceLocation Keyword, SourceLocation Else)
+      : Stmt(ObjC3GuardStmtClass), NumConditions(N), KeywordLoc(Keyword),
+        ElseLoc(Else) {}
+
+public:
+  friend class ASTStmtReader;
+  static ObjC3GuardStmt *Create(const ASTContext &, llvm::ArrayRef<Stmt *>,
+                                Stmt *ElseBody, SourceLocation Keyword,
+                                SourceLocation Else);
+  static ObjC3GuardStmt *CreateEmpty(const ASTContext &, unsigned);
+  unsigned getNumConditions() const { return NumConditions; }
+  Stmt *getCondition(unsigned I) const {
+    assert(I < NumConditions);
+    return getTrailingObjects()[I];
+  }
+  Stmt *getElse() const { return getTrailingObjects()[NumConditions]; }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getElseLoc() const { return ElseLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return KeywordLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY {
+    return getElse()->getEndLoc();
+  }
+  child_range children() {
+    Stmt **Begin = getTrailingObjects();
+    return child_range(Begin, Begin + NumConditions + 1);
+  }
+  const_child_range children() const {
+    Stmt *const *Begin = getTrailingObjects();
+    return const_child_range(Begin, Begin + NumConditions + 1);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3GuardStmtClass;
+  }
+};
+
+/// Native if-let shares condition semantics; its bindings end with the then
+/// branch and are invisible in else. It never extends their cleanup lifetime.
+class ObjC3IfBindingStmt final
+    : public Stmt,
+      private llvm::TrailingObjects<ObjC3IfBindingStmt, Stmt *> {
+  friend TrailingObjects;
+  unsigned NumConditions;
+  SourceLocation IfLoc, ElseLoc;
+  ObjC3IfBindingStmt(unsigned N, SourceLocation If, SourceLocation Else)
+      : Stmt(ObjC3IfBindingStmtClass), NumConditions(N), IfLoc(If),
+        ElseLoc(Else) {}
+
+public:
+  friend class ASTStmtReader;
+  static ObjC3IfBindingStmt *Create(const ASTContext &, llvm::ArrayRef<Stmt *>,
+                                    Stmt *Then, Stmt *Else, SourceLocation If,
+                                    SourceLocation ElseAt);
+  static ObjC3IfBindingStmt *CreateEmpty(const ASTContext &, unsigned);
+  unsigned getNumConditions() const { return NumConditions; }
+  Stmt *getCondition(unsigned I) const {
+    assert(I < NumConditions);
+    return getTrailingObjects()[I];
+  }
+  Stmt *getThen() const { return getTrailingObjects()[NumConditions]; }
+  Stmt *getElse() const { return getTrailingObjects()[NumConditions + 1]; }
+  SourceLocation getIfLoc() const { return IfLoc; }
+  SourceLocation getElseLoc() const { return ElseLoc; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return IfLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY {
+    return getElse() ? getElse()->getEndLoc() : getThen()->getEndLoc();
+  }
+  child_range children() {
+    Stmt **Begin = getTrailingObjects();
+    return child_range(Begin, Begin + NumConditions + 2);
+  }
+  const_child_range children() const {
+    Stmt *const *Begin = getTrailingObjects();
+    return const_child_range(Begin, Begin + NumConditions + 2);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3IfBindingStmtClass;
+  }
+};
diff --git a/clang/lib/AST/ObjC3ConditionNodes.cpp b/clang/lib/AST/ObjC3ConditionNodes.cpp
new file mode 100644
index 000000000..a17807856
--- /dev/null
+++ b/clang/lib/AST/ObjC3ConditionNodes.cpp
@@ -0,0 +1,65 @@
+//===--- ObjC3ConditionNodes - Native condition AST ---------------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/Stmt.h"
+#include <algorithm>
+using namespace clang;
+
+ObjC3BindingCondition::ObjC3BindingCondition(Expr *Source, DeclStmt *Binding,
+                                             bool Mutable,
+                                             SourceLocation Keyword,
+                                             SourceLocation Equal)
+    : Stmt(ObjC3BindingConditionClass), Children{Source, Binding},
+      KeywordLoc(Keyword), EqualLoc(Equal), Mutable(Mutable) {}
+Expr *ObjC3BindingCondition::getSource() const {
+  return cast<Expr>(Children[0]);
+}
+DeclStmt *ObjC3BindingCondition::getBindingStatement() const {
+  return cast<DeclStmt>(Children[1]);
+}
+VarDecl *ObjC3BindingCondition::getBindingDecl() const {
+  return cast<VarDecl>(getBindingStatement()->getSingleDecl());
+}
+SourceLocation ObjC3BindingCondition::getEndLoc() const {
+  return getSource()->getEndLoc();
+}
+ObjC3GuardStmt *ObjC3GuardStmt::Create(const ASTContext &C,
+                                       llvm::ArrayRef<Stmt *> Conditions,
+                                       Stmt *ElseBody, SourceLocation Keyword,
+                                       SourceLocation Else) {
+  void *Memory = C.Allocate(totalSizeToAlloc<Stmt *>(Conditions.size() + 1),
+                            alignof(ObjC3GuardStmt));
+  auto *Node = new (Memory) ObjC3GuardStmt(Conditions.size(), Keyword, Else);
+  std::copy(Conditions.begin(), Conditions.end(), Node->getTrailingObjects());
+  Node->getTrailingObjects()[Conditions.size()] = ElseBody;
+  return Node;
+}
+ObjC3GuardStmt *ObjC3GuardStmt::CreateEmpty(const ASTContext &C, unsigned N) {
+  void *Memory =
+      C.Allocate(totalSizeToAlloc<Stmt *>(N + 1), alignof(ObjC3GuardStmt));
+  auto *Node = new (Memory) ObjC3GuardStmt(N, {}, {});
+  std::fill_n(Node->getTrailingObjects(), N + 1, nullptr);
+  return Node;
+}
+ObjC3IfBindingStmt *ObjC3IfBindingStmt::Create(
+    const ASTContext &C, llvm::ArrayRef<Stmt *> Conditions, Stmt *Then,
+    Stmt *Else, SourceLocation If, SourceLocation ElseAt) {
+  void *Memory = C.Allocate(totalSizeToAlloc<Stmt *>(Conditions.size() + 2),
+                            alignof(ObjC3IfBindingStmt));
+  auto *Node = new (Memory) ObjC3IfBindingStmt(Conditions.size(), If, ElseAt);
+  std::copy(Conditions.begin(), Conditions.end(), Node->getTrailingObjects());
+  Node->getTrailingObjects()[Conditions.size()] = Then;
+  Node->getTrailingObjects()[Conditions.size() + 1] = Else;
+  return Node;
+}
+ObjC3IfBindingStmt *ObjC3IfBindingStmt::CreateEmpty(const ASTContext &C,
+                                                    unsigned N) {
+  void *Memory =
+      C.Allocate(totalSizeToAlloc<Stmt *>(N + 2), alignof(ObjC3IfBindingStmt));
+  auto *Node = new (Memory) ObjC3IfBindingStmt(N, {}, {});
+  std::fill_n(Node->getTrailingObjects(), N + 2, nullptr);
+  return Node;
+}
diff --git a/clang/unittests/AST/ObjC3ConditionNodesTest.cpp b/clang/unittests/AST/ObjC3ConditionNodesTest.cpp
new file mode 100644
index 000000000..d38847f38
--- /dev/null
+++ b/clang/unittests/AST/ObjC3ConditionNodesTest.cpp
@@ -0,0 +1,177 @@
+//===--- ObjC3ConditionNodesTest.cpp - Native condition AST consumers ----===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Lex/HeaderSearchOptions.h"
+#include "clang/Sema/Initialization.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/ADT/FoldingSet.h"
+#include "llvm/Support/Error.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/ToolOutputFile.h"
+#include "llvm/Support/VirtualFileSystem.h"
+#include "gtest/gtest.h"
+using namespace clang;
+namespace {
+class Conditions : public RecursiveASTVisitor<Conditions> {
+public:
+  unsigned Bindings = 0, Guards = 0, Ifs = 0, Variables = 0;
+  bool VisitObjC3BindingCondition(ObjC3BindingCondition *) {
+    ++Bindings;
+    return true;
+  }
+  bool VisitObjC3GuardStmt(ObjC3GuardStmt *) {
+    ++Guards;
+    return true;
+  }
+  bool VisitObjC3IfBindingStmt(ObjC3IfBindingStmt *) {
+    ++Ifs;
+    return true;
+  }
+  bool VisitVarDecl(VarDecl *) {
+    ++Variables;
+    return true;
+  }
+};
+} // namespace
+TEST(ObjC3Conditions,
+     TraversesProfilesPrintsImportsAndPersistsNativeDeclarations) {
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                         "-fobjc-version=3"};
+  auto From = tooling::buildASTFromCodeWithArgs(
+      "int source; void test() { int first = source; int second = source; }",
+      Args, "conditions.mm");
+  auto To = tooling::buildASTFromCodeWithArgs("extern int source; void test();",
+                                              Args, "target.mm");
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  FunctionDecl *Function = nullptr;
+  for (Decl *D : From->getASTContext().getTranslationUnitDecl()->decls())
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      if (FD->hasBody())
+        Function = FD;
+  ASSERT_TRUE(Function);
+  ASTContext &C = From->getASTContext();
+  auto *Original = cast<CompoundStmt>(Function->getBody());
+  auto *FirstStatement = cast<DeclStmt>(*Original->body_begin());
+  auto *SecondStatement = cast<DeclStmt>(*(Original->body_begin() + 1));
+  auto MakeBinding = [&](DeclStmt *Statement, bool Mutable) {
+    auto *Variable = cast<VarDecl>(Statement->getSingleDecl());
+    Expr *Source = Variable->getInit();
+    if (!Mutable)
+      Variable->setType(C.getConstType(Variable->getType()));
+    auto *Opaque =
+        new (C) OpaqueValueExpr(Variable->getLocation(), C.IntTy, VK_LValue);
+    ExprResult Init = From->getSema().PerformCopyInitialization(
+        InitializedEntity::InitializeVariable(Variable),
+        Variable->getLocation(), Opaque);
+    EXPECT_FALSE(Init.isInvalid());
+    Variable->setInit(Init.get());
+    return new (C)
+        ObjC3BindingCondition(Source, Statement, Mutable,
+                              Variable->getLocation(), Variable->getLocation());
+  };
+  auto *Let = MakeBinding(FirstStatement, false);
+  auto *Var = MakeBinding(SecondStatement, true);
+  SourceLocation Loc = Function->getLocation();
+  auto *Return = ReturnStmt::Create(C, Loc, nullptr, nullptr);
+  Stmt *ReturnBody[] = {Return};
+  auto *Else =
+      CompoundStmt::Create(C, ReturnBody, FPOptionsOverride(), Loc, Loc);
+  auto *Then = CompoundStmt::Create(C, {}, FPOptionsOverride(), Loc, Loc);
+  auto *Truth = new (C) CXXBoolLiteralExpr(true, C.BoolTy, Loc);
+  Stmt *GuardConditions[] = {Let, Truth};
+  auto *Guard = ObjC3GuardStmt::Create(C, GuardConditions, Else, Loc, Loc);
+  Stmt *IfConditions[] = {Var};
+  auto *If = ObjC3IfBindingStmt::Create(C, IfConditions, Then, nullptr, Loc,
+                                        SourceLocation());
+  Stmt *Body[] = {Guard, If};
+  Function->setBody(
+      CompoundStmt::Create(C, Body, FPOptionsOverride(), Loc, Loc));
+  Conditions Visitor;
+  EXPECT_TRUE(Visitor.TraverseStmt(Function->getBody()));
+  EXPECT_EQ(2u, Visitor.Bindings);
+  EXPECT_EQ(1u, Visitor.Guards);
+  EXPECT_EQ(1u, Visitor.Ifs);
+  EXPECT_EQ(2u, Visitor.Variables);
+  llvm::FoldingSetNodeID LetID, VarID;
+  Let->Profile(LetID, C, true);
+  Var->Profile(VarID, C, true);
+  EXPECT_NE(LetID, VarID);
+  std::string Printed;
+  llvm::raw_string_ostream Stream(Printed);
+  Function->getBody()->printPretty(Stream, nullptr,
+                                   PrintingPolicy(C.getLangOpts()));
+  EXPECT_NE(std::string::npos,
+            Printed.find("guard let first = source, true else"));
+  EXPECT_NE(std::string::npos, Printed.find("if var second = source"));
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(), C,
+                       From->getFileManager(), false);
+  auto Imported = Importer.Import(Function);
+  if (!Imported) {
+    ADD_FAILURE() << llvm::toString(Imported.takeError());
+    return;
+  }
+  auto *ImportedFunction = cast<FunctionDecl>(*Imported);
+  auto *ImportedGuard = cast<ObjC3GuardStmt>(
+      cast<CompoundStmt>(ImportedFunction->getBody())->body_front());
+  auto *ImportedLet =
+      cast<ObjC3BindingCondition>(ImportedGuard->getCondition(0));
+  EXPECT_NE(Let->getBindingDecl(), ImportedLet->getBindingDecl());
+  EXPECT_EQ("first", ImportedLet->getBindingDecl()->getName());
+  EXPECT_TRUE(ImportedLet->getBindingDecl()->getType().isConstQualified());
+  StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalent;
+  StructuralEquivalenceContext Equivalent(
+      C.getLangOpts(), C, To->getASTContext(), NonEquivalent,
+      StructuralEquivalenceKind::Default, false, false);
+  EXPECT_TRUE(Equivalent.IsEquivalent(Guard, ImportedGuard));
+
+  llvm::SmallString<256> ASTPath;
+  int Descriptor;
+  ASSERT_FALSE(llvm::sys::fs::createTemporaryFile("objc3-conditions", "ast",
+                                                  Descriptor, ASTPath));
+  llvm::ToolOutputFile ASTFile(ASTPath, Descriptor);
+  ASSERT_FALSE(From->Save(ASTPath));
+  auto VFS = From->getFileManager().getVirtualFileSystemPtr();
+  auto DiagnosticOpts = std::make_shared<DiagnosticOptions>();
+  auto Diagnostics = CompilerInstance::createDiagnostics(*VFS, *DiagnosticOpts);
+  auto Containers = std::make_shared<PCHContainerOperations>();
+  HeaderSearchOptions HeaderOptions;
+  auto Reloaded = ASTUnit::LoadFromASTFile(
+      ASTPath, Containers->getRawReader(), ASTUnit::LoadEverything, VFS,
+      DiagnosticOpts, Diagnostics, From->getFileSystemOpts(), HeaderOptions);
+  ASSERT_TRUE(Reloaded);
+  FunctionDecl *ReloadedFunction = nullptr;
+  for (Decl *D : Reloaded->getASTContext().getTranslationUnitDecl()->decls())
+    if (auto *FD = dyn_cast<FunctionDecl>(D))
+      if (FD->hasBody())
+        ReloadedFunction = FD;
+  ASSERT_TRUE(ReloadedFunction);
+  auto *ReloadedBody = cast<CompoundStmt>(ReloadedFunction->getBody());
+  ASSERT_EQ(2u, ReloadedBody->size());
+  auto *ReloadedGuard = cast<ObjC3GuardStmt>(ReloadedBody->body_front());
+  auto *ReloadedIf = cast<ObjC3IfBindingStmt>(ReloadedBody->body_back());
+  ASSERT_EQ(2u, ReloadedGuard->getNumConditions());
+  ASSERT_EQ(1u, ReloadedIf->getNumConditions());
+  auto *ReloadedLet =
+      cast<ObjC3BindingCondition>(ReloadedGuard->getCondition(0));
+  auto *ReloadedVar = cast<ObjC3BindingCondition>(ReloadedIf->getCondition(0));
+  EXPECT_FALSE(ReloadedLet->isMutableBinding());
+  EXPECT_TRUE(ReloadedVar->isMutableBinding());
+  EXPECT_EQ("first", ReloadedLet->getBindingDecl()->getName());
+  EXPECT_EQ("second", ReloadedVar->getBindingDecl()->getName());
+  EXPECT_TRUE(ReloadedLet->getBindingDecl()->getType().isConstQualified());
+  EXPECT_FALSE(ReloadedVar->getBindingDecl()->getType().isConstQualified());
+  EXPECT_NE(nullptr, ReloadedGuard->getElse());
+  EXPECT_EQ(nullptr, ReloadedIf->getElse());
+  Conditions ReloadedVisitor;
+  EXPECT_TRUE(ReloadedVisitor.TraverseStmt(ReloadedBody));
+  EXPECT_EQ(2u, ReloadedVisitor.Bindings);
+  EXPECT_EQ(2u, ReloadedVisitor.Variables);
+}
