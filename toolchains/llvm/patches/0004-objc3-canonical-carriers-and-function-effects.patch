+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Analysis/CFG.h"
+#include "clang/Basic/Diagnostic.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Sema/Sema.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+#include <functional>
+#include <map>
+#include <set>
+using namespace clang;
+namespace {
+class Diagnostics final : public DiagnosticConsumer {
+public:
+  unsigned Errors = 0;
+  void HandleDiagnostic(DiagnosticsEngine::Level Level,
+                        const Diagnostic &) override {
+    Errors += Level >= DiagnosticsEngine::Error;
+  }
+};
+class Placeholder : public RecursiveASTVisitor<Placeholder> {
+public:
+  IfStmt *Statement = nullptr;
+  bool VisitIfStmt(IfStmt *If) {
+    if (!Statement && If->getElse() && isa<CompoundStmt>(If->getThen()))
+      Statement = If;
+    return true;
+  }
+};
+void replaceStatement(Stmt *Root, Stmt *Old, Stmt *New) {
+  for (Stmt *&Child : Root->children()) {
+    if (Child == Old)
+      Child = New;
+    else if (Child)
+      replaceStatement(Child, Old, New);
+  }
+}
+ObjC3GuardStmt *replacePlaceholder(ASTContext &C, FunctionDecl *Function,
+                                   ArrayRef<Stmt *> Conditions = {}) {
+  Placeholder Find;
+  Find.TraverseStmt(Function->getBody());
+  if (!Find.Statement)
+    return nullptr;
+  auto *If = Find.Statement;
+  SmallVector<Stmt *, 4> Native(Conditions.begin(), Conditions.end());
+  if (Native.empty())
+    Native.push_back(If->getCond());
+  auto *Guard = ObjC3GuardStmt::Create(C, Native, If->getElse(), If->getIfLoc(),
+                                       If->getElseLoc());
+  replaceStatement(Function->getBody(), If, Guard);
+  return Guard;
+}
+} // namespace
+
+TEST(ObjC3ConditionScope, CompletedCallableUsesRealImplicitAndCompoundScopes) {
+  auto AST = tooling::buildASTFromCodeWithArgs(
+      R"(
+    bool condition;
+    void pass_return() { if(condition) {} else { return; } }
+    void pass_implicit() { if(condition) if(condition) {} else { goto out; } out:; }
+    void pass_outer_label() { { if(condition) {} else { goto out; } } out:; }
+    void fail_same_scope() { if(condition) {} else { goto out; } out:; }
+    void fail_fallthrough() { if(condition) {} else {} }
+  )",
+      {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto *Messages = new Diagnostics;
+  AST->getDiagnostics().setClient(Messages, true);
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    ASSERT_TRUE(replacePlaceholder(AST->getASTContext(), Function));
+    Sema::SynthesizedFunctionScope Scope(AST->getSema(), Function);
+    bool Invalid =
+        AST->getSema().CheckObjC3Guards(Function, Function->getBody());
+    EXPECT_EQ(Function->getName().starts_with("fail_"), Invalid);
