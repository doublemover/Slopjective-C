diff --git a/clang/test/ObjC3/AST/match-dependent-transform.mm b/clang/test/ObjC3/AST/match-dependent-transform.mm
new file mode 100644
index 000000000..05bc9c365
--- /dev/null
+++ b/clang/test/ObjC3/AST/match-dependent-transform.mm
@@ -0,0 +1,21 @@
+// MATCH-PACKET: transform after substitution must rerun type-directed coverage.
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+template <class T> int match_bool(T value) {
+  return __objc3_match (value) {
+  case true => 1;
+  case false => 0;
+  };
+}
+int instantiate_bool(bool value) { return match_bool(value); }
+
+template <class T> int match_optional(__objc3_optional(T) value) {
+  return __objc3_match (value) {
+  case __objc3_case_some(let element) => 1;
+  case __objc3_case_none => 0;
+  };
+}
+int instantiate_optional(__objc3_optional(int) value) {
+  return match_optional(value);
+}
diff --git a/clang/test/ObjC3/AST/match-node-order.mm b/clang/test/ObjC3/AST/match-node-order.mm
new file mode 100644
index 000000000..10634128c
--- /dev/null
+++ b/clang/test/ObjC3/AST/match-node-order.mm
@@ -0,0 +1,26 @@
+// MATCH-PACKET: AST traversal preserves source-order arms and case bindings.
+// RUN: %clang_cc1 -x objective-c++ -fobjc-version=3 -ast-dump %s | FileCheck %s
+// CHECK: ObjC3ResultType
+// CHECK: ObjC3OptionalType
+// CHECK: ObjC3MatchStmt
+// CHECK: ObjC3MatchArm
+// CHECK: VarDecl {{.*}} value
+// CHECK: ObjC3MatchArm
+// CHECK: VarDecl {{.*}} error
+// CHECK: ObjC3MatchStmt
+// CHECK: ObjC3MatchArm
+// CHECK: VarDecl {{.*}} element
+// CHECK: ObjC3MatchArm
+
+using R = __objc3_result(int, long long);
+using O = __objc3_optional(int);
+void f(R r, O o) {
+  __objc3_match_stmt (r) {
+  case .Ok(let value): { (void)value; }
+  case .Err(let error): { (void)error; }
+  }
+  __objc3_match_stmt (o) {
+  case __objc3_case_some(let element): { (void)element; }
+  case __objc3_case_none: { }
+  }
+}
