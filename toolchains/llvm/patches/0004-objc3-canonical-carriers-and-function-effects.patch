+// RUN: %clang_cc1 -std=c++20 -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify %s
+// RUN: %clang_cc1 -std=c++23 -fobjc-version=3 -fobjc3-profile=strict -fsyntax-only -verify %s
+@protocol Error @end
+__attribute__((objc_root_class)) @interface Good <Error> @end
+__attribute__((objc_root_class)) @interface Wrong @end
+template<class T> T checked(T value) {
+  return __builtin_objc3_checked_error(value); // expected-error {{must conform to Objective-C protocol 'Error'}}
