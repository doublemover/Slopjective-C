+          PayloadBase +
+          UnionLayout.getFieldOffset(Info.ErrorField->getFieldIndex());
+  }
+  Info.State = ObjC3CarrierRepresentationInfo::Status::Materialized;
+  ObjC3CarrierRepresentations[T] = Info;
+  return Info;
+}
