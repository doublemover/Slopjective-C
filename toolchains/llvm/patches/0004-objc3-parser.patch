+    }
+    if (!Tok.is(tok::r_paren)) {
+      Diag(Tok, diag::err_objc3_unterminated_throws_payload);
+      Payload.skipToEnd();
+      continue;
+    }
+    Payload.consumeClose();
+    ThrowsKind = 2; // ObjC3ThrowsKind::Typed
+    ErrorType = ParsedErrorType.get();
+    Actions.GetTypeFromParser(ErrorType, &ErrorTypeInfo);
+  }
+}
+
 bool Parser::ParseRefQualifier(bool &RefQualifierIsLValueRef,
                                SourceLocation &RefQualifierLoc) {
   if (Tok.isOneOf(tok::amp, tok::ampamp)) {

diff --git a/clang/lib/Parse/ParseObjC3Match.cpp b/clang/lib/Parse/ParseObjC3Match.cpp
new file mode 100644
index 000000000..6a84c44ec
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3Match.cpp
@@ -0,0 +1,393 @@
+#include "clang/AST/ObjC3MatchSemantic.h"
+#include "clang/Basic/DiagnosticParse.h"
+#include "clang/Basic/ObjC3Syntax.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
+#include "clang/Sema/Scope.h"
+#include "llvm/ADT/SmallVector.h"
+
+using namespace clang;
+
+bool Parser::ParseObjC3MatchPattern(objc3::MatchPatternInfo &Pattern) {
+  Pattern.Location = Tok.getLocation();
+  auto IsWord = [&](StringRef Word) {
+    return Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+           Tok.getIdentifierInfo()->isStr(Word);
+  };
+  auto ParseName = [&](bool Mutable) -> bool {
+    if (!Tok.is(tok::identifier) || !Tok.getIdentifierInfo()) {
+      Diag(Tok, diag::err_expected) << tok::identifier;
+      return false;
+    }
+    Pattern.BindingName = Tok.getIdentifierInfo();
+    Pattern.BindingLocation = Tok.getLocation();
+    Pattern.MutableBinding = Mutable;
+    ConsumeAnyToken();
+    return true;
+  };
+
+  if (Tok.is(tok::kw_true) || Tok.is(tok::kw_false)) {
+    Pattern.Kind = Tok.is(tok::kw_true) ? objc3::MatchPatternKind::BooleanTrue
+                                        : objc3::MatchPatternKind::BooleanFalse;
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("_")) {
+    Pattern.Kind = objc3::MatchPatternKind::Wildcard;
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("let") || IsWord("var")) {
+    bool Mutable = IsWord("var");
+    Pattern.Kind = objc3::MatchPatternKind::Binding;
+    ConsumeAnyToken();
+    return ParseName(Mutable);
+  }
+  // Public Optional arms use the same dot-case convention as Result arms.
+  // Recognize these spellings only while parsing a match pattern.
+  bool PublicOptional = false;
+  if (Tok.is(tok::period) && NextToken().is(tok::identifier) &&
+      (NextToken().getIdentifierInfo()->isStr("Some") ||
+       NextToken().getIdentifierInfo()->isStr("None"))) {
+    ConsumeToken();
+    PublicOptional = true;
+  }
+  if ((IsWord("__objc3_case_none") || (PublicOptional && IsWord("None")))) {
+    Pattern.Kind = objc3::MatchPatternKind::OptionalNone;
+    ConsumeAnyToken();
+    return true;
+  }
+  if ((IsWord("__objc3_case_some") || (PublicOptional && IsWord("Some")))) {
+    Pattern.Kind = objc3::MatchPatternKind::OptionalSome;
+    ConsumeAnyToken();
+    if (Tok.isNot(tok::l_paren)) {
+      Diag(Tok, diag::err_objc3_match_binding_required);
+      return false;
+    }
+    ConsumeAnyToken();
+    if (IsWord("move")) {
+      Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+      ConsumeAnyToken();
+      if (IsWord("let") || IsWord("var"))
+        ConsumeAnyToken();
+      if (!ParseName(/*Mutable=*/false))
+        return false;
+      if (Tok.isNot(tok::r_paren)) {
+        Diag(Tok, diag::err_expected) << tok::r_paren;
+        return false;
+      }
+      ConsumeAnyToken();
+      return true;
+    }
+    if (IsWord("_")) {
+      ConsumeAnyToken();
+      if (Tok.isNot(tok::r_paren)) {
+        Diag(Tok, diag::err_expected) << tok::r_paren;
+        return false;
+      }
+      ConsumeAnyToken();
+      return true;
+    }
+    if (!IsWord("let") && !IsWord("var")) {
+      Diag(Tok, diag::err_objc3_match_binding_required);
+      return false;
+    }
+    bool Mutable = IsWord("var");
+    ConsumeAnyToken();
+    if (!ParseName(Mutable))
+      return false;
+    if (Tok.isNot(tok::r_paren)) {
+      Diag(Tok, diag::err_expected) << tok::r_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    return true;
+  }
+  if (IsWord("move")) {
+    Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+    ConsumeAnyToken();
+    if (IsWord("let") || IsWord("var"))
+      ConsumeAnyToken();
+    return ParseName(/*Mutable=*/false);
+  }
+  if (IsWord("is")) {
+    Pattern.Kind = objc3::MatchPatternKind::TypeTest;
+    ConsumeAnyToken();
+    TypeResult Refined = ParseTypeName();
+    return !Refined.isInvalid();
+  }
+  if (Tok.is(tok::period)) {
+    ConsumeAnyToken();
+    if (!Tok.is(tok::identifier) || !Tok.getIdentifierInfo()) {
+      Diag(Tok, diag::err_expected) << tok::identifier;
+      return false;
+    }
+    IdentifierInfo *CaseName = Tok.getIdentifierInfo();
+    bool IsOK = CaseName->isStr("Ok");
+    bool IsErr = CaseName->isStr("Err");
+    if (!IsOK && !IsErr) {
+      Diag(Tok, diag::err_objc3_match_invalid_pattern);
+      return false;
+    }
+    Pattern.Kind = IsOK ? objc3::MatchPatternKind::ResultOK
+                        : objc3::MatchPatternKind::ResultErr;
+    ConsumeAnyToken();
+    if (Tok.isNot(tok::l_paren)) {
+      Diag(Tok, diag::err_expected) << tok::l_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    if (IsWord("_")) {
+      ConsumeAnyToken();
+    } else if (IsWord("move")) {
+      Pattern.Kind = objc3::MatchPatternKind::MoveBinding;
+      ConsumeAnyToken();
+      ParseName(/*Mutable=*/false);
+    } else {
+      if (!IsWord("let") && !IsWord("var")) {
+        Diag(Tok, diag::err_objc3_match_binding_required);
+        return false;
+      }
+      bool Mutable = IsWord("var");
+      ConsumeAnyToken();
+      if (!ParseName(Mutable))
+        return false;
+    }
+    if (Tok.isNot(tok::r_paren)) {
+      Diag(Tok, diag::err_expected) << tok::r_paren;
+      return false;
+    }
+    ConsumeAnyToken();
+    return true;
+  }
+
+  if (Tok.is(tok::numeric_constant) ||
+      ((Tok.is(tok::minus) || Tok.is(tok::plus)) &&
+       NextToken().is(tok::numeric_constant)))
+    Pattern.Kind = objc3::MatchPatternKind::IntegerLiteral;
+  else if (Tok.is(tok::char_constant))
+    Pattern.Kind = objc3::MatchPatternKind::CharacterLiteral;
+  else if (Tok.is(tok::kw_nullptr) || Tok.is(tok::kw___null) ||
+           Tok.is(tok::l_paren))
+    Pattern.Kind = objc3::MatchPatternKind::NilLiteral;
+  else if (Tok.is(tok::at) || Tok.is(tok::string_literal))
+    Pattern.Kind = objc3::MatchPatternKind::StringLiteral;
+  else {
+    Diag(Tok, diag::err_objc3_match_invalid_pattern);
+    return false;
+  }
+  // A match head ends at `=>`; its '=' must not start an assignment.
+  ExprResult Value = ParseConditionalExpression();
+  if (Value.isInvalid())
+    return false;
+  Pattern.PatternValue = Value.get();
+  return true;
+}
+
+ExprResult Parser::ParseObjC3MatchExpression() {
+  SourceLocation KeywordLoc = ConsumeAnyToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, "match",
+                              tok::r_paren))
+    return ExprError();
+  ExprResult Scrutinee = ParseExpression();
+  if (Scrutinee.isUsable())
+    Scrutinee = Actions.CheckPlaceholderExpr(Scrutinee.get());
+  if (Scrutinee.isInvalid() || Parens.consumeClose())
+    return ExprError();
+  if (Tok.isNot(tok::l_brace)) {
+    Diag(Tok, diag::err_expected) << tok::l_brace;
+    return ExprError();
+  }
+  SourceLocation LBraceLoc = ConsumeAnyToken();
+  if (Tok.is(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::kw_case;
+    ConsumeAnyToken();
+    return ExprError();
+  }
+  llvm::SmallVector<ObjC3MatchArm *, 8> Arms;
+
+  while (Tok.isNot(tok::r_brace) && Tok.isNot(tok::eof)) {
+    bool IsDefault = Tok.is(tok::kw_default);
+    if (!IsDefault && Tok.isNot(tok::kw_case)) {
+      Diag(Tok, diag::err_expected) << tok::kw_case;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation CaseLoc = Tok.getLocation();
+    ConsumeAnyToken();
+    ParseScope CaseScope(this, Scope::DeclScope | Scope::CompoundStmtScope);
+    objc3::MatchPatternInfo Pattern;
+    Pattern.Kind = IsDefault ? objc3::MatchPatternKind::Default
+                             : objc3::MatchPatternKind::Wildcard;
+    Pattern.Location = Tok.getLocation();
+    if (!IsDefault && !ParseObjC3MatchPattern(Pattern)) {
+      SkipUntil(tok::semi, StopAtSemi);
+      if (Tok.is(tok::semi))
+        ConsumeAnyToken();
+      continue;
+    }
+    objc3::MatchCaseState State = Actions.ActOnObjC3MatchBeginCase(
+        getCurScope(), Scrutinee.get(), Pattern, /*ExpressionForm=*/true);
+    if (!State.IsValid) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    ExprResult Guard;
+    SourceLocation GuardLoc;
+    if (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+        Tok.getIdentifierInfo()->isStr("where")) {
+      GuardLoc = ConsumeAnyToken();
+      if (Tok.is(tok::semi) || Tok.is(tok::equal)) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::semi, StopAtSemi);
+        if (Tok.is(tok::semi))
+          ConsumeAnyToken();
+        continue;
+      }
+      Guard = ParseConditionalExpression();
+      if (Guard.isInvalid()) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::semi, StopAtSemi);
+        if (Tok.is(tok::semi))
+          ConsumeAnyToken();
+        continue;
+      }
+    }
+    if (Tok.isNot(tok::equal)) {
+      Diag(Tok, diag::err_objc3_match_form_delimiter) << true;
+      SkipUntil(tok::semi, StopAtSemi);
+      if (Tok.is(tok::semi))
+        ConsumeAnyToken();
+      continue;
+    }
+    ConsumeAnyToken();
+    if (Tok.isNot(tok::greater)) {
+      Diag(Tok, diag::err_expected) << tok::greater;
+      SkipUntil(tok::semi, StopAtSemi);
+      if (Tok.is(tok::semi))
+        ConsumeAnyToken();
+      continue;
+    }
+    SourceLocation DelimiterLoc = ConsumeAnyToken();
+    ExprResult Body = ParseAssignmentExpression();
+    if (Body.isInvalid()) {
+      SkipUntil(tok::semi, StopAtSemi);
+      if (Tok.is(tok::semi))
+        ConsumeAnyToken();
+      continue;
+    }
+    if (Tok.isNot(tok::semi)) {
+      Diag(Tok, diag::err_expected) << tok::semi;
+      SkipUntil(tok::semi, StopAtSemi);
+      if (Tok.is(tok::semi))
+        ConsumeAnyToken();
+      continue;
+    }
+    ConsumeAnyToken();
+    if (ObjC3MatchArm *Arm = Actions.ActOnObjC3MatchFinishCase(
+            State, Guard.get(), Body.get(), CaseLoc, Pattern.Location, GuardLoc,
+            DelimiterLoc))
+      Arms.push_back(Arm);
+  }
+  if (Tok.isNot(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::r_brace;
+    return ExprError();
+  }
+  SourceLocation RBraceLoc = ConsumeAnyToken();
+  return Actions.ActOnObjC3MatchExpr(
+      Scrutinee.get(), Arms, KeywordLoc, Parens.getOpenLocation(),
+      Parens.getCloseLocation(), LBraceLoc, RBraceLoc);
+}
+
+StmtResult Parser::ParseObjC3MatchStatement() {
+  SourceLocation KeywordLoc = ConsumeAnyToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, "match",
+                              tok::r_paren))
+    return StmtError();
+  ExprResult Scrutinee = ParseExpression();
+  if (Scrutinee.isUsable())
+    Scrutinee = Actions.CheckPlaceholderExpr(Scrutinee.get());
+  if (Scrutinee.isInvalid() || Parens.consumeClose())
+    return StmtError();
+  if (Tok.isNot(tok::l_brace)) {
+    Diag(Tok, diag::err_expected) << tok::l_brace;
+    return StmtError();
+  }
+  SourceLocation LBraceLoc = ConsumeAnyToken();
+  if (Tok.is(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::kw_case;
+    ConsumeAnyToken();
+    return StmtError();
+  }
+  llvm::SmallVector<ObjC3MatchArm *, 8> Arms;
+  while (Tok.isNot(tok::r_brace) && Tok.isNot(tok::eof)) {
+    bool IsDefault = Tok.is(tok::kw_default);
+    if (!IsDefault && Tok.isNot(tok::kw_case)) {
+      Diag(Tok, diag::err_expected) << tok::kw_case;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation CaseLoc = Tok.getLocation();
+    ConsumeAnyToken();
+    ParseScope CaseScope(this, Scope::DeclScope | Scope::CompoundStmtScope);
+    objc3::MatchPatternInfo Pattern;
+    Pattern.Kind = IsDefault ? objc3::MatchPatternKind::Default
+                             : objc3::MatchPatternKind::Wildcard;
+    Pattern.Location = Tok.getLocation();
+    if (!IsDefault && !ParseObjC3MatchPattern(Pattern)) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    objc3::MatchCaseState State = Actions.ActOnObjC3MatchBeginCase(
+        getCurScope(), Scrutinee.get(), Pattern, /*ExpressionForm=*/false);
+    if (!State.IsValid) {
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    ExprResult Guard;
+    SourceLocation GuardLoc;
+    if (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+        Tok.getIdentifierInfo()->isStr("where")) {
+      GuardLoc = ConsumeAnyToken();
+      if (Tok.is(tok::colon) || Tok.is(tok::r_brace)) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+      Guard = ParseAssignmentExpression();
+      if (Guard.isInvalid()) {
+        Diag(Tok, diag::err_objc3_match_malformed_guard);
+        SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+        continue;
+      }
+    }
+    if (Tok.isNot(tok::colon)) {
+      Diag(Tok, diag::err_objc3_match_form_delimiter) << false;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    SourceLocation ColonLoc = ConsumeAnyToken();
+    if (Tok.isNot(tok::l_brace)) {
+      Diag(Tok, diag::err_expected) << tok::l_brace;
+      SkipUntil(tok::kw_case, tok::kw_default, tok::r_brace, StopBeforeMatch);
+      continue;
+    }
+    StmtResult Body = ParseCompoundStatement();
+    if (Body.isInvalid())
+      continue;
+    if (ObjC3MatchArm *Arm = Actions.ActOnObjC3MatchFinishCase(
+            State, Guard.get(), Body.get(), CaseLoc, Pattern.Location, GuardLoc,
+            ColonLoc))
+      Arms.push_back(Arm);
+  }
+  if (Tok.isNot(tok::r_brace)) {
+    Diag(Tok, diag::err_expected) << tok::r_brace;
+    return StmtError();
+  }
+  SourceLocation RBraceLoc = ConsumeAnyToken();
+  return Actions.ActOnObjC3MatchStmt(
+      Scrutinee.get(), Arms, KeywordLoc, Parens.getOpenLocation(),
+      Parens.getCloseLocation(), LBraceLoc, RBraceLoc);
+}
diff --git a/clang/lib/Parse/ParseObjC3QualifiedName.cpp b/clang/lib/Parse/ParseObjC3QualifiedName.cpp
new file mode 100644
index 000000000..84cca4e57
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3QualifiedName.cpp
@@ -0,0 +1,121 @@
+//===--- ParseObjC3QualifiedName.cpp - ObjC3 qualified names -------------===//
+//
+// Staged Clang extension source. This file is added to clangParse's CMake
+// source list after Parser.h and the shared insertion hooks are merged.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/Basic/DiagnosticParse.h"
+
+#include "clang/Basic/TokenKinds.h"
+#include "clang/Parse/Parser.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/SmallVector.h"
+
+using namespace clang;
+
+namespace {
+struct QualifiedNameTokens {
+  SmallVector<IdentifierInfo *, 8> Components;
+  SmallVector<SourceLocation, 8> Locations;
+  SmallVector<SourceLocation, 8> Dots;
+};
+
+QualifiedNameTokens collectQualifiedName(Parser &P, const Token &Start) {
+  QualifiedNameTokens Result;
+  if (!Start.is(tok::identifier) || !Start.getIdentifierInfo())
+    return Result;
+
+  Result.Components.push_back(Start.getIdentifierInfo());
+  Result.Locations.push_back(Start.getLocation());
+  unsigned Offset = 1;
+  while (P.GetLookAheadToken(Offset).is(tok::period) &&
+         P.GetLookAheadToken(Offset + 1).is(tok::identifier) &&
+         P.GetLookAheadToken(Offset + 1).getIdentifierInfo()) {
+    Result.Dots.push_back(P.GetLookAheadToken(Offset).getLocation());
+    Result.Components.push_back(
+        P.GetLookAheadToken(Offset + 1).getIdentifierInfo());
+    Result.Locations.push_back(P.GetLookAheadToken(Offset + 1).getLocation());
+    Offset += 2;
+  }
+  return Result;
+}
+
+} // namespace
+
+bool Parser::isObjC3QualifiedNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::identifier) ||
+      !Tok.getIdentifierInfo())
+    return false;
+  return NextToken().is(tok::period) &&
+         GetLookAheadToken(2).is(tok::identifier);
+}
+
+bool Parser::isObjC3QualifiedTypeNameAhead() {
+  if (!getLangOpts().ObjC3 || !Tok.is(tok::at) ||
+      !GetLookAheadToken(1).is(tok::identifier) ||
+      !GetLookAheadToken(2).is(tok::period) ||
+      !GetLookAheadToken(3).is(tok::identifier))
+    return false;
+
+  SmallVector<IdentifierInfo *, 8> Components;
+  unsigned Offset = 1;
+  Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+  Offset += 2;
+  while (GetLookAheadToken(Offset - 1).is(tok::period) &&
+         GetLookAheadToken(Offset).is(tok::identifier)) {
+    Components.push_back(GetLookAheadToken(Offset).getIdentifierInfo());
+    Offset += 2;
+  }
+  return Actions.IsObjC3QualifiedTypeName(Components);
+}
+
+ExprResult Parser::ParseObjC3QualifiedNameExpression(SourceLocation AtLoc) {
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2)
+    return ExprError(Diag(AtLoc, diag::err_unexpected_at));
+
+  unsigned ConsumedComponents = Name.Components.size();
+  ExprResult Result = Actions.ActOnObjC3QualifiedNameExpr(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return ParsePostfixExpressionSuffix(Result);
+}
+
+TypeResult Parser::ParseObjC3QualifiedTypeName(SourceLocation &EndLoc) {
+  assert(getLangOpts().ObjC3 && Tok.is(tok::at));
+  SourceLocation AtLoc = ConsumeToken();
+  QualifiedNameTokens Name = collectQualifiedName(*this, Tok);
+  if (Name.Components.size() < 2) {
+    EndLoc = AtLoc;
+    return TypeError();
+  }
+
+  unsigned ConsumedComponents = Name.Components.size();
+  TypeResult Result = Actions.ActOnObjC3QualifiedTypeName(
+      AtLoc, Name.Components, Name.Locations, ConsumedComponents);
+  if (ConsumedComponents == 0 ||
+      ConsumedComponents > Name.Components.size())
+    ConsumedComponents = Name.Components.size();
+  EndLoc = Name.Locations[ConsumedComponents - 1];
+  for (unsigned I = 0; I != ConsumedComponents; ++I) {
+    assert(Tok.is(tok::identifier));
+    ConsumeToken();
+    if (I + 1 != ConsumedComponents) {
+      assert(Tok.is(tok::period));
+      ConsumeToken();
+    }
+  }
+  return Result;
+}
