+void Parser::ParseObjC3ResourceAttribute(
+    IdentifierInfo &AttrName, SourceLocation AttrNameLoc,
+    ParsedAttributes &Attrs, SourceLocation *EndLoc, IdentifierInfo *ScopeName,
+    SourceLocation ScopeLoc, ParsedAttr::Form Form) {
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.consumeOpen())
+    return;
+
+  ExprResult Close, Invalid;
+  bool Malformed = false;
+  while (Tok.isNot(tok::r_paren) && Tok.isNot(tok::eof)) {
+    if (Tok.isNot(tok::identifier)) {
+      Diag(Tok, PP.getDiagnostics().getCustomDiagID(
+                    DiagnosticsEngine::Error,
+                    "expected 'close=F' or 'invalid=X' in objc_resource"));
+      Malformed = true;
+      break;
+    }
+    StringRef Key = Tok.getIdentifierInfo()->getName();
+    SourceLocation KeyLoc = ConsumeToken();
+    if (ExpectAndConsume(tok::equal)) {
+      Malformed = true;
+      break;
+    }
+    EnterExpressionEvaluationContext ConstantContext(
+        Actions, Sema::ExpressionEvaluationContext::ConstantEvaluated, nullptr,
+        Sema::ExpressionEvaluationContextRecord::ExpressionKind::EK_AttrArgument);
+    ExprResult Value = ParseAssignmentExpression();
+    if (Value.isInvalid()) {
+      Malformed = true;
+      break;
+    }
+    ExprResult *Destination = Key == "close" ? &Close
+                              : Key == "invalid" ? &Invalid
+                                                 : nullptr;
+    if (!Destination || Destination->isUsable()) {
+      Diag(KeyLoc, PP.getDiagnostics().getCustomDiagID(
+                       DiagnosticsEngine::Error,
+                       "unknown or duplicate objc_resource argument '%0'"))
+          << Key;
+      Malformed = true;
+      break;
+    }
+    *Destination = Value;
+    if (Tok.isNot(tok::comma))
+      break;
+    ConsumeToken();
+    if (Tok.is(tok::r_paren)) {
+      Diag(Tok, PP.getDiagnostics().getCustomDiagID(
+                    DiagnosticsEngine::Error,
+                    "expected objc_resource argument after ','"));
+      Malformed = true;
+      break;
+    }
+  }
+  if (Malformed) {
+    Parens.skipToEnd();
+    return;
+  }
+  if (Parens.consumeClose())
+    return;
+  if (EndLoc)
+    *EndLoc = Parens.getCloseLocation();
+  if (!Close.isUsable() || !Invalid.isUsable()) {
+    Diag(AttrNameLoc, PP.getDiagnostics().getCustomDiagID(
+                          DiagnosticsEngine::Error,
+                          "objc_resource requires both 'close=F' and 'invalid=X'"));
+    return;
+  }
+  ArgsUnion Arguments[] = {Close.get(), Invalid.get()};
+  Attrs.addNew(&AttrName, SourceRange(AttrNameLoc, Parens.getCloseLocation()),
+               AttributeScopeInfo(ScopeName, ScopeLoc), Arguments, 2, Form);
+}
