+bool isObjC3BorrowedQualifier(const LangOptions &Lang, const Token &Current,
+                              const Token &Next) {
+  if (!Lang.ObjC3 || Current.isNot(tok::identifier) ||
+      !Current.getIdentifierInfo()->isStr("borrowed"))
+    return false;
+  // The word remains a general identifier, including borrowed(x), borrowed++,
+  // member selection, labels and declarations naming a variable borrowed.
