+/// A private migration AST node for the ObjC3 structured error handler.
+class ObjC3DoCatchStmt final : public Stmt,
+                               private llvm::TrailingObjects<ObjC3DoCatchStmt, Stmt *> {
+  friend class ASTStmtReader;
+  friend TrailingObjects;
+  SourceLocation DoLoc;
+  unsigned NumCatchClauses;
+  size_t numTrailingObjects(OverloadToken<Stmt *>) const { return NumCatchClauses + 1; }
+  Stmt **getStmts() { return getTrailingObjects(); }
+  Stmt *const *getStmts() const { return getTrailingObjects(); }
+  ObjC3DoCatchStmt(SourceLocation DoLoc, CompoundStmt *Body,
+                   ArrayRef<ObjC3CatchStmt *> Clauses);
+  ObjC3DoCatchStmt(EmptyShell Empty, unsigned NumCatchClauses)
+      : Stmt(ObjC3DoCatchStmtClass, Empty), NumCatchClauses(NumCatchClauses) {}
+public:
+  static ObjC3DoCatchStmt *Create(ASTContext &Context, SourceLocation DoLoc,
+      CompoundStmt *Body, ArrayRef<ObjC3CatchStmt *> Clauses);
+  static ObjC3DoCatchStmt *CreateEmpty(ASTContext &Context, EmptyShell Empty,
+                                       unsigned NumCatchClauses);
+  SourceLocation getDoLoc() const { return DoLoc; }
+  CompoundStmt *getBody() const { return cast<CompoundStmt>(getStmts()[0]); }
+  unsigned getNumCatchClauses() const { return NumCatchClauses; }
+  ObjC3CatchStmt *getCatchClause(unsigned I) const {
+    assert(I < NumCatchClauses);
+    return cast<ObjC3CatchStmt>(getStmts()[I + 1]);
+  }
+  SourceLocation getBeginLoc() const { return DoLoc; }
+  SourceLocation getEndLoc() const { return getCatchClause(NumCatchClauses - 1)->getEndLoc(); }
+  child_range children() { return child_range(getStmts(), getStmts() + NumCatchClauses + 1); }
+  const_child_range children() const { return const_child_range(getStmts(), getStmts() + NumCatchClauses + 1); }
+  static bool classof(const Stmt *S) { return S->getStmtClass() == ObjC3DoCatchStmtClass; }
+};
