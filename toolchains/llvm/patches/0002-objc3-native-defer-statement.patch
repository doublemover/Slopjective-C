+ObjC3DoCatchStmt::ObjC3DoCatchStmt(SourceLocation DoLoc,
+    CompoundStmt *Body, ArrayRef<ObjC3CatchStmt *> Clauses)
+    : Stmt(ObjC3DoCatchStmtClass), DoLoc(DoLoc),
