+/// Structured ObjC3 error transfer, kept separate from C++ ThrowExpr and
+/// Objective-C @throw statements.
+class ObjC3ThrowStmt : public Stmt {
+  friend class ASTStmtReader;
+  Stmt *Payload = nullptr;
+  SourceLocation KeywordLoc, SemiLoc;
+  ObjC3ThrowStmt(EmptyShell Empty) : Stmt(ObjC3ThrowStmtClass, Empty) {}
+  ObjC3ThrowStmt(SourceLocation KeywordLoc, Expr *Payload,
+                 SourceLocation SemiLoc);
+public:
+  static ObjC3ThrowStmt *CreateEmpty(ASTContext &Context, EmptyShell Empty);
+  static ObjC3ThrowStmt *Create(ASTContext &Context, SourceLocation KeywordLoc,
+                                Expr *Payload, SourceLocation SemiLoc);
+  Expr *getPayload() const { return reinterpret_cast<Expr *>(Payload); }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getSemiLoc() const { return SemiLoc; }
+  SourceLocation getBeginLoc() const { return KeywordLoc; }
+  SourceLocation getEndLoc() const { return SemiLoc; }
+  child_range children() { return child_range(&Payload, &Payload + 1); }
+  const_child_range children() const {
+    return const_child_range(&Payload, &Payload + 1);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3ThrowStmtClass;
+  }
+};
