+/// A typed ObjC3 catch clause. This remains distinct from CXXCatchStmt.
+class ObjC3CatchStmt : public Stmt {
+  friend class ASTStmtReader;
+  SourceLocation CatchLoc, LParenLoc, RParenLoc;
+  TypeSourceInfo *CatchTypeInfo = nullptr;
+  Stmt *SubStmts[2] = {nullptr, nullptr}; // optional binding DeclStmt, handler body
+  bool CatchAll = false;
+  ObjC3CatchStmt(EmptyShell Empty) : Stmt(ObjC3CatchStmtClass, Empty) {}
+  ObjC3CatchStmt(SourceLocation CatchLoc, SourceLocation LParenLoc,
+                 SourceLocation RParenLoc, TypeSourceInfo *CatchTypeInfo,
+                 DeclStmt *Binding, CompoundStmt *Body, bool CatchAll)
+      : Stmt(ObjC3CatchStmtClass), CatchLoc(CatchLoc), LParenLoc(LParenLoc),
+        RParenLoc(RParenLoc), CatchTypeInfo(CatchTypeInfo),
+        SubStmts{Binding, Body}, CatchAll(CatchAll) {}
+public:
+  static ObjC3CatchStmt *CreateEmpty(ASTContext &Context, EmptyShell Empty);
+  static ObjC3CatchStmt *Create(ASTContext &Context, SourceLocation CatchLoc,
+      SourceLocation LParenLoc, SourceLocation RParenLoc,
+      TypeSourceInfo *CatchTypeInfo, DeclStmt *Binding,
+      CompoundStmt *Body, bool CatchAll);
+  bool isCatchAll() const { return CatchAll; }
+  TypeSourceInfo *getCatchTypeInfo() const { return CatchTypeInfo; }
+  DeclStmt *getBindingDeclStmt() const { return cast_or_null<DeclStmt>(SubStmts[0]); }
+  CompoundStmt *getHandlerBody() const { return cast<CompoundStmt>(SubStmts[1]); }
+  SourceLocation getCatchLoc() const { return CatchLoc; }
+  SourceLocation getLParenLoc() const { return LParenLoc; }
+  SourceLocation getRParenLoc() const { return RParenLoc; }
+  SourceLocation getBeginLoc() const { return CatchLoc; }
+  SourceLocation getEndLoc() const { return getHandlerBody()->getEndLoc(); }
+  child_range children() { return child_range(SubStmts, SubStmts + 2); }
+  const_child_range children() const { return const_child_range(SubStmts, SubStmts + 2); }
+  static bool classof(const Stmt *S) { return S->getStmtClass() == ObjC3CatchStmtClass; }
+};
