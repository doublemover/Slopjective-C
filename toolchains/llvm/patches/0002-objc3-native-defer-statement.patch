+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fcxx-exceptions -fexceptions -fobjc-version=3 -fsyntax-only -ast-dump %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fcxx-exceptions -fexceptions -fobjc-version=3 -ast-print %s > %t
+// RUN: FileCheck %s --check-prefix=PRINT < %t
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fcxx-exceptions -fexceptions -fobjc-version=3 -fsyntax-only %t
+
+void record(int);
+
+void scopes_and_exits(int value) {
+  __objc3_defer { record(value); }
+  if (value)
+    __objc3_defer { record(value + 1); }
+
+  for (;;) {
+    __objc3_defer {
+      for (;;) {
+        break;
+      }
+      for (;;) {
+        continue;
+      }
+    }
+    break;
+  }
+
+  __objc3_defer { record(value + 2); }
+  return;
+}
+
+void exception_domains(int value) {
+  try {
+    __objc3_defer { throw value; }
+  } catch (...) {
+    record(value);
+  }
+
+  __objc3_defer {
+    auto nested = [] {
+      try {
+        throw 1;
+      } catch (...) {
+        return 2;
+      }
+    };
+    record(nested());
+  }
+}
+
+// A macro expansion is consumed by the ordinary preprocessor before the
+// parser considers the reserved implementation spelling.
+#define __objc3_defer(value) (value)
+#define defer(value) (value)
+int macro_uses() { return __objc3_defer(1) + defer(2); }
+
+// Macro expansion occurs before the contextual parser decision, so an alias
+// that deliberately expands to the reserved spelling selects the extension.
+#define defer_alias __objc3_defer
+void macro_alias_expands_to_extension() { defer_alias { record(3); } }
