diff --git a/clang/test/ObjC3/Parser/contextual-identifiers.m b/clang/test/ObjC3/Parser/contextual-identifiers.m
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Parser/contextual-identifiers.m
@@ -0,0 +1,20 @@
+// RUN: %clang_cc1 -x objective-c -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c -fobjc-version=3 -fsyntax-only %s
+
+typedef int let;
+
+@interface LegacyNames
+- (int)await:(int)defer;
+@end
+
+@implementation LegacyNames
+- (int)await:(int)defer { return defer; }
+@end
+
+int fn, var, defer, guard, match, async, await, actor, throws;
+
+int identifiers_remain_identifiers(LegacyNames *object) {
+  let declaration = fn;
+  return declaration + var + defer + guard + match + async + await + actor +
+         throws + [object await:defer];
+}
diff --git a/clang/test/ObjC3/Parser/contextual-identifiers.mm b/clang/test/ObjC3/Parser/contextual-identifiers.mm
new file mode 100644
--- /dev/null
+++ b/clang/test/ObjC3/Parser/contextual-identifiers.mm
@@ -0,0 +1,33 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fcxx-exceptions -fexceptions -fsyntax-only %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fcxx-exceptions -fexceptions -fobjc-version=3 -fsyntax-only %s
+
+typedef int let;
+
+int fn, var, defer, guard, match, async, await, actor, throws;
+
+let typedef_name_still_declares() { return fn; }
+
+struct Receiver {
+  int await(int value) { return value; }
+};
+
+int names_and_exception_syntax(Receiver *receiver) {
+  let value = defer;
+  try {
+    return fn + var + guard + match + async + await + actor + throws +
+           receiver->await(value);
+  } catch (...) {
+    return 0;
+  }
+}
+
+void nested_lambda_exception_domain() {
+  auto callback = [] {
+    try {
+      throw 1;
+    } catch (...) {
+      return 2;
+    }
+  };
+  (void)callback();
+}
