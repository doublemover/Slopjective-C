+void StmtPrinter::VisitObjC3ResultExpr(ObjC3ResultExpr *Node) {
+  switch (Node->getKind()) {
+  case ObjC3ResultExpr::Kind::Ok: OS << "__objc3_ok("; break;
+  case ObjC3ResultExpr::Kind::Err: OS << "__objc3_err("; break;
+  case ObjC3ResultExpr::Kind::IsOk: OS << "__objc3_is_ok("; break;
+  }
+  if (TypeSourceInfo *Info = Node->getSuccessTypeInfo()) {
+    Info->getType().print(OS, Policy);
+    OS << ", ";
+    Node->getErrorTypeInfo()->getType().print(OS, Policy);
+    OS << ", ";
+  }
+  if (Node->getPayload()) PrintExpr(Node->getPayload());
+  OS << ")";
+}
+
+void StmtPrinter::VisitObjC3OptionalExpr(ObjC3OptionalExpr *Node) {
+  switch (Node->getKind()) {
+  case ObjC3OptionalExpr::Kind::Some: OS << "__objc3_some("; break;
+  case ObjC3OptionalExpr::Kind::None: OS << "__objc3_none("; break;
+  case ObjC3OptionalExpr::Kind::HasValue: OS << "__objc3_has_value("; break;
+  }
+  if (TypeSourceInfo *Info = Node->getPayloadTypeInfo()) {
+    Info->getType().print(OS, Policy);
+    if (Node->getKind() == ObjC3OptionalExpr::Kind::Some) OS << ", ";
+  }
+  if (Node->getPayload()) PrintExpr(Node->getPayload());
+  OS << ")";
+}
+
 void StmtPrinter::VisitChooseExpr(ChooseExpr *Node) {
   OS << "__builtin_choose_expr(";
   PrintExpr(Node->getCond());
