+
+StmtResult Parser::ParseObjC3DoCatchStatement() {
+  assert(getLangOpts().ObjC3 && Tok.is(tok::identifier) &&
+         (Tok.getIdentifierInfo()->isStr("__objc3_do") || Tok.getIdentifierInfo()->isStr("handle")));
+  SourceLocation DoLoc = ConsumeToken();
+  ObjC3DoCatchContext *Handler = Actions.ActOnObjC3BeginDoCatch(DoLoc);
+  llvm::scope_exit AbortHandler(
+      [&] { Actions.ActOnObjC3AbortDoCatch(Handler); });
+
+  if (Tok.isNot(tok::l_brace))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+  StmtResult Body = ParseCompoundStatement();
+  if (Body.isInvalid())
+    return StmtError();
+  auto *CompoundBody = dyn_cast<CompoundStmt>(Body.get());
+  if (!CompoundBody)
+    return StmtError();
+  Actions.ActOnObjC3EndDoCatchBody(Handler);
+
+  SmallVector<ObjC3CatchStmt *, 2> Clauses;
+  while (Tok.isOneOf(tok::identifier, tok::kw_catch) && Tok.getIdentifierInfo() &&
+         (Tok.getIdentifierInfo()->isStr("__objc3_catch") ||
+          Tok.getIdentifierInfo()->isStr("catch"))) {
+    SourceLocation CatchLoc = ConsumeToken();
+    SourceLocation LParenLoc;
+    SourceLocation RParenLoc;
+    TypeResult CatchType;
+    IdentifierInfo *BindingName = nullptr;
+    SourceLocation BindingLoc;
+    bool CatchAll = Tok.isNot(tok::l_paren);
+
+    if (!CatchAll) {
+      BalancedDelimiterTracker Pattern(*this, tok::l_paren);
+      if (Pattern.consumeOpen())
+        return StmtError();
+      LParenLoc = Pattern.getOpenLocation();
+      CatchType = ParseTypeName();
+      if (CatchType.isInvalid()) {
+        Pattern.skipToEnd();
+        return StmtError();
+      }
+      if (Tok.is(tok::identifier)) {
+        BindingName = Tok.getIdentifierInfo();
+        BindingLoc = ConsumeToken();
+      }
+      if (Pattern.consumeClose())
+        return StmtError();
+      RParenLoc = Pattern.getCloseLocation();
+    }
+
+    if (Tok.isNot(tok::l_brace))
+      return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+
+    ParseScope CatchScope(this, Scope::DeclScope | Scope::ControlScope |
+                                    Scope::CatchScope);
+    DeclStmt *Binding = nullptr;
+    if (BindingName)
+      Binding = Actions.ActOnObjC3CatchBinding(
+          getCurScope(), CatchType.get(), CatchLoc, BindingName, BindingLoc);
+    if (BindingName && !Binding)
+      return StmtError();
+    ObjC3DoCatchContext *CatchContext = Actions.ActOnObjC3BeginCatchBody();
+    llvm::scope_exit AbortCatch(
+        [&] { Actions.ActOnObjC3AbortCatchBody(CatchContext); });
+    StmtResult HandlerBody = ParseCompoundStatement();
+    if (HandlerBody.isInvalid())
+      return StmtError();
+    auto *CompoundHandler = dyn_cast<CompoundStmt>(HandlerBody.get());
+    if (!CompoundHandler)
+      return StmtError();
+    Actions.ActOnObjC3EndCatchBody(CatchContext);
+    AbortCatch.release();
+
+    ObjC3CatchStmt *Clause = Actions.ActOnObjC3CatchClause(
+        CatchLoc, LParenLoc,
+        CatchType.isUsable() ? CatchType.get() : ParsedType(), RParenLoc,
+        Binding, CompoundHandler, CatchAll);
+    if (!Clause)
+      return StmtError();
+    Clauses.push_back(Clause);
+  }
+
+  StmtResult Result =
+      Actions.ActOnObjC3FinishDoCatch(Handler, CompoundBody, Clauses);
+  AbortHandler.release();
+  return Result;
+}
+
+ExprResult Parser::ParseObjC3CarrierTransferExpression() {
+  const bool IsMove = classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+                      ObjC3Syntax::Move;
+  const char *Name = Tok.getIdentifierInfo()->getNameStart();
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name,
+                              tok::r_paren))
+    return ExprError();
+  ExprResult Source = ParseAssignmentExpression();
+  if (Source.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3CarrierTransferExpr(
+      IsMove, Keyword, Parens.getOpenLocation(), Source.get(),
+      Parens.getCloseLocation());
+}
+
+StmtResult Parser::ParseObjC3DeferStatement() {
+  assert(Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+         (Tok.getIdentifierInfo()->isStr("__objc3_defer") ||
+          Tok.getIdentifierInfo()->isStr("defer")) &&
+         "Not an ObjC3 defer statement!");
+
+  SourceLocation DeferLoc = ConsumeToken();
+  Actions.ActOnStartOfDeferStmt(DeferLoc, getCurScope());
+  llvm::scope_exit OnError([&] { Actions.ActOnDeferStmtError(getCurScope()); });
+
+  // The first ObjC3 defer spelling is deliberately a compound statement.
+  // Parsing it through Clang's ordinary compound-statement path preserves its
+  // normal lexical scope, recovery, and source locations.
+  if (Tok.isNot(tok::l_brace))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+
+  StmtResult Body = ParseCompoundStatement();
+  if (!Body.isUsable())
+    return StmtError();
+
+  OnError.release();
+  StmtResult Result = Actions.ActOnEndOfDeferStmt(Body.get(), getCurScope());
+  if (Result.isUsable())
+    cast<DeferStmt>(Result.get())->setObjC3Spelling(true);
+  return Result;
+}
