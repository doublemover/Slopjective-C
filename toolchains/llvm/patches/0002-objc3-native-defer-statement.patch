+ExprResult Parser::ParseObjC3ResultExpression() {
+  const bool Ok = classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+                  ObjC3Syntax::Ok;
+  const bool Err = classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+                   ObjC3Syntax::Err;
+  const char *Name = Tok.getIdentifierInfo()->getNameStart();
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name,
+                              tok::r_paren))
+    return ExprError();
+  if (!Ok && !Err) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) {
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    if (Parens.consumeClose())
+      return ExprError();
+    return Actions.ActOnObjC3ResultIsOkExpr(Keyword, Parens.getOpenLocation(),
+                                            Operand.get(),
+                                            Parens.getCloseLocation());
+  }
+  TypeResult Success = ParseTypeName();
+  if (Success.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  SourceLocation FirstComma = ConsumeToken();
+  TypeResult Error = ParseTypeName();
+  if (Error.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  SourceLocation SecondComma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  if (Ok)
+    return Actions.ActOnObjC3ResultOkExpr(
+        Keyword, Parens.getOpenLocation(), Success.get(), FirstComma,
+        Error.get(), SecondComma, Payload.get(), Parens.getCloseLocation());
+  return Actions.ActOnObjC3ResultErrExpr(
+      Keyword, Parens.getOpenLocation(), Success.get(), FirstComma, Error.get(),
+      SecondComma, Payload.get(), Parens.getCloseLocation());
+}
+
+ExprResult Parser::ParseObjC3OptionalExpression() {
+  const bool Some = classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+                    ObjC3Syntax::Some;
+  const bool None = classifyObjC3Syntax(Tok.getIdentifierInfo()->getName()) ==
+                    ObjC3Syntax::None;
+  const char *Name = Tok.getIdentifierInfo()->getNameStart();
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name,
+                              tok::r_paren))
+    return ExprError();
+  if (!Some && !None) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) {
+      Parens.skipToEnd();
+      return ExprError();
+    }
+    if (Parens.consumeClose())
+      return ExprError();
+    return Actions.ActOnObjC3OptionalHasValueExpr(
+        Keyword, Parens.getOpenLocation(), Operand.get(),
+        Parens.getCloseLocation());
+  }
+  TypeResult PayloadType = ParseTypeName();
+  if (PayloadType.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (None) {
+    if (Parens.consumeClose())
+      return ExprError();
+    return Actions.ActOnObjC3OptionalNoneExpr(Keyword, Parens.getOpenLocation(),
+                                              PayloadType.get(),
+                                              Parens.getCloseLocation());
+  }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  SourceLocation Comma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3OptionalSomeExpr(Keyword, Parens.getOpenLocation(),
+                                            PayloadType.get(), Payload.get(),
+                                            Comma, Parens.getCloseLocation());
+}
+
+ExprResult Parser::ParseObjC3TryExpression() {
+  IdentifierInfo *II = Tok.getIdentifierInfo();
+  const bool Optional = (II->isStr("__objc3_try_optional") || II->isStr("tryOptional"));
+  const bool Force = (II->isStr("__objc3_try_force") || II->isStr("tryForce"));
+  const unsigned Kind = Optional ? 1 : Force ? 2 : 0;
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after,
+                              Optional ? "tryOptional"
+                              : Force  ? "tryForce"
+                                       : "tryValue",
+                              tok::r_paren))
+    return ExprError();
+  ExprResult Operand = ParseAssignmentExpression();
+  if (Operand.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3TryExpr(Kind, Keyword, Parens.getOpenLocation(),
+                                   Operand.get(), Parens.getCloseLocation());
+}
+
+StmtResult Parser::ParseObjC3ThrowStatement() {
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, "throwError",
+                              tok::r_paren))
+    return StmtError();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) {
+    Parens.skipToEnd();
+    return StmtError();
+  }
+  if (Parens.consumeClose())
+    return StmtError();
+  if (Tok.isNot(tok::semi))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::semi);
+  SourceLocation Semi = ConsumeToken();
+  return Actions.ActOnObjC3ThrowStmt(Keyword, Payload.get(), Semi);
