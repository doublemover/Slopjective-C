+  Record.AddTypeSourceInfo(S->getCatchTypeInfo());
+  Record.AddStmt(S->getBindingDeclStmt());
+  Record.AddStmt(S->getHandlerBody());
+  Record.push_back(S->isCatchAll());
+  Code = serialization::STMT_OBJC3_CATCH;
+}
+
+void ASTStmtWriter::VisitObjC3DoCatchStmt(ObjC3DoCatchStmt *S) {
+  VisitStmt(S);
+  Record.push_back(S->getNumCatchClauses());
+  Record.AddSourceLocation(S->getDoLoc());
+  Record.AddStmt(S->getBody());
+  for (unsigned I = 0; I != S->getNumCatchClauses(); ++I)
+    Record.AddStmt(S->getCatchClause(I));
+  Code = serialization::STMT_OBJC3_DO_CATCH;
+}
