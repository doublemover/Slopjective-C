+void StmtPrinter::VisitObjC3ResultExpr(ObjC3ResultExpr *Node) {
+  switch (Node->getKind()) {
+  case ObjC3ResultExpr::Kind::Ok: OS << "Ok("; break;
+  case ObjC3ResultExpr::Kind::Err: OS << "Err("; break;
+  case ObjC3ResultExpr::Kind::IsOk: OS << "isOk("; break;
+  }
+  if (TypeSourceInfo *Info = Node->getSuccessTypeInfo()) {
+    Info->getType().print(OS, Policy);
+    OS << ", ";
+    Node->getErrorTypeInfo()->getType().print(OS, Policy);
+    OS << ", ";
+  }
+  if (Node->getPayload()) PrintExpr(Node->getPayload());
+  OS << ")";
+}
+
+void StmtPrinter::VisitObjC3OptionalExpr(ObjC3OptionalExpr *Node) {
+  switch (Node->getKind()) {
+  case ObjC3OptionalExpr::Kind::Some: OS << "Some("; break;
+  case ObjC3OptionalExpr::Kind::None: OS << "None("; break;
+  case ObjC3OptionalExpr::Kind::HasValue: OS << "hasValue("; break;
+  }
+  if (TypeSourceInfo *Info = Node->getPayloadTypeInfo()) {
+    Info->getType().print(OS, Policy);
+    if (Node->getKind() == ObjC3OptionalExpr::Kind::Some) OS << ", ";
+  }
+  if (Node->getPayload()) PrintExpr(Node->getPayload());
+  OS << ")";
+}
+
+void StmtPrinter::VisitObjC3TryExpr(ObjC3TryExpr *Node) {
+  switch (Node->getKind()) {
+  case ObjC3TryExpr::Kind::Propagate: OS << "tryValue("; break;
+  case ObjC3TryExpr::Kind::Optionalize: OS << "tryOptional("; break;
+  case ObjC3TryExpr::Kind::Force: OS << "tryForce("; break;
+  }
+  PrintExpr(Node->getOperand());
+  OS << ")";
+}
+
+void StmtPrinter::VisitObjC3MatchArm(ObjC3MatchArm *Node) {
+  Indent(-1);
+  if (Node->getPatternKind() == objc3::MatchPatternKind::Default)
+    OS << "default";
+  else
+    OS << "case ";
+  switch (Node->getPatternKind()) {
+  case objc3::MatchPatternKind::BooleanTrue: OS << "true"; break;
+  case objc3::MatchPatternKind::BooleanFalse: OS << "false"; break;
+  case objc3::MatchPatternKind::OptionalSome:
+    OS << ".Some(";
+    if (Node->getBindingDecl()) {
+      OS << (Node->isMutableBinding() ? "var " : "let ");
+      OS << Node->getBindingDecl()->getName();
+    } else {
+      OS << "_";
+    }
+    OS << ")";
+    break;
+  case objc3::MatchPatternKind::OptionalNone: OS << ".None"; break;
+  case objc3::MatchPatternKind::ResultOK:
+  case objc3::MatchPatternKind::ResultErr:
+    OS << (Node->getPatternKind() == objc3::MatchPatternKind::ResultOK
+               ? ".Ok(" : ".Err(");
+    if (Node->getBindingDecl()) {
+      OS << (Node->isMutableBinding() ? "var " : "let ");
+      OS << Node->getBindingDecl()->getName();
+    }
+    OS << ")";
+    break;
+  case objc3::MatchPatternKind::Wildcard: OS << "_"; break;
+  case objc3::MatchPatternKind::Binding:
+    OS << (Node->isMutableBinding() ? "var " : "let ");
+    if (Node->getBindingDecl()) OS << Node->getBindingDecl()->getName();
+    break;
+  case objc3::MatchPatternKind::Default: break;
+  case objc3::MatchPatternKind::TypeTest: OS << "is <disabled>"; break;
+  case objc3::MatchPatternKind::MoveBinding: OS << "move <unsupported>"; break;
+  case objc3::MatchPatternKind::IntegerLiteral:
+  case objc3::MatchPatternKind::CharacterLiteral:
+  case objc3::MatchPatternKind::NilLiteral:
+  case objc3::MatchPatternKind::StringLiteral:
+    PrintExpr(Node->getPatternValue());
+    break;
+  }
+  if (Node->getGuard()) {
+    OS << " where ";
+    PrintExpr(Node->getGuard());
+  }
+  OS << (Node->hasExpressionBody() ? " => " : ":");
+  if (Node->hasExpressionBody()) {
+    PrintExpr(cast<Expr>(Node->getBody()));
+    OS << ";" << NL;
+  } else {
+    PrintStmt(Node->getBody(), 0);
+  }
+}
+void StmtPrinter::VisitObjC3MatchStmt(ObjC3MatchStmt *Node) {
+  Indent() << "match (";
+  PrintExpr(Node->getScrutinee());
+  OS << ") {" << NL;
+  IndentLevel++;
+  for (unsigned I = 0; I != Node->getNumArms(); ++I)
+    PrintStmt(Node->getArm(I));
+  --IndentLevel;
+  Indent() << "}";
+}
+void StmtPrinter::VisitObjC3MatchExpr(ObjC3MatchExpr *Node) {
+  Indent() << "match (";
+  PrintExpr(Node->getScrutinee());
+  OS << ") {" << NL;
+  IndentLevel++;
+  for (unsigned I = 0; I != Node->getNumArms(); ++I)
+    PrintStmt(Node->getArm(I));
+  --IndentLevel;
+  Indent() << "}";
+}
+
+void StmtPrinter::VisitObjC3ThrowStmt(ObjC3ThrowStmt *Node) {
+  OS << "throwError(";
+  PrintExpr(Node->getPayload());
+  OS << ");";
+}
+
+void StmtPrinter::VisitObjC3CatchStmt(ObjC3CatchStmt *Node) {
+  OS << "catch";
+  if (!Node->isCatchAll()) {
+    OS << "(";
+    Node->getCatchTypeInfo()->getType().print(OS, Policy);
+    if (Node->getBindingDeclStmt()) {
+      if (const auto *Binding = dyn_cast<VarDecl>(
+              Node->getBindingDeclStmt()->getSingleDecl()))
+        OS << " " << Binding->getName();
+    }
+    OS << ")";
+  }
+  OS << " ";
+  PrintStmt(Node->getHandlerBody());
+}
+
+void StmtPrinter::VisitObjC3DoCatchStmt(ObjC3DoCatchStmt *Node) {
+  OS << "handle ";
+  PrintStmt(Node->getBody());
+  for (unsigned I = 0; I != Node->getNumCatchClauses(); ++I) {
+    OS << " ";
+    PrintStmt(Node->getCatchClause(I));
+  }
+}
+
+void StmtPrinter::VisitObjC3CarrierTransferExpr(
+    ObjC3CarrierTransferExpr *Node) {
+  OS << (Node->isMove() ? "moveValue(" : "copyValue(");
+  PrintExpr(Node->getSource());
+  OS << ")";
+}
