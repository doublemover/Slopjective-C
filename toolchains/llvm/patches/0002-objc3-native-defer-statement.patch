diff --git a/clang/lib/Parse/ParseObjC3.cpp b/clang/lib/Parse/ParseObjC3.cpp
new file mode 100644
--- /dev/null
+++ b/clang/lib/Parse/ParseObjC3.cpp
@@ -0,0 +1,115 @@
+//===--- ParseObjC3.cpp - Slopjective-C parser ---------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Parse/Parser.h"
+#include "clang/Basic/DiagnosticParse.h"
+#include "clang/Parse/RAIIObjectsForParser.h"
+#include "llvm/ADT/ScopeExit.h"
+
+using namespace clang;
+
+ExprResult Parser::ParseObjC3ResultExpression() {
+  const bool Ok = Tok.getIdentifierInfo()->isStr("__objc3_ok");
+  const bool Err = Tok.getIdentifierInfo()->isStr("__objc3_err");
+  const char *Name = Ok ? "__objc3_ok" : Err ? "__objc3_err" : "__objc3_is_ok";
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name, tok::r_paren))
+    return ExprError();
+  if (!Ok && !Err) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3ResultIsOkExpr(Keyword, Parens.getOpenLocation(),
+        Operand.get(), Parens.getCloseLocation());
+  }
+  TypeResult Success = ParseTypeName();
+  if (Success.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation FirstComma = ConsumeToken();
+  TypeResult Error = ParseTypeName();
+  if (Error.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation SecondComma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Parens.consumeClose()) return ExprError();
+  if (Ok)
+    return Actions.ActOnObjC3ResultOkExpr(Keyword, Parens.getOpenLocation(),
+        Success.get(), FirstComma, Error.get(), SecondComma, Payload.get(),
+        Parens.getCloseLocation());
+  return Actions.ActOnObjC3ResultErrExpr(Keyword, Parens.getOpenLocation(),
+      Success.get(), FirstComma, Error.get(), SecondComma, Payload.get(),
+      Parens.getCloseLocation());
+}
+
+
+ExprResult Parser::ParseObjC3OptionalExpression() {
+  const bool Some = Tok.getIdentifierInfo()->isStr("__objc3_some");
+  const bool None = Tok.getIdentifierInfo()->isStr("__objc3_none");
+  const char *Name = Some ? "__objc3_some" : None ? "__objc3_none" : "__objc3_has_value";
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name, tok::r_paren))
+    return ExprError();
+  if (!Some && !None) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3OptionalHasValueExpr(Keyword, Parens.getOpenLocation(), Operand.get(), Parens.getCloseLocation());
+  }
+  TypeResult PayloadType = ParseTypeName();
+  if (PayloadType.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (None) {
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3OptionalNoneExpr(Keyword, Parens.getOpenLocation(), PayloadType.get(), Parens.getCloseLocation());
+  }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation Comma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Parens.consumeClose()) return ExprError();
+  return Actions.ActOnObjC3OptionalSomeExpr(Keyword, Parens.getOpenLocation(), PayloadType.get(), Payload.get(), Comma, Parens.getCloseLocation());
+}
+
+
+StmtResult Parser::ParseObjC3DeferStatement() {
+  assert(Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+         Tok.getIdentifierInfo()->isStr("__objc3_defer") &&
+         "Not an ObjC3 defer statement!");
+
+  SourceLocation DeferLoc = ConsumeToken();
+  Actions.ActOnStartOfDeferStmt(DeferLoc, getCurScope());
+  llvm::scope_exit OnError(
+      [&] { Actions.ActOnDeferStmtError(getCurScope()); });
+
+  // The first ObjC3 defer spelling is deliberately a compound statement.
+  // Parsing it through Clang's ordinary compound-statement path preserves its
+  // normal lexical scope, recovery, and source locations.
+  if (Tok.isNot(tok::l_brace))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+
+  StmtResult Body = ParseCompoundStatement();
+  if (!Body.isUsable())
+    return StmtError();
+
+  OnError.release();
+  StmtResult Result = Actions.ActOnEndOfDeferStmt(Body.get(), getCurScope());
+  if (Result.isUsable())
+    cast<DeferStmt>(Result.get())->setObjC3Spelling(true);
+  return Result;
+}
