+
+ExprResult Parser::ParseObjC3ResultExpression() {
+  const bool Ok = Tok.getIdentifierInfo()->isStr("__objc3_ok");
+  const bool Err = Tok.getIdentifierInfo()->isStr("__objc3_err");
+  const char *Name = Ok ? "__objc3_ok" : Err ? "__objc3_err" : "__objc3_is_ok";
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name, tok::r_paren))
+    return ExprError();
+  if (!Ok && !Err) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3ResultIsOkExpr(Keyword, Parens.getOpenLocation(),
+        Operand.get(), Parens.getCloseLocation());
+  }
+  TypeResult Success = ParseTypeName();
+  if (Success.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation FirstComma = ConsumeToken();
+  TypeResult Error = ParseTypeName();
+  if (Error.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation SecondComma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Parens.consumeClose()) return ExprError();
+  if (Ok)
+    return Actions.ActOnObjC3ResultOkExpr(Keyword, Parens.getOpenLocation(),
+        Success.get(), FirstComma, Error.get(), SecondComma, Payload.get(),
+        Parens.getCloseLocation());
+  return Actions.ActOnObjC3ResultErrExpr(Keyword, Parens.getOpenLocation(),
+      Success.get(), FirstComma, Error.get(), SecondComma, Payload.get(),
+      Parens.getCloseLocation());
+}
+
+
+ExprResult Parser::ParseObjC3OptionalExpression() {
+  const bool Some = Tok.getIdentifierInfo()->isStr("__objc3_some");
+  const bool None = Tok.getIdentifierInfo()->isStr("__objc3_none");
+  const char *Name = Some ? "__objc3_some" : None ? "__objc3_none" : "__objc3_has_value";
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after, Name, tok::r_paren))
+    return ExprError();
+  if (!Some && !None) {
+    ExprResult Operand = ParseAssignmentExpression();
+    if (Operand.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3OptionalHasValueExpr(Keyword, Parens.getOpenLocation(), Operand.get(), Parens.getCloseLocation());
+  }
+  TypeResult PayloadType = ParseTypeName();
+  if (PayloadType.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (None) {
+    if (Parens.consumeClose()) return ExprError();
+    return Actions.ActOnObjC3OptionalNoneExpr(Keyword, Parens.getOpenLocation(), PayloadType.get(), Parens.getCloseLocation());
+  }
+  if (Tok.isNot(tok::comma)) {
+    Diag(Tok, diag::err_expected) << tok::comma;
+    Parens.skipToEnd(); return ExprError();
+  }
+  SourceLocation Comma = ConsumeToken();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) { Parens.skipToEnd(); return ExprError(); }
+  if (Parens.consumeClose()) return ExprError();
+  return Actions.ActOnObjC3OptionalSomeExpr(Keyword, Parens.getOpenLocation(), PayloadType.get(), Payload.get(), Comma, Parens.getCloseLocation());
+}
+
+
+ExprResult Parser::ParseObjC3TryExpression() {
+  IdentifierInfo *II = Tok.getIdentifierInfo();
+  const bool Optional = II->isStr("__objc3_try_optional");
+  const bool Force = II->isStr("__objc3_try_force");
+  const unsigned Kind = Optional ? 1 : Force ? 2 : 0;
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after,
+                              Optional ? "__objc3_try_optional"
+                                       : Force ? "__objc3_try_force"
+                                               : "__objc3_try",
+                              tok::r_paren))
+    return ExprError();
+  ExprResult Operand = ParseAssignmentExpression();
+  if (Operand.isInvalid()) {
+    Parens.skipToEnd();
+    return ExprError();
+  }
+  if (Parens.consumeClose())
+    return ExprError();
+  return Actions.ActOnObjC3TryExpr(Kind, Keyword, Parens.getOpenLocation(),
+                                   Operand.get(), Parens.getCloseLocation());
+}
+
+StmtResult Parser::ParseObjC3ThrowStatement() {
+  SourceLocation Keyword = ConsumeToken();
+  BalancedDelimiterTracker Parens(*this, tok::l_paren);
+  if (Parens.expectAndConsume(diag::err_expected_lparen_after,
+                              "__objc3_throw", tok::r_paren))
+    return StmtError();
+  ExprResult Payload = ParseAssignmentExpression();
+  if (Payload.isInvalid()) {
+    Parens.skipToEnd();
+    return StmtError();
+  }
+  if (Parens.consumeClose())
+    return StmtError();
+  if (Tok.isNot(tok::semi))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::semi);
+  SourceLocation Semi = ConsumeToken();
+  return Actions.ActOnObjC3ThrowStmt(Keyword, Payload.get(), Semi);
+}
+
+StmtResult Parser::ParseObjC3DoCatchStatement() {
+  assert(getLangOpts().ObjC3 && Tok.is(tok::identifier) &&
+         Tok.getIdentifierInfo()->isStr("__objc3_do"));
+  SourceLocation DoLoc = ConsumeToken();
+  ObjC3DoCatchContext *Handler = Actions.ActOnObjC3BeginDoCatch(DoLoc);
+  llvm::scope_exit AbortHandler(
+      [&] { Actions.ActOnObjC3AbortDoCatch(Handler); });
+
+  if (Tok.isNot(tok::l_brace))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+  StmtResult Body = ParseCompoundStatement();
+  if (Body.isInvalid())
+    return StmtError();
+  auto *CompoundBody = dyn_cast<CompoundStmt>(Body.get());
+  if (!CompoundBody)
+    return StmtError();
+  Actions.ActOnObjC3EndDoCatchBody(Handler);
+
+  SmallVector<ObjC3CatchStmt *, 2> Clauses;
+  while (Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+         Tok.getIdentifierInfo()->isStr("__objc3_catch")) {
+    SourceLocation CatchLoc = ConsumeToken();
+    SourceLocation LParenLoc;
+    SourceLocation RParenLoc;
+    TypeResult CatchType;
+    IdentifierInfo *BindingName = nullptr;
+    SourceLocation BindingLoc;
+    bool CatchAll = Tok.isNot(tok::l_paren);
+
+    if (!CatchAll) {
+      BalancedDelimiterTracker Pattern(*this, tok::l_paren);
+      if (Pattern.consumeOpen())
+        return StmtError();
+      LParenLoc = Pattern.getOpenLocation();
+      CatchType = ParseTypeName();
+      if (CatchType.isInvalid()) {
+        Pattern.skipToEnd();
+        return StmtError();
+      }
+      if (Tok.is(tok::identifier)) {
+        BindingName = Tok.getIdentifierInfo();
+        BindingLoc = ConsumeToken();
+      }
+      if (Pattern.consumeClose())
+        return StmtError();
+      RParenLoc = Pattern.getCloseLocation();
+    }
+
+    if (Tok.isNot(tok::l_brace))
+      return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+
+    ParseScope CatchScope(this, Scope::DeclScope | Scope::ControlScope |
+                                    Scope::CatchScope);
+    DeclStmt *Binding = nullptr;
+    if (BindingName)
+      Binding = Actions.ActOnObjC3CatchBinding(getCurScope(), CatchType.get(),
+                                               CatchLoc, BindingName,
+                                               BindingLoc);
+    if (BindingName && !Binding)
+      return StmtError();
+    ObjC3DoCatchContext *CatchContext = Actions.ActOnObjC3BeginCatchBody();
+    llvm::scope_exit AbortCatch(
+        [&] { Actions.ActOnObjC3AbortCatchBody(CatchContext); });
+    StmtResult HandlerBody = ParseCompoundStatement();
+    if (HandlerBody.isInvalid())
+      return StmtError();
+    auto *CompoundHandler = dyn_cast<CompoundStmt>(HandlerBody.get());
+    if (!CompoundHandler)
+      return StmtError();
+    Actions.ActOnObjC3EndCatchBody(CatchContext);
+    AbortCatch.release();
+
+    ObjC3CatchStmt *Clause = Actions.ActOnObjC3CatchClause(
+        CatchLoc, LParenLoc, CatchType.isUsable() ? CatchType.get() : ParsedType(),
+        RParenLoc, Binding, CompoundHandler, CatchAll);
+    if (!Clause)
+      return StmtError();
+    Clauses.push_back(Clause);
+  }
+
+  StmtResult Result =
+      Actions.ActOnObjC3FinishDoCatch(Handler, CompoundBody, Clauses);
+  AbortHandler.release();
+  return Result;
+}
+
+StmtResult Parser::ParseObjC3DeferStatement() {
+  assert(Tok.is(tok::identifier) && Tok.getIdentifierInfo() &&
+         Tok.getIdentifierInfo()->isStr("__objc3_defer") &&
+         "Not an ObjC3 defer statement!");
+
+  SourceLocation DeferLoc = ConsumeToken();
+  Actions.ActOnStartOfDeferStmt(DeferLoc, getCurScope());
+  llvm::scope_exit OnError(
+      [&] { Actions.ActOnDeferStmtError(getCurScope()); });
+
+  // The first ObjC3 defer spelling is deliberately a compound statement.
+  // Parsing it through Clang's ordinary compound-statement path preserves its
+  // normal lexical scope, recovery, and source locations.
+  if (Tok.isNot(tok::l_brace))
+    return StmtError(Diag(Tok, diag::err_expected) << tok::l_brace);
+
+  StmtResult Body = ParseCompoundStatement();
+  if (!Body.isUsable())
+    return StmtError();
+
+  OnError.release();
+  StmtResult Result = Actions.ActOnEndOfDeferStmt(Body.get(), getCurScope());
+  if (Result.isUsable())
+    cast<DeferStmt>(Result.get())->setObjC3Spelling(true);
+  return Result;
+}
