diff --git a/clang/test/ObjC3/CodeGen/module-owned-inline-initialization.cpp b/clang/test/ObjC3/CodeGen/module-owned-inline-initialization.cpp
new file mode 100644
index 000000000..d8f7b608f
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/module-owned-inline-initialization.cpp
@@ -0,0 +1,21 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -O0 -emit-llvm %s -o - | FileCheck %s --check-prefixes=CHECK,O0
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -O0 -emit-llvm %s -o - | FileCheck %s --check-prefixes=CHECK,O0
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -O2 -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -O2 -emit-llvm %s -o - | FileCheck %s
+
+int initial() noexcept;
+inline int seeded __asm__("__objc3_m_seeded") = initial();
+inline int ordered __asm__("__objc3_m_ordered") = seeded + 2;
+static int observed = ordered;
+int read() { return observed; }
+
+// The guarded inline initializers and their dependent consumer must share a
+// single lexical startup chain. Independent COMDAT ctor entries permit O2's
+// constructor evaluator to fold the consumer's read to the zero initializer.
+// CHECK: @llvm.global_ctors = appending global [1 x {{.*}}ptr null
+// O0-LABEL: define internal void @_GLOBAL__sub_I_
+// O0: call void @__cxx_global_var_init()
+// The ordered inline definition is emitted on demand after the consumer,
+// but its reserved lexical position must still precede that consumer.
+// O0-NEXT: call void @__cxx_global_var_init.2()
+// O0-NEXT: call void @__cxx_global_var_init.1()
diff --git a/clang/test/ObjC3/CodeGen/module-owned-destructor-thunks.cpp b/clang/test/ObjC3/CodeGen/module-owned-destructor-thunks.cpp
new file mode 100644
index 000000000..a1f96dcf8
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/module-owned-destructor-thunks.cpp
@@ -0,0 +1,15 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -emit-llvm %s -o - | FileCheck %s
+
+struct Root { virtual ~Root() __asm__("__objc3_m_root_dtor"); };
+struct Side { virtual ~Side() = default; };
+struct Derived : Side, virtual Root {
+  ~Derived() override __asm__("__objc3_m_derived_dtor");
+};
+Derived::~Derived() = default;
+
+// The two virtual adjustment thunks must target different destructor phases.
+// Collapsing their names routes virtual delete through complete destruction,
+// which runs destructors but never calls operator delete.
+// CHECK-DAG: define {{.*}}void @_ZTv{{[^ (]*}}__objc3_m_derived_dtor_dtor_1v
+// CHECK-DAG: define {{.*}}void @_ZTv{{[^ (]*}}__objc3_m_derived_dtor_dtor_0v
