+Result local_result() __objc3_async_frame {
+  Result result{};
+  return result;
+}
+int (^block)(int) __objc3_async_frame = ^int(int value) __objc3_async_frame {
+  Scope scope(value);
+  return __objc3_await leaf(value);
+};
+__attribute__((objc_root_class)) @interface FrameOwner
+- (int)compute:(int)value __objc3_async_frame;
+@end
+@implementation FrameOwner
+- (int)compute:(int)value __objc3_async_frame {
+  Scope scope(value);
+  return __objc3_await leaf(value);
+}
+@end
