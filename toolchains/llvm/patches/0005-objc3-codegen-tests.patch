+  variadic_fixed(*value, 42); // expected-error {{ObjC3 carrier operation 'by-value call ABI'}}
+}
+#elif defined(TEST_BLOCK_FIXED)
+void caller(void (^block)(OptionalInt), OptionalInt *value) {
+  block(*value); // expected-error {{ObjC3 carrier operation 'runtime callable type encoding'}}
+}
+#elif defined(TEST_C_AGGREGATE)
+struct Wrapped { OptionalInt value; };
+extern void aggregate_sink(struct Wrapped);
+void caller(struct Wrapped *value) {
+  aggregate_sink(*value); // expected-error {{ObjC3 carrier operation 'by-value call ABI'}}
+}
+#elif defined(TEST_C_VECTORCALL)
+extern void __attribute__((vectorcall)) alternate_sink(OptionalInt);
+void caller(OptionalInt *value) {
+  alternate_sink(*value); // expected-error {{ObjC3 carrier operation 'by-value call ABI'}}
+}
+#endif
