@@ -0,0 +1,40 @@
+#ifndef OBJC3_NATIVE_INITIALIZER_H
+#define OBJC3_NATIVE_INITIALIZER_H
+#include "native-c-async-frame.h"
+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface InitializerRoot <Sendable>
+- (instancetype)initFrame:(int)kind __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+@end
+@interface InitializerChild : InitializerRoot @end
+@implementation InitializerRoot
+- (instancetype)initFrame:(int)kind __objc3_async_frame {return self;}
+@end
+static id retained_native_frame(void) __objc3_async_frame __attribute__((ns_returns_retained));
+static id retained_native_frame(void) __objc3_async_frame {return 0;}
+static id unretained_native_frame(void) __objc3_async_frame __attribute__((ns_returns_not_retained));
+static id unretained_native_frame(void) __objc3_async_frame {return 0;}
+static id autoreleased_native_frame(void) __objc3_async_frame __attribute__((ns_returns_autoreleased));
+static id autoreleased_native_frame(void) __objc3_async_frame {return 0;}
+static int unused_native_parameter(int unused) __objc3_async_frame {return 7;}
+static inline int initializer_cross(InitializerChild *object) __objc3_async_frame {
+#ifdef __cplusplus
+  auto value=__objc3_await [object initFrame:0];
+  static_assert(__is_same(__typeof__(*value),InitializerChild));
+#else
+  __auto_type value=__objc3_await [object initFrame:0];
+  _Static_assert(__builtin_types_compatible_p(__typeof__(*value),InitializerChild),"instancetype");
+#endif
+  return value!=0;
+}
+static inline int initializer_same_executor(InitializerChild *object) __objc3_async_frame __attribute__((objc_executor(main)));
+static inline int initializer_same_executor(InitializerChild *object) __objc3_async_frame {
+#ifdef __cplusplus
+  auto value=__objc3_await [object initFrame:0];
+  static_assert(__is_same(__typeof__(*value),InitializerChild));
+#else
+  __auto_type value=__objc3_await [object initFrame:0];
+  _Static_assert(__builtin_types_compatible_p(__typeof__(*value),InitializerChild),"instancetype");
+#endif
+  return value!=0;
+}
+#endif
