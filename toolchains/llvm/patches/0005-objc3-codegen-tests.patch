+void move_placement(void *storage,ObjectMaybe &source){::new(storage)ObjectMaybe(static_cast<ObjectMaybe &&>(source));}
+void generic_placement(void *storage,const ObjectMaybe &source){auto *value=object_construct_at(static_cast<ObjectMaybe *>(storage),source);object_destroy_at(value);}
+ObjectMaybe generic_read(const void *source){return object_read<ObjectMaybe>(source);}
+int array_copies(const ObjectMaybe &source){ObjectMaybe values[2]={source,source};auto *heap=new ObjectMaybe[2]{source,source};int count=__objc3_has_value(values[0])+__objc3_has_value(heap[1]);delete[]heap;return count;}
+ObjectResult result_copy(const ObjectResult &source){ObjectResult local(source);return local;}
+ObjectNested nested_copy(const ObjectNested &source){ObjectNested local(source);return local;}
+
+int functional_local_storage(const ObjectMaybe &source) {
+  auto value=ObjectMaybe(source);const ObjectMaybe &extended=ObjectMaybe(source);
+  (void)ObjectMaybe(source);(void)__objc3_copy(source);
+  if(__objc3_has_value(source))(void)ObjectMaybe(source);
+  return __objc3_has_value(value)+__objc3_has_value(extended);
+}
+
+struct ObjectTrivial {int code;ObjectTrivial(const ObjectTrivial &);};
+using TrivialObjectMaybe=__objc3_optional(ObjectTrivial);
+void discarded_trivial_copy(const TrivialObjectMaybe &source) {
+  (void)__objc3_copy(source);(void)TrivialObjectMaybe(source);
+}
+
+void scalar_delete(ObjectMaybe *value){delete value;}
