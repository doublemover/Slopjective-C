+#ifndef OBJC3_ASYNC_PROPERTY_CONTROLS_H
+#define OBJC3_ASYNC_PROPERTY_CONTROLS_H
+#ifdef __cplusplus
+#include "native-async-task.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>);
+#else
+#include "native-c-async-frame.h"
+#endif
+@protocol Sendable @end
+@protocol Error <Sendable> @end
+__attribute__((objc_root_class)) @interface AsyncPropertyHost <Sendable>
+@property(nonatomic) int value;
+- (int)value __objc3_async_frame __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+- (void)setValue:(int)value __objc3_async_frame __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+@property(nonatomic) int getterOnly;
+- (int)getterOnly __objc3_async_frame __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+- (void)setGetterOnly:(int)value __attribute__((nothrow,objc_executor(main)));
+@property(nonatomic) int setterOnly;
+- (int)setterOnly __attribute__((nothrow,objc_executor(main)));
+- (void)setSetterOnly:(int)value __objc3_async_frame __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+@property(nonatomic) int plain;
+- (int)plain __objc3_async_frame __attribute__((nothrow));
+- (void)setPlain:(int)value __objc3_async_frame __attribute__((nothrow));
+@property(nonatomic) int getterPlain;
+- (int)getterPlain __objc3_async_frame __attribute__((nothrow));
+- (void)setGetterPlain:(int)value __attribute__((nothrow));
+#ifdef __cplusplus
+@property(nonatomic) int taskValue;
+- (int)taskValue __objc3_async __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+- (void)setTaskValue:(int)value __objc3_async __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+#endif
+@end
+// Remaining on the caller's executor does not require Sendable admission.
+__attribute__((objc_root_class)) @interface LocalAsyncPropertyHost
+@property(nonatomic) int value;
+- (int)value __objc3_async_frame __attribute__((nothrow));
+- (void)setValue:(int)value __objc3_async_frame __attribute__((nothrow));
+@end
+static inline int local_async_property(LocalAsyncPropertyHost *object) __objc3_async_frame {
+  return __objc3_await (object.value+=1);
+}
+static inline int async_property_updates(AsyncPropertyHost *object,int value) __objc3_async_frame __objc3_throws(id<Error>) {
+  int result=__objc3_try(__objc3_await (object.value=value));
+  result+=__objc3_try(__objc3_await (object.value+=2));
+  result+=__objc3_try(__objc3_await object.value++);
+  result+=__objc3_try(__objc3_await --object.value);
+  result+=__objc3_try(__objc3_await (object.getterOnly+=1));
+  result+=__objc3_try(__objc3_await (object.setterOnly+=1));
+  result+=__objc3_try(__objc3_await object.value);
+  result+=__objc3_await (object.plain+=1);
+#ifdef __cplusplus
+  result+=__objc3_try(__objc3_await (object.taskValue+=1));
+#endif
+  return result;
+}
+#endif
