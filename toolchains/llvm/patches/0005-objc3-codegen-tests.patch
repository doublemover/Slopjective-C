+#ifndef NATIVE_DEPENDENT_TASK_AWAIT_H
+#define NATIVE_DEPENDENT_TASK_AWAIT_H
+#include "native-dependent-frame-await.h"
+template<class T> struct __attribute__((objc_unsafe_sendable)) DependentTaskEntries {
+  T sync(T value) noexcept __attribute__((objc_executor(main))) {return value;}
+  T frame(T value) noexcept __objc3_async_frame __attribute__((objc_executor(main))) {return value;}
+  T task(T value) noexcept __objc3_async __attribute__((objc_executor(main))) {return value;}
+  int scalar(T value) noexcept __attribute__((objc_executor(main))) {return (int)value;}
+  T forward(T value) __objc3_async {return __objc3_await sync(value);}
+};
+template<class T> static T dependent_task_parent(T value) __objc3_async {
+  DependentTaskEntries<T> receiver;
+  T first=__objc3_await receiver.sync(value);
+  T second=__objc3_await receiver.frame(first);
+  return __objc3_await receiver.task(second);
+}
+template<class T> static int dependent_task_known_result(T value) __objc3_async {
+  DependentTaskEntries<T> receiver;
+  return __objc3_await receiver.scalar(value);
+}
+template<class Work> static int dependent_task_callback(Work work) __objc3_async {
+  return __objc3_await work(42);
+}
+template<class Awaiter> static int dependent_task_awaiter(Awaiter value) __objc3_async {
+  return __objc3_await value;
+}
+static int dependent_task_plain(int value) noexcept {return value;}
+static int dependent_task_frame(int value) __objc3_async_frame {return value;}
+static int dependent_task_task(int value) __objc3_async {return value;}
+template<int Bias> static int dependent_task_value_only(int value) __objc3_async {
+  return __objc3_await dependent_task_plain(value+Bias);
+}
+namespace DependentTaskADL {
+struct Token {};
+struct Ready {
+  bool await_ready() noexcept {return true;}
+  void await_suspend(std::coroutine_handle<>) noexcept {}
+  int await_resume() noexcept {return 42;}
+};
+Ready operator co_await(Token) noexcept;
+}
+template<class Work> static objc3::task<int> ordinary_task_awaiter(Work work) {
+  co_return co_await work;
+}
+#endif
