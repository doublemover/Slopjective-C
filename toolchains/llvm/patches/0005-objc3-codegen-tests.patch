+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -triple x86_64-pc-windows-msvc -DTEST_VARIADIC_FIXED -emit-llvm -o %t.fixed.ll -verify %s
+// RUN: test ! -e %t.fixed.ll
