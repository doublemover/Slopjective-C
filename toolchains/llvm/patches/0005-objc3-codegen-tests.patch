+@protocol Error @end
+id<Error> get_error();
+struct Owner {
+  int value;
+  Owner(int);
+  Owner(const Owner &);
+  ~Owner() noexcept(false);
+};
+using Maybe = __objc3_optional(Owner);
+__attribute__((objc_root_class)) @interface Host
+- (Maybe)echo:(Maybe)owner;
++ (Maybe)checked:(Maybe)owner fail:(bool)fail __objc3_throws(id<Error>);
+@end
