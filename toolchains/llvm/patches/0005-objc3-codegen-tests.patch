index 000000000..5a4a1a83b
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/native-actor-self-debug.m
@@ -0,0 +1,27 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-strict-concurrency -fobjc-arc -debug-info-kind=standalone -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-strict-concurrency -debug-info-kind=standalone -O2 -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-strict-concurrency -debug-info-kind=standalone -emit-llvm %s -o - | FileCheck %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc3-strict-concurrency -fobjc-arc -debug-info-kind=standalone -O2 -emit-llvm %s -o - | FileCheck %s
+
+// Receiver isolation is a semantic type qualifier. Debug information keeps
+// the native object-pointer representation for both implicit self parameters.
+// CHECK: ![[ISOLATED:[0-9]+]] = distinct !DISubprogram(name: "-[DebugActor update:]"
+// CHECK: !DILocalVariable(name: "self", arg: 1, scope: ![[ISOLATED]], {{.*}}DIFlagObjectPointer
+// CHECK: ![[PLAIN:[0-9]+]] = distinct !DISubprogram(name: "-[DebugActor plain]"
+// CHECK: !DILocalVariable(name: "self", arg: 1, scope: ![[PLAIN]], {{.*}}DIFlagObjectPointer
+
+__attribute__((objc_root_class))
+@interface DebugRoot { Class isa; }
+@end
+@implementation DebugRoot
+@end
+
+actor class DebugActor : DebugRoot { int value; }
+- (int)update:(int)amount;
+- (int)plain __attribute__((objc_nonisolated));
+@end
+
+@implementation DebugActor
+- (int)update:(int)amount { return value += amount; }
+- (int)plain { return 17; }
+@end
