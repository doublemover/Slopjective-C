+extern "C" RegisterEmpty native_checked_register_empty(bool fail,id<Error> error) __objc3_throws(id<Error>) {if(fail)__objc3_throw(error);return {};}
+struct RegisterPair {long value,other;};
+struct RegisterMixed {double value;int other;};
+struct RegisterLarge {long value,other[4];};
+struct [[clang::trivial_abi]] RegisterOwner {long value;explicit RegisterOwner(int);RegisterOwner(const RegisterOwner &);RegisterOwner(RegisterOwner &&);~RegisterOwner() noexcept;};
+template<class T>T register_checked(int mode,id<Error> error) __objc3_throws(id<Error>) {
+  if(mode==1)__objc3_throw(error);
+  T value{47};if(mode==2)__objc3_throw(error);return value;
+}
+extern "C" RegisterSmall native_checked_register_small(int mode,id<Error> error) __objc3_throws(id<Error>) {return __objc3_try(register_checked<RegisterSmall>(mode,error));}
+extern "C" RegisterPair native_checked_register_pair(int mode,id<Error> error) __objc3_throws(id<Error>) {return __objc3_try(register_checked<RegisterPair>(mode,error));}
+extern "C" RegisterMixed native_checked_register_mixed(int mode,id<Error> error) __objc3_throws(id<Error>) {return __objc3_try(register_checked<RegisterMixed>(mode,error));}
+extern "C" RegisterLarge native_checked_register_large(int mode,id<Error> error) __objc3_throws(id<Error>) {return __objc3_try(register_checked<RegisterLarge>(mode,error));}
+extern "C" RegisterOwner native_checked_register_owner(int mode,id<Error> error) __objc3_throws(id<Error>) {return __objc3_try(register_checked<RegisterOwner>(mode,error));}
+extern "C" int native_checked_register_optional(int mode,id<Error> error) {
+  auto small=__objc3_try_optional(register_checked<RegisterSmall>(mode,error));
+  auto owner=__objc3_try_optional(register_checked<RegisterOwner>(mode,error));
+  __objc3_try_optional(register_checked<RegisterSmall>(mode,error));
+  __objc3_try_optional(register_checked<RegisterOwner>(mode,error));
+  return __objc3_has_value(small)+__objc3_has_value(owner);
+}
