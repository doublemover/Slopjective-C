+#include "Inputs/native-c-async-frame.h"
+extern void entered(int);
+extern void destroyed(int);
+struct Scope {
+  int value;
+  Scope(int value) : value(value) { entered(value); }
+  ~Scope() { destroyed(value); }
+};
