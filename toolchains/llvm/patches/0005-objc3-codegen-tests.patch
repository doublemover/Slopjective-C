+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fsanitize=signed-integer-overflow -emit-llvm -o - %s | FileCheck %s --check-prefix=LE
+// RUN: %clang_cc1 -triple powerpc64-unknown-linux-gnu -std=c17 -fsanitize=signed-integer-overflow -emit-llvm -o - %s | FileCheck %s --check-prefix=BE
+// The descriptor suffix stores a leading zero, the exact 32-bit width in
+// target byte order, and a terminating zero, before the array terminator.
+// Do not truncate embedded zeros.
+_BitInt(31) checked_bitint_sum(_BitInt(31) left, _BitInt(31) right) {
+  return left + right;
+}
+// LE: c"'_BitInt(31)'\00\1F\00\00\00\00\00"
+// BE: c"'_BitInt(31)'\00\00\00\00\1F\00\00"
