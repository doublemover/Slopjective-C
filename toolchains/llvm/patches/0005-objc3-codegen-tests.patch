index 000000000..3c8928725
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/native-mrc-task-consumption.h
@@ -0,0 +1,37 @@
+#ifndef NATIVE_MRC_TASK_CONSUMPTION_H
+#define NATIVE_MRC_TASK_CONSUMPTION_H
+#include "native-async-task.h"
+#include "native-c-async-frame.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>) noexcept;
+@protocol Sendable @end
+extern "C" void task_manual_release(id) __asm__("objc_release");
+__attribute__((objc_root_class)) @interface ManualTaskRoot <Sendable>
+- (int)consumeTask __objc3_async __attribute__((nothrow,ns_consumes_self,objc_executor(main)));
+@end
+extern ManualTaskRoot *manual_task_source() __attribute__((ns_returns_retained));
+static int manual_task_entry(__attribute__((ns_consumed)) ManualTaskRoot *value)
+    noexcept __objc3_async __attribute__((objc_executor(main)));
+static int manual_task_entry(__attribute__((ns_consumed)) ManualTaskRoot *value)
+    noexcept __objc3_async {
+  int result = value != 0;
+#if !__has_feature(objc_arc)
+  task_manual_release(value);
+#endif
+  return result;
+}
+@implementation ManualTaskRoot
+- (int)consumeTask __objc3_async {
+  int result = self != 0;
+#if __has_feature(objc_arc)
+  self = manual_task_source();
+#else
+  task_manual_release(self);
+#endif
+  return result;
+}
+@end
+static int manual_task_parent() __objc3_async_frame {
+  int result = __objc3_await manual_task_entry(manual_task_source());
+  return result + __objc3_await [manual_task_source() consumeTask];
+}
+#endif
