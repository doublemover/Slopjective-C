+// O0: store ptr {{.*}}, ptr %objc3.carrier.payload.addr2, align 8
+
+// O0-LABEL: define{{.*}} void @replace_array(
+// O0: call void @[[ARRAYCOPY:__objc3_v12_storage_2_[0-9A-F]+]](
+// O0: call void @[[ARRAYMOVE:__objc3_v12_storage_5_[0-9A-F]+]](
