+}
+#elif REGION == 7
+void unselected_result_local() {
+  StorageResult value{}; // expected-error {{local lifetime}}
+}
+#else
+void volatile_destruction(volatile Maybe *value) {
+  value->~Maybe(); // expected-error {{nontrivial carrier explicit destruction}}
+}
