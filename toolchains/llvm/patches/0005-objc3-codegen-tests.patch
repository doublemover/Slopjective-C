+#include "native-explicit-cxx-storage.h"
+#ifndef NO_EXCEPTION_HOOK
+inline int __objc3_async_capture_current_exception(void **out) noexcept {*out=nullptr;return 0;}
+#endif
+struct __attribute__((objc_unsafe_sendable)) FrameExceptionValue {
+  int value;
+  FrameExceptionValue(int);
+  FrameExceptionValue(const FrameExceptionValue &);
+  FrameExceptionValue(FrameExceptionValue &&);
+  ~FrameExceptionValue() noexcept;
+};
+struct __attribute__((objc_unsafe_sendable)) FrameExceptionMove {
+  FrameExceptionMove(int);
+  FrameExceptionMove(const FrameExceptionMove &)=delete;
+  FrameExceptionMove(FrameExceptionMove &&);
+  ~FrameExceptionMove() noexcept;
+};
+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface FrameExceptionHost <Sendable>
+@property(nonatomic) FrameExceptionValue value;
+- (FrameExceptionValue)value __attribute__((objc_executor(main)));
+- (void)setValue:(FrameExceptionValue)value __attribute__((objc_executor(main)));
+@property(nonatomic) FrameExceptionMove move;
+- (FrameExceptionMove)move __attribute__((objc_executor(main)));
+- (void)setMove:(FrameExceptionMove)value __attribute__((objc_executor(main)));
+@end
+int throwing_isolated_entry(int) __attribute__((objc_executor(main)));
+inline void typed_setters(FrameExceptionHost *object,FrameExceptionValue *value) __objc3_async_frame {
+  __objc3_await (object.value=*value);
+  __objc3_await (object.value=FrameExceptionValue(42));
+  __objc3_await (object.move=FrameExceptionMove(43));
+}
+inline int throwing_entry(FrameExceptionHost *object) __objc3_async_frame {
+  FrameExceptionValue result=__objc3_await object.value;
+  return __objc3_await throwing_isolated_entry(result.value);
+}
+inline int direct_exception() __objc3_async_frame {throw 44;}
+#endif
