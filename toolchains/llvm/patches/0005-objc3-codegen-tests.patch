+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple aarch64-unknown-linux-gnu -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+
+@protocol Error @end
+extern id<Error> vector_error(void);
+typedef float Four __attribute__((ext_vector_type(4)));
+struct Packet { Four lanes; long stamp[3]; };
+
+// CHECK-LABEL: define {{.*}}@checked_packet(
+// CHECK-SAME: sret(%struct.Packet) align 16
+// CHECK: fadd <4 x float>
+struct Packet checked_packet(struct Packet input, int fail) throws(id<Error>) {
+  if (fail) __objc3_throw(vector_error());
+  input.lanes += (Four){1, 2, 3, 4};
+  return input;
+}
+
+// CHECK-LABEL: define {{.*}}@copied_optional_lane(
+// CHECK: load <4 x float>, ptr %objc3.carrier.payload.addr
+// CHECK: store <4 x float>
+// CHECK: extractelement <4 x float>
+float copied_optional_lane(Four input) {
+  Optional(Four) first = Some(Four, input);
+  Optional(Four) second = None(Four);
+  second = first;
+  return match(second) {
+    case .Some(let lane) => lane[2];
+    case .None => -1.0f;
+  };
+}
+
+// CHECK-LABEL: define {{.*}}@checked_lane(
+// CHECK: call void @checked_packet(
+// CHECK-SAME: ptr noundef %objc3.error.out
+// CHECK: br i1 {{.*}}, label %objc3.try.failure, label %objc3.try.success
+// CHECK: extractelement <4 x float>
+float checked_lane(struct Packet input) {
+  struct Packet packet = try! checked_packet(input, 0);
+  return packet.lanes[2];
+}
