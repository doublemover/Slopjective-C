+// RUN: test ! -e %t.block.ll
+// RUN: %clang_cc1 -x objective-c -std=c17 -fblocks -fobjc-version=3 -triple x86_64-pc-windows-msvc -DTEST_C_AGGREGATE -emit-llvm -o %t.aggregate.ll -verify %s
