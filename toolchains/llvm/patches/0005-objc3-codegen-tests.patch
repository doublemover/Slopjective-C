@@ -0,0 +1,33 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -Werror=return-type -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -Wno-vla-cxx-extension -Werror=return-type -emit-obj -o %t.20.o %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fexceptions -fobjc-exceptions -Wno-vla-cxx-extension -O2 -Werror=return-type -emit-obj -o %t.23.o %s
+// Both cleanup copies have local labels, local declarations and VLA size SSA.
+#ifdef __cplusplus
+extern "C" {
+#endif
+void may_throw(void);
+void consume(int *) __attribute__((nothrow));
+void copies(int count) {
+  defer {
+    int values[count];
+    values[0] = count;
+    goto end;
+  label:
+    consume(values);
+    goto done;
+  end:
+    goto label;
+  done:;
+  }
+  may_throw();
+}
+int returns_after_cleanup(int value) {
+  defer { consume(&value); }
+  return value;
+}
+#ifdef __cplusplus
+}
+#endif
+// CHECK-LABEL: define {{.*}}void @copies
+// CHECK: call void @consume
+// CHECK: call void @consume
