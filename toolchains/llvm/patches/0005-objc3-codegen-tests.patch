+#ifndef OBJC3_NATIVE_NIL_FRAMES_H
+#define OBJC3_NATIVE_NIL_FRAMES_H
+#include "native-c-async-frame.h"
+@protocol Sendable @end
+typedef const struct NilOpaque *NilCFRef;
+struct NilRecord {int value;double weight;};
+__attribute__((objc_root_class)) @interface NilRoot <Sendable>
+- (instancetype)initNative __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+- (instancetype)initDirectNative __objc3_async_frame __attribute__((objc_direct,nothrow,objc_executor(main)));
+- (int)scalar:(__attribute__((ns_consumed)) id)value __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+- (struct NilRecord)record __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+- (NilCFRef)foreign:(__attribute__((cf_consumed)) NilCFRef)value __objc3_async_frame __attribute__((cf_returns_retained,nothrow,objc_executor(main)));
+@end
+@implementation NilRoot
+- (instancetype)initDirectNative __objc3_async_frame {return self;}
+@end
+static inline int nil_frame_parent(NilRoot *receiver, __attribute__((ns_consumed)) id value,
+                                  __attribute__((cf_consumed)) NilCFRef foreign) __objc3_async_frame {
+  int result=__objc3_await [receiver scalar:value];
+  result+=(__objc3_await [receiver initNative])!=0;
+  result+=(__objc3_await [receiver initDirectNative])!=0;
+  result+=(__objc3_await [receiver foreign:foreign])!=0;
+  struct NilRecord record=__objc3_await [receiver record];
+  return result+record.value;
+}
