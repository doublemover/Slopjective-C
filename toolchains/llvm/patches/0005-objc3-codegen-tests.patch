+// expected-no-diagnostics
+#include "Inputs/native-async-task.h"
+@protocol Error @end
+struct Prefix { virtual ~Prefix() {} long padding; };
+struct Base {
+  virtual int value(int) const __objc3_async = 0;
+  virtual int checked(bool, id<Error>) const __objc3_async __objc3_throws(id<Error>) = 0;
+};
+struct Worker : Prefix, Base {
+  int bias;
+  int value(int n) const __objc3_async override { return bias + n; }
+  int checked(bool fail, id<Error> error) const __objc3_async __objc3_throws(id<Error>) override {
+    if (fail) __objc3_throw(error);
+    return bias;
+  }
+  static int constant() __objc3_async { return 7; }
+  int operator()(int n) const __objc3_async { return __objc3_await value(n); }
+  int operator[](int n) const __objc3_async { return bias + n; }
+  int operator-() const __objc3_async { return -bias; }
+  int qualified() & __objc3_async { return bias; }
+  int qualified() && __objc3_async { return bias + 1; }
+#if __cplusplus > 202002L
+  int explicit_object(this Worker self, int n) __objc3_async { return self.bias + n; }
+#endif
+};
+int operator+(const Worker &w, int n) __objc3_async { return __objc3_await w.value(n); }
+using Member = int (Worker::*)(int) const __objc3_async;
+using CheckedMember = int (Base::*)(bool, id<Error>) const __objc3_async __objc3_throws(id<Error>);
+int invoke(Worker &w, Base &b, Member member, CheckedMember checked, id<Error> error)
+    __objc3_async __objc3_throws(id<Error>) {
+  int a = __objc3_await b.value(1);
+  int c = __objc3_await (w.*member)(2);
+  int d = __objc3_try(__objc3_await (b.*checked)(false, error));
+  int e = __objc3_await w(3);
+  int f = __objc3_await w[4];
+  int g = __objc3_await -w;
+  int h = __objc3_await (w + 5);
+  return a + c + d + e + f + g + h + __objc3_await Worker::constant();
+}
+Worker instantiate;
