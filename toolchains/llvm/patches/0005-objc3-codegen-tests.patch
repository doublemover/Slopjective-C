@@ -0,0 +1,54 @@
+#ifndef OBJC3_NATIVE_TASK_RESULTS_H
+#define OBJC3_NATIVE_TASK_RESULTS_H
+#include "native-async-task.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>);
+@protocol Sendable @end
+typedef const struct TaskForeign *TaskCFRef;
+extern "C" const void *CFRetain(const void *) __attribute__((nothrow,cf_returns_retained));
+extern "C" void CFRelease(const void *) __attribute__((nothrow));
+__attribute__((objc_root_class)) @interface TaskResultRoot <Sendable>
+- (instancetype)initTask:(int)kind __objc3_async __attribute__((nothrow,objc_executor(main)));
+- (instancetype)initDirectTask __objc3_async __attribute__((objc_direct,nothrow,objc_executor(main)));
++ (instancetype)newTask __objc3_async __attribute__((nothrow,objc_executor(main)));
+- (TaskCFRef)foreignTask __objc3_async __attribute__((cf_returns_retained,nothrow,objc_executor(main)));
+- (TaskCFRef)borrowedTask __objc3_async __attribute__((cf_returns_not_retained,nothrow,objc_executor(main)));
+- (int)nilTask:(__attribute__((ns_consumed)) id)object __objc3_async;
+@end
+@interface TaskResultChild : TaskResultRoot @end
+@implementation TaskResultRoot
+- (instancetype)initTask:(int)kind __objc3_async {return kind ? self : 0;}
+- (instancetype)initDirectTask __objc3_async {return self;}
++ (instancetype)newTask __objc3_async {return 0;}
+- (TaskCFRef)foreignTask __objc3_async {return 0;}
+- (TaskCFRef)borrowedTask __objc3_async {return 0;}
+- (int)nilTask:(__attribute__((ns_consumed)) id)object __objc3_async {return 1;}
+@end
+static id owned_result_task(void) __objc3_async __attribute__((ns_returns_retained));
+static id owned_result_task(void) __objc3_async {return 0;}
+static TaskCFRef owned_foreign_task(void) __objc3_async __attribute__((cf_returns_retained));
+static TaskCFRef owned_foreign_task(void) __objc3_async {return 0;}
+static TaskCFRef borrowed_foreign_task(void) __objc3_async __attribute__((cf_returns_not_retained));
+static TaskCFRef borrowed_foreign_task(void) __objc3_async {return 0;}
+static inline int task_result_caller(TaskResultChild *object) __objc3_async __attribute__((nothrow,objc_executor(main)));
+static inline int task_result_caller(TaskResultChild *object) __objc3_async {
+  auto result = __objc3_await [object initTask:1];
+  static_assert(__is_same(__typeof__(*result),TaskResultChild));
+  auto family = __objc3_await [TaskResultChild newTask];
+  static_assert(__is_same(__typeof__(*family),TaskResultChild));
+  auto direct = __objc3_await [object initDirectTask];
+  static_assert(__is_same(__typeof__(*direct),TaskResultChild));
+  return result != 0 && family != 0 && direct != 0 &&
+      (__objc3_await owned_result_task()) != 0 &&
+      (__objc3_await owned_foreign_task()) != 0 &&
+      (__objc3_await borrowed_foreign_task()) != 0 &&
+      (__objc3_await [object foreignTask]) != 0 &&
+      (__objc3_await [object borrowedTask]) != 0;
+}
+static inline int frame_result_caller(TaskResultChild *object) __objc3_async_frame {
+  auto result = __objc3_await [object initTask:1];
+  static_assert(__is_same(__typeof__(*result),TaskResultChild));
+  auto family = __objc3_await [TaskResultChild newTask];
+  static_assert(__is_same(__typeof__(*family),TaskResultChild));
+  return result != 0 && family != 0 && (__objc3_await [object foreignTask]) != 0;
+}
+#endif
