+#ifndef NATIVE_TASK_FRAME_INTEROP_H
+#define NATIVE_TASK_FRAME_INTEROP_H
+#include "native-async-task.h"
+#include "native-c-async-frame.h"
+template<class T>
+objc3_async_frame __objc3_async_to_frame(objc3::task<T>) noexcept;
+int task_frame_leaf(int) noexcept __objc3_async;
+int task_frame_isolated(int) noexcept __objc3_async
+    __attribute__((objc_executor(main)));
+static int task_frame_direct(int value) __objc3_async_frame {
+  return __objc3_await task_frame_leaf(value);
+}
+static int task_frame_isolation(int value) __objc3_async_frame {
+  return __objc3_await task_frame_isolated(value);
+}
+@protocol Sendable @end
+__attribute__((objc_root_class)) @interface TaskFrameRoot <Sendable>
+- (int)taskValue:(int)value __objc3_async __attribute__((nothrow,objc_executor(main)));
++ (int)taskClassValue:(int)value __objc3_async __attribute__((nothrow,objc_executor(main)));
+@end
+static int task_frame_message(TaskFrameRoot *object,int value) __objc3_async_frame {
+  return __objc3_await [object taskValue:value];
+}
+@interface TaskFrameDerived : TaskFrameRoot
+- (int)superTask __objc3_async_frame;
++ (int)superClassTask __objc3_async_frame;
+@end
+@implementation TaskFrameDerived
+- (int)superTask __objc3_async_frame {
+  return __objc3_await [super taskValue:42];
+}
++ (int)superClassTask __objc3_async_frame {
+  return __objc3_await [super taskClassValue:42];
+}
+@end
+#endif
