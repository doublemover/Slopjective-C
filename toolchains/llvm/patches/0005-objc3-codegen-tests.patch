+++ b/clang/test/ObjC3/CodeGen/Inputs/native-cxx-member-isolation.h
@@ -0,0 +1,55 @@
+#ifndef NATIVE_CXX_MEMBER_ISOLATION_H
+#define NATIVE_CXX_MEMBER_ISOLATION_H
+#include "native-explicit-cxx-storage.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>);
+struct __attribute__((objc_unsafe_sendable)) MemberEntry {
+  int value;
+  MemberEntry();
+  MemberEntry(const MemberEntry &);
+  ~MemberEntry() noexcept;
+  int run(int) & noexcept __attribute__((objc_executor(main)));
+  int read(int) const & noexcept __attribute__((objc_executor(main)));
+  int take(int) && noexcept __attribute__((objc_executor(main)));
+  int frame(int) noexcept __objc3_async_frame __attribute__((objc_executor(main)));
+  int task(int) noexcept __objc3_async __attribute__((objc_executor(main)));
+  virtual int dispatch(int) noexcept __attribute__((objc_executor(main)));
+  static int static_entry(int) noexcept __attribute__((objc_executor(main)));
+  template<class T> T generic(T value) noexcept __attribute__((objc_executor(main))) {return value;}
+private:
+  int private_entry(int) noexcept __attribute__((objc_executor(main)));
+public:
+  int through_private(int value) __objc3_async_frame {return __objc3_await private_entry(value);}
+};
+struct __attribute__((objc_unsafe_sendable)) DerivedMemberEntry : MemberEntry {
+  int dispatch(int) noexcept override;
+};
+MemberEntry &member_receiver(int *evaluations);
+int member_argument(int *evaluations);
+static int member_native_calls(MemberEntry &object, const MemberEntry &readonly,
+    DerivedMemberEntry &derived, int *evaluations) __objc3_async_frame {
+  int result=__objc3_await object.run(1);
+  result+=__objc3_await readonly.read(2);
+  result+=__objc3_await static_cast<MemberEntry&&>(object).take(3);
+  result+=__objc3_await object.frame(4);
+  result+=__objc3_await object.task(5);
+  result+=__objc3_await derived.dispatch(6);
+  result+=__objc3_await derived.MemberEntry::dispatch(7);
+  result+=__objc3_await object.generic<int>(8);
+  result+=__objc3_await object.through_private(11);
+  result+=__objc3_await member_receiver(evaluations).run(member_argument(evaluations));
+  result+=__objc3_await member_receiver(evaluations).static_entry(member_argument(evaluations));
+  result+=__objc3_await MemberEntry().take(9);
+  return result;
+}
+static int member_task_calls(MemberEntry &object) __objc3_async {
+  return __objc3_await object.run(10);
+}
+template<class T> struct __attribute__((objc_unsafe_sendable)) DependentMemberEntry {
+  int entry(T value) noexcept __attribute__((objc_executor(main))) {return (int)value;}
+  int forward(T value) __objc3_async_frame {return __objc3_await entry(value);}
+};
+static int member_known_dependent_result(void) __objc3_async_frame {
+  DependentMemberEntry<int> receiver;
+  return __objc3_await receiver.forward(42);
+}
+#endif
