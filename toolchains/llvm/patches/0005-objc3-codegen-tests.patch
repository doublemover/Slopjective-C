+
+#ifndef ALIGNMENT_PCH
+#define ALIGNMENT_PCH
+typedef Optional(id) Managed;
+struct Inner { Managed object; };
+#pragma pack(push, 1)
+struct Envelope {
+  char prefix;
+  struct Inner inner;
+};
+struct Array {
+  char prefix;
+  Managed values[2];
+};
+#pragma pack(pop)
+struct Field {
+  char prefix;
+  struct Inner inner __attribute__((packed));
+};
+#else
+#ifndef PACKED_FIRST
+void ordinary(struct Inner *out, const struct Inner *in) { *out = *in; }
+#endif
+void replace_inner(struct Envelope *out, const struct Inner *in) {
