+#ifndef OBJC3_MRC_RECORD_PAYLOADS_H
+#define OBJC3_MRC_RECORD_PAYLOADS_H
+extern "C" id mrc_hold(id value);
+extern "C" void mrc_drop(id value);
+extern "C" void *mrc_block_copy(const void *value);
+extern "C" void mrc_block_release(const void *value);
+struct MRCPayload {
+  id value;explicit MRCPayload(id value):value(mrc_hold(value)){}
+  MRCPayload(const MRCPayload &other):value(mrc_hold(other.value)){}
+  MRCPayload(MRCPayload &&other)noexcept:value(other.value){other.value=0;}
+  ~MRCPayload()noexcept{mrc_drop(value);}
+};
+struct MRCTrivial {id value;int code;};
+struct MRCBlockPayload {
+  void (^value)(void);
+  explicit MRCBlockPayload(void (^value)(void)):value((void(^)(void))mrc_block_copy(value)){}
+  MRCBlockPayload(const MRCBlockPayload &other):value((void(^)(void))mrc_block_copy(other.value)){}
+  MRCBlockPayload(MRCBlockPayload &&other)noexcept:value(other.value){other.value=0;}
+  ~MRCBlockPayload()noexcept{mrc_block_release(value);}
+};
+typedef __objc3_optional(MRCPayload) MRCMaybe;
+typedef __objc3_result(MRCPayload,MRCBlockPayload) MRCResult;
+typedef __objc3_optional(MRCTrivial) MRCView;
+typedef __objc3_optional(MRCMaybe) MRCNested;
+struct MRCRecord {MRCMaybe values[2];};
+union MRCUnion {struct Owned {MRCMaybe value;} owned;int scalar;
+  MRCUnion(MRCPayload owner):owned{__objc3_some(MRCPayload,static_cast<MRCPayload &&>(owner))}{}
+  MRCUnion(const MRCUnion &other):owned(other.owned){}
+  ~MRCUnion()noexcept{owned.~Owned();}
+};
+MRCMaybe mrc_echo(MRCMaybe value);
+__attribute__((objc_root_class)) @interface MRCPayloadHost
+-(MRCMaybe)echo:(MRCMaybe)value;
+@end
+#endif
