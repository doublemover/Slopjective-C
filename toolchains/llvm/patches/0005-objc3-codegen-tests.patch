+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c -std=c17 -fblocks -fexceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-llvm -o - %s | FileCheck %s --check-prefix=C
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -x objective-c++ -std=c++20 -fblocks -fexceptions -fcxx-exceptions -fobjc-arc-exceptions -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fobjc-arc -emit-llvm -o - %s | FileCheck %s --check-prefix=CPP
+// REQUIRES: x86-registered-target
+// Ordinary C and C++ records share an indirect result and callee-owned argument.
+typedef __objc3_optional(id) Strong;
+typedef __objc3_optional(id __weak) Weak;
+struct Record { int marker; Strong first; Weak weak; Strong values[2]; id object; };
+#ifdef __cplusplus
+extern "C"
+#endif
+struct Record record_echo(struct Record value) { return value; }
+// C-LABEL: define{{.*}} void @record_echo(ptr {{.*}}sret(%struct.Record){{.*}}, ptr noundef align 8 dead_on_return %value)
+// C: {{call|invoke}} void @__objc3_v12_storage_2_
+// C: {{call|invoke}} void @__objc3_v12_storage_1_
+// C: ret void
+// C-LABEL: define internal void @__objc3_v12_storage_2_
+// C: llvm.objc.retain
+// C: llvm.objc.copyWeak
+// C: objc3.storage.array.header
+// C: llvm.objc.retain
+// C-LABEL: define internal void @__objc3_v12_storage_1_
+// C: llvm.objc.storeStrong
+// C: arraydestroy
+// C: llvm.objc.destroyWeak
+// CPP-LABEL: define{{.*}} void @record_echo(ptr {{.*}}sret(%struct.Record){{.*}}, ptr noundef align 8 dead_on_return %value)
+// CPP: call void @_ZN6RecordC1EOS_
+// CPP: call void @_ZN6RecordD1Ev
+// CPP: ret void
+void record_assign(struct Record *dst,struct Record *src) { *dst=*src; }
+// C-LABEL: define{{.*}} void @record_assign
+// C: objc3.record.assign.snapshot
+// C: @__objc3_v12_storage_2_
+// C: @__objc3_v12_storage_5_
+// CPP-LABEL: define{{.*}} void {{.*}}record_assign
+// CPP: call {{.*}} @_ZN6RecordaSERKS_
+
+// A zero-width separator has no storage-unit lvalue. Named bitfields remain
+// copied as native values while the enclosing record owns managed carriers.
+struct Separated { Strong value; unsigned first : 2; unsigned : 0; unsigned last : 3; };
+#ifdef __cplusplus
+extern "C"
+#endif
+struct Separated separated_echo(struct Separated value) { return value; }
+// C-LABEL: define{{.*}} void @separated_echo
+// C: @__objc3_v12_storage_
+// CPP-LABEL: define{{.*}} void @separated_echo
