--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/typed-error-c-record.m
@@ -0,0 +1,41 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -x objective-c -std=c23 -triple aarch64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fobjc-arc -emit-llvm -o - %s | FileCheck %s
+
+@protocol Error @end
+struct Direct { int x, y; };
+struct Indirect { long data[4]; };
+
+struct Direct checked_register(struct Direct value, id<Error> failure)
+    __objc3_throws(id<Error>) {
+  if (failure) __objc3_throw(failure);
+  ++value.x;
+  return value;
+}
+
+struct Indirect checked_indirect(struct Indirect value, id<Error> failure)
+    __objc3_throws(id<Error>) {
+  if (failure) __objc3_throw(failure);
+  ++value.data[2];
+  return value;
+}
+
+int optional_register(int input, id<Error> failure) {
+  __objc3_optional(struct Direct) value =
+      __objc3_try_optional(checked_register((struct Direct){input, 2}, failure));
+  return __objc3_has_value(value);
+}
+
+int optional_indirect(long input, id<Error> failure) {
+  __objc3_optional(struct Indirect) value =
+      __objc3_try_optional(checked_indirect((struct Indirect){{1, input, 3, 4}}, failure));
+  return __objc3_has_value(value);
+}
+
+// CHECK-LABEL: define {{.*}}i64 @checked_register(i64 {{[^,]+}}, ptr {{[^,]+}}, ptr
+// CHECK-LABEL: define {{.*}}void @checked_indirect(ptr {{[^,]*}}sret(%struct.Indirect)
