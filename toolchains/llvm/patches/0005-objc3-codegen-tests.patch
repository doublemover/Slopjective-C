+// A secondary-base virtual thunk returns the task carrier through sret.
+// CHECK: define {{.*}}void @_ZThn16_NK6Worker5valueEi(ptr {{.*}}sret
+// CHECK: define {{.*}}void @_ZThn16_NK6Worker7checkedEbPU15objcproto5Error11objc_object(ptr {{.*}}sret
