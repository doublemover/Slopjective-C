+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++20 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -disable-llvm-passes -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -emit-pch -o %t %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -std=c++23 -fobjc-version=3 -fobjc-runtime=gnustep-2.2 -fblocks -include-pch %t -x objective-c++ /dev/null -disable-llvm-passes -emit-llvm -o - | FileCheck %s
+#include "Inputs/native-c-async-frame.h"
+struct Noncopyable {
+  Noncopyable(const Noncopyable &) = delete;
+  ~Noncopyable();
+  int value;
+};
+extern int leaf() __objc3_async_frame;
+// DEBUG-LABEL: define{{.*}} @_Z6borrowR11Noncopyable
+// DEBUG: #dbg_declare(ptr %value.async.reference,
+// CHECK-LABEL: define{{.*}} @_Z6borrowR11Noncopyable
+// CHECK: %value.async.reference = alloca ptr, align 8
+// CHECK: load ptr, ptr %value.addr
+// CHECK: store ptr {{.*}}, ptr %value.async.reference
+// CHECK: @llvm.coro.suspend
+// CHECK: load ptr, ptr %value.async.reference
+int borrow(Noncopyable &value) __objc3_async_frame {
+  __objc3_await leaf();
+  return value.value;
+}
+struct Receiver {
+  int value;
+  int run() const & __objc3_async_frame;
+};
+// CHECK-LABEL: define{{.*}} @_ZNKR8Receiver3runEv
+// CHECK: @llvm.coro.suspend
+// CHECK: getelementptr inbounds nuw %struct.Receiver
+int Receiver::run() const & __objc3_async_frame {
+  __objc3_await leaf();
+  return value;
+}
