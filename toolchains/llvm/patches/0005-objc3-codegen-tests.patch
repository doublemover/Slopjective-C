+struct TemplateBlockSmall {int value;};
+template<class T,class E>T native_template_checked_source(int mode,E error) __objc3_throws(E) {
+  if(mode)__objc3_throw(error);return T{47};
+}
+template<class T,class E>T native_template_checked_block(int mode,E error) __objc3_throws(E) {
+  auto factory=^T(int input) __objc3_throws(E){return __objc3_try(native_template_checked_source<T,E>(input,error));};
+  return __objc3_try(factory(mode));
+}
+extern "C" int native_template_block_small(int mode,id<Error> error) {
+  auto value=__objc3_try_optional(native_template_checked_block<TemplateBlockSmall>(mode,error));
+  return __objc3_has_value(value);
+}
+extern "C" int native_template_block_owner(int mode,id<Error> error) {
+  auto value=__objc3_try_optional(native_template_checked_block<CheckedCompilerResult>(mode,error));
+  return __objc3_has_value(value);
+}
