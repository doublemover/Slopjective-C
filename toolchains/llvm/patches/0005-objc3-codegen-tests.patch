diff --git a/clang/test/ObjC3/CodeGen/Inputs/native-union-keypaths.h b/clang/test/ObjC3/CodeGen/Inputs/native-union-keypaths.h
new file mode 100644
index 000000000..7ed2d71da
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/native-union-keypaths.h
@@ -0,0 +1,25 @@
+#ifndef OBJC3_NATIVE_UNION_KEYPATH_CONTROLS
+#define OBJC3_NATIVE_UNION_KEYPATH_CONTROLS
+#include "../../Inputs/keypath-abi.h"
+struct NativeUnionArm {int tag;id owner;id __weak observer;int value;};
+union NativePathUnion {
+ NativeUnionArm owned;struct Plain {int tag,value;} plain;
+ NativePathUnion();NativePathUnion(const NativePathUnion &);
+ NativePathUnion(NativePathUnion &&) noexcept;~NativePathUnion();
+};
+struct NativePathEnvelope {int prefix;NativePathUnion active;};
+__attribute__((objc_root_class)) @interface NativeUnionPathRoot
+@property(nonatomic) NativePathUnion active;
+@property(nonatomic) NativePathEnvelope envelope;
+@property(nonatomic,strong) NativeUnionPathRoot *_Nullable next;
+@end
+static inline NativePathUnion native_union_whole(NativeUnionPathRoot *_Nonnull root) {
+ return KeyPathGet(@keypath(NativeUnionPathRoot,active),root);
+}
+static inline void native_union_write(NativeUnionPathRoot *_Nonnull root,NativePathUnion value,id owner) {
+ KeyPathSet(@keypath(NativeUnionPathRoot,active),root,value);
+ root[@keypath(NativeUnionPathRoot,envelope.active.owned.value)]=42;
+ root[@keypath(NativeUnionPathRoot,active.owned.owner)]=owner;
+ KeyPathSet(@keypath(NativeUnionPathRoot,next.active.owned.observer),root,owner);
+}
+#endif
