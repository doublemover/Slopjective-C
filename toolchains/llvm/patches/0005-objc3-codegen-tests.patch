+#ifndef NATIVE_CF_CONSUMPTION_H
+#define NATIVE_CF_CONSUMPTION_H
+#include "native-c-async-frame.h"
+#ifdef __cplusplus
+#include "native-async-task.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>) noexcept;
+extern "C" {
+#endif
+typedef const struct __CFNativeObject *NativeCFRef;
+extern const void *CFRetain(const void *) __attribute__((nothrow));
+extern void CFRelease(const void *) __attribute__((nothrow));
+extern NativeCFRef cf_source(void) __attribute__((cf_returns_retained));
+extern int cf_sync(__attribute__((cf_consumed)) NativeCFRef)
+    __attribute__((nothrow,objc_executor(main)));
+#ifdef __cplusplus
+}
+#endif
+#ifdef __cplusplus
+typedef int CFConsumedSignature(__attribute__((cf_consumed)) NativeCFRef) noexcept;
+#else
+typedef int CFConsumedSignature(__attribute__((cf_consumed)) NativeCFRef);
+#endif
+extern CFConsumedSignature cf_type_entry __attribute__((nothrow,objc_executor(main)));
+#ifdef __cplusplus
+#define CF_NATIVE_NOEXCEPT noexcept
+#else
+#define CF_NATIVE_NOEXCEPT
+#endif
+static int cf_native(__attribute__((cf_consumed)) NativeCFRef value) CF_NATIVE_NOEXCEPT
+    __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+static int cf_native(__attribute__((cf_consumed)) NativeCFRef value) CF_NATIVE_NOEXCEPT __objc3_async_frame {
+  int result = value != 0;
+  if (value) CFRelease(value);
+  return result;
+}
+#ifdef __cplusplus
+static int cf_task(__attribute__((cf_consumed)) NativeCFRef value)
+    noexcept __objc3_async __attribute__((objc_executor(main)));
+static int cf_task(__attribute__((cf_consumed)) NativeCFRef value) noexcept __objc3_async {
+  int result = value != 0;
+  if (value) CFRelease(value);
+  return result;
+}
+#endif
+#ifdef __cplusplus
+typedef int CFAliasedFrame(__attribute__((cf_consumed)) NativeCFRef) noexcept __objc3_async_frame;
+typedef int CFAliasedTask(__attribute__((cf_consumed)) NativeCFRef) noexcept __objc3_async;
+static CFAliasedFrame cf_alias_frame __attribute__((objc_executor(main)));
+static CFAliasedTask cf_alias_task __attribute__((objc_executor(main)));
+static int cf_alias_frame(__attribute__((cf_consumed)) NativeCFRef value) noexcept __objc3_async_frame {
+  int result = value != 0;
+  if (value) CFRelease(value);
+  return result;
+}
+static int cf_alias_task(__attribute__((cf_consumed)) NativeCFRef value) noexcept __objc3_async {
+  int result = value != 0;
+  if (value) CFRelease(value);
+  return result;
+}
+#endif
+static int cf_parent(void) __objc3_async_frame {
+  int result = __objc3_await cf_sync(cf_source());
+  result += __objc3_await cf_type_entry(cf_source());
+  result += __objc3_await cf_native(cf_source());
+#ifdef __cplusplus
+  result += __objc3_await cf_task(cf_source());
+  result += __objc3_await cf_alias_frame(cf_source());
+  result += __objc3_await cf_alias_task(cf_source());
+#endif
+  return result;
+}
+#endif
