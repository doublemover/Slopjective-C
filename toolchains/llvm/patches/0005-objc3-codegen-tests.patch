+#if defined(TEST_RECORD_COPY)
+void copy_record_containing_carrier(void) {
+  destination_record = source_record; // expected-error {{ObjC3 carrier operation 'enclosing aggregate copy'}}
+}
+#elif defined(TEST_ARRAY_MEMBER_COPY)
+void copy_record_containing_carrier_array(void) {
