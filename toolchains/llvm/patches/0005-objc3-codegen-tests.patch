+#ifndef OBJC3_CHECKED_CPP_RESULT_CONTROLS_H
+#define OBJC3_CHECKED_CPP_RESULT_CONTROLS_H
+#include "native-async-task.h"
+template<class T> void __objc3_async_frame_capture(void *,void *) {static_assert(__is_constructible(T,T&&) && __is_nothrow_destructible(T));}
+template<class T> const void *__objc3_async_frame_value_ops() {static_assert(__is_constructible(T,const T&) && __is_nothrow_destructible(T));return nullptr;}
+@protocol Sendable @end
+@protocol Error <Sendable> @end
+struct __attribute__((objc_unsafe_sendable)) CheckedCompilerResult {
+  int value;explicit CheckedCompilerResult(int) noexcept;
+  CheckedCompilerResult(const CheckedCompilerResult &) noexcept;
+  CheckedCompilerResult(CheckedCompilerResult &&) noexcept;
+  ~CheckedCompilerResult() noexcept;
+};
+CheckedCompilerResult checked_compiler_source(int) __objc3_throws(id<Error>);
+struct CheckedCompilerParameter {CheckedCompilerParameter() noexcept;~CheckedCompilerParameter() noexcept(false);};
+CheckedCompilerResult checked_compiler_parameter(CheckedCompilerParameter) __objc3_throws(id<Error>);
+static inline int checked_compiler_initialize() __objc3_throws(id<Error>) {
+  CheckedCompilerResult value=__objc3_try(checked_compiler_parameter(CheckedCompilerParameter()));
+  return value.value;
+}
+static inline CheckedCompilerResult checked_compiler_forward(int mode) __objc3_throws(id<Error>) {
+  return __objc3_try(checked_compiler_source(mode));
+}
+__attribute__((objc_root_class)) @interface CheckedCompilerHost <Sendable>
+@property(nonatomic) CheckedCompilerResult value;
+- (CheckedCompilerResult)value __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+- (void)setValue:(CheckedCompilerResult)value __objc3_throws(id<Error>) __attribute__((nothrow,objc_executor(main)));
+@end
+static inline int checked_compiler_property(CheckedCompilerHost *object) __objc3_async_frame __objc3_throws(id<Error>) {
+  CheckedCompilerResult value=__objc3_try(__objc3_await object.value);
+  __objc3_try(__objc3_await (object.value=value));return value.value;
+}
+struct CheckedCompilerAggregate {CheckedCompilerResult first,second;int tail;};
+struct CheckedCompilerReferences {const CheckedCompilerResult &first;int tail;};
+int checked_compiler_integer(int) __objc3_throws(id<Error>);
+static inline int checked_compiler_regions(int mode,bool selected) __objc3_throws(id<Error>) {
+  CheckedCompilerResult conditional=selected
+      ?__objc3_try(checked_compiler_parameter(CheckedCompilerParameter()))
+      :__objc3_try(checked_compiler_parameter(CheckedCompilerParameter()));
+  CheckedCompilerAggregate aggregate={__objc3_try(checked_compiler_source(0)),
+      __objc3_try(checked_compiler_parameter(CheckedCompilerParameter())),
+      __objc3_try(checked_compiler_integer(mode))};
+  CheckedCompilerReferences references={__objc3_try(checked_compiler_source(0)),
+      __objc3_try(checked_compiler_integer(mode))};
+  return conditional.value+aggregate.tail+references.first.value;
+}
+struct CheckedCompilerHeap {
+  CheckedCompilerResult first;int tail;
+  static void *operator new(__SIZE_TYPE__);static void operator delete(void *) noexcept;
+  static void *operator new[](__SIZE_TYPE__);static void operator delete[](void *) noexcept;
+};
+static inline int checked_compiler_storage(int mode,bool selected) __objc3_throws(id<Error>) {
+  CheckedCompilerHeap *single=selected
+      ?new CheckedCompilerHeap{__objc3_try(checked_compiler_source(0)),__objc3_try(checked_compiler_integer(mode))}
+      :new CheckedCompilerHeap{__objc3_try(checked_compiler_source(0)),__objc3_try(checked_compiler_integer(mode))};
+  delete single;
+  CheckedCompilerHeap *array=new CheckedCompilerHeap[2]{
+      {__objc3_try(checked_compiler_source(0)),19},
+      {__objc3_try(checked_compiler_source(0)),__objc3_try(checked_compiler_integer(mode))}};
+  delete[] array;
+  static CheckedCompilerResult persistent=__objc3_try_force(checked_compiler_parameter(CheckedCompilerParameter()));
+  static thread_local CheckedCompilerResult local=__objc3_try_force(checked_compiler_parameter(CheckedCompilerParameter()));
+  return persistent.value+local.value;
+}
+#endif
