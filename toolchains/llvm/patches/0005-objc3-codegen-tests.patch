+  MRCMaybe array[2]={mrc_make(value),mrc_make(value)};auto *heap=new MRCMaybe[2]{mrc_make(value),mrc_make(value)};
+  int result=__objc3_has_value(heap[0])+__objc3_has_value(array[1])+__objc3_has_value(copied.values[1]);delete[]heap;
+  return result;
