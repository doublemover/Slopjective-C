index 000000000..5567ddeb6
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/native-explicit-cxx-storage.h
@@ -0,0 +1,47 @@
+#ifndef NATIVE_EXPLICIT_CXX_STORAGE_H
+#define NATIVE_EXPLICIT_CXX_STORAGE_H
+#include "native-async-task.h"
+// Compile-only hooks enforce the same admission as the installed runtime.
+// The maintained native fixture executes the real operations and lifetimes.
+template<class T> void __objc3_async_frame_capture(void *,void *) {
+  static_assert(__is_constructible(T,T&&) && __is_nothrow_destructible(T));
+}
+template<class T> const void *__objc3_async_frame_value_ops() {
+  static_assert(__is_constructible(T,const T&) && __is_nothrow_destructible(T));
+  return nullptr;
+}
+union __attribute__((objc_unsafe_sendable)) ExplicitUnion {
+  id object;long integer;
+  explicit ExplicitUnion(id);
+  ExplicitUnion(const ExplicitUnion &);
+  ExplicitUnion(ExplicitUnion &&);
+  ~ExplicitUnion() noexcept;
+  int value() const;
+};
+struct __attribute__((objc_unsafe_sendable)) ExplicitWrapper {
+  ExplicitUnion storage;
+  explicit ExplicitWrapper(id);
+  ExplicitWrapper(const ExplicitWrapper &);
+  ExplicitWrapper(ExplicitWrapper &&);
+  ~ExplicitWrapper() noexcept;
+  int value() const;
+};
+ExplicitUnion explicit_union_entry(ExplicitUnion) noexcept __attribute__((objc_executor(main)));
+ExplicitWrapper explicit_wrapper_entry(ExplicitWrapper) noexcept __attribute__((objc_executor(main)));
+struct ExplicitStaticEntries {
+  static ExplicitUnion run(ExplicitUnion) noexcept __attribute__((objc_executor(main)));
+};
+static int explicit_storage_native(void) __objc3_async_frame {
+  ExplicitUnion value((id)0);
+  ExplicitUnion first=__objc3_await explicit_union_entry(static_cast<ExplicitUnion &&>(value));
+  ExplicitUnion second=__objc3_await ExplicitStaticEntries::run(static_cast<ExplicitUnion &&>(first));
+  ExplicitWrapper wrapper((id)0);
+  ExplicitWrapper result=__objc3_await explicit_wrapper_entry(static_cast<ExplicitWrapper &&>(wrapper));
+  return second.value()+result.value();
+}
+static int explicit_storage_task(void) __objc3_async {
+  ExplicitUnion value((id)0);
+  ExplicitUnion result=__objc3_await ExplicitStaticEntries::run(static_cast<ExplicitUnion &&>(value));
+  return result.value();
+}
+#endif
