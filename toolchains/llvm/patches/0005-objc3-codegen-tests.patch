+// REQUIRES: x86-registered-target
+@protocol Error @end
+typedef __objc3_optional(id) Strong;
+typedef __objc3_result(id, id __weak) Mixed;
+void fail(void) __objc3_throws(id<Error>);
+Strong value(Strong input, int error) __objc3_throws(id<Error>) {
+  if (error) __objc3_try(fail());
+  return input;
+}
+// CHECK-LABEL: define{{.*}} void {{.*}}value{{.*}}sret(
+// CHECK-NOT: byval
+// CHECK-NOT: dead_on_return
+// CHECK: objc3.error.out
+// CHECK: objc3.try.failure
+// CHECK: objc3.arc.error.return.empty
+// CHECK: llvm.memset
+// CHECK: objc3.error.publish
+// CHECK: llvm.objc.autorelease
+Strong forward(Strong input) __objc3_throws(id<Error>) {
+  return __objc3_try(value(input, 1));
+}
+// CHECK-LABEL: define{{.*}} void {{.*}}forward{{.*}}sret(
+// CHECK: objc3.arc.argument
+// CHECK: {{call|invoke}} void {{.*}}value
+// CHECK: objc3.try.failure
+// CHECK: objc3.arc.error.return.empty
+Strong force(Strong input) { return __objc3_try_force(value(input, 0)); }
+// CHECK-LABEL: define{{.*}} void {{.*}}force{{.*}}sret(
+// CHECK: {{call|invoke}} void {{.*}}value
+// CHECK: {{call|invoke}} void @llvm.trap
+// CHECK: unreachable
+int query(Strong input) { return __objc3_has_value(__objc3_try_force(value(input, 0))); }
+// CHECK-LABEL: define{{.*}} i32 {{.*}}query
+// CHECK: objc3.arc.query.return
+// CHECK: {{call|invoke}} void {{.*}}value
+// CHECK: {{call|invoke}} void @llvm.trap
+// CHECK: objc3.carrier.tag
+typedef Mixed (^Callback)(Mixed) __objc3_throws(id<Error>);
+Mixed invoke(Callback callback, Mixed input) __objc3_throws(id<Error>) {
+  return __objc3_try(callback(input));
+}
+// CHECK-LABEL: define{{.*}} void {{.*}}invoke{{.*}}sret(
+// CHECK: llvm.objc.copyWeak
+// CHECK: {{call|invoke}} void %{{.*}}sret(
+// CHECK: objc3.try.failure
+// CHECK: llvm.objc.destroyWeak
