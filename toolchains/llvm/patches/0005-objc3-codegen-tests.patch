+#ifndef NATIVE_DEPENDENT_FRAME_AWAIT_H
+#define NATIVE_DEPENDENT_FRAME_AWAIT_H
+#include "native-async-task.h"
+template<class T> objc3_async_frame __objc3_async_to_frame(objc3::task<T>);
+template<class T> static T dependent_frame_leaf(T value) __objc3_async_frame {return value;}
+template<class T> static T dependent_task_leaf(T value) __objc3_async {return value;}
+template<class T> struct DependentFrameEntries {
+  static T run(T value) noexcept __attribute__((objc_executor(main))) {return value;}
+};
+template<class T> static T dependent_frame_parent(T value) __objc3_async_frame {
+  T isolated=__objc3_await DependentFrameEntries<T>::run(value);
+  T framed=__objc3_await dependent_frame_leaf(isolated);
+  return __objc3_await dependent_task_leaf(framed);
+}
+template<class Work> static int dependent_frame_callback(Work work) __objc3_async_frame {
+  return __objc3_await work(42);
+}
+static int dependent_plain_leaf(int value) noexcept {return value;}
+#endif
