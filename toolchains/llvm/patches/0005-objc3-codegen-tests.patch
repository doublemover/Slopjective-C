diff --git a/clang/test/ObjC3/CodeGen/Inputs/resource-keypaths.h b/clang/test/ObjC3/CodeGen/Inputs/resource-keypaths.h
new file mode 100644
index 000000000..6e44658b1
--- /dev/null
+++ b/clang/test/ObjC3/CodeGen/Inputs/resource-keypaths.h
@@ -0,0 +1,38 @@
+#ifndef OBJC3_RESOURCE_KEYPATH_CONTROLS_H
+#define OBJC3_RESOURCE_KEYPATH_CONTROLS_H
+#include "../../Inputs/keypath-abi.h"
+void resource_compiler_close(int) noexcept;
+typedef int ResourceCompilerHandle __attribute__((objc_requires_cleanup(resource_compiler_close),objc_resource_family(ResourceCompilerHandles),objc_invalid(-1)));
+struct ResourceCompilerValue {
+  ResourceCompilerHandle handle;int value;
+  explicit ResourceCompilerValue(int);
+  ResourceCompilerValue(const ResourceCompilerValue &);
+  ResourceCompilerValue(ResourceCompilerValue &&) noexcept;
+  ~ResourceCompilerValue() noexcept;
+};
+struct ResourceCompilerPair {ResourceCompilerValue first,second;};
+union ResourceCompilerUnion {
+  struct ResourceArm {int tag;ResourceCompilerHandle handle;} owned;
+  int plain;explicit ResourceCompilerUnion(int);
+  ResourceCompilerUnion(const ResourceCompilerUnion &);
+  ResourceCompilerUnion(ResourceCompilerUnion &&) noexcept;
+  ~ResourceCompilerUnion() noexcept;
+};
+__attribute__((objc_root_class)) @interface ResourceCompilerRoot
+@property(nonatomic) ResourceCompilerValue resource;
+@property(nonatomic) ResourceCompilerPair resources;
+@property(nonatomic) ResourceCompilerUnion active;
+@property(nonatomic,strong) ResourceCompilerRoot *_Nullable next;
+@end
+static inline int resource_compiler_get(ResourceCompilerRoot *_Nonnull root) {
+  ResourceCompilerValue value=KeyPathGet(@keypath(ResourceCompilerRoot,resource),root);
+  ResourceCompilerPair pair=KeyPathGet(@keypath(ResourceCompilerRoot,resources),root);
+  return value.value+pair.first.value;
+}
+static inline void resource_compiler_set(ResourceCompilerRoot *_Nonnull root,ResourceCompilerValue value) {
+  KeyPathSet(@keypath(ResourceCompilerRoot,next.resource),root,value);
+  root[@keypath(ResourceCompilerRoot,resources.first.value)]=41;
+  ResourceCompilerUnion active=KeyPathGet(@keypath(ResourceCompilerRoot,active),root);
+  KeyPathSet(@keypath(ResourceCompilerRoot,active),root,active);
+}
+#endif
