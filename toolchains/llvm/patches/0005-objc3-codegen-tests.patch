+static objc3::task<int> ordinary_object(__attribute__((ns_consumed)) id value) {
+  int result = value != 0;
+#if !__has_feature(objc_arc)
+  ordinary_release(value);
+#endif
+  co_return result;
+}
+__attribute__((objc_root_class)) @interface OrdinaryReceiver
+- (objc3::task<int>)ordinaryConsume:(__attribute__((cf_consumed)) OrdinaryCFRef)value
+    __attribute__((ns_consumes_self));
+@end
+@implementation OrdinaryReceiver
+- (objc3::task<int>)ordinaryConsume:(__attribute__((cf_consumed)) OrdinaryCFRef)value {
+  int result = value != 0;
+  if (value) CFRelease(value);
+#if !__has_feature(objc_arc)
+  ordinary_release(self);
+#endif
+  co_return result;
+}
+@end
+typedef objc3::task<int> (^OrdinaryWork)(__attribute__((cf_consumed)) OrdinaryCFRef);
+static OrdinaryWork ordinary_work = ^objc3::task<int>(__attribute__((cf_consumed)) OrdinaryCFRef value) {
+  int result = value != 0;
+  if (value) CFRelease(value);
+  co_return result;
+};
