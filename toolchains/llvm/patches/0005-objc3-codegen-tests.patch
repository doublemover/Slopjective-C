+#include "native-c-async-frame.h"
+@protocol Sendable @end
+__attribute__((objc_root_class))
+@interface ConsumptionRoot <Sendable>
+- (int)consumeSelf __attribute__((nothrow,ns_consumes_self,objc_executor(main)));
+- (instancetype)initOnMain __attribute__((nothrow,objc_executor(main)));
+@end
+extern ConsumptionRoot *consumption_source(void) __attribute__((ns_returns_retained));
+extern int consumption_entry(__attribute__((ns_consumed)) ConsumptionRoot *)
+    __attribute__((nothrow,objc_executor(main)));
+static inline int consumption_parent(void) __objc3_async_frame {
+  return __objc3_await consumption_entry(consumption_source());
+}
+static inline int consumption_receiver_parent(void) __objc3_async_frame {
+  return __objc3_await [consumption_source() consumeSelf];
+}
+static inline int consumption_init_parent(void) __objc3_async_frame {
+#ifdef __cplusplus
+  auto value = __objc3_await [consumption_source() initOnMain];
+  static_assert(__is_same(__typeof__(*value),ConsumptionRoot));
+#else
+  __auto_type value = __objc3_await [consumption_source() initOnMain];
+  _Static_assert(__builtin_types_compatible_p(__typeof__(*value),ConsumptionRoot), "instancetype");
+#endif
+  return value != 0;
+}
+extern void consumption_release(id) __asm__("objc_release");
+static inline int consumption_frame(__attribute__((ns_consumed)) ConsumptionRoot *object)
+    __objc3_async_frame __attribute__((nothrow,objc_executor(main)));
+static inline int consumption_frame(__attribute__((ns_consumed)) ConsumptionRoot *object)
+    __objc3_async_frame {
+  int result = object != 0;
+#if !__has_feature(objc_arc)
+  consumption_release(object);
+#endif
+  return result;
+}
+static inline int consumption_frame_parent(void) __objc3_async_frame {
+  return __objc3_await consumption_frame(consumption_source());
+}
+#endif
