diff --git a/clang/test/ObjC3/Parser/Inputs/guard-pch.h b/clang/test/ObjC3/Parser/Inputs/guard-pch.h
new file mode 100644
index 000000000..d2fad4ad8
--- /dev/null
+++ b/clang/test/ObjC3/Parser/Inputs/guard-pch.h
@@ -0,0 +1,33 @@
+#ifndef OBJC3_NATIVE_GUARD_PCH_H
+#define OBJC3_NATIVE_GUARD_PCH_H
+
+typedef Optional(int) GuardMaybe;
+
+inline int pch_guard(GuardMaybe source, bool flag) {
+  guard let first = source, second = Some(int, first),
+        flag, var third = Some(int, second) else { return 0; }
+  third += first;
+  return first + second + third;
+}
+
+inline int pch_if_binding(GuardMaybe source) {
+  if var first = source, second = Some(int, first) {
+    first += second;
+    return first;
+  } else {
+    return 0;
+  }
+}
+
+template <class T> int pch_dependent_conditions(T source) {
+  guard let first = source, second = source else { return 0; }
+  if let third = source, fourth = source {
+    return first + second + third + fourth;
+  }
+  return first + second;
+}
+
+#define OBJC3_PCH_REQUIRE guard
+#define OBJC3_PCH_BIND let
+
+#endif
diff --git a/clang/test/ObjC3/Parser/guard-c-mode.m b/clang/test/ObjC3/Parser/guard-c-mode.m
new file mode 100644
index 000000000..ab4d2dba4
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-c-mode.m
@@ -0,0 +1,26 @@
+// RUN: %clang_cc1 -x objective-c -std=c17 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c -std=c23 -fobjc-version=3 -fsyntax-only -verify %s
+// expected-no-diagnostics
+
+typedef Optional(int) Maybe;
+typedef __typeof__(hasValue(None(int))) Bool;
+Maybe make(int);
+void use(int);
+
+void native_c_conditions(Maybe source, Bool flag) {
+  guard let first = source, second = make(first),
+        flag, var third = make(second), fourth = make(third) else {
+    return;
+  }
+  third += fourth;
+  use(first + second + third + fourth);
+  if let local = make(first), dependent = make(local) {
+    use(local + dependent);
+  } else {
+    use(first);
+  }
+  if var local = make(second), dependent = make(local) {
+    local += dependent;
+    use(local);
+  }
+}
diff --git a/clang/test/ObjC3/Parser/guard-conditions.mm b/clang/test/ObjC3/Parser/guard-conditions.mm
new file mode 100644
index 000000000..8bbe5bc89
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-conditions.mm
@@ -0,0 +1,57 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s --check-prefix=AST
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-print %s > %t.mm
+// RUN: FileCheck %s --check-prefix=PRINT < %t.mm
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only %t.mm
+// expected-no-diagnostics
+
+typedef Optional(int) Maybe;
+Maybe next_value(int);
+bool check(int);
+void use(int);
+
+void ordered_bindings(Maybe source) {
+  guard let first = source, second = next_value(first),
+        check(second), var third = next_value(second), fourth = next_value(third)
+  else { return; }
+  third += first;
+  fourth += second;
+  use(first + second + third + fourth);
+}
+
+void assignment_after_boolean(Maybe source, bool flag) {
+  // A Boolean ends binding continuation. Assigning to the ordinary bool flag
+  // is a Boolean condition, rather than an attempt to bind a bool payload.
+  guard let value = source, check(value), (flag = check(value)) else { return; }
+  use(value);
+}
+
+void if_lists(Maybe source) {
+  if let first = source, second = next_value(first) {
+    use(first + second);
+  } else {
+    use(0);
+  }
+  if var first = source, second = next_value(first) {
+    first += second;
+    second += first;
+    use(first + second);
+  }
+}
+
+// AST-LABEL: FunctionDecl {{.*}} ordered_bindings
+// AST: ObjC3GuardStmt
+// AST: ObjC3BindingCondition
+// AST: ObjC3BindingCondition
+// AST: CallExpr
+// AST: ObjC3BindingCondition
+// AST: ObjC3BindingCondition
+// AST-LABEL: FunctionDecl {{.*}} assignment_after_boolean
+// AST: ObjC3GuardStmt
+// AST: BinaryOperator {{.*}} '='
+// AST-LABEL: FunctionDecl {{.*}} if_lists
+// AST: ObjC3IfBindingStmt
+// AST: ObjC3IfBindingStmt
+// PRINT: guard let first = source, let second = next_value(first), check(second), var third = next_value(second), var fourth = next_value(third) else
+// PRINT: if let first = source, second = next_value(first)
+// PRINT: if var first = source, second = next_value(first)
diff --git a/clang/test/ObjC3/Parser/guard-contextual.mm b/clang/test/ObjC3/Parser/guard-contextual.mm
new file mode 100644
index 000000000..cfbce1951
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-contextual.mm
@@ -0,0 +1,69 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s
+// expected-no-diagnostics
+
+bool guard(bool value) { return value; }
+bool let(bool value) { return value; }
+bool var(bool value) { return value; }
+struct Names { int guard, let, var; };
+
+int ordinary_identifiers(bool value) {
+  int let = 1;
+  int var = 2;
+  if (guard(value)) {
+    Names object = {let, var, 3};
+    if (object.guard)
+      goto guard;
+    goto let;
+  }
+guard:
+  if (value) goto var;
+let:
+  return let;
+var:
+  return var;
+}
+
+void contextual_boolean_names(bool value) {
+  guard let(value), var(value), guard(value) else { return; }
+}
+
+void contextual_bare_names(bool let, bool var) {
+  guard let, var else { return; }
+}
+
+#define guard(value) (value)
+#define let(value) (value)
+#define var(value) (value)
+bool ordinary_function_macros(bool value) {
+  return guard(let(var(value)));
+}
+#undef guard
+#undef let
+#undef var
+
+#define REQUIRE guard
+#define BIND let
+#define NAMED(name) name
+#define SOURCE(value) Some(int, value)
+int expanded_binding_heads(int input) {
+  REQUIRE BIND NAMED(first) = SOURCE(input), second = SOURCE(first) else {
+    return 0;
+  }
+  if BIND third = SOURCE(second), fourth = SOURCE(third) {
+    return first + second + third + fourth;
+  }
+  return 0;
+}
+
+// CHECK-LABEL: FunctionDecl {{.*}} ordinary_identifiers
+// CHECK-NOT: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} contextual_boolean_names
+// CHECK: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} contextual_bare_names
+// CHECK: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} ordinary_function_macros
+// CHECK-NOT: ObjC3GuardStmt
+// CHECK-LABEL: FunctionDecl {{.*}} expanded_binding_heads
+// CHECK: ObjC3GuardStmt
+// CHECK: ObjC3IfBindingStmt
