diff --git a/clang/test/ObjC3/AST/Inputs/generic-lambda-contracts.h b/clang/test/ObjC3/AST/Inputs/generic-lambda-contracts.h
new file mode 100644
index 000000000..55142b3d2
--- /dev/null
+++ b/clang/test/ObjC3/AST/Inputs/generic-lambda-contracts.h
@@ -0,0 +1,19 @@
+struct GenericConfigBase { int bias; };
+struct GenericConfig : GenericConfigBase { int values[2]; double scale; };
+union GenericChoice { int left; int right; };
+inline constexpr int generic_contracts() {
+  auto checked=[]<class T>(T value) noexcept(noexcept(value+2))
+      requires requires(T item) { item+2; } {return value+2;};
+  auto head=[]<class T> requires (sizeof(T)>0) (T value) {return value+2;};
+  auto structural=[]<GenericConfig C>() {
+    return C.bias+C.values[0]+C.values[1]+int(C.scale);
+  };
+  auto floating=[]<double D>() {return int(D);};
+  auto choice=[]<GenericChoice C>() {return C.right;};
+  static_assert(noexcept(checked(40)));
+  return checked(40)+head(40)+
+      structural.template operator()<GenericConfig{{2},{20,18},2.0}>()+
+      floating.template operator()<42.0>()+
+      choice.template operator()<GenericChoice{.right=42}>();
+}
+static_assert(generic_contracts()==210);
