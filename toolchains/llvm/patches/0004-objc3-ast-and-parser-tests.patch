+         __objc3_try_force(pch_nothrow_typed_call());
+}
+
+inline void pch_ordered_handlers() {
+  __objc3_do { __objc3_throw(PCHError{}); }
+  __objc3_catch(PCHError first) { (void)first; }
+  __objc3_catch { }
+}
