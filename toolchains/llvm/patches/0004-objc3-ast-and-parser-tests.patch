+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+
+typedef Optional(int) Maybe;
+void use(int);
+
+void scope_after_success(Maybe source) {
+  guard let persistent = source else { return; }
+  use(persistent);
+  {
+    guard var inner = Some(int, persistent) else { return; }
+    inner += persistent;
+    use(inner);
+  }
+  use(inner); // expected-error {{use of undeclared identifier 'inner'}}
+}
+
+void guard_failure_has_outer_lookup(Maybe source) {
+  int failure_value = 4;
+  {
+    guard let failure_value = source else {
+      // The newly bound failure_value is not in this branch. Assignment is
+      // valid because lookup reaches the mutable outer declaration instead.
+      failure_value += 1;
+      return;
+    }
+    use(failure_value);
+  }
+}
+
+void unavailable_in_guard_failure(Maybe source) {
+  guard let only_in_success = source else {
+    use(only_in_success); // expected-error {{use of undeclared identifier 'only_in_success'}}
+    return;
+  }
+}
+
+void if_binding_scope(Maybe source) {
+  int outer = 7;
+  if let outer = source, later = Some(int, outer) {
+    use(outer + later);
+  } else {
+    outer += 1;
+  }
+  outer += 1;
+  if let only_in_success = source { use(only_in_success); }
+  else { use(only_in_success); } // expected-error {{use of undeclared identifier 'only_in_success'}}
+  use(only_in_success); // expected-error {{use of undeclared identifier 'only_in_success'}}
+}
+
+void boolean_resets_bare_binding(Maybe source) {
+  Maybe assignment = None(int);
+  guard let first = source, true, assignment = Some(int, first) // expected-error {{condition must have Bool type}}
+  else { return; }
+}
+
+void explicit_head_restarts_binding(Maybe source) {
+  guard let first = source, true, var second = Some(int, first),
+        third = Some(int, second) else { return; }
+  second += first;
+  third += second;
+  use(first + second + third);
+}
diff --git a/clang/test/ObjC3/Parser/guard-template.mm b/clang/test/ObjC3/Parser/guard-template.mm
new file mode 100644
index 000000000..34da6ee82
--- /dev/null
+++ b/clang/test/ObjC3/Parser/guard-template.mm
@@ -0,0 +1,63 @@
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -ast-dump %s | FileCheck %s
+// expected-no-diagnostics
+
+template <class T> bool accepts(T value) { return value != 0; }
+
+template <class T> int dependent_guard(T source) {
+  guard let first = source, second = source, accepts(first),
+        var third = source, fourth = source else { return 0; }
+  third += first;
+  fourth += second;
+  if let local = source, next = source {
+    return local + next + third + fourth;
+  } else {
+    return first + second;
+  }
+}
+
+template <class T> int dependent_if(T source) {
+  if var first = source, second = source {
+    first += second;
+    auto capture = [first] { return first; };
+    return capture();
+  }
+  return 0;
+}
+
+template <class T> int binding_used_in_later_lambda(T source) {
+  guard let first = source,
+        second = Some(int, [&] { return first; }()) else { return 0; }
+  return second;
+}
+
+template <class T> struct Holder {
+  int run(T source) {
+    guard let first = source else { return 0; }
+    if var second = source, third = source {
+      second += first + third;
+      return second;
+    }
+    return first;
+  }
+};
+
+template int dependent_guard<Optional(int)>(Optional(int));
+template int dependent_if<Optional(int)>(Optional(int));
+template int binding_used_in_later_lambda<Optional(int)>(Optional(int));
+template struct Holder<Optional(int)>;
+
