+// RUN: %clang_cc1 -x objective-c++ -std=c++20 -fobjc-version=3 -fsyntax-only -verify %s
+
+typedef Optional(int) Maybe;
+void use(int);
+
+void missing_else(Maybe source) {
+  guard let rejected = source { // expected-error {{expected 'else' after guard conditions}}
+    return;
+  }
+  use(rejected); // expected-error {{use of undeclared identifier 'rejected'}}
+  use(1);
+}
+
+void boolean_missing_else(bool flag) {
+  guard true { return; } // expected-error {{expected 'else' after guard conditions}}
+  guard !flag; // expected-error {{expected 'else' after guard conditions}}
+  use(1);
+}
+
+void missing_guard_compound(Maybe source) {
+  guard let rejected = source else use(0); // expected-error {{expected a compound statement after guard 'else'}}
+  use(rejected); // expected-error {{use of undeclared identifier 'rejected'}}
+  use(1);
+}
+
+void missing_if_compound(Maybe source) {
+  if let rejected = source use(0); // expected-error {{expected ',' or '{' after condition}} expected-error {{expected a compound statement after if binding conditions}}
+  use(rejected); // expected-error {{use of undeclared identifier 'rejected'}}
+  use(1);
+}
+
+void missing_then_before_else(Maybe source) {
+  if let rejected = source else { // expected-error {{expected a compound statement after if binding conditions}}
+    use(0);
+  }
+  use(rejected); // expected-error {{use of undeclared identifier 'rejected'}}
+}
+
+void missing_if_else_compound(Maybe source) {
+  if let value = source { use(value); }
+  else use(0); // expected-error {{expected a compound statement after if binding 'else'}}
+  use(1);
+}
+
+void missing_equal(Maybe source) {
+  guard let rejected source else { return; } // expected-error {{expected '='}}
+  if let rejected source { use(0); } // expected-error {{expected '='}}
+  use(1);
+}
+
+void missing_source(Maybe source) {
+  guard let rejected = else { return; } // expected-error {{expected expression}}
+  if let rejected = { use(0); } // expected-error {{expected expression}}
+  use(1);
+}
+
+void empty_lists() {
+  guard else { return; } // expected-error {{expected a condition in guard statement}}
+  guard true, else { return; } // expected-error {{expected a condition in guard statement}}
+  guard true, , true else { return; } // expected-error {{expected a condition in guard statement}}
+  if let { use(0); } // expected-error {{expected an optional binding of the form 'identifier = expression'}}
+  use(1);
