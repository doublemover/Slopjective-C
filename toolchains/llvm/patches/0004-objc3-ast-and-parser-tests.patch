+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -x objective-c -std=c17 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fobjc-runtime=gnustep-2.2 -fobjc-version=3 -fobjc3-profile=strict-system -x objective-c++ -std=c++23 -fsyntax-only -verify %s
+
+typedef int behavior;
+
+@protocol Properties
+@property behavior ordinary;
+@property int behavior;
+@property(getter=behavior) int ordinaryGetter;
+@property behavior { storage { int ignored; } }; // expected-error {{property behavior blocks are reserved for a future Objective-C revision}} expected-note {{apply a behavior with the objc_property_behavior attribute}}
+@property (nonatomic, behavior { validate {} }, readonly) int reservedAttribute; // expected-error {{property behavior blocks are reserved}} expected-note {{objc_property_behavior attribute}}
+@property int reservedSuffix behavior { get {} set {} }; // expected-error {{property behavior blocks are reserved}} expected-note {{objc_property_behavior attribute}}
+@property int after;
+@end
