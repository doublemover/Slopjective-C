+TEST(ObjC3ResultExpr, StoresBothArmTypesKindsAndQueryChild) {
+  auto AST = parse(R"cpp(
+    typedef int SuccessAlias;
+    typedef int ErrorAlias;
+    using AliasResult = __objc3_result(SuccessAlias, ErrorAlias);
+    using CanonicalResult = __objc3_result(int, int);
+    static_assert(__is_same(AliasResult, CanonicalResult), "canonical Result");
+    auto OkValue = __objc3_ok(SuccessAlias, ErrorAlias, 0);
+    auto ErrValue = __objc3_err(SuccessAlias, ErrorAlias, 0);
+    bool IsOkValue = __objc3_is_ok(OkValue);
+    using VoidResult = __objc3_result(void, void);
+    auto VoidOk = __objc3_ok(void, void, (void)0);
+    auto VoidErr = __objc3_err(void, void, (void)0);
+    bool VoidOkTag = __objc3_is_ok(VoidOk);
+    bool VoidErrTag = __objc3_is_ok(VoidErr);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
