+  auto *OkValue = getResultExpr(Context, "OkValue");
+  auto *ErrValue = getResultExpr(Context, "ErrValue");
+  auto *IsOkValue = getResultExpr(Context, "IsOkValue");
+  auto *VoidOk = getResultExpr(Context, "VoidOk");
+  auto *VoidErr = getResultExpr(Context, "VoidErr");
+  auto *VoidOkTag = getResultExpr(Context, "VoidOkTag");
+  auto *VoidErrTag = getResultExpr(Context, "VoidErrTag");
+  ASSERT_NE(OkValue, nullptr);
+  ASSERT_NE(ErrValue, nullptr);
+  ASSERT_NE(IsOkValue, nullptr);
+  ASSERT_NE(VoidOk, nullptr);
+  ASSERT_NE(VoidErr, nullptr);
+  ASSERT_NE(VoidOkTag, nullptr);
+  ASSERT_NE(VoidErrTag, nullptr);
+
+  EXPECT_EQ(OkValue->getKind(), ObjC3ResultExpr::Kind::Ok);
+  EXPECT_EQ(ErrValue->getKind(), ObjC3ResultExpr::Kind::Err);
+  EXPECT_EQ(IsOkValue->getKind(), ObjC3ResultExpr::Kind::IsOk);
+  EXPECT_EQ(childCount(OkValue), 1u);
+  EXPECT_EQ(childCount(ErrValue), 1u);
+  EXPECT_EQ(childCount(IsOkValue), 1u);
+  EXPECT_EQ(childCount(VoidOk), 1u);
+  EXPECT_EQ(childCount(VoidErr), 1u);
+  EXPECT_EQ(childCount(VoidOkTag), 1u);
+  EXPECT_EQ(childCount(VoidErrTag), 1u);
+  EXPECT_EQ(OkValue->getPayload(), *OkValue->child_begin());
+  EXPECT_EQ(ErrValue->getPayload(), *ErrValue->child_begin());
+  EXPECT_EQ(IsOkValue->getPayload(), *IsOkValue->child_begin());
+  EXPECT_TRUE(IsOkValue->getType()->isBooleanType());
+  EXPECT_TRUE(VoidOkTag->getType()->isBooleanType());
+  EXPECT_TRUE(VoidErrTag->getType()->isBooleanType());
+
+  for (ObjC3ResultExpr *E : {OkValue, ErrValue, VoidOk, VoidErr}) {
+    ASSERT_NE(E->getSuccessTypeInfo(), nullptr);
+    ASSERT_NE(E->getErrorTypeInfo(), nullptr);
+    EXPECT_TRUE(Context.hasSameType(E->getType(), E->getCarrierType()));
+  }
+  EXPECT_TRUE(OkValue->getSuccessTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(OkValue->getErrorTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_NE(OkValue->getSuccessTypeInfo(), OkValue->getErrorTypeInfo());
+  EXPECT_NE(OkValue->getSuccessTypeInfo()->getTypeLoc().getBeginLoc(),
+            OkValue->getErrorTypeInfo()->getTypeLoc().getBeginLoc());
+  EXPECT_TRUE(Context.hasSameType(OkValue->getCarrierType(),
+                                  ErrValue->getCarrierType()));
+  EXPECT_TRUE(Context.hasSameType(
+      OkValue->getCarrierType(),
+      Context.getObjC3ResultType(Context.IntTy, Context.IntTy)));
+  auto *AliasResult =
+      dyn_cast_or_null<TypeAliasDecl>(lookup(Context, "AliasResult"));
+  auto *CanonicalResult =
+      dyn_cast_or_null<TypeAliasDecl>(lookup(Context, "CanonicalResult"));
+  ASSERT_NE(AliasResult, nullptr);
+  ASSERT_NE(CanonicalResult, nullptr);
+  EXPECT_TRUE(Context.hasSameType(AliasResult->getUnderlyingType(),
+                                  CanonicalResult->getUnderlyingType()));
+  EXPECT_EQ(IsOkValue->getSuccessTypeInfo(), nullptr);
+  EXPECT_EQ(IsOkValue->getErrorTypeInfo(), nullptr);
+  EXPECT_TRUE(Context.hasSameType(IsOkValue->getCarrierType(),
+                                  OkValue->getCarrierType()));
+  EXPECT_TRUE(Context.hasSameType(VoidOk->getCarrierType(),
+                                  VoidErr->getCarrierType()));
+  EXPECT_EQ(VoidOk->getPayload()->getType(), Context.VoidTy);
+  EXPECT_EQ(VoidErr->getPayload()->getType(), Context.VoidTy);
+  EXPECT_EQ(VoidOkTag->getPayload(), *VoidOkTag->child_begin());
+  EXPECT_EQ(VoidErrTag->getPayload(), *VoidErrTag->child_begin());
+}
