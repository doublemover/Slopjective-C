+TEST(ObjC3ResultExpr, ImportPreservesBothArmTypeInfoAndPayloadAssociation) {
+  const std::string Source = R"cpp(
+    typedef int SuccessAlias;
+    typedef long ErrorAlias;
+    auto Imported = __objc3_err(SuccessAlias, ErrorAlias, 0L);
+  )cpp";
+  auto From = parse(Source, "from-result.mm");
+  const tooling::FileContentMappings Mappings = {{"from-result.mm", Source}};
+  auto To = parse("", "to-result.mm", Mappings);
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  auto *FromVariable =
+      dyn_cast_or_null<VarDecl>(lookup(FromContext, "Imported"));
+  ASSERT_NE(FromVariable, nullptr);
+  auto *FromExpr = dyn_cast<ObjC3ResultExpr>(
+      FromVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(FromExpr, nullptr);
+  ASSERT_NE(FromExpr->getSuccessTypeInfo(), nullptr);
+  ASSERT_NE(FromExpr->getErrorTypeInfo(), nullptr);
+
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), false);
+  auto Imported = Importer.Import(FromVariable);
+  if (!Imported) {
+    ADD_FAILURE() << llvm::toString(Imported.takeError());
+    return;
+  }
+  auto *ToVariable = cast<VarDecl>(*Imported);
+  auto *ToExpr =
+      dyn_cast<ObjC3ResultExpr>(ToVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(ToExpr, nullptr);
+  EXPECT_NE(ToExpr, FromExpr);
+  ASSERT_NE(ToExpr->getSuccessTypeInfo(), nullptr);
+  ASSERT_NE(ToExpr->getErrorTypeInfo(), nullptr);
+  EXPECT_NE(ToExpr->getSuccessTypeInfo(), FromExpr->getSuccessTypeInfo());
+  EXPECT_NE(ToExpr->getErrorTypeInfo(), FromExpr->getErrorTypeInfo());
+  EXPECT_TRUE(ToExpr->getSuccessTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(ToExpr->getErrorTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_EQ(ToExpr->getKind(), FromExpr->getKind());
+  EXPECT_EQ(childCount(ToExpr), 1u);
+  EXPECT_EQ(ToExpr->getPayload(), *ToExpr->child_begin());
+  EXPECT_NE(ToExpr->getPayload(), FromExpr->getPayload());
+  QualType ExpectedCarrier = ToContext.getObjC3ResultType(
+      ToExpr->getSuccessTypeInfo()->getType(),
+      ToExpr->getErrorTypeInfo()->getType());
+  EXPECT_TRUE(ToContext.hasSameType(ToExpr->getCarrierType(), ExpectedCarrier));
+  EXPECT_TRUE(ToExpr->getKeywordLoc().isValid());
+  EXPECT_TRUE(ToExpr->getFirstCommaLoc().isValid());
+  EXPECT_TRUE(ToExpr->getSecondCommaLoc().isValid());
+  EXPECT_TRUE(ToExpr->getRParenLoc().isValid());
+  EXPECT_EQ(ToContext.getSourceManager().getSpellingLineNumber(
+                ToExpr->getKeywordLoc()),
+            FromContext.getSourceManager().getSpellingLineNumber(
+                FromExpr->getKeywordLoc()));
+}
