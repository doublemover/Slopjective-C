+namespace {
+
+std::unique_ptr<ASTUnit> parse(
+    llvm::StringRef Source,
+    llvm::StringRef FileName = "objc3-optional-expressions.mm",
+    const tooling::FileContentMappings &Mappings = {}) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      FileName, "clang-tool", std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(), Mappings);
+}
+
+NamedDecl *lookup(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  return Decls.empty() ? nullptr : Decls.front();
+}
+
+ObjC3OptionalExpr *getOptionalExpr(ASTContext &Context,
+                                   llvm::StringRef VariableName) {
+  auto *Variable = dyn_cast_or_null<VarDecl>(lookup(Context, VariableName));
+  if (!Variable || !Variable->hasInit())
+    return nullptr;
+  return dyn_cast<ObjC3OptionalExpr>(Variable->getInit()->IgnoreImplicit());
+}
+
+unsigned childCount(const Stmt *S) {
+  return std::distance(S->child_begin(), S->child_end());
+}
+
+class OptionalExprCollector
+    : public RecursiveASTVisitor<OptionalExprCollector> {
+public:
+  std::vector<ObjC3OptionalExpr *> Expressions;
+
+  bool shouldVisitTemplateInstantiations() const { return true; }
+
+  bool VisitObjC3OptionalExpr(ObjC3OptionalExpr *E) {
+    Expressions.push_back(E);
+    return true;
+  }
+};
+
+TEST(ObjC3OptionalExpr, StoresKindCanonicalCarrierAndPayloadSourceInfo) {
+  auto AST = parse(R"cpp(
+    typedef int Count;
+    typedef __objc3_optional(Count) AliasOptional;
+    typedef __objc3_optional(int) IntOptional;
+    auto SomeAlias = __objc3_some(Count, 0);
+    auto SomeInt = __objc3_some(int, 1);
+    auto NoneAlias = __objc3_none(Count);
+    bool HasValue = __objc3_has_value(NoneAlias);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  auto *SomeAlias = getOptionalExpr(Context, "SomeAlias");
+  auto *SomeInt = getOptionalExpr(Context, "SomeInt");
+  auto *NoneAlias = getOptionalExpr(Context, "NoneAlias");
+  auto *HasValue = getOptionalExpr(Context, "HasValue");
+  ASSERT_NE(SomeAlias, nullptr);
+  ASSERT_NE(SomeInt, nullptr);
+  ASSERT_NE(NoneAlias, nullptr);
+  ASSERT_NE(HasValue, nullptr);
+
+  EXPECT_EQ(SomeAlias->getKind(), ObjC3OptionalExpr::Kind::Some);
+  EXPECT_EQ(NoneAlias->getKind(), ObjC3OptionalExpr::Kind::None);
+  EXPECT_EQ(HasValue->getKind(), ObjC3OptionalExpr::Kind::HasValue);
+  EXPECT_EQ(childCount(SomeAlias), 1u);
+  EXPECT_EQ(childCount(SomeInt), 1u);
+  EXPECT_EQ(childCount(NoneAlias), 0u);
+  EXPECT_EQ(childCount(HasValue), 1u);
+  EXPECT_TRUE(HasValue->getType()->isBooleanType());
+  EXPECT_EQ(HasValue->getPayloadTypeInfo(), nullptr);
+
+  ASSERT_NE(SomeAlias->getPayloadTypeInfo(), nullptr);
+  ASSERT_NE(SomeInt->getPayloadTypeInfo(), nullptr);
+  ASSERT_NE(NoneAlias->getPayloadTypeInfo(), nullptr);
+  EXPECT_TRUE(SomeAlias->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(NoneAlias->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_TRUE(SomeInt->getPayloadTypeInfo()->getType()->isBuiltinType());
+  EXPECT_NE(SomeAlias->getPayloadTypeInfo(), SomeInt->getPayloadTypeInfo());
+  EXPECT_NE(SomeAlias->getPayloadTypeInfo()->getTypeLoc().getBeginLoc(),
+            SomeInt->getPayloadTypeInfo()->getTypeLoc().getBeginLoc());
+
+  QualType AliasCarrier = Context.getObjC3OptionalType(
+      SomeAlias->getPayloadTypeInfo()->getType());
+  QualType IntCarrier = Context.getObjC3OptionalType(
+      SomeInt->getPayloadTypeInfo()->getType());
+  EXPECT_TRUE(Context.hasSameType(AliasCarrier, IntCarrier));
+  EXPECT_TRUE(Context.hasSameType(SomeAlias->getCarrierType(), AliasCarrier));
+  EXPECT_TRUE(Context.hasSameType(SomeInt->getCarrierType(), IntCarrier));
+  EXPECT_TRUE(Context.hasSameType(NoneAlias->getCarrierType(), AliasCarrier));
+  EXPECT_TRUE(Context.hasSameType(HasValue->getCarrierType(), AliasCarrier));
+  EXPECT_TRUE(Context.hasSameType(SomeAlias->getType(), AliasCarrier));
+  EXPECT_TRUE(Context.hasSameType(NoneAlias->getType(), AliasCarrier));
+
+  auto *AliasOptional =
+      dyn_cast_or_null<TypedefNameDecl>(lookup(Context, "AliasOptional"));
+  auto *IntOptional =
+      dyn_cast_or_null<TypedefNameDecl>(lookup(Context, "IntOptional"));
+  ASSERT_NE(AliasOptional, nullptr);
+  ASSERT_NE(IntOptional, nullptr);
+  EXPECT_TRUE(Context.hasSameType(AliasOptional->getUnderlyingType(),
+                                  IntOptional->getUnderlyingType()));
+  auto AliasLoc = AliasOptional->getTypeSourceInfo()->getTypeLoc().getAs<
+      ObjC3OptionalTypeLoc>();
+  auto IntLoc = IntOptional->getTypeSourceInfo()->getTypeLoc().getAs<
+      ObjC3OptionalTypeLoc>();
+  ASSERT_FALSE(AliasLoc.isNull());
+  ASSERT_FALSE(IntLoc.isNull());
+  ASSERT_NE(AliasLoc.getElementLoc(), nullptr);
+  ASSERT_NE(IntLoc.getElementLoc(), nullptr);
+  EXPECT_TRUE(AliasLoc.getElementLoc()->getType()->isTypedefNameType());
+  EXPECT_TRUE(IntLoc.getElementLoc()->getType()->isBuiltinType());
+  EXPECT_NE(AliasLoc.getKeywordLoc(), IntLoc.getKeywordLoc());
+}
+
+TEST(ObjC3OptionalExpr, DependentTemplateSubstitutionRebuildsCarrier) {
+  auto AST = parse(R"cpp(
+    template <class T> auto make_optional(T value) {
+      return __objc3_some(T, value);
+    }
+    template <class T> bool is_present(T value) {
+      return __objc3_has_value(value);
+    }
+    auto Concrete = make_optional(1);
+    bool ConcretePresence = is_present(Concrete);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  OptionalExprCollector Collector;
+  Collector.TraverseDecl(Context.getTranslationUnitDecl());
+  auto HasCarrier = [&Context](const ObjC3OptionalExpr *E, bool IsDependent) {
+    QualType Carrier = E->getCarrierType().getCanonicalType();
+    if (Carrier->isDependentType() != IsDependent)
+      return false;
+    if (E->getKind() == ObjC3OptionalExpr::Kind::HasValue)
+      return E->getType()->isBooleanType() &&
+             (IsDependent ||
+              (Carrier->getAs<ObjC3OptionalType>() &&
+               Carrier->getAs<ObjC3OptionalType>()->getElementType() ==
+                   Context.IntTy));
+    const auto *Optional = Carrier->getAs<ObjC3OptionalType>();
+    return E->getKind() == ObjC3OptionalExpr::Kind::Some && Optional &&
+           (IsDependent || Optional->getElementType() == Context.IntTy);
+  };
+  EXPECT_TRUE(std::any_of(Collector.Expressions.begin(),
+                          Collector.Expressions.end(), [&](const auto *E) {
+                            return E->getKind() ==
+                                       ObjC3OptionalExpr::Kind::Some &&
+                                   HasCarrier(E, true);
+                          }));
+  EXPECT_TRUE(std::any_of(Collector.Expressions.begin(),
+                          Collector.Expressions.end(), [&](const auto *E) {
+                            return E->getKind() ==
+                                       ObjC3OptionalExpr::Kind::Some &&
+                                   HasCarrier(E, false);
+                          }));
+  EXPECT_TRUE(std::any_of(Collector.Expressions.begin(),
+                          Collector.Expressions.end(), [&](const auto *E) {
+                            return E->getKind() ==
+                                       ObjC3OptionalExpr::Kind::HasValue &&
+                                   HasCarrier(E, true);
+                          }));
+  EXPECT_TRUE(std::any_of(Collector.Expressions.begin(),
+                          Collector.Expressions.end(), [&](const auto *E) {
+                            return E->getKind() ==
+                                       ObjC3OptionalExpr::Kind::HasValue &&
+                                   HasCarrier(E, false);
+                          }));
+}
+
+TEST(ObjC3OptionalExpr, ImportPreservesPayloadTypeInfoAndChildAssociation) {
+  const std::string Source = R"cpp(
+    typedef int Count;
+    auto Imported = __objc3_some(Count, 0);
+  )cpp";
+  auto From = parse(Source, "from-optional.mm");
+  const tooling::FileContentMappings Mappings = {{"from-optional.mm", Source}};
+  auto To = parse("", "to-optional.mm", Mappings);
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  auto *FromVariable =
+      dyn_cast_or_null<VarDecl>(lookup(FromContext, "Imported"));
+  ASSERT_NE(FromVariable, nullptr);
+  auto *FromExpr = dyn_cast<ObjC3OptionalExpr>(
+      FromVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(FromExpr, nullptr);
+  ASSERT_NE(FromExpr->getPayloadTypeInfo(), nullptr);
+
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), false);
+  auto Imported = Importer.Import(FromVariable);
+  if (!Imported) {
+    ADD_FAILURE() << llvm::toString(Imported.takeError());
+    return;
+  }
+  auto *ToVariable = cast<VarDecl>(*Imported);
+  auto *ToExpr =
+      dyn_cast<ObjC3OptionalExpr>(ToVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(ToExpr, nullptr);
+  ASSERT_NE(ToExpr->getPayloadTypeInfo(), nullptr);
+  EXPECT_NE(ToExpr, FromExpr);
+  EXPECT_NE(ToExpr->getPayloadTypeInfo(), FromExpr->getPayloadTypeInfo());
+  EXPECT_TRUE(ToExpr->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_EQ(ToExpr->getKind(), FromExpr->getKind());
+  EXPECT_EQ(childCount(ToExpr), 1u);
+  EXPECT_EQ(ToExpr->getPayload(), *ToExpr->child_begin());
+  EXPECT_NE(ToExpr->getPayload(), FromExpr->getPayload());
+  QualType ExpectedCarrier = ToContext.getObjC3OptionalType(
+      ToExpr->getPayloadTypeInfo()->getType());
+  EXPECT_TRUE(ToContext.hasSameType(ToExpr->getCarrierType(), ExpectedCarrier));
+  EXPECT_TRUE(ToExpr->getKeywordLoc().isValid());
+  EXPECT_TRUE(ToExpr->getCommaLoc().isValid());
+  EXPECT_TRUE(ToExpr->getRParenLoc().isValid());
+  EXPECT_EQ(ToContext.getSourceManager().getSpellingLineNumber(
+                ToExpr->getKeywordLoc()),
+            FromContext.getSourceManager().getSpellingLineNumber(
+                FromExpr->getKeywordLoc()));
+}
+
+} // namespace
