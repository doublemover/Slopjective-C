+#include "gtest/gtest.h"
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<ASTUnit> parse(llvm::StringRef Source) {
+  return tooling::buildASTFromCodeWithArgs(
+      Source, {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3"},
+      "objc3-carrier-expression-semantics.mm");
+}
+
+NamedDecl *lookup(ASTContext &Context, llvm::StringRef Name) {
+  auto Decls = Context.getTranslationUnitDecl()->lookup(
+      &Context.Idents.get(Name));
+  return Decls.empty() ? nullptr : Decls.front();
+}
+
+Expr *getInit(ASTContext &Context, llvm::StringRef Name) {
+  auto *Variable = dyn_cast_or_null<VarDecl>(lookup(Context, Name));
+  if (!Variable || !Variable->hasInit())
+    return nullptr;
+
+  Expr *E = Variable->getInit();
+  while (E) {
+    if (auto *WithCleanups = dyn_cast<ExprWithCleanups>(E)) {
+      E = WithCleanups->getSubExpr();
+      continue;
+    }
+    Expr *Unwrapped = E->IgnoreParenImpCasts();
+    if (Unwrapped == E)
+      return E;
+    E = Unwrapped;
+  }
+  return nullptr;
+}
+
+TEST(ObjC3CarrierExprSemantics, ValueKindAndSideEffects) {
+  auto AST = parse(R"cpp(
+    auto NoneValue = __objc3_none(int);
+    auto SomeZero = __objc3_some(int, 0);
+    auto ResultOkZero = __objc3_ok(int, int, 0);
+    auto ResultErrZero = __objc3_err(int, int, 0);
+    bool OptionalQuery = __objc3_has_value(NoneValue);
+    bool ResultQuery = __objc3_is_ok(ResultOkZero);
+
+    typedef __objc3_optional(int) IntOptional;
+    typedef __objc3_result(int, int) IntResult;
+    volatile IntOptional VolatileOptional;
+    volatile IntResult VolatileResult;
+    bool VolatileOptionalQuery = __objc3_has_value(VolatileOptional);
+    bool VolatileResultQuery = __objc3_is_ok(VolatileResult);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+
+  Expr *NoneValue = getInit(Context, "NoneValue");
+  Expr *SomeZero = getInit(Context, "SomeZero");
+  Expr *ResultOkZero = getInit(Context, "ResultOkZero");
+  Expr *ResultErrZero = getInit(Context, "ResultErrZero");
+  Expr *OptionalQuery = getInit(Context, "OptionalQuery");
+  Expr *ResultQuery = getInit(Context, "ResultQuery");
+  Expr *VolatileOptionalQuery = getInit(Context, "VolatileOptionalQuery");
+  Expr *VolatileResultQuery = getInit(Context, "VolatileResultQuery");
+  ASSERT_NE(NoneValue, nullptr);
+  ASSERT_NE(SomeZero, nullptr);
+  ASSERT_NE(ResultOkZero, nullptr);
+  ASSERT_NE(ResultErrZero, nullptr);
+  ASSERT_NE(OptionalQuery, nullptr);
+  ASSERT_NE(ResultQuery, nullptr);
+  ASSERT_NE(VolatileOptionalQuery, nullptr);
+  ASSERT_NE(VolatileResultQuery, nullptr);
+
+  for (Expr *E : {NoneValue, SomeZero, ResultOkZero, ResultErrZero,
+                  OptionalQuery, ResultQuery, VolatileOptionalQuery,
+                  VolatileResultQuery})
+    EXPECT_TRUE(E->isPRValue());
+
+  EXPECT_FALSE(NoneValue->HasSideEffects(Context));
+  EXPECT_FALSE(SomeZero->HasSideEffects(Context));
+  EXPECT_FALSE(ResultOkZero->HasSideEffects(Context));
+  EXPECT_FALSE(ResultErrZero->HasSideEffects(Context));
+  EXPECT_FALSE(OptionalQuery->HasSideEffects(Context));
+  EXPECT_FALSE(ResultQuery->HasSideEffects(Context));
+  EXPECT_FALSE(NoneValue->isEvaluatable(Context));
+  EXPECT_FALSE(SomeZero->isEvaluatable(Context));
+  EXPECT_FALSE(ResultOkZero->isEvaluatable(Context));
+  EXPECT_FALSE(ResultQuery->isEvaluatable(Context));
+  EXPECT_TRUE(VolatileOptionalQuery->HasSideEffects(Context));
+  EXPECT_TRUE(VolatileResultQuery->HasSideEffects(Context));
+  EXPECT_FALSE(VolatileOptionalQuery->HasSideEffects(Context, false));
+  EXPECT_FALSE(VolatileResultQuery->HasSideEffects(Context, false));
+}
+
+TEST(ObjC3CarrierExprSemantics, NoexceptTracksNativePayloadOperations) {
+  auto AST = parse(R"cpp(
+    int noexcept_function() noexcept;
+    int throwing_function();
+    struct NoexceptConstruction { NoexceptConstruction(int) noexcept; };
+    struct ThrowingConstruction { ThrowingConstruction(int); };
+    using IntOptional = __objc3_optional(int);
+    using IntResult = __objc3_result(int, int);
+    IntResult noexcept_result_function() noexcept;
+    IntResult throwing_result_function();
+
+    static_assert(noexcept(__objc3_none(int)));
+    static_assert(noexcept(__objc3_some(int, noexcept_function())));
+    static_assert(!noexcept(__objc3_some(int, throwing_function())));
+    static_assert(noexcept(__objc3_some(NoexceptConstruction, 0)));
+    static_assert(!noexcept(__objc3_some(ThrowingConstruction, 0)));
+    static_assert(noexcept(__objc3_ok(int, int, noexcept_function())));
+    static_assert(!noexcept(__objc3_err(int, int, throwing_function())));
+    static_assert(noexcept(__objc3_is_ok(noexcept_result_function())));
+    static_assert(!noexcept(__objc3_is_ok(throwing_result_function())));
+  )cpp");
+  ASSERT_TRUE(AST);
+  EXPECT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+}
+
+} // namespace
