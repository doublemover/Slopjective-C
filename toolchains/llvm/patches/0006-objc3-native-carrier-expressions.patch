+TEST(ObjC3ResultExpr, DependentArmSelectionAndQueryRevalidateAfterSubstitution) {
+  auto AST = parse(R"cpp(
+    template <class T, class E> using Result = __objc3_result(T, E);
+    template <class T, class E> auto make_ok(T value) {
+      return __objc3_ok(T, E, value);
+    }
+    template <class T, class E> auto make_err(E value) {
+      return __objc3_err(T, E, value);
+    }
+    template <class T, class E> bool is_ok(Result<T, E> value) {
+      return __objc3_is_ok(value);
+    }
+    auto ConcreteOk = make_ok<int, long>(1);
+    auto ConcreteErr = make_err<int, long>(2L);
+    bool ConcreteOkTag = is_ok(ConcreteOk);
+    bool ConcreteErrTag = is_ok(ConcreteErr);
+  )cpp");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+
+  ResultExprCollector Collector;
+  Collector.TraverseDecl(Context.getTranslationUnitDecl());
+  auto IsCarrier = [&Context](const ObjC3ResultExpr *E, bool IsDependent) {
+    QualType Carrier = E->getCarrierType().getCanonicalType();
+    if (Carrier->isDependentType() != IsDependent)
+      return false;
+    const auto *Result = Carrier->getAs<ObjC3ResultType>();
+    return Result &&
+           (IsDependent || (Result->getSuccessType() == Context.IntTy &&
+                             Result->getErrorType() == Context.LongTy));
+  };
+  auto Has = [&](ObjC3ResultExpr::Kind Kind, bool IsDependent) {
+    return std::any_of(Collector.Expressions.begin(),
+                       Collector.Expressions.end(), [&](const auto *E) {
+                         return E->getKind() == Kind &&
+                                IsCarrier(E, IsDependent);
+                       });
+  };
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::Ok, true));
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::Err, true));
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::IsOk, true));
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::Ok, false));
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::Err, false));
+  EXPECT_TRUE(Has(ObjC3ResultExpr::Kind::IsOk, false));
+}
