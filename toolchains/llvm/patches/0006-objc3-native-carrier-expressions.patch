+TEST(ObjC3OptionalExpr, ImportPreservesPayloadTypeInfoAndChildAssociation) {
+  const std::string Source = R"cpp(
+    typedef int Count;
+    auto Imported = __objc3_some(Count, 0);
+  )cpp";
+  auto From = parse(Source, "from-optional.mm");
+  auto To = parse("", "to-optional.mm", {{"from-optional.mm", Source}});
+  ASSERT_TRUE(From);
+  ASSERT_TRUE(To);
+  ASTContext &FromContext = From->getASTContext();
+  ASTContext &ToContext = To->getASTContext();
+  auto *FromVariable =
+      dyn_cast_or_null<VarDecl>(lookup(FromContext, "Imported"));
+  ASSERT_NE(FromVariable, nullptr);
+  auto *FromExpr = dyn_cast<ObjC3OptionalExpr>(
+      FromVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(FromExpr, nullptr);
+  ASSERT_NE(FromExpr->getPayloadTypeInfo(), nullptr);
+
+  ASTImporter Importer(ToContext, To->getFileManager(), FromContext,
+                       From->getFileManager(), false);
+  auto Imported = Importer.Import(FromVariable);
+  if (!Imported) {
+    ADD_FAILURE() << llvm::toString(Imported.takeError());
+    return;
+  }
+  auto *ToVariable = cast<VarDecl>(*Imported);
+  auto *ToExpr =
+      dyn_cast<ObjC3OptionalExpr>(ToVariable->getInit()->IgnoreImplicit());
+  ASSERT_NE(ToExpr, nullptr);
+  ASSERT_NE(ToExpr->getPayloadTypeInfo(), nullptr);
+  EXPECT_NE(ToExpr, FromExpr);
+  EXPECT_NE(ToExpr->getPayloadTypeInfo(), FromExpr->getPayloadTypeInfo());
+  EXPECT_TRUE(ToExpr->getPayloadTypeInfo()->getType()->isTypedefNameType());
+  EXPECT_EQ(ToExpr->getKind(), FromExpr->getKind());
+  EXPECT_EQ(childCount(ToExpr), 1u);
+  EXPECT_EQ(ToExpr->getPayload(), *ToExpr->child_begin());
+  EXPECT_NE(ToExpr->getPayload(), FromExpr->getPayload());
+  QualType ExpectedCarrier = ToContext.getObjC3OptionalType(
+      ToExpr->getPayloadTypeInfo()->getType());
+  EXPECT_TRUE(ToContext.hasSameType(ToExpr->getCarrierType(), ExpectedCarrier));
+  EXPECT_TRUE(ToExpr->getKeywordLoc().isValid());
+  EXPECT_TRUE(ToExpr->getCommaLoc().isValid());
+  EXPECT_TRUE(ToExpr->getRParenLoc().isValid());
+  EXPECT_EQ(ToContext.getSourceManager().getSpellingLineNumber(
+                ToExpr->getKeywordLoc()),
+            FromContext.getSourceManager().getSpellingLineNumber(
+                FromExpr->getKeywordLoc()));
+}
