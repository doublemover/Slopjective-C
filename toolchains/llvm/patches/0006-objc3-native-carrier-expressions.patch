+          ConsumeToken();
+          Name = Tok.getIdentifierInfo();
+        }
+        SourceLocation NameLoc = ConsumeToken();
+        Actions.ActOnObjC3BlockCapture(Name, Kind, SourceRange(Begin, NameLoc),
+                                       getCurScope());
+        if (Tok.isNot(tok::comma) && Tok.isNot(tok::r_square)) {
+          CaptureError(Tok.getLocation(),
+                       "expected ',' or ']' after Block capture item");
+          SkipUntil(tok::comma, tok::r_square, StopBeforeMatch);
+        }
+      }
+      if (Tok.isNot(tok::comma))
+        break;
+      ConsumeToken();
+      if (Tok.is(tok::r_square))
+        CaptureError(Tok.getLocation(),
+                     "expected a Block capture item after ','");
+    }
+    Captures.consumeClose();
+    Actions.ActOnObjC3BlockCaptureList(
+        SourceRange(Captures.getOpenLocation(), Captures.getCloseLocation()));
+  }
+
