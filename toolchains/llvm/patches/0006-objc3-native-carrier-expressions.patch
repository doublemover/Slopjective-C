+/// Explicit copy or move construction of a local ObjC3 Optional/Result from
+/// another carrier glvalue. The source is a real child and is evaluated once.
+/// The per-arm initialization recipes are ordinary Sema-produced expressions
+/// that reference their associated payload OpaqueValueExpr. CodeGen binds only
+/// the selected leaf to the corresponding source field after testing the tag.
+/// No carrier-wide native C++ special member is implied by this node.
+class ObjC3CarrierTransferExpr : public Expr {
+public:
+  enum class Kind : unsigned char { Copy, Move };
+
+private:
+  Kind Operation = Kind::Copy;
+  QualType CarrierType;
+  Stmt *SubExprs[4] = {};
+  OpaqueValueExpr *ValueSource = nullptr;
+  OpaqueValueExpr *SuccessSource = nullptr;
+  OpaqueValueExpr *ErrorSource = nullptr;
+  SourceLocation KeywordLoc, LParenLoc, RParenLoc;
+
+  ObjC3CarrierTransferExpr(Kind Operation, QualType CarrierType, Expr *Source,
+                           OpaqueValueExpr *ValueSource, Expr *ValueInit,
+                           OpaqueValueExpr *SuccessSource, Expr *SuccessInit,
+                           OpaqueValueExpr *ErrorSource, Expr *ErrorInit,
+                           SourceLocation KeywordLoc,
+                           SourceLocation LParenLoc, SourceLocation RParenLoc);
+
+public:
+  explicit ObjC3CarrierTransferExpr(EmptyShell Empty)
+      : Expr(ObjC3CarrierTransferExprClass, Empty) {}
+  static ObjC3CarrierTransferExpr *Create(
+      ASTContext &Context, Kind Operation, QualType CarrierType, Expr *Source,
+      OpaqueValueExpr *ValueSource, Expr *ValueInit,
+      OpaqueValueExpr *SuccessSource, Expr *SuccessInit,
+      OpaqueValueExpr *ErrorSource, Expr *ErrorInit,
+      SourceLocation KeywordLoc, SourceLocation LParenLoc,
+      SourceLocation RParenLoc);
+
+  Kind getKind() const { return Operation; }
+  void setKind(Kind Value) { Operation = Value; }
+  bool isMove() const { return Operation == Kind::Move; }
+  QualType getCarrierType() const { return CarrierType; }
+  void setCarrierType(QualType Value) { CarrierType = Value; }
+  Expr *getSource() const { return cast_or_null<Expr>(SubExprs[0]); }
+  void setSource(Expr *Value) { SubExprs[0] = Value; }
+  OpaqueValueExpr *getValueSource() const { return ValueSource; }
+  void setValueSource(OpaqueValueExpr *Value) { ValueSource = Value; }
+  Expr *getValueInit() const { return cast_or_null<Expr>(SubExprs[1]); }
+  void setValueInit(Expr *Value) { SubExprs[1] = Value; }
+  OpaqueValueExpr *getSuccessSource() const { return SuccessSource; }
+  void setSuccessSource(OpaqueValueExpr *Value) { SuccessSource = Value; }
+  Expr *getSuccessInit() const { return cast_or_null<Expr>(SubExprs[2]); }
+  void setSuccessInit(Expr *Value) { SubExprs[2] = Value; }
+  OpaqueValueExpr *getErrorSource() const { return ErrorSource; }
+  void setErrorSource(OpaqueValueExpr *Value) { ErrorSource = Value; }
+  Expr *getErrorInit() const { return cast_or_null<Expr>(SubExprs[3]); }
+  void setErrorInit(Expr *Value) { SubExprs[3] = Value; }
+  SourceLocation getKeywordLoc() const { return KeywordLoc; }
+  SourceLocation getLParenLoc() const { return LParenLoc; }
+  SourceLocation getRParenLoc() const { return RParenLoc; }
+  void setKeywordLoc(SourceLocation Value) { KeywordLoc = Value; }
+  void setLParenLoc(SourceLocation Value) { LParenLoc = Value; }
+  void setRParenLoc(SourceLocation Value) { RParenLoc = Value; }
+  SourceLocation getBeginLoc() const LLVM_READONLY { return KeywordLoc; }
+  SourceLocation getEndLoc() const LLVM_READONLY { return RParenLoc; }
+  child_range children() { return child_range(&SubExprs[0], &SubExprs[4]); }
+  const_child_range children() const {
+    return const_child_range(&SubExprs[0], &SubExprs[4]);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == ObjC3CarrierTransferExprClass;
+  }
+};
