+ExprDependence clang::computeDependence(ObjC3TryExpr *E) {
+  // A try operation keeps the operand's type/value/pack dependence and also
+  // reflects dependence introduced by the result type of `try?` optionality.
+  return toExprDependenceForImpliedType(E->getType()->getDependence()) |
+         E->getOperand()->getDependence();
+}
+
+ExprDependence clang::computeDependence(ObjC3MatchExpr *E) {
+  ExprDependence D = toExprDependenceForImpliedType(E->getType()->getDependence());
+  D |= E->getScrutinee()->getDependence();
+  for (unsigned I = 0; I != E->getNumArms(); ++I) {
+    const ObjC3MatchArm *Arm = E->getArm(I);
+    if (!Arm->getCanonicalPatternType().isNull())
+      D |= toExprDependenceForImpliedType(Arm->getCanonicalPatternType()->getDependence());
+    for (const Stmt *Child : Arm->children())
+      if (const auto *Expression = dyn_cast_or_null<Expr>(Child))
+        D |= Expression->getDependence();
+  }
+  return D;
+}
