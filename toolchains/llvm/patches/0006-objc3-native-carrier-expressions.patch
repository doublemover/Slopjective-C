+    OpaqueValueExpr *SuccessSource, Expr *SuccessInit,
+    OpaqueValueExpr *ErrorSource, Expr *ErrorInit,
+    SourceLocation KeywordLoc, SourceLocation LParenLoc,
+    SourceLocation RParenLoc)
+    : Expr(ObjC3CarrierTransferExprClass, CarrierType, VK_PRValue, OK_Ordinary),
+      Operation(Operation), CarrierType(CarrierType),
+      ValueSource(ValueSource), SuccessSource(SuccessSource),
+      ErrorSource(ErrorSource), KeywordLoc(KeywordLoc), LParenLoc(LParenLoc),
+      RParenLoc(RParenLoc) {
+  SubExprs[0] = Source;
