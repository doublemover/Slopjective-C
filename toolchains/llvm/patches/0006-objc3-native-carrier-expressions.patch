new file mode 100644
index 000000000..113d259be
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3OptionalExpr.cpp
@@ -0,0 +1,196 @@
+//===--- SemaObjC3OptionalExpr.cpp - Optional expression semantics --------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "clang/AST/TypeBase.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Initialization.h"
+#include "SemaObjC3CarrierARC.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+
+bool checkOptionalConstructionType(Sema &S, SourceLocation Loc,
+                                   QualType PayloadType,
+                                   QualType CarrierType) {
+  if (PayloadType->isArrayType() || PayloadType->isVariablyModifiedType() ||
+      PayloadType->isFunctionType() || PayloadType->isReferenceType()) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  if (PayloadType->isDependentType())
+    return false;
+
+  ObjC3CarrierRepresentationInfo Representation =
+      S.Context.getObjC3CarrierRepresentationType(CarrierType);
+  if (Representation.State ==
+      ObjC3CarrierRepresentationInfo::Status::Unsupported) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+
+  if (Representation.State ==
+      ObjC3CarrierRepresentationInfo::Status::Deferred) {
+    return S.RequireCompleteType(Loc, PayloadType,
+                                 diag::err_typecheck_decl_incomplete_type);
+  }
+  return false;
+}
+
+TypeSourceInfo *getPayloadTypeInfo(Sema &S, ParsedType ParsedType,
+                                   QualType &PayloadType) {
+  TypeSourceInfo *Info = nullptr;
+  PayloadType = S.GetTypeFromParser(ParsedType, &Info);
+  if (PayloadType.isNull())
+    return nullptr;
+  if (!Info)
+    Info = S.Context.getTrivialTypeSourceInfo(PayloadType);
+  return Info;
+}
+
+ExprResult buildOptionalExpr(Sema &S, ObjC3OptionalExpr::Kind Kind,
+                             QualType ResultType, QualType CarrierType,
+                             TypeSourceInfo *PayloadTypeInfo, Expr *Payload,
+                             SourceLocation KeywordLoc,
+                             SourceLocation LParenLoc,
+                             SourceLocation CommaLoc,
+                             SourceLocation RParenLoc) {
+  return ObjC3OptionalExpr::Create(
+      S.Context, Kind, ResultType, CarrierType, PayloadTypeInfo, Payload,
+      KeywordLoc, LParenLoc, CommaLoc, RParenLoc);
+}
+
+} // namespace
+
+ExprResult Sema::ActOnObjC3OptionalSomeExpr(SourceLocation KeywordLoc,
+                                            SourceLocation LParenLoc,
+                                            ParsedType PayloadTypeAsWritten,
+                                            Expr *Payload,
+                                            SourceLocation CommaLoc,
+                                            SourceLocation RParenLoc) {
+  if (!Payload)
+    return ExprError();
+
+  QualType PayloadType;
+  TypeSourceInfo *PayloadTypeInfo =
+      getPayloadTypeInfo(*this, PayloadTypeAsWritten, PayloadType);
+  if (!PayloadTypeInfo)
+    return ExprError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, PayloadType))
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3OptionalType(PayloadType);
+  if (checkOptionalConstructionType(*this, KeywordLoc, PayloadType,
+                                    CarrierType))
+    return ExprError();
+
+  if (PayloadType->isDependentType() || Payload->isTypeDependent()) {
+    return buildOptionalExpr(*this, ObjC3OptionalExpr::Kind::Some,
+                             CarrierType, CarrierType, PayloadTypeInfo, Payload,
+                             KeywordLoc, LParenLoc, CommaLoc, RParenLoc);
+  }
+
+  ExprResult InitializedPayload;
+  if (PayloadType->isVoidType()) {
+    if (!Payload->getType()->isVoidType()) {
+      DiagnoseAssignmentResult(AssignConvertType::Incompatible, CommaLoc,
+                               PayloadType, Payload->getType(), Payload,
+                               AssignmentAction::Initializing);
+      return ExprError();
+    }
+    InitializedPayload = Payload;
+  } else {
+    // Construct the active payload in its carrier field. Binding that field as
+    // a temporary would schedule destruction at the enclosing full expression
+    // and conflict with the carrier's eventual lifetime adapter. Source
+    // argument temporaries keep their normal native cleanup bindings.
+    auto Representation = Context.getObjC3CarrierRepresentationType(CarrierType);
+    assert(Representation.ValueField && "complete Optional payload field");
+    InitializedEntity Entity =
+        InitializedEntity::InitializeMember(Representation.ValueField);
+    InitializationKind Kind =
+        InitializationKind::CreateCopy(KeywordLoc, CommaLoc);
+    InitializationSequence Sequence(*this, Entity, Kind, Payload);
+    InitializedPayload = Sequence.Perform(*this, Entity, Kind, Payload);
+    if (InitializedPayload.isInvalid())
+      return ExprError();
+  }
+
+  Expr *InitializedExpr = InitializedPayload.getAs<Expr>();
+  CheckCompletedExpr(InitializedExpr, CommaLoc);
+  ExprResult Result = buildOptionalExpr(
+      *this, ObjC3OptionalExpr::Kind::Some, CarrierType, CarrierType,
+      PayloadTypeInfo, InitializedExpr, KeywordLoc, LParenLoc, CommaLoc,
+      RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
+
+ExprResult Sema::ActOnObjC3OptionalNoneExpr(SourceLocation KeywordLoc,
+                                            SourceLocation LParenLoc,
+                                            ParsedType PayloadTypeAsWritten,
+                                            SourceLocation RParenLoc) {
+  QualType PayloadType;
+  TypeSourceInfo *PayloadTypeInfo =
+      getPayloadTypeInfo(*this, PayloadTypeAsWritten, PayloadType);
+  if (!PayloadTypeInfo)
+    return ExprError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, PayloadType))
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3OptionalType(PayloadType);
+  if (checkOptionalConstructionType(*this, KeywordLoc, PayloadType,
+                                    CarrierType))
+    return ExprError();
+
+  return buildOptionalExpr(*this, ObjC3OptionalExpr::Kind::None, CarrierType,
+                           CarrierType, PayloadTypeInfo, nullptr, KeywordLoc,
+                           LParenLoc, SourceLocation(), RParenLoc);
+}
+
+ExprResult Sema::ActOnObjC3OptionalHasValueExpr(SourceLocation KeywordLoc,
+                                                 SourceLocation LParenLoc,
+                                                 Expr *OptionalValue,
+                                                 SourceLocation RParenLoc) {
+  if (!OptionalValue)
+    return ExprError();
+
+  ExprResult CheckedValue = CheckPlaceholderExpr(OptionalValue);
+  if (CheckedValue.isInvalid())
+    return ExprError();
+  OptionalValue = CheckedValue.get();
+
+  QualType CarrierType = Context.getCanonicalType(OptionalValue->getType());
+  const auto *Optional = CarrierType->getAs<ObjC3OptionalType>();
+  if (!OptionalValue->isTypeDependent() && !Optional) {
+    Diag(KeywordLoc, diag::err_objc3_has_value_requires_optional)
+        << OptionalValue->getType() << OptionalValue->getSourceRange();
+    return ExprError();
+  }
+
+  if (Optional && checkOptionalConstructionType(
+                      *this, KeywordLoc, Optional->getElementType(),
+                      CarrierType))
+    return ExprError();
+
+  CheckCompletedExpr(OptionalValue, RParenLoc);
+  const QualType ResultType = Context.BoolTy;
+  ExprResult Result = buildOptionalExpr(
+      *this, ObjC3OptionalExpr::Kind::HasValue, ResultType, CarrierType,
+      nullptr, OptionalValue, KeywordLoc, LParenLoc, SourceLocation(),
+      RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
diff --git a/clang/lib/Sema/SemaObjC3ResultExpr.cpp b/clang/lib/Sema/SemaObjC3ResultExpr.cpp
new file mode 100644
index 000000000..0183e9b78
--- /dev/null
+++ b/clang/lib/Sema/SemaObjC3ResultExpr.cpp
@@ -0,0 +1,276 @@
+//===--- SemaObjC3ResultExpr.cpp - Result expression semantics ------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "clang/AST/TypeBase.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Initialization.h"
+#include "SemaObjC3CarrierARC.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+
+TypeSourceInfo *getResultPayloadTypeInfo(Sema &S, ParsedType Parsed,
+                                         QualType &PayloadType) {
+  TypeSourceInfo *Info = nullptr;
+  PayloadType = S.GetTypeFromParser(Parsed, &Info);
+  if (PayloadType.isNull())
+    return nullptr;
+  if (!Info)
+    Info = S.Context.getTrivialTypeSourceInfo(PayloadType);
+  return Info;
+}
+
+/// Validate an arm independently so an unselected arm cannot make the Result
+/// carrier incomplete or admit a type with no native storage representation.
+bool checkResultPayloadType(Sema &S, SourceLocation Loc, QualType PayloadType,
+                            bool DeferCompleteness) {
+  if (PayloadType->isArrayType() || PayloadType->isVariablyModifiedType() ||
+      PayloadType->isFunctionType() || PayloadType->isReferenceType()) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  if (PayloadType->isVoidType() || PayloadType->isDependentType())
+    return false;
+  if (PayloadType->isIncompleteType() && !DeferCompleteness)
+    return S.RequireCompleteType(Loc, PayloadType,
+                                 diag::err_typecheck_decl_incomplete_type);
+  if (PayloadType->isIncompleteType())
+    return false;
+  if (!PayloadType->isObjectType()) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  return false;
+}
+
+bool checkResultRepresentation(Sema &S, SourceLocation Loc,
+                               QualType SuccessType, QualType ErrorType,
+                               QualType CarrierType,
+                               bool DeferCompleteness) {
+  if (checkResultPayloadType(S, Loc, SuccessType, DeferCompleteness) ||
+      checkResultPayloadType(S, Loc, ErrorType, DeferCompleteness))
+    return true;
+
+  ObjC3CarrierRepresentationInfo Representation =
+      S.Context.getObjC3CarrierRepresentationType(CarrierType);
+  if (Representation.State ==
+      ObjC3CarrierRepresentationInfo::Status::Unsupported) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << SuccessType;
+    return true;
+  }
+
+  if (Representation.State ==
+          ObjC3CarrierRepresentationInfo::Status::Deferred &&
+      !DeferCompleteness && !SuccessType->isDependentType() &&
+      !ErrorType->isDependentType()) {
+    if (S.RequireCompleteType(Loc, SuccessType,
+                              diag::err_typecheck_decl_incomplete_type))
+      return true;
+    if (S.RequireCompleteType(Loc, ErrorType,
+                              diag::err_typecheck_decl_incomplete_type))
+      return true;
+    // A non-dependent carrier must not pass construction while its computed
+    // representation remains deferred for any other reason.
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << ErrorType;
+    return true;
+  }
+  return false;
+}
+
+ExprResult buildResultExpr(Sema &S, ObjC3ResultExpr::Kind Kind,
+                           QualType ResultType, QualType CarrierType,
+                           TypeSourceInfo *SuccessTypeInfo,
+                           TypeSourceInfo *ErrorTypeInfo, Expr *Payload,
+                           SourceLocation KeywordLoc,
+                           SourceLocation LParenLoc,
+                           SourceLocation FirstCommaLoc,
+                           SourceLocation SecondCommaLoc,
+                           SourceLocation RParenLoc) {
+  return ObjC3ResultExpr::Create(
+      S.Context, Kind, ResultType, CarrierType, SuccessTypeInfo,
+      ErrorTypeInfo, Payload, KeywordLoc, LParenLoc, FirstCommaLoc,
+      SecondCommaLoc, RParenLoc);
+}
+
+ExprResult initializeResultPayload(Sema &S, SourceLocation KeywordLoc,
+                                   SourceLocation InitLoc,
+                                   FieldDecl *PayloadField,
+                                   QualType PayloadType, Expr *Payload) {
+  if (PayloadType->isVoidType()) {
+    if (Payload->getType()->isVoidType())
+      return Payload;
+    S.DiagnoseAssignmentResult(AssignConvertType::Incompatible, InitLoc,
+                               PayloadType, Payload->getType(), Payload,
+                               AssignmentAction::Initializing);
+    return ExprError();
+  }
+
+  assert(PayloadField && "complete Result payload field");
+  // The selected destination is a carrier field, not a native C++ temporary.
+  // The enclosing full-expression action owns source argument cleanups.
+  InitializedEntity Entity = InitializedEntity::InitializeMember(PayloadField);
+  InitializationKind Kind = InitializationKind::CreateCopy(KeywordLoc,
+                                                            InitLoc);
+  InitializationSequence Sequence(S, Entity, Kind, Payload);
+  return Sequence.Perform(S, Entity, Kind, Payload);
+}
+
+} // namespace
+
+ExprResult Sema::ActOnObjC3ResultOkExpr(
+    SourceLocation KeywordLoc, SourceLocation LParenLoc,
+    ParsedType SuccessTypeAsWritten, SourceLocation FirstCommaLoc,
+    ParsedType ErrorTypeAsWritten, SourceLocation SecondCommaLoc,
+    Expr *Payload, SourceLocation RParenLoc) {
+  if (!Payload)
+    return ExprError();
+
+  QualType SuccessType;
+  TypeSourceInfo *SuccessTypeInfo = getResultPayloadTypeInfo(
+      *this, SuccessTypeAsWritten, SuccessType);
+  if (!SuccessTypeInfo)
+    return ExprError();
+  QualType ErrorType;
+  TypeSourceInfo *ErrorTypeInfo =
+      getResultPayloadTypeInfo(*this, ErrorTypeAsWritten, ErrorType);
+  if (!ErrorTypeInfo)
+    return ExprError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, SuccessType) ||
+      normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, ErrorType))
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3ResultType(SuccessType, ErrorType);
+  const bool DeferCompleteness = SuccessType->isDependentType() ||
+                                 ErrorType->isDependentType() ||
+                                 Payload->isTypeDependent();
+  if (checkResultRepresentation(*this, KeywordLoc, SuccessType, ErrorType,
+                                CarrierType, DeferCompleteness))
+    return ExprError();
+
+  if (DeferCompleteness) {
+    return buildResultExpr(*this, ObjC3ResultExpr::Kind::Ok, CarrierType,
+                           CarrierType, SuccessTypeInfo, ErrorTypeInfo, Payload,
+                           KeywordLoc, LParenLoc, FirstCommaLoc, SecondCommaLoc,
+                           RParenLoc);
+  }
+
+  ExprResult InitializedPayload = initializeResultPayload(
+      *this, KeywordLoc, SecondCommaLoc,
+      Context.getObjC3CarrierRepresentationType(CarrierType).SuccessField,
+      SuccessType, Payload);
+  if (InitializedPayload.isInvalid())
+    return ExprError();
+  Expr *InitializedExpr = InitializedPayload.getAs<Expr>();
+  CheckCompletedExpr(InitializedExpr, SecondCommaLoc);
+
+  ExprResult Result = buildResultExpr(
+      *this, ObjC3ResultExpr::Kind::Ok, CarrierType, CarrierType,
+      SuccessTypeInfo, ErrorTypeInfo, InitializedExpr, KeywordLoc, LParenLoc,
+      FirstCommaLoc, SecondCommaLoc, RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
+
+ExprResult Sema::ActOnObjC3ResultErrExpr(
+    SourceLocation KeywordLoc, SourceLocation LParenLoc,
+    ParsedType SuccessTypeAsWritten, SourceLocation FirstCommaLoc,
+    ParsedType ErrorTypeAsWritten, SourceLocation SecondCommaLoc,
+    Expr *Payload, SourceLocation RParenLoc) {
+  if (!Payload)
+    return ExprError();
+
+  QualType SuccessType;
+  TypeSourceInfo *SuccessTypeInfo = getResultPayloadTypeInfo(
+      *this, SuccessTypeAsWritten, SuccessType);
+  if (!SuccessTypeInfo)
+    return ExprError();
+  QualType ErrorType;
+  TypeSourceInfo *ErrorTypeInfo =
+      getResultPayloadTypeInfo(*this, ErrorTypeAsWritten, ErrorType);
+  if (!ErrorTypeInfo)
+    return ExprError();
+
+  if (normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, SuccessType) ||
+      normalizeObjC3CarrierPayloadOwnership(*this, KeywordLoc, ErrorType))
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3ResultType(SuccessType, ErrorType);
+  const bool DeferCompleteness = SuccessType->isDependentType() ||
+                                 ErrorType->isDependentType() ||
+                                 Payload->isTypeDependent();
+  if (checkResultRepresentation(*this, KeywordLoc, SuccessType, ErrorType,
+                                CarrierType, DeferCompleteness))
+    return ExprError();
+
+  if (DeferCompleteness) {
+    return buildResultExpr(*this, ObjC3ResultExpr::Kind::Err, CarrierType,
+                           CarrierType, SuccessTypeInfo, ErrorTypeInfo, Payload,
+                           KeywordLoc, LParenLoc, FirstCommaLoc, SecondCommaLoc,
+                           RParenLoc);
+  }
+
+  ExprResult InitializedPayload = initializeResultPayload(
+      *this, KeywordLoc, SecondCommaLoc,
+      Context.getObjC3CarrierRepresentationType(CarrierType).ErrorField,
+      ErrorType, Payload);
+  if (InitializedPayload.isInvalid())
+    return ExprError();
+  Expr *InitializedExpr = InitializedPayload.getAs<Expr>();
+  CheckCompletedExpr(InitializedExpr, SecondCommaLoc);
+
+  ExprResult Result = buildResultExpr(
+      *this, ObjC3ResultExpr::Kind::Err, CarrierType, CarrierType,
+      SuccessTypeInfo, ErrorTypeInfo, InitializedExpr, KeywordLoc, LParenLoc,
+      FirstCommaLoc, SecondCommaLoc, RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
+
+ExprResult Sema::ActOnObjC3ResultIsOkExpr(SourceLocation KeywordLoc,
+                                          SourceLocation LParenLoc,
+                                          Expr *Operand,
+                                          SourceLocation RParenLoc) {
+  if (!Operand)
+    return ExprError();
+
+  ExprResult CheckedOperand = CheckPlaceholderExpr(Operand);
+  if (CheckedOperand.isInvalid())
+    return ExprError();
+  Operand = CheckedOperand.get();
+
+  QualType CarrierType = Context.getCanonicalType(Operand->getType());
+  const auto *ResultType = CarrierType->getAs<ObjC3ResultType>();
+  if (!Operand->isTypeDependent() && !ResultType) {
+    Diag(KeywordLoc, diag::err_objc3_is_ok_requires_result)
+        << Operand->getType() << Operand->getSourceRange();
+    return ExprError();
+  }
+
+  if (ResultType &&
+      checkResultRepresentation(*this, KeywordLoc,
+                                ResultType->getSuccessType(),
+                                ResultType->getErrorType(), CarrierType,
+                                Operand->isTypeDependent()))
+    return ExprError();
+
+  CheckCompletedExpr(Operand, RParenLoc);
+  ExprResult Result = buildResultExpr(
+      *this, ObjC3ResultExpr::Kind::IsOk, Context.BoolTy, CarrierType, nullptr,
+      nullptr, Operand, KeywordLoc, LParenLoc, SourceLocation(),
+      SourceLocation(), RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
