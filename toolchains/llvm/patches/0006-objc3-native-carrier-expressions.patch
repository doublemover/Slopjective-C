+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Expr.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+#include "clang/AST/TypeBase.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Sema/Initialization.h"
+#include "clang/Sema/Sema.h"
+
+using namespace clang;
+
+namespace {
+
+bool checkOptionalConstructionType(Sema &S, SourceLocation Loc,
+                                   QualType PayloadType,
+                                   QualType CarrierType) {
+  if (PayloadType->isArrayType() || PayloadType->isVariablyModifiedType() ||
+      PayloadType->isFunctionType() || PayloadType->isReferenceType()) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+  if (PayloadType->isDependentType())
+    return false;
+
+  ObjC3CarrierRepresentationInfo Representation =
+      S.Context.getObjC3CarrierRepresentationType(CarrierType);
+  if (Representation.State ==
+      ObjC3CarrierRepresentationInfo::Status::Unsupported) {
+    S.Diag(Loc, diag::err_objc3_carrier_payload_unsupported) << PayloadType;
+    return true;
+  }
+
+  if (Representation.State ==
+      ObjC3CarrierRepresentationInfo::Status::Deferred) {
+    return S.RequireCompleteType(Loc, PayloadType,
+                                 diag::err_typecheck_decl_incomplete_type);
+  }
+  return false;
+}
+
+TypeSourceInfo *getPayloadTypeInfo(Sema &S, ParsedType ParsedType,
+                                   QualType &PayloadType) {
+  TypeSourceInfo *Info = nullptr;
+  PayloadType = S.GetTypeFromParser(ParsedType, &Info);
+  if (PayloadType.isNull())
+    return nullptr;
+  if (!Info)
+    Info = S.Context.getTrivialTypeSourceInfo(PayloadType);
+  return Info;
+}
+
+ExprResult buildOptionalExpr(Sema &S, ObjC3OptionalExpr::Kind Kind,
+                             QualType ResultType, QualType CarrierType,
+                             TypeSourceInfo *PayloadTypeInfo, Expr *Payload,
+                             SourceLocation KeywordLoc,
+                             SourceLocation LParenLoc,
+                             SourceLocation CommaLoc,
+                             SourceLocation RParenLoc) {
+  return ObjC3OptionalExpr::Create(
+      S.Context, Kind, ResultType, CarrierType, PayloadTypeInfo, Payload,
+      KeywordLoc, LParenLoc, CommaLoc, RParenLoc);
+}
+
+} // namespace
+
+ExprResult Sema::ActOnObjC3OptionalSomeExpr(SourceLocation KeywordLoc,
+                                            SourceLocation LParenLoc,
+                                            ParsedType PayloadTypeAsWritten,
+                                            Expr *Payload,
+                                            SourceLocation CommaLoc,
+                                            SourceLocation RParenLoc) {
+  if (!Payload)
+    return ExprError();
+
+  QualType PayloadType;
+  TypeSourceInfo *PayloadTypeInfo =
+      getPayloadTypeInfo(*this, PayloadTypeAsWritten, PayloadType);
+  if (!PayloadTypeInfo)
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3OptionalType(PayloadType);
+  if (checkOptionalConstructionType(*this, KeywordLoc, PayloadType,
+                                    CarrierType))
+    return ExprError();
+
+  if (PayloadType->isDependentType() || Payload->isTypeDependent()) {
+    return buildOptionalExpr(*this, ObjC3OptionalExpr::Kind::Some,
+                             CarrierType, CarrierType, PayloadTypeInfo, Payload,
+                             KeywordLoc, LParenLoc, CommaLoc, RParenLoc);
+  }
+
+  ExprResult InitializedPayload;
+  if (PayloadType->isVoidType()) {
+    if (!Payload->getType()->isVoidType()) {
+      DiagnoseAssignmentResult(AssignConvertType::Incompatible, CommaLoc,
+                               PayloadType, Payload->getType(), Payload,
+                               AssignmentAction::Initializing);
+      return ExprError();
+    }
+    InitializedPayload = Payload;
+  } else {
+    // Construct the active payload in its carrier field. Binding that field as
+    // a temporary would schedule destruction at the enclosing full expression
+    // and conflict with the carrier's eventual lifetime adapter. Source
+    // argument temporaries keep their normal native cleanup bindings.
+    auto Representation = Context.getObjC3CarrierRepresentationType(CarrierType);
+    assert(Representation.ValueField && "complete Optional payload field");
+    InitializedEntity Entity =
+        InitializedEntity::InitializeMember(Representation.ValueField);
+    InitializationKind Kind =
+        InitializationKind::CreateCopy(KeywordLoc, CommaLoc);
+    InitializationSequence Sequence(*this, Entity, Kind, Payload);
+    InitializedPayload = Sequence.Perform(*this, Entity, Kind, Payload);
+    if (InitializedPayload.isInvalid())
+      return ExprError();
+  }
+
+  Expr *InitializedExpr = InitializedPayload.getAs<Expr>();
+  CheckCompletedExpr(InitializedExpr, CommaLoc);
+  ExprResult Result = buildOptionalExpr(
+      *this, ObjC3OptionalExpr::Kind::Some, CarrierType, CarrierType,
+      PayloadTypeInfo, InitializedExpr, KeywordLoc, LParenLoc, CommaLoc,
+      RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
+
+ExprResult Sema::ActOnObjC3OptionalNoneExpr(SourceLocation KeywordLoc,
+                                            SourceLocation LParenLoc,
+                                            ParsedType PayloadTypeAsWritten,
+                                            SourceLocation RParenLoc) {
+  QualType PayloadType;
+  TypeSourceInfo *PayloadTypeInfo =
+      getPayloadTypeInfo(*this, PayloadTypeAsWritten, PayloadType);
+  if (!PayloadTypeInfo)
+    return ExprError();
+
+  QualType CarrierType = Context.getObjC3OptionalType(PayloadType);
+  if (checkOptionalConstructionType(*this, KeywordLoc, PayloadType,
+                                    CarrierType))
+    return ExprError();
+
+  return buildOptionalExpr(*this, ObjC3OptionalExpr::Kind::None, CarrierType,
+                           CarrierType, PayloadTypeInfo, nullptr, KeywordLoc,
+                           LParenLoc, SourceLocation(), RParenLoc);
+}
+
+ExprResult Sema::ActOnObjC3OptionalHasValueExpr(SourceLocation KeywordLoc,
+                                                 SourceLocation LParenLoc,
+                                                 Expr *OptionalValue,
+                                                 SourceLocation RParenLoc) {
+  if (!OptionalValue)
+    return ExprError();
+
+  ExprResult CheckedValue = CheckPlaceholderExpr(OptionalValue);
+  if (CheckedValue.isInvalid())
+    return ExprError();
+  OptionalValue = CheckedValue.get();
+
+  QualType CarrierType = Context.getCanonicalType(OptionalValue->getType());
+  const auto *Optional = CarrierType->getAs<ObjC3OptionalType>();
+  if (!OptionalValue->isTypeDependent() && !Optional) {
+    Diag(KeywordLoc, diag::err_objc3_has_value_requires_optional)
+        << OptionalValue->getType() << OptionalValue->getSourceRange();
+    return ExprError();
+  }
+
+  if (Optional && checkOptionalConstructionType(
+                      *this, KeywordLoc, Optional->getElementType(),
+                      CarrierType))
+    return ExprError();
+
+  CheckCompletedExpr(OptionalValue, RParenLoc);
+  const QualType ResultType = Context.BoolTy;
+  ExprResult Result = buildOptionalExpr(
+      *this, ObjC3OptionalExpr::Kind::HasValue, ResultType, CarrierType,
+      nullptr, OptionalValue, KeywordLoc, LParenLoc, SourceLocation(),
+      RParenLoc);
+  if (Result.isInvalid())
+    return Result;
+  return Result;
+}
