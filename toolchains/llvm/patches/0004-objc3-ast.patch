+        id ordinary_factory(void) __attribute__((nothrow));
+        void ordinary_marker(int) __attribute__((nothrow));
+        void ordinary_raise(void);
+        void ordinary_path(void) {
+          @try {
+            id local=ordinary_factory();
+            ordinary_marker(11);ordinary_raise();(void)local;
