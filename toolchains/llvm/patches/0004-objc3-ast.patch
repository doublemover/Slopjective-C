+            unsigned Origins = 0;
+            for (FieldDecl *Field : Specialization->fields()) {
+              auto *Origin = From->getASTContext().getInstantiatedFromUnnamedFieldDecl(Field);
+              if (!Origin) continue;
+              ++Origins;
+              auto ImportedField = Importer.Import(Field);
+              ASSERT_TRUE(bool(ImportedField)) << llvm::toString(ImportedField.takeError());
+              auto ImportedOrigin = Importer.Import(Origin);
+              ASSERT_TRUE(bool(ImportedOrigin)) << llvm::toString(ImportedOrigin.takeError());
+              auto *Result = cast<FieldDecl>(*ImportedField);
+              EXPECT_EQ(To->getASTContext().getInstantiatedFromUnnamedFieldDecl(Result), *ImportedOrigin);
+              EXPECT_EQ(Result->getDeclContext(), cast<ClassTemplateSpecializationDecl>(*Imported));
+              auto Again = Importer.Import(Field);
+              ASSERT_TRUE(bool(Again)) << llvm::toString(Again.takeError());
+              EXPECT_EQ(*Again, Result);
+            }
+            EXPECT_EQ(Origins, 3u);
+          }
+        }
+        EXPECT_EQ(Specializations, 1u);
+      }
