+ int allocating(int n) __attribute__((allocating)){return n+5;}
+ template<bool Enabled> int conditional(int n) __attribute__((nonblocking(Enabled))){return n+2;}
+ template<class T> T sized(T n) __attribute__((nonallocating(sizeof(T)<=8))){return n+3;}
+ template<bool Enabled> using Callback=int (__attribute__((nonblocking(Enabled))) *)(int);
+ inline auto closure(){return [](int n) __attribute__((nonblocking)){return n+2;};}
+ inline int block(){return (^int(int n) __attribute__((nonallocating)){return n+3;})(39);}
+ )effects";
+ for(const char *Standard:{"c++20","c++23"}) {
+  std::vector<std::string> Args={"-x","c++",std::string("-std=")+Standard,"-fblocks","--target=x86_64-unknown-linux-gnu"};
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"native-effects-source.cpp");
+  auto To=tooling::buildASTFromCodeWithArgs("",Args,"native-effects-target.cpp");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  auto Shape=[](ASTContext &Context) {
+   struct Effects:RecursiveASTVisitor<Effects> {
+    ASTContext &Context;std::string Key;unsigned Conditions=0;
+    explicit Effects(ASTContext &Context):Context(Context){}
+    bool VisitFunctionProtoType(FunctionProtoType *Type) {
+     for(const auto &Effect:Type->getFunctionEffects()) {
+      Key+=Effect.Effect.name().str()+";";
+      if(auto *Condition=Effect.Cond.getCondition()) {
+       ++Conditions;llvm::raw_string_ostream Out(Key);Condition->printPretty(Out,nullptr,Context.getPrintingPolicy());
+       struct References:RecursiveASTVisitor<References> {
+        ASTContext *Expected=nullptr;
+        bool VisitDeclRefExpr(DeclRefExpr *E){EXPECT_EQ(&E->getDecl()->getASTContext(),Expected);return true;}
+       } references;references.Expected=&Context;references.TraverseStmt(Condition);
+      }
+     }
+     return true;
+    }
+   } effects(Context);
+   effects.TraverseDecl(Context.getTranslationUnitDecl());EXPECT_GE(effects.Conditions,3u);return effects.Key;
+  };
+  const auto Expected=Shape(From->getASTContext());ASSERT_FALSE(Expected.empty());
+  {
+   ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()) {
+    auto Result=Importer.Import(D);if(!Result){auto Message=llvm::toString(Result.takeError());FAIL()<<Message;}
+   }
+  }
+  From.reset();EXPECT_EQ(Shape(To->getASTContext()),Expected);
+  PrintingPolicy Policy(To->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+  std::string Printed;llvm::raw_string_ostream Out(Printed);
+  for(auto *D:To->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){D->print(Out,Policy);Out<<";\n";}
+  Out.flush();auto Replay=tooling::buildASTFromCodeWithArgs(Printed,Args,"native-effects-replay.cpp");
+  ASSERT_TRUE(Replay);EXPECT_FALSE(Replay->getDiagnostics().hasErrorOccurred());EXPECT_EQ(Shape(Replay->getASTContext()),Expected);
+ }
+}
