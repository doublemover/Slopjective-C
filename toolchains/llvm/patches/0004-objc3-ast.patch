+void JSONNodeDumper::writeObjC3FunctionEffects(ObjC3FunctionEffectInfo Effects) {
+  if (!Effects.Async && Effects.Throws == ObjC3ThrowsKind::None)
+    return;
+  JOS.attributeObject("objc3Effects", [=, this] {
+    attributeOnlyIfTrue("async", Effects.Async);
+    if (Effects.Async)
+      JOS.attribute("asyncABI", Effects.AsyncFrame ? "c-frame-v1" : "cxx-task-v1");
+    switch (Effects.Throws) {
+    case ObjC3ThrowsKind::None:
+      break;
+    case ObjC3ThrowsKind::Untyped:
+      JOS.attribute("throws", "untyped");
+      break;
+    case ObjC3ThrowsKind::Typed:
+      JOS.attribute("throws", "typed");
+      JOS.attribute("errorType", createQualType(Effects.ErrorType));
+      break;
+    }
+  });
+}
