+TEST(ObjC3ASTInfrastructure, NativeFunctionEffectsCoexistWithObjC3CallableEffects) {
+ const char *Source=
+   "int native_async(int) __objc3_async_frame __attribute__((blocking));"
+   "int native_checked(int) __objc3_throws(int) __attribute__((allocating));";
+ std::vector<std::string> Args={"-x","objective-c++","-std=c++23","-fobjc-version=3","-fobjc-runtime=gnustep-2.2","--target=x86_64-unknown-linux-gnu"};
