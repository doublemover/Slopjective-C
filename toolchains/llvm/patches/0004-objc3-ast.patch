+TEST(ObjC3ASTInfrastructure, TupleConstructionForwardsDistinctElementsOnce) {
+  struct OwnedPair {
+    std::unique_ptr<int> First, Second;
+    OwnedPair(std::unique_ptr<int> First, std::unique_ptr<int> Second)
+        : First(std::move(First)), Second(std::move(Second)) {}
+    OwnedPair(const OwnedPair &) = delete;
+    OwnedPair(OwnedPair &&) = delete;
+  };
+  auto Arguments = std::make_tuple(std::make_unique<int>(17),
+                                   std::make_unique<int>(29));
+  std::unique_ptr<OwnedPair> Owned(
+      clang::ast_matchers::internal::new_from_tuple<OwnedPair>(
+          std::move(Arguments)));
+  ASSERT_TRUE(Owned->First);
+  ASSERT_TRUE(Owned->Second);
+  EXPECT_EQ(17, *Owned->First);
+  EXPECT_EQ(29, *Owned->Second);
+  EXPECT_FALSE(std::get<0>(Arguments));
+  EXPECT_FALSE(std::get<1>(Arguments));
+
+  struct References {
+    int &Mutable;
+    const int &Constant;
+    References(int &Mutable, const int &Constant)
+        : Mutable(Mutable), Constant(Constant) {}
+    References(const References &) = delete;
+    References(References &&) = delete;
+  };
+  int Mutable = 3;
+  const int Constant = 5;
+  auto ReferenceArguments = std::forward_as_tuple(Mutable, Constant);
+  std::unique_ptr<References> Refs(
+      clang::ast_matchers::internal::new_from_tuple<References>(ReferenceArguments));
+  EXPECT_EQ(&Mutable, &Refs->Mutable);
+  EXPECT_EQ(&Constant, &Refs->Constant);
+  Refs->Mutable = 11;
+  EXPECT_EQ(11, Mutable);
+}
