+const char Managed[] = R"(
+#ifdef __cplusplus
+extern "C" {
+#endif
+id class_createInstance(Class, __SIZE_TYPE__) __attribute__((ns_returns_retained));
+id object_dispose(__unsafe_unretained id);
+#ifdef __cplusplus
+}
+#endif
+static int destroyed, calls, failed;
+__attribute__((objc_root_class))
+@interface GuardProbe { Class isa; int key; }
++ (id)newWithKey:(int)value;
+- (int)key;
+@end
+@implementation GuardProbe
++ (id)newWithKey:(int)value {
+  GuardProbe *object = class_createInstance(self, 0);
+  object->key = value;
+  return object;
+}
+- (int)key { return key; }
+- (void)dealloc { if (key == 42) ++destroyed; object_dispose(self); }
+@end
+#if GUARD_BLOCK
+  typedef int (^Value)(void);
+#else
+  typedef GuardProbe *Value;
+#endif
+#if GUARD_TAGGED
+  typedef __objc3_optional(Value GUARD_OWNERSHIP) Source;
+  #define EMPTY __objc3_none(Value GUARD_OWNERSHIP)
+  #define PRESENT(x) __objc3_some(Value GUARD_OWNERSHIP, x)
+#else
+  typedef Value GUARD_OWNERSHIP Source;
+  #define EMPTY ((Value)0)
+  #define PRESENT(x) (x)
+#endif
+static GuardProbe * __weak witness;
+static Source *counted(Source *input) { ++calls; return input; }
+int exercise(Source *input, Value __strong *owner, id token, int exceptional) {
+  Source source = *counted(input);
+  if (1) {} else { return -1; }
+  Value value = (Value)0;
+  *input = EMPTY;
+  *owner = (Value)0;
+  if (value) {
+    if (!witness || destroyed != exceptional) failed = 1;
+#if GUARD_BLOCK
+    if (value() != 42) failed = 2;
+#else
+    if ([value key] != 42) failed = 3;
+#endif
+  }
+  if (exceptional) @throw token;
+  return value ? 42 : 0;
+}
+int main(void) {
+  @autoreleasepool {
+    Value owner;
+    {
+      GuardProbe *object = [GuardProbe newWithKey:42];
+      witness = object;
+#if GUARD_BLOCK
+      owner = ^{ return [object key]; };
+#else
+      owner = object;
+#endif
+    }
+    Source input = PRESENT(owner);
+    if (exercise(&input, &owner, (id)0, 0) != 42 || calls != 1 || failed) return 1;
+    if (witness || destroyed != 1 || owner) return 2;
+    input = EMPTY;
+    if (exercise(&input, &owner, (id)0, 0) != -1 || calls != 2) return 3;
+#if GUARD_TAGGED
+    input = PRESENT((Value)0);
+    if (exercise(&input, &owner, (id)0, 0) != 0 || calls != 3) return 4;
+#endif
+#if GUARD_WEAK
+    {
+      GuardProbe *object = [GuardProbe newWithKey:41];
+#if GUARD_BLOCK
+      Value expired = ^{ return [object key]; };
+#else
+      Value expired = object;
+#endif
+      input = PRESENT(expired);
+    }
+    // A zeroed weak payload remains Some(nil); a direct weak source is absent.
+    if (exercise(&input, &owner, (id)0, 0) != (GUARD_TAGGED ? 0 : -1)) return 7;
+#endif
+    {
+      GuardProbe *object = [GuardProbe newWithKey:42];
+      witness = object;
+#if GUARD_BLOCK
+      owner = ^{ return [object key]; };
+#else
+      owner = object;
+#endif
+    }
+    input = PRESENT(owner);
+    id token = [GuardProbe newWithKey:99];
+    @try {
+      exercise(&input, &owner, token, 1);
+      return 5;
+    } @catch (id caught) {
+      if (caught != token || failed || witness || destroyed != 2 || owner) return 6;
+    }
+  }
+  return failed;
+}
+)";
