+TEST(ObjC3ASTInfrastructure, NativeManagedUnionPayloadRecipesSurviveImport) {
+ for(const char *Standard:{"c++20","c++23"}) {
+  std::vector<std::string> Args={"-x","objective-c++",std::string("-std=")+Standard,
+   "-fobjc-version=3","-fobjc-runtime=gnustep-2.2","-fobjc-arc","-fexceptions","-fobjc-exceptions"};
+  auto From=tooling::buildASTFromCodeWithArgs(R"(
+   struct NativeArm {id __strong owner;id __weak observer;};
+   union NativeUnion;
+   union alignas(64) NativeUnion {NativeArm owned;int plain;
+    NativeUnion();NativeUnion(const NativeUnion &);NativeUnion(NativeUnion &&);~NativeUnion() noexcept;};
+   using Maybe=__objc3_optional(NativeUnion);
+   Maybe provider(const Maybe &value){return __objc3_copy(value);}
+   struct MoveOnly {MoveOnly();MoveOnly(const MoveOnly &)=delete;MoveOnly(MoveOnly &&);~MoveOnly() noexcept;};
+   using MoveMaybe=__objc3_optional(MoveOnly);
+   MoveMaybe implicit_move(){MoveMaybe value=__objc3_some(MoveOnly,MoveOnly());return value;}
+  )",Args,"union-payload-provider.mm");
+  auto To=tooling::buildASTFromCodeWithArgs("",Args,"union-payload-consumer.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  auto Check=[](FunctionDecl *Function) {
+   struct Recipes : DynamicRecursiveASTVisitor {
+    ASTContext &Context;bool Move;unsigned Found=0;
+    Recipes(ASTContext &Context,bool Move):Context(Context),Move(Move) {}
+    bool VisitObjC3CarrierTransferExpr(ObjC3CarrierTransferExpr *Transfer) override {
+     EXPECT_EQ(Transfer->isMove(),Move);EXPECT_NE(Transfer->getValueInit(),nullptr);
+     struct Constructors : DynamicRecursiveASTVisitor {
+      ASTContext &Context;bool Move;unsigned Found=0;
+      Constructors(ASTContext &Context,bool Move):Context(Context),Move(Move) {}
+      bool VisitCXXConstructExpr(CXXConstructExpr *Construction) override {
+       const auto *Constructor=Construction->getConstructor();
+       EXPECT_EQ(&Constructor->getASTContext(),&Context);
+       EXPECT_EQ(Constructor->isMoveConstructor(),Move);++Found;return true;
+      }
+     } Constructors(Context,Move);
+     Constructors.TraverseStmt(Transfer->getValueInit());EXPECT_EQ(Constructors.Found,1u);++Found;return true;
+    }
+   } Recipes(Function->getASTContext(),Function->getName()=="implicit_move");
+   Recipes.TraverseStmt(Function->getBody());EXPECT_EQ(Recipes.Found,1u);
+   if(Function->getName()=="provider") {
+    const auto *Optional=Function->getReturnType()->getAs<ObjC3OptionalType>();ASSERT_NE(Optional,nullptr);
+    const auto *Record=Optional->getElementType()->getAsCXXRecordDecl()->getDefinition();ASSERT_NE(Record,nullptr);
+    EXPECT_TRUE(Record->isUnion());EXPECT_TRUE(Record->getDestructor()->isUserProvided());
+    EXPECT_EQ(Function->getASTContext().getTypeAlignInChars(Optional->getElementType()).getQuantity(),64);
+    std::string Encoding;EXPECT_TRUE(getObjC3CarrierRuntimeEncoding(Function->getASTContext(),Function->getReturnType(),Encoding));
+    EXPECT_NE(Encoding.find("__objc3_cxx_storage_v2"),std::string::npos);EXPECT_NE(Encoding.find("_a64"),std::string::npos);
+   }
+  };
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+  unsigned Checked=0;
+  for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())
+   if(auto *F=dyn_cast<FunctionDecl>(D);F && (F->getName()=="provider" || F->getName()=="implicit_move")) {
+    Check(F);auto Imported=Importer.Import(F);ASSERT_TRUE(bool(Imported));Check(cast<FunctionDecl>(*Imported));++Checked;
+   }
+  EXPECT_EQ(Checked,2u);
+ }
+}
