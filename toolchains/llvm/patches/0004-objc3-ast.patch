+SmallVector<const LifetimeCaptureByAttr *, 4>
+nativeReceiverLifetimeCaptures(const FunctionDecl *Function) {
+  SmallVector<const LifetimeCaptureByAttr *, 4> Attributes;
+  const auto *Method = dyn_cast_or_null<CXXMethodDecl>(Function);
+  if (!Method || Method->isStatic() || Method->isExplicitObjectMemberFunction())return Attributes;
