+#include "clang/Tooling/Tooling.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+using namespace clang;
+TEST(ObjC3ASTInfrastructure, ConditionalExplicitPredicatesRemainTargetOwned) {
+ const char *Source=R"explicit(
+ struct Implicit{int value;explicit(false) Implicit(int n):value(n){} explicit(false) operator int()const{return value;}};
+ struct Locked{int value;explicit(true) Locked(int n):value(n){} explicit(true) operator int()const{return value;}};
+ template<bool E>struct Toggle{int value;explicit(E) Toggle(int n):value(n){} explicit(E) operator int()const{return value;}};
+ template<class T>struct Flexible{T value;template<class U>explicit(!__is_same(T,U)) Flexible(U n):value(T(n)){} explicit(sizeof(T)>4) operator int()const{return int(value);}};
+ inline int exercise(){Implicit a=1;Toggle<false> b=2;Locked c(3);Flexible<int> d=4;return int(a)+int(b)+int(c)+int(d);}
+ )explicit";
+ for(const char *Standard:{"c++20","c++23"})for(const char *Language:{"c++","objective-c++"}) {
+  std::vector<std::string> Args={"-x",Language,std::string("-std=")+Standard,"--target=x86_64-unknown-linux-gnu"};
+  if(std::string(Language)=="objective-c++"){Args.push_back("-fobjc-version=3");Args.push_back("-fobjc-runtime=gnustep-2.2");Args.push_back("-fobjc-arc");}
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"explicit-source.mm");
+  auto To=tooling::buildASTFromCodeWithArgs("struct Implicit;struct Locked;template<bool E>struct Toggle;",Args,"explicit-target.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  {ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit() && From->getSourceManager().isWrittenInMainFile(D->getLocation())){
+    auto Imported=Importer.Import(D);if(!Imported)FAIL()<<llvm::toString(Imported.takeError());}}
+  From.reset();
+  struct Predicates:RecursiveASTVisitor<Predicates>{ASTContext &Context;unsigned Count=0,Dependent=0;
+   explicit Predicates(ASTContext &C):Context(C){}
+   bool VisitFunctionDecl(FunctionDecl *F){if(auto *E=ExplicitSpecifier::getFromDecl(F).getExpr()){
+    ++Count;Dependent+=E->isValueDependent();EXPECT_EQ(&F->getASTContext(),&Context);
+    std::string Printed;llvm::raw_string_ostream OS(Printed);E->printPretty(OS,nullptr,PrintingPolicy(Context.getLangOpts()),0,"\n",&Context);EXPECT_FALSE(Printed.empty());}return true;}
+   bool VisitDeclRefExpr(DeclRefExpr *E){EXPECT_EQ(&E->getDecl()->getASTContext(),&Context);return true;}
+  } Retained(To->getASTContext());Retained.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  EXPECT_GE(Retained.Count,8u);EXPECT_GE(Retained.Dependent,4u);
+  std::string Canonical;llvm::raw_string_ostream Printed(Canonical);PrintingPolicy Policy(To->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+  for(auto *D:To->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){
+   const auto *Named=dyn_cast<NamedDecl>(D);if(!Named || !Named->getIdentifier())continue;
+   const auto Name=Named->getName();if(Name!="Implicit" && Name!="Locked" && Name!="Toggle" && Name!="Flexible" && Name!="exercise")continue;
+   if(const auto *Record=dyn_cast<CXXRecordDecl>(D);Record && !Record->isCompleteDefinition())continue;
+   if(const auto *Template=dyn_cast<ClassTemplateDecl>(D);Template && !Template->getTemplatedDecl()->isCompleteDefinition())continue;
+   D->print(Printed,Policy);Printed<<";\n";}
+  auto Reparsed=tooling::buildASTFromCodeWithArgs(Canonical,Args,"explicit-reparsed.mm");ASSERT_TRUE(Reparsed);EXPECT_FALSE(Reparsed->getDiagnostics().hasErrorOccurred())<<Canonical;
+ }
+}
+TEST(ObjC3ASTInfrastructure, ConditionalExplicitEquivalenceBindsDependentExpressions) {
+ for(bool Different:{false,true}) {
+  const char *Left="template<bool E>struct Holder{explicit(E)Holder(int);explicit(E)operator int()const;};";
+  const char *Right=Different?"template<bool F>struct Holder{explicit(!F)Holder(int);explicit(!F)operator int()const;};":"template<bool F>struct Holder{explicit(F)Holder(int);explicit(F)operator int()const;};";
+  auto A=tooling::buildASTFromCodeWithArgs(Left,{"-std=c++20"},"left.cpp");auto B=tooling::buildASTFromCodeWithArgs(Right,{"-std=c++20"},"right.cpp");ASSERT_TRUE(A);ASSERT_TRUE(B);
+  ClassTemplateDecl *AT=nullptr,*BT=nullptr;for(auto *D:A->getASTContext().getTranslationUnitDecl()->decls())if(auto *T=dyn_cast<ClassTemplateDecl>(D))AT=T;
+  for(auto *D:B->getASTContext().getTranslationUnitDecl()->decls())if(auto *T=dyn_cast<ClassTemplateDecl>(D))BT=T;ASSERT_TRUE(AT);ASSERT_TRUE(BT);
+  llvm::DenseSet<std::tuple<Decl *,Decl *,int>> NonEquivalent;
+  StructuralEquivalenceContext Context(A->getASTContext().getLangOpts(),A->getASTContext(),B->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+  EXPECT_EQ(Context.IsEquivalent(AT,BT),!Different);
+ }
+}
+TEST(ObjC3ASTInfrastructure, ConditionalExplicitImportRejectsChangedPredicate) {
+ for(bool Reverse:{false,true}){
+  const char *Positive="template<bool E>struct Holder{explicit(E)Holder(int);explicit(E)operator int()const;};";
+  const char *Negative="template<bool E>struct Holder{explicit(!E)Holder(int);explicit(!E)operator int()const;};";
+  auto From=tooling::buildASTFromCodeWithArgs(Reverse?Negative:Positive,{"-std=c++20"},"source.cpp");auto To=tooling::buildASTFromCodeWithArgs(Reverse?Positive:Negative,{"-std=c++20"},"target.cpp");ASSERT_TRUE(From);ASSERT_TRUE(To);
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);bool Rejected=false;
+  for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){
+   auto Imported=Importer.Import(D);if(!Imported){llvm::consumeError(Imported.takeError());Rejected=true;}}
+  EXPECT_TRUE(Rejected);
+ }
+}

