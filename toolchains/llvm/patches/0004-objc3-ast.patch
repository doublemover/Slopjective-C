+      if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getName()=="factory")Function=F;
+    ASSERT_TRUE(Function);
+    auto members=[](const CXXRecordDecl *Record) {
+      std::vector<std::string> Names;
+      for(auto *D:Record->decls())
+        if(const auto *Named=dyn_cast<NamedDecl>(D);Named && !D->isImplicit())
+          Names.push_back(Named->getNameAsString());
+      return Names;
+    };
+    const auto Expected=members(Function->getReturnType()->getAsCXXRecordDecl());
+    EXPECT_EQ(Expected,(std::vector<std::string>{"Left","Right","Code","Choice","value"}));
+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+    auto Imported=Importer.Import(Function);ASSERT_TRUE(bool(Imported))<<llvm::toString(Imported.takeError());
+    EXPECT_EQ(members(cast<FunctionDecl>(*Imported)->getReturnType()->getAsCXXRecordDecl()),Expected);
+  }
+}
+
+TEST(ObjC3FunctionEffectImport, OptionalDeclarationAttributeArgumentsCompareSafely) {
+  const std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                          "-fobjc-version=3"};
+  auto Unit = tooling::buildASTFromCodeWithArgs(R"(
+    using Integer = int;
+    struct [[gsl::Owner]] OwnerNone {};
+    struct [[gsl::Owner(int)]] OwnerInt {};
+    struct [[gsl::Owner(Integer)]] OwnerAlias {};
+    struct [[gsl::Owner(double)]] OwnerDouble {};
+    struct [[gsl::Pointer]] PointerNone {};
+    struct [[gsl::Pointer(int)]] PointerInt {};
+    struct [[gsl::Pointer(Integer)]] PointerAlias {};
+    struct [[gsl::Pointer(double)]] PointerDouble {};
+    __attribute__((malloc)) void *allocate();
+  )", Args, "optional-attributes.mm");
+  ASSERT_TRUE(Unit);
+  ASSERT_FALSE(Unit->getDiagnostics().hasErrorOccurred());
+  auto &Context = Unit->getASTContext();
+  auto Equivalent = [&](const Attr *Left, const Attr *Right) {
+    StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalent;
+    StructuralEquivalenceContext Comparison(
+        Context.getLangOpts(), Context, Context, NonEquivalent,
+        StructuralEquivalenceKind::Default, false, false);
+    return Left->isEquivalent(*Right, Comparison);
+  };
+  for (llvm::StringRef Prefix : {"Owner", "Pointer"}) {
+    auto Attribute = [&](llvm::StringRef Suffix) -> const Attr * {
+      auto *Record = recordType(Context, (Prefix + Suffix).str())->getAsCXXRecordDecl();
+      return Prefix == "Owner" ? static_cast<const Attr *>(Record->getAttr<OwnerAttr>())
+                               : static_cast<const Attr *>(Record->getAttr<PointerAttr>());
+    };
+    const auto *None = Attribute("None"), *Int = Attribute("Int"),
+               *Alias = Attribute("Alias"), *Double = Attribute("Double");
+    ASSERT_TRUE(None && Int && Alias && Double);
+    EXPECT_TRUE(Equivalent(None, None->clone(Context)));
+    EXPECT_FALSE(Equivalent(None, Int));
+    EXPECT_FALSE(Equivalent(Int, None));
+    EXPECT_TRUE(Equivalent(Int, Alias));
+    EXPECT_FALSE(Equivalent(Int, Double));
+  }
+  const auto *Allocate = findFunction(Context, "allocate");
+  ASSERT_TRUE(Allocate);
+  const auto *Malloc = Allocate->getAttr<RestrictAttr>();
+  ASSERT_TRUE(Malloc);
+  EXPECT_TRUE(Equivalent(Malloc, Malloc->clone(Context)));
+}
diff --git a/clang/unittests/AST/ObjC3FunctionEffectTest.cpp b/clang/unittests/AST/ObjC3FunctionEffectTest.cpp
