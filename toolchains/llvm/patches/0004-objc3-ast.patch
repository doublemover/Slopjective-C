+TEST(ObjC3ASTInfrastructure, StatementExpressionSelectsOnlyItsTerminalBorrow) {
+  constexpr llvm::StringLiteral Code = R"(
+    void examine(borrowed const char *loan, const char *owned) {
+      const char *owned_result = ({ (void)loan; owned_label: owned; });
+      const char *borrowed_result = ({ (void)owned; loan_label: loan; });
+      (void)owned_result;
+      (void)borrowed_result;
+    }
+  )";
+  auto AST = tooling::buildASTFromCodeWithArgs(
+      Code, {"-x", "objective-c", "-std=c17", "-fobjc-version=3",
+             "-fobjc3-profile=strict-system",
+             "-target", "x86_64-unknown-linux-gnu"}, "result.m");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  for (bool Borrowed : {false, true}) {
+    StringRef Name = Borrowed ? "borrowed_result" : "owned_result";
+    const auto *Variable = selectFirst<VarDecl>(
+        "variable", match(varDecl(hasName(Name)).bind("variable"), Context));
+    ASSERT_TRUE(Variable && Variable->hasInit());
+    const auto *Statement = dyn_cast<StmtExpr>(
+        Variable->getInit()->IgnoreParenImpCasts());
+    ASSERT_TRUE(Statement);
+    const Expr *Result = getObjC3StatementExpressionResult(*Statement);
+    ASSERT_TRUE(Result);
+    const auto *Reference = dyn_cast<DeclRefExpr>(Result->IgnoreParenImpCasts());
+    ASSERT_TRUE(Reference);
+    EXPECT_EQ(Borrowed ? "loan" : "owned", Reference->getDecl()->getName());
+    EXPECT_EQ(Borrowed, isObjC3BorrowedType(Context, Reference->getType()));
+  }
+}
