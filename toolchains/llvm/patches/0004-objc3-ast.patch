+  auto Imported = Importer.Import(FD);
+  ASSERT_TRUE(static_cast<bool>(Imported))
+      << llvm::toString(Imported.takeError());
+  auto *Function = cast<FunctionDecl>(*Imported);
+  const auto *Body = cast<CompoundStmt>(Function->getBody());
+  const auto *Declaration = cast<DeclStmt>(*Body->body_begin());
+  const auto *Variable = cast<VarDecl>(Declaration->getSingleDecl());
+  auto Contract =
+      getObjC3ResourceTypeContract(To->getASTContext(), Variable->getType());
+  ASSERT_TRUE(Contract.Cleanup && Contract.Family && Contract.Invalid);
+  ASSERT_TRUE(Contract.getCleanupFunction());
+  EXPECT_EQ("Handles", Contract.Family->getFamily()->getName());
+  EXPECT_EQ(&To->getASTContext(),
