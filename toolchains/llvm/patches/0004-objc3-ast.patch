+    ASSERT_GT(Budget--,0u);ASSERT_LT(Depth,128u);
+    Unwind|=Block->isNativeExceptionExit();Termination|=Block->hasNoReturnElement();
+    for(const auto &Element:*Block) {
+      if(auto Init=Element.getAs<CFGInitializer>()) {
+        auto *I=Init->getInitializer();
+        Complete.push_back(I->isBaseInitializer()?0:I->getMember()->getName()=="first"?1:2);
+      }
+      int Destroyed=-1;
+      if(auto Member=Element.getAs<CFGMemberDtor>())Destroyed=Member->getFieldDecl()->getName()=="first"?1:2;
+      if(auto Base=Element.getAs<CFGBaseDtor>()) {Destroyed=0;EXPECT_NE(Base->getDestructorDecl(AST->getASTContext()),nullptr);}
+      if(Destroyed>=0) {
