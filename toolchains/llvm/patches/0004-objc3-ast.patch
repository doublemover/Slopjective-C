+  const char *Positive="struct Owner{template<class T>struct Cell{template<class U>Cell(U);};explicit Cell(int)->Cell<long>;};";
+  const char *Negative="struct Owner{template<class T>struct Cell{template<class U>Cell(U);};Cell(int)->Cell<long>;};";
+  auto From=tooling::buildASTFromCodeWithArgs(Reverse?Negative:Positive,{"-std=c++20"},"from.cpp");auto To=tooling::buildASTFromCodeWithArgs(Reverse?Positive:Negative,{"-std=c++20"},"to.cpp");ASSERT_TRUE(From);ASSERT_TRUE(To);
+  CXXRecordDecl *Root=nullptr;for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(auto *R=dyn_cast<CXXRecordDecl>(D);R && R->getName()=="Owner" && R->isCompleteDefinition())Root=R;ASSERT_TRUE(Root);
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);auto Imported=Importer.Import(Root);EXPECT_FALSE(bool(Imported));if(!Imported)llvm::consumeError(Imported.takeError());
+ }
+}
+
+TEST(ObjC3ASTInfrastructure, FunctionTemplateEquivalenceChecksGuideDeclarationPolicy) {
+ for(bool Different:{false,true}) {
+  const std::string Prefix="template<class T>struct Box{template<class U>Box(U);};";
+  auto A=tooling::buildASTFromCodeWithArgs(Prefix+"template<class T>explicit(sizeof(T)>4)Box(T)->Box<T>;",{"-std=c++20"},"left.cpp");
+  auto B=tooling::buildASTFromCodeWithArgs(Prefix+(Different?"template<class U>explicit(sizeof(U)>8)Box(U)->Box<U>;":"template<class U>explicit(sizeof(U)>4)Box(U)->Box<U>;"),{"-std=c++20"},"right.cpp");
+  ASSERT_TRUE(A);ASSERT_TRUE(B);auto *L=OnlyGuide(*A),*R=OnlyGuide(*B);ASSERT_TRUE(L);ASSERT_TRUE(R);
+  llvm::DenseSet<std::tuple<Decl *,Decl *,int>> NonEquivalent;
+  StructuralEquivalenceContext Context(A->getASTContext().getLangOpts(),A->getASTContext(),B->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+  EXPECT_EQ(Context.IsEquivalent(L->getDescribedFunctionTemplate(),R->getDescribedFunctionTemplate()),!Different);
+ }
+}
+TEST(ObjC3ASTInfrastructure, CompleteRecordsRejectTemplateAndBareExplicitPolicyChanges) {
+ for(const auto &Pair:std::vector<std::pair<std::string,std::string>>{
+  {"struct Owner{template<class T>struct Cell{template<class U>Cell(U);};template<class T>explicit(sizeof(T)>4)Cell(T)->Cell<T>;};", "struct Owner{template<class T>struct Cell{template<class U>Cell(U);};template<class T>explicit(sizeof(T)>8)Cell(T)->Cell<T>;};"},
+  {"struct Owner{explicit Owner(int);};","struct Owner{Owner(int);};"},
+  {"struct Owner{template<class T>explicit(sizeof(T)>4)Owner(T);};","struct Owner{template<class U>explicit(sizeof(U)>8)Owner(U);};"}})
+ for(bool Reverse:{false,true}) {
+  auto From=tooling::buildASTFromCodeWithArgs(Reverse?Pair.second:Pair.first,{"-std=c++20"},"from.cpp");auto To=tooling::buildASTFromCodeWithArgs(Reverse?Pair.first:Pair.second,{"-std=c++20"},"to.cpp");ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  CXXRecordDecl *Root=nullptr;for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(auto *R=dyn_cast<CXXRecordDecl>(D);R && R->getName()=="Owner" && R->isCompleteDefinition())Root=R;ASSERT_TRUE(Root);
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);auto Imported=Importer.Import(Root);EXPECT_FALSE(bool(Imported));if(!Imported)llvm::consumeError(Imported.takeError());
+ }
+}
+TEST(ObjC3ASTInfrastructure, CompleteRecordsRejectClassAndMethodFinalPolicyChanges) {
+ for(const auto &Pair:std::vector<std::pair<std::string,std::string>>{
+  {"struct Owner final{int value;};","struct Owner{int value;};"},
+  {"struct Owner{virtual int run() final;};","struct Owner{virtual int run();};"}})
+ for(bool Reverse:{false,true}) {
+  auto From=tooling::buildASTFromCodeWithArgs(Reverse?Pair.second:Pair.first,{"-std=c++20"},"from.cpp");auto To=tooling::buildASTFromCodeWithArgs(Reverse?Pair.first:Pair.second,{"-std=c++20"},"to.cpp");ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  CXXRecordDecl *Root=nullptr;for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(auto *R=dyn_cast<CXXRecordDecl>(D);R && R->getName()=="Owner" && R->isCompleteDefinition())Root=R;ASSERT_TRUE(Root);
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);auto Imported=Importer.Import(Root);EXPECT_FALSE(bool(Imported));if(!Imported)llvm::consumeError(Imported.takeError());
+ }
+}
+TEST(ObjC3ASTInfrastructure, FunctionTemplateEquivalenceRetainsNativeMethodCategory) {
+ for(bool Different:{false,true}) {
+  auto A=tooling::buildASTFromCodeWithArgs("struct Owner{template<class T>static int call(T);};",{"-std=c++20"},"left.cpp");
+  auto B=tooling::buildASTFromCodeWithArgs(Different?"struct Owner{template<class U>int call(U);};":"struct Owner{template<class U>static int call(U);};",{"-std=c++20"},"right.cpp");ASSERT_TRUE(A);ASSERT_TRUE(B);
+  auto Find=[](ASTUnit &Unit)->FunctionTemplateDecl *{for(auto *D:Unit.getASTContext().getTranslationUnitDecl()->decls())if(auto *R=dyn_cast<CXXRecordDecl>(D);R && R->isCompleteDefinition())for(auto *M:R->decls())if(auto *T=dyn_cast<FunctionTemplateDecl>(M))return T;return nullptr;};
+  auto *L=Find(*A),*R=Find(*B);ASSERT_TRUE(L);ASSERT_TRUE(R);
+  llvm::DenseSet<std::tuple<Decl *,Decl *,int>> NonEquivalent;StructuralEquivalenceContext Context(A->getASTContext().getLangOpts(),A->getASTContext(),B->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+  EXPECT_EQ(Context.IsEquivalent(L,R),!Different);
