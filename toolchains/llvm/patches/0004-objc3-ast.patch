+        EXPECT_EQ(std::count(Trace.begin(),Trace.end(),4),0);
+        if(std::find(Trace.begin(),Trace.end(),2)!=Trace.end())++FailedDestruction;
+        else if(std::find(Trace.begin(),Trace.end(),1)!=Trace.end())++FailedConstruction;
+      } else {++Normal;EXPECT_EQ(Trace[Trace.size()-2],31);EXPECT_EQ(Trace.back(),4);}
