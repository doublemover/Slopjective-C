+TEST(ObjC3ASTInfrastructure, NativeCleanupOverloadsSelectConcreteStorageAndTemplates) {
+  const char *Source=R"(
+    void close(int);void close(long);void close(int *);
+    template<class T>void address(T *);
+    template<class T>void resource(T);
+    template<class T>void use(T initial){
+      @cleanup(address) auto dependent=initial;
+      @resource(resource,invalid:-1) T handle=initial;
+    }
+    void concrete(){@cleanup(close) int scalar=1;@cleanup(close) long wider=2;use(3);}
+  )";
+  for(const char *Standard:{"-std=c++20","-std=c++23"})for(bool ARC:{false,true}) {
+    std::vector<std::string> Args={"-x","objective-c++",Standard,"-fobjc-version=3","-fobjc-runtime=gnustep-2.2","-fobjc3-profile=strict-system"};
+    if(ARC)Args.push_back("-fobjc-arc");
+    auto AST=tooling::buildASTFromCodeWithArgs(Source,Args,"cleanup-selection.mm");ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    auto &Context=AST->getASTContext();
+    struct Storage:RecursiveASTVisitor<Storage> {
+      ASTContext &Context;unsigned Concrete=0,Deferred=0;
+      explicit Storage(ASTContext &Context):Context(Context){}
+      bool shouldVisitTemplateInstantiations()const{return true;}
+      bool VisitVarDecl(VarDecl *V){
+        const Expr *Call=nullptr;bool Address=false;
+        if(auto *A=V->getAttr<ObjCCleanupAttr>()){Call=A->getCall();Address=A->getByAddress();}
+        else if(auto *A=V->getAttr<ObjCResourceAttr>()){Call=A->getCall();Address=A->getByAddress();}
+        else return true;
+        if(V->getType()->isDependentType()){EXPECT_FALSE(Call);++Deferred;return true;}
+        ASSERT_CALL(Call);
+        auto *C=dyn_cast<CallExpr>(Call);EXPECT_TRUE(C);if(!C)return true;
+        auto *F=C->getDirectCallee();EXPECT_TRUE(F);if(!F)return true;
+        auto Parameter=F->getParamDecl(0)->getType();
+        EXPECT_TRUE(Context.hasSameUnqualifiedType(Parameter,Address?Context.getPointerType(V->getType()):V->getType()));
+        if(V->getName()=="dependent") {EXPECT_TRUE(Address);EXPECT_TRUE(F->getPrimaryTemplate());}
+        if(V->getName()=="handle") {EXPECT_FALSE(Address);EXPECT_TRUE(F->getPrimaryTemplate());}
+        ++Concrete;return true;
+      }
+      void ASSERT_CALL(const Expr *Call){EXPECT_TRUE(Call);}
+    } Values(Context);
+    Values.TraverseDecl(Context.getTranslationUnitDecl());EXPECT_EQ(Values.Deferred,2U);EXPECT_EQ(Values.Concrete,4U);
+  }
