+ + (id)newBorrow __attribute__((objc_method_family(none)));
+ @end
+ __attribute__((objc_subclassing_restricted)) @interface PolicyLeaf:PolicyRoot @end
+ __attribute__((objc_nonlazy_class)) @interface PolicyEager:PolicyRoot @end
+ __attribute__((objc_runtime_visible)) @interface PolicyVisible:PolicyRoot @end
+ struct __attribute__((objc_boxable)) PolicyBox {int value;};
+ inline int policy_precise(PolicyRoot *object){id value __attribute__((objc_precise_lifetime))=object;return value!=0;}
+ )policies";
+ for(const char *Language:{"objective-c","objective-c++"})for(bool Arc:{false,true}) {
+  std::vector<std::string> Args={"-x",Language,std::string("-std=")+(std::string(Language)=="objective-c"?"c17":"c++20"),"--target=x86_64-unknown-linux-gnu","-fobjc-version=3","-fobjc-runtime=gnustep-2.2"};
+  if(Arc)Args.push_back("-fobjc-arc");
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"policies-source.mm");
+  auto To=tooling::buildASTFromCodeWithArgs("@class PolicyRoot,PolicyLeaf;@protocol PolicyExplicit;",Args,"policies-target.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  {ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()) {
+    auto Imported=Importer.Import(D);if(!Imported){FAIL()<<llvm::toString(Imported.takeError());}
+   }}
+  From.reset();unsigned Policies=0;
+  for(auto *D:To->getASTContext().getTranslationUnitDecl()->decls()) {
+   if(const auto *Interface=dyn_cast<ObjCInterfaceDecl>(D);Interface && Interface->isThisDeclarationADefinition()) {
+    const auto Name=Interface->getName();
+    if(Name=="PolicyRoot") {++Policies;EXPECT_TRUE(Interface->hasAttr<ObjCRequiresPropertyDefsAttr>());EXPECT_TRUE(Interface->hasDesignatedInitializers());
+     unsigned Methods=0;for(const auto *Method:Interface->methods()){
+      if(Method->getSelector().getAsString()=="init"){++Methods;EXPECT_TRUE(Method->hasAttr<ObjCDesignatedInitializerAttr>());}
+      if(Method->getSelector().getAsString()=="refresh"){++Methods;EXPECT_TRUE(Method->hasAttr<ObjCRequiresSuperAttr>());}}
+     EXPECT_EQ(Methods,2u);
+     unsigned Families=0;for(const auto *Method:Interface->methods())if(const auto *Family=Method->getAttr<ObjCMethodFamilyAttr>()){
+      ++Families;const auto Name=Method->getSelector().getAsString();
+      EXPECT_EQ(std::string(ObjCMethodFamilyAttr::ConvertFamilyKindToStr(Family->getFamily())),
+          Name=="make"?"new":Name=="create"?"alloc":Name=="clone"?"copy":Name=="mutableClone"?"mutableCopy":Name=="initializeRoot"?"init":"none");
+      EXPECT_EQ(Method->getMethodFamily(),Name=="make"?OMF_new:Name=="create"?OMF_alloc:Name=="clone"?OMF_copy:Name=="mutableClone"?OMF_mutableCopy:Name=="initializeRoot"?OMF_init:OMF_None);}
+     EXPECT_EQ(Families,6u);}
+    if(Name=="PolicyLeaf"){++Policies;EXPECT_TRUE(Interface->hasAttr<ObjCSubclassingRestrictedAttr>());}
+    if(Name=="PolicyEager"){++Policies;EXPECT_TRUE(Interface->hasAttr<ObjCNonLazyClassAttr>());}
+    if(Name=="PolicyVisible"){++Policies;EXPECT_TRUE(Interface->hasAttr<ObjCRuntimeVisibleAttr>());}
+   }
+   if(const auto *Protocol=dyn_cast<ObjCProtocolDecl>(D);Protocol && Protocol->isThisDeclarationADefinition()) {
+    if(Protocol->getName()=="PolicyExplicit"){++Policies;EXPECT_TRUE(Protocol->hasAttr<ObjCExplicitProtocolImplAttr>());}
+    if(Protocol->getName()=="PolicyStatic"){++Policies;EXPECT_TRUE(Protocol->hasAttr<ObjCNonRuntimeProtocolAttr>());}
+   }
+   if(const auto *Record=dyn_cast<RecordDecl>(D);Record && Record->getName()=="PolicyBox") {++Policies;EXPECT_TRUE(Record->hasAttr<ObjCBoxableAttr>());}
+  }
+  EXPECT_EQ(Policies,7u);
+  PrintingPolicy Policy(To->getASTContext().getLangOpts());Policy.PrintAsCanonical=true;
+  std::string Canonical;llvm::raw_string_ostream Printed(Canonical);
+  for(auto *D:To->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()) {
+    const auto *Named=dyn_cast<NamedDecl>(D);if(!Named || !Named->getIdentifier())continue;
+    if(!Named->getName().starts_with("Policy") && Named->getName()!="policy_precise")continue;
+    if(const auto *Interface=dyn_cast<ObjCInterfaceDecl>(D);Interface && !Interface->isThisDeclarationADefinition())continue;
+    if(const auto *Protocol=dyn_cast<ObjCProtocolDecl>(D);Protocol && !Protocol->isThisDeclarationADefinition())continue;
+    D->print(Printed,Policy);
+    if(!isa<ObjCInterfaceDecl,ObjCProtocolDecl>(D))Printed<<';';Printed<<'\n';
+  }
+  auto Reparsed=tooling::buildASTFromCodeWithArgs(Canonical,Args,"policies-reparsed.mm");
+  ASSERT_TRUE(Reparsed);EXPECT_FALSE(Reparsed->getDiagnostics().hasErrorOccurred())<<Canonical;
+ }
+ for(const auto &Declarations:std::vector<std::pair<std::string,std::string>>{
+     {"__attribute__((objc_root_class)) @interface MergePolicy -(id)init __attribute__((objc_designated_initializer));@end","__attribute__((objc_root_class)) @interface MergePolicy -(id)init;@end"},
+     {"__attribute__((objc_root_class)) @interface MergePolicy -(void)refresh __attribute__((objc_requires_super));@end","__attribute__((objc_root_class)) @interface MergePolicy -(void)refresh;@end"},
+     {"__attribute__((objc_root_class,objc_subclassing_restricted)) @interface MergePolicy @end","__attribute__((objc_root_class)) @interface MergePolicy @end"},
+     {"__attribute__((objc_root_class,objc_requires_property_definitions)) @interface MergePolicy @end","__attribute__((objc_root_class)) @interface MergePolicy @end"},
+     {"__attribute__((objc_protocol_requires_explicit_implementation)) @protocol MergePolicy @end","@protocol MergePolicy @end"},
+     {"__attribute__((objc_non_runtime_protocol)) @protocol MergePolicy @end","@protocol MergePolicy @end"},
+     {"__attribute__((objc_root_class)) @interface MergePolicy +(id)make __attribute__((objc_method_family(new)));@end","__attribute__((objc_root_class)) @interface MergePolicy +(id)make __attribute__((objc_method_family(none)));@end"},
+     {"struct __attribute__((objc_boxable)) MergePolicy{int value;};","struct MergePolicy{int value;};"}})for(bool Reverse:{false,true}){
+  std::vector<std::string> Args={"-x","objective-c++","-std=c++20","-fobjc-version=3","-fobjc-runtime=gnustep-2.2"};
+  auto From=tooling::buildASTFromCodeWithArgs(Reverse?Declarations.second:Declarations.first,Args,"policy-merge-source.mm");
+  auto To=tooling::buildASTFromCodeWithArgs(Reverse?Declarations.first:Declarations.second,Args,"policy-merge-target.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+  bool Rejected=false;for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){
+   auto Imported=Importer.Import(D);if(!Imported){llvm::consumeError(Imported.takeError());Rejected=true;}}
+  EXPECT_TRUE(Rejected)<<Declarations.first;
+ }
+}

diff --git a/clang/unittests/AST/ObjC3ExplicitSpecifierImportTest.cpp b/clang/unittests/AST/ObjC3ExplicitSpecifierImportTest.cpp
new file mode 100644
--- /dev/null
+++ b/clang/unittests/AST/ObjC3ExplicitSpecifierImportTest.cpp
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
