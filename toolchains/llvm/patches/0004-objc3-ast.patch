+  ASSERT_TRUE(Contract.Invalid->getInvalid()->EvaluateAsRValue(
+      Sentinel, To->getASTContext()));
+  ASSERT_TRUE(Sentinel.Val.isInt());
+  EXPECT_EQ(-1, Sentinel.Val.getInt().getSExtValue());
+}
