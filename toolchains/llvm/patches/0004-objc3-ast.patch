+TEST(ObjC3ConditionCFG, MatchAndCoalesceSelectArmsBeforeCleanup) {
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    typedef Optional(int) Maybe;
+    void first() noexcept;
+    void armCleanup() noexcept;
+    int one() noexcept;
+    int two() noexcept;
+    int none() noexcept;
+    bool predicate(int) noexcept;
+    Maybe *source() noexcept;
+    int fallback() noexcept;
+    Maybe fallbackCarrier() noexcept;
+    id fallbackReference() noexcept;
+    void work();
+    struct Local { Local() noexcept; ~Local() noexcept; };
+    struct Temporary { Temporary() noexcept; ~Temporary() noexcept; };
+    int number(const Temporary &);
+    bool predicateTemporary(const Temporary &);
+    void boolean_expression(bool value) {
+      defer { first(); }
+      (void)__objc3_match(value) {
+        case true => one();
+        case false => two();
+      };
+    }
+    void optional_expression() {
+      defer { first(); }
+      (void)__objc3_match(*source()) {
+        case .Some(let payload) => one();
+        case .None => none();
+      };
+    }
+    void guarded_optional() {
+      defer { first(); }
+      __objc3_match_stmt(*source()) {
+        case .Some(let payload) where predicate(payload): {
+          defer { armCleanup(); }
+          one();
+        }
+        case .Some(var payload): { two(); }
+        case .None: { none(); }
+      }
+    }
+    void selected_local_cleanup(bool value) {
+      defer { first(); }
+      __objc3_match_stmt(value) {
+        case true: {
+          defer { armCleanup(); }
+          Local local;
+          one();
+        }
+        case false: { two(); }
+      }
+    }
+    void throwing_selected_arm(bool value) {
+      try {
+        defer { first(); }
+        __objc3_match_stmt(value) {
+          case true: { Local local; work(); }
+          case false: { two(); }
+        }
+      } catch (...) { none(); }
+    }
+    void arm_temporary(bool value) {
+      try {
+        defer { first(); }
+        (void)__objc3_match(value) {
+          case true => number(Temporary());
+          case false => two();
+        };
+      } catch (...) { none(); }
+    }
+    void guard_temporary() {
+      try {
+        defer { first(); }
+        __objc3_match_stmt(*source()) {
+          case .Some(_) where predicateTemporary(Temporary()): { one(); }
+          case .Some(_): { two(); }
+          case .None: { none(); }
+        }
+      } catch (...) { armCleanup(); }
+    }
+    void scalar_coalesce() {
+      defer { first(); }
+      (void)(*source() ?? fallback());
+    }
+    void carrier_coalesce() {
+      defer { first(); }
+      Maybe value = *source() ?? fallbackCarrier();
+    }
+    void reference_coalesce(id value) {
+      defer { first(); }
+      (void)(value ?? fallbackReference());
+    }
+    template<class T> int template_coalesce(Optional(T) *value) {
+      defer { first(); }
+      return *value ?? fallback();
+    }
+    template int template_coalesce<int>(Optional(int) *);
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+         "-fobjc-runtime=gnustep-2.2", "-fexceptions", "-fcxx-exceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  const std::map<std::string, std::set<std::string>> Expected = {
+      {"boolean_expression", {"one,first,", "two,first,"}},
+      {"optional_expression", {"source,one,first,", "source,none,first,"}},
+      {"guarded_optional",
+       {"source,predicate,one,armCleanup,first,",
+        "source,predicate,two,first,", "source,none,first,"}},
+      {"selected_local_cleanup",
+       {"+Local,one,-Local,armCleanup,first,", "two,first,"}},
+      {"throwing_selected_arm",
+       {"+Local,work,-Local,first,", "+Local,work,-Local,first,none,",
+        "two,first,"}},
+      {"arm_temporary",
+       {"+Temporary,number,-Temporary,first,",
+        "+Temporary,number,-Temporary,first,none,", "two,first,"}},
+      {"guard_temporary",
+       {"source,+Temporary,predicateTemporary,-Temporary,one,first,",
+        "source,+Temporary,predicateTemporary,-Temporary,two,first,",
+        "source,+Temporary,predicateTemporary,-Temporary,first,armCleanup,",
+        "source,none,first,"}},
+      {"scalar_coalesce", {"source,first,", "source,fallback,first,"}},
+      {"carrier_coalesce", {"source,first,", "source,fallbackCarrier,first,"}},
+      {"reference_coalesce", {"first,", "fallbackReference,first,"}},
+      {"template_coalesce", {"first,", "fallback,first,"}}};
+  std::set<const FunctionDecl *> Functions;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    if (auto *Function = dyn_cast<FunctionDecl>(D)) {
+      if (Function->hasBody())
+        Functions.insert(Function);
+    } else if (auto *Template = dyn_cast<FunctionTemplateDecl>(D)) {
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      EXPECT_FALSE(CFG::buildCFG(Template->getTemplatedDecl(),
+                                Template->getTemplatedDecl()->getBody(),
+                                &AST->getASTContext(), Options));
+      for (FunctionDecl *Specialization : Template->specializations())
+        Functions.insert(Specialization);
+    }
+  }
+  for (const FunctionDecl *Function : Functions) {
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool Markers : {false, true}) {
+      SCOPED_TRACE(Markers);
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      Options.AddRichCXXConstructors = Options.AddLifetime = Options.AddScopes =
+          Markers;
+      Options.setAllAlwaysAdd();
+      auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                                 &AST->getASTContext(), Options);
+      ASSERT_TRUE(Graph);
+      std::set<std::string> Paths;
+      std::function<void(const CFGBlock *, std::string, unsigned)> Visit =
+          [&](const CFGBlock *Block, std::string Events, unsigned Depth) {
+            ASSERT_LT(Depth, 160u);
+            for (const auto &Element : *Block) {
+              if (auto Destructor = Element.getAs<CFGImplicitDtor>()) {
+                const auto *Function =
+                    Destructor->getDestructorDecl(AST->getASTContext());
+                ASSERT_TRUE(Function);
+                Events += "-" + Function->getParent()->getNameAsString() + ",";
+              } else if (auto Statement = Element.getAs<CFGStmt>()) {
+                if (const auto *Constructor =
+                        dyn_cast<CXXConstructExpr>(Statement->getStmt()))
+                  Events += "+" + Constructor->getConstructor()
+                                      ->getParent()->getNameAsString() + ",";
+                else if (const auto *Call =
+                             dyn_cast<CallExpr>(Statement->getStmt()))
+                  if (const auto *Callee = Call->getDirectCallee())
+                    Events += Callee->getNameAsString() + ",";
+              }
+            }
+            if (Block->isNativeExceptionExit())
+              Events += "unwind,";
+            if (Block->hasNoReturnElement())
+              Events += "terminate,";
+            if (Block == &Graph->getExit())
+              Paths.insert(Events);
+            else
+              for (const auto &Edge : Block->succs())
+                if (const auto *Next = Edge.getReachableBlock())
+                  Visit(Next, Events, Depth + 1);
+          };
+      Visit(&Graph->getEntry(), "", 0);
+      EXPECT_EQ(Expected.at(Function->getNameAsString()), Paths);
+    }
+  }
+  EXPECT_EQ(Expected.size(), Functions.size());
+}
+
+TEST(ObjC3ConditionCFG, MatchAndCoalesceParticipateInMandatoryExitProof) {
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    typedef Optional(int) Maybe;
+    void first() noexcept;
+    bool predicate(int) noexcept;
+    Maybe *source() noexcept;
+    int raising();
+    void work();
+    void pass_exhaustive_match(bool accept, bool value) {
+      if (accept) {} else {
+        defer { first(); }
+        __objc3_match_stmt(value) {
+          case true: { return; }
+          case false: { return; }
+        }
+      }
+    }
+    void fail_arm_falls_through(bool accept, bool value) {
+      if (accept) {} else {
+        defer { first(); }
+        __objc3_match_stmt(value) {
+          case true: { return; }
+          case false: { }
+        }
+      }
+    }
+    void pass_guarded_fallback(bool accept) {
+      if (accept) {} else {
+        defer { first(); }
+        __objc3_match_stmt(*source()) {
+          case .Some(let payload) where predicate(payload): { return; }
+          case .Some(_): { return; }
+          case .None: { return; }
+        }
+      }
+    }
+    void fail_caught_selected_arm(bool accept, bool value) {
+      if (accept) {} else {
+        try {
+          defer { first(); }
+          __objc3_match_stmt(value) {
+            case true: { work(); return; }
+            case false: { return; }
+          }
+        } catch (...) {}
+      }
+    }
+    void fail_caught_coalesce(bool accept) {
+      if (accept) {} else {
+        try { defer { first(); } (void)(*source() ?? raising()); return; }
+        catch (...) {}
+      }
+    }
+    void pass_coalesce_outward(bool accept) {
+      if (accept) {} else {
+        defer { first(); } (void)(*source() ?? raising()); return;
+      }
+    }
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+         "-fobjc-runtime=gnustep-2.2", "-fexceptions", "-fcxx-exceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto *Messages = new Diagnostics;
+  AST->getDiagnostics().setClient(Messages, true);
+  unsigned Cases = 0, Invalid = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    ASSERT_TRUE(replacePlaceholder(AST->getASTContext(), Function));
+    Sema::SynthesizedFunctionScope Scope(AST->getSema(), Function);
+    bool Bad = AST->getSema().CheckObjC3Guards(Function, Function->getBody());
+    EXPECT_EQ(Function->getName().starts_with("fail_"), Bad);
+    Invalid += Bad;
+    ++Cases;
+  }
+  EXPECT_EQ(6u, Cases);
+  EXPECT_EQ(3u, Invalid);
+  EXPECT_EQ(Invalid, Messages->Errors);
+}
+
+TEST(ObjC3ConditionCFG, MatchRefusesHiddenSnapshotAndResultDestruction) {
+  auto AST = tooling::buildASTFromCodeWithArgs(R"(
+    struct Value { Value(); ~Value() noexcept(false); };
+    typedef Optional(Value) Owned;
+    typedef Optional(int) Plain;
+    Plain fromTemporary(const Value &) noexcept;
+    void owned_snapshot(Owned *value) {
+      __objc3_match_stmt(*value) {
+        case .Some(_): {}
+        case .None: {}
+      }
+    }
+    void source_temporary() {
+      __objc3_match_stmt(fromTemporary(Value())) {
+        case .Some(_): {}
+        case .None: {}
+      }
+    }
+    void completed_result(bool condition) {
+      (void)__objc3_match(condition) {
+        case true => Value();
+        case false => Value();
+      };
+    }
+  )", {"-x", "objective-c++", "-std=c++20", "-fobjc-version=3",
+         "-fexceptions", "-fcxx-exceptions"});
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool EH : {false, true}) {
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = EH;
+      Options.AddImplicitDtors = Options.AddTemporaryDtors = true;
+      EXPECT_FALSE(CFG::buildCFG(Function, Function->getBody(),
+                                &AST->getASTContext(), Options));
+    }
+    ++Cases;
+  }
+  EXPECT_EQ(3u, Cases);
+}
+
+TEST(ObjC3LifetimeScopes,
+     ReleasesOwnersAfterSourceActionsWithoutOptionalFlags) {
+  for (bool ARC : {false, true}) {
+    std::vector<std::string> Args = {"-x", "objective-c++", "-std=c++20",
+                                     "-fobjc-version=3",
+                                     "-fobjc-runtime=gnustep-2.2"};
+    if (ARC)
+      Args.push_back("-fobjc-arc");
+    auto AST = tooling::buildASTFromCodeWithArgs(R"(
+      void action(void) __attribute__((nothrow));
+      void body(void) __attribute__((nothrow));
+      void after(void) __attribute__((nothrow));
+      void exercise(id source) {
+        defer { action(); }
+        keepAlive(source);
+        withLifetime(source) { body(); }
+        after();
+      }
+    )",
+                                                 Args, "lifetime-scopes.mm");
+    ASSERT_TRUE(AST);
+    ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    FunctionDecl *Function = nullptr;
+    for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls())
+      if (auto *F = dyn_cast<FunctionDecl>(D))
+        if (F->getName() == "exercise")
+          Function = F;
+    ASSERT_TRUE(Function);
+    CFG::BuildOptions Options;
+    Options.AddImplicitDtors = Options.AddLifetime = Options.AddScopes = false;
+    Options.setAllAlwaysAdd();
+    auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                               &AST->getASTContext(), Options);
+    ASSERT_TRUE(Graph);
+    std::string Events;
+    const CFGBlock *Block = &Graph->getEntry();
+    unsigned Steps = 0;
+    std::set<const VarDecl *> Owners;
+    while (Block) {
+      ASSERT_LT(++Steps, 40u);
+      for (auto Element : *Block) {
+        if (auto Release = Element.getAs<CFGObjC3LifetimeRelease>()) {
+          Events += "L";
+          Owners.insert(Release->getVarDecl());
+        } else if (auto Statement = Element.getAs<CFGStmt>()) {
+          if (auto *Call = dyn_cast<CallExpr>(Statement->getStmt()))
+            if (auto *F = Call->getDirectCallee()) {
+              if (F->getName() == "body")
+                Events += "B";
+              if (F->getName() == "after")
+                Events += "Z";
+              if (F->getName() == "action")
+                Events += "A";
+            }
+        }
+      }
+      const CFGBlock *Next = nullptr;
+      for (auto Successor : Block->succs())
+        if (const CFGBlock *Reachable = Successor.getReachableBlock()) {
+          ASSERT_FALSE(Next);
+          Next = Reachable;
+        }
+      Block = Next;
+    }
+    EXPECT_EQ("BLZAL", Events);
+    EXPECT_EQ(2u, Owners.size());
+  }
+}
diff --git a/clang/include/clang/AST/ObjC3SourceScopes.h b/clang/include/clang/AST/ObjC3SourceScopes.h
new file mode 100644
index 000000000..e71eca2f5
--- /dev/null
+++ b/clang/include/clang/AST/ObjC3SourceScopes.h
@@ -0,0 +1,181 @@
+//===--- ObjC3SourceScopes.h - Scope owners for source actions -----*- C++
+//-*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_OBJC3SOURCESCOPES_H
+#define LLVM_CLANG_AST_OBJC3SOURCESCOPES_H
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/ExprObjC.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/AST/StmtObjC.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+
+namespace clang {
+/// Source owners are independent of incidental CodeGen cleanup scopes. In
+/// particular, a guard prefix is not a new source region and its snapshot is
+/// not a committed user local. Nested callable bodies have their own owners.
+struct ObjC3SourceScopes {
+  llvm::DenseMap<const VarDecl *, const Stmt *> Variables;
+  /// Literal capture storage belongs to the creation site, independently of
+  /// the captured declaration's owner and the nested Block body's scopes.
+  llvm::DenseMap<const BlockExpr *, const Stmt *> Blocks;
+  llvm::DenseMap<const DeferStmt *, const Stmt *> Defers;
+  llvm::SmallPtrSet<const Stmt *, 8> DeferredScopes;
+  /// Cleanup attributes register source actions even without a lexical defer.
+  /// Keep their owners separate from DeferredScopes: consumers that reason
+  /// about deferred bodies still need the narrower set.
+  llvm::SmallPtrSet<const Stmt *, 8> CleanupScopes;
+
+  explicit ObjC3SourceScopes(const Stmt *Body) { collect(Body, Body); }
+
+private:
+  void collectCondition(const Stmt *Condition, const Stmt *Owner,
+                        const Stmt *BindingOwner) {
+    if (const auto *Binding = dyn_cast<ObjC3BindingCondition>(Condition)) {
+      Variables[Binding->getBindingDecl()] = BindingOwner;
+      collect(Binding->getSnapshotDecl()->getInit(), Owner);
+      collect(Binding->getBindingDecl()->getInit(), Owner);
+    } else {
+      collect(Condition, Owner);
+    }
+  }
+  void collect(const Stmt *S, const Stmt *Owner) {
+    if (!S)
+      return;
+    if (const auto *Argument = dyn_cast<CXXDefaultArgExpr>(S)) {
+      collect(Argument->getExpr(), Owner);
+      return;
+    }
+    if (const auto *Initializer = dyn_cast<CXXDefaultInitExpr>(S)) {
+      collect(Initializer->getExpr(), Owner);
+      return;
+    }
+    if (const auto *Lambda = dyn_cast<LambdaExpr>(S)) {
+      for (const Expr *Capture : Lambda->capture_inits())
+        collect(Capture, Owner);
+      return;
+    }
+    if (const auto *Block = dyn_cast<BlockExpr>(S)) {
+      Blocks[Block] = Owner;
+      for (const auto &Capture : Block->getBlockDecl()->captures()) {
+        // Only the creation recipe executes here. CopyExpr is the heap-copy
+        // recipe when a separate move initializer is present.
+        collect(Capture.getObjC3InitExpr() ? Capture.getObjC3InitExpr()
+                                         : Capture.getCopyExpr(), Owner);
+      }
+      return;
+    }
+    if (isa<CompoundStmt>(S))
+      Owner = S;
+    if (const auto *Defer = dyn_cast<DeferStmt>(S)) {
+      Defers[Defer] = Owner;
+      DeferredScopes.insert(Owner);
+      CleanupScopes.insert(Owner);
+      collect(Defer->getBody(), Defer->getBody());
+      return;
+    }
+    if (const auto *Lifetime = dyn_cast<ObjC3LifetimeStmt>(S)) {
+      if (!Lifetime->isKeepAlive()) {
+        collect(Lifetime->getStorage(), Lifetime->getStorage());
+      } else {
+        Variables[Lifetime->getBindingDecl()] = Owner;
+        CleanupScopes.insert(Owner);
+        collect(Lifetime->getOperand(), Owner);
+      }
+      return;
+    }
+    if (const auto *Declaration = dyn_cast<DeclStmt>(S))
+      for (const Decl *D : Declaration->decls())
+        if (const auto *Variable = dyn_cast<VarDecl>(D))
+          if (Variable->hasLocalStorage() &&
+              (!Variable->isImplicit() || Variable->hasAttr<ObjC3LifetimeBindingAttr>())) {
+            Variables[Variable] = Owner;
+            if (Variable->hasAttr<CleanupAttr>() ||
+                Variable->hasAttr<ObjCCleanupAttr>() ||
+                Variable->hasAttr<ObjCResourceAttr>() ||
+                Variable->hasAttr<ObjC3LifetimeBindingAttr>())
+              CleanupScopes.insert(Owner);
+          }
+    if (const auto *Catch = dyn_cast<ObjC3CatchStmt>(S)) {
+      collect(Catch->getBindingDeclStmt(), Catch->getHandlerBody());
+      collect(Catch->getHandlerBody(), Catch->getHandlerBody());
+      return;
+    }
+    if (const auto *Catch = dyn_cast<CXXCatchStmt>(S)) {
+      if (const auto *Variable = Catch->getExceptionDecl())
+        Variables[Variable] = Catch->getHandlerBlock();
+      collect(Catch->getHandlerBlock(), Catch->getHandlerBlock());
+      return;
+    }
+    if (const auto *Catch = dyn_cast<ObjCAtCatchStmt>(S)) {
+      if (const auto *Variable = Catch->getCatchParamDecl())
+        Variables[Variable] = Catch->getCatchBody();
+      collect(Catch->getCatchBody(), Catch->getCatchBody());
+      return;
+    }
+    if (const auto *Arm = dyn_cast<ObjC3MatchArm>(S)) {
+      collect(Arm->getPatternValue(), Owner);
+      collect(Arm->getBindingStatement(), Arm->getBody());
+      collect(Arm->getGuard(), Arm->getBody());
+      collect(Arm->getBody(), Arm->getBody());
+      return;
+    }
+    if (const auto *Guard = dyn_cast<ObjC3GuardStmt>(S)) {
+      for (const Stmt *Condition : Guard->getConditions())
+        collectCondition(Condition, Owner, Owner);
+      collect(Guard->getElse(), Guard->getElse());
+      return;
+    }
+    if (const auto *If = dyn_cast<ObjC3IfBindingStmt>(S)) {
+      for (const Stmt *Condition : If->getConditions())
+        collectCondition(Condition, Owner, If->getThen());
+      collect(If->getThen(), If->getThen());
+      collect(If->getElse(), If->getElse());
+      return;
+    }
+    if (const auto *If = dyn_cast<IfStmt>(S)) {
+      for (const Stmt *Child : If->children())
+        collect(Child,
+                Child == If->getThen() || Child == If->getElse() ? Child : If);
+      return;
+    }
+    if (const auto *Loop = dyn_cast<ForStmt>(S)) {
+      // The initializer survives every iteration. The condition declaration
+      // is destroyed on each backedge and must not share its release queue.
+      const Stmt *ConditionOwner = Loop->getConditionVariableDeclStmt();
+      collect(Loop->getInit(), Loop);
+      collect(ConditionOwner, ConditionOwner);
+      collect(Loop->getCond(), ConditionOwner ? ConditionOwner : Loop);
+      collect(Loop->getInc(), Loop);
+      collect(Loop->getBody(), Loop->getBody());
+      return;
+    }
+    if (const auto *Loop = dyn_cast<CXXForRangeStmt>(S)) {
+      for (const Stmt *Child : Loop->children())
+        collect(Child, Child == Loop->getBody() ||
+                               Child == Loop->getLoopVarStmt()
+                           ? Child
+                           : Loop);
+      return;
+    }
+    if (const auto *Loop = dyn_cast<ObjCForCollectionStmt>(S)) {
+      collect(Loop->getElement(), Loop->getElement());
+      collect(Loop->getCollection(), Loop);
+      collect(Loop->getBody(), Loop->getBody());
+      return;
+    }
+    const Stmt *Body = nullptr;
+    if (const auto *Loop = dyn_cast<WhileStmt>(S))
+      Body = Loop->getBody();
+    else if (const auto *Loop = dyn_cast<DoStmt>(S))
+      Body = Loop->getBody();
+    else if (const auto *Switch = dyn_cast<SwitchStmt>(S))
+      Body = Switch->getBody();
+    for (const Stmt *Child : S->children())
+      collect(Child, Body ? (Child == Body ? Body : S) : Owner);
+  }
+};
+} // namespace clang
+#endif
