+    typedef const volatile int AddressInt __attribute__((address_space(3)));
+    typedef AddressInt AddressAlias;
+    typedef AddressAlias AddressArray[4];
+  )");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  for (const char *Name : {"AddressInt", "AddressAlias", "AddressArray"}) {
+    const auto *Alias = selectFirst<TypedefDecl>(
+        "alias", match(typedefDecl(hasName(Name)).bind("alias"), Ctx));
+    ASSERT_TRUE(Alias);
+    QualType Original = Ctx.getTypedefType(ElaboratedTypeKeyword::None,
+                                            NestedNameSpecifier(std::nullopt), Alias);
+    ASSERT_TRUE(Original.hasAddressSpace());
+    QualType Stripped = Ctx.removeAddrSpaceQualType(Original);
+    EXPECT_FALSE(Stripped.hasAddressSpace());
+    EXPECT_TRUE(Ctx.getBaseElementType(Stripped).isConstQualified());
+    EXPECT_TRUE(Ctx.getBaseElementType(Stripped).isVolatileQualified());
+    EXPECT_TRUE(Ctx.hasSameType(Stripped, Ctx.removeAddrSpaceQualType(Stripped)));
+    EXPECT_TRUE(Original.hasAddressSpace());
+    if (StringRef(Name) == "AddressArray") {
+      const auto *Array = Ctx.getAsConstantArrayType(Stripped);
+      ASSERT_TRUE(Array);
+      EXPECT_EQ(4u, Array->getZExtSize());
+    }
+  }
+}
