+  auto *Binding = cast<ObjC3BindingCondition>(Guard->getCondition(0));
+  EXPECT_TRUE(Binding->getBindingDecl()->getType()->isIntegerType());
+  EXPECT_TRUE(Binding->getBindingDecl()->getType().isConstQualified());
+  auto *Return = cast<ReturnStmt>(Instantiated->body_back());
