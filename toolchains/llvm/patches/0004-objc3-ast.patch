+  if(const auto *Contract=dyn_cast<PtGuardedByAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
+  }
+  if(const auto *Contract=dyn_cast<AcquiredBeforeAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
+    for(const auto *Value:Contract->delayedArgs())Expression(Value);
+  }
+  if(const auto *Contract=dyn_cast<AcquiredAfterAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
+    for(const auto *Value:Contract->delayedArgs())Expression(Value);
+  }
+  if(const auto *Contract=dyn_cast<AssertCapabilityAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
+    for(const auto *Value:Contract->delayedArgs())Expression(Value);
+  }
+  if(const auto *Contract=dyn_cast<TryAcquireCapabilityAttr>(A)) {
+    if(Contract->getSuccessValue())Expression(Contract->getSuccessValue());
