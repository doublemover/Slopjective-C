+namespace {
+class PreloadedFieldsSource final : public ExternalASTSource {
+public:
+  SmallVector<Decl *, 4> Declarations;
+  unsigned Calls = 0;
+
+  void FindExternalLexicalDecls(const DeclContext *,
+                               llvm::function_ref<bool(Decl::Kind)> Include,
+                               SmallVectorImpl<Decl *> &Result) override {
+    ++Calls;
+    for (Decl *D : Declarations)
+      if (Include(D->getKind()))
+        Result.push_back(D);
+  }
+};
+} // namespace
