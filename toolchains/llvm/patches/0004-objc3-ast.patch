+TEST(ObjC3ASTInfrastructure, ScalarDeleteDeallocatesBeforeExceptionalCleanup) {
+  for (bool ARC : {false,true}) {
+    auto AST=tooling::buildASTFromCodeWithArgs(R"(
+      struct Disposal {~Disposal() noexcept(false);static void operator delete(void *) noexcept;};
+      void disposal_marker(int) noexcept;
+      void dispose_paths(Disposal *value) {
+        __objc3_defer {disposal_marker(3);}
+        try {delete value;}catch(...) {disposal_marker(4);}
+      }
+    )",{"-x","objective-c++","-std=c++23","-fobjc-version=3","-fobjc-runtime=gnustep-2.2",
+         "--target=x86_64-unknown-linux-gnu","-fexceptions","-fobjc-exceptions",
+         ARC?"-fobjc-arc":"-fno-objc-arc"},"delete-paths.mm");
+    ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+    FunctionDecl *Function=nullptr;
+    for(auto *D:AST->getASTContext().getTranslationUnitDecl()->decls())
+      if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getNameAsString()=="dispose_paths")Function=F;
+    ASSERT_NE(Function,nullptr);
+    CFG::BuildOptions Options;Options.setAllAlwaysAdd();Options.AddLifetime=true;
+    Options.AddEHEdges=true;Options.AddImplicitDtors=true;
+    auto Graph=CFG::buildCFG(Function,Function->getBody(),&AST->getASTContext(),Options);
+    ASSERT_TRUE(Graph);
+    unsigned Paths=0,NullPaths=0,CaughtPaths=0,Budget=4096;
+    auto Explore=[&](auto &&Self,const CFGBlock *Block,std::vector<int> Trace,unsigned Depth)->void {
+      ASSERT_GT(Budget--,0u);ASSERT_LT(Depth,64u);
+      for(const auto &Element:*Block) {
+        if(Element.getAs<CFGDeleteDtor>())Trace.push_back(1);
+        if(auto Statement=Element.getAs<CFGStmt>()) {
+          if(isa<CXXDeleteExpr>(Statement->getStmt()))Trace.push_back(2);
+          if(const auto *Call=dyn_cast<CallExpr>(Statement->getStmt());Call && Call->getDirectCallee() &&
+              Call->getDirectCallee()->getName()=="disposal_marker")
+            Trace.push_back(cast<IntegerLiteral>(Call->getArg(0)->IgnoreParenImpCasts())->getValue().getZExtValue());
+        }
+      }
+      if(Block->succ_empty()) {
+        ++Paths;
+        auto Destructor=std::find(Trace.begin(),Trace.end(),1);
+        if(Destructor==Trace.end()) {++NullPaths;EXPECT_EQ(Trace,std::vector<int>({3}));}
+        else {
+          ASSERT_NE(Destructor+1,Trace.end());EXPECT_EQ(*(Destructor+1),2);
+          EXPECT_EQ(std::count(Trace.begin(),Trace.end(),1),1);
+          EXPECT_EQ(std::count(Trace.begin(),Trace.end(),2),1);
+        }
+        if(std::find(Trace.begin(),Trace.end(),4)!=Trace.end())++CaughtPaths;
+        return;
+      }
+      for(auto Successor:Block->succs())if(const auto *Next=Successor.getReachableBlock())Self(Self,Next,Trace,Depth+1);
+    };
+    Explore(Explore,&Graph->getEntry(),{},0);
+    EXPECT_GE(Paths,3u);EXPECT_GT(NullPaths,0u);EXPECT_GT(CaughtPaths,0u);
+  }
+}
