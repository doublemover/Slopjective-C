+TEST(ObjC3ConditionTooling, JSONPreservesScopeMetadataAndSourceReferences) {
+  auto AST = tooling::buildASTFromCodeWithArgs(ConditionSource, conditionArgs(),
+                                               "condition-json.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto *FD = findExercise(*AST);
+  ASSERT_TRUE(FD);
+  for (TraversalKind Kind : {TK_AsIs, TK_IgnoreUnlessSpelledInSource}) {
+    SCOPED_TRACE(Kind);
+    auto JSON = llvm::json::parse(dumpJSON(FD, Kind));
+    ASSERT_TRUE(static_cast<bool>(JSON)) << llvm::toString(JSON.takeError());
+    const auto *Root = JSON->getAsObject();
+    ASSERT_TRUE(Root);
+    SmallVector<const llvm::json::Object *, 4> Guards, Ifs, Bindings, Variables,
+        References;
+    findJSONNodes(*Root, "ObjC3GuardStmt", Guards);
+    findJSONNodes(*Root, "ObjC3IfBindingStmt", Ifs);
+    findJSONNodes(*Root, "ObjC3BindingCondition", Bindings);
+    findJSONNodes(*Root, "VarDecl", Variables);
+    findJSONNodes(*Root, "DeclRefExpr", References);
+    ASSERT_EQ(1u, Guards.size());
+    EXPECT_EQ(2, Guards.front()->getInteger("numConditions"));
+    EXPECT_EQ("continuation", Guards.front()->getString("bindingScope"));
+    ASSERT_EQ(1u, Ifs.size());
+    EXPECT_EQ(2, Ifs.front()->getInteger("numConditions"));
+    EXPECT_EQ("then", Ifs.front()->getString("bindingScope"));
+    EXPECT_EQ(true, Ifs.front()->getBoolean("hasElse"));
+    ASSERT_EQ(2u, Bindings.size());
+    EXPECT_EQ("let", Bindings[0]->getString("bindingKind"));
+    EXPECT_EQ("var", Bindings[1]->getString("bindingKind"));
+    ASSERT_TRUE(Bindings[0]->getObject("bindingDecl"));
+    EXPECT_EQ("first",
+              Bindings[0]->getObject("bindingDecl")->getString("name"));
+    EXPECT_EQ(Kind == TK_AsIs ? 4u : 2u, Variables.size());
+    unsigned Sources = 0;
+    for (const auto *Reference : References)
+      if (const auto *Target = Reference->getObject("referencedDecl"))
+        Sources += Target->getString("name") == "source";
+    EXPECT_EQ(2u, Sources);
+  }
+}
