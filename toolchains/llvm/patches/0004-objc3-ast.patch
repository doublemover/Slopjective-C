+void printObjC3FunctionTypeAttributes(const FunctionDecl *D,
+    const PrintingPolicy &Policy,raw_ostream &Out) {
+  // Calling-convention attributes can live only in FunctionType::ExtInfo,
+  // with no declaration Attr node to print. Preserve the callable ABI just as
+  // the noreturn type bit below; type aliases already use the type printer.
+  if (Policy.PolishForDeclaration || Policy.PrintAsCanonical) {
+    StringRef Convention;
+    bool HasAttribute=false;
+    switch (D->getType()->castAs<FunctionType>()->getCallConv()) {
+    case CC_Swift:Convention="swiftcall";HasAttribute=D->hasAttr<SwiftCallAttr>();break;
+    case CC_SwiftAsync:Convention="swiftasynccall";HasAttribute=D->hasAttr<SwiftAsyncCallAttr>();break;
+    case CC_PreserveMost:Convention="preserve_most";HasAttribute=D->hasAttr<PreserveMostAttr>();break;
+    case CC_PreserveAll:Convention="preserve_all";HasAttribute=D->hasAttr<PreserveAllAttr>();break;
+    case CC_PreserveNone:Convention="preserve_none";HasAttribute=D->hasAttr<PreserveNoneAttr>();break;
+    case CC_X86RegCall:Convention="regcall";HasAttribute=D->hasAttr<RegCallAttr>();break;
+    case CC_X86VectorCall:Convention="vectorcall";HasAttribute=D->hasAttr<VectorCallAttr>();break;
+    case CC_X86_64SysV:Convention="sysv_abi";HasAttribute=D->hasAttr<SysVABIAttr>();break;
+    case CC_AArch64VectorCall:Convention="aarch64_vector_pcs";HasAttribute=D->hasAttr<AArch64VectorPcsAttr>();break;
