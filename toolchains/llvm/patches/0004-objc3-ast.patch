+  SmallVector<NamedDecl *, 4> Declarations(Lookup.begin(), Lookup.end());
+  ASSERT_EQ(4u, Declarations.size());
+  NamedDecl *First = Declarations[0], *Second = Declarations[1];
+  NamedDecl *Third = Declarations[2], *Fourth = Declarations[3];
+  StoredDeclsList List;
+  List.addOrReplaceDecl(First);
+  List.setHasExternalDecls();
+  List.replaceExternalDecls({Second});
+  EXPECT_FALSE(List.hasExternalDecls());
+  EXPECT_EQ((SmallVector<NamedDecl *, 4>{First, Second}),
+            (SmallVector<NamedDecl *, 4>(List.getLookupResult().begin(),
+                                        List.getLookupResult().end())));
+  List.addOrReplaceDecl(Third);
+  List.remove(Second);
+  List.replaceExternalDecls({Fourth});
+  EXPECT_EQ((SmallVector<NamedDecl *, 4>{First, Third, Fourth}),
+            (SmallVector<NamedDecl *, 4>(List.getLookupResult().begin(),
+                                        List.getLookupResult().end())));
+  List.remove(Fourth);
+  List.remove(First);
+  List.replaceExternalDecls({Second});
+  EXPECT_EQ((SmallVector<NamedDecl *, 4>{Third, Second}),
+            (SmallVector<NamedDecl *, 4>(List.getLookupResult().begin(),
+                                        List.getLookupResult().end())));
+  List.remove(Third);
+  List.remove(Second);
+  EXPECT_TRUE(List.isNull());
+  List.replaceExternalDecls({Fourth});
+  EXPECT_EQ(Fourth, List.getAsDecl());
