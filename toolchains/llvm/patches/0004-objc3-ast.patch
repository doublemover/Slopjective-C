+      namespace std {
+        template<class P=void>struct coroutine_handle {
+          static coroutine_handle from_address(void*)noexcept;
+          void *address()const noexcept;
+        };
+        template<class R,class...A>struct coroutine_traits{using promise_type=typename R::promise_type;};
+      }
+      struct Suspend {
+        bool await_ready()const noexcept;
+        template<class P>void await_suspend(std::coroutine_handle<P>)const noexcept;
+        void await_resume()const noexcept;
+      };
+      template<class T>struct Task {
+        struct promise_type {
+          Task get_return_object();Suspend initial_suspend();Suspend final_suspend()noexcept;
+          void return_value(T);void unhandled_exception();
+        };
+        bool await_ready()const noexcept;
+        template<class P>void await_suspend(std::coroutine_handle<P>)const noexcept;
