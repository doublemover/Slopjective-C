+      auto Found=C.getTranslationUnitDecl()->lookup(&C.Idents.get("choose"));
+      for (const auto *D:Found) {llvm::SmallString<128> USR;EXPECT_FALSE(index::generateUSRForDecl(D,USR));Set.insert(USR.str().str());}
+    };
+    Collect(FirstAST->getASTContext(),Overloads);Collect(MovedAST->getASTContext(),RelocatedOverloads);
+    EXPECT_EQ(Types.size(),2u);EXPECT_EQ(Overloads.size(),2u);EXPECT_EQ(Overloads,RelocatedOverloads);
+  }
