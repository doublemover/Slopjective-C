+TEST(ObjC3ASTInfrastructure, ConstantImportPreservesPendingAndImmediateEvaluation) {
+  auto From=tooling::buildASTFromCode("int value=42;");
+  auto To=tooling::buildASTFromCode("");
+  ASSERT_TRUE(From && To);
+  auto &FromContext=From->getASTContext();
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                       FromContext,From->getFileManager(),false);
+  auto *Literal=IntegerLiteral::Create(FromContext,llvm::APInt(32,42),
+                                      FromContext.IntTy,SourceLocation());
+  for (auto Storage : {ConstantResultStorageKind::None,
+                       ConstantResultStorageKind::Int64,
+                       ConstantResultStorageKind::APValue})
+    for (bool Immediate : {false,true}) {
+      auto *Source=ConstantExpr::Create(FromContext,Literal,Storage,Immediate);
+      ASSERT_FALSE(Source->hasAPValueResult());
+      auto Imported=Importer.Import(Source);
+      ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+      auto *Result=cast<ConstantExpr>(*Imported);
+      EXPECT_FALSE(Result->hasAPValueResult());
+      EXPECT_EQ(Result->getResultStorageKind(),Storage);
+      EXPECT_EQ(Result->isImmediateInvocation(),Immediate);
+      Expr::EvalResult Evaluated;
+      ASSERT_TRUE(Result->EvaluateAsInt(Evaluated,To->getASTContext()));
+      EXPECT_EQ(Evaluated.Val.getInt().getBitWidth(),32u);
+      EXPECT_EQ(Evaluated.Val.getInt().getSExtValue(),42);
+    }
+  for (unsigned Width : {32u,64u,128u})
+    for (bool Unsigned : {false,true}) {
+      QualType Type=Width==32?FromContext.IntTy:Width==64?FromContext.LongLongTy:FromContext.Int128Ty;
+      if (Unsigned) Type=FromContext.getCorrespondingUnsignedType(Type);
+      llvm::APSInt Integer(llvm::APInt(Width,42),Unsigned);
+      auto *Value=IntegerLiteral::Create(FromContext,Integer,Type,SourceLocation());
+      auto *Source=ConstantExpr::Create(FromContext,Value,
+          Width<=64?ConstantResultStorageKind::Int64:ConstantResultStorageKind::APValue,true);
+      Source->SetResult(APValue(Integer),FromContext);
+      auto Imported=Importer.Import(Source);
+      ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+      auto *Result=cast<ConstantExpr>(*Imported);
+      ASSERT_TRUE(Result->hasAPValueResult());
+      EXPECT_TRUE(Result->isImmediateInvocation());
+      EXPECT_EQ(Result->getResultAsAPSInt(),Integer);
+      EXPECT_EQ(Result->getResultAsAPSInt().getBitWidth(),Width);
+      EXPECT_EQ(Result->getResultAsAPSInt().isUnsigned(),Unsigned);
+    }
+}
