+}

diff --git a/clang/unittests/AST/ObjC3C23OpaqueImportTest.cpp b/clang/unittests/AST/ObjC3C23OpaqueImportTest.cpp
new file mode 100644
--- /dev/null
+++ b/clang/unittests/AST/ObjC3C23OpaqueImportTest.cpp
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/ASTImporter.h"
+#include "clang/AST/ASTStructuralEquivalence.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "llvm/Support/Error.h"
+#include "gtest/gtest.h"
+using namespace clang;
+namespace {
+std::unique_ptr<ASTUnit> opaqueAST(const std::string &Code,const char *Standard,const char *File="opaque-source.c") {
+ auto AST=tooling::buildASTFromCodeWithArgs(Code,{"-xc",std::string("-std=")+Standard},File);
+ if(AST)AST->getDiagnostics().setSuppressAllDiagnostics(true);
+ return AST;
+}
+FunctionDecl *opaqueFunction(ASTUnit &AST) {
+ for(auto *D:AST.getASTContext().getTranslationUnitDecl()->decls())
+  if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getName()=="consume")return F;
+ return nullptr;
+}
+}
+TEST(ObjC3ASTInfrastructure,C23CorrespondingOpaqueTagsImportThroughRecursiveCarriers) {
+ for(const char *Standard:{"c17","c23"}) {
+  const std::string Code="struct Shared;struct Holder {struct Shared *value;void(*resume)(struct Shared *);};void consume(struct Holder *);";
+  auto From=opaqueAST(Code,Standard),To=opaqueAST(Code,Standard,"opaque-target.c");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  auto *Expected=opaqueFunction(*To);ASSERT_TRUE(Expected);
+  {
+   ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   auto Imported=Importer.Import(opaqueFunction(*From));
+   if(!Imported){auto Message=llvm::toString(Imported.takeError());FAIL()<<Standard<<": "<<Message;}
+   EXPECT_EQ(cast<FunctionDecl>(*Imported)->getCanonicalDecl(),Expected->getCanonicalDecl());
+  }
+  From.reset();EXPECT_EQ(Expected->getNumParams(),1u);
+ }
+}
+TEST(ObjC3ASTInfrastructure,C23OpaqueTagsRetainKindAttributeAndDefinitionConflicts) {
+ for(const auto &Pair:{
+      std::pair{"union Shared;","struct Shared;"},
+      std::pair{"struct __attribute__((aligned(16))) Shared;","struct Shared;"},
+      std::pair{"struct Shared {int value;};","struct Shared {double value;};"}}) {
+  const char *Kind=std::string(Pair.first).find("union")==0?"union":"struct";
+  auto From=opaqueAST(std::string(Pair.first)+"void consume("+Kind+" Shared *);","c23");
+  auto To=opaqueAST(std::string(Pair.second)+"void consume(struct Shared *);","c23","opaque-target.c");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());ASSERT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+  auto Imported=Importer.Import(opaqueFunction(*From));EXPECT_FALSE(bool(Imported));
+  if(!Imported)llvm::consumeError(Imported.takeError());
+ }
+}
+TEST(ObjC3ASTInfrastructure,C23SameASTDistinctIncompleteScopesRemainUnproved) {
+ auto AST=opaqueAST("struct Shared;void scopes(void){struct Shared;}","c23");ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+ struct Records:RecursiveASTVisitor<Records> {
+  SmallVector<RecordDecl *,2> Values;
+  bool VisitRecordDecl(RecordDecl *D){if(D->getName()=="Shared")Values.push_back(D);return true;}
+ } Found;Found.TraverseDecl(AST->getASTContext().getTranslationUnitDecl());ASSERT_EQ(Found.Values.size(),2u);
+ ASTImporter::NonEquivalentDeclSet NonEquivalent;
+ StructuralEquivalenceContext Context(AST->getLangOpts(),AST->getASTContext(),AST->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+ EXPECT_FALSE(Context.IsEquivalent(Found.Values[0],Found.Values[1]));
+}

diff --git a/clang/unittests/AST/ObjC3PublicAsyncSyntaxTest.cpp b/clang/unittests/AST/ObjC3PublicAsyncSyntaxTest.cpp
new file mode 100644
--- /dev/null
+++ b/clang/unittests/AST/ObjC3PublicAsyncSyntaxTest.cpp
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/AST/ASTContext.h"
+#include "clang/Frontend/ASTUnit.h"
+#include "clang/Tooling/Tooling.h"
+#include "gtest/gtest.h"
+using namespace clang;
+TEST(ObjC3ASTInfrastructure,PublicAsyncPrintedTypesKeepPhysicalEntries) {
+ const std::string Prelude=R"(
+ struct objc3_task;struct objc3_async_result_type;
+ typedef struct objc3_async_frame {
+  unsigned struct_size,version;void *context;
+  void(*resume)(struct objc3_task *,void *);void(*destroy)(void *);
+  const struct objc3_async_result_type *result_type;
+ }objc3_async_frame;
+ namespace objc3 {template<class Value>struct task {};}
+ template<class Value>using __objc3_async_task=objc3::task<Value>;
+ )";
+ for(const char *Standard:{"c++20","c++23"}) {
+  const std::vector<std::string> Args={"-xobjective-c++",std::string("-std=")+Standard,"-fobjc-version=3","-fobjc-runtime=gnustep-2.2"};
+  auto AST=tooling::buildASTFromCodeWithArgs(Prelude+"using PublicFrame=int(*)(int) async;using PrivateTask=int(*)(int)__objc3_async;",Args,"public-types.mm");
+  ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto Type=[&](ASTUnit &Unit,const char *Name) {
+   auto &Context=Unit.getASTContext();
+   auto Found=Context.getTranslationUnitDecl()->lookup(&Context.Idents.get(Name));
+   return Found.empty()?QualType():cast<TypedefNameDecl>(*Found.begin())->getUnderlyingType();
+  };
+  auto Frame=Type(*AST,"PublicFrame"),Task=Type(*AST,"PrivateTask");
+  ASSERT_FALSE(Frame.isNull());ASSERT_FALSE(Task.isNull());EXPECT_FALSE(AST->getASTContext().hasSameType(Frame,Task));
+  const auto FrameText=Frame.getAsString(),TaskText=Task.getAsString();
+  EXPECT_NE(FrameText.find("__objc3_async_frame"),std::string::npos);
+  EXPECT_NE(TaskText.find("__objc3_async"),std::string::npos);
+  EXPECT_EQ(TaskText.find("__objc3_async_frame"),std::string::npos);
+  auto Replay=tooling::buildASTFromCodeWithArgs(Prelude+"using ReplayedFrame="+FrameText+";using ReplayedTask="+TaskText+";",Args,"replayed-types.mm");
+  ASSERT_TRUE(Replay);ASSERT_FALSE(Replay->getDiagnostics().hasErrorOccurred());
+  auto ReplayedFrame=Type(*Replay,"ReplayedFrame"),ReplayedTask=Type(*Replay,"ReplayedTask");
+  ASSERT_FALSE(ReplayedFrame.isNull());ASSERT_FALSE(ReplayedTask.isNull());
+  EXPECT_TRUE(ReplayedFrame->getPointeeType()->castAs<FunctionProtoType>()->getObjC3FunctionEffects().AsyncFrame);
+  EXPECT_FALSE(ReplayedTask->getPointeeType()->castAs<FunctionProtoType>()->getObjC3FunctionEffects().AsyncFrame);
+ }
+}

