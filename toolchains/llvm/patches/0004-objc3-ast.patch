+TEST(ObjC3ASTInfrastructure, NativeStatementContractsAndAssemblyKeepShapeAfterImport) {
+ const char *Source=R"cpp(
+namespace NativeStatementPrinter {
+int leaf(int n){return n+1;}
+inline int tail(int n){[[clang::musttail]]return leaf(n);}
+template<int N> int repeat(int n){int value=0;
+#pragma clang loop unroll_count(N)
+ for(int i=0;i<n;++i)value+=i;return value;}
+inline int run(int n){
+ [[clang::assume(n>0)]];
+ [[clang::suppress("imported-policy")]] {n+=0;}
+ int sum=0;
+#pragma clang loop unroll_count(4) vectorize(disable)
+ for(int i=0;i<n;++i)sum+=i;
+ if(sum>0)[[likely]]sum+=1;else [[unlikely]]sum-=1;
+ [[clang::code_align(32)]]for(int j=0;j<1;++j)sum+=j;
+ asm volatile("" :);
+ asm volatile("" : [value] "+r"(sum) : : "memory");
+ if(n>1)goto positive;else goto negative;
+positive:return tail(sum)+repeat<4>(n);
+negative:return 0;
+}
+}
