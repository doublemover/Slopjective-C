+TEST(ObjC3FunctionEffectImport, ConceptOwnerSeparatesAtomicIdentity) {
+  for (const char *Standard : {"-std=c++20", "-std=c++23"}) {
+    auto Build = [&](const char *Owner) {
+      std::string Code = "template<class T> concept Number [[clang::annotate(\"objc3.concept-owner:";
+      Code += Owner;
+      Code += "\")]]=sizeof(T)>0;";
+      return tooling::buildASTFromCodeWithArgs(Code, {"-xc++", Standard});
+    };
+    auto From = Build("first");auto Different = Build("second");auto Same = Build("first");
+    ASSERT_TRUE(From && Different && Same);
+    auto Find = [](ASTUnit &AST) {
+      auto &Context = AST.getASTContext();
+      return cast<ConceptDecl>(*Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("Number")).begin());
+    };
+    auto Equivalent = [&](ASTUnit &To) {
+      StructuralEquivalenceContext::NonEquivalentDeclSet NonEquivalent;
+      StructuralEquivalenceContext Context(
+          From->getLangOpts(), From->getASTContext(), To.getASTContext(),
+          NonEquivalent, StructuralEquivalenceKind::Default,
+          /*StrictTypeSpelling=*/false, /*Complain=*/false);
+      return Context.IsEquivalent(Find(*From), Find(To));
+    };
+    EXPECT_FALSE(Equivalent(*Different));
+    EXPECT_TRUE(Equivalent(*Same));
+  }
