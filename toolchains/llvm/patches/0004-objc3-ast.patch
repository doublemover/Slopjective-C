+  if(const auto *Contract=dyn_cast<RequiresCapabilityAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
+    for(const auto *Value:Contract->delayedArgs())Expression(Value);
+  }
+  if(const auto *Contract=dyn_cast<LocksExcludedAttr>(A)) {
+    for(const auto *Value:Contract->args())Expression(Value);
