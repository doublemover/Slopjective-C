+TEST(ObjC3ASTInfrastructure, ConstructorUnwindDestroysOnlyCompletedSubobjects) {
+  auto AST=tooling::buildASTFromCodeWithArgs(R"(
+    struct Base {Base(int);~Base() noexcept(false);};
+    struct Member {Member(int);~Member() noexcept(false);};
+    void subobject_marker(int) noexcept;
+    void subobject_raise(void);
+    struct Derived:Base {
+      Member first,second;
+      Derived():Base(0),first(1),second(2) {
