diff --git a/clang/include/clang/AST/IgnoreExpr.h b/clang/include/clang/AST/IgnoreExpr.h
index 3b50b8115..6bf8ee9c4 100644
--- a/clang/include/clang/AST/IgnoreExpr.h
+++ b/clang/include/clang/AST/IgnoreExpr.h
@@ -22,10 +22,17 @@ namespace clang {
 /// Recursively apply each of the functions to E until reaching a fixed point.
 /// Note that a null E is valid; in this case nothing is done.
 template <typename... FnTys> Expr *IgnoreExprNodes(Expr *E, FnTys &&... Fns) {
+  // A round invokes the same callback objects without moving them. Preserve
+  // ref-qualified call operators, including rvalue-only callbacks, on every
+  // round of the fixed-point iteration.
+  auto ApplyRound = [&](Expr *Current) {
+    ((Current = std::forward<FnTys>(Fns)(Current)), ...);
+    return Current;
+  };
   Expr *LastE = nullptr;
   while (E != LastE) {
     LastE = E;
-    ((E = std::forward<FnTys>(Fns)(E)), ...);
+    E = ApplyRound(E);
   }
   return E;
 }
