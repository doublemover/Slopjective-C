+const char ManagedPrefixDefer[] = R"(
+#ifndef __cplusplus
+#define bool _Bool
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+id class_createInstance(Class, __SIZE_TYPE__) __attribute__((ns_returns_retained));
+id object_dispose(__unsafe_unretained id);
+#ifdef __cplusplus
+}
+#endif
+static int events;
+static void record(int digit) __attribute__((nothrow));
+static void record(int digit) { events = events * 10 + digit; }
+__attribute__((objc_root_class))
+@interface PrefixProbe { Class isa; int key; }
++ (id)newWithKey:(int)value;
+@end
+@implementation PrefixProbe
++ (id)newWithKey:(int)value {
+  PrefixProbe *object = class_createInstance(self, 0);
+  object->key = value;
+  return object;
+}
+- (void)dealloc { if(key == 42)record(3); object_dispose(self); }
+@end
+static PrefixProbe *prepare_second(PrefixProbe *value, int mode, id token)
+    __attribute__((ns_returns_retained));
+static PrefixProbe *prepare_second(PrefixProbe *value, int mode, id token) {
+  if(mode == 3)@throw token;
+  return value;
+}
+#ifdef ORDERED_IF_BINDING
+#define FAILED_PREFIX_TRACE 34
+#define THROWING_PREFIX_TRACE 32
+#else
+#define FAILED_PREFIX_TRACE 341
+#define THROWING_PREFIX_TRACE 132
+#endif
+typedef __objc3_optional(PrefixProbe *) Source;
+int exercise(int mode, id token) {
+  Source source = __objc3_some(PrefixProbe *, [PrefixProbe newWithKey:42]);
+  if(1) {} else { record(4); return -1; }
+  PrefixProbe *value = (id)0;
+  Source second_source = mode == 1 ? __objc3_none(PrefixProbe *)
+                                  : __objc3_some(PrefixProbe *, prepare_second(value, mode, token));
+  PrefixProbe *second_value = (id)0;
+  (void)(bool)1;
+  defer { record(1); }
+  if(mode == 2)@throw token;
+  if(!value || second_value != value)return 9;
+  return 0;
+}
+int main(void) {
+  @autoreleasepool {
+    if(exercise(0, (id)0) || events != 13)return 1;
+    events = 0;
+    if(exercise(1, (id)0) != -1 || events != FAILED_PREFIX_TRACE)return 2;
+    events = 0;
+    id token = [PrefixProbe newWithKey:7];
+    @try { exercise(2, token); return 3; }
+    @catch(id error) { if(error != token)return 4; record(2); }
+    if(events != 132)return 5;
+    events = 0;
+    @try { exercise(3, token); return 6; }
+    @catch(id error) { if(error != token)return 7; record(2); }
+    if(events != THROWING_PREFIX_TRACE)return 8;
+  }
+  return 0;
+}
+)";
+}
