+using namespace clang;
+using namespace clang::tooling;
+
+TEST(ObjC3DiagnosticStorage, CleansUpDependentDiagnosticStorage) {
+  // Run under LSan as well as ordinary ASTTests. Both diagnostic strings and
+  // fix-it strings/vectors exceed inline capacity and outlive the source PDiag.
+  auto AST = buildASTFromCode("template<class T> struct Holder {};", "input.cc");
+  ASSERT_TRUE(AST);
+  ASTContext &Context = AST->getASTContext();
+  auto Found = Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("Holder"));
+  ASSERT_TRUE(Found.isSingleResult());
+  auto *Record = cast<ClassTemplateDecl>(Found.front())->getTemplatedDecl();
+  unsigned ID = Context.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error, "%0");
+  std::string Message(512, 'm');
+  for (int Index = 0; Index != 16; ++Index) {
+    PartialDiagnostic Original(ID, Context.getDiagAllocator());
+    Original << Message;
+    for (int Hint = 0; Hint != 16; ++Hint)
+      Original << FixItHint::CreateInsertion(Record->getLocation(), std::string(512, 'x'));
+    auto *Stored = DependentDiagnostic::Create(Context, Record,
+        DependentDiagnostic::Access, Record->getLocation(), true, AS_private,
+        Record, Record, Context.getCanonicalTagType(Record), Original);
+    EXPECT_EQ(Stored->getDiagnostic().getDiagID(), ID);
+    llvm::SmallString<1024> Text;
+    Stored->getDiagnostic().EmitToString(Context.getDiagnostics(), Text);
+    EXPECT_EQ(Text, Message);
+  }
+  // Explicit destruction makes the test exercise storage cleanup in embedded
+  // compiler users such as clang-tidy, rather than relying on driver exit.
+  AST.reset();
+}
