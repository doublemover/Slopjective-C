+      ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+      FunctionDecl *Function=nullptr;const VarDecl *Owner=nullptr;
+      for(auto *D:AST->getASTContext().getTranslationUnitDecl()->decls())
+        if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getName()=="ordinary_path")Function=F;
+      ASSERT_NE(Function,nullptr);
+      CFG::BuildOptions Options;Options.setAllAlwaysAdd();Options.AddLifetime=true;
+      Options.AddEHEdges=true;Options.AddImplicitDtors=true;
+      auto Graph=CFG::buildCFG(Function,Function->getBody(),&AST->getASTContext(),Options);
+      ASSERT_TRUE(Graph);
+      for(const auto *Block:*Graph)
+        for(const auto &Element:*Block)
+          if(auto Statement=Element.getAs<CFGStmt>())
+            if(const auto *Declarations=dyn_cast<DeclStmt>(Statement->getStmt()))
+              for(const auto *D:Declarations->decls())
+                if(const auto *V=dyn_cast<VarDecl>(D);V && V->getName()=="local")Owner=V;
+      ASSERT_NE(Owner,nullptr);
+      unsigned Caught=0,Normal=0,Budget=4096;
+      auto Explore=[&](auto &&Self,const CFGBlock *Block,std::vector<int> Trace,unsigned Depth)->void {
+        ASSERT_GT(Budget--,0u);ASSERT_LT(Depth,64u);
+        for(const auto &Element:*Block) {
+          if(auto End=Element.getAs<CFGLifetimeEnds>();End && End->getVarDecl()==Owner)Trace.push_back(20);
+          if(auto Statement=Element.getAs<CFGStmt>())
+            if(const auto *Call=dyn_cast<CallExpr>(Statement->getStmt());Call && Call->getDirectCallee()) {
+              if(Call->getDirectCallee()->getName()=="ordinary_marker")
+                Trace.push_back(cast<IntegerLiteral>(Call->getArg(0)->IgnoreParenImpCasts())->getValue().getZExtValue());
+            }
+        }
+        if(Block->succ_empty()) {
+          auto Handler=std::find(Trace.begin(),Trace.end(),12);
+          auto End=std::find(Trace.begin(),Trace.end(),20);
+          EXPECT_NE(End,Trace.end());EXPECT_EQ(std::count(Trace.begin(),Trace.end(),20),1);
+          EXPECT_EQ(Trace.front(),11);EXPECT_EQ(Trace.back(),13);
+          if(Handler!=Trace.end()){++Caught;EXPECT_LT(End,Handler);}else ++Normal;
