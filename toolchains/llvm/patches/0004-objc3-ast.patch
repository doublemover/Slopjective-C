+    ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+    unsigned Checked=0;
+    for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls()) {
+      auto *Alias=dyn_cast<TypedefNameDecl>(D);
+      auto *Function=dyn_cast<FunctionDecl>(D);
+      if((!Alias || (Alias->getName()!="Callback" && Alias->getName()!="Pointer")) && !Function)continue;
+      auto Imported=Importer.Import(D);
+      if(!Imported){llvm::consumeError(Imported.takeError());FAIL()<<"failed to import Swift callable";}
+      TypeSourceInfo *Info=Alias?cast<TypedefNameDecl>(*Imported)->getTypeSourceInfo():cast<FunctionDecl>(*Imported)->getTypeSourceInfo();
+      ASSERT_TRUE(Info);
+      bool Found=false;
+      for(auto Loc=Info->getTypeLoc();!Loc.isNull();Loc=Loc.getNextTypeLoc())
+        if(auto Prototype=Loc.getAs<FunctionProtoTypeLoc>()) {
+          ASSERT_GE(Prototype.getNumParams(),2U);
+          auto *Context=Prototype.getParam(1);ASSERT_TRUE(Context);
+          EXPECT_TRUE(Context->hasAttr<SwiftContextAttr>());
+          EXPECT_EQ(Prototype.getTypePtr()->getCallConv(),CC_Swift);
+          EXPECT_EQ(Prototype.getTypePtr()->getExtParameterInfo(1).getABI(),ParameterABI::SwiftContext);
+          if(Function) {
+            auto *Error=Prototype.getParam(2);ASSERT_TRUE(Error);
+            EXPECT_TRUE(Error->hasAttr<SwiftErrorResultAttr>());
+          }
+          Found=true;
+        }
+      EXPECT_TRUE(Found);++Checked;
+      PrintingPolicy Policy(To->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+      std::string Printed;llvm::raw_string_ostream Out(Printed);(*Imported)->print(Out,Policy);
+      EXPECT_NE(Printed.find("swift_context"),std::string::npos);
+      EXPECT_NE(Printed.find("swiftcall"),std::string::npos);
+    }
+    EXPECT_EQ(Checked,3U);EXPECT_FALSE(To->getDiagnostics().hasErrorOccurred());
+  }
+}
