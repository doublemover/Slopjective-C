+  Out.flush();auto Replay=tooling::buildASTFromCodeWithArgs(Printed,Args,"object-expressions-replay.mm");
+  ASSERT_TRUE(Replay);EXPECT_FALSE(Replay->getDiagnostics().hasErrorOccurred())<<Printed;
+  From.reset();Expressions Retained(To->getASTContext());Retained.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  for(auto *Expression:ImportedExpressions)Retained.TraverseStmt(Expression);
+  EXPECT_EQ(Retained.Counts,Original.Counts);
