+  PrintingPolicy Policy(AST->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+  std::string Printed;llvm::raw_string_ostream Stream(Printed);AST->getASTContext().getTranslationUnitDecl()->print(Stream,Policy);
+  for(const char *Spelling:{"pass_object_size","pass_dynamic_object_size","lifetimebound","noescape","diagnose_if","callback","sentinel","returns_twice","leaf","disable_tail_calls","not_tail_called","nomerge","noduplicate","optnone"})
+    EXPECT_NE(Printed.find(Spelling),std::string::npos)<<Spelling;
+  EXPECT_TRUE(Printed.find("nothrow")!=std::string::npos || Printed.find("noexcept")!=std::string::npos);
+  auto Replayed=tooling::buildASTFromCodeWithArgs(Printed,{"-x","objective-c++","-std=c++23","-fobjc-version=3"},"moved-contracts.mm");
+  ASSERT_TRUE(Replayed);ASSERT_FALSE(Replayed->getDiagnostics().hasErrorOccurred());
+  EXPECT_EQ(Expected,Identities(Replayed->getASTContext()));
+  PrintingPolicy AgainPolicy(Replayed->getASTContext().getLangOpts());AgainPolicy.PolishForDeclaration=true;
+  std::string Again;llvm::raw_string_ostream AgainStream(Again);
+  Replayed->getASTContext().getTranslationUnitDecl()->print(AgainStream,AgainPolicy);
+  EXPECT_EQ(Printed,Again);
+  auto Consumer=tooling::buildASTFromCodeWithArgs("",{"-x","objective-c++","-std=c++23","-fobjc-version=3"},"consumer.mm");
+  ASSERT_TRUE(Consumer);
+  ASTImporter Importer(Consumer->getASTContext(),Consumer->getFileManager(),
+      AST->getASTContext(),AST->getFileManager(),/*MinimalImport=*/false);
+  auto Checked=AST->getASTContext().getTranslationUnitDecl()->lookup(&AST->getASTContext().Idents.get("checked"));
+  ASSERT_FALSE(Checked.empty());
+  auto Imported=Importer.Import(Checked.front());
+  ASSERT_TRUE(bool(Imported));
+  const auto *Function=dyn_cast<FunctionDecl>(*Imported);ASSERT_TRUE(Function);
+  const auto *Diagnostic=Function->getAttr<DiagnoseIfAttr>();ASSERT_TRUE(Diagnostic);
+  EXPECT_EQ(&Diagnostic->getParent()->getASTContext(),&Consumer->getASTContext());
+  struct References:RecursiveASTVisitor<References> {
+    ASTContext &Target;unsigned Count=0;
+    explicit References(ASTContext &Target):Target(Target) {}
+    bool VisitDeclRefExpr(DeclRefExpr *Expression) {
+      EXPECT_EQ(&Expression->getDecl()->getASTContext(),&Target);++Count;return true;
+    }
+  } References(Consumer->getASTContext());
+  References.TraverseStmt(Diagnostic->getCond());EXPECT_GT(References.Count,0u);
+}
