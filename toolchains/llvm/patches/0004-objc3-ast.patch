+                         From->getASTContext(),From->getFileManager(),false);
+    auto Imported=Importer.Import(Find(From->getASTContext()));
+    ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+    auto *Record=cast<ClassTemplateDecl>(*Imported)->getTemplatedDecl();
+    auto Attributes=Record->specific_attrs<AbiTagAttr>();
+    EXPECT_EQ(std::distance(Attributes.begin(),Attributes.end()),1);
+    EXPECT_TRUE(Record->isCompleteDefinition());
+    unsigned Bodies=0;
+    for(auto *Method:Record->methods()) {
+      if(Method->doesThisDeclarationHaveABody())++Bodies;
+      if(auto *Constructor=dyn_cast<CXXConstructorDecl>(Method);Constructor && Constructor->doesThisDeclarationHaveABody()) {
+        EXPECT_TRUE(Constructor->getParamDecl(0)->hasDefaultArg());
+        EXPECT_EQ(Constructor->getNumCtorInitializers(),1u);
+      }
+    }
+    EXPECT_EQ(Bodies,3u);
