+        auto To = tooling::buildASTFromCodeWithArgs(Existing ? Code : "", {Standard}, "to.cpp");
+        ASSERT_TRUE(From && To);
+        ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+        ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                             From->getASTContext(), From->getFileManager(), Minimal);
+        unsigned Specializations = 0;
+        for (Decl *D : From->getASTContext().getTranslationUnitDecl()->decls()) {
+          auto *Pattern = dyn_cast<ClassTemplateDecl>(D);
+          if (!Pattern || Pattern->getName() != "Storage") continue;
+          for (auto *Specialization : Pattern->specializations()) {
+            ++Specializations;
