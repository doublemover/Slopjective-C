+ @end
+ inline NSString *string_expression(){return @"native\n\u03bc";}
+ inline NSNumber *boxed_expression(int value){return @(value+1);}
+ inline NSNumber *number_expression(){return @42;}
+ inline NSArray *array_expression(id first,id second){return @[first,second];}
+ inline NSDictionary *dictionary_expression(id first,id second){return @{first:second};}
+ template<class...Values>NSArray *array_pack_expression(Values...values){return @[values...];}
+ template<class...Values>NSDictionary *dictionary_pack_expression(Values...values){return @{values:values...};}
+ )objects";
+ for(const char *Standard:{"c++20","c++23"})for(bool Arc:{false,true}) {
+  std::vector<std::string> Args={"-x","objective-c++",std::string("-std=")+Standard,"-fobjc-version=3","-fobjc-runtime=gnustep-2.2","-fblocks","-Wno-objc-missing-super-calls","-Wno-deprecated-objc-isa-usage"};
+  if(Arc)Args.push_back("-fobjc-arc");
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"object-expressions-source.mm");
+  auto To=tooling::buildASTFromCodeWithArgs("",Args,"object-expressions-target.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  struct Expressions:RecursiveASTVisitor<Expressions> {
+   ASTContext &Context;llvm::SmallPtrSet<Expr *,32> Seen;std::vector<Expr *> Nodes;
+   std::map<std::string,unsigned> Counts;
+   explicit Expressions(ASTContext &C):Context(C){}
+   void Reference(const Decl *D){if(D)EXPECT_EQ(&D->getASTContext(),&Context);}
+   bool VisitExpr(Expr *E) {
+    const bool Interesting=isa<ObjCPropertyRefExpr,ObjCSubscriptRefExpr,ObjCSelectorExpr,ObjCProtocolExpr,ObjCEncodeExpr,ObjCBoolLiteralExpr,ObjCStringLiteral,ObjCBoxedExpr,ObjCArrayLiteral,ObjCDictionaryLiteral,ObjCIsaExpr,ObjCIndirectCopyRestoreExpr,ObjCBridgedCastExpr,OpaqueValueExpr>(E);
+    if(!Interesting || !Seen.insert(E).second)return true;
+    Nodes.push_back(E);++Counts[E->getStmtClassName()];
+    if(const auto *Property=dyn_cast<ObjCPropertyRefExpr>(E)) {
+     ++Counts[Property->isExplicitProperty()?"explicit-property":"implicit-property"];
