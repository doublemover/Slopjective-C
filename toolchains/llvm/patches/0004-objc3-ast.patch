+      auto Attribute = Type.getAsAdjusted<AttributedTypeLoc>();
+      if (!Attribute)break;
+      if (auto *Capture = Attribute.getAttrAs<LifetimeCaptureByAttr>())Attributes.push_back(Capture);
+      Type = Attribute.getModifiedLoc();
+    }
+  return Attributes;
+}
+SmallVector<const ParmVarDecl *, 8> nativeLifetimeParameters(const ParmVarDecl *Parameter,
+                                                          bool &ImplicitThis) {
+  SmallVector<const ParmVarDecl *, 8> Parameters;
+  ImplicitThis = false;
+  const auto *Context = Parameter->getDeclContext();
+  if (const auto *Function = dyn_cast<FunctionDecl>(Context)) {
+    Parameters.append(Function->param_begin(), Function->param_end());
+    if (const auto *Method = dyn_cast<CXXMethodDecl>(Function))
+      ImplicitThis = !Method->isStatic() && !Method->isExplicitObjectMemberFunction();
+  } else if (const auto *Method = dyn_cast<ObjCMethodDecl>(Context))
+    Parameters.append(Method->param_begin(), Method->param_end());
+  else if (const auto *Block = dyn_cast<BlockDecl>(Context))
+    Parameters.append(Block->param_begin(), Block->param_end());
+  return Parameters;
+}
+std::string nativeLifetimeParameterName(const ParmVarDecl *Parameter,
+                                       const PrintingPolicy &Policy) {
+  if (const auto *Name = Parameter->getIdentifier())
+    return Policy.CleanUglifiedParameters ? Name->deuglifiedName().str() : Name->getName().str();
+  bool ImplicitThis;
+  const auto Parameters = nativeLifetimeParameters(Parameter, ImplicitThis);
+  const auto Position = llvm::find(Parameters, Parameter);
+  if (Position == Parameters.end()) return {};
+  const unsigned Index = Position - Parameters.begin();
+  bool Referenced = false;
+  for (const auto *P : Parameters)
+    for (const auto *Capture : P->specific_attrs<LifetimeCaptureByAttr>())
+      for (int Target : Capture->params())
+        Referenced |= Target == static_cast<int>(Index + ImplicitThis);
+  if (const auto *Function = dyn_cast<FunctionDecl>(Parameter->getDeclContext()))
+    for (const auto *Capture : nativeReceiverLifetimeCaptures(Function))
+      for (int Target : Capture->params())Referenced |= Target == static_cast<int>(Index + ImplicitThis);
