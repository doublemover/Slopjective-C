+TEST(ObjC3ASTInfrastructure, ExplicitInstantiationImportPreservesWrittenStructure) {
+  const char *Code = R"cpp(
+namespace ExplicitSource {
+template<class T> struct Item {
+  T value;
+  constexpr T read() const { return value; }
+  struct Inner { T value; };
+};
+template<class T> constexpr T echo(T value) { return value; }
+template<class T> T variable = T(17);
+extern template struct Item<int>;
+template struct Item<long>;
+extern template int echo<int>(int);
+template long echo<long>(long);
+extern template int variable<int>;
+template long variable<long>;
+extern template short Item<short>::read() const;
+template unsigned long Item<unsigned long>::read() const;
+extern template struct Item<unsigned>::Inner;
+template struct Item<unsigned long>::Inner;
+}
+)cpp";
+  for (const char *Standard : {"-std=c++20", "-std=c++23"})
+    for (bool Minimal : {false, true}) {
+      auto From = tooling::buildASTFromCodeWithArgs(Code, {Standard}, "from.cpp");
+      auto To = tooling::buildASTFromCodeWithArgs("", {Standard}, "to.cpp");
+      ASSERT_TRUE(From && To);
+      ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+      ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                           From->getASTContext(), From->getFileManager(), Minimal);
+      auto Text = [](const ASTUnit &Unit, SourceRange Range) {
+        return Lexer::getSourceText(CharSourceRange::getTokenRange(Range),
+                                    Unit.getSourceManager(), Unit.getLangOpts())
+            .str();
+      };
+      unsigned Count = 0;
+      for (Decl *Top : From->getASTContext().getTranslationUnitDecl()->decls()) {
+        auto *Namespace = dyn_cast<NamespaceDecl>(Top);
+        if (!Namespace || Namespace->getName() != "ExplicitSource") continue;
+        for (Decl *Member : Namespace->decls()) {
+          auto *D = dyn_cast<ExplicitInstantiationDecl>(Member);
+          if (!D) continue;
+          ++Count;
+          auto Imported = Importer.Import(D);
+          ASSERT_TRUE(bool(Imported)) << llvm::toString(Imported.takeError());
+          auto *Result = cast<ExplicitInstantiationDecl>(*Imported);
+          EXPECT_EQ(Result->getTemplateSpecializationKind(), D->getTemplateSpecializationKind());
+          EXPECT_EQ(Result->isExternTemplate(), D->isExternTemplate());
+          EXPECT_EQ(Result->hasTrailingQualifier(), D->hasTrailingQualifier());
+          EXPECT_EQ(Result->hasTrailingArgsAsWritten(), D->hasTrailingArgsAsWritten());
+          EXPECT_EQ(bool(Result->getQualifierLoc()), bool(D->getQualifierLoc()));
+          EXPECT_EQ(bool(Result->getTypeAsWritten()), bool(D->getTypeAsWritten()));
+          EXPECT_EQ(Result->getNumTemplateArgs(), D->getNumTemplateArgs());
+          EXPECT_EQ(Text(*To, Result->getSourceRange()), Text(*From, D->getSourceRange()));
+          EXPECT_EQ(To->getSourceManager().getSpellingLineNumber(Result->getNameLoc()),
+                    From->getSourceManager().getSpellingLineNumber(D->getNameLoc()));
+          auto Spec = Importer.Import(D->getSpecialization());
+          ASSERT_TRUE(bool(Spec)) << llvm::toString(Spec.takeError());
+          EXPECT_EQ(Result->getSpecialization(), *Spec);
+          if (auto *Function = dyn_cast<FunctionDecl>(*Spec)) {
+            ASSERT_TRUE(Function->getTypeSourceInfo());
+            auto FTL = Function->getTypeSourceInfo()->getTypeLoc()
+                           .IgnoreParens().getAs<FunctionTypeLoc>();
+            ASSERT_TRUE(FTL);
+            ASSERT_EQ(FTL.getNumParams(), Function->getNumParams());
+            for (unsigned I = 0; I < Function->getNumParams(); ++I)
+              EXPECT_EQ(FTL.getParam(I), Function->getParamDecl(I));
+          }
+          auto Again = Importer.Import(D);
+          ASSERT_TRUE(bool(Again)) << llvm::toString(Again.takeError());
+          EXPECT_EQ(*Again, Result);
+          auto Index = To->getASTContext().getExplicitInstantiationDecls(Result->getSpecialization());
+          unsigned Occurrences = 0;
+          for (const auto *Indexed : Index) Occurrences += Indexed == Result;
+          EXPECT_EQ(Occurrences, 1u);
+          EXPECT_EQ(Result->getLexicalDeclContext(), Result->getDeclContext());
+          EXPECT_TRUE(Result->getLexicalDeclContext()->containsDecl(Result));
+        }
+      }
+      EXPECT_EQ(Count, 10u);
+    }
+}
