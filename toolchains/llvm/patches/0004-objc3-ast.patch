+TEST(ObjC3ASTInfrastructure, WrappedBlockKeepsItsOwnershipPrototype) {
+  constexpr llvm::StringLiteral Code = R"(
+    typedef id (^OwnedBlock)(id __attribute__((ns_consumed)))
+        __attribute__((ns_returns_retained));
+    OwnedBlock block;
+    OwnedBlock __strong *pointer;
+    OwnedBlock array[2];
+  )";
+  auto AST = tooling::buildASTFromCodeWithArgs(
+      Code, {"-x", "objective-c", "-std=c17", "-fblocks", "-fobjc-version=3",
+             "-fobjc-runtime=gnustep-2.2", "-fobjc-arc",
+             "-target", "x86_64-unknown-linux-gnu"}, "blocks.m");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  ASTContext &Context = AST->getASTContext();
+  const FunctionProtoType *Shared = nullptr;
+  for (StringRef Name : {"block", "pointer", "array"}) {
+    const auto *Variable = selectFirst<VarDecl>(
+        "variable", match(varDecl(hasName(Name)).bind("variable"), Context));
+    ASSERT_TRUE(Variable);
+    const auto *Prototype = dyn_cast_or_null<FunctionProtoType>(
+        getObjC3CallableFunctionType(Context, Variable->getType()));
+    ASSERT_TRUE(Prototype);
+    ASSERT_EQ(1u, Prototype->getNumParams());
+    EXPECT_TRUE(Prototype->isParamConsumed(0));
+    EXPECT_TRUE(Prototype->getExtInfo().getProducesResult());
+    if (!Shared)
+      Shared = Prototype;
+    EXPECT_EQ(Shared, Prototype);
+  }
+  EXPECT_EQ(nullptr, getObjC3CallableFunctionType(Context, Context.IntTy));
+}
