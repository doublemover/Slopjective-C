+TEST(ObjC3ResourceTooling, ImportsPublicOperationsAndKeepsSlotIdentity) {
+  constexpr llvm::StringLiteral Source = R"(
+    void close_handle(int) __attribute__((nothrow));
+    int exercise(int input) {
+      @resource(close_handle, invalid: -1) int slot = input;
+      reset(slot, 2);
+      int owner = take(slot);
+      reset(slot, 3);
+      discard(slot);
+      return owner;
+    }
+  )";
+  auto From = tooling::buildASTFromCodeWithArgs(Source, conditionArgs(),
+                                                "resource-import.mm");
+  auto To = tooling::buildASTFromCodeWithArgs(
+      "", conditionArgs(), "resource-target.mm", "clang-tool",
+      std::make_shared<PCHContainerOperations>(),
+      tooling::getClangStripDependencyFileAdjuster(),
+      {{"resource-import.mm", Source.str()}});
+  ASSERT_TRUE(From && To);
+  ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  FunctionDecl *FD = findExercise(*From);
+  ASSERT_TRUE(FD);
+  ASTImporter Importer(To->getASTContext(), To->getFileManager(),
+                       From->getASTContext(), From->getFileManager(), false);
+  auto Imported = Importer.Import(FD);
+  ASSERT_TRUE(static_cast<bool>(Imported))
+      << llvm::toString(Imported.takeError());
+  auto *Function = cast<FunctionDecl>(*Imported);
+  class Collector : public RecursiveASTVisitor<Collector> {
+  public:
+    SmallVector<ObjC3ResourceExpr *, 4> Operations;
+    bool VisitObjC3ResourceExpr(ObjC3ResourceExpr *E) {
+      Operations.push_back(E);
+      return true;
+    }
+  } Visitor;
+  ASSERT_TRUE(Visitor.TraverseStmt(Function->getBody()));
+  ASSERT_EQ(4u, Visitor.Operations.size());
+  const VarDecl *Slot = Visitor.Operations[0]->getResourceVariable();
+  ASSERT_TRUE(Slot);
+  EXPECT_TRUE(Slot->hasAttr<ObjCResourceAttr>());
+  EXPECT_EQ(&To->getASTContext(), &Slot->getASTContext());
+  for (auto *Operation : Visitor.Operations)
+    EXPECT_EQ(Slot, Operation->getResourceVariable());
+  EXPECT_EQ(ObjC3ResourceExpr::Kind::Take, Visitor.Operations[1]->getKind());
+  Occurrences Index;
+  index::IndexingOptions Options;
+  Options.IndexFunctionLocals = true;
+  const Decl *Declarations[] = {Function};
+  index::indexTopLevelDecls(To->getASTContext(), To->getPreprocessor(),
+                            Declarations, Index, Options);
+  EXPECT_EQ(4u, Index.count("slot", index::SymbolRole::Reference));
+  EXPECT_EQ(1u, Index.count("close_handle", index::SymbolRole::Reference));
+  std::string Printed;
+  llvm::raw_string_ostream OS(Printed);
+  Function->getBody()->printPretty(OS, nullptr,
+                                   To->getASTContext().getPrintingPolicy());
+  EXPECT_NE(std::string::npos, Printed.find("reset(slot, 2)"));
+  EXPECT_NE(std::string::npos, Printed.find("take(slot)"));
+  EXPECT_NE(std::string::npos, Printed.find("discard(slot)"));
+}
