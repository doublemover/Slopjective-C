+TEST(ObjC3ASTInfrastructure, FixedPointCallbacksKeepTheirIdentityAndValueCategory) {
+  auto AST = tooling::buildASTFromCode("");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *Value = IntegerLiteral::Create(Ctx, llvm::APInt(32, 7), Ctx.IntTy, {});
+  auto *Inner = new (Ctx) ParenExpr({}, {}, Value);
+  auto *Outer = new (Ctx) ParenExpr({}, {}, Inner);
+  struct StripOneParen {
+    unsigned &Calls;
+    explicit StripOneParen(unsigned &Calls) : Calls(Calls) {}
+    StripOneParen(const StripOneParen &) = delete;
+    StripOneParen(StripOneParen &&) = delete;
+    Expr *operator()(Expr *E) && {
+      ++Calls;
+      if (auto *Paren = dyn_cast<ParenExpr>(E))
+        return Paren->getSubExpr();
+      return E;
+    }
+    Expr *operator()(Expr *) & = delete;
+  };
+  unsigned Calls = 0;
+  EXPECT_EQ(Value, IgnoreExprNodes(Outer, StripOneParen(Calls)));
+  EXPECT_EQ(3u, Calls);
+  const Expr *ConstOuter = Outer;
+  EXPECT_EQ(Value, IgnoreExprNodes(ConstOuter, StripOneParen(Calls)));
+  EXPECT_EQ(6u, Calls);
+  EXPECT_EQ(nullptr, IgnoreExprNodes(static_cast<Expr *>(nullptr),
+                                     StripOneParen(Calls)));
+  EXPECT_EQ(6u, Calls);
+}
