+     if(Property->isMessagingGetter())++Counts["messaging-getter"];
+     if(Property->isMessagingSetter())++Counts["messaging-setter"];
+     if(Property->isExplicitProperty())Reference(Property->getExplicitProperty());
+     else {Reference(Property->getImplicitPropertyGetter());Reference(Property->getImplicitPropertySetter());}
+     if(Property->isClassReceiver())Reference(Property->getClassReceiver());
+    }
+    if(const auto *Subscript=dyn_cast<ObjCSubscriptRefExpr>(E)){Reference(Subscript->getAtIndexMethodDecl());Reference(Subscript->setAtIndexMethodDecl());}
+    if(const auto *Opaque=dyn_cast<OpaqueValueExpr>(E))if(Opaque->isUnique()){++Counts["unique-opaque"];EXPECT_TRUE(Opaque->getSourceExpr());}
+    if(const auto *Protocol=dyn_cast<ObjCProtocolExpr>(E)){Reference(Protocol->getProtocol());EXPECT_TRUE(Context.hasSameType(Protocol->getType()->getPointeeType(),Context.getObjCProtoType()));}
+    if(const auto *Encode=dyn_cast<ObjCEncodeExpr>(E))if(const auto *Tag=Encode->getEncodedType()->getAsTagDecl())Reference(Tag);
+    if(const auto *Box=dyn_cast<ObjCBoxedExpr>(E))Reference(Box->getBoxingMethod());
+    if(const auto *Array=dyn_cast<ObjCArrayLiteral>(E))Reference(Array->getArrayWithObjectsMethod());
+    if(const auto *Dictionary=dyn_cast<ObjCDictionaryLiteral>(E)) {
+     Reference(Dictionary->getDictWithObjectsMethod());
+     for(unsigned I=0;I!=Dictionary->getNumElements();++I)if(Dictionary->getKeyValueElement(I).isPackExpansion())++Counts["dictionary-pack"];
+    }
+    if(const auto *Copy=dyn_cast<ObjCIndirectCopyRestoreExpr>(E))++Counts[Copy->shouldCopy()?"copy-restore":"zero-restore"];
+    if(const auto *Literal=dyn_cast<ObjCObjectLiteral>(E))++Counts[Literal->isExpressibleAsConstantInitializer()?"constant-literal":"factory-literal"];
+    if(E->getExprLoc().isValid())EXPECT_GT(Context.getSourceManager().getSpellingLineNumber(E->getExprLoc()),0u);
+    return true;
+   }
+  } Original(From->getASTContext());Original.TraverseDecl(From->getASTContext().getTranslationUnitDecl());
+  for(const char *Kind:{"ObjCPropertyRefExpr","ObjCSubscriptRefExpr","ObjCSelectorExpr","ObjCProtocolExpr","ObjCEncodeExpr","ObjCBoolLiteralExpr","ObjCStringLiteral","ObjCBoxedExpr","ObjCArrayLiteral","ObjCDictionaryLiteral","explicit-property","implicit-property","object-property","super-property","class-property","messaging-getter","messaging-setter","unique-opaque","dictionary-pack"})ASSERT_GT(Original.Counts[Kind],0u)<<Kind;
+  if(Arc){ASSERT_GT(Original.Counts["copy-restore"],0u);ASSERT_GT(Original.Counts["zero-restore"],0u);}
+  std::vector<Expr *> ImportedExpressions;
+  {
+   ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){
+    auto Imported=Importer.Import(D);if(!Imported){auto Message=llvm::toString(Imported.takeError());FAIL()<<Message;}
