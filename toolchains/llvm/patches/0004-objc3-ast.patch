+TEST(ObjC3ASTInfrastructure, NativeObjCIvarReferencesRetainOwnedDeclarationsAndAccessKinds) {
+ const char *Source=R"ivars(
+ __attribute__((objc_root_class)) @interface IvarRoot {
+ @public
+  int number;
+  unsigned flags:3;
+ @protected
+  int inherited;
+ }
+ @end
+ @interface IvarChild:IvarRoot
+ - (int)read;
+ @end
+ @implementation IvarChild
+ - (int)read {return number+flags+self->inherited;}
+ @end
+ inline int ivar_read(IvarChild *value){return ++value->number+value->flags;}
+ inline void ivar_write(IvarChild *value){value->flags=3;}
+ inline int ivar_callback(IvarChild *value){auto callback=^{return value->number;};return callback();}
+ )ivars";
+ for(const char *Standard:{"c++20","c++23"})for(bool Arc:{false,true}) {
+  std::vector<std::string> Args={"-x","objective-c++",std::string("-std=")+Standard,"-fobjc-version=3","-fobjc-runtime=gnustep-2.2","-fblocks"};
+  if(Arc)Args.push_back("-fobjc-arc");
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"ivars-source.mm");
+  auto To=tooling::buildASTFromCodeWithArgs("",Args,"ivars-target.mm");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  struct References:RecursiveASTVisitor<References> {
+   ASTContext &Context;unsigned All=0,Free=0,Arrow=0,BitFields=0;
+   llvm::SmallPtrSet<ObjCIvarRefExpr *,16> Seen;
+   std::vector<ObjCIvarRefExpr *> Nodes;
+   explicit References(ASTContext &C):Context(C){}
+   bool VisitObjCIvarRefExpr(ObjCIvarRefExpr *E) {
+    if(!Seen.insert(E).second)return true;
+    Nodes.push_back(E);++All;Free+=E->isFreeIvar();Arrow+=E->isArrow();BitFields+=E->getDecl()->isBitField();
+    EXPECT_EQ(&E->getDecl()->getASTContext(),&Context);
+    EXPECT_EQ(E->getObjectKind(),E->getDecl()->isBitField()?OK_BitField:OK_Ordinary);
+    EXPECT_EQ(E->getValueKind(),VK_LValue);EXPECT_TRUE(E->getBase());
+    if(E->getLocation().isValid())EXPECT_GT(Context.getSourceManager().getSpellingLineNumber(E->getLocation()),0u);
+    return true;
+   }
+  } Original(From->getASTContext());Original.TraverseDecl(From->getASTContext().getTranslationUnitDecl());
+  ASSERT_GE(Original.All,7u);ASSERT_GE(Original.Free,2u);ASSERT_GE(Original.BitFields,3u);
+  std::vector<Expr *> ImportedExpressions;
+  {
+   ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()) {
+    auto Imported=Importer.Import(D);if(!Imported){auto Message=llvm::toString(Imported.takeError());FAIL()<<Message;}
+   }
+   // Implementation bodies are not published by interface import. Exercise
+   // their free-ivar nodes directly after their method/self bindings import.
+   for(auto *Expression:Original.Nodes) {
+    auto Imported=Importer.Import(Expression);
+    if(!Imported){auto Message=llvm::toString(Imported.takeError());FAIL()<<Message;}
+    ImportedExpressions.push_back(*Imported);
+   }
+  }
+  From.reset();References Retained(To->getASTContext());Retained.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  for(auto *Expression:ImportedExpressions)Retained.TraverseStmt(Expression);
+  EXPECT_EQ(Retained.All,Original.All);EXPECT_EQ(Retained.Free,Original.Free);EXPECT_EQ(Retained.Arrow,Original.Arrow);EXPECT_EQ(Retained.BitFields,Original.BitFields);
+ }
+}
