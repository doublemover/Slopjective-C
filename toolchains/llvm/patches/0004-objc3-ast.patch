+TEST(ObjC3ASTInfrastructure, AlreadyLoadedIndirectFieldsCannotCreateADeclCycle) {
+  auto AST = tooling::buildASTFromCode("struct R { union { int member; }; };");
+  ASSERT_TRUE(AST);
+  ASTContext &Ctx = AST->getASTContext();
+  auto *Record = const_cast<CXXRecordDecl *>(selectFirst<CXXRecordDecl>(
+      "record", match(cxxRecordDecl(isDefinition(), hasName("R")).bind("record"),
+                      Ctx)));
+  ASSERT_TRUE(Record);
+  SmallVector<Decl *, 4> Before(Record->noload_decls());
+  auto Source = llvm::makeIntrusiveRefCnt<PreloadedFieldsSource>();
+  for (Decl *D : Before)
+    if (isa<FieldDecl>(D) || isa<IndirectFieldDecl>(D))
+      Source->Declarations.push_back(D);
+  ASSERT_EQ(2u, Source->Declarations.size());
+  Ctx.setExternalSource(Source);
+  Record->setHasLoadedFieldsFromExternalStorage(true);
+  Record->setHasExternalLexicalStorage(true);
+
+  // An old chain containing an already-loaded indirect field can become cyclic.
+  // Bound the witness itself so that this regression fails rather than hangs.
+  auto Declarations = Record->decls();
+  auto Position = Declarations.begin();
+  SmallVector<Decl *, 4> After;
+  for (unsigned Step = 0; Step <= Before.size() && Position != Declarations.end();
+       ++Step, ++Position)
+    After.push_back(*Position);
+  EXPECT_EQ(Declarations.end(), Position);
+  EXPECT_EQ(Before, After);
+  EXPECT_EQ(1u, Source->Calls);
+  EXPECT_FALSE(Record->hasExternalLexicalStorage());
+}
