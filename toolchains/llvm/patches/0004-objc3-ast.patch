+bool printNativeLifetimeAttribute(const Attr *Attribute, const Decl *Declaration,
+                                  const PrintingPolicy &Policy, raw_ostream &OS) {
+  const auto *Owner = dyn_cast<OwnerAttr>(Attribute);
+  const auto *Pointer = dyn_cast<PointerAttr>(Attribute);
+  if (Owner || Pointer) {
+    OS << "[[gsl::" << (Owner ? "Owner" : "Pointer");
