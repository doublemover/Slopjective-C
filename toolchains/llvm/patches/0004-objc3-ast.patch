+static bool haveSameAbiTags(const NamedDecl *First,
+                                    const NamedDecl *Second) {
+  auto Tags = [](const NamedDecl *Function) {
+    SmallVector<StringRef, 2> Values;
+    if (const auto *Attribute = Function->getAttr<AbiTagAttr>())
+      Values.append(Attribute->tags_begin(), Attribute->tags_end());
+    if (isa<TypeAliasDecl>(Function))
+      for (const auto *Annotation:Function->specific_attrs<AnnotateAttr>())
+        if (Annotation->args_size()==0 &&
+            Annotation->getAnnotation().starts_with("objc3.alias-owner:"))
+          Values.push_back(Annotation->getAnnotation().drop_front(sizeof("objc3.alias-owner:")-1));
+    llvm::sort(Values);
+    return Values;
+  };
+  return Tags(First) == Tags(Second);
+}
