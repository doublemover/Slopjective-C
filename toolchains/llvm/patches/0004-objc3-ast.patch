+          if(Call->getDirectCallee()->getName()=="subobject_raise")Body=true;
+          if(Call->getDirectCallee()->getName()=="subobject_marker")Deferred=true;
+        }
+    }
+    if(Block->succ_empty()) {
+      if(Termination)++Terminated;
+      else if(Unwind){++Unwound;EXPECT_TRUE(Complete.empty());}
+      else {++Normal;EXPECT_EQ(Complete,std::vector<int>({0,1,2}));EXPECT_TRUE(Deferred);}
+      return;
+    }
+    for(auto Successor:Block->succs())if(const auto *Next=Successor.getReachableBlock())
+      Self(Self,Next,Complete,Body,Deferred,Unwind,Termination,Depth+1);
+  };
+  Explore(Explore,&Graph->getEntry(),{},false,false,false,false,0);
+  EXPECT_GT(Normal,0u);EXPECT_GT(Unwound,0u);EXPECT_GT(Terminated,0u);
+}
