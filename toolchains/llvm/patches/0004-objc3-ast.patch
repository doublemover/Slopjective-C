+TEST(ObjC3IndexIdentity, UnnamedTemplateMemberTypesAndOverloadsSurviveRelocation) {
+  for (const char *Standard:{"-std=c++20","-std=c++23"}) {
+    const std::string Source=R"(
+      template<class T>struct Family {struct {T value;} first;struct {T value;} second;};
