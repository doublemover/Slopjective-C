+  if ((Policy.PolishForDeclaration || Policy.PrintAsCanonical) &&
+      D->getType()->castAs<FunctionType>()->getNoReturnAttr() &&
+      !D->hasAttr<NoReturnAttr>() && !D->hasAttr<CXX11NoReturnAttr>())
+    Out << "__attribute__((noreturn)) ";
