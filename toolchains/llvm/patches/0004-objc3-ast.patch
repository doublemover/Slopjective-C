+    for(const auto *D:C.getTranslationUnitDecl()->lookup(&C.Idents.get(Name))) {
+      llvm::SmallString<128> USR;EXPECT_FALSE(index::generateUSRForDecl(D,USR));Result.insert(USR.str().str());
+    }
+    return Result;
+  };
+  EXPECT_EQ(Collect(AST->getASTContext(),"choose").size(),2u);
+  EXPECT_EQ(Collect(AST->getASTContext(),"ordered").size(),2u);
+  EXPECT_EQ(Collect(AST->getASTContext(),"owner").size(),2u);
+  EXPECT_EQ(Collect(AST->getASTContext(),"generic").size(),2u);
+  EXPECT_EQ(Collect(AST->getASTContext(),"renamed").size(),1u);
+  EXPECT_EQ(Collect(AST->getASTContext(),"syntactic").size(),2u);
+  std::string Changed=Source;
+  for(size_t At=0;(At=Changed.find("value",At))!=std::string::npos;At+=7)Changed.replace(At,5,"renamed");
+  auto Moved=tooling::buildASTFromCodeWithArgs("\n\n"+Changed,Args,"relocated.mm");
+  ASSERT_TRUE(Moved);ASSERT_FALSE(Moved->getDiagnostics().hasErrorOccurred());
+  for(const char *Name:{"choose","ordered","owner","generic","renamed","syntactic"})
+    EXPECT_EQ(Collect(AST->getASTContext(),Name),Collect(Moved->getASTContext(),Name));
+  PrintingPolicy Policy(AST->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+  std::string Printed;llvm::raw_string_ostream Out(Printed);AST->getASTContext().getTranslationUnitDecl()->print(Out,Policy);
+  auto Replayed=tooling::buildASTFromCodeWithArgs(Printed,Args,"replayed.mm");
+  ASSERT_TRUE(Replayed);ASSERT_FALSE(Replayed->getDiagnostics().hasErrorOccurred());
+  EXPECT_EQ(Collect(AST->getASTContext(),"choose"),Collect(Replayed->getASTContext(),"choose"));
+  auto Target=tooling::buildASTFromCodeWithArgs("",Args,"target.mm");ASSERT_TRUE(Target);
+  ASTImporter Importer(Target->getASTContext(),Target->getFileManager(),AST->getASTContext(),AST->getFileManager(),false);
+  for(const char *Name:{"choose","ordered","owner","generic","renamed","syntactic"}) {
+    auto Found=AST->getASTContext().getTranslationUnitDecl()->lookup(&AST->getASTContext().Idents.get(Name));
+    for(auto *D:Found) {auto Imported=Importer.Import(D);ASSERT_TRUE(bool(Imported));}
+    EXPECT_EQ(Collect(AST->getASTContext(),Name),Collect(Target->getASTContext(),Name));
+  }
+  auto Members=AST->getASTContext().getTranslationUnitDecl()->lookup(&AST->getASTContext().Idents.get("Member"));
+  ASSERT_FALSE(Members.empty());auto ImportedRecord=Importer.Import(Members.front());ASSERT_TRUE(bool(ImportedRecord));
+  auto *FromRecord=cast<CXXRecordDecl>(Members.front())->getDefinition();
