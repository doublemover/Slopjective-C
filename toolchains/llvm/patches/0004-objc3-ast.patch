+TEST(ObjC3ASTInfrastructure, VirtualObjectsKeepConstructionAndDestructionVariantsCorrelated) {
+  auto AST=tooling::buildASTFromCodeWithArgs(R"(
+    struct Virtual {explicit Virtual(int);~Virtual() noexcept(false);};
+    struct Direct {explicit Direct(int);~Direct() noexcept(false);};
+    struct Member {explicit Member(int);~Member() noexcept(false);};
+    int virtual_stage(int);
+    void virtual_marker(int) noexcept;
+    void virtual_raise();
+    extern int virtual_return;
+    struct Owner:virtual Virtual,Direct {
+      Member member;
+      Owner() try:Virtual(virtual_stage(0)),Direct(virtual_stage(1)),member(virtual_stage(2)) {
+        __objc3_defer {virtual_marker(31);}
+        if(virtual_return)goto finished;
+        virtual_raise();
+      finished:virtual_marker(30);
+      } catch(...) {virtual_marker(80);}
+      ~Owner() noexcept(false) try {
+        __objc3_defer {virtual_marker(31);}
+        if(virtual_return)return;
+        virtual_raise();
+      } catch(...) {virtual_marker(80);}
+    };
+  )",{"-x","objective-c++","-std=c++23","-fobjc-version=3","-fobjc-runtime=gnustep-2.2",
+       "--target=x86_64-unknown-linux-gnu","-fexceptions","-fobjc-exceptions"},"virtual-variants.mm");
+  ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  CXXRecordDecl *Owner=nullptr;
+  for(auto *D:AST->getASTContext().getTranslationUnitDecl()->decls())
+    if(auto *R=dyn_cast<CXXRecordDecl>(D);R && R->getName()=="Owner")Owner=R;
+  ASSERT_NE(Owner,nullptr);
+  for(bool Destroying:{false,true}) {
+    CXXMethodDecl *Method=Destroying?static_cast<CXXMethodDecl *>(Owner->getDestructor()):*Owner->ctor_begin();
+    CFG::BuildOptions Options;Options.setAllAlwaysAdd();Options.AddLifetime=true;
+    Options.AddEHEdges=true;Options.AddImplicitDtors=true;Options.AddInitializers=true;
+    Options.AddVirtualBaseBranches=true;Options.AddRichCXXConstructors=true;
+    auto Graph=CFG::buildCFG(Method,Method->getBody(),&AST->getASTContext(),Options);ASSERT_TRUE(Graph);
+    const CFGBlock *Choice=*Graph->getEntry().succ_begin();
+    ASSERT_TRUE(Choice->getTerminator().isVirtualBaseBranch());ASSERT_EQ(Choice->succ_size(),2u);
+    unsigned Variant=0;
+    for(auto Head:Choice->succs()) {
+      bool Base=Variant++==1;
+      unsigned Budget=32768,Normal=0,Unwound=0,VirtualInitializations=0,VirtualDestructions=0;
+      auto Explore=[&](auto &&Self,const CFGBlock *Block,std::vector<int> Parts,bool Handler,bool Unwind,bool Terminated,unsigned Depth)->void {
+        ASSERT_GT(Budget--,0u);ASSERT_LT(Depth,256u);
+        Unwind|=Block->isNativeExceptionExit();Terminated|=Block->hasNoReturnElement();
+        for(const auto &Element:*Block) {
+          if(auto Initializer=Element.getAs<CFGInitializer>()) {
+            auto *I=Initializer->getInitializer();int Part=I->isAnyMemberInitializer()?2:I->isBaseVirtual()?0:1;
+            EXPECT_FALSE(Destroying);EXPECT_FALSE(Handler);
+            if(Part==0){EXPECT_FALSE(Base);++VirtualInitializations;}
+            Parts.push_back(Part);
+          }
+          int Part=-1;
+          if(auto Dtor=Element.getAs<CFGMemberDtor>())Part=2;
+          if(auto Dtor=Element.getAs<CFGBaseDtor>())Part=Dtor->getBaseSpecifier()->isVirtual()?0:1;
+          if(Part>=0) {
+            EXPECT_FALSE(Handler);ASSERT_FALSE(Parts.empty());EXPECT_EQ(Parts.back(),Part);Parts.pop_back();
+            if(Part==0){EXPECT_FALSE(Base);++VirtualDestructions;}
+          }
+          if(auto Statement=Element.getAs<CFGStmt>())
+            if(const auto *Call=dyn_cast<CallExpr>(Statement->getStmt());Call && Call->getDirectCallee()) {
+              if(Call->getDirectCallee()->getName()=="virtual_stage" &&
+                 cast<IntegerLiteral>(Call->getArg(0)->IgnoreParenImpCasts())->getValue()==0)EXPECT_FALSE(Base);
+              if(Call->getDirectCallee()->getName()=="virtual_marker" &&
+                 cast<IntegerLiteral>(Call->getArg(0)->IgnoreParenImpCasts())->getValue()==80) {
+                EXPECT_TRUE(Parts.empty());Handler=true;
+              }
+            }
+        }
+        if(Block->succ_empty()) {
+          if(Terminated)return;
+          if(Unwind){++Unwound;EXPECT_TRUE(Parts.empty());EXPECT_TRUE(Handler);}
+          else {++Normal;EXPECT_FALSE(Handler);EXPECT_EQ(Parts.size(),Destroying?0u:Base?2u:3u);}
+          return;
+        }
+        for(auto Successor:Block->succs())if(auto *Next=Successor.getReachableBlock())Self(Self,Next,Parts,Handler,Unwind,Terminated,Depth+1);
+      };
+      std::vector<int> Parts;
+      if(Destroying){if(!Base)Parts.push_back(0);Parts.push_back(1);Parts.push_back(2);}
+      Explore(Explore,Head.getReachableBlock(),Parts,false,false,false,0);
+      EXPECT_GT(Normal,0u);EXPECT_GT(Unwound,0u);
+      EXPECT_EQ(VirtualInitializations>0,!Base && !Destroying);EXPECT_EQ(VirtualDestructions>0,!Base);
+    }
+  }
+}
