+void printObjC3ThreadSafetyAttribute(const Attr *A,const Decl *D,
+    const PrintingPolicy &Policy,raw_ostream &Out) {
+  struct Parameters:PrinterHelper {
+    const NamedDecl *Current;
+    explicit Parameters(const Decl *D):Current(dyn_cast<NamedDecl>(D)){}
+    bool handledStmt(Stmt *Statement,raw_ostream &Out) override {
+      const auto *Reference=dyn_cast<DeclRefExpr>(Statement);
+      const auto *Parameter=Reference?dyn_cast<ParmVarDecl>(Reference->getDecl()):nullptr;
+      if(!Parameter || !Current)return false;
+      const auto *Owner=dyn_cast<NamedDecl>(Parameter->getDeclContext());
+      if(!Owner || Owner->getCanonicalDecl()!=Current->getCanonicalDecl())return false;
+      const unsigned Index=Parameter->getFunctionScopeIndex();
+      const ParmVarDecl *Target=nullptr;
+      if(const auto *Function=dyn_cast<FunctionDecl>(Current)) {
+        if(Index<Function->getNumParams())Target=Function->getParamDecl(Index);
+      } else if(const auto *Method=dyn_cast<ObjCMethodDecl>(Current)) {
+        if(Index<Method->param_size())Target=Method->getParamDecl(Index);
