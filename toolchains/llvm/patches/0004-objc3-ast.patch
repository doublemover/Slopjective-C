+TEST(ObjC3ConditionTooling,
+     PersistedASTKeepsNativeBindingsAndSourceOccurrences) {
+  auto AST = tooling::buildASTFromCodeWithArgs(ConditionSource, conditionArgs(),
+                                               "condition-persistence.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  llvm::SmallString<256> Path;
+  int Descriptor;
+  ASSERT_FALSE(llvm::sys::fs::createTemporaryFile("objc3-condition-tooling",
+                                                  "ast", Descriptor, Path));
+  llvm::ToolOutputFile File(Path, Descriptor);
+  ASSERT_FALSE(AST->Save(Path));
+  auto VFS = AST->getFileManager().getVirtualFileSystemPtr();
+  auto DiagnosticOpts = std::make_shared<DiagnosticOptions>();
+  auto Diagnostics = CompilerInstance::createDiagnostics(*VFS, *DiagnosticOpts);
+  auto Containers = std::make_shared<PCHContainerOperations>();
+  HeaderSearchOptions HeaderOptions;
+  auto Reloaded = ASTUnit::LoadFromASTFile(
+      Path, Containers->getRawReader(), ASTUnit::LoadEverything, VFS,
+      DiagnosticOpts, Diagnostics, AST->getFileSystemOpts(), HeaderOptions);
+  ASSERT_TRUE(Reloaded);
+  auto *FD = findExercise(*Reloaded);
+  ASSERT_TRUE(FD);
+  auto *Body = cast<CompoundStmt>(FD->getBody());
+  ASSERT_EQ(2u, Body->size());
+  auto *Guard = cast<ObjC3GuardStmt>(Body->body_front());
+  auto *If = cast<ObjC3IfBindingStmt>(*(Body->body_begin() + 1));
+  ASSERT_EQ(2u, Guard->getNumConditions());
+  ASSERT_EQ(2u, If->getNumConditions());
+  EXPECT_TRUE(Guard->getElseLoc().isValid());
+  EXPECT_TRUE(If->getElseLoc().isValid());
+  EXPECT_TRUE(If->getElse());
+  SourceVisitor Visitor;
+  EXPECT_TRUE(Visitor.TraverseStmt(Body));
+  EXPECT_EQ(2u, Visitor.SourceReferences);
+  EXPECT_EQ(2u, Visitor.DeclStatements);
+  Occurrences Index;
+  index::IndexingOptions Options;
+  Options.IndexFunctionLocals = true;
+  index::indexASTUnit(*Reloaded, Index, Options);
+  EXPECT_EQ(2u, Index.count("source", index::SymbolRole::Reference));
+  EXPECT_EQ(3u, Index.count("first", index::SymbolRole::Reference));
+  EXPECT_EQ(3u, Index.count("second", index::SymbolRole::Reference));
+}
