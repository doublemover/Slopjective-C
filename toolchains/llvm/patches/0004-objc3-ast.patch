+          To->getASTContext(),NonEquivalent,StructuralEquivalenceKind::Default,false,false);
+      EXPECT_EQ(Equivalence.IsEquivalent(Find(From->getASTContext()),Find(To->getASTContext())),!Foreign);
+      ASTImporter Importer(To->getASTContext(),To->getFileManager(),
+                           From->getASTContext(),From->getFileManager(),false);
+      auto Imported=Importer.Import(Find(From->getASTContext()));
+      EXPECT_EQ(bool(Imported),!Foreign);
+      if(!Imported)llvm::consumeError(Imported.takeError());
+      else EXPECT_EQ(*Imported,Find(To->getASTContext()));
