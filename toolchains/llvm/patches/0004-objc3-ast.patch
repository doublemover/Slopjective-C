+  ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  auto Identities=[](ASTContext &Context) {
+    std::set<std::string> Result;
+    for(const auto *D:Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("choose"))) {
