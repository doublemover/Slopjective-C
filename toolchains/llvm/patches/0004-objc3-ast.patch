+TEST(ObjC3ASTInfrastructure, UnnamedObjCIvarsKeepTheirLayoutThroughRepeatedImport) {
+  constexpr llvm::StringLiteral Code = R"(
+    __attribute__((objc_root_class))
+    @interface Layout {
+      unsigned first : 3;
+      unsigned : 0;
+      unsigned last : 5;
+    }
+    @end
+  )";
+  const std::vector<std::string> Args = {
+      "-x", "objective-c", "-std=c17", "-target", "x86_64-unknown-linux-gnu",
+      "-fobjc-version=3", "-fobjc-runtime=gnustep-2.2"};
+  auto First = tooling::buildASTFromCodeWithArgs(Code, Args, "first.m");
+  auto Second = tooling::buildASTFromCodeWithArgs(Code, Args, "second.m");
+  auto Target = tooling::buildASTFromCodeWithArgs("", Args, "target.m");
+  ASSERT_TRUE(First && Second && Target);
+  auto Layout = [](ASTUnit &Unit) {
+    ASTContext &Context = Unit.getASTContext();
+    return dyn_cast<ObjCInterfaceDecl>(
+        Context.getTranslationUnitDecl()->lookup(&Context.Idents.get("Layout")).front());
+  };
+  auto *SourceLayout = Layout(*First);
+  ASSERT_TRUE(SourceLayout);
+  SmallVector<ObjCIvarDecl *, 4> SourceIvars(SourceLayout->ivars());
+  ASSERT_EQ(4u, SourceIvars.size());
+  EXPECT_EQ(0u, SourceIvars[1]->getBitWidthValue());
+  EXPECT_TRUE(SourceIvars[3]->getDeclName().isEmpty());
+  EXPECT_EQ(0u, SourceIvars[3]->getBitWidthValue());
+
+  ASTContext &Context = Target->getASTContext();
+  ObjCInterfaceDecl *ImportedLayout = nullptr;
+  for (ASTUnit *Source : {First.get(), Second.get()}) {
+    ASTImporter Importer(Context, Target->getFileManager(), Source->getASTContext(),
+                         Source->getFileManager(), /*MinimalImport=*/false);
+    auto Imported = Importer.Import(Layout(*Source));
+    ASSERT_TRUE(static_cast<bool>(Imported));
+    auto *Current = cast<ObjCInterfaceDecl>(*Imported);
+    if (!ImportedLayout)
+      ImportedLayout = Current;
+    EXPECT_EQ(ImportedLayout, Current);
+    SmallVector<ObjCIvarDecl *, 4> TargetIvars(Current->ivars());
+    ASSERT_EQ(SourceIvars.size(), TargetIvars.size());
+    for (unsigned I = 0; I != SourceIvars.size(); ++I) {
+      EXPECT_EQ(SourceIvars[I]->getName(), TargetIvars[I]->getName());
+      EXPECT_EQ(SourceIvars[I]->isImplicit(), TargetIvars[I]->isImplicit());
+      EXPECT_EQ(SourceIvars[I]->getBitWidthValue(), TargetIvars[I]->getBitWidthValue());
+    }
+  }
+
+  const auto &SourceABI = First->getASTContext().getASTObjCInterfaceLayout(SourceLayout);
+  const auto &TargetABI = Context.getASTObjCInterfaceLayout(ImportedLayout);
+  EXPECT_EQ(SourceABI.getSize(), TargetABI.getSize());
+  ASSERT_EQ(SourceABI.getFieldCount(), TargetABI.getFieldCount());
+  for (unsigned I = 0; I != SourceABI.getFieldCount(); ++I)
+    EXPECT_EQ(SourceABI.getFieldOffset(I), TargetABI.getFieldOffset(I));
+}
