+namespace {
+struct ObservingCopyVisitor : CopiedTypeVisitor<ObservingCopyVisitor, false, int> {
+  int Observed = 0;
+  bool DestructivePrepass = false;
+  void preVisit(QualType::PrimitiveCopyKind, QualType,
+                const std::unique_ptr<int> &Value) {
+    EXPECT_TRUE(Value);
+    if (Value) Observed = *Value;
+  }
+  void preVisit(QualType::PrimitiveCopyKind, QualType,
+                std::unique_ptr<int> &&Value) {
+    DestructivePrepass = true;
+    auto Consumed = std::move(Value);
+  }
+  int visitTrivial(QualType, std::unique_ptr<int> Value) {
+    EXPECT_TRUE(Value);
+    return Value ? *Value : 0;
+  }
+  int visitARCStrong(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+  int visitARCWeak(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+  int visitPtrAuth(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+  int visitObjC3Carrier(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+  int visitStruct(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+  int visitVolatileTrivial(QualType T, std::unique_ptr<int> V) {return visitTrivial(T, std::move(V));}
+};
+} // namespace
