+TEST(ObjC3ASTInfrastructure, CatchLifetimeFollowsDeferredBodyOnEveryExit) {
+  for (bool Cxx : {false,true})
+    for (bool ARC : {false,true}) {
+      std::vector<std::string> Args={"-x",Cxx?"objective-c++":"objective-c",
+          Cxx?"-std=c++23":"-std=c17","-fobjc-version=3","-fobjc-runtime=gnustep-2.2",
+          "--target=x86_64-unknown-linux-gnu","-fexceptions","-fobjc-exceptions"};
+      if(ARC)Args.push_back("-fobjc-arc");
+      auto AST=tooling::buildASTFromCodeWithArgs(R"(
+        void catch_marker(int) __attribute__((nothrow));
+        void catch_raise(void);
+        void catch_paths(int mode) {
+          @try {
+            @try {catch_raise();}
+            @catch(id value) {
+              __objc3_defer {catch_marker(11);}
+              catch_marker(12);
+              if(mode)@throw;
+              return;
+            }
+          } @catch(...) {catch_marker(13);}
+        }
+      )",Args,"catch-lifetime.m");
+      ASSERT_TRUE(AST);ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+      FunctionDecl *Function=nullptr;
+      for(auto *D:AST->getASTContext().getTranslationUnitDecl()->decls())
+        if(auto *F=dyn_cast<FunctionDecl>(D);F && F->getName()=="catch_paths")Function=F;
+      ASSERT_NE(Function,nullptr);
+      CFG::BuildOptions Options;Options.setAllAlwaysAdd();Options.AddLifetime=true;
+      Options.AddEHEdges=true;Options.AddImplicitDtors=true;
+      auto Graph=CFG::buildCFG(Function,Function->getBody(),&AST->getASTContext(),Options);
+      ASSERT_TRUE(Graph);
+      const CFGBlock *Start=nullptr;const VarDecl *Binding=nullptr;
+      for(const auto *Block:*Graph)
+        if(const auto *Catch=dyn_cast_or_null<ObjCAtCatchStmt>(Block->getLabel());
+           Catch && Catch->getCatchParamDecl()) {Start=Block;Binding=Catch->getCatchParamDecl();}
+      ASSERT_NE(Start,nullptr);ASSERT_NE(Binding,nullptr);
+      unsigned Paths=0,Budget=4096;
+      auto Explore=[&](auto &&Self,const CFGBlock *Block,std::vector<int> Trace,unsigned Depth)->void {
+        ASSERT_GT(Budget--,0u);ASSERT_LT(Depth,64u);
+        for(const auto &Element:*Block) {
+          if(auto End=Element.getAs<CFGLifetimeEnds>();End && End->getVarDecl()==Binding)Trace.push_back(20);
+          if(auto Statement=Element.getAs<CFGStmt>())
+            if(const auto *Call=dyn_cast<CallExpr>(Statement->getStmt());Call && Call->getDirectCallee() &&
+                Call->getDirectCallee()->getName()=="catch_marker")
+              Trace.push_back(cast<IntegerLiteral>(Call->getArg(0)->IgnoreParenImpCasts())->getValue().getZExtValue());
+        }
+        if(Block->succ_empty()) {
+          ++Paths;ASSERT_GE(Trace.size(),3u);
+          EXPECT_EQ(Trace[0],12);EXPECT_EQ(Trace[1],11);EXPECT_EQ(Trace[2],20);
+          EXPECT_EQ(std::count(Trace.begin(),Trace.end(),20),1);
+          return;
+        }
+        for(auto Successor:Block->succs())if(const auto *Next=Successor.getReachableBlock())Self(Self,Next,Trace,Depth+1);
+      };
+      Explore(Explore,Start,{},0);EXPECT_GE(Paths,2u);
+    }
+}
