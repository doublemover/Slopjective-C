+      OS << '('; Type->getType().print(OS, Policy); OS << ')';
+    }
+    OS << "]]"; return true;
+  }
+  const auto *Capture = dyn_cast<LifetimeCaptureByAttr>(Attribute);
+  if (!Capture) return false;
+  const bool Receiver = isa<FunctionDecl>(Declaration);
+  const StringRef Open = Receiver ? "[[clang::" : "__attribute__((";
+  const StringRef Close = Receiver ? "]]" : "))";
+  bool ImplicitThis = false;
+  SmallVector<const ParmVarDecl *, 8> Parameters;
+  if (const auto *Parameter = dyn_cast<ParmVarDecl>(Declaration))
+    Parameters = nativeLifetimeParameters(Parameter, ImplicitThis);
+  if (const auto *Function = dyn_cast<CXXMethodDecl>(Declaration)) {
+    ImplicitThis = !Function->isStatic() && !Function->isExplicitObjectMemberFunction();
