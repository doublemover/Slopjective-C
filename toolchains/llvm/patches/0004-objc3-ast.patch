+TEST(ObjC3ConditionTooling, IndexesSourcesAndUserBindingsExactlyOnce) {
+  auto AST = tooling::buildASTFromCodeWithArgs(ConditionSource, conditionArgs(),
+                                               "condition-index.mm");
+  ASSERT_TRUE(AST);
+  ASSERT_FALSE(AST->getDiagnostics().hasErrorOccurred());
+  Occurrences Index;
+  index::IndexingOptions Options;
+  Options.IndexFunctionLocals = true;
+  index::indexASTUnit(*AST, Index, Options);
+  EXPECT_EQ(2u, Index.count("source", index::SymbolRole::Reference));
+  EXPECT_EQ(1u, Index.count("first", index::SymbolRole::Definition));
+  EXPECT_EQ(1u, Index.count("second", index::SymbolRole::Definition));
+  EXPECT_EQ(3u, Index.count("first", index::SymbolRole::Reference));
+  EXPECT_EQ(3u, Index.count("second", index::SymbolRole::Reference));
+  EXPECT_EQ(1u, Index.count("second", index::SymbolRole::Write));
+  for (const auto &Item : Index.Items)
+    EXPECT_FALSE(Item.Declaration->isImplicit());
+}
