+void printObjC3TypestateAttribute(const Attr *A,raw_ostream &Out) {
+  Out << "__attribute__((";
+  auto State=[&](StringRef Name,StringRef Value){Out<<Name<<'('<<Value<<')';};
+  if(const auto *V=dyn_cast<ConsumableAttr>(A))
+    State("consumable",ConsumableAttr::ConvertConsumedStateToStr(V->getDefaultState()));
+  else if(const auto *V=dyn_cast<CallableWhenAttr>(A)) {
+    llvm::SmallVector<StringRef,4> States;
+    for(auto Value:V->callableStates())States.push_back(CallableWhenAttr::ConvertConsumedStateToStr(Value));
+    llvm::sort(States);States.erase(std::unique(States.begin(),States.end()),States.end());
+    Out<<"callable_when(";llvm::ListSeparator Comma;
+    for(auto Value:States)Out<<Comma<<'"'<<Value<<'"';
+    Out<<')';
+  } else if(const auto *V=dyn_cast<ParamTypestateAttr>(A))
+    State("param_typestate",ParamTypestateAttr::ConvertConsumedStateToStr(V->getParamState()));
+  else if(const auto *V=dyn_cast<ReturnTypestateAttr>(A))
+    State("return_typestate",ReturnTypestateAttr::ConvertConsumedStateToStr(V->getState()));
+  else if(const auto *V=dyn_cast<SetTypestateAttr>(A))
+    State("set_typestate",SetTypestateAttr::ConvertConsumedStateToStr(V->getNewState()));
+  else if(const auto *V=dyn_cast<TestTypestateAttr>(A))
+    State("test_typestate",TestTypestateAttr::ConvertConsumedStateToStr(V->getTestState()));
+  else if(const auto *V=dyn_cast<EnumExtensibilityAttr>(A))
+    State("enum_extensibility",EnumExtensibilityAttr::ConvertKindToStr(V->getExtensibility()));
+  else if(isa<ConsumableAutoCastAttr>(A))Out<<"consumable_auto_cast_state";
+  else if(isa<ConsumableSetOnReadAttr>(A))Out<<"consumable_set_state_on_read";
+  else if(isa<FlagEnumAttr>(A))Out<<"flag_enum";
+  Out<<"))";
+}
