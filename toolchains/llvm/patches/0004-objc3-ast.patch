+      int choose(int value) const __asm__("member_negative") __attribute__((enable_if(value<0,"negative"))) {return -value;}
+    };
+    int choose(int value) __attribute__((enable_if(value>=0,"positive")));
+    int choose(int value) __attribute__((enable_if(value<0,"negative")));
+    int ordered(int value) __attribute__((enable_if(value>0,"positive")));
+    int ordered(int value) __attribute__((enable_if(value>0,"positive"),enable_if(value<10,"small")));
+    int owner(int value) __attribute__((enable_if(value>Left::bound,"left")));
+    int owner(int value) __attribute__((enable_if(value>Right::bound,"right")));
+    template<class T> T generic(T value) __attribute__((enable_if(value>=0,"generic")));
+    template<class T> T generic(T value) __attribute__((enable_if(value<0,"negative generic")));
+    int syntactic(int value) __attribute__((enable_if(value>=0,"plain")));
+    int syntactic(int value) __attribute__((enable_if((value>=0),"parenthesized")));
+    int renamed(int before) __attribute__((enable_if(before>=0,"renamed")));
+    int renamed(int after) __attribute__((enable_if(after>=0,"renamed"))) {return after;}
+  )";
+  auto Args=std::vector<std::string>{"-x","objective-c++","-std=c++23","-fobjc-version=3"};
+  auto AST=tooling::buildASTFromCodeWithArgs(Source,Args,"conditional.mm");
