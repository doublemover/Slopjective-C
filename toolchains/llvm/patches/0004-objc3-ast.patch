+      {"result_temporary",
+       {"construct,temporary,first,", "construct,temporary,first,caught,"}},
+      {"temporary_construction_failure",
+       {"construct,first,caught,", "construct,temporary,first,"}},
+      {"reference_cast", {"cast,first,", "cast,first,caught,"}},
+      {"type_query", {"typeid,first,", "typeid,first,caught,"}},
+      {"scalar_allocation", {"allocate,first,", "allocate,first,caught,"}},
+      {"initialized_allocation",
+       {"allocate,construct,first,", "allocate,first,caught,"}},
+      {"scalar_deallocation",
+       {"first,", "delete-dtor,delete,first,", "delete-dtor,delete,first,caught,"}},
+      {"unmatched_inner_handler",
+       {"work,second,first,", "work,second,caught,first,",
+        "work,second,first,unwind,"}}};
+  unsigned Cases = 0;
+  for (Decl *D : AST->getASTContext().getTranslationUnitDecl()->decls()) {
+    auto *Function = dyn_cast<FunctionDecl>(D);
+    if (!Function || !Function->hasBody())
+      continue;
+    SCOPED_TRACE(Function->getNameAsString());
+    for (bool Rich : {false, true}) {
+      SCOPED_TRACE(Rich);
+      CFG::BuildOptions Options;
+      Options.AddEHEdges = Options.AddImplicitDtors =
+          Options.AddTemporaryDtors = true;
+      Options.AddRichCXXConstructors = Rich;
+      Options.setAllAlwaysAdd();
+      auto Graph = CFG::buildCFG(Function, Function->getBody(),
+                                 &AST->getASTContext(), Options);
+      ASSERT_TRUE(Graph);
+      std::set<std::string> Paths;
+      std::function<void(const CFGBlock *, std::string, unsigned)> Visit =
+          [&](const CFGBlock *Block, std::string Events, unsigned Depth) {
+            ASSERT_LT(Depth, 100u);
+            for (const auto &Element : *Block) {
+              if (Element.getAs<CFGAutomaticObjDtor>())
+                Events += "destroy,";
+              else if (Element.getAs<CFGTemporaryDtor>())
+                Events += "temporary,";
+              else if (Element.getAs<CFGDeleteDtor>())
+                Events += "delete-dtor,";
+              else if (Element.getAs<CFGCleanupFunction>())
+                Events += "cleanup,";
+              else if (Element.getAs<CFGNewAllocator>())
+                Events += "allocate,";
+              else if (auto Statement = Element.getAs<CFGStmt>()) {
+                const Stmt *Node = Statement->getStmt();
+                if (isa<CXXConstructExpr>(Node))
+                  Events += "construct,";
+                else if (isa<CXXDynamicCastExpr>(Node))
+                  Events += "cast,";
+                else if (isa<CXXTypeidExpr>(Node))
+                  Events += "typeid,";
+                else if (isa<CXXDeleteExpr>(Node))
+                  Events += "delete,";
+                else if (const auto *Call = dyn_cast<CallExpr>(Node))
+                  if (const auto *Callee = Call->getDirectCallee())
+                    Events += Callee->getNameAsString() + ",";
+              }
+            }
+            if (Block->isNativeExceptionExit())
+              Events += "unwind,";
+            if (Block->hasNoReturnElement())
+              Events += "terminate,";
+            if (Block == &Graph->getExit())
+              Paths.insert(Events);
+            else
+              for (const auto &Edge : Block->succs())
+                if (const auto *Next = Edge.getReachableBlock())
+                  Visit(Next, Events, Depth + 1);
+          };
+      Visit(&Graph->getEntry(), "", 0);
+      EXPECT_EQ(Expected.at(Function->getNameAsString()), Paths);
+    }
+    ++Cases;
+  }
+  EXPECT_EQ(Expected.size(), Cases);
+}
