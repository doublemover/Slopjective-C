+TEST(ObjC3ASTInfrastructure, NativeLifetimeAnnotationsOwnTypesAndCaptureTargetsAfterImport) {
+ const char *Source=R"lifetime(
+ struct Pointee {int value;};
+ struct View;
+ struct [[gsl::Owner(Pointee)]] Owner {Pointee value;void bind(View &target) const [[clang::lifetime_capture_by(target)]];};
+ struct [[gsl::Pointer(Pointee)]] View {const Pointee *pointer;};
+ void Owner::bind(View &renamed) const {renamed.pointer=&value;}
+ struct [[gsl::Owner]] ErasedOwner {int value;};
+ struct [[gsl::Pointer]] ErasedView {const int *pointer;};
+ void capture(const Owner &source [[clang::lifetime_capture_by(destination)]],View &destination);
+ void capture(const Owner &renamed,View &result){result.pointer=&renamed.value;}
+ void unnamed(const Owner &source [[clang::lifetime_capture_by(destination)]],View &destination);
+ void unnamed(const Owner &__objc3_capture_parameter_1,View &){}
+ void first(View &destination,const Owner &source [[clang::lifetime_capture_by(destination)]]){destination.pointer=&source.value;}
+ void global(const Owner &source [[clang::lifetime_capture_by_global]]);
+ void unknown(const Owner &source [[clang::lifetime_capture_by_unknown]]);
+ struct [[gsl::Pointer(Pointee)]] Holder {
+  const Pointee *pointer;
+  void put(const Owner &source [[clang::lifetime_capture_by_this]]){pointer=&source.value;}
+  static void put_static(View &destination,const Owner &source [[clang::lifetime_capture_by(destination)]]){destination.pointer=&source.value;}
+ };
+ template<class T>struct [[gsl::Owner(T)]] Box {T value;};
+ template<class T>struct [[gsl::Pointer(T)]] Ref {const T *pointer;};
+ template<class T>void generic(const Box<T>&source [[clang::lifetime_capture_by(destination)]],Ref<T>&destination){destination.pointer=&source.value;}
+ inline auto closure(){return [](const Owner &source [[clang::lifetime_capture_by(destination)]],View &destination){destination.pointer=&source.value;};}
+ )lifetime";
+ for(const char *Standard:{"c++20","c++23"}) {
+  std::vector<std::string> Args={"-x","c++",std::string("-std=")+Standard};
+  auto From=tooling::buildASTFromCodeWithArgs(Source,Args,"lifetime-source.cpp");
+  auto To=tooling::buildASTFromCodeWithArgs("",Args,"lifetime-target.cpp");
+  ASSERT_TRUE(From);ASSERT_TRUE(To);ASSERT_FALSE(From->getDiagnostics().hasErrorOccurred());
+  struct Attributes:RecursiveASTVisitor<Attributes> {
+   ASTContext &Context;llvm::SmallPtrSet<const TypeSourceInfo *,16> Types;
+   unsigned Captures=0,ReceiverCaptures=0;
+   void CheckCapture(const LifetimeCaptureByAttr *Capture) {
+    ++Captures;
+    for(int Target:Capture->params())EXPECT_NE(Target,LifetimeCaptureByAttr::Invalid);
+    for(const auto *Name:Capture->getArgIdents())if(Name)EXPECT_EQ(Name,&Context.Idents.get(Name->getName()));
+    for(auto Location:Capture->getArgLocs())if(Location.isValid())EXPECT_GT(Context.getSourceManager().getSpellingLineNumber(Location),0u);
+   }
+   explicit Attributes(ASTContext &Context):Context(Context){}
+   bool VisitNamedDecl(NamedDecl *D) {
+    for(const auto *A:D->attrs()) {
+     const TypeSourceInfo *Type=nullptr;
+     if(const auto *Owner=dyn_cast<OwnerAttr>(A))Type=Owner->getDerefTypeLoc();
+     if(const auto *Pointer=dyn_cast<PointerAttr>(A))Type=Pointer->getDerefTypeLoc();
+     if(Type) {
+      Types.insert(Type);
+      if(const auto *Tag=Type->getType()->getAsTagDecl())EXPECT_EQ(&Tag->getASTContext(),&Context);
+      if(const auto *Parameter=Type->getType()->getAs<TemplateTypeParmType>())
+       if(Parameter->getDecl())EXPECT_EQ(&Parameter->getDecl()->getASTContext(),&Context);
+     }
+     if(const auto *Capture=dyn_cast<LifetimeCaptureByAttr>(A)) {
+      CheckCapture(Capture);
+     }
+    }
+    if(const auto *Function=dyn_cast<FunctionDecl>(D))
+     if(auto *Info=Function->getTypeSourceInfo())
+      for(TypeLoc Type=Info->getTypeLoc();;) {
+       auto Attribute=Type.getAsAdjusted<AttributedTypeLoc>();if(!Attribute)break;
+       if(auto *Capture=Attribute.getAttrAs<LifetimeCaptureByAttr>()){++ReceiverCaptures;CheckCapture(Capture);}
+       Type=Attribute.getModifiedLoc();
+      }
+    return true;
+   }
+  } Original(From->getASTContext());Original.TraverseDecl(From->getASTContext().getTranslationUnitDecl());
+  ASSERT_GE(Original.Types.size(),5u);ASSERT_GE(Original.Captures,8u);ASSERT_EQ(Original.ReceiverCaptures,2u);
+  {
+   ASTImporter Importer(To->getASTContext(),To->getFileManager(),From->getASTContext(),From->getFileManager(),false);
+   for(auto *D:From->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()) {
+    auto Imported=Importer.Import(D);if(!Imported){auto Message=llvm::toString(Imported.takeError());FAIL()<<Message;}
+   }
+  }
+  Attributes Imported(To->getASTContext());Imported.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  for(auto *Type:Imported.Types)EXPECT_FALSE(Original.Types.contains(Type));
+  EXPECT_EQ(Imported.Captures,Original.Captures);EXPECT_EQ(Imported.ReceiverCaptures,Original.ReceiverCaptures);
+  From.reset();Attributes Retained(To->getASTContext());Retained.TraverseDecl(To->getASTContext().getTranslationUnitDecl());
+  PrintingPolicy Policy(To->getASTContext().getLangOpts());Policy.PolishForDeclaration=true;
+  std::string Printed;llvm::raw_string_ostream Out(Printed);
+  for(auto *D:To->getASTContext().getTranslationUnitDecl()->decls())if(!D->isImplicit()){D->print(Out,Policy);Out<<";\n";}
+  Out.flush();EXPECT_EQ(Printed.find("lifetime_capture_by(1)"),std::string::npos)<<Printed;
+  auto Replay=tooling::buildASTFromCodeWithArgs(Printed,Args,"lifetime-replay.cpp");ASSERT_TRUE(Replay);
+  EXPECT_FALSE(Replay->getDiagnostics().hasErrorOccurred())<<Printed;
+  Attributes Reparsed(Replay->getASTContext());Reparsed.TraverseDecl(Replay->getASTContext().getTranslationUnitDecl());
+  EXPECT_EQ(Reparsed.Captures,Retained.Captures);EXPECT_EQ(Reparsed.ReceiverCaptures,Retained.ReceiverCaptures);
+ }
+}
