+      llvm::SmallString<128> USR;EXPECT_FALSE(index::generateUSRForDecl(Method,USR));Result.insert(USR.str().str());
+    }
+    return Result;
+  };
+  EXPECT_EQ(Methods(FromRecord).size(),2u);EXPECT_EQ(Methods(FromRecord),Methods(ToRecord));
