+static StringRef getDarwinIntMethodLookupName(unsigned CallArgCount, bool Super) {
+  static constexpr llvm::StringLiteral Names[][2] = {
+      {"objc3_darwin_lookup_v1", "objc3_darwin_lookup_super_v1"},
+      {"objc3_darwin_lookup_int_arg_v1", "objc3_darwin_lookup_super_int_arg_v1"},
+      {"objc3_darwin_lookup_two_int_args_v1",
+       "objc3_darwin_lookup_super_two_int_args_v1"}};
+  static_assert(std::size(Names) == std::size(DarwinIntMethodEncodings));
+  // The first two ABI arguments are the receiver and selector.
+  assert(CallArgCount >= 2 && CallArgCount - 2 < std::size(Names));
+  return Names[CallArgCount - 2][Super];
+}
+
+static bool isDarwinRegistrationMethod(ASTContext &Context,
+                                       const ObjCMethodDecl *Method) {
+  if (!Method || Method->isDirectMethod() || Method->isVariadic() ||
+      Method->param_size() >= std::size(DarwinIntMethodEncodings) ||
+      Method->hasAttr<NSConsumesSelfAttr>() ||
+      Method->getObjC3FunctionEffects().Async ||
+      Method->getObjC3FunctionEffects().AsyncFrame ||
+      Method->getObjC3FunctionEffects().Throws != ObjC3ThrowsKind::None ||
+      !Method->getReturnType()->isSpecificBuiltinType(BuiltinType::Int))
+    return false;
+  for (const ParmVarDecl *Param : Method->parameters())
+    if (!Param->getType()->isSpecificBuiltinType(BuiltinType::Int))
+      return false;
+  if (Context.getObjCEncodingForMethodDecl(Method) !=
+      DarwinIntMethodEncodings[Method->param_size()])
+    return false;
+  std::string Selector = Method->getSelector().getAsString();
+  return Selector != "load" && Selector != "initialize" && Selector != "alloc" &&
+         Selector != "new" && Selector != "dealloc" && Selector != "retain" &&
+         Selector != "release" && Selector != "autorelease" &&
+         Selector != "retainCount";
+}
