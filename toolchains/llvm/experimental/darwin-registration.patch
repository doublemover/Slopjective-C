+++ b/clang/lib/CodeGen/CGObjC3Darwin.h
@@ -0,0 +1,59 @@
+//===--- CGObjC3Darwin.h - Experimental owned Darwin runtime -----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_CODEGEN_CGOBJC3DARWIN_H
+#define LLVM_CLANG_LIB_CODEGEN_CGOBJC3DARWIN_H
+
+#include "CodeGenModule.h"
+#include "clang/AST/DeclObjC.h"
+#include "clang/AST/ObjC3TypeContracts.h"
+
+namespace clang::CodeGen {
+
+inline bool isObjC3DarwinRegistration(const CodeGenModule &CGM) {
+  return isObjC3DarwinRegistrationRuntime(CGM.getContext());
+}
+
+inline bool isObjC3DarwinARC(const CodeGenModule &CGM) {
+  return CGM.getLangOpts().ObjCAutoRefCount && isObjC3DarwinRegistration(CGM);
+}
+
+inline const ObjCIvarDecl *getDarwinFixedRootIvar(const ObjCInterfaceDecl *Class) {
+  if (Class->getSuperClass() || !Class->hasAttr<ObjCRootClassAttr>())
+    return nullptr;
+  const ObjCIvarDecl *Ivar = Class->all_declared_ivar_begin();
+  if (!Ivar || Ivar->getNextIvar() || Ivar->isBitField() || Ivar->hasAttrs() ||
+      Ivar->getType().hasQualifiers() ||
+      !Ivar->getType()->isSpecificBuiltinType(BuiltinType::Int))
+    return nullptr;
+  return Ivar;
+}
+
+// Managed storage uses an explicitly declared ISA word in its root. The
+// runtime resolves ivar offsets after all participating images register.
+inline const ObjCIvarDecl *
+getDarwinManagedLayoutIsa(const ObjCInterfaceDecl *Class) {
+  while (const auto *Super = Class->getSuperClass())
+    Class = Super;
+  const auto *Ivar = Class->all_declared_ivar_begin();
+  if (Ivar && Ivar->getIdentifier() && Ivar->getIdentifier()->isStr("isa") &&
+      Ivar->getType()->isObjCClassType() && !Ivar->isBitField() &&
+      Class->hasAttr<ObjCRootClassAttr>())
+    return Ivar;
+  return nullptr;
+}
+
+inline const llvm::StructLayout *getDarwinFixedRootLayout(CodeGenModule &CGM) {
+  auto *Type = llvm::StructType::get(
+      CGM.getLLVMContext(), {CGM.Int8PtrTy, CGM.Int32Ty});
+  return CGM.getDataLayout().getStructLayout(Type);
+}
+
+} // namespace clang::CodeGen
+
+#endif
