+static bool isObjC3DarwinRegistration(CodeGenModule &CGM) {
+  const auto &Runtime = CGM.getLangOpts().ObjCRuntime;
+  StringRef Arch = CGM.getTriple().getArchName();
+  return CGM.getLangOpts().ObjC3 && !CGM.getLangOpts().ObjCAutoRefCount &&
+         CGM.getTriple().isMacOSX() &&
+         (Arch == "arm64" || Arch == "aarch64") &&
+         Runtime.getKind() == ObjCRuntime::GNUstep &&
+         Runtime.getVersion() == VersionTuple(2, 99);
+}
+
+static bool isDarwinRegistrationMethod(const ObjCMethodDecl *Method) {
+  if (!Method || Method->isDirectMethod() ||
+      Method->isVariadic() || Method->param_size() ||
+      Method->getObjC3FunctionEffects().Async ||
+      !Method->getReturnType()->isSpecificBuiltinType(BuiltinType::Int))
+    return false;
+  std::string Selector = Method->getSelector().getAsString();
+  return Selector != "load" && Selector != "initialize" && Selector != "alloc" &&
+         Selector != "new" && Selector != "dealloc" && Selector != "retain" &&
+         Selector != "release" && Selector != "autorelease" &&
+         Selector != "retainCount";
+}
