{
  "schema": "objc3c.native-source-coverage-policy.v1",
  "host": "linux-x86_64",
  "compiler_profile": "compiler-source-coverage",
  "compile_flags": [
    "-fprofile-instr-generate",
    "-fcoverage-mapping",
    "-fprofile-update=atomic"
  ],
  "frontend_tests": [
    "objc3_compile_session",
    "objc3_interface_contract",
    "objc3_interface_emitter_coverage_0",
    "objc3_interface_emitter_coverage_1",
    "objc3_interface_emitter_coverage_2",
    "objc3_interface_emitter_coverage_3",
    "objc3_interface_emitter_coverage_4",
    "objc3_interface_emitter_coverage_5",
    "objc3_interface_emitter_coverage_6",
    "objc3_interface_emitter_coverage_7",
    "objc3_interface_import_api",
    "objc3_interface_module_resolution",
    "objc3_interface_artifact_io"
  ],
  "runtime_tests": [
    "objc3_task_services",
    "objc3_structured_runtime",
    "objc3_async_error_bridge",
    "objc3_keypath_service",
    "objc3_async_handle_join",
    "objc3_generic_collection_service",
    "objc3_generic_associative_service",
    "objc3_generic_collection_ownership"
  ],
  "test_timeouts_seconds": {
    "default": 120,
    "frontend:objc3_interface_emitter_coverage_0": 900,
    "frontend:objc3_interface_emitter_coverage_1": 900,
    "frontend:objc3_interface_emitter_coverage_2": 900,
    "frontend:objc3_interface_emitter_coverage_3": 900,
    "frontend:objc3_interface_emitter_coverage_4": 900,
    "frontend:objc3_interface_emitter_coverage_5": 900,
    "frontend:objc3_interface_emitter_coverage_6": 900,
    "frontend:objc3_interface_emitter_coverage_7": 900
  },
  "purpose": "Measured first-party and patched-compiler implementation coverage with separate denominators and patch-hunk views. No uncalibrated percentage threshold."
}
