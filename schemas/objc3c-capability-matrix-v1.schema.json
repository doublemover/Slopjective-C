{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-capability-matrix-v1.schema.json",
  "title": "objc3c Capability Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_version",
    "schema_path",
    "evidence_map_path",
    "states",
    "command_surface",
    "hard_cutover_rules",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "objc3c-capability-matrix-v1"
    },
    "matrix_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_path": {
      "type": "string",
      "const": "schemas/objc3c-capability-matrix-v1.schema.json"
    },
    "evidence_map_path": {
      "type": "string",
      "const": "docs/support/evidence_map.json"
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state"
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "command_surface": {
      "type": "object",
      "required": [
        "public_bridge",
        "action_owner",
        "public_command_pattern",
        "unsupported_public_surfaces"
      ],
      "properties": {
        "public_bridge": {
          "type": "string",
          "const": "npm run objc3c -- <action>"
        },
        "action_owner": {
          "type": "string",
          "const": "scripts/objc3c_workflow/action_catalog.py"
        },
        "public_command_pattern": {
          "type": "string",
          "const": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "unsupported_public_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "hard_cutover_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "state": {
      "enum": [
        "implemented",
        "rejected",
        "reserved",
        "internal"
      ]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "supportClaim": {
      "type": "string",
      "pattern": "^objc3c\\.behavior\\.[a-z0-9._-]+$"
    },
    "publicCommand": {
      "type": "string",
      "description": "Optional public workflow command for replaying this evidence. Capability truth surfaces may only advertise the npm objc3c bridge.",
      "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
    },
    "evidenceKind": {
      "enum": [
        "test",
        "diagnostic",
        "doc",
        "schema",
        "source"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidenceKind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/publicCommand"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "title",
        "state",
        "summary",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "support_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportClaim"
          },
          "uniqueItems": true
        },
        "owner_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
