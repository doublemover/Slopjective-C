{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-public-command-contract-v1.schema.json",
  "title": "Objective-C 3 Public Command Contract v1",
  "x-objc3c-artifact-contract": {
    "schema_id": "objc3c-public-command-contract-v1",
    "payload_id_field": "contract_id",
    "payload_id_value": "objc3c-public-command-contract-v1",
    "registry_owner": "native/objc3c/src/artifacts/json/artifact_schema_contract_table.cpp",
    "artifact_family": "public-command-contract"
  },
  "type": "object",
  "required": [
    "contract_id",
    "issue",
    "runner_mode",
    "runner_path",
    "package_bridge_count",
    "workflow_action_count",
    "internal_action_count",
    "operator_action_count",
    "maintainer_action_count",
    "missing_package_bridge",
    "unexpected_package_bridges",
    "actions",
    "package_bridges"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "objc3c-public-command-contract-v1"
    },
    "issue": {
      "type": "string"
    },
    "runner_mode": {
      "type": "string"
    },
    "runner_path": {
      "type": "string"
    },
    "package_bridge_count": {
      "type": "integer",
      "minimum": 0
    },
    "workflow_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "internal_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "operator_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "maintainer_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "missing_package_bridge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unexpected_package_bridges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "package_bridges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package_bridge"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "action",
        "command",
        "summary",
        "backend",
        "implementation_anchor",
        "pass_through_args",
        "mode",
        "runner_path",
        "category"
      ],
      "properties": {
        "action": { "type": "string" },
        "command": {
          "type": "string",
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "summary": { "type": "string" },
        "backend": {
          "type": "string",
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "implementation_anchor": { "type": "string" },
        "validation_tier": { "type": "string" },
        "guarantee_owner": { "type": "string" },
        "pass_through_args": { "type": "boolean" },
        "mode": { "type": "string" },
        "runner_path": { "type": "string" },
        "audience": {
          "type": "string",
          "enum": ["operator", "maintainer", "internal"]
        },
        "category": { "type": "string" }
      },
      "additionalProperties": false
    },
    "package_bridge": {
      "type": "object",
      "required": [
        "package_bridge",
        "action",
        "command",
        "summary",
        "audience",
        "category",
        "backend",
        "runner_path"
      ],
      "properties": {
        "package_bridge": { "type": "string" },
        "action": { "type": "string" },
        "summary": { "type": "string" },
        "audience": {
          "type": "string",
          "enum": ["operator", "maintainer", "internal"]
        },
        "category": { "type": "string" },
        "backend": {
          "type": "string",
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "command": {
          "type": "string",
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "validation_tier": { "type": "string" },
        "guarantee_owner": { "type": "string" },
        "pass_through_args": { "type": "boolean" },
        "mode": { "type": "string" },
        "runner_path": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
