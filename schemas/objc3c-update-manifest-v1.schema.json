{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-update-manifest-v1.schema.json",
  "title": "objc3c Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "generated_at_utc",
    "current_version",
    "default_channel",
    "default_platform_id",
    "platform_support_matrix",
    "supported_platform_ids",
    "support_tiers",
    "channels",
    "upgrade_support_report"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.release.operations.update-manifest.v1" },
    "generated_at_utc": { "type": "string" },
    "current_version": { "type": "string" },
    "default_channel": { "type": "string" },
    "default_platform_id": { "type": "string" },
    "platform_support_matrix": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "version", "support_status", "artifacts"],
        "properties": {
          "channel_id": { "type": "string" },
          "version": { "type": "string" },
          "support_status": { "enum": ["supported", "preview", "deprecated", "blocked"] },
          "artifacts": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "upgrade_support_report": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
