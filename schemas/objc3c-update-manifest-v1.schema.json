{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-update-manifest-v1.schema.json",
  "title": "objc3c Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "generated_at_utc",
    "current_version",
    "default_channel",
    "default_platform_id",
    "supported_major_line",
    "package_model",
    "platform_support_matrix",
    "platform_support_summary",
    "supported_platform_ids",
    "support_tiers",
    "channels",
    "release_channel_manifest",
    "local_provenance",
    "release_evidence",
    "upgrade_paths",
    "upgrade_support_report"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.release.operations.update-manifest.v1" },
    "generated_at_utc": { "type": "string" },
    "current_version": { "type": "string" },
    "default_channel": { "type": "string" },
    "default_platform_id": { "type": "string" },
    "supported_major_line": { "type": "integer", "minimum": 0 },
    "package_model": { "type": "string", "minLength": 1 },
    "platform_support_matrix": { "type": "string" },
    "platform_support_summary": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "version",
          "support_status",
          "warning_classes",
          "upgrade_targets",
          "artifacts"
        ],
        "properties": {
          "channel_id": { "type": "string" },
          "version": { "type": "string" },
          "support_status": {
            "enum": ["supported", "release-drill", "nightly", "preview", "deprecated", "blocked"]
          },
          "warning_classes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "upgrade_targets": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "portable_archive",
              "installer_archive",
              "offline_archive",
              "installer_signature",
              "package_channels_manifest",
              "release_manifest",
              "platform_support_matrix"
            ],
            "properties": {
              "portable_archive": { "type": "string" },
              "installer_archive": { "type": "string" },
              "offline_archive": { "type": "string" },
              "installer_signature": { "$ref": "#/$defs/installerSignature" },
              "package_channels_manifest": { "type": "string" },
              "release_manifest": { "type": "string" },
              "platform_support_matrix": { "type": "string" }
            }
          }
        }
      }
    },
    "release_channel_manifest": { "type": "string", "minLength": 1 },
    "local_provenance": { "$ref": "#/$defs/localProvenance" },
    "release_evidence": { "$ref": "#/$defs/releaseEvidence" },
    "upgrade_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/upgradePath" },
      "minItems": 1
    },
    "upgrade_support_report": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "installerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_format",
        "signing_key_id",
        "subject",
        "artifact",
        "sha256",
        "verification_command",
        "trust_scope"
      ],
      "properties": {
        "signature_format": { "const": "objc3c-local-sha256-v1" },
        "signing_key_id": { "const": "objc3c-release-operations-local-installer-key-v1" },
        "subject": { "const": "local-installer" },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_command": { "const": "npm run objc3c -- validate-packaging-channels-end-to-end" },
        "trust_scope": { "const": "checked-in-artifact-digest" }
      }
    },
    "localProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_manifest",
        "release_manifest_sha256",
        "package_channels_manifest",
        "package_channels_manifest_sha256",
        "release_payload_digest_sha256",
        "package_model",
        "git_commit",
        "git_tree_dirty",
        "artifact_digests",
        "installer_signature",
        "platform_support_matrix",
        "platform_support_summary",
        "source_policy_paths"
      ],
      "properties": {
        "release_manifest": { "type": "string", "minLength": 1 },
        "release_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "package_channels_manifest": { "type": "string", "minLength": 1 },
        "package_channels_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "release_payload_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "package_model": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "minLength": 1 },
        "git_tree_dirty": { "type": "boolean" },
        "artifact_digests": { "type": "object" },
        "installer_signature": { "$ref": "#/$defs/installerSignature" },
        "platform_support_matrix": { "type": "string", "minLength": 1 },
        "platform_support_summary": { "type": "string", "minLength": 1 },
        "source_policy_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_note_sources",
        "public_changelog_sources",
        "evidence_artifacts",
        "replayable_public_commands"
      ],
      "properties": {
        "release_note_sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "public_changelog_sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "evidence_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "replayable_public_commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "upgradePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "from",
        "to",
        "upgrade_contract",
        "requires_warning",
        "revert_channel"
      ],
      "properties": {
        "path_id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "upgrade_contract": { "type": "string" },
        "requires_warning": { "type": "boolean" },
        "revert_channel": { "type": "string" }
      }
    }
  }
}
