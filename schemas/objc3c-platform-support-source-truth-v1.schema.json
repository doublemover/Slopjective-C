{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-platform-support-source-truth-v1.schema.json",
  "title": "objc3c Platform Support Source Truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "issue",
    "schema_path",
    "source_path",
    "roadmap_issue_refs",
    "upstream_sources",
    "claim_policy",
    "host_promotion_architecture",
    "required_supported_evidence_classes",
    "required_auxiliary_evidence_classes",
    "required_toolchain_components",
    "supported_rows",
    "unsupported_rows",
    "package_variant_rows",
    "sanitizer_variant_rows",
    "umbrella_readiness_contract",
    "report_policy"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.platform.support.source_truth.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "issue": {
      "const": "OBJ3-NEXT-024"
    },
    "schema_path": {
      "const": "schemas/objc3c-platform-support-source-truth-v1.schema.json"
    },
    "source_path": {
      "const": "tests/tooling/fixtures/platform_support/source_truth_matrix.json"
    },
    "roadmap_issue_refs": {
      "type": "array",
      "items": {
        "type": "integer",
        "enum": [
          8206,
          8228,
          8229,
          8230,
          8231,
          8232
        ]
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "upstream_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_platforms",
        "platform_toolchain_support_evidence",
        "unsupported_host_policy"
      ],
      "properties": {
        "supported_platforms": {
          "type": "string"
        },
        "platform_toolchain_support_evidence": {
          "type": "string"
        },
        "unsupported_host_policy": {
          "type": "string"
        }
      }
    },
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_rows_require_checked_source",
        "support_claims_require_live_network",
        "generated_reports_are_source_truth",
        "unsupported_host_result",
        "unsupported_toolchain_result",
        "toolchain_range_policy"
      ],
      "properties": {
        "supported_rows_require_checked_source": {
          "const": true
        },
        "support_claims_require_live_network": {
          "const": false
        },
        "generated_reports_are_source_truth": {
          "const": false
        },
        "unsupported_host_result": {
          "const": "fail-closed"
        },
        "unsupported_toolchain_result": {
          "const": "fail-closed-no-range-claim"
        },
        "toolchain_range_policy": {
          "const": "current-probed-executable-only"
        }
      }
    },
    "host_promotion_architecture": {
      "$ref": "#/$defs/hostPromotionArchitecture"
    },
    "required_supported_evidence_classes": {
      "type": "array",
      "items": {
        "enum": [
          "build",
          "package",
          "install",
          "execution"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "required_auxiliary_evidence_classes": {
      "type": "array",
      "items": {
        "enum": [
          "toolchain",
          "hosted_ci",
          "clean_room"
        ]
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "required_toolchain_components": {
      "type": "array",
      "items": {
        "enum": [
          "llvm",
          "clang",
          "cmake",
          "ninja",
          "python",
          "node",
          "pwsh"
        ]
      },
      "minItems": 7,
      "uniqueItems": true
    },
    "supported_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/supportedRow"
      }
    },
    "unsupported_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unsupportedRow"
      }
    },
    "package_variant_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/packageVariantRow"
      }
    },
    "sanitizer_variant_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sanitizerVariantRow"
      }
    },
    "umbrella_readiness_contract": {
      "$ref": "#/$defs/umbrellaReadinessContract"
    },
    "report_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "generated_reports_must_not_be_source"
      ],
      "properties": {
        "summary_path": {
          "type": "string",
          "pattern": "^tmp/reports/platform-hardening/"
        },
        "generated_reports_must_not_be_source": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hostPromotionArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "promotion_policy",
        "source_evidence_sections",
        "supported_platform_ids",
        "unsupported_platform_ids",
        "host_identity_record_ids",
        "toolchain_probe_record_ids",
        "package_root_record_ids",
        "native_execution_record_ids",
        "negative_host_toolchain_case_ids",
        "diagnostic"
      ],
      "properties": {
        "contract_id": {
          "const": "objc3c.platform.support.host-promotion.source-truth.v1"
        },
        "promotion_policy": {
          "const": "real-host-execution-required"
        },
        "source_evidence_sections": {
          "$ref": "#/$defs/stringArray"
        },
        "supported_platform_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "unsupported_platform_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "host_identity_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "toolchain_probe_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "package_root_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "native_execution_record_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "negative_host_toolchain_case_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^objc3c\\.evidence\\."
    },
    "publicReplayCommand": {
      "type": "string",
      "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*( .*)?$"
    },
    "umbrellaReadinessContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "umbrella_issue_ref",
        "closure_state",
        "support_claim_boundary",
        "supported_platform_row_ids",
        "child_issue_contracts",
        "native_object_emission_contract",
        "forbidden_overclaims",
        "lead_projection_rule"
      ],
      "properties": {
        "umbrella_issue_ref": {
          "const": 8206
        },
        "closure_state": {
          "const": "source-owned-fail-closed-ready"
        },
        "support_claim_boundary": {
          "const": "windows-x64-only"
        },
        "supported_platform_row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "child_issue_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childIssueContract"
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "native_object_emission_contract": {
          "$ref": "#/$defs/nativeObjectEmissionContract"
        },
        "forbidden_overclaims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "lead_projection_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "childIssueContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_ref",
        "row_id",
        "contract_kind",
        "claim_state",
        "required_promotion_evidence",
        "diagnostic"
      ],
      "properties": {
        "issue_ref": {
          "type": "integer",
          "enum": [
            8228,
            8229,
            8230,
            8231,
            8232
          ]
        },
        "row_id": {
          "type": "string"
        },
        "contract_kind": {
          "enum": [
            "platform-host",
            "sanitizer-runtime-package",
            "native-object-emission"
          ]
        },
        "claim_state": {
          "enum": [
            "unsupported",
            "reserved",
            "toolchain-prerequisite-fail-closed"
          ]
        },
        "required_promotion_evidence": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution",
              "toolchain",
              "native-object-emission"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nativeObjectEmissionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "issue_ref",
        "required_tool",
        "required_probe",
        "success_status",
        "missing_llc_status",
        "missing_filetype_status",
        "mixed_toolchain_status",
        "mismatched_version_status",
        "unsupported_version_status",
        "unresolved_version_status",
        "hosted_runner_behavior",
        "conformance_minima_behavior",
        "fallback_policy",
        "coherent_toolchain_policy"
      ],
      "properties": {
        "contract_id": {
          "const": "objc3c.llvm.native-object-emission.fail-closed.v1"
        },
        "issue_ref": {
          "const": 8232
        },
        "required_tool": {
          "const": "llc"
        },
        "required_probe": {
          "const": "llc --filetype=obj"
        },
        "success_status": {
          "const": "native_object_emission_supported"
        },
        "missing_llc_status": {
          "const": "native_object_emission_missing_llc"
        },
        "missing_filetype_status": {
          "const": "native_object_emission_filetype_obj_unavailable"
        },
        "mixed_toolchain_status": {
          "const": "native_object_emission_mixed_toolchain_root"
        },
        "mismatched_version_status": {
          "const": "native_object_emission_mismatched_tool_versions"
        },
        "unsupported_version_status": {
          "const": "native_object_emission_unsupported_tool_version"
        },
        "unresolved_version_status": {
          "const": "native_object_emission_unresolved_tool_version"
        },
        "hosted_runner_behavior": {
          "const": "fail-closed-no-native-object-success-claim"
        },
        "conformance_minima_behavior": {
          "const": "fail-closed-before-cross-lane-runtime-proof"
        },
        "fallback_policy": {
          "const": "no-clang-fallback-success-claim"
        },
        "coherent_toolchain_policy": {
          "const": "no-mixed-root-or-mismatched-version-success-claim"
        }
      }
    },
    "supportedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "platform_id",
        "host_os",
        "host_arch",
        "host_triples",
        "support_state",
        "issue_ref",
        "required_evidence",
        "package_variant_row_ids",
        "toolchain_evidence_ids",
        "hosted_ci_evidence_ids",
        "local_clean_room_evidence_ids",
        "public_replay_commands",
        "diagnostic"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "host_arch": {
          "type": "string"
        },
        "host_triples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "support_state": {
          "const": "supported"
        },
        "issue_ref": {
          "type": "integer"
        },
        "required_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "package",
            "install",
            "execution"
          ],
          "properties": {
            "build": {
              "$ref": "#/$defs/evidenceId"
            },
            "package": {
              "$ref": "#/$defs/evidenceId"
            },
            "install": {
              "$ref": "#/$defs/evidenceId"
            },
            "execution": {
              "$ref": "#/$defs/evidenceId"
            }
          }
        },
        "package_variant_row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "toolchain_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "hosted_ci_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "local_clean_room_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "public_replay_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicReplayCommand"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsupportedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "platform_id",
        "host_os",
        "host_arch",
        "host_triples",
        "support_state",
        "issue_ref",
        "required_evidence_classes",
        "required_missing_evidence_classes",
        "required_toolchain_components",
        "failure_id",
        "fail_closed_evidence_id",
        "package_variant_row_ids",
        "public_replay_commands",
        "diagnostic"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "host_arch": {
          "type": "string"
        },
        "host_triples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "support_state": {
          "const": "unsupported"
        },
        "issue_ref": {
          "type": "integer"
        },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "required_missing_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "required_toolchain_components": {
          "type": "array",
          "items": {
            "enum": [
              "llvm",
              "clang",
              "cmake",
              "ninja",
              "python",
              "node",
              "pwsh"
            ]
          },
          "minItems": 7,
          "uniqueItems": true
        },
        "failure_id": {
          "type": "string",
          "pattern": "^unsupported-host-"
        },
        "fail_closed_evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "package_variant_row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "public_replay_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicReplayCommand"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packageVariantRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "issue_ref",
        "variant_kind",
        "target_platform_id",
        "platform_ids",
        "package_id",
        "runtime_library_contract",
        "metadata_freshness_guard",
        "artifact_identity_contract",
        "promotion_gate_contract",
        "claim_state",
        "required_evidence_classes",
        "required_missing_evidence_classes",
        "evidence_ids",
        "unsupported_behavior",
        "diagnostic"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "issue_ref": {
          "type": "integer"
        },
        "variant_kind": {
          "enum": [
            "release-runtime",
            "sanitizer-runtime"
          ]
        },
        "target_platform_id": {
          "type": "string"
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "package_id": {
          "type": "string"
        },
        "runtime_library_contract": {
          "$ref": "#/$defs/runtimeLibraryContract"
        },
        "metadata_freshness_guard": {
          "$ref": "#/$defs/metadataFreshnessGuard"
        },
        "artifact_identity_contract": {
          "$ref": "#/$defs/packageArtifactIdentityContract"
        },
        "promotion_gate_contract": {
          "$ref": "#/$defs/packagePromotionGateContract"
        },
        "claim_state": {
          "enum": [
            "evidence-bound",
            "fail-closed",
            "reserved"
          ]
        },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_missing_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "unsupported_behavior": {
          "const": "fail-closed"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "sanitizerVariantRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "issue_ref",
        "sanitizer",
        "claim_state",
        "platform_ids",
        "package_variant_row_id",
        "package_id",
        "runtime_requirement",
        "metadata_freshness_guard",
        "install_guard",
        "package_runtime_contract",
        "required_promotion_evidence",
        "required_missing_evidence_classes",
        "diagnostic"
      ],
      "properties": {
        "variant_id": {
          "type": "string"
        },
        "issue_ref": {
          "type": "integer"
        },
        "sanitizer": {
          "enum": [
            "address",
            "undefined"
          ]
        },
        "claim_state": {
          "enum": [
            "reserved",
            "evidence-bound"
          ]
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "package_variant_row_id": {
          "type": "string"
        },
        "package_id": {
          "type": "string"
        },
        "runtime_requirement": {
          "type": "string"
        },
        "metadata_freshness_guard": {
          "$ref": "#/$defs/metadataFreshnessGuard"
        },
        "install_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_channel_policy",
            "unsupported_platform_behavior",
            "missing_runtime_behavior",
            "mixed_runtime_behavior",
            "stale_package_metadata_behavior"
          ],
          "properties": {
            "release_channel_policy": {
              "type": "string"
            },
            "unsupported_platform_behavior": {
              "const": "fail-closed"
            },
            "missing_runtime_behavior": {
              "const": "fail-closed-before-package-install"
            },
            "mixed_runtime_behavior": {
              "const": "fail-closed"
            },
            "stale_package_metadata_behavior": {
              "const": "fail-closed-before-publication"
            }
          }
        },
        "package_runtime_contract": {
          "$ref": "#/$defs/sanitizerPackageRuntimeContract"
        },
        "required_promotion_evidence": {
          "type": "array",
          "items": {
            "enum": [
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "required_missing_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "packageArtifactIdentityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_name_suffix",
        "object_format",
        "debug_format",
        "runtime_library_names",
        "loader_path_policy",
        "package_root_layout",
        "symbol_export_policy"
      ],
      "properties": {
        "archive_name_suffix": {
          "type": "string",
          "minLength": 1
        },
        "object_format": {
          "type": "string",
          "minLength": 1
        },
        "debug_format": {
          "type": "string",
          "minLength": 1
        },
        "runtime_library_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "loader_path_policy": {
          "type": "string",
          "minLength": 1
        },
        "package_root_layout": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "symbol_export_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packagePromotionGateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_source",
        "required_positive_evidence_classes",
        "blocked_until_evidence_classes",
        "blocked_publication_surfaces",
        "source_only_metadata_behavior",
        "hosted_runner_summary_behavior"
      ],
      "properties": {
        "promotion_source": {
          "const": "checked-in-package-variant-row"
        },
        "required_positive_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "blocked_until_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "uniqueItems": true
        },
        "blocked_publication_surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "package",
              "install",
              "execution",
              "publication"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_only_metadata_behavior": {
          "const": "fail-closed-before-publication"
        },
        "hosted_runner_summary_behavior": {
          "const": "summary-only-no-support-promotion"
        }
      }
    },
    "sanitizerPackageRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_probe_required",
        "runtime_library_resolution",
        "default_release_channel_allowed",
        "report_artifact_support_truth",
        "mixed_release_sanitizer_runtime_behavior",
        "release_runtime_package_ids",
        "release_runtime_mixing_allowed",
        "expected_detection_records",
        "unsupported_host_diagnostics",
        "required_metadata_fields"
      ],
      "properties": {
        "runtime_probe_required": {
          "const": true
        },
        "runtime_library_resolution": {
          "type": "string",
          "minLength": 1
        },
        "default_release_channel_allowed": {
          "const": false
        },
        "report_artifact_support_truth": {
          "const": false
        },
        "mixed_release_sanitizer_runtime_behavior": {
          "const": "fail-closed"
        },
        "release_runtime_package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "release_runtime_mixing_allowed": {
          "const": false
        },
        "expected_detection_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "record_kind",
              "required_behavior",
              "support_truth"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "record_kind": {
                "type": "string",
                "minLength": 1
              },
              "required_behavior": {
                "const": "record-only-no-support-promotion"
              },
              "support_truth": {
                "const": false
              }
            }
          }
        },
        "unsupported_host_diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "diagnostic_id",
              "failure_class",
              "required_behavior",
              "blocks"
            ],
            "properties": {
              "diagnostic_id": {
                "type": "string",
                "minLength": 1
              },
              "failure_class": {
                "const": "unsupported-sanitizer-platform"
              },
              "required_behavior": {
                "const": "fail-closed-before-capability-promotion"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "enum": [
                    "package",
                    "install",
                    "execution",
                    "publication"
                  ]
                },
                "minItems": 4,
                "uniqueItems": true
              }
            }
          }
        },
        "required_metadata_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "uniqueItems": true
        }
      }
    },
    "runtimeLibraryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_library_ids",
        "missing_runtime_behavior",
        "mixed_runtime_behavior"
      ],
      "properties": {
        "runtime_library_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "missing_runtime_behavior": {
          "enum": [
            "fail-closed-before-native-execution-claim",
            "fail-closed-before-package-install"
          ]
        },
        "mixed_runtime_behavior": {
          "const": "fail-closed"
        }
      }
    },
    "metadataFreshnessGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_source",
        "generated_metadata_allowed",
        "stale_package_metadata_behavior",
        "blocks_publication_on_stale"
      ],
      "properties": {
        "metadata_source": {
          "type": "string",
          "pattern": "^(tests/tooling/fixtures|schemas|docs/runbooks)/"
        },
        "generated_metadata_allowed": {
          "const": false
        },
        "stale_package_metadata_behavior": {
          "const": "fail-closed-before-publication"
        },
        "blocks_publication_on_stale": {
          "const": true
        }
      }
    }
  }
}
