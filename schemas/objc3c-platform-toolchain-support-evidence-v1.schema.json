{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-platform-toolchain-support-evidence-v1.schema.json",
  "title": "objc3c Platform And Toolchain Support Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "issue",
    "schema_path",
    "source_path",
    "roadmap_issue_refs",
    "owner_policy",
    "network_policy",
    "support_rows",
    "toolchain_evidence_requirements",
    "toolchain_ranges",
    "llvm_version_support_matrix",
    "package_variant_rows",
    "sanitizer_variants",
    "evidence_records"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.platform.toolchain.support.evidence.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "issue": {
      "const": "OBJ3-NEXT-024"
    },
    "schema_path": {
      "const": "schemas/objc3c-platform-toolchain-support-evidence-v1.schema.json"
    },
    "source_path": {
      "const": "tests/tooling/fixtures/platform_hardening/platform_toolchain_support_evidence.json"
    },
    "roadmap_issue_refs": {
      "type": "array",
      "items": {
        "type": "integer",
        "enum": [
          8206,
          8228,
          8229,
          8230,
          8231,
          8232
        ]
      },
      "minItems": 5,
      "uniqueItems": true
    },
    "owner_policy": {
      "type": "object"
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_claims_require_live_network",
        "network_unavailable_result",
        "unsupported_host_result"
      ],
      "properties": {
        "support_claims_require_live_network": {
          "type": "boolean"
        },
        "network_unavailable_result": {
          "const": "skip-no-support-claim"
        },
        "unsupported_host_result": {
          "const": "fail-closed"
        }
      }
    },
    "support_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/supportRow"
      }
    },
    "toolchain_evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_components",
        "support_claim_policy",
        "unsupported_component_behavior"
      ],
      "properties": {
        "required_components": {
          "type": "array",
          "items": {
            "enum": [
              "llvm",
              "clang",
              "cmake",
              "ninja",
              "python",
              "node",
              "pwsh"
            ]
          },
          "minItems": 7,
          "uniqueItems": true
        },
        "support_claim_policy": {
          "const": "evidence-bound-current-probes-only"
        },
        "unsupported_component_behavior": {
          "const": "fail-closed-no-range-claim"
        }
      }
    },
    "toolchain_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolchainRange"
      }
    },
    "llvm_version_support_matrix": {
      "$ref": "#/$defs/llvmVersionSupportMatrix"
    },
    "package_variant_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/packageVariantRow"
      }
    },
    "sanitizer_variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sanitizerVariant"
      }
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRecord"
      }
    }
  },
  "$defs": {
    "supportRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "platform_id",
        "host_os",
        "host_arch",
        "support_state",
        "claim_class",
        "tier_id",
        "evidence",
        "issue_ref",
        "package_variant_row_ids",
        "diagnostic"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "host_arch": {
          "type": "string"
        },
        "support_state": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "claim_class": {
          "enum": [
            "supported",
            "fail-closed"
          ]
        },
        "tier_id": {
          "type": "string"
        },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          }
        },
        "required_toolchain_components": {
          "type": "array",
          "items": {
            "enum": [
              "llvm",
              "clang",
              "cmake",
              "ninja",
              "python",
              "node",
              "pwsh"
            ]
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "issue_ref": {
          "type": "integer"
        },
        "package_variant_row_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "negative_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negativeContract"
          }
        },
        "toolchain_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hosted_ci_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "local_clean_room_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_id": {
          "type": "string"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "llvmVersionSupportMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "issue_ref",
        "support_claim_policy",
        "minimum_supported_version",
        "known_good_versions",
        "known_bad_versions",
        "required_tools",
        "matrix_entries",
        "rejection_rules"
      ],
      "properties": {
        "contract_id": {
          "const": "objc3c.llvm.version-support-matrix.source.v1"
        },
        "issue_ref": {
          "const": 8232
        },
        "support_claim_policy": {
          "const": "capability-probed-fail-closed"
        },
        "minimum_supported_version": {
          "type": "string"
        },
        "known_good_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_bad_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_tools": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/llvmRequiredTool"
          }
        },
        "matrix_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/llvmMatrixEntry"
          }
        },
        "rejection_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/llvmRejectionRule"
          }
        }
      }
    },
    "llvmRequiredTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "capability",
        "claim_state",
        "version_source",
        "failure_behavior"
      ],
      "properties": {
        "tool_name": {
          "enum": [
            "clang",
            "clang++",
            "llc",
            "llvm-ar",
            "llvm-config",
            "headers-libs"
          ]
        },
        "capability": {
          "type": "string"
        },
        "claim_state": {
          "enum": [
            "required",
            "reserved"
          ]
        },
        "version_source": {
          "enum": [
            "probe",
            "native-build-resolution",
            "reserved"
          ]
        },
        "failure_behavior": {
          "const": "fail-closed-before-support-claim"
        }
      }
    },
    "llvmMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "platform_id",
        "llvm_version_claim",
        "support_status",
        "object_emission_capability",
        "package_capability",
        "native_execution_capability",
        "evidence_ids",
        "unsupported_version_behavior"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "llvm_version_claim": {
          "type": "string"
        },
        "support_status": {
          "enum": [
            "evidence-bound",
            "reserved"
          ]
        },
        "object_emission_capability": {
          "enum": [
            "supported",
            "reserved"
          ]
        },
        "package_capability": {
          "enum": [
            "supported",
            "reserved"
          ]
        },
        "native_execution_capability": {
          "enum": [
            "supported",
            "reserved"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_version_behavior": {
          "const": "fail-closed-no-range-claim"
        }
      }
    },
    "llvmRejectionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "condition",
        "diagnostic"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "toolchainRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain_id",
        "component",
        "platform_ids",
        "claim_state",
        "range_claim",
        "required_evidence_classes",
        "evidence_ids",
        "unsupported_version_behavior"
      ],
      "properties": {
        "toolchain_id": {
          "type": "string"
        },
        "component": {
          "enum": [
            "llvm",
            "clang",
            "cmake",
            "ninja",
            "python",
            "node",
            "pwsh"
          ]
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_state": {
          "enum": [
            "evidence-bound",
            "reserved"
          ]
        },
        "range_claim": {
          "type": "string"
        },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "const": "toolchain"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_version_behavior": {
          "const": "fail-closed-no-range-claim"
        },
        "source_owner": {
          "type": "string"
        },
        "unsupported_contract_id": {
          "type": "string"
        }
      }
    },
    "packageVariantRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "issue_ref",
        "variant_kind",
        "target_platform_id",
        "platform_ids",
        "package_id",
        "claim_state",
        "channel_scope",
        "required_evidence_classes",
        "evidence_ids",
        "unsupported_behavior",
        "diagnostic"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "issue_ref": {
          "type": "integer"
        },
        "variant_kind": {
          "enum": [
            "release-runtime",
            "sanitizer-runtime"
          ]
        },
        "target_platform_id": {
          "type": "string"
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "package_id": {
          "type": "string"
        },
        "claim_state": {
          "enum": [
            "evidence-bound",
            "fail-closed",
            "reserved"
          ]
        },
        "channel_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_missing_evidence_classes": {
          "type": "array",
          "items": {
            "enum": [
              "build",
              "package",
              "install",
              "execution"
            ]
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_behavior": {
          "const": "fail-closed"
        },
        "negative_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negativeContract"
          }
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "sanitizerVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "issue_ref",
        "sanitizer",
        "claim_state",
        "platform_ids",
        "package_variant_row_id",
        "package_id",
        "llvm_requirement",
        "runtime_requirement",
        "build_contract",
        "install_guard",
        "evidence_ids",
        "diagnostic"
      ],
      "properties": {
        "variant_id": {
          "type": "string"
        },
        "issue_ref": {
          "type": "integer"
        },
        "sanitizer": {
          "enum": [
            "address",
            "undefined"
          ]
        },
        "claim_state": {
          "enum": [
            "reserved",
            "evidence-bound"
          ]
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_variant_row_id": {
          "type": "string"
        },
        "package_id": {
          "type": "string"
        },
        "llvm_requirement": {
          "type": "string"
        },
        "runtime_requirement": {
          "type": "string"
        },
        "build_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compiler_flags",
            "linker_flags",
            "environment_requirements"
          ],
          "properties": {
            "compiler_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "linker_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "environment_requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string"
            },
            "suppression_policy": {
              "type": "string"
            }
          }
        },
        "install_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_channel_policy",
            "unsupported_platform_behavior",
            "mixed_runtime_behavior"
          ],
          "properties": {
            "release_channel_policy": {
              "type": "string"
            },
            "unsupported_platform_behavior": {
              "const": "fail-closed"
            },
            "mixed_runtime_behavior": {
              "const": "fail-closed"
            }
          }
        },
        "diagnostic": {
          "type": "string"
        },
        "negative_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negativeContract"
          }
        }
      }
    },
    "negativeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "failure_class",
        "required_behavior",
        "source_owner"
      ],
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "failure_class": {
          "type": "string"
        },
        "required_behavior": {
          "type": "string"
        },
        "source_owner": {
          "type": "string"
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_class",
        "claim_weight",
        "source_paths",
        "replay_commands",
        "generated_report_paths",
        "supports_platform_ids",
        "requires_network",
        "unsupported_host_behavior"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "issue_refs": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "evidence_class": {
          "enum": [
            "build",
            "package",
            "install",
            "execution",
            "toolchain",
            "hosted_ci",
            "clean_room",
            "fail_closed",
            "sanitizer_policy"
          ]
        },
        "claim_weight": {
          "enum": [
            "supporting",
            "policy"
          ]
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_report_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_network": {
          "type": "boolean"
        },
        "unsupported_host_behavior": {
          "enum": [
            "fail-closed",
            "not-applicable"
          ]
        }
      }
    }
  }
}
