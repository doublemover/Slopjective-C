{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-install-receipt-v1.schema.json",
  "title": "objc3c Package Install Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "install_root",
    "install_home",
    "channel_id",
    "bootstrap_entrypoint",
    "package_bridge",
    "install_command",
    "payload_manifest",
    "payload_manifest_sha256",
    "payload_required_entries",
    "installed_at_utc"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.packaging.channels.install-receipt.v1" },
    "install_root": { "type": "string" },
    "install_home": { "type": "string" },
    "channel_id": { "enum": ["local-installer", "offline-bundle"] },
    "bootstrap_entrypoint": { "type": "string" },
    "package_bridge": { "const": "objc3c" },
    "install_command": {
      "type": "string",
      "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
    },
    "payload_manifest": {
      "const": "artifacts/package/objc3c-runnable-toolchain-package.json"
    },
    "payload_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_required_entries": {
      "type": "array",
      "items": {
        "enum": [
          "artifacts/package/objc3c-runnable-toolchain-package.json",
          "artifacts/bin/objc3c-native.exe",
          "artifacts/lib/objc3_runtime.lib",
          "stdlib/workspace.json",
          "stdlib/modules/objc3.core/module.json",
          "docs/runbooks/objc3c_packaging_channels.md",
          "share/objc3c/sanitizer/asan-metadata.json",
          "share/objc3c/sanitizer/ubsan-metadata.json"
        ]
      },
      "minItems": 1
    },
    "sanitizer_package_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_variant_row_id",
        "package_channel_id",
        "target_platform_id",
        "sanitizer",
        "runtime_library_ids",
        "metadata_manifest_path",
        "metadata_digest",
        "selected_runtime_variant",
        "install_selector",
        "native_execution_contract",
        "support_truth",
        "native_execution_claimed"
      ],
      "properties": {
        "package_id": {
          "enum": [
            "org.objc3c.runtime:objc3c-runtime-asan",
            "org.objc3c.runtime:objc3c-runtime-ubsan"
          ]
        },
        "package_variant_row_id": {
          "enum": [
            "objc3c.package.sanitizer.asan.reserved",
            "objc3c.package.sanitizer.ubsan.reserved"
          ]
        },
        "package_channel_id": {
          "enum": [
            "windows-x64-sanitizer-asan",
            "windows-x64-sanitizer-ubsan"
          ]
        },
        "target_platform_id": { "type": "string", "minLength": 1 },
        "sanitizer": { "enum": ["address", "undefined"] },
        "runtime_library_ids": {
          "type": "array",
          "items": {
            "enum": ["objc3-runtime", "clang_rt.asan", "clang_rt.ubsan"]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "metadata_manifest_path": {
          "type": "string",
          "pattern": "^share/objc3c/sanitizer/(asan|ubsan)-metadata\\.json$"
        },
        "metadata_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "selected_runtime_variant": {
          "enum": ["sanitizer=address", "sanitizer=undefined"]
        },
        "install_selector": {
          "enum": ["sanitizer=address", "sanitizer=undefined"]
        },
        "trap_or_recover_mode": { "enum": ["trap", "recover"] },
        "native_execution_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_execution_required_before_support",
            "native_execution_record_required",
            "native_execution_record_fields",
            "missing_native_execution_behavior",
            "native_execution_claimed"
          ],
          "properties": {
            "native_execution_required_before_support": { "const": true },
            "native_execution_record_required": { "const": true },
            "native_execution_record_fields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "missing_native_execution_behavior": {
              "const": "fail-closed-before-support-promotion"
            },
            "native_execution_claimed": { "const": false }
          }
        },
        "support_truth": { "const": false },
        "native_execution_claimed": { "const": false }
      }
    },
    "installed_at_utc": { "type": "string" }
  }
}
