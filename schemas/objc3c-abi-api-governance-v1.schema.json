{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-abi-api-governance-v1.schema.json",
  "title": "objc3c ABI/API Governance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "release_blocker_issue_refs",
    "gate_action",
    "schema",
    "abi_version_taxonomy",
    "source_manifests",
    "module_policies",
    "stdlib_public_api",
    "stdlib_runtime_abi",
    "frontend_c_api",
    "compatibility_window_policy",
    "allowed_transition_policy",
    "deprecation_lifecycle",
    "package_abi_identity",
    "compiler_artifact_compatibility",
    "private_helper_graduation_records",
    "change_policy"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.release.foundation.abi_api_governance.v1" },
    "schema_version": { "const": 1 },
    "release_blocker_issue_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^#[0-9]+$" }
    },
    "gate_action": { "const": "check-release-abi-api-drift" },
    "schema": { "const": "schemas/objc3c-abi-api-governance-v1.schema.json" },
    "abi_version_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "abi_epoch",
        "current_major_line",
        "current_minor_line",
        "supported_major_lines",
        "compatibility_classes",
        "surface_classes"
      ],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "abi_epoch": { "type": "string", "minLength": 1 },
        "current_major_line": { "type": "integer", "minimum": 1 },
        "current_minor_line": { "type": "integer", "minimum": 0 },
        "supported_major_lines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "compatibility_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compatibilityClass" }
        },
        "surface_classes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_manifests": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": [
        "stdlib_module_inventory",
        "stdlib_stability_policy",
        "stdlib_semantic_policy",
        "stdlib_advanced_helper_package_surface",
        "frontend_c_api_helper_contract",
        "frontend_c_api_runner_contract",
        "release_operations_versioning_model",
        "long_horizon_deprecation_policy"
      ]
    },
    "module_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/modulePolicy" }
    },
    "stdlib_public_api": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/symbolSurface" }
    },
    "stdlib_runtime_abi": {
      "type": "array",
      "items": { "$ref": "#/$defs/symbolSurface" }
    },
    "frontend_c_api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "helper_contract",
        "runner_contract",
        "public_private_partition_owner",
        "surface_owner",
        "compatibility_class",
        "introduced_in",
        "minimum_supported_abi",
        "maximum_supported_abi",
        "deprecation_state",
        "allowed_transition_set",
        "release_blocker",
        "required_helpers",
        "required_type_aliases"
      ],
      "properties": {
        "helper_contract": { "type": "string", "minLength": 1 },
        "runner_contract": { "type": "string", "minLength": 1 },
        "public_private_partition_owner": { "type": "string", "minLength": 1 },
        "surface_owner": { "type": "string", "minLength": 1 },
        "compatibility_class": { "type": "string", "minLength": 1 },
        "introduced_in": { "type": "string", "minLength": 1 },
        "minimum_supported_abi": { "type": "string", "minLength": 1 },
        "maximum_supported_abi": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "deprecation_state": { "type": "string", "minLength": 1 },
        "allowed_transition_set": { "type": "string", "minLength": 1 },
        "release_blocker": { "const": true },
        "required_helpers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_type_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_transition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_sets",
        "release_blocked_transitions"
      ],
      "properties": {
        "transition_sets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "release_blocked_transitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deprecation_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_source",
        "public_claim_allowed_states",
        "public_claim_blocking_states",
        "required_warning_classes",
        "required_evidence_fields"
      ],
      "properties": {
        "policy_source": { "type": "string", "minLength": 1 },
        "public_claim_allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_claim_blocking_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_warning_classes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "required_evidence_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "package_abi_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_lock_schema",
        "package_lock_action",
        "package_compatibility_rule",
        "lockfile_abi_identity"
      ],
      "properties": {
        "package_lock_schema": { "type": "string", "minLength": 1 },
        "package_lock_action": { "const": "build-package-lock" },
        "package_compatibility_rule": { "type": "string", "minLength": 1 },
        "lockfile_abi_identity": { "$ref": "#/$defs/packageAbiIdentity" }
      }
    },
    "compiler_artifact_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_schema_surfaces",
        "required_schema_transition_policy"
      ],
      "properties": {
        "artifact_schema_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactSchemaSurface" }
        },
        "required_schema_transition_policy": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility_window_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versioning_model",
        "deprecation_policy",
        "expected_supported_major_line",
        "expected_current_minor_line",
        "expected_channel_statuses",
        "expected_forbidden_claims",
        "claim_blocking_deprecation_states"
      ],
      "properties": {
        "versioning_model": { "type": "string", "minLength": 1 },
        "deprecation_policy": { "type": "string", "minLength": 1 },
        "expected_supported_major_line": { "type": "integer", "minimum": 1 },
        "expected_current_minor_line": { "type": "integer", "minimum": 0 },
        "expected_channel_statuses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "expected_forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_blocking_deprecation_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "private_helper_graduation_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/graduationRecord" }
    },
    "change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unreviewed_symbol_additions",
        "unreviewed_symbol_removals",
        "signature_drift",
        "private_helper_graduation_without_policy",
        "compatibility_window_violations"
      ],
      "properties": {
        "unreviewed_symbol_additions": { "const": "block-publication" },
        "unreviewed_symbol_removals": { "const": "block-publication" },
        "signature_drift": { "const": "block-publication" },
        "private_helper_graduation_without_policy": { "const": "block-publication" },
        "compatibility_window_violations": { "const": "block-publication" }
      }
    }
  },
  "$defs": {
    "compatibilityClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "claim_scope",
        "release_blocker"
      ],
      "properties": {
        "class_id": { "type": "string", "minLength": 1 },
        "claim_scope": { "type": "string", "minLength": 1 },
        "release_blocker": { "type": "boolean" }
      }
    },
    "modulePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_profile",
        "allowed_public_prefixes",
        "allowed_runtime_prefixes",
        "allowed_public_symbols"
      ],
      "properties": {
        "required_profile": { "type": "string", "minLength": 1 },
        "allowed_public_prefixes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "allowed_runtime_prefixes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "allowed_public_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "symbolSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "manifest",
        "source",
        "surface_owner",
        "compatibility_class",
        "introduced_in",
        "minimum_supported_abi",
        "maximum_supported_abi",
        "deprecation_state",
        "allowed_transition_set",
        "release_blocker",
        "symbol_set_field",
        "signature_field",
        "symbols"
      ],
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "surface_owner": { "type": "string", "minLength": 1 },
        "compatibility_class": { "type": "string", "minLength": 1 },
        "introduced_in": { "type": "string", "minLength": 1 },
        "minimum_supported_abi": { "type": "string", "minLength": 1 },
        "maximum_supported_abi": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "deprecation_state": { "type": "string", "minLength": 1 },
        "allowed_transition_set": { "type": "string", "minLength": 1 },
        "release_blocker": { "const": true },
        "symbol_set_field": { "type": "string", "minLength": 1 },
        "signature_field": { "type": "string", "minLength": 1 },
        "symbols": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "graduationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "module",
        "symbol",
        "source_profile",
        "target_profile",
        "issue_refs",
        "policy_state"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "source_profile": { "type": "string", "minLength": 1 },
        "target_profile": { "type": "string", "minLength": 1 },
        "issue_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#[0-9]+$" }
        },
        "policy_state": { "enum": ["approved", "rejected"] }
      }
    },
    "packageAbiIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "governance_manifest",
        "governance_schema",
        "supported_major_line",
        "current_minor_line",
        "compatibility_class",
        "stdlib_public_api_symbol_count",
        "stdlib_runtime_abi_symbol_count",
        "frontend_c_api_symbol_count"
      ],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "governance_manifest": { "type": "string", "minLength": 1 },
        "governance_schema": { "type": "string", "minLength": 1 },
        "supported_major_line": { "type": "integer", "minimum": 1 },
        "current_minor_line": { "type": "integer", "minimum": 0 },
        "compatibility_class": { "type": "string", "minLength": 1 },
        "stdlib_public_api_symbol_count": { "type": "integer", "minimum": 0 },
        "stdlib_runtime_abi_symbol_count": { "type": "integer", "minimum": 0 },
        "frontend_c_api_symbol_count": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactSchemaSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "schema",
        "identity_path",
        "expected_identity",
        "compatibility_class",
        "allowed_transition_set"
      ],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "identity_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_identity": { "type": "string", "minLength": 1 },
        "compatibility_class": { "type": "string", "minLength": 1 },
        "allowed_transition_set": { "type": "string", "minLength": 1 }
      }
    }
  }
}
