{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-platform-support-matrix-v1.schema.json",
  "title": "objc3c Platform Support Matrix",
  "type": "object",
  "required": [
    "contract_id",
    "schema_version",
    "generated_at_utc",
    "default_platform_id",
    "matrix_dimensions",
    "platform_count",
    "platforms",
    "packaged_runtime_acceptance",
    "channels",
    "tiers",
    "current_host",
    "required_tool_probes",
    "claim_boundary",
    "support_evidence_contract",
    "platform_support_rows",
    "toolchain_support",
    "evidence_records",
    "support_evidence_ids",
    "publication_surface"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.platform.hardening.support.matrix.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at_utc": {
      "type": "string"
    },
    "default_platform_id": {
      "type": "string"
    },
    "matrix_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_os",
        "host_arch",
        "package_channels",
        "runtime_acceptance_suites",
        "release_validation_surfaces"
      ],
      "properties": {
        "host_os": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "host_arch": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "package_channels": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "runtime_acceptance_suites": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "release_validation_surfaces": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "platform_count": {
      "type": "integer",
      "minimum": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform_id"
        ],
        "properties": {
          "platform_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "packaged_runtime_acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform_id",
          "required_public_actions",
          "required_artifacts",
          "rollback_required"
        ],
        "properties": {
          "platform_id": { "type": "string" },
          "required_public_actions": {
            "type": "array",
            "items": { "$ref": "#/$defs/publicCommand" },
            "minItems": 1
          },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "rollback_required": { "type": "boolean" }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier_id",
          "display_name",
          "claim_class",
          "platform_ids"
        ],
        "properties": {
          "tier_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "claim_class": {
            "type": "string"
          },
          "platform_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "current_host": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      }
    },
    "required_tool_probes": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "supported_platform_ids",
        "gap_claims",
        "forbidden_claims"
      ],
      "properties": {
        "supported_platform_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "support_evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "schema_version",
        "issue",
        "schema_path",
        "source_path",
        "network_policy"
      ],
      "properties": {
        "contract_id": {
          "const": "objc3c.platform.toolchain.support.evidence.v1"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "issue": {
          "const": "OBJ3-NEXT-024"
        },
        "schema_path": {
          "const": "schemas/objc3c-platform-toolchain-support-evidence-v1.schema.json"
        },
        "source_path": {
          "const": "tests/tooling/fixtures/platform_hardening/platform_toolchain_support_evidence.json"
        },
        "network_policy": {
          "type": "object"
        }
      }
    },
    "platform_support_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_id",
          "platform_id",
          "support_state",
          "claim_class",
          "evidence"
        ],
        "properties": {
          "row_id": { "type": "string" },
          "platform_id": { "type": "string" },
          "support_state": {
            "enum": [
              "supported",
              "unsupported"
            ]
          },
          "claim_class": {
            "enum": [
              "supported",
              "fail-closed"
            ]
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "toolchain_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain_evidence_requirements",
        "toolchain_ranges",
        "sanitizer_variants"
      ],
      "properties": {
        "toolchain_evidence_requirements": {
          "type": "object"
        },
        "toolchain_ranges": {
          "type": "array"
        },
        "sanitizer_variants": {
          "type": "array"
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "evidence_class",
          "claim_weight",
          "source_paths",
          "replay_commands",
          "requires_network",
          "unsupported_host_behavior"
        ],
        "properties": {
          "evidence_id": { "type": "string" },
          "evidence_class": { "type": "string" },
          "claim_weight": {
            "enum": [
              "supporting",
              "policy"
            ]
          },
          "source_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replay_commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires_network": { "type": "boolean" },
          "unsupported_host_behavior": {
            "enum": [
              "fail-closed",
              "not-applicable"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "support_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "publication_surface": {
      "type": "object",
      "required": [
        "package_bridge",
        "inspect_support_matrix_command",
        "package_command",
        "package_channels_command",
        "packaging_validation_command",
        "packaging_end_to_end_command",
        "platform_hardening_validation_command",
        "platform_hardening_end_to_end_command",
        "release_operations_command",
        "release_operations_end_to_end_command"
      ],
      "properties": {
        "package_bridge": {
          "const": "objc3c"
        },
        "inspect_support_matrix_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "package_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "package_channels_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "packaging_validation_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "packaging_end_to_end_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "platform_hardening_validation_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "platform_hardening_end_to_end_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "release_operations_command": {
          "$ref": "#/$defs/publicCommand"
        },
        "release_operations_end_to_end_command": {
          "$ref": "#/$defs/publicCommand"
        }
      }
    }
  },
  "$defs": {
    "publicCommand": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
