{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-tooling-release-evidence-operation-v1.schema.json",
  "title": "objc3c Release Evidence Operation (v1)",
  "description": "Release-evidence operation sidecar emitted with the conformance publication bundle.",
  "x-objc3c-artifact-contract": {
    "schema_id": "objc3c-tooling-release-evidence-operation-v1",
    "payload_id_field": "schema_id",
    "payload_id_value": "objc3c-tooling-release-evidence-operation-v1",
    "registry_owner": "native/objc3c/src/artifacts/json/release_readiness_schema_records.cpp",
    "artifact_family": "release-evidence-operation"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_id",
    "dependency_contract_ids",
    "validation_contract_id",
    "dashboard_contract_id",
    "operation_model",
    "release_label",
    "command_tokens",
    "report_artifact",
    "publication_artifact",
    "validation_artifact",
    "dashboard_artifact",
    "gate_script_path",
    "runbook_reference_path",
    "dashboard_schema_path",
    "release_evidence_checklist_path",
    "release_evidence_schema_path",
    "targeted_profile_ids",
    "corpus_shard_ids",
    "release_evidence_artifact_ids",
    "generated_at",
    "ready"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.tooling.release.evidence.toolchain.operations.v1"
    },
    "schema_id": {
      "const": "objc3c-tooling-release-evidence-operation-v1"
    },
    "dependency_contract_ids": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "validation_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "dashboard_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_model": {
      "type": "string",
      "minLength": 16
    },
    "release_label": {
      "$ref": "#/$defs/releaseLabel"
    },
    "command_tokens": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "report_artifact": {
      "$ref": "#/$defs/artifactPath"
    },
    "publication_artifact": {
      "$ref": "#/$defs/artifactPath"
    },
    "validation_artifact": {
      "$ref": "#/$defs/artifactPath"
    },
    "dashboard_artifact": {
      "$ref": "#/$defs/artifactPath"
    },
    "gate_script_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "runbook_reference_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "dashboard_schema_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "release_evidence_checklist_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "release_evidence_schema_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "targeted_profile_ids": {
      "$ref": "#/$defs/profileArray"
    },
    "corpus_shard_ids": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "release_evidence_artifact_ids": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "ready": {
      "type": "boolean"
    }
  },
  "$defs": {
    "artifactPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 260
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profileArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "strict",
          "strict-concurrency",
          "strict-system"
        ]
      }
    },
    "releaseLabel": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
