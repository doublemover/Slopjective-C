          ],
          "properties": {
            "package_root_layout": { "$ref": "#/$defs/sanitizerPackageRootOverlayLayout" },
            "metadata_manifest_path": {
              "type": "string",
              "pattern": "^share/objc3c/sanitizer/(asan|ubsan)-metadata\\.json$"
            },
            "runtime_library_manifest_path": {
              "type": "string",
              "pattern": "^share/objc3c/sanitizer/(asan|ubsan)-runtime-libraries\\.json$"
            },
            "runtime_library_required_entries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "install_receipt_required_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "layout_support_truth": {
              "const": false
            }
          }
        },
        "runtime_probe_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe_required",
            "probe_inputs",
            "required_runtime_library_ids",
            "missing_runtime_behavior",
            "probe_result_support_truth"
          ],
          "properties": {
            "probe_required": {
              "const": true
            },
            "probe_inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "required_runtime_library_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "missing_runtime_behavior": {
              "const": "fail-closed-before-package-install"
            },
            "probe_result_support_truth": {
              "const": false
            }
          }
        },
        "install_selection_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_mode",
            "install_selector",
            "default_release_selection_allowed",
            "default_release_misuse_behavior"
          ],
          "properties": {
            "selection_mode": {
              "const": "explicit-opt-in"
            },
            "install_selector": {
              "enum": [
                "sanitizer=address",
                "sanitizer=undefined"
              ]
            },
            "default_release_selection_allowed": {
              "const": false
            },
            "default_release_misuse_behavior": {
              "const": "fail-closed-before-install"
            }
          }
        },
        "runtime_mixing_rejection_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_sanitizer_mixing_allowed",
            "mixed_runtime_behavior",
            "rejected_release_runtime_package_ids"
          ],
          "properties": {
            "release_sanitizer_mixing_allowed": {
              "const": false
            },
            "mixed_runtime_behavior": {
              "const": "fail-closed-before-native-execution-claim"
            },
            "rejected_release_runtime_package_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "environment_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env_var",
            "required_metadata_field",
            "required_options",
            "missing_environment_behavior",
            "environment_support_truth"
          ],
          "properties": {
            "env_var": {
              "enum": [
                "ASAN_OPTIONS",
                "UBSAN_OPTIONS"
              ]
            },
            "required_metadata_field": {
              "type": "string",
              "minLength": 1
            },
            "required_options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "missing_environment_behavior": {
              "const": "fail-closed-before-native-execution-claim"
            },
            "environment_support_truth": {
              "const": false
            }
          }
        },
        "trap_recover_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_mode_field",
            "allowed_modes",
            "default_mode_allowed",
            "missing_mode_behavior",
            "mode_support_truth"
          ],
          "properties": {
            "required_mode_field": {
              "const": "trap_or_recover_mode"
            },
            "allowed_modes": {
              "type": "array",
              "items": {
                "enum": [
                  "trap",
                  "recover"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "default_mode_allowed": {
              "const": false
            },
            "missing_mode_behavior": {
              "const": "fail-closed-before-native-execution-claim"
            },
            "mode_support_truth": {
              "const": false
            }
          }
        },
        "metadata_freshness_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_owned_metadata_required",
            "generated_metadata_support_truth",
            "stale_package_metadata_behavior",
            "freshness_inputs"
          ],
          "properties": {
            "source_owned_metadata_required": {
              "const": true
            },
            "generated_metadata_support_truth": {
              "const": false
            },
            "stale_package_metadata_behavior": {
              "const": "fail-closed-before-publication"
            },
            "freshness_inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "default_release_channel_allowed": {
          "const": false
        },
        "report_artifact_support_truth": {
          "const": false
        },
        "mixed_release_sanitizer_runtime_behavior": {
          "const": "fail-closed"
        },
        "release_runtime_package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "release_runtime_mixing_allowed": {
          "const": false
        },
        "expected_detection_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "record_kind",
              "required_behavior",
              "support_truth"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "record_kind": {
                "type": "string",
                "minLength": 1
              },
              "required_behavior": {
                "const": "record-only-no-support-promotion"
              },
              "support_truth": {
                "const": false
              }
            }
          }
        },
        "unsupported_host_diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "diagnostic_id",
              "failure_class",
              "required_behavior",
              "blocks"
            ],
            "properties": {
              "diagnostic_id": {
                "type": "string",
                "minLength": 1
              },
              "failure_class": {
                "const": "unsupported-sanitizer-platform"
              },
              "required_behavior": {
                "const": "fail-closed-before-capability-promotion"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "enum": [
                    "package",
                    "install",
                    "execution",
                    "publication"
                  ]
                },
                "minItems": 4,
                "uniqueItems": true
              }
            }
          }
        },
        "required_metadata_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "uniqueItems": true
        }
      }
    },
    "objectEmissionTruthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "positive_case",
        "required_tool",
        "required_probe",
        "required_target_probe",
        "clang_substitute_allowed",
        "toolchain_identity_required",
        "blocks_surfaces",
        "diagnostic"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "positive_case": {
          "type": "boolean"
        },
        "required_tool": {
          "const": "llc"
        },
        "required_probe": {
          "const": "llc --filetype=obj"
        },
        "required_target_probe": {
          "const": "llc --filetype=obj --mtriple=<target> [--relocation-model=pic for PIE/PIC targets] emits a non-empty object"
        },
        "clang_substitute_allowed": {
          "const": false
        },
        "toolchain_identity_required": {
          "const": true
        },
        "blocks_surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "package",
              "execution",
              "publication"
            ]
          },
          "uniqueItems": true
        },
        "diagnostic": {
          "type": "string"
        }
      }
    }
  }
}
