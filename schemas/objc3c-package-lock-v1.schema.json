{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-lock-v1.schema.json",
  "title": "objc3c Package Lock",
  "type": "object",
  "required": [
    "contract_id",
    "lockfile_version",
    "workspace",
    "package_manager",
    "packages",
    "dependencies",
    "provenance",
    "resolution_plan",
    "trust_policy",
    "digest_inputs",
    "replay"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "objc3c.package_ecosystem.lockfile.v1"
    },
    "lockfile_version": {
      "type": "integer",
      "minimum": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "workspace_id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package_manager": {
      "type": "object",
      "required": [
        "model",
        "language_version",
        "abi_identity",
        "package_manifest_root",
        "package_manifest_paths",
        "network_resolution",
        "hosted_registry"
      ],
      "additionalProperties": false,
      "properties": {
        "model": { "const": "checked-in-local-registry-offline-mirror-v1" },
        "language_version": { "const": "3.0" },
        "abi_identity": { "const": "objc3-abi-2025Q4" },
        "package_manifest_root": { "const": "tmp/artifacts/package-ecosystem/manifests" },
        "package_manifest_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
          }
        },
        "network_resolution": { "const": "unsupported-fail-closed" },
        "hosted_registry": { "const": "unsupported-fail-closed-if-claimed" }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "resolution_plan": {
      "$ref": "#/$defs/resolutionPlan"
    },
    "interop_loader_metadata": {
      "$ref": "#/$defs/interopLoaderSummary"
    },
    "trust_policy": {
      "$ref": "#/$defs/trustPolicy"
    },
    "digest_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[A-Za-z0-9_.-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "required": [
        "package_id",
        "source",
        "source_kind",
        "package_version",
        "language_version",
        "abi_identity",
        "source_digest",
        "package_manifest",
        "module_graph",
        "provenance_id",
        "trust"
      ],
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "stdlib-module-manifest",
            "showcase-workspace-manifest"
          ]
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "language_version": {
          "const": "3.0"
        },
        "abi_identity": {
          "const": "objc3-abi-2025Q4"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "package_manifest": {
          "$ref": "#/$defs/packageManifestRef"
        },
        "module_graph": {
          "$ref": "#/$defs/moduleGraph"
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "interop_loader_metadata": {
          "$ref": "#/$defs/interopLoaderPackageMetadata"
        }
      }
    },
    "packageManifestRef": {
      "type": "object",
      "required": ["path", "contract_id", "digest"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
        },
        "contract_id": { "const": "objc3c.package_ecosystem.package_manifest.v1" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "moduleGraph": {
      "type": "object",
      "required": [
        "contract_id",
        "package_id",
        "package_source_kind",
        "source",
        "source_digest",
        "source_authority",
        "source_authority_digest",
        "module_name",
        "resolver",
        "direct_import_syntax",
        "import_edges",
        "unsafe_metadata_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.module_graph.v1" },
        "package_id": { "$ref": "#/$defs/packageId" },
        "package_source_kind": {
          "enum": [
            "stdlib-module-manifest",
            "showcase-workspace-manifest"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": { "$ref": "#/$defs/sha256" },
        "module_name": {
          "type": "object",
          "required": ["canonical", "implementation", "case_sensitive"],
          "additionalProperties": false,
          "properties": {
            "canonical": { "type": "string", "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 },
            "case_sensitive": { "const": true }
          }
        },
        "resolver": { "const": "checked-in-local-registry" },
        "direct_import_syntax": { "const": "reserved-fail-closed" },
        "import_edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/moduleImportEdge" }
        },
        "unsafe_metadata_policy": {
          "type": "object",
          "required": [
            "missing_module_graph",
            "missing_package_manifest",
            "manual_sidecar_manifest",
            "network_or_hosted_metadata"
          ],
          "additionalProperties": false,
          "properties": {
            "missing_module_graph": { "const": "fail-closed" },
            "missing_package_manifest": { "const": "fail-closed" },
            "manual_sidecar_manifest": { "const": "fail-closed" },
            "network_or_hosted_metadata": { "const": "fail-closed" }
          }
        }
      }
    },
    "moduleImportEdge": {
      "type": "object",
      "required": [
        "from_module",
        "to_module",
        "to_package_id",
        "source",
        "source_authority",
        "source_authority_digest",
        "resolution",
        "required_version"
      ],
      "additionalProperties": false,
      "properties": {
        "from_module": { "type": "string", "minLength": 1 },
        "to_module": { "type": "string", "minLength": 1 },
        "to_package_id": { "$ref": "#/$defs/packageId" },
        "source": { "const": "checked-in-local-workspace" },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": { "$ref": "#/$defs/sha256" },
        "resolution": { "const": "locked-local-registry" },
        "required_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "contract_id",
        "signature_id",
        "signature_format",
        "signing_backend",
        "signer_id",
        "signing_key_id",
        "trust_root_id",
        "subject_kind",
        "subject_package_id",
        "subject_version",
        "package_namespace",
        "artifact_digest",
        "manifest_digest",
        "abi_identity",
        "language_version",
        "signature",
        "revocation_state",
        "verification_policy",
        "signed_at_utc",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.signature_envelope.v1" },
        "signature_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_format": { "const": "objc3c-deterministic-test-sha256-v1" },
        "signing_backend": { "const": "deterministic-test-replay" },
        "signer_id": { "const": "objc3c-local-package-signer-v1" },
        "signing_key_id": { "const": "objc3c-local-package-key-v1" },
        "trust_root_id": { "const": "objc3c-local-deterministic-trust-root-v1" },
        "subject_kind": { "const": "package-manifest" },
        "subject_package_id": { "type": "string", "minLength": 1 },
        "subject_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "package_namespace": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "abi_identity": { "const": "objc3-abi-2025Q4" },
        "language_version": { "const": "3.0" },
        "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "revocation_state": { "const": "not-revoked" },
        "verification_policy": { "const": "fail-closed-local-digest-trust-root-revocation-v1" },
        "signed_at_utc": { "const": "omitted-for-deterministic-replay" },
        "provenance": { "const": "deterministic-local-fixture-replay-only" }
      }
    },
    "trustPolicy": {
      "type": "object",
      "required": [
        "contract_id",
        "policy_version",
        "diagnostic_code",
        "trust_roots",
        "revocations",
        "key_rotation_policy",
        "production_signing_backend",
        "verification_policy"
      ],
      "additionalProperties": true,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.signing_trust.v1" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "diagnostic_code": { "const": "O3PKG8055" },
        "trust_roots": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "object" }
        },
        "revocations": {
          "type": "object",
          "required": [
            "revoked_trust_root_ids",
            "revoked_signing_key_ids",
            "revoked_package_ids",
            "revoked_signature_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "revoked_trust_root_ids": { "type": "array", "items": { "type": "string" } },
            "revoked_signing_key_ids": { "type": "array", "items": { "type": "string" } },
            "revoked_package_ids": { "type": "array", "items": { "type": "string" } },
            "revoked_signature_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "production_signing_backend": {
          "type": "object",
          "required": ["state", "required_backend", "diagnostic_code"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "reserved-fail-closed" },
            "required_backend": { "const": "ed25519-pinned-reviewed-provider" },
            "diagnostic_code": { "const": "O3PKG8055" }
          }
        }
      }
    },
    "interopLoaderSummary": {
      "type": "object",
      "required": [
        "contract_id",
        "source",
        "package_count",
        "package_ids",
        "bridge_surface_count",
        "objcxx_bridge_surface_count",
        "swift_bridge_surface_count",
        "tamper_rejection_diagnostic"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "package_count": {
          "type": "integer",
          "minimum": 0
        },
        "package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "objcxx_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "swift_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "tamper_rejection_diagnostic": {
          "const": "O3PKG8054"
        }
      }
    },
    "interopLoaderPackageMetadata": {
      "type": "object",
      "required": [
        "metadata_id",
        "source",
        "contract_id",
        "digest",
        "header_imports",
        "header_exports",
        "abi_alignment",
        "foreign_types",
        "mixed_images",
        "bridge_surfaces",
        "package_execution",
        "positive_fixtures",
        "negative_diagnostics",
        "tamper_rejection"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_input_digests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "header_imports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "header_exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abi_alignment": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "foreign_types": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mixed_images": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bridge_surfaces": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        },
        "package_execution": {
          "type": "object"
        },
        "positive_fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tamper_rejection": {
          "type": "object",
          "required": [
            "diagnostic_code",
            "source_range",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "diagnostic_code": {
              "const": "O3PKG8054"
            },
            "source_range": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "from",
        "to",
        "source",
        "source_authority",
        "source_authority_digest",
        "language_requirement",
        "abi_requirement",
        "resolution",
        "required_version",
        "resolved_version",
        "target_source_digest",
        "target_manifest_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "checked-in-local-workspace",
            "generated-local-package-artifact",
            "offline-mirror-artifact"
          ]
        },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": {
          "$ref": "#/$defs/sha256"
        },
        "language_requirement": {
          "const": "3.0"
        },
        "abi_requirement": {
          "const": "objc3-abi-2025Q4"
        },
        "resolution": {
          "const": "locked-local-registry"
        },
        "required_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "resolved_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target_source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "resolutionPlan": {
      "type": "object",
      "required": [
        "contract_id",
        "resolver",
        "selection_policy",
        "network_resolution",
        "hosted_registry",
        "install_order",
        "dependency_closures",
        "resolution_edges"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.resolution_plan.v1" },
        "resolver": { "const": "deterministic-local-registry" },
        "selection_policy": { "const": "exact-locked-version-only" },
        "network_resolution": { "const": "unsupported-fail-closed" },
        "hosted_registry": { "const": "unsupported-fail-closed-if-claimed" },
        "install_order": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dependency_closures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package_id", "dependencies_first"],
            "additionalProperties": false,
            "properties": {
              "package_id": { "type": "string", "minLength": 1 },
              "dependencies_first": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "resolution_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "source_authority",
              "source_authority_digest",
              "required_version",
              "resolved_version",
              "target_source_digest",
              "target_manifest_digest"
            ],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "source_authority": {
                "enum": [
                  "stdlib/module_inventory.json",
                  "showcase/portfolio.json"
                ]
              },
              "source_authority_digest": {
                "$ref": "#/$defs/sha256"
              },
              "required_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "resolved_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "target_source_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "target_manifest_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "provenance_id",
        "source_path",
        "generator",
        "replay_command",
        "package_manifest",
        "source_digest",
        "manifest_digest",
        "trust_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "replay_command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "package_manifest": {
          "type": "string",
          "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trust_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
