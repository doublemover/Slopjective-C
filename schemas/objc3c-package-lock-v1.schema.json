{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-lock-v1.schema.json",
  "title": "objc3c Package Lock",
  "type": "object",
  "required": [
    "contract_id",
    "lockfile_version",
    "workspace",
    "package_manager",
    "packages",
    "dependencies",
    "provenance",
    "digest_inputs",
    "replay"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "objc3c.package_ecosystem.lockfile.v1"
    },
    "lockfile_version": {
      "type": "integer",
      "minimum": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "workspace_id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package_manager": {
      "type": "object",
      "required": [
        "model",
        "language_version",
        "abi_identity",
        "package_manifest_root",
        "package_manifest_paths",
        "network_resolution",
        "hosted_registry"
      ],
      "additionalProperties": false,
      "properties": {
        "model": { "const": "checked-in-local-registry-offline-mirror-v1" },
        "language_version": { "const": "3.0" },
        "abi_identity": { "const": "objc3-abi-2025Q4" },
        "package_manifest_root": { "const": "tmp/artifacts/package-ecosystem/manifests" },
        "package_manifest_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
          }
        },
        "network_resolution": { "const": "unsupported-fail-closed" },
        "hosted_registry": { "const": "unsupported-fail-closed-if-claimed" }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "interop_loader_metadata": {
      "$ref": "#/$defs/interopLoaderSummary"
    },
    "digest_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "package_id",
        "source",
        "source_kind",
        "package_version",
        "language_version",
        "abi_identity",
        "source_digest",
        "package_manifest",
        "provenance_id",
        "trust"
      ],
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "stdlib-module-manifest",
            "showcase-workspace-manifest"
          ]
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "language_version": {
          "const": "3.0"
        },
        "abi_identity": {
          "const": "objc3-abi-2025Q4"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "package_manifest": {
          "$ref": "#/$defs/packageManifestRef"
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "$ref": "#/$defs/trust"
        },
        "interop_loader_metadata": {
          "$ref": "#/$defs/interopLoaderPackageMetadata"
        }
      }
    },
    "packageManifestRef": {
      "type": "object",
      "required": ["path", "contract_id", "digest"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
        },
        "contract_id": { "const": "objc3c.package_ecosystem.package_manifest.v1" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "signature_format",
        "signing_key_id",
        "subject",
        "signature",
        "trust_scope",
        "revocation_state",
        "revocation_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "signature_format": { "const": "objc3c-local-sha256-v1" },
        "signing_key_id": { "const": "objc3c-local-package-key-v1" },
        "subject": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "trust_scope": { "const": "checked-in-local-package-source" },
        "revocation_state": { "const": "not-revoked" },
        "revocation_policy": { "const": "revoked-package-ids-fail-resolution" }
      }
    },
    "interopLoaderSummary": {
      "type": "object",
      "required": [
        "contract_id",
        "source",
        "package_count",
        "package_ids",
        "bridge_surface_count",
        "objcxx_bridge_surface_count",
        "swift_bridge_surface_count",
        "tamper_rejection_diagnostic"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "package_count": {
          "type": "integer",
          "minimum": 0
        },
        "package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "objcxx_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "swift_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "tamper_rejection_diagnostic": {
          "const": "O3PKG8054"
        }
      }
    },
    "interopLoaderPackageMetadata": {
      "type": "object",
      "required": [
        "metadata_id",
        "source",
        "contract_id",
        "digest",
        "header_imports",
        "header_exports",
        "abi_alignment",
        "foreign_types",
        "mixed_images",
        "bridge_surfaces",
        "package_execution",
        "positive_fixtures",
        "negative_diagnostics",
        "tamper_rejection"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "header_imports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "header_exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abi_alignment": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "foreign_types": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mixed_images": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bridge_surfaces": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        },
        "package_execution": {
          "type": "object"
        },
        "positive_fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tamper_rejection": {
          "type": "object",
          "required": [
            "diagnostic_code",
            "source_range",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "diagnostic_code": {
              "const": "O3PKG8054"
            },
            "source_range": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "from",
        "to",
        "source",
        "language_requirement",
        "abi_requirement",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "checked-in-local-workspace",
            "generated-local-package-artifact",
            "offline-mirror-artifact"
          ]
        },
        "language_requirement": {
          "const": "3.0"
        },
        "abi_requirement": {
          "const": "objc3-abi-2025Q4"
        },
        "resolution": {
          "const": "locked-local-registry"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "provenance_id",
        "source_path",
        "generator",
        "replay_command",
        "package_manifest",
        "source_digest",
        "manifest_digest",
        "trust_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "replay_command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        },
        "package_manifest": {
          "type": "string",
          "pattern": "^tmp/artifacts/package-ecosystem/manifests/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.json$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trust_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
