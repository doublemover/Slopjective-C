{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-lock-v1.schema.json",
  "title": "objc3c Package Lock",
  "type": "object",
  "required": [
    "contract_id",
    "lockfile_version",
    "workspace",
    "packages",
    "dependencies",
    "provenance",
    "digest_inputs",
    "replay"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "objc3c.package_ecosystem.lockfile.v1"
    },
    "lockfile_version": {
      "type": "integer",
      "minimum": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "workspace_id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "interop_loader_metadata": {
      "$ref": "#/$defs/interopLoaderSummary"
    },
    "digest_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "package_id",
        "source",
        "provenance_id"
      ],
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "interop_loader_metadata": {
          "$ref": "#/$defs/interopLoaderPackageMetadata"
        }
      }
    },
    "interopLoaderSummary": {
      "type": "object",
      "required": [
        "contract_id",
        "source",
        "package_count",
        "package_ids",
        "bridge_surface_count",
        "objcxx_bridge_surface_count",
        "swift_bridge_surface_count",
        "tamper_rejection_diagnostic"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "package_count": {
          "type": "integer",
          "minimum": 0
        },
        "package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "objcxx_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "swift_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "tamper_rejection_diagnostic": {
          "const": "O3PKG8054"
        }
      }
    },
    "interopLoaderPackageMetadata": {
      "type": "object",
      "required": [
        "metadata_id",
        "source",
        "contract_id",
        "digest",
        "header_imports",
        "header_exports",
        "abi_alignment",
        "foreign_types",
        "mixed_images",
        "bridge_surfaces",
        "package_execution",
        "positive_fixtures",
        "negative_diagnostics",
        "tamper_rejection"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "header_imports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "header_exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abi_alignment": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "foreign_types": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mixed_images": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bridge_surfaces": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        },
        "package_execution": {
          "type": "object"
        },
        "positive_fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tamper_rejection": {
          "type": "object",
          "required": [
            "diagnostic_code",
            "source_range",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "diagnostic_code": {
              "const": "O3PKG8054"
            },
            "source_range": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "from",
        "to",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "checked-in-local-workspace",
            "generated-local-package-artifact",
            "offline-mirror-artifact"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "provenance_id",
        "source_path",
        "generator",
        "replay_command"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "replay_command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
        }
      }
    }
  }
}
