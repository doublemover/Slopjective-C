{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-network-resolution-v1.schema.json",
  "title": "objc3c Package Network Dependency Resolution Contract",
  "type": "object",
  "required": [
    "contract_id",
    "issue_refs",
    "umbrella_issue_refs",
    "resolver_id",
    "network_policy",
    "hosted_registry_endpoint",
    "lock_trust_material",
    "resolution_inputs",
    "dependencies",
    "failure_modes",
    "replay"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "const": "objc3c.package_ecosystem.network_dependency_resolution.v1" },
    "issue_refs": {
      "type": "array",
      "items": { "type": "integer" },
      "contains": { "const": 8221 },
      "minItems": 1,
      "uniqueItems": true
    },
    "umbrella_issue_refs": {
      "type": "array",
      "items": { "type": "integer" },
      "contains": { "const": 8204 },
      "minItems": 1,
      "uniqueItems": true
    },
    "resolver_id": { "const": "deterministic-network-dependency-offline-fixture-resolver-v1" },
    "network_policy": { "$ref": "#/$defs/networkPolicy" },
    "hosted_registry_endpoint": { "$ref": "#/$defs/endpointIdentity" },
    "lock_trust_material": { "$ref": "#/$defs/lockTrustMaterial" },
    "resolution_inputs": { "$ref": "#/$defs/resolutionInputs" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/networkDependency" },
      "minItems": 1
    },
    "failure_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/failureMode" },
      "minItems": 8,
      "uniqueItems": true
    },
    "replay": { "$ref": "#/$defs/replay" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9_.-]+)?$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[A-Za-z0-9_.-]+$"
    },
    "endpointIdentity": {
      "type": "object",
      "required": [
        "registry_id",
        "endpoint_id",
        "channel_id",
        "base_url",
        "availability_claim",
        "network_fetch",
        "fallback_registry_success"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_id": { "type": "string", "minLength": 1 },
        "endpoint_id": { "const": "objc3c-hosted-registry-fixture-endpoint-v1" },
        "channel_id": { "const": "stable-fixture" },
        "base_url": { "const": "https://registry.objc3c.invalid/fixture/v1" },
        "availability_claim": { "const": "fixture-metadata-only" },
        "network_fetch": { "const": "forbidden-fail-closed" },
        "fallback_registry_success": { "const": false }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "dependency_resolution",
        "live_network_fetch",
        "fallback_registry_success",
        "version_selection",
        "lock_policy",
        "lockfile_required",
        "trust_required",
        "provenance_required",
        "cache_policy",
        "cache_signature_required",
        "provenance_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "dependency_resolution": { "const": "offline-fixture-backed-network-resolution" },
        "live_network_fetch": { "const": "forbidden-fail-closed" },
        "fallback_registry_success": { "const": false },
        "version_selection": { "const": "exact-locked-version-only" },
        "lock_policy": { "const": "fixture-lock-required" },
        "lockfile_required": { "const": true },
        "trust_required": { "const": true },
        "provenance_required": { "const": true },
        "cache_policy": { "const": "offline-cache-required-digest-pinned" },
        "cache_signature_required": { "const": true },
        "provenance_policy": { "const": "source-owned-package-manifest-required" }
      }
    },
    "lockTrustMaterial": {
      "type": "object",
      "required": [
        "source_lock",
        "source_lock_digest",
        "trust_root_id",
        "offline_mirror_path",
        "cache_policy",
        "provenance_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "source_lock": { "type": "string", "minLength": 1 },
        "source_lock_digest": { "$ref": "#/$defs/sha256" },
        "trust_root_id": { "const": "objc3c-local-deterministic-trust-root-v1" },
        "offline_mirror_path": { "type": "string", "minLength": 1 },
        "cache_policy": { "const": "offline-cache-required-digest-pinned" },
        "provenance_policy": { "const": "source-owned-package-manifest-required" }
      }
    },
    "resolutionInputs": {
      "type": "object",
      "required": [
        "hosted_registry_index",
        "offline_mirror",
        "fixture_lock",
        "release_channel_publication"
      ],
      "additionalProperties": false,
      "properties": {
        "hosted_registry_index": { "type": "string", "minLength": 1 },
        "offline_mirror": { "type": "string", "minLength": 1 },
        "fixture_lock": { "type": "string", "minLength": 1 },
        "release_channel_publication": { "type": "string", "minLength": 1 }
      }
    },
    "networkDependency": {
      "type": "object",
      "required": [
        "from_package_id",
        "dependency_id",
        "requested_version",
        "resolved_version",
        "resolution",
        "fallback_used",
        "endpoint",
        "dependency_identity",
        "lock",
        "cache",
        "trust"
      ],
      "additionalProperties": false,
      "properties": {
        "from_package_id": { "$ref": "#/$defs/packageId" },
        "dependency_id": { "$ref": "#/$defs/packageId" },
        "requested_version": { "$ref": "#/$defs/semver" },
        "resolved_version": { "$ref": "#/$defs/semver" },
        "resolution": { "const": "offline-hosted-registry-fixture" },
        "fallback_used": { "const": false },
        "endpoint": { "$ref": "#/$defs/endpointIdentity" },
        "dependency_identity": { "$ref": "#/$defs/dependencyIdentity" },
        "lock": { "$ref": "#/$defs/dependencyLock" },
        "cache": { "$ref": "#/$defs/dependencyCache" },
        "trust": { "$ref": "#/$defs/dependencyTrust" }
      }
    },
    "dependencyIdentity": {
      "type": "object",
      "required": [
        "package_id",
        "package_version",
        "source_digest",
        "manifest_digest",
        "registry_record_digest",
        "endpoint_id",
        "channel_id"
      ],
      "additionalProperties": false,
      "properties": {
        "package_id": { "$ref": "#/$defs/packageId" },
        "package_version": { "$ref": "#/$defs/semver" },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "registry_record_digest": { "$ref": "#/$defs/sha256" },
        "endpoint_id": { "const": "objc3c-hosted-registry-fixture-endpoint-v1" },
        "channel_id": { "const": "stable-fixture" }
      }
    },
    "dependencyLock": {
      "type": "object",
      "required": [
        "source_lock",
        "source_lock_digest",
        "manifest_digest",
        "trust_root_id"
      ],
      "additionalProperties": false,
      "properties": {
        "source_lock": { "type": "string", "minLength": 1 },
        "source_lock_digest": { "$ref": "#/$defs/sha256" },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "trust_root_id": { "const": "objc3c-local-deterministic-trust-root-v1" }
      }
    },
    "dependencyCache": {
      "type": "object",
      "required": [
        "cache_entry",
        "cache_path",
        "cache_digest",
        "cache_policy",
        "signature_required",
        "registry_signature_id"
      ],
      "additionalProperties": false,
      "properties": {
        "cache_entry": { "type": "string", "minLength": 1 },
        "cache_path": { "type": "string", "minLength": 1 },
        "cache_digest": { "$ref": "#/$defs/sha256" },
        "cache_policy": { "const": "offline-cache-required-digest-pinned" },
        "signature_required": { "const": true },
        "registry_signature_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyTrust": {
      "type": "object",
      "required": [
        "trust_root_id",
        "package_manifest_signature_id",
        "registry_record_signature_id",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "trust_root_id": { "const": "objc3c-local-deterministic-trust-root-v1" },
        "package_manifest_signature_id": { "$ref": "#/$defs/sha256" },
        "registry_record_signature_id": { "$ref": "#/$defs/sha256" },
        "provenance": { "const": "deterministic-local-fixture-replay-only" }
      }
    },
    "failureMode": {
      "enum": [
        "dependency-identity-drift",
        "fallback-registry-success",
        "hosted-registry-endpoint-mismatch",
        "live-network-fetch",
        "lock-mismatch",
        "stale-release-channel",
        "unsigned-or-tampered-cache",
        "unpinned-hosted-dependency"
      ]
    },
    "replay": {
      "type": "object",
      "required": ["commands"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          },
          "minItems": 1
        }
      }
    }
  }
}
