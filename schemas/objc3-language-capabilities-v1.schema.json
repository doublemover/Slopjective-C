{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_family",
    "language_revision",
    "extension_abi_revision",
    "features"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "compiler_family": { "const": "clang-foundation" },
    "language_revision": { "type": "integer", "minimum": 1 },
    "extension_abi_revision": { "type": "integer", "minimum": 1 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "macro", "aliases", "state", "qualified_targets"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "macro": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "state": { "enum": ["implemented", "rejected", "reserved", "internal"] },
          "qualified_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["triple", "runtime", "profile", "evidence"],
              "properties": {
                "triple": { "type": "string", "minLength": 1 },
                "runtime": { "type": "string", "minLength": 1 },
                "profile": {
                  "enum": ["compatibility", "strict", "strict-concurrency", "strict-system"]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
