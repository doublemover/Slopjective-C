{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-channels-manifest-v1.schema.json",
  "title": "objc3c Package Channels Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "generated_at_utc",
    "status",
    "platform_id",
    "package_root",
    "platform_support_matrix",
    "supported_platform_ids",
    "support_tiers",
    "implemented_channels",
    "interop_loader_metadata",
    "installer_signature",
    "archive_digests",
    "portable_archive",
    "installer_archive",
    "offline_archive"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.packaging.channels.summary.v1" },
    "generated_at_utc": { "type": "string" },
    "status": { "const": "PASS" },
    "platform_id": { "type": "string" },
    "package_root": { "type": "string" },
    "platform_support_matrix": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "implemented_channels": {
      "type": "array",
      "items": {
        "enum": ["portable-archive", "local-installer", "offline-bundle"]
      },
      "minItems": 3
    },
    "interop_loader_metadata": {
      "$ref": "#/$defs/interopLoaderMetadata"
    },
    "installer_signature": {
      "$ref": "#/$defs/installerSignature"
    },
    "archive_digests": {
      "$ref": "#/$defs/archiveDigests"
    },
    "portable_archive": { "type": "string" },
    "installer_archive": { "type": "string" },
    "offline_archive": { "type": "string" }
  },
  "$defs": {
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "installerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_format",
        "signing_key_id",
        "subject",
        "artifact",
        "sha256",
        "verification_command",
        "trust_scope"
      ],
      "properties": {
        "signature_format": { "const": "objc3c-local-sha256-v1" },
        "signing_key_id": { "const": "objc3c-release-operations-local-installer-key-v1" },
        "subject": { "const": "local-installer" },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_command": { "const": "npm run objc3c -- validate-packaging-channels-end-to-end" },
        "trust_scope": { "const": "checked-in-artifact-digest" }
      }
    },
    "archiveDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_archive", "installer_archive", "offline_archive"],
      "properties": {
        "portable_archive": { "$ref": "#/$defs/portableArchiveDigest" },
        "installer_archive": { "$ref": "#/$defs/installerArchiveDigest" },
        "offline_archive": { "$ref": "#/$defs/offlineArchiveDigest" }
      }
    },
    "portableArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "portable-archive" }
          }
        }
      ]
    },
    "installerArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "local-installer" }
          }
        }
      ]
    },
    "offlineArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "offline-bundle" }
          }
        }
      ]
    },
    "archiveDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_format",
        "artifact_role",
        "artifact",
        "sha256",
        "verification_command",
        "trust_scope"
      ],
      "properties": {
        "digest_format": { "const": "sha256" },
        "artifact_role": {
          "enum": ["portable-archive", "local-installer", "offline-bundle"]
        },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_command": { "const": "npm run objc3c -- validate-packaging-channels-end-to-end" },
        "trust_scope": { "const": "checked-in-artifact-digest" }
      }
    },
    "interopLoaderMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "source",
        "support",
        "package_count",
        "package_ids",
        "header_import_count",
        "header_export_count",
        "abi_alignment_count",
        "foreign_type_count",
        "mixed_image_count",
        "bridge_surface_count",
        "objcxx_bridge_surface_count",
        "swift_bridge_surface_count",
        "positive_fixture_count",
        "negative_fixture_count",
        "tamper_rejection_diagnostic",
        "unsupported_surfaces"
      ],
      "properties": {
        "contract_id": {
          "const": "objc3c.package_ecosystem.mixed_image_interop_loader_metadata.v1"
        },
        "source": {
          "const": "tests/tooling/fixtures/package_ecosystem/mixed_image_interop_loader_metadata.json"
        },
        "support": {
          "const": "local-mixed-image-metadata-digest-checked"
        },
        "package_count": {
          "type": "integer",
          "minimum": 1
        },
        "package_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "header_import_count": {
          "type": "integer",
          "minimum": 1
        },
        "header_export_count": {
          "type": "integer",
          "minimum": 1
        },
        "abi_alignment_count": {
          "type": "integer",
          "minimum": 1
        },
        "foreign_type_count": {
          "type": "integer",
          "minimum": 1
        },
        "mixed_image_count": {
          "type": "integer",
          "minimum": 1
        },
        "bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "objcxx_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "swift_bridge_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "positive_fixture_count": {
          "type": "integer",
          "minimum": 1
        },
        "negative_fixture_count": {
          "type": "integer",
          "minimum": 1
        },
        "tamper_rejection_diagnostic": {
          "const": "O3PKG8054"
        },
        "unsupported_surfaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
