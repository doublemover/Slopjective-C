{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-channels-manifest-v1.schema.json",
  "title": "objc3c Package Channels Manifest",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["sanitizer_variant"],
        "properties": { "sanitizer_variant": { "const": "release" } }
      },
      "then": {
        "properties": {
          "package_id": {
            "enum": [
              "org.objc3c.runtime:objc3c-runtime-release",
              "org.objc3c.runtime:objc3c-runtime-linux-x64-release",
              "org.objc3c.runtime:objc3c-runtime-darwin-arm64-release"
            ]
          },
          "package_channel_id": {
            "enum": [
              "windows-x64-release",
              "linux-x64-release",
              "darwin-arm64-release"
            ]
          },
          "payload_contract": {
            "properties": {
              "required_entries": {
                "not": {
                  "contains": {
                    "enum": [
                      "share/objc3c/sanitizer/asan-metadata.json",
                      "share/objc3c/sanitizer/ubsan-metadata.json",
                      "share/objc3c/sanitizer/asan-runtime-libraries.json",
                      "share/objc3c/sanitizer/ubsan-runtime-libraries.json",
                      "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.dll",
                      "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.lib",
                      "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic_runtime_thunk-x86_64.lib",
                      "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone-x86_64.lib",
                      "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone_cxx-x86_64.lib"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["sanitizer_variant"],
        "properties": { "sanitizer_variant": { "const": "address" } }
      },
      "then": {
        "properties": {
          "package_id": { "const": "org.objc3c.runtime:objc3c-runtime-asan" },
          "package_channel_id": { "const": "windows-x64-sanitizer-asan" },
          "payload_contract": {
            "properties": {
              "required_entries": {
                "allOf": [
                  { "contains": { "const": "share/objc3c/sanitizer/asan-metadata.json" } },
                  { "contains": { "const": "share/objc3c/sanitizer/asan-runtime-libraries.json" } },
                  { "contains": { "const": "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.dll" } },
                  { "contains": { "const": "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.lib" } },
                  { "contains": { "const": "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic_runtime_thunk-x86_64.lib" } }
                ]
              }
            }
          },
          "receipt_contracts": {
            "properties": {
              "install_receipt": { "$ref": "#/$defs/addressSanitizerReceiptContract" },
              "offline_install_receipt": { "$ref": "#/$defs/addressSanitizerReceiptContract" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["sanitizer_variant"],
        "properties": { "sanitizer_variant": { "const": "undefined" } }
      },
      "then": {
        "properties": {
          "package_id": { "const": "org.objc3c.runtime:objc3c-runtime-ubsan" },
          "package_channel_id": { "const": "windows-x64-sanitizer-ubsan" },
          "payload_contract": {
            "properties": {
              "required_entries": {
                "allOf": [
                  { "contains": { "const": "share/objc3c/sanitizer/ubsan-metadata.json" } },
                  { "contains": { "const": "share/objc3c/sanitizer/ubsan-runtime-libraries.json" } },
                  { "contains": { "const": "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone-x86_64.lib" } },
                  { "contains": { "const": "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone_cxx-x86_64.lib" } }
                ]
              }
            }
          },
          "receipt_contracts": {
            "properties": {
              "install_receipt": { "$ref": "#/$defs/undefinedSanitizerReceiptContract" },
              "offline_install_receipt": { "$ref": "#/$defs/undefinedSanitizerReceiptContract" }
            }
          }
        }
      }
    }
  ],
  "required": [
    "contract_id",
    "generated_at_utc",
    "status",
    "platform_id",
    "package_id",
    "package_channel_id",
    "sanitizer_variant",
    "package_root",
    "platform_support_matrix",
    "supported_platform_ids",
    "support_tiers",
    "package_runtime_models",
    "implemented_channels",
    "interop_loader_metadata",
    "installer_signature",
    "archive_digests",
    "payload_contract",
    "receipt_contracts",
    "portable_archive",
    "installer_archive",
    "offline_archive",
    "support_truth",
    "native_execution_claimed"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.packaging.channels.summary.v1" },
    "generated_at_utc": { "type": "string" },
    "status": { "const": "PASS" },
    "platform_id": { "type": "string" },
    "package_id": {
      "enum": [
        "org.objc3c.runtime:objc3c-runtime-release",
        "org.objc3c.runtime:objc3c-runtime-linux-x64-release",
        "org.objc3c.runtime:objc3c-runtime-darwin-arm64-release",
        "org.objc3c.runtime:objc3c-runtime-asan",
        "org.objc3c.runtime:objc3c-runtime-ubsan"
      ]
    },
    "package_channel_id": {
      "enum": [
        "windows-x64-release",
        "linux-x64-release",
        "darwin-arm64-release",
        "windows-x64-sanitizer-asan",
        "windows-x64-sanitizer-ubsan"
      ]
    },
    "sanitizer_variant": { "enum": ["release", "address", "undefined"] },
    "package_root": { "type": "string" },
    "platform_support_matrix": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "package_runtime_models": {
      "$ref": "#/$defs/packageRuntimeModels"
    },
    "implemented_channels": {
      "type": "array",
      "items": {
        "enum": ["portable-archive", "local-installer", "offline-bundle"]
      },
      "minItems": 3
    },
    "interop_loader_metadata": {
      "$ref": "#/$defs/interopLoaderMetadata"
    },
    "installer_signature": {
      "$ref": "#/$defs/installerSignature"
    },
    "archive_digests": {
      "$ref": "#/$defs/archiveDigests"
    },
    "payload_contract": {
      "$ref": "#/$defs/payloadContract"
    },
    "receipt_contracts": {
      "$ref": "#/$defs/receiptContracts"
    },
    "portable_archive": { "type": "string" },
    "installer_archive": { "type": "string" },
    "offline_archive": { "type": "string" },
    "support_truth": { "const": false },
    "native_execution_claimed": { "const": false },
    "release_foundation_artifacts": { "type": "object" }
  },
  "$defs": {
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "packageRuntimeModels": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRuntimeModel" },
      "minItems": 1,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "platform_id": { "const": "linux-x64" },
              "support_state": { "const": "unsupported" },
              "claim_state": { "const": "fail-closed" },
              "package_id": {
                "const": "org.objc3c.runtime:objc3c-runtime-linux-x64-release"
              },
              "required_missing_evidence_classes": {
                "allOf": [
                  { "contains": { "const": "build" } },
                  { "contains": { "const": "package" } },
                  { "contains": { "const": "install" } },
                  { "contains": { "const": "execution" } }
                ]
              },
              "unsupported_behavior": { "const": "fail-closed" },
              "support_truth": { "const": false },
              "native_execution_required": { "const": true },
              "native_execution_claimed": { "const": false },
              "promotion_allowed": { "const": false }
            },
            "required": [
              "platform_id",
              "support_state",
              "claim_state",
              "package_id",
              "required_missing_evidence_classes",
              "unsupported_behavior",
              "support_truth",
              "native_execution_required",
              "native_execution_claimed",
              "promotion_allowed"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "platform_id": { "const": "darwin-arm64" },
              "support_state": { "const": "unsupported" },
              "claim_state": { "const": "fail-closed" },
              "package_id": {
                "const": "org.objc3c.runtime:objc3c-runtime-darwin-arm64-release"
              },
              "required_missing_evidence_classes": {
                "allOf": [
                  { "contains": { "const": "build" } },
                  { "contains": { "const": "package" } },
                  { "contains": { "const": "install" } },
                  { "contains": { "const": "execution" } }
                ]
              },
              "unsupported_behavior": { "const": "fail-closed" },
              "support_truth": { "const": false },
              "native_execution_required": { "const": true },
              "native_execution_claimed": { "const": false },
              "promotion_allowed": { "const": false }
            },
            "required": [
              "platform_id",
              "support_state",
              "claim_state",
              "package_id",
              "required_missing_evidence_classes",
              "unsupported_behavior",
              "support_truth",
              "native_execution_required",
              "native_execution_claimed",
              "promotion_allowed"
            ]
          }
        }
      ]
    },
    "packageRuntimeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "target_platform_id",
        "host_os",
        "host_arch",
        "support_state",
        "claim_state",
        "package_id",
        "package_channel_id",
        "package_variant_row_id",
        "runtime_variant",
        "runtime_library_ids",
        "runtime_library_names",
        "package_root_layout",
        "missing_runtime_behavior",
        "unsupported_behavior",
        "required_evidence_classes",
        "required_missing_evidence_classes",
        "support_truth",
        "native_execution_required",
        "native_execution_claimed",
        "promotion_allowed"
      ],
      "properties": {
        "platform_id": {
          "enum": ["windows-x64", "linux-x64", "darwin-arm64"]
        },
        "target_platform_id": {
          "enum": ["windows-x64", "linux-x64", "darwin-arm64"]
        },
        "host_os": { "enum": ["windows", "linux", "darwin"] },
        "host_arch": { "enum": ["x64", "arm64"] },
        "support_state": { "enum": ["supported", "unsupported"] },
        "claim_state": { "enum": ["evidence-bound", "fail-closed"] },
        "package_id": {
          "enum": [
            "org.objc3c.runtime:objc3c-runtime-release",
            "org.objc3c.runtime:objc3c-runtime-linux-x64-release",
            "org.objc3c.runtime:objc3c-runtime-darwin-arm64-release"
          ]
        },
        "package_channel_id": {
          "enum": [
            "windows-x64-release",
            "linux-x64-release",
            "darwin-arm64-release"
          ]
        },
        "package_variant_row_id": {
          "type": "string",
          "pattern": "^objc3c\\.package\\.runtime\\."
        },
        "runtime_variant": { "const": "release" },
        "runtime_library_ids": {
          "type": "array",
          "items": { "const": "objc3-runtime" },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtime_library_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "package_root_layout": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "missing_runtime_behavior": {
          "const": "fail-closed-before-native-execution-claim"
        },
        "unsupported_behavior": { "const": "fail-closed" },
        "required_evidence_classes": {
          "type": "array",
          "items": {
            "enum": ["build", "package", "install", "execution"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_missing_evidence_classes": {
          "type": "array",
          "items": {
            "enum": ["build", "package", "install", "execution"]
          },
          "uniqueItems": true
        },
        "support_truth": { "const": false },
        "native_execution_required": { "const": true },
        "native_execution_claimed": { "const": false },
        "promotion_allowed": { "const": false }
      }
    },
    "receiptPackageRuntimeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_platform_id",
        "package_id",
        "package_channel_id",
        "sanitizer_variant",
        "runtime_variant",
        "runtime_library_ids",
        "runtime_library_names",
        "package_root_layout",
        "missing_runtime_behavior",
        "unsupported_behavior",
        "support_truth",
        "native_execution_claimed"
      ],
      "properties": {
        "target_platform_id": {
          "enum": ["windows-x64", "linux-x64", "darwin-arm64"]
        },
        "package_id": {
          "enum": [
            "org.objc3c.runtime:objc3c-runtime-release",
            "org.objc3c.runtime:objc3c-runtime-linux-x64-release",
            "org.objc3c.runtime:objc3c-runtime-darwin-arm64-release",
            "org.objc3c.runtime:objc3c-runtime-asan",
            "org.objc3c.runtime:objc3c-runtime-ubsan"
          ]
        },
        "package_channel_id": {
          "enum": [
            "windows-x64-release",
            "linux-x64-release",
            "darwin-arm64-release",
            "windows-x64-sanitizer-asan",
            "windows-x64-sanitizer-ubsan"
          ]
        },
        "sanitizer_variant": { "enum": ["release", "address", "undefined"] },
        "runtime_variant": {
          "enum": ["release", "sanitizer=address", "sanitizer=undefined"]
        },
        "runtime_library_ids": {
          "type": "array",
          "items": {
            "enum": ["objc3-runtime", "clang_rt.asan", "clang_rt.ubsan"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtime_library_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "package_root_layout": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "missing_runtime_behavior": {
          "enum": [
            "fail-closed-before-native-execution-claim",
            "fail-closed-before-package-install"
          ]
        },
        "unsupported_behavior": { "const": "fail-closed" },
        "support_truth": { "const": false },
        "native_execution_claimed": { "const": false }
      }
    },
    "installerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_format",
        "signing_key_id",
        "subject",
        "artifact",
        "sha256",
        "verification_command",
        "trust_scope"
      ],
      "properties": {
        "signature_format": { "const": "objc3c-local-sha256-v1" },
        "signing_key_id": { "const": "objc3c-release-operations-local-installer-key-v1" },
        "subject": { "const": "local-installer" },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_command": { "const": "npm run objc3c -- validate-packaging-channels-end-to-end" },
        "trust_scope": { "const": "checked-in-artifact-digest" }
      }
    },
    "archiveDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_archive", "installer_archive", "offline_archive"],
      "properties": {
        "portable_archive": { "$ref": "#/$defs/portableArchiveDigest" },
        "installer_archive": { "$ref": "#/$defs/installerArchiveDigest" },
        "offline_archive": { "$ref": "#/$defs/offlineArchiveDigest" }
      }
    },
    "portableArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "portable-archive" }
          }
        }
      ]
    },
    "installerArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "local-installer" }
          }
        }
      ]
    },
    "offlineArchiveDigest": {
      "allOf": [
        { "$ref": "#/$defs/archiveDigest" },
        {
          "type": "object",
          "properties": {
            "artifact_role": { "const": "offline-bundle" }
          }
        }
      ]
    },
    "archiveDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_format",
        "artifact_role",
        "artifact",
        "sha256",
        "verification_command",
        "trust_scope"
      ],
      "properties": {
        "digest_format": { "const": "sha256" },
        "artifact_role": {
          "enum": ["portable-archive", "local-installer", "offline-bundle"]
        },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_command": { "const": "npm run objc3c -- validate-packaging-channels-end-to-end" },
        "trust_scope": { "const": "checked-in-artifact-digest" }
      }
    },
    "payloadContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "source",
        "manifest_relative_path",
        "manifest_artifact",
        "manifest_sha256",
        "required_entries",
        "entry_digests",
        "clean_room_source_policy"
      ],
      "properties": {
        "contract_id": { "const": "objc3c.packaging.channels.payload-contract.v1" },
        "source": { "const": "canonical-runnable-toolchain-package" },
        "manifest_relative_path": {
          "const": "artifacts/package/objc3c-runnable-toolchain-package.json"
        },
        "manifest_artifact": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "required_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadEntryPath" },
          "minItems": 1
        },
        "entry_digests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/payloadEntryDigest" },
          "minProperties": 1
        },
        "clean_room_source_policy": { "const": "fresh-owned-tmp-root-only" }
      }
    },
    "payloadEntryPath": {
      "enum": [
        "artifacts/package/objc3c-runnable-toolchain-package.json",
        "artifacts/bin/objc3c-native.exe",
        "artifacts/bin/objc3c-native",
        "artifacts/lib/objc3_runtime.lib",
        "artifacts/lib/libobjc3-runtime.so",
        "artifacts/lib/libobjc3-runtime.dylib",
        "stdlib/workspace.json",
        "stdlib/modules/objc3.core/module.json",
        "docs/runbooks/objc3c_packaging_channels.md",
        "share/objc3c/sanitizer/asan-metadata.json",
        "share/objc3c/sanitizer/ubsan-metadata.json",
        "share/objc3c/sanitizer/asan-runtime-libraries.json",
        "share/objc3c/sanitizer/ubsan-runtime-libraries.json",
        "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.dll",
        "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic-x86_64.lib",
        "artifacts/runtime/sanitizer/address/clang_rt.asan_dynamic_runtime_thunk-x86_64.lib",
        "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone-x86_64.lib",
        "artifacts/runtime/sanitizer/undefined/clang_rt.ubsan_standalone_cxx-x86_64.lib"
      ]
    },
    "payloadEntryDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_format", "artifact", "sha256"],
      "properties": {
        "digest_format": { "const": "sha256" },
        "artifact": { "$ref": "#/$defs/payloadEntryPath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "receiptContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_receipt", "offline_install_receipt"],
      "properties": {
        "install_receipt": { "$ref": "#/$defs/localInstallReceiptContract" },
        "offline_install_receipt": { "$ref": "#/$defs/offlineInstallReceiptContract" }
      }
    },
    "localInstallReceiptContract": {
      "allOf": [
        { "$ref": "#/$defs/installReceiptContract" },
        {
          "type": "object",
          "properties": {
            "channel_id": { "const": "local-installer" },
            "emitted_by": { "const": "Install-objc3c.ps1" },
            "network_policy": { "const": "local-filesystem-only" }
          }
        }
      ]
    },
    "offlineInstallReceiptContract": {
      "allOf": [
        { "$ref": "#/$defs/installReceiptContract" },
        {
          "type": "object",
          "required": ["delegates_to"],
          "properties": {
            "channel_id": { "const": "offline-bundle" },
            "emitted_by": { "const": "OfflineBootstrap-objc3c.ps1" },
            "network_policy": { "const": "no-network" },
            "delegates_to": { "const": "local-installer" }
          }
        }
      ]
    },
    "installReceiptContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "schema",
        "receipt_path",
        "channel_id",
        "emitted_by",
        "bootstrap_entrypoint",
        "package_bridge",
        "install_command",
        "payload_manifest",
        "payload_required_entries",
        "required_fields",
        "network_policy",
        "rollback_required",
        "package_id",
        "package_channel_id",
        "sanitizer_variant",
        "target_platform_id",
        "package_runtime_model",
        "emitted_platform_fields",
        "support_truth",
        "native_execution_claimed"
      ],
      "properties": {
        "contract_id": { "const": "objc3c.packaging.channels.install-receipt.v1" },
        "schema": { "const": "schemas/objc3c-package-install-receipt-v1.schema.json" },
