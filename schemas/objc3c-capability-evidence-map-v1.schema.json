{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-capability-evidence-map-v1.schema.json",
  "title": "objc3c Capability Evidence Map",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_path",
    "matrix_schema_path",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "objc3c-capability-evidence-map-v1"
    },
    "matrix_path": {
      "type": "string",
      "const": "docs/support/capability_matrix.json"
    },
    "matrix_schema_path": {
      "type": "string",
      "const": "schemas/objc3c-capability-matrix-v1.schema.json"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "evidence_kind",
          "path"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "support_claim": {
            "type": "string",
            "pattern": "^objc3c\\.behavior\\.[a-z0-9._-]+$"
          },
          "evidence_kind": {
            "enum": [
              "test",
              "diagnostic",
              "doc",
              "schema",
              "source"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
