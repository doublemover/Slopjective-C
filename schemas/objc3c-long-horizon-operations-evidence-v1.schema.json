{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-long-horizon-operations-evidence-v1.schema.json",
  "title": "objc3c Long-Horizon Operations Evidence",
  "type": "object",
  "required": [
    "contract_id",
    "schema_version",
    "generated_from",
    "owner_split",
    "owner_contracts",
    "support_window",
    "upgrade_replay",
    "revert_readiness",
    "soak",
    "aging_regression",
    "claim_audit"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.long_horizon_operations.evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generated_from": {
      "type": "object",
      "required": ["owner_split", "owner_contracts", "contracts", "commands"],
      "properties": {
        "owner_split": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "owner_contracts": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "contracts": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "owner_split": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "owner_contracts": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "support_window": {
      "type": "object",
      "required": ["current_version", "supported_major_line", "default_channel", "supported_platform_ids", "channels"],
      "properties": {
        "current_version": {"type": "string"},
        "supported_major_line": {"type": "integer"},
        "default_channel": {"type": "string"},
        "supported_platform_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "support_tiers": {"type": "object"},
        "channels": {
          "type": "array",
          "items": {"type": "object"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "upgrade_replay": {
      "type": "object",
      "required": ["status", "source_version", "target_version", "source_channel", "target_channel", "requirements", "evidence_paths"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "source_version": {"type": "string"},
        "target_version": {"type": "string"},
        "source_channel": {"type": "string"},
        "target_channel": {"type": "string"},
        "requirements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "revert_readiness": {
      "type": "object",
      "required": ["status", "channels", "evidence_paths"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "channels": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "soak": {
      "type": "object",
      "required": ["status", "required_families", "evidence_paths"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "required_families": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "aging_regression": {
      "type": "object",
      "required": ["status", "cadence_classes", "freshness_budget"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "cadence_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "freshness_budget": {"type": "object"}
      },
      "additionalProperties": false
    },
    "claim_audit": {
      "type": "object",
      "required": ["support_state", "earned_claims", "demoted_or_out_of_scope_claims", "blocker_metadata", "release_blockers"],
      "properties": {
        "support_state": {"type": "string"},
        "earned_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "demoted_or_out_of_scope_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "blocker_metadata": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "release_blockers": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
