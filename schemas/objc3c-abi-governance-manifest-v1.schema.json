{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-abi-governance-manifest-v1.schema.json",
  "title": "objc3c ABI Governance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "issue_refs",
    "source_of_truth",
    "governance_posture",
    "governed_surfaces",
    "surface_extractors",
    "compatibility_evidence",
    "release_blocked_transitions",
    "compatibility_policy",
    "summary_contract"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.abi_governance.source_of_truth.v1" },
    "schema_version": { "const": 1 },
    "issue_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "#8173" },
      "items": { "type": "string", "pattern": "^#[0-9]+$" }
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "schema_path",
        "checker_path",
        "release_governance_manifest",
        "release_governance_schema"
      ],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/repoPath" },
        "schema_path": { "const": "schemas/objc3c-abi-governance-manifest-v1.schema.json" },
        "checker_path": { "const": "scripts/check_objc3c_abi_governance.py" },
        "release_governance_manifest": { "const": "tests/tooling/fixtures/release_foundation/abi_api_governance.json" },
        "release_governance_schema": { "const": "schemas/objc3c-abi-api-governance-v1.schema.json" }
      }
    },
    "governance_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "failure_mode",
        "publication_claim",
        "compatibility_shims_supported",
        "fallback_routes_supported",
        "unsupported_stability_claims"
      ],
      "properties": {
        "mode": { "const": "source-of-truth-manifest" },
        "failure_mode": { "const": "fail-closed" },
        "publication_claim": { "const": "exact checked ABI surface only" },
        "compatibility_shims_supported": { "const": false },
        "fallback_routes_supported": { "const": false },
        "unsupported_stability_claims": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "contains": { "const": "cross-major forward compatibility" },
          "items": {
            "enum": [
              "cross-major forward compatibility",
              "drop-in legacy ABI compatibility",
              "indefinite support window",
              "retired ABI accommodation claim",
              "fallback downgrade route"
            ]
          }
        }
      }
    },
    "governed_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/governedSurface" }
    },
    "surface_extractors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surfaceExtractor" }
    },
    "compatibility_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_source",
        "case_contract",
        "cases"
      ],
      "properties": {
        "evidence_source": { "const": "checked-source-of-truth-manifest" },
        "case_contract": { "const": "objc3c.abi_governance.compatibility_case.v1" },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/compatibilityCase" }
        }
      }
    },
    "release_blocked_transitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "unsupported-downgrade-route" },
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_major_lines",
        "current_minor_line",
        "shim_policy",
        "fallback_route_policy",
        "private_helper_graduation_policy",
        "claim_source"
      ],
      "properties": {
        "supported_major_lines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "current_minor_line": { "type": "integer", "minimum": 0 },
        "shim_policy": { "const": "no-compatibility-shims" },
        "fallback_route_policy": { "const": "no-fallback-routes" },
        "private_helper_graduation_policy": { "const": "requires-approved-governance-record" },
        "claim_source": { "const": "checked-source-of-truth-manifest" }
      }
    },
    "summary_contract": { "const": "objc3c.abi_governance.summary.v1" }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!tmp/)(?!temp/)(?!.*\\\\).*"
    },
    "governedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "owner",
        "source_path",
        "schema_path",
        "identity_path",
        "expected_identity",
        "release_blocker",
        "stability_claim",
        "allowed_transition_set"
      ],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_path": { "$ref": "#/$defs/repoPath" },
        "schema_path": { "$ref": "#/$defs/repoPath" },
        "identity_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_identity": { "type": "string", "minLength": 1 },
        "release_blocker": { "const": true },
        "stability_claim": {
          "enum": [
            "exact-current-abi-only",
            "same-major-checked-manifest-only"
          ]
        },
        "allowed_transition_set": { "type": "string", "minLength": 1 }
      }
    },
    "surfaceExtractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractor_id",
        "kind",
        "source_globs",
        "release_blocker",
        "output_policy",
        "expected_count",
        "expected_digest"
      ],
      "properties": {
        "extractor_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "c-header-public-symbols",
            "stdlib-module-abi-signatures",
            "package-abi-identity-schema"
          ]
        },
        "source_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "release_blocker": { "const": true },
        "output_policy": { "const": "generated-output-only" },
        "expected_count": { "type": "integer", "minimum": 1 },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "compatibilityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "surface_id",
        "compatibility_class",
        "transition",
        "before",
        "after",
        "expected_decision",
        "release_blocker_issue_ref"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "surface_id": { "type": "string", "minLength": 1 },
        "compatibility_class": {
          "enum": [
            "stable-public-api",
            "stable-runtime-abi",
            "frontend-c-api-exact-abi",
            "governed-artifact-schema",
            "package-lockfile-abi"
          ]
        },
        "transition": {
          "enum": [
            "public-symbol-removal-without-deprecation-window",
            "runtime-symbol-removal-without-deprecation-window",
            "signature-change-without-major-line",
            "private-helper-graduation-without-policy",
            "unsupported-upgrade-route",
            "unsupported-downgrade-route",
            "package-abi-identity-drift",
            "schema-breaking-change-without-major-line"
          ]
        },
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 },
        "expected_decision": { "const": "block-release" },
        "release_blocker_issue_ref": { "const": "#8173" }
      }
    }
  }
}
