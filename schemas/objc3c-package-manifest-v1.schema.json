{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-manifest-v1.schema.json",
  "title": "objc3c Package Manifest",
  "type": "object",
  "required": [
    "contract_id",
    "package_id",
    "package_namespace",
    "package_name",
    "package_version",
    "source_kind",
    "source",
    "source_digest",
    "language",
    "abi",
    "module_graph",
    "dependencies",
    "registry",
    "trust",
    "replay",
    "manifest_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "const": "objc3c.package_ecosystem.package_manifest.v1" },
    "package_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[A-Za-z0-9_.-]+$" },
    "package_namespace": { "type": "string", "minLength": 1 },
    "package_name": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_kind": {
      "enum": [
        "stdlib-module-manifest",
        "showcase-workspace-manifest"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "language": {
      "type": "object",
      "required": ["version", "mode"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "3.0" },
        "mode": { "const": "strict" }
      }
    },
    "abi": {
      "type": "object",
      "required": ["identity", "minimum", "runtime_symbols"],
      "additionalProperties": false,
      "properties": {
        "identity": { "const": "objc3-abi-2025Q4" },
        "minimum": { "const": "objc3-abi-2025Q4" },
        "runtime_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "module_graph": { "$ref": "#/$defs/moduleGraph" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "registry": {
      "type": "object",
      "required": ["resolution", "network_resolution", "offline_mirror_required"],
      "additionalProperties": false,
      "properties": {
        "resolution": { "const": "checked-in-local-registry" },
        "network_resolution": { "const": "unsupported-fail-closed" },
        "offline_mirror_required": { "const": true }
      }
    },
    "trust": { "$ref": "#/$defs/trust" },
    "replay": {
      "type": "object",
      "required": ["commands"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^npm run objc3c -- [a-z0-9][a-z0-9-]*(?: .*)?$"
          }
        }
      }
    },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[A-Za-z0-9_.-]+$"
    },
    "moduleGraph": {
      "type": "object",
      "required": [
        "contract_id",
        "package_id",
        "package_source_kind",
        "source",
        "source_digest",
        "source_authority",
        "source_authority_digest",
        "module_name",
        "resolver",
        "direct_import_syntax",
        "import_edges",
        "unsafe_metadata_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.module_graph.v1" },
        "package_id": { "$ref": "#/$defs/packageId" },
        "package_source_kind": {
          "enum": [
            "stdlib-module-manifest",
            "showcase-workspace-manifest"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": { "$ref": "#/$defs/sha256" },
        "module_name": {
          "type": "object",
          "required": ["canonical", "implementation", "case_sensitive"],
          "additionalProperties": false,
          "properties": {
            "canonical": { "type": "string", "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 },
            "case_sensitive": { "const": true }
          }
        },
        "resolver": { "const": "checked-in-local-registry" },
        "direct_import_syntax": { "const": "reserved-fail-closed" },
        "import_edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/moduleImportEdge" }
        },
        "unsafe_metadata_policy": {
          "type": "object",
          "required": [
            "missing_module_graph",
            "missing_package_manifest",
            "manual_sidecar_manifest",
            "network_or_hosted_metadata"
          ],
          "additionalProperties": false,
          "properties": {
            "missing_module_graph": { "const": "fail-closed" },
            "missing_package_manifest": { "const": "fail-closed" },
            "manual_sidecar_manifest": { "const": "fail-closed" },
            "network_or_hosted_metadata": { "const": "fail-closed" }
          }
        }
      }
    },
    "moduleImportEdge": {
      "type": "object",
      "required": [
        "from_module",
        "to_module",
        "to_package_id",
        "source",
        "source_authority",
        "source_authority_digest",
        "resolution",
        "required_version"
      ],
      "additionalProperties": false,
      "properties": {
        "from_module": { "type": "string", "minLength": 1 },
        "to_module": { "type": "string", "minLength": 1 },
        "to_package_id": { "$ref": "#/$defs/packageId" },
        "source": { "const": "checked-in-local-workspace" },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": { "$ref": "#/$defs/sha256" },
        "resolution": { "const": "locked-local-registry" },
        "required_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "package_id",
        "source",
        "source_authority",
        "source_authority_digest",
        "version_requirement",
        "language_requirement",
        "abi_requirement"
      ],
      "additionalProperties": false,
      "properties": {
        "package_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[A-Za-z0-9_.-]+$" },
        "source": { "const": "checked-in-local-workspace" },
        "source_authority": {
          "enum": [
            "stdlib/module_inventory.json",
            "showcase/portfolio.json"
          ]
        },
        "source_authority_digest": { "$ref": "#/$defs/sha256" },
        "version_requirement": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "language_requirement": { "const": "3.0" },
        "abi_requirement": { "const": "objc3-abi-2025Q4" }
      }
    },
    "trust": {
      "type": "object",
      "required": [
        "contract_id",
        "signature_id",
        "signature_format",
        "signing_backend",
        "signer_id",
        "signing_key_id",
        "trust_root_id",
        "subject_kind",
        "subject_package_id",
        "subject_version",
        "package_namespace",
        "artifact_digest",
        "manifest_digest",
        "abi_identity",
        "language_version",
        "signature",
        "revocation_state",
        "verification_policy",
        "signed_at_utc",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.signature_envelope.v1" },
        "signature_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_format": { "const": "objc3c-deterministic-test-sha256-v1" },
        "signing_backend": { "const": "deterministic-test-replay" },
        "signer_id": { "const": "objc3c-local-package-signer-v1" },
        "signing_key_id": { "const": "objc3c-local-package-key-v1" },
        "trust_root_id": { "const": "objc3c-local-deterministic-trust-root-v1" },
        "subject_kind": { "const": "package-manifest" },
        "subject_package_id": { "type": "string", "minLength": 1 },
        "subject_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "package_namespace": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "abi_identity": { "const": "objc3-abi-2025Q4" },
        "language_version": { "const": "3.0" },
        "signature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "revocation_state": { "const": "not-revoked" },
        "verification_policy": { "const": "fail-closed-local-digest-trust-root-revocation-v1" },
        "signed_at_utc": { "const": "omitted-for-deterministic-replay" },
        "provenance": { "const": "deterministic-local-fixture-replay-only" }
      }
    }
  }
}
