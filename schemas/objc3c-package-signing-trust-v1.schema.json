{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-package-signing-trust-v1.schema.json",
  "title": "objc3c Package Signing Trust",
  "type": "object",
  "required": [
    "contract_id",
    "policy_version",
    "diagnostic_code",
    "trust_roots",
    "revocations",
    "key_rotation_policy",
    "extraction_path_policy",
    "installer_update_key_policy",
    "release_registry_trust_root_policy",
    "production_signing_backend",
    "verification_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "const": "objc3c.package_ecosystem.signing_trust.v1" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "diagnostic_code": { "const": "O3PKG8055" },
    "trust_roots": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/trustRoot" }
    },
    "revocations": { "$ref": "#/$defs/revocations" },
    "key_rotation_policy": {
      "type": "object",
      "required": [
        "rotation_model",
        "overlap_required",
        "implicit_key_rollover_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "rotation_model": { "const": "explicit-new-trust-root-before-old-root-revocation" },
        "overlap_required": { "const": true },
        "implicit_key_rollover_allowed": { "const": false }
      }
    },
    "extraction_path_policy": { "$ref": "#/$defs/extractionPathPolicy" },
    "installer_update_key_policy": { "$ref": "#/$defs/installerUpdateKeyPolicy" },
    "release_registry_trust_root_policy": { "$ref": "#/$defs/releaseRegistryTrustRootPolicy" },
    "production_signing_backend": {
      "type": "object",
      "required": ["state", "required_backend", "diagnostic_code"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "reserved-fail-closed" },
        "required_backend": { "const": "ed25519-pinned-reviewed-provider" },
        "diagnostic_code": { "const": "O3PKG8055" }
      }
    },
    "verification_policy": {
      "type": "object",
      "required": [
        "require_signature",
        "require_trust_root",
        "check_revocation",
        "check_artifact_digest",
        "check_manifest_digest",
        "check_subject_identity",
        "production_backend_reserved_fail_closed"
      ],
      "additionalProperties": false,
      "properties": {
        "require_signature": { "const": true },
        "require_trust_root": { "const": true },
        "check_revocation": { "const": true },
        "check_artifact_digest": { "const": true },
        "check_manifest_digest": { "const": true },
        "check_subject_identity": { "const": true },
        "production_backend_reserved_fail_closed": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signatureEnvelope": {
      "type": "object",
      "required": [
        "contract_id",
        "signature_id",
        "signature_format",
        "signing_backend",
        "signer_id",
        "signing_key_id",
        "trust_root_id",
        "subject_kind",
        "subject_package_id",
        "subject_version",
        "package_namespace",
        "artifact_digest",
        "manifest_digest",
        "abi_identity",
        "language_version",
        "signature",
        "revocation_state",
        "verification_policy",
        "signed_at_utc",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.signature_envelope.v1" },
        "signature_id": { "$ref": "#/$defs/sha256" },
        "signature_format": {
          "enum": [
            "objc3c-deterministic-test-sha256-v1",
            "ed25519-reserved-fail-closed"
          ]
        },
        "signing_backend": {
          "enum": [
            "deterministic-test-replay",
            "production-ed25519-reserved"
          ]
        },
        "signer_id": { "type": "string", "minLength": 1 },
        "signing_key_id": { "type": "string", "minLength": 1 },
        "trust_root_id": { "type": "string", "minLength": 1 },
        "subject_kind": {
          "enum": [
            "package-manifest",
            "package-artifact",
            "package-lock",
            "hosted-registry-record",
            "registry-metadata",
            "install-receipt",
            "update-receipt"
          ]
        },
        "subject_package_id": { "type": "string", "minLength": 1 },
        "subject_version": { "type": "string", "minLength": 1 },
        "package_namespace": { "type": "string", "minLength": 1 },
        "artifact_digest": { "$ref": "#/$defs/sha256" },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "lock_digest": { "$ref": "#/$defs/sha256" },
        "abi_identity": { "type": "string", "minLength": 1 },
        "language_version": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/sha256" },
        "revocation_state": { "enum": ["not-revoked", "revoked"] },
        "verification_policy": { "const": "fail-closed-local-digest-trust-root-revocation-v1" },
        "signed_at_utc": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "trustRoot": {
      "type": "object",
      "required": [
        "trust_root_id",
        "issuer_id",
        "root_kind",
        "signer_id",
        "signing_key_id",
        "signature_format",
        "signature_algorithm",
        "signing_backend",
        "key_state",
        "valid_from_utc",
        "valid_until_utc",
        "trust_scope",
        "compatibility_scope",
        "allowed_package_namespaces"
      ],
      "additionalProperties": false,
      "properties": {
        "trust_root_id": { "type": "string", "minLength": 1 },
        "issuer_id": { "type": "string", "minLength": 1 },
        "root_kind": {
          "enum": [
            "local-development",
            "release-signing",
            "registry-signing"
          ]
        },
        "signer_id": { "type": "string", "minLength": 1 },
        "signing_key_id": { "type": "string", "minLength": 1 },
        "signature_format": {
          "enum": [
            "objc3c-deterministic-test-sha256-v1",
            "ed25519-reserved-fail-closed"
          ]
        },
        "signature_algorithm": {
          "enum": [
            "sha256-fixture-digest",
            "ed25519-reserved"
          ]
        },
        "signing_backend": {
          "enum": [
            "deterministic-test-replay",
            "production-ed25519-reserved"
          ]
        },
        "deterministic_public_material": { "type": "string", "minLength": 1 },
        "key_state": { "enum": ["active", "reserved", "revoked", "expired"] },
        "valid_from_utc": { "type": "string", "minLength": 1 },
        "valid_until_utc": { "type": "string", "minLength": 1 },
        "trust_scope": { "type": "string", "minLength": 1 },
        "compatibility_scope": { "type": "string", "minLength": 1 },
        "allowed_package_namespaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "extractionPathPolicy": {
      "type": "object",
      "required": [
        "contract_id",
        "policy",
        "diagnostic_code",
        "plan_contract_id",
        "path_root",
        "before_filesystem_mutation_required",
        "reject_absolute_paths",
        "reject_parent_traversal",
        "reject_symlink_entries",
        "reject_overwrite_existing_paths",
        "reject_duplicate_paths",
        "reject_case_conflicting_paths",
        "allow_empty_path"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.extraction_path_policy.v1" },
        "policy": { "const": "fail-closed-no-absolute-traversal-symlink-overwrite-duplicates-v1" },
        "diagnostic_code": { "const": "O3PKG8055" },
        "plan_contract_id": { "const": "objc3c.package_ecosystem.extraction_plan.v1" },
        "path_root": { "const": "repo-relative-owned-package-root" },
        "before_filesystem_mutation_required": { "const": true },
        "reject_absolute_paths": { "const": true },
        "reject_parent_traversal": { "const": true },
        "reject_symlink_entries": { "const": true },
        "reject_overwrite_existing_paths": { "const": true },
        "reject_duplicate_paths": { "const": true },
        "reject_case_conflicting_paths": { "const": true },
        "allow_empty_path": { "const": false }
      }
    },
    "installerUpdateKeyPolicy": {
      "type": "object",
      "required": [
        "contract_id",
        "policy",
        "diagnostic_code",
        "installer_key_required",
        "update_key_required",
        "installer_key_state",
        "update_key_state",
        "reserved_key_use_fails_closed",
        "implicit_installer_key_rollover_allowed",
        "implicit_update_key_rollover_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.installer_update_key_policy.v1" },
        "policy": { "const": "reserved-fail-closed-installer-update-keys-v1" },
        "diagnostic_code": { "const": "O3PKG8055" },
        "installer_key_required": { "const": true },
        "update_key_required": { "const": true },
        "installer_key_state": { "const": "reserved-fail-closed" },
        "update_key_state": { "const": "reserved-fail-closed" },
        "reserved_key_use_fails_closed": { "const": true },
        "implicit_installer_key_rollover_allowed": { "const": false },
        "implicit_update_key_rollover_allowed": { "const": false }
      }
    },
    "releaseRegistryTrustRootPolicy": {
      "type": "object",
      "required": [
        "contract_id",
        "policy",
        "diagnostic_code",
        "local_fixture_root_only_active",
        "release_root_required_state",
        "registry_root_required_state",
        "reserved_root_use_fails_closed",
        "fallback_trust_root_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.release_registry_trust_root_policy.v1" },
        "policy": { "const": "reserved-fail-closed-release-registry-trust-roots-v1" },
        "diagnostic_code": { "const": "O3PKG8055" },
        "local_fixture_root_only_active": { "const": true },
        "release_root_required_state": { "const": "reserved" },
        "registry_root_required_state": { "const": "reserved" },
        "reserved_root_use_fails_closed": { "const": true },
        "fallback_trust_root_allowed": { "const": false }
      }
    },
    "extractionPlan": {
      "type": "object",
      "required": [
        "contract_id",
        "plan_id",
        "path_root",
        "path_policy",
        "entries",
        "entry_count",
        "before_filesystem_mutation",
        "provenance",
        "plan_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": { "const": "objc3c.package_ecosystem.extraction_plan.v1" },
        "plan_id": { "type": "string", "minLength": 1 },
        "path_root": { "const": "repo-relative-owned-package-root" },
        "path_policy": { "$ref": "#/$defs/extractionPathPolicy" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extractionEntry" }
        },
        "entry_count": { "type": "integer", "minimum": 1 },
        "before_filesystem_mutation": { "const": true },
        "provenance": { "type": "string", "minLength": 1 },
        "plan_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "extractionEntry": {
      "type": "object",
      "required": ["path", "entry_type", "mutation"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "entry_type": { "enum": ["file", "directory", "symlink"] },
        "mutation": { "enum": ["write", "copy", "record"] },
        "package_id": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "revocations": {
      "type": "object",
      "required": [
        "revoked_trust_root_ids",
        "revoked_signing_key_ids",
        "revoked_package_ids",
        "revoked_signature_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "revoked_trust_root_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "revoked_signing_key_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "revoked_package_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "revoked_signature_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
