{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-adoption-legibility-evidence-v1.schema.json",
  "title": "objc3c Adoption And Legibility Evidence",
  "description": "Evidence envelope for current adoption, onboarding, comparison, and replay support. Section identifiers do not create retired-surface acceptance, alternate old-surface support, or report-only support claims.",
  "type": "object",
  "required": [
    "contract_id",
    "schema_version",
    "generated_at_utc",
    "generated_from",
    "public_workflow",
    "boundary_inventory",
    "artifact_contract",
    "evaluator_path",
    "adoption_replay",
    "comparison_matrix",
    "onboarding",
    "candidate_claims",
    "claim_audit"
  ],
  "properties": {
    "contract_id": {
      "const": "objc3c.adoption_legibility.evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generated_from": {
      "type": "object",
      "required": ["contracts", "commands", "owner_split"],
      "properties": {
        "contracts": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "commands": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "owner_split": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "public_workflow": {
      "type": "object",
      "required": ["status", "public_actions", "package_bridge", "metadata_publisher", "integration_checker"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "public_actions": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2
        },
        "package_bridge": {
          "type": "string",
          "const": "objc3c"
        },
        "metadata_publisher": {"type": "string"},
        "integration_checker": {"type": "string"}
      },
      "additionalProperties": false
    },
    "boundary_inventory": {
      "type": "object",
      "required": [
        "status",
        "working_scope",
        "non_goals",
        "primary_evaluator_surfaces",
        "substrate_runbooks",
        "machine_owned_output_roots",
        "successor_surfaces"
      ],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "working_scope": {
          "type": "array",
          "items": {"type": "string"}
        },
        "non_goals": {
          "type": "array",
          "items": {"type": "string"}
        },
        "primary_evaluator_surfaces": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "substrate_runbooks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "machine_owned_output_roots": {
          "type": "array",
          "items": {"type": "string"}
        },
        "successor_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "artifact_contract": {
      "type": "object",
      "required": ["status", "schema", "artifact_root", "report_root", "generated_artifacts", "generated_reports", "claim_rules"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "schema": {"type": "string"},
        "artifact_root": {"type": "string"},
        "report_root": {"type": "string"},
        "generated_artifacts": {
          "type": "array",
          "items": {"type": "object"}
        },
        "generated_reports": {
          "type": "array",
          "items": {"type": "string"}
        },
        "claim_rules": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "evaluator_path": {
      "type": "object",
      "required": ["status", "entrypoints", "package_bridge", "required_actions"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "entrypoints": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "package_bridge": {
          "type": "string",
          "const": "objc3c"
        },
        "required_actions": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "tutorial_doc_count": {
          "type": ["integer", "null"]
        },
        "showcase_source_count": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "adoption_replay": {
      "type": "object",
      "description": "Current-support adoption replay evidence. This section records upgrade/replay obligations for supported flows and does not authorize old syntax, retired-source acceptance, alternate old-surface support, or replay-only support claims.",
      "required": ["status", "phases", "interop_axes", "replay_fields", "package_bridge", "required_actions"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "phases": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "interop_axes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "replay_fields": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "package_bridge": {
          "type": "string",
          "const": "objc3c"
        },
        "required_actions": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "comparison_matrix": {
      "type": "object",
      "required": ["status", "axes", "adjacent_ecosystems", "evidence_paths"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "axes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "adjacent_ecosystems": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_paths": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "required": ["status", "tutorials", "showcase_workspaces", "package_actions"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "tutorials": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "showcase_workspaces": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "package_actions": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "candidate_claims": {
      "type": "object",
      "required": ["status", "claim_classes", "publication_fields", "forbidden_claims", "deferred_behavior_policy"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "DEFERRED"]},
        "claim_classes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "publication_fields": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "deferred_behavior_policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "claim_audit": {
      "type": "object",
      "required": ["support_state", "earned_claims", "demoted_or_out_of_scope_claims", "release_blockers"],
      "properties": {
        "support_state": {"type": "string"},
        "earned_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "demoted_or_out_of_scope_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "release_blockers": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "publication_view": {
      "type": "object"
    },
    "published_at_utc": {
      "type": "string"
    },
    "evaluator_publication": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
