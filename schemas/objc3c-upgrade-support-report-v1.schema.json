{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-upgrade-support-report-v1.schema.json",
  "title": "objc3c Upgrade Support Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "generated_at_utc",
    "current_version",
    "default_platform_id",
    "platform_support_matrix",
    "supported_platform_ids",
    "support_tiers",
    "support_windows",
    "upgrade_paths",
    "warnings",
    "revert_guidance"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.release.operations.upgrade-support-report.v1" },
    "generated_at_utc": { "type": "string" },
    "current_version": { "type": "string" },
    "default_platform_id": { "type": "string" },
    "platform_support_matrix": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "support_windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_major", "supported_major_lines"],
      "properties": {
        "current_major": { "type": "integer", "minimum": 0 },
        "supported_major_lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1
        }
      }
    },
    "upgrade_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/upgradePath" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportWarning" }
    },
    "revert_guidance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revertGuidance" }
    }
  },
  "$defs": {
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "upgradePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "status"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "status": { "enum": ["supported", "blocked", "manual-review"] },
        "required_channel": { "type": "string" }
      }
    },
    "reportWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "severity", "message"],
      "properties": {
        "warning_id": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" }
      }
    },
    "revertGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "instruction"],
      "properties": {
        "channel_id": { "type": "string" },
        "instruction": { "type": "string" },
        "requires_backup": { "type": "boolean" }
      }
    }
  }
}
