{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objc3c.dev/schemas/objc3c-upgrade-support-report-v1.schema.json",
  "title": "objc3c Upgrade Support Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "generated_at_utc",
    "current_version",
    "default_platform_id",
    "platform_support_matrix",
    "supported_platform_ids",
    "support_tiers",
    "support_windows",
    "upgrade_paths",
    "warnings",
    "revert_guidance",
    "rollback_diagnostics",
    "fail_closed_diagnostics",
    "forbidden_claims"
  ],
  "properties": {
    "contract_id": { "const": "objc3c.release.operations.upgrade-support-report.v1" },
    "generated_at_utc": { "type": "string" },
    "current_version": { "type": "string" },
    "default_platform_id": { "type": "string" },
    "platform_support_matrix": { "type": "string" },
    "supported_platform_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportTier" },
      "minItems": 1
    },
    "support_windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable", "candidate", "preview"],
      "properties": {
        "stable": { "$ref": "#/$defs/supportWindow" },
        "candidate": { "$ref": "#/$defs/supportWindow" },
        "preview": { "$ref": "#/$defs/supportWindow" }
      }
    },
    "upgrade_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/upgradePath" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportWarning" }
    },
    "revert_guidance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revertGuidance" }
    },
    "rollback_diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rollbackDiagnostic" }
    },
    "fail_closed_diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/failClosedDiagnostic" }
    },
    "forbidden_claims": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "supportTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_id", "status"],
      "properties": {
        "tier_id": { "type": "string" },
        "status": { "enum": ["supported", "experimental", "unsupported"] },
        "platform_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "supportWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supported_minor_lines", "upgrade_from", "downgrade_to"],
      "properties": {
        "status": { "type": "string" },
        "supported_minor_lines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "upgrade_from": {
          "type": "array",
          "items": { "type": "string" }
        },
        "downgrade_to": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "upgradePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "from",
        "to",
        "upgrade_contract",
        "requires_warning",
        "revert_channel"
      ],
      "properties": {
        "path_id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "upgrade_contract": { "type": "string" },
        "requires_warning": { "type": "boolean" },
        "revert_channel": { "type": "string" }
      }
    },
    "reportWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "severity", "message"],
      "properties": {
        "channel_id": { "type": "string" },
        "warning_id": { "type": "string" },
        "severity": { "enum": ["info", "warn", "warning", "error"] },
        "message": { "type": "string" },
        "required_action": { "type": "string" },
        "blocks_publication": { "type": "boolean" }
      }
    },
    "revertGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "instruction", "requires_backup", "rollback_channel", "operator_command"],
      "properties": {
        "channel_id": { "type": "string" },
        "instruction": { "type": "string" },
        "requires_backup": { "type": "boolean" },
        "rollback_channel": { "type": "string" },
        "operator_command": { "type": "string" }
      }
    },
    "rollbackDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "severity",
        "user_facing_message",
        "rollback_channel",
        "operator_command",
        "blocks_publication"
      ],
      "properties": {
        "diagnostic_id": { "type": "string" },
        "severity": { "enum": ["info", "warn", "warning", "error"] },
        "user_facing_message": { "type": "string" },
        "rollback_channel": { "type": "string" },
        "operator_command": { "type": "string" },
        "blocks_publication": { "type": "boolean" }
      }
    },
    "failClosedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "severity",
        "trigger",
        "required_action",
        "blocks_publication"
      ],
      "properties": {
        "diagnostic_id": { "type": "string" },
        "severity": { "enum": ["info", "warn", "warning", "error"] },
        "trigger": { "type": "string" },
        "required_action": { "type": "string" },
        "blocks_publication": { "type": "boolean" }
      }
    }
  }
}
